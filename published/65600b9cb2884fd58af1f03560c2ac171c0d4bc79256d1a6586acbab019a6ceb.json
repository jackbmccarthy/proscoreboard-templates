{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Glacier Ink Footline PICKLEBALL 1</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; min-height: 100%; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; }\n.stage { display: flex; min-height: 100vh; align-items: center; justify-content: center; padding: 16px; }\n.board { --glacier: #e2eaeb; --ink: #253c49; width: min(100%, 1200px); overflow: hidden; border-radius: 6px; color: var(--ink); background: var(--glacier); }\n.lanes { display: flex; flex-direction: column; min-width: 0; }\n.lane { display: flex; flex: 0 0 142px; min-width: 0; height: 142px; background: var(--glacier); }\n.lane + .lane { border-top: 1px solid #a8b9bf; }\n.identity { flex: 0 0 34px; background: #2b88a9; }\n.jerseyColorB { background: #c66d68; }\n.name-cell { display: flex; align-items: center; flex: 1 1 0; min-width: 0; gap: 8px; padding: 0 32px; }\n.name { display: block; flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 62px; line-height: 1.1; font-weight: 700; }\n.combinedAName:empty::before { content: \"Player A\"; }\n.combinedBName:empty::before { content: \"Player B\"; }\n.serve { flex: 0 0 13px; width: 13px; height: 13px; font-size: 13px; line-height: 13px; text-align: center; color: var(--ink); }\n.support-track, .primary-track { display: flex; flex-direction: column; justify-content: center; align-items: center; flex-shrink: 0; min-width: 0; font-variant-numeric: tabular-nums; }\n.support-track { flex-basis: 240px; background: var(--glacier); border-left: 1px solid #a8b9bf; }\n.primary-track { flex-basis: 240px; background: var(--ink); color: #fff; }\n.value { display: block; width: 100%; text-align: center; white-space: nowrap; font-weight: 700; line-height: 1; }\n.support-track .value { font-size: 58px; }\n.primary-track .value { font-size: 78px; }\n.caption { display: block; width: 100%; margin-top: 5px; text-align: center; white-space: nowrap; font-size: 24px; line-height: 1; font-weight: 700; }\n.footline { position: relative; display: flex; align-items: center; width: 100%; height: 86px; padding: 0 36px; background: var(--ink); color: #fff; border-top: 1px solid #a8b9bf; }\n.sport-tag { font-size: 42px; line-height: 1; font-weight: 700; letter-spacing: .025em; white-space: nowrap; }\n.point-slot { position: relative; width: 120px; height: 18px; margin-left: auto; font-size: 11px; line-height: 18px; font-weight: 700; text-align: right; }\n.point-label { position: absolute; inset: 0; white-space: nowrap; }\n.point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint { opacity: 0 !important; }\n@media (max-width: 980px) {\n  .board { width: min(100%, 540px); }\n  .lanes { flex-direction: column; }\n  .lane { flex: 0 0 82px; height: 82px; }\n  .lane + .lane { border-left: 0; border-top: 1px solid #a8b9bf; }\n  .identity { flex-basis: 6px; }\n  .name-cell { padding: 0 14px; }\n  .name { font-size: clamp(20px, 5vw, 32px); }\n  .support-track { flex-basis: 72px; }\n  .primary-track { flex-basis: 88px; }\n  .support-track .value { font-size: 30px; }\n  .primary-track .value { font-size: 40px; }\n  .caption { margin-top: 3px; font-size: 10px; }\n  .footline { height: 42px; padding: 0 14px; }\n  .sport-tag { font-size: 16px; }\n  .point-slot { width: 94px; font-size: 9px; }\n}\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n      <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n      <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n        <div class=\"name-cell\">\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span>\n        </div>\n        <div class=\"support-track\"><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">GAMES</span></div>\n        <div class=\"primary-track\"><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n      </div>\n      <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n        <div class=\"name-cell\">\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span>\n        </div>\n        <div class=\"support-track\"><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">GAMES</span></div>\n        <div class=\"primary-track\"><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n      </div>\n      </div>\n      <div class=\"footline\">\n        <span class=\"sport-tag\">PICKLEBALL</span>\n        <span class=\"point-slot\">\n          <span class=\"point-label isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span>\n          <span class=\"point-label isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span>\n        </span>\n      </div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
