{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Center Court</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1;position:relative}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.18)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing,.ldot{animation:none!important;transition:none!important}}\n.nm{display:block;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;line-height:1.02}\n.bal{text-wrap:balance}\n.st,.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hv{position:relative;display:inline-grid;place-items:center}.hv>*{grid-area:1/1}.hv>.w{display:block;align-self:stretch;justify-self:stretch}.hv>.num{position:relative}\n.ev,.rd{white-space:nowrap}\n.hc:not([style*=\"opacity: 1\"]),.cell:not([style*=\"opacity: 1\"]){display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 0 .15rem #0b1a12,0 0 .4rem #0007}\n\n.stage{position:fixed;left:0;right:0;bottom:4rem;display:flex;justify-content:center}\n.board{position:relative;display:flex;flex-direction:column;align-items:center;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff;filter:drop-shadow(0 .5rem 1.2rem #000a)}\n.evtab{max-width:60rem;display:block;padding:.75rem 2rem 0;height:3.2rem;background:#081a3d;border-radius:.6rem .6rem 0 0;font-size:1.7rem;letter-spacing:.08em;text-transform:uppercase;color:#b9c8ea;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1}.evtab .sep{font-style:normal;color:#ff9f1c;margin:0 .55rem}\n.bar{display:flex;align-items:stretch;height:8rem;background:#0c2350;border-radius:.4rem;overflow:visible}\n.side{position:relative;display:flex;align-items:stretch}.sB{flex-direction:row-reverse}\n.chip{width:1rem;flex:none}.chipA{background:#3d8bff;border-radius:.4rem 0 0 .4rem}.chipB{background:#ff4b55;border-radius:0 .4rem .4rem 0}\n.who{width:25rem;display:flex;flex-direction:column;justify-content:center;gap:.55rem;padding:.5rem 1.2rem 0}\n.sB .who{align-items:flex-end;text-align:right}\n.nm{font-size:2.5rem;font-weight:700;text-transform:uppercase}\n.pips{display:flex;gap:.45rem}.pip{position:relative;display:block;width:2.4rem;height:.8rem;border-radius:.1rem;box-shadow:inset 0 0 0 .15rem #8eb0ff}.pip>.lit{position:absolute;inset:0;border-radius:inherit;background:#ff9f1c}\n.sv{width:3.6rem;flex:none;place-items:center}.vball{width:2.4rem;height:2.4rem}\n.win{display:grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%;background:#ff9f1c;color:#0c2350;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;font-size:1.9rem;font-weight:900}\n.setbox{width:5.4rem;flex:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.2rem;background:#0a1d44}\n.setbox>i{font-style:normal;font-size:1.6rem;letter-spacing:.08em;color:#7f97cf;padding-top:.2rem}\n.sets{color:#ff9f1c;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3rem;font-weight:700;line-height:1}\n.pts{width:8rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem;background:#fff;color:#0c2350;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:4.8rem;font-weight:700}\n.mid{width:12rem;flex:none;display:flex}\n.sslot{flex:1}.sslot>.st{flex-direction:column;gap:.1rem;padding-top:.3rem;font-size:1.9rem;letter-spacing:.07em;line-height:1;text-align:center;white-space:normal;background:#ff9f1c;color:#0c2350}\n.sslot .num{display:block;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.2rem;font-weight:700;letter-spacing:0}\n.sslot>.sdec{background:#ff3d6e;color:#fff;font-size:2.2rem;padding:0 1rem}.sslot>.sbrk{background:#16336f;color:#fff}.sslot>.sbrk .num{font-size:2.8rem}.sslot>.sfin{background:#fff;font-size:2.8rem}\n.sslot>.gp{background:#ffe2b3;color:#0c2350;font-size:2.3rem;padding:0 1.2rem;box-shadow:inset 0 -.5rem 0 #ff9f1c}.sslot>.mp{background:#e8202a;color:#fff;font-size:2.3rem;padding:0 1.2rem}\n.tob{position:absolute;bottom:100%;display:flex;align-items:center;gap:.6rem;height:3.2rem;padding:.35rem 1.1rem 0;background:#ff9f1c;color:#0c2350;font-size:1.8rem;letter-spacing:.06em;white-space:nowrap;border-radius:.4rem .4rem 0 0}.sA .tob{left:0}.sB .tob{right:0}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.2rem}\n.htab{display:flex;justify-content:center;height:3.2rem;paddin