=\"opacity: 1\"]))>.num{color:#8ea2cf}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{color:#ff9f1c}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{background:#ff9f1c;color:#0c2350}\n.board:has(.isAWinner[style*=