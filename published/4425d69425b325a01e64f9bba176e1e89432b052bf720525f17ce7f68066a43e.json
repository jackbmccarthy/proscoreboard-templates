{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Baseball — Linen Navy Sideconsole 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:10px}\n.board{--ink:#1f3242;--linen:#e7dfd0;--steel:#aebfc2;display:flex;width:min(68vw,1300px);height:min(19vw,360px);max-width:100%;min-width:0;overflow:hidden;border-radius:3px;background:var(--ink);color:#f8fafb;container-type:inline-size}\n.console{flex:0 0 22.2%;min-width:0;display:flex;flex-direction:column;background:var(--linen);color:#193247;padding:2.5cqw 1.65cqw}\n.sport-tag{display:block;white-space:nowrap;font-size:2.45cqw;font-weight:800;line-height:1;letter-spacing:-.035em}\n.counter-list{display:flex;flex-direction:column;justify-content:space-between;flex:1;min-height:0;margin-top:2.1cqw}\n.counter-line{display:flex;justify-content:space-between;align-items:center;gap:4px;font-size:2.05cqw;font-weight:700;line-height:1}\n.counter-value{font-variant-numeric:tabular-nums}\n.competitors{display:flex;flex:1 1 auto;min-width:0;flex-direction:column}\n.lane{display:flex;align-items:center;flex:1 1 0;min-width:0;background:var(--ink)}\n.lane+.lane{border-top:2px solid #7898a9}\n.identity{display:block;flex:0 0 1.35cqw;height:77%;margin-left:1.1cqw;border-radius:1px}\n.jerseyColorA{background:#3288ee}.jerseyColorB{background:#ef6c65}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2.2cqw;font-size:5.9cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.support{display:flex;flex:0 0 10.4cqw;height:78%;min-width:0;flex-direction:column;align-items:center;justify-content:center;border-radius:4px;background:var(--steel);color:#173248}\n.support-value{display:block;max-width:100%;overflow:hidden;font-size:6.25cqw;font-weight:800;line-height:.9;font-variant-numeric:tabular-nums}\n.support-caption{font-size:2.1cqw;font-weight:800;line-height:1.1}\n.primary{display:flex;flex:0 0 16cqw;min-width:0;flex-direction:column;align-items:center;justify-content:center;color:#fff}\n.primary-value{display:block;max-width:100%;overflow:hidden;text-align:center;font-size:8.4cqw;font-weight:800;line-height:.96;font-variant-numeric:tabular-nums}\n.primary-caption{font-size:2.15cqw;font-weight:700;line-height:1.15}\n.retained,.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){\n.stage{padding:6px}\n.board{width:100%;height:168px}\n.console{flex-basis:28%;padding:11px 6px}\n.sport-tag{font-size:13px;letter-spacing:-.05em}\n.counter-list{margin-top:10px}\n.counter-line{font-size:9px}\n.identity{flex-basis:5px;margin-left:5px}\n.name{padding:0 5px;font-size:clamp(16px,5vw,27px)}\n.support{flex-basis:40px;height:70%}\n.support-value{font-size:31px}\n.support-caption{font-size:9px}\n.primary{flex-basis:75px}\n.primary-value{font-size:35px}\n.primary-caption{font-size:9px}\n}\n@media(max-width:390px){.console{flex-basis:30%}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n  <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"baseball scoreboard\">\n    <aside class=\"console columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Editable static game counters\">\n      <span class=\"sport-tag\" data-osb-component=\"text\">BASEBALL</span>\n      <div class=\"counter-list columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"counter-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">INNING</span><strong class=\"counter-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></div>\n        <div class=\"counter-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">BALLS</span><strong class=\"counter-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></div>\n        <div class=\"counter-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">STRIKES</span><strong class=\"counter-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></div>\n        <div class=\"counter-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">OUTS</span><strong class=\"counter-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></div>\n      </div>\n    </aside>\n    <div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n      <div class=\"lane rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n        <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n        <div class=\"support columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hits-a\">0</strong><span class=\"support-caption\" data-osb-component=\"text\">HITS</span></div>\n        <div class=\"primary columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">RUNS</span></div>\n        <span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n      </div>\n      <div class=\"lane rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n        <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n        <div class=\"support columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hits-b\">0</strong><span class=\"support-caption\" data-osb-component=\"text\">HITS</span></div>\n        <div class=\"primary columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">RUNS</span></div>\n        <span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n      </div>\n    </div>\n    <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n  </article>\n</main>\n</body>\n</html>\n","css":""}
