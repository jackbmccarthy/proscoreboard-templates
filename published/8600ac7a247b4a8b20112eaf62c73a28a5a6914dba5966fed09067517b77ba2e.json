{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Glacier Ink Footline paired</title><style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;flex-direction:column;width:min(63vw,1280px);max-width:100%;min-width:0;overflow:hidden;border-radius:6px;background:#253c49;container-type:inline-size}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{display:flex;align-items:stretch;min-width:0;height:10.7cqw;background:#e2eaeb}\n.lane+.lane{border-top:1px solid #a8b9bf}\n.identity{display:block;align-self:stretch;flex:none;width:2.45%;min-width:4px;background:#2b88a9}\n.jerseyColorB{background:#c66d68}\n.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2.5cqw;color:#253c49;font-size:5.5cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.support-track,.primary-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;min-width:0;font-variant-numeric:tabular-nums}\n.support-track{width:15%;border-left:1px solid #a8b9bf;background:#e2eaeb;color:#253c49}\n.primary-track{width:17.2%;background:#253c49;color:#f7faf9}\n.value{display:block;max-width:100%;overflow:hidden;text-align:center;white-space:nowrap;font-weight:800;line-height:1}\n.support-track .value{font-size:4.65cqw}\n.primary-track .value{font-size:6.75cqw}\n.caption{display:block;max-width:100%;white-space:nowrap;text-align:center;font-size:2.1cqw;font-weight:700;line-height:1.1}\n.footline{display:flex;align-items:center;min-width:0;height:6.4cqw;border-top:1px solid #a8b9bf;background:#253c49;color:#f7faf9}\n.sport-tag{display:block;flex:1 1 auto;min-width:0;padding:0 2.6cqw;overflow:hidden;white-space:nowrap;font-size:3.4cqw;font-weight:800;line-height:1}\n.stats{display:flex;align-items:center;justify-content:flex-end;flex:0 0 auto;min-width:0}\n.stat{display:flex;align-items:baseline;justify-content:center;gap:.55cqw;min-width:0;padding:0 1.6cqw;border-left:1px solid #a8b9bf;white-space:nowrap;font-size:2cqw;font-weight:600;line-height:1}\n.stat strong{font-size:1.25em;font-weight:800;font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:760px){.board{width:100%}.lanes{flex-direction:column}.lane{flex:none;height:74px}.lane+.lane{border-left:0;border-top:1px solid #a8b9bf}.identity{width:5px}.name{padding:0 12px;font-size:clamp(18px,5.3vw,27px)}.support-track{width:17%}.primary-track{width:24%}.support-track .value{font-size:clamp(20px,6vw,28px)}.primary-track .value{font-size:clamp(25px,7.7vw,38px)}.caption{font-size:10px}.footline{height:auto;min-height:60px;display:block;padding:8px 10px}.sport-tag{padding:0 0 6px;font-size:13px}.stats{justify-content:space-between}.stat{padding:0 5px;gap:3px;font-size:clamp(8px,2.2vw,11px)}.stat:first-child{border-left:0}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball scoreboard\">\n<div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong><span class=\"caption\" data-osb-component=\"text\">HITS</span></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong><span class=\"caption\" data-osb-component=\"text\">RUNS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong><span class=\"caption\" data-osb-component=\"text\">HITS</span></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong><span class=\"caption\" data-osb-component=\"text\">RUNS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"footline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">BASEBALL</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static baseball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
