{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Vertical Name Spine Volleyball — Duel</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { color: #f8f5ee; font-family: Arial, Helvetica, sans-serif; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { --panel-height: 614px; --spine-width: 132px; width: 100%; max-width: 1116px; display: flex; flex-direction: column; background: transparent; }\n.title { font-size: 90px; font-weight: 700; line-height: 1; text-align: center; margin-bottom: 30px; }\n.duel { display: flex; gap: 64px; }\n.team { display: flex; flex: 1 1 0; min-width: 0; height: var(--panel-height); }\n.spine { flex: 0 0 var(--spine-width); width: var(--spine-width); height: var(--panel-height); min-width: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #102a36; }\n.name { display: block; flex: 0 0 calc(var(--panel-height) - 96px); width: calc(var(--panel-height) - 96px); height: 104px; line-height: 104px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-size: 88px; font-weight: 700; transform: rotate(-90deg); }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-pane { display: flex; flex-direction: column; align-items: center; flex: 1 1 0; min-width: 0; padding: 30px 20px; background: #f2eee6; color: #102a36; }\n.sets-band { display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 44px; line-height: 1; font-weight: 700; color: #b85c3a; }\n.match-score { display: block; width: 66px; text-align: left; font-variant-numeric: tabular-nums; }\n.primary-score { display: block; width: 100%; height: 242px; font-family: \"Arial Black\", Arial, sans-serif; font-size: 280px; font-weight: 900; line-height: .9; letter-spacing: -.07em; text-align: center; font-variant-numeric: tabular-nums; margin-top: 90px; }\n.points-label { display: block; width: 100%; text-align: center; font-size: 52px; line-height: 1; font-weight: 700; margin-top: 22px; }\n.set-footer { display: flex; align-items: center; justify-content: center; gap: 17px; margin-top: 28px; font-size: 58px; line-height: 1; font-weight: 700; }\n.set-value { display: block; width: 66px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-height: 800px) and (min-width: 601px) {\n  .board { --panel-height: 480px; }\n  .title { font-size: 64px; margin-bottom: 24px; }\n  .name { height: 90px; line-height: 90px; font-size: 76px; }\n  .score-pane { padding-top: 24px; padding-bottom: 24px; }\n  .sets-band { font-size: 34px; }\n  .primary-score { font-size: 215px; height: 180px; margin-top: 65px; }\n  .points-label { font-size: 36px; margin-top: 14px; }\n  .set-footer { font-size: 44px; margin-top: 24px; }\n}\n@media (max-width: 1000px) {\n  .board { --spine-width: 90px; }\n  .title { font-size: clamp(30px, 8vw, 80px); }\n  .duel { gap: 40px; }\n  .name { font-size: 64px; height: 78px; line-height: 78px; }\n  .primary-score { font-size: clamp(100px, 24vw, 250px); }\n  .sets-band { font-size: 32px; gap: 7px; }\n  .match-score { width: 48px; }\n  .points-label { font-size: 35px; }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .board { --panel-height: 370px; --spine-width: 44px; }\n  .title { font-size: 30px; margin-bottom: 24px; }\n  .duel { gap: 20px; }\n  .name { flex-basis: calc(var(--panel-height) - 40px); width: calc(var(--panel-height) - 40px); font-size: 34px; height: 40px; line-height: 40px; }\n  .score-pane { padding: 24px 10px; }\n  .sets-band { font-size: 19px; gap: 6px; }\n  .match-score { width: 33px; }\n  .primary-score { font-size: 85px; height: 82px; margin-top: 70px; }\n  .points-label { font-size: 18px; margin-top: 14px; }\n  .set-footer { font-size: 32px; gap: 10px; margin-top: 25px; }\n  .set-value { width: 36px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-pane columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sets-band rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-pane columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sets-band rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"points-label\">POINTS</span></div><div class=\"spine jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
