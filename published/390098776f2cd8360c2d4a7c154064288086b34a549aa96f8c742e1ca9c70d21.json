{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pickleball Tour Band</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.25)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing{animation:none!important;transition:none!important}}\n.clamp2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;line-height:1.02}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0004 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0004 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0004 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0003 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0003 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 .4rem #0007}\n.sslot{align-items:center}.sslot>.st{display:flex;align-items:center;justify-content:center;gap:.4em;white-space:nowrap;height:100%}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .swarm{opacity:0!important}\n.board:has(.isGamePoint[style*=\"opacity: 1\"]) .sbrk,.board:has(.isMatchPoint[style*=\"opacity: 1\"]) .sbrk{opacity:0!important}\n.pslot>.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hist:not(:has(>[style*=\"opacity: 1\"])){display:none}\n.srv{display:flex;align-items:center;gap:.35rem}\n.sn{position:relative;display:inline-grid;place-items:center}.sn>i{grid-area:1/1;font-style:normal}\n.sn:has(>.isSecondServer[style*=\"opacity: 1\"])>.one,.cn:has(>.isSecondServer[style*=\"opacity: 1\"])>.one{opacity:0}\n.cn{display:inline-grid}.cn>i{grid-area:1/1;font-style:normal;text-align:center}\n.call{display:inline-flex;align-items:baseline}.call>i,.dbl>i{font-style:normal}.call .ca{order:1}.call .d1{order:2}.call .cb{order:3}.call .dbl{order:4;display:inline-flex;align-items:baseline}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .ca{order:3}.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .cb{order:1}\n.call .dbl:not([style*=\"opacity: 1\"]){display:none}\n.cards{display:flex;gap:.3rem;align-items:center}.card{display:block;border-radius:.15rem;box-shadow:0 0 0 .1rem #0004}.yc{background:#ffd200}.rc{background:#e3262f}\n.cards:not(:has(>[style*=\"opacity: 1\"])){display:none}\n.tie{display:flex;align-items:center}.tie:has(>.teamAName[style*=\"display: none\"]){display:none}\n.tlogo{display:block;object-fit:contain}.tlogo:not([src]),.tlogo[src=\"\"]{visibility:hidden}\n.tie>.tdash{font-style:normal}\n.tname{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;line-height:1.05}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>:not(.tie){display:none}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>.tie{height:auto;min-height:5.2rem;padding-top:.6rem;padding-bottom:.4rem;margin:0}\n\n.row{position:relative;display:flex;align-items:stretch;height:5.4rem}\n.chip{width:.8rem;flex:none}\n.nm{flex:1;min-width:0;align-self:center;padding:.3rem .4rem 0 1rem;font-size:2.6rem;font-weight:700}\n.srv{flex:none;padding:0 .5rem}.pball{width:2rem;height:2rem}\n.sn{min-width:2rem;height:2rem;border-radius:.3rem;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:1.6rem;font-weight:700}\n.stat{display:flex;align-items:center;gap:.5rem;flex:none;padding-right:.6rem}.card{width:1.2rem;height:1.7rem}\n.tou{display:flex;align-items:center;height:2rem;padding:.2rem .5rem 0;border-radius:.25rem;font-size:1.4rem;letter-spacing:.06em;white-space:nowrap}\n.games{width:5.4rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.3rem;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3rem;font-weight:700}\n.pts{width:7.4rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.3rem;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:4.2rem;font-weight:700}\n.tob{position:absolute;left:100%;top:0;bottom:0;display:flex;align-items:center;gap:.6rem;padding:.3rem 1rem 0;font-size:1.8rem;letter-spacing:.05em;white-space:nowrap}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.2rem}\n\n.stage{position:fixed;left:4rem;bottom:4rem}\n.board{position:relative;width:74rem;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;color:#fff;filter:drop-shadow(0 .5rem 1.2rem #0009)}\n.tie{gap:1rem;height:3.8rem;padding:0 1.2rem;background:#fff;color:#3b1f6e;font-size:1.7rem;font-weight:800}.tlogo{width:2.8rem;height:2.8rem}.tchip{width:.6rem;height:2.4rem}.tname:last-of-type{text-align:right}.tscore{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.6rem}.tie>.tdash{color:#a08cc4}\n.head{display:flex;align-items:stretch;height:3.4rem;background:linear-gradient(90deg,#ffcc33,#ffb020);color:#3b1f6e;font-size:1.45rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.ctx{flex:1;min-width:0;display:flex;align-items:center;gap:.6rem;padding:0 1.2rem;white-space:nowrap;overflow:hidden}.ctx .sep{font-style:normal;color:#7a4fc4}\n.sslot{min-width:15rem}.sslot>.st{padding:0 1.2rem;background:#3b1f6e;color:#d8c8f5}.sslot>.sgame{background:#5b2fb0;color:#fff}.sslot>.swarm{background:#ff7a1a;color:#fff}.sslot>.sbrk{background:#fff;color:#3b1f6e}\n.row{background:#3b1f6e}.rB{border-top:.15rem solid #2a1452}\n.nm{font-size:2.4rem;font-weight:800;letter-spacing:-.01em}\n.sn{background:#ffcc33;color:#3b1f6e}\n.tou{background:#ffffff1f;color:#ffcc33;font-weight:800;font-size:1.3rem}\n.games{background:#2a1452;color:#ffcc33}\n.pts{background:#fff;color:#3b1f6e}\n.tob{background:#ffcc33;color:#3b1f6e;font-weight:800;font-size:1.5rem}\n.foot{display:flex;align-items:stretch;justify-content:space-between;height:3.2rem;background:#2a1452}\n.cl{display:flex;align-items:center;gap:.8rem;padding:0 1.2rem;font-size:1.3rem;font-weight:800;letter-spacing:.14em;color:#b9a3e6}.call{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.4rem;font-weight:700;color:#ffcc33;gap:.15rem}\n.hist{display:flex;align-items:stretch}\n.hc{display:flex;align-items:center;gap:.3rem;padding:0 1rem;border-left:.1rem solid #ffffff1c;color:#fff;font-size:1.4rem}.hc .hl{font-weight:700;color:#b9a3e6;margin-right:.3rem}.hc .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:1.9rem}.hc .hd{font-style:normal;color:#b9a3e6}\n.pslot{position:absolute;right:0;bottom:100%;margin-bottom:.5rem}.pt{height:3.2rem;padding:0 1.4rem;font-size:1.6rem;font-weight:800;letter-spacing:.1em;background:#ffcc33;color:#3b1f6e}.pt.mp{background:#ff3b5c;color:#fff}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<span class=\"tie\"><img class=\"tlogo teamLogoURLA\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><i class=\"tchip teamJerseyColorA\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorA\"></i><span class=\"tname teamAName\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tscore num teamAScore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span><i class=\"tdash\">-</i><span class=\"tscore num teamBScore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span><span class=\"tname teamBName\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><i class=\"tchip teamJerseyColorB\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorB\"></i><img class=\"tlogo teamLogoURLB\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"></span>\n<div class=\"head\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"ctx\"><span class=\"eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"slot sslot\"><span class=\"st sfmt\"><span class=\"matchFormatLabel\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span><span class=\"st sgame isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">GAME <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st swarm isWarmUpStarted\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">WARM-UP</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF GAME <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span></span></div>\n<div class=\"rows\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"row rA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"nm clamp2 combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"pball\"></i><b class=\"sn isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><i class=\"one\">1</i><i class=\"two isSecondServer\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" isA=\"true\" style=\"opacity:0\">2</i></b></span><span class=\"stat\"><span class=\"cards\"><i class=\"card yc isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></i><i class=\"card rc isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></i></span><span class=\"tou isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O</span></span><span class=\"games num currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"pts num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"tob isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"tclock num timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span></div><div class=\"row rB\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"nm clamp2 combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"pball\"></i><b class=\"sn isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><i class=\"one\">1</i><i class=\"two isSecondServer\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" style=\"opacity:0\">2</i></b></span><span class=\"stat\"><span class=\"cards\"><i class=\"card yc isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></i><i class=\"card rc isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></i></span><span class=\"tou isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T/O</span></span><span class=\"games num currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"pts num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"tob isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"tclock num timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></div></div>\n<div class=\"foot\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"cl\">SCORE CALL <span class=\"call\"><span class=\"ca num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"d1\">-</i><span class=\"cb num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"dbl isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><i class=\"d2\">-</i><b class=\"cn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" isA=\"true\" style=\"opacity:0\">2</i><i class=\"two isSecondServer\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" style=\"opacity:0\">2</i></b></span></span></span><div class=\"hist\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"hc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><b class=\"hl\">G1</b><span class=\"ha num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span><span class=\"hc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><b class=\"hl\">G2</b><span class=\"ha num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span><span class=\"hc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><b class=\"hl\">G3</b><span class=\"ha num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span><span class=\"hc isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><b class=\"hl\">G4</b><span class=\"ha num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span><span class=\"hc isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><b class=\"hl\">G5</b><span class=\"ha num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div></div>\n<span class=\"slot pslot\"><span class=\"pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"osb-core-fields\"><span class=\"playerA2\" data-osb-component=\"field\" data-osb-field=\"playerA2\"></span></span></section></main>\n</body>\n</html>\n","css":""}
