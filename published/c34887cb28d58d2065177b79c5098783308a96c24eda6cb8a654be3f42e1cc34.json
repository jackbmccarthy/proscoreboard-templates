{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Open Corner Grid basketball 2</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f4f6f8}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:68vw;max-width:1300px;container-type:inline-size;background:transparent;min-width:0}.heading{font-size:6.7cqw;line-height:1.05;margin:0;letter-spacing:-.025em}.heading::after{content:\"\";display:block;width:25.3%;height:.85cqw;background:#ef442c;margin-top:1.1cqw}.lane{display:flex;align-items:center;min-width:0;height:19.2cqw;border-bottom:.25cqw solid #f4f6f8;gap:1cqw}.name{display:block;flex:1 1 0;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:8cqw;line-height:1.1}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.points{flex:0 0 18%;min-width:0;text-align:center}.label{display:block;font-size:2.4cqw;line-height:1.2;letter-spacing:.025em}.score-frame{position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:10.7cqw;margin-top:1.35cqw;background:transparent}.score{display:block;width:100%;text-align:center;line-height:1;font-size:9.2cqw;font-variant-numeric:tabular-nums;letter-spacing:-.055em}.corner{position:absolute;width:2.5cqw;height:2.5cqw;border:0 solid #f4f6f8;pointer-events:none}.tl{left:0;top:0;border-top-width:.48cqw;border-left-width:.48cqw}.tr{right:0;top:0;border-top-width:.48cqw;border-right-width:.48cqw}.bl{left:0;bottom:0;border-bottom-width:.48cqw;border-left-width:.48cqw}.br{right:0;bottom:0;border-bottom-width:.48cqw;border-right-width:.48cqw}.footer{display:flex;min-width:0;justify-content:center;gap:4.8cqw;margin:6.5cqw auto 0;width:84%}.stat{min-width:0;flex:1 1 0;text-align:center;position:relative}.stat .score-frame{height:10cqw;margin-top:1.2cqw}.stat .value{display:block;width:100%;font-size:6.4cqw;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.03em}.stat.clock{flex:1.6 1 0}.stat.shot{flex:1.3 1 0}.basketball.variant-1 .stat+.stat::before{content:\"\";position:absolute;left:-2.7cqw;top:3.8cqw;bottom:.6cqw;width:.2cqw;background:#f4f6f8}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}.soccer.variant-1{width:61vw;max-width:1170px}.soccer.variant-1 .heading{font-size:6.8cqw}.soccer.variant-1 .heading::after{width:28%}.soccer.variant-1 .name{font-size:10cqw}.soccer.variant-1 .lane{height:21.5cqw}.soccer.variant-1 .points{flex-basis:19%;padding-right:3cqw}.soccer.variant-1 .footer{width:94%;justify-content:space-between;margin-top:4.2cqw;gap:45cqw}.soccer.variant-1 .stat.clock{flex:2 1 0}.soccer.variant-1 .stat .score-frame{height:11.5cqw}.soccer.variant-1 .stat .value{font-size:8.8cqw}.variant-2{width:60vw;max-width:1150px}.variant-2 .heading{text-align:center;font-size:8.6cqw}.variant-2 .heading::after{display:none}.duel{display:flex;align-items:stretch;margin-top:6.4cqw;min-width:0;position:relative}.duel::after{content:\"\";position:absolute;width:.65cqw;background:#ef442c;top:0;bottom:0;left:calc(50% - .325cqw)}.team{flex:1 1 0;min-width:0;text-align:center;display:flex;align-items:center;flex-direction:column;padding:0 2cqw 1.5cqw}.variant-2 .name{width:100%;flex:none;font-size:6cqw;margin:0 0 3.1cqw}.variant-2 .team .score-frame{width:33cqw;height:24cqw;margin:0}.variant-2 .team .score{font-size:19cqw}.variant-2 .team .corner{width:4cqw;height:4cqw}.variant-2 .footer{width:91%;margin-top:6.1cqw;gap:10cqw}.variant-2 .footer .label{font-size:2.8cqw}.variant-2 .footer .value{font-size:7.5cqw}.variant-2 .footer .stat .score-frame{height:10.5cqw}.soccer.variant-2 .heading{font-size:8.8cqw}.soccer.variant-2 .name{font-size:8.5cqw;margin-bottom:3.4cqw}.soccer.variant-2 .team .score-frame{width:29cqw;height:27cqw}.soccer.variant-2 .team .score{font-size:23.5cqw}.soccer.variant-2 .duel{margin-top:6.8cqw}.soccer.variant-2 .footer{width:43%;gap:5.8cqw;margin-top:6.8cqw}.soccer.variant-2 .footer .stat.clock{flex:2.5 1 0}.soccer.variant-2 .footer .stat .score-frame{margin-top:1.2cqw}.soccer.variant-2 .footer .stat+.stat::before{content:\"\";position:absolute;width:.25cqw;background:#f4f6f8;top:0;bottom:0;left:-2.9cqw}.soccer.variant-2 .footer .value{font-size:8.7cqw}@media(max-width:600px){.board,.variant-2,.soccer.variant-1{width:92vw}.points{flex-basis:20%}.soccer.variant-1 .points{flex-basis:21%;padding-right:1cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer basketball variant-2\" data-osb-component=\"layout\"><h1 class=\"heading\" data-osb-component=\"text\">BASKETBALL</h1><div class=\"duel rowContainer\" data-osb-component=\"layout\"><section class=\"team columnContainer\" data-osb-component=\"layout\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-frame\" data-osb-component=\"decoration\"><i class=\"corner tl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner tr\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner bl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner br\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"team columnContainer\" data-osb-component=\"layout\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-frame\" data-osb-component=\"decoration\"><i class=\"corner tl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner tr\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner bl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner br\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section></div><footer class=\"footer rowContainer\" data-osb-component=\"layout\"><div class=\"stat clock columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><div class=\"score-frame\" data-osb-component=\"decoration\"><i class=\"corner tl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner tr\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner bl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner br\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div></div><div class=\"stat period columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">PERIOD</span><div class=\"score-frame\" data-osb-component=\"decoration\"><i class=\"corner tl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner tr\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner bl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner br\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></div></div><div class=\"stat shot columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SHOT</span><div class=\"score-frame\" data-osb-component=\"decoration\"><i class=\"corner tl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner tr\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner bl\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><i class=\"corner br\" data-osb-component=\"decoration\" aria-hidden=\"true\"></i><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"shot-clock\">00</span></div></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\" currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\" currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\" jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\" jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
