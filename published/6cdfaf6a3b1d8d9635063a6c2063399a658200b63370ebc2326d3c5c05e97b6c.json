{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Network Broadcast Bar</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.bb-retained{display:none}\n.bb-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.8)}\n.diamond>.base{position:absolute;width:30%;height:37.5%;transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.06rem)}\n.diamond>.base.second{left:35%;top:10%}.diamond>.base.third{left:8%;top:44%}.diamond>.base.first{left:62%;top:44%}\n.diamond::before{content:\"\";position:absolute;left:calc(var(--d,3rem)*.309);top:calc(var(--d,3rem)*.311);width:calc(var(--d,3rem)*.382);height:calc(var(--d,3rem)*.382);transform:rotate(45deg);border:1px solid var(--base-edge,currentColor);opacity:.28}\n.bb-plate{display:none}\n.bb-bases{position:absolute;left:0;right:0;bottom:-.1rem;text-align:center;font:700 .42rem/1 var(--mono-ui,Menlo,Consolas,monospace);letter-spacing:.04em;color:var(--base-text,currentColor);opacity:.85}\n.bb-half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.bb-half-dim{position:absolute;inset:0}\n.bb-half-dim::before,.bb-half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.28))}\n.bb-half-dim::before,.bb-half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.bb-half-dim::before,.inningHalf::after{clip-path:polygon(50% 4%,96% 40%,4% 40%)}\n.bb-half-dim::after,.inningHalf::before{clip-path:polygon(4% 60%,96% 60%,50% 96%)}\n.bb-half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.bb-ls-col>.bb-gate{display:flex;flex-direction:column;align-items:stretch}\n.bb-tick{position:relative}.bb-tick>.bb-gate{display:block;position:absolute;inset:0;border-radius:inherit;background:var(--tick-on,#fff)}\n.bb-ls-extra{display:none!important}.bb-ls-extra:has(>.bb-gate[style*=\"opacity: 1\"]),.bb-ls-extra:has(>.bb-gate[style*=\"opacity:1\"]){display:flex!important}\n.bb-live,.bb-break,.bb-final{transition:opacity .25s ease}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.bb-stage{position:fixed;left:50%;bottom:2.4rem;transform:translateX(-50%);font-family:\"Avenir Next Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#ffffff}\n.br{display:flex;flex-direction:column;align-items:stretch;filter:drop-shadow(0 .3rem .7rem rgba(0,0,0,.4))}\n.br-bar{display:flex;align-items:stretch;height:2.75rem;border-radius:.3rem;overflow:hidden;background:#111317}\n.br-logo{display:flex;align-items:center;padding:0 .8rem;background:#e4002b;color:#fff;font:800 .7rem/1 \"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;letter-spacing:.16em}\n.br-team{position:relative;display:flex;align-items:center;width:13rem;isolation:isolate}\n.br-team .bb-jersey{position:absolute;inset:0;z-index:-1;background:#3a3f4a}\n.br-team::after{content:\"\";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(0,0,0,.05),rgba(0,0,0,.45))}\n.br-team .bb-name{flex:1;min-width:0;padding:0 .7rem;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:1.25rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.4)}\n.br-team .bb-runs{display:flex;align-items:center;justify-content:center;align-self:stretch;width:2.8rem;background:rgba(0,0,0,.55);color:#fff;font:800 1.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;font-variant-numeric:tabular-nums}\n.br-sit{position:relative;display:flex;align-items:center;gap:.9rem;padding:0 1rem;background:#111317}\n.bb-inning{display:flex;align-items:center;gap:.25rem;font:700 1.35rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;--half-on:#e4002b;--half-off:rgba(255,255,255,.22);--half-h:1.3rem;--half-size:.56rem}\n.br-sit .diamond{--d:2.9rem;--base-edge:#ffffff;--base-off:rgba(255,255,255,.08);--base-line:.1rem;--base-text:#a3a9b4}\n.bb-count{font:700 1.35rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;font-variant-numeric:tabular-nums}\n.bb-outs{display:flex;align-items:baseline;gap:.2rem;font:700 1.35rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif}.bb-outs-label{font-size:.6rem;letter-spacing:.12em;color:#a3a9b4}\n.br-sep{width:1px;align-self:stretch;margin:.5rem 0;background:rgba(255,255,255,.18)}\n.br-under{display:flex;align-items:center;justify-content:space-between;gap:1rem;height:1.2rem;margin:0 .6rem;padding:0 .7rem;border-radius:0 0 .25rem .25rem;background:#1d2027;color:#a3a9b4;font:700 .55rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.12em;text-transform:uppercase}\n.br-under>span{display:flex;gap:.5rem;align-items:center}\n.br-under .bb-round:not(:empty)::before{content:\"·\";margin-right:.5rem}\n.br-he{color:#ffffff;gap:.25rem!important}.br-he i{font-style:normal;color:#a3a9b4;margin-left:.5rem}\n.br-under .bb-track{display:flex;gap:.15rem}\n.bb-tick{width:.6rem;height:.22rem;border-radius:.1rem;background:rgba(255,255,255,.22);--tick-on:#e4002b}\n.bb-live{color:#e4002b}\n.bb-break{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#111317;font:700 .85rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.18em;color:#e4002b}\n</style></head><body><main class=\"bb-stage\" aria-label=\"Baseball lower-third scoreboard\">\n<article class=\"br columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball broadcast bar\">\n<div class=\"br-bar rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"br-logo\">BASEBALL</span>\n<div class=\"br-team\"><span class=\"bb-jersey jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"bb-name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"bb-runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><div class=\"br-team\"><span class=\"bb-jersey jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"bb-name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"bb-runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n<div class=\"br-sit\"><span class=\"bb-inning\"><span class=\"bb-half\"><span class=\"bb-half-dim\" aria-hidden=\"true\"></span><span class=\"bb-half-win\"><span class=\"inningHalf\" data-osb-component=\"field\"></span></span></span><span class=\"bb-inning-no inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"br-sep\"></span><span class=\"diamond\" aria-label=\"Bases\"><span class=\"base second\"></span><span class=\"base third\"></span><span class=\"base first\"></span><span class=\"bb-plate\" aria-hidden=\"true\"></span><span class=\"bb-bases bases\" data-osb-component=\"field\"></span></span><span class=\"br-sep\"></span><span class=\"bb-count\"><span class=\"bb-b balls\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"bb-dash\" aria-hidden=\"true\">-</span><span class=\"bb-s strikes\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"bb-outs\"><span class=\"bb-o outs\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span><span class=\"bb-outs-label\">OUT</span></span><span class=\"bb-break isInBetweenGames\" data-osb-component=\"field\" style=\"opacity: 0\">INNING BREAK</span></div></div>\n<div class=\"br-under\"><span><span class=\"bb-event eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"bb-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><span class=\"bb-live isMatchStarted\" data-osb-component=\"field\" style=\"opacity: 0\">LIVE</span></span><span class=\"br-he\"><i>H</i><span class=\"bb-h hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span>–<span class=\"bb-h hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span><i>E</i><span class=\"bb-e errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span>–<span class=\"bb-e errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></span><span class=\"bb-track\" aria-label=\"Innings\"><span class=\"bb-tick\"><span class=\"bb-gate isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame8Started\" data-osb-component=\"field\" data-osb-field=\"isGame8Started\" style=\"opacity: 0\"></span></span><span class=\"bb-tick\"><span class=\"bb-gate isGame9Started\" data-osb-component=\"field\" data-osb-field=\"isGame9Started\" style=\"opacity: 0\"></span></span></span></div>\n</article>\n<span class=\"bb-sr battingSide\" data-osb-component=\"field\"></span><span class=\"bb-retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"bb-retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main></body></html>\n","css":""}
