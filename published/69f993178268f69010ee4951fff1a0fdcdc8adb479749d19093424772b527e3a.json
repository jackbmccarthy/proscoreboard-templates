{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Rally Bar</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1;position:relative}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.18)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing,.ldot{animation:none!important;transition:none!important}}\n.nm{display:block;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;line-height:1.02}\n.bal{text-wrap:balance}\n.st,.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hv{position:relative;display:inline-grid;place-items:center}.hv>*{grid-area:1/1}.hv>.w{display:block;align-self:stretch;justify-self:stretch}.hv>.num{position:relative}\n.ev,.rd{white-space:nowrap}\n.hc:not([style*=\"opacity: 1\"]),.cell:not([style*=\"opacity: 1\"]){display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 0 .15rem #0b1a12,0 0 .4rem #0007}\n\n.stage{position:fixed;left:3.2rem;top:3.2rem}\n.board{position:relative;width:50rem;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff;filter:drop-shadow(0 .5rem 1.2rem #000a)}\n.head{display:flex;align-items:stretch;height:3.4rem;background:#08142e}\n.sslot{width:13.4rem;flex:none}.sslot>.st{padding:.35rem .8rem 0;font-size:1.9rem;letter-spacing:.08em;background:#f2b705;color:#08142e}\n.sslot .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;margin-left:.45rem}\n.sslot>.sdec{background:#ff6b1a;color:#fff}.sslot>.sbrk{background:#2b4aa0;color:#fff}.sslot>.sfin{background:#fff;color:#08142e}\n.sslot>.gp{background:#fff;color:#08142e;box-shadow:inset .6rem 0 0 #f2b705}.sslot>.mp{background:#ff2e4d;color:#fff}\n.ctx{flex:1;min-width:0;display:block;padding:.95rem 1rem 0;font-size:1.7rem;letter-spacing:.07em;text-transform:uppercase;color:#aebbe0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1}.ctx .sep{font-style:normal;color:#f2b705;margin:0 .55rem}\n.colh{flex:none;width:6rem;display:flex;align-items:center;justify-content:center;padding-top:.35rem;font-size:1.6rem;letter-spacing:.08em;color:#7d8fc4;background:#0b1c40}\n.r{position:relative;display:flex;align-items:stretch;min-height:6rem;background:#122a5c}.rB{border-top:.2rem solid #08142e}\n.chip{width:.8rem;flex:none}.chipA{background:#3fa7ff}.chipB{background:#ff5a4e}\n.pts{width:7.4rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem;background:#fff;color:#08142e;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:4.4rem;font-weight:700}\n.sv{width:3.4rem;flex:none;place-items:center}.vball{width:2.4rem;height:2.4rem}\n.win{display:grid;place-items:center;width:2.7rem;height:2.7rem;border-radius:50%;background:#f2b705;color:#08142e;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;font-size:1.8rem;font-weight:900}\n.who{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.5rem;padding:.6rem .6rem .3rem .4rem}\n.nm{font-size:2.6rem;font-weight:700;text-transform:uppercase}\n.pips{display:flex;gap:.4rem}.pip{position:relative;display:block;width:2.4rem;height:.8rem;border-radius:.4rem;box-shadow:inset 0 0 0 .15rem #8fa6e0}.pip>.lit{position:absolute;inset:0;border-radius:inherit;background:#f2b705}\n.sets{width:6rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem;background:#0b1c40;color:#f2b705;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.1rem;font-weight:700}\n.tob{position:absolute;left:100%;top:0;bottom:0;display:flex;align-items:center;gap:.6rem;padding:.35rem 1.1rem 0;background:#f2b705;color:#08142e;font-size:1.9rem;letter-spacing:.06em;white-space:nowrap}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.3rem}\n.foot{display:flex;align-items:stretch;min-height:3.4rem;background:#08142e}\n.hist{display:flex;align-items:stretch;margin-left:8.2rem}\n.hc{display:flex;align-items:center;gap:.25rem;padding:.3rem .9rem 0;border-right:.1rem solid #ffffff1a;font-size:1.7rem}\n.hc .hl{color:#7d8fc4;margin-right:.35rem}.hc .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:1.9rem;color:#fff}.hc .hd{font-style:normal;color:#7d8fc4}\n.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .foot,.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .foot .hist{height:0!important;min-height:0!important;padding-top:0!important;padding-bottom:0!important;margin-top:0!important;margin-bottom:0!important;border-width:0!important;overflow:hidden!important;align-items:flex-start!important;box-shadow:none!important;background:none!important}\n\n.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])){max-width:1px!important;min-width:0!important;padding:0!important;margin:0!important;border:0!important;overflow:hidden;color:transparent!important;background:none!important;box-shadow:none!important}.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])) *{color:transparent!important;background:none!important;box-shadow:none!important;border-color:transparent!important}\n.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .hist,.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .hist .hist{height:0!important;min-height:0!important;padding-top:0!important;padding-bottom:0!important;margin-top:0!important;margin-bottom:0!important;border-width:0!important;overflow:hidden!important;align-items:flex-start!important;box-shadow:none!important;background:none!important}\n.hc .hv{padding:.15rem .45rem 0;border-radius:.2rem}\n.hc .hv>.w{border-radius:.2rem;background:#f2b705;margin:-.15rem -.45rem 0}\n.hc .hv:has(>.w[style*=\"opacity: 1\"])>.num{color:#08142e}\n.hc:has(.w[style*=\"opacity: 1\"]) .hv:not(:has(>.w[style*=\"opacity: 1\"]))>.num{color:#8fa0cc}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{color:#f2b705}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{color:#08142e;background:#f2b705}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .rA .sets,.board:has(.isBWinner[style*=\"opacity: 1\"]) .rB .sets{background:#f2b705;color:#08142e}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.rB .who,.rB .sets,.rB .pts),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.rA .who,.rA .sets,.rA .pts){opacity:0.42}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"head\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"slot sslot pslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span><span class=\"st pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"st pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"ctx\"><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"colh\">SETS</span></div>\n<div class=\"r rA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipA jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"pts num ptsA currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"slot sv\"><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"win winA isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"><b>&#10003;</b></span></span><span class=\"who\"><span class=\"nm bal combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>