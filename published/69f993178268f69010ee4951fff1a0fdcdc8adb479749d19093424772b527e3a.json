"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></div>\n<div class=\"foot\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"hist\"><span class=\"hc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><b class=\"hl\">S1</b><span class=\"hv a\"><i class=\"w isGame1AWon\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></i><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame1BWon\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></i><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"hc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><b class=\"hl\">S2</b><span class=\"hv a\"><i class=\"w isGame2AWon\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></i><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame2BWon\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></i><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"hc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><b class=\"hl\">S3</b><span class=\"hv a\"><i class=\"w isGame3AWon\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></i><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><i class=\"hd\