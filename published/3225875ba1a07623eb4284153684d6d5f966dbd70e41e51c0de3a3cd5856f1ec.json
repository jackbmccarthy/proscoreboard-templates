{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Soccer — Porcelain Inkline, compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.board{display:flex;flex-direction:column;overflow:hidden;min-width:0;max-width:100%;container-type:inline-size;color:#202a2e;background:#f0f1ed;border:1px solid #c6cbc7}.header{display:flex;align-items:center;min-width:0;background:#202a2e;color:#fff;border-bottom:5px solid #397a78}.sport{font-weight:800;line-height:1;white-space:nowrap}.heading{font-weight:700;line-height:1;white-space:nowrap}.competitors{display:flex;min-width:0;background:#f0f1ed}.competitor{display:flex;align-items:stretch;min-width:0;background:#f0f1ed}.identity-tick{display:block;flex:none;background:#397a78}.jerseyColorB{background:#7da2a1}.name{display:block;align-content:center;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#202a2e;font-weight:700;line-height:1.05}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;min-width:0}.score{display:block;width:100%;color:#202a2e;text-align:center;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}.score-label{display:block;color:#647a7c;font-weight:700;line-height:1}.stats{display:flex;align-items:stretch;min-width:0;background:#202a2e;color:#fff}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;white-space:nowrap}.stat+.stat{border-left:2px solid #397a78}.stat-label{color:#aabebd;font-weight:700;line-height:1}.stat-value{color:#fff;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{width:min(60vw,1100px,calc((100vh - 24px)*2.28))}.header{height:7cqw;min-height:30px;justify-content:space-between;padding:0 3.2cqw}.sport{font-size:3.7cqw}.heading{font-size:2.7cqw}.competitors{flex-direction:column}.competitor{height:14.2cqw;min-height:53px}.competitor+.competitor{border-top:1px solid #c6cbc7}.identity-tick{width:3.3%}.name{padding:0 3.2cqw;font-size:7cqw}.score-track{width:22%;border-left:1px solid #c6cbc7}.score{font-size:8cqw}.stats{height:8.5cqw;min-height:38px}.stat{gap:2.8cqw}.stat-label{font-size:2.4cqw}.stat-value{font-size:4.8cqw}@media(max-width:600px){.board{width:100%}.header{border-bottom-width:2px}.sport{font-size:max(15px,3.7cqw)}.heading{font-size:max(10px,2.7cqw)}.stat{gap:.8cqw}.stat+.stat{border-left-width:1px}.stat-label{font-size:max(8px,2.1cqw)}.stat-value{font-size:max(15px,4.2cqw)}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-component=\"text\">SOCCER</span><span class=\"heading\" data-osb-component=\"text\">GOALS</span></header><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
