{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Linen Navy Sideconsole 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{display:flex;width:min(96vw,1512px);aspect-ratio:4.2;max-width:100%;overflow:hidden;border-radius:4px;background:#1f3242;color:#f8fafb;container-type:inline-size}\n.console{flex:0 0 19%;min-width:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20px;padding:18px 14px;background:#e7dfd0;color:#1f3242;text-align:center}\n.sport-tag{display:block;max-width:100%;overflow:hidden;font-size:clamp(16px,2cqw,30px);font-weight:800;line-height:1.1;white-space:nowrap;text-overflow:ellipsis}\n.console-rule{width:66%;height:2px;background:#99acb2}\n.console-status{display:flex;align-items:center;flex-direction:column;gap:4px;font-size:clamp(12px,1.8cqw,27px);font-weight:800;line-height:1}\n.current-set{font-size:clamp(29px,5.2cqw,77px);font-variant-numeric:tabular-nums}\n.lanes{flex:1 1 0;min-width:0;display:flex;flex-direction:column}\n.lane{flex:1 1 0;min-height:0;display:flex;align-items:stretch;min-width:0}\n.lane+.lane{border-top:2px solid #526a79}\n.identity{flex:0 0 26px;align-self:stretch;background:#2685a5}\n.jerseyColorB{background:#c96a60}\n.name{flex:1 1 0;min-width:0;display:flex;align-items:center;overflow:hidden;padding:0 44px;font-size:clamp(24px,5.1cqw,76px);font-weight:700;white-space:nowrap;text-overflow:ellipsis}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.support,.primary{align-self:center;flex-shrink:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.support{width:13%;height:84%;background:#aebfc2;color:#1f3242}\n.support-number{font-size:clamp(30px,4.6cqw,69px);font-weight:800;line-height:1}\n.support-label{font-size:clamp(11px,1.65cqw,25px);font-weight:800;line-height:1}\n.primary{width:25%;color:#f8fafb}\n.primary-number{font-size:clamp(49px,6.1cqw,94px);font-weight:800;line-height:1}\n.primary-label{font-size:clamp(12px,1.65cqw,25px);font-weight:800;letter-spacing:.03em;line-height:1}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.stage{padding:5px}.board{width:100%;height:136px;aspect-ratio:auto;border-radius:2px}.console{flex-basis:21%;gap:7px;padding:3px}.sport-tag{font-size:clamp(8px,2.3cqw,10px)}.console-rule{height:1px}.console-status{gap:1px;font-size:clamp(8px,2.7cqw,12px)}.current-set{font-size:clamp(20px,6.2cqw,28px)}.lane+.lane{border-top-width:1px}.identity{flex-basis:6px}.name{padding:0 7px;font-size:clamp(13px,5cqw,21px)}.support{width:17%;height:82%}.support-number{font-size:clamp(18px,6.2cqw,28px)}.support-label{font-size:clamp(7px,2.2cqw,10px)}.primary{width:25%}.primary-number{font-size:clamp(27px,9cqw,40px)}.primary-label{font-size:clamp(7px,2.3cqw,10px)}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Volleyball scoreboard with manual scoring\">\n  <aside class=\"console columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><span class=\"console-rule\" data-osb-component=\"layout\"></span><div class=\"console-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></aside>\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-label\" data-osb-component=\"text\">SETS</span></div><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span></div></div>\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-label\" data-osb-component=\"text\">SETS</span></div><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span></div></div>\n  </div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
