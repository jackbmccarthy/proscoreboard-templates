{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Matchup Panel</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;text-wrap:balance}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.22rem)}\n.dot{position:relative;flex:none;width:var(--dot,.62rem);height:var(--dot,.62rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18));box-shadow:inset 0 0 0 .08rem var(--dot-edge,transparent)}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:not(:empty)+.ev-r:not(:empty)::before{content:\"\\00b7\";margin:0 .4em;opacity:.7}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.3em}.st-live-in>i{width:.5em;height:.5em;border-radius:50%;background:currentColor;animation:osb-pulse 1.6s ease-in-out infinite}\n@keyframes osb-pulse{50%{transform:scale(.55)}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\n.ls{display:flex}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.tick{position:relative}.tick>.tick-on{position:absolute;inset:0;border-radius:inherit;background:var(--tick-on,#fff)}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;left:50%;bottom:2.4rem;transform:translateX(-50%);font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#2a1640}\n.pan{display:grid;grid-template-columns:30rem 15.5rem;grid-template-rows:auto auto;border-radius:.45rem;overflow:hidden;box-shadow:0 .4rem 1.1rem rgba(0,0,0,.4)}\n.hdr{grid-column:1/3;display:grid;grid-template-columns:1fr 3.6rem 2.4rem 2.4rem 15.5rem;align-items:center;height:1.6rem;background:#2a1640;color:#f4f0fa;font:700 .82rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}\n.hdr .ev{padding-left:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hdr>.c{text-align:center}\n.hdr .st{justify-self:stretch;justify-items:end;padding-right:1rem;color:#ffd43b}\n.teams{background:#fdfcff}\n.row{display:grid;grid-template-columns:.7rem 1fr 1.3rem 3.6rem 2.4rem 2.4rem;align-items:center;height:3rem}\n.row+.row{border-top:.06rem solid rgba(42,22,64,.12)}\n.chip{align-self:stretch;position:relative}\n.home{position:absolute;left:1.05rem;top:50%;transform:translateY(-50%);width:.55rem;height:.58rem;background:#6b5d7d;clip-path:polygon(0 0,100% 0,100% 55%,50% 100%,0 55%)}\n.nmw{min-width:0;padding:0 .4rem 0 2rem}\n.nm{font-weight:700;font-size:1.5rem;line-height:1;text-transform:uppercase;letter-spacing:.01em}\n.batw{display:flex;justify-content:center}.bat{width:.65rem;height:.65rem;border-radius:50%;background:#e8590c}\n.runs{display:flex;align-items:center;justify-content:center;align-self:stretch;background:#2a1640;color:#fff;font:700 2.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.he{text-align:center;font:700 1.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;color:#6b5d7d;font-variant-numeric:tabular-nums}\n.sit{position:relative;display:grid;grid-template-columns:auto 1fr;grid-template-rows:1fr 1fr;align-items:center;column-gap:1rem;padding:.3rem 1rem;background:#3b2357;color:#f7f3fb}\n.sit .diamond{grid-row:1/3;--d:4rem;--base-edge:#f7f3fb;--base-off:transparent;--base-on:#ffd43b;--base-line:.14rem}\n.topr{display:flex;align-items:center;justify-content:space-between}\n.inn{display:flex;align-items:center;gap:.15rem;font:700 1.8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;--half-on:#e8590c;--half-off:rgba(255,255,255,.22);--half-h:1.8rem;--half-size:.77rem}\n.count{font:700 1.7rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}.count .dash{opacity:.55;margin:0 .06em}\n.bso{display:flex;align-items:center;justify-content:space-between;font:700 .95rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.08em;color:#c2b3d3;--dot:.66rem;--dot-gap:.2rem;--dot-off:rgba(255,255,255,.18)}\n.bso>span{display:flex;align-items:center;gap:.3rem}\n.ball-dots{--dot-on:#58d68d}.strike-dots{--dot-on:#ff6b6b}.out-dots{--dot-on:#ffd43b}\n.cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.25rem;background:#3b2357;text-transform:uppercase;text-align:center;z-index:2}\n.cover b{font:700 .78rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#c2b3d3}\n.cover .periodLabel{font:700 1.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em}\n.cover.fin{font:700 1.8399999999999999rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;color:#ffd43b}\n.cover{color:#f7f3fb}\n.foot{grid-column:1/3;display:flex;align-items:center;justify-content:flex-end;height:.9rem;padding:0 1rem;background:#2a1640}\n.ticks{display:flex;gap:.22rem}.tick{width:1rem;height:.26rem;border-radius:.13rem;background:rgba(255,255,255,.2);--tick-on:#ffd43b}\n</style></head><body><main class=\"board\" aria-label=\"Softball lower-third scoreboard\">\n<div class=\"pan columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball matchup panel\">\n<div class=\"hdr\"><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"c\">R</span><span class=\"c\">H</span><span class=\"c\">E</span><span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span></span></div>\n<div class=\"teams\"><div class=\"row\"><span class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"home isAHome\" data-osb-component=\"field\" data-osb-field=\"isAHome\" style=\"opacity: 0\"></span></span><span class=\"nmw\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"batw\"><span class=\"bat isABatting\" data-osb-component=\"field\" data-osb-field=\"isABatting\" style=\"opacity: 0\"></span></span><span class=\"runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"he hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"he errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span></div><div class=\"row\"><span class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"home isBHome\" data-osb-component=\"field\" data-osb-field=\"isBHome\" style=\"opacity: 0\"></span></span><span class=\"nmw\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span><span class=\"batw\"><span class=\"bat isBBatting\" data-osb-component=\"field\" data-osb-field=\"isBBatting\" style=\"opacity: 0\"></span></span><span class=\"runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"he hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span><span class=\"he errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></div></div>\n<div class=\"sit\"><span class=\"diamond\" aria-label=\"Bases\"><span class=\"base second\"><span class=\"runner isRunnerOnSecond\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnSecond\" style=\"opacity: 0\"></span></span><span class=\"base third\"><span class=\"runner isRunnerOnThird\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnThird\" style=\"opacity: 0\"></span></span><span class=\"base first\"><span class=\"runner isRunnerOnFirst\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnFirst\" style=\"opacity: 0\"></span></span></span><span class=\"topr\"><span class=\"inn\"><span class=\"half\" aria-hidden=\"true\"><span class=\"half-dim\"></span><span class=\"half-win\"><span class=\"inningHalf\" data-osb-component=\"field\"></span></span></span><span class=\"inn-n inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"count\"><span class=\"cb balls\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"dash\" aria-hidden=\"true\">-</span><span class=\"cs strikes\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span></span><span class=\"bso\"><span>B<span class=\"dots ball-dots\"><span class=\"dot\"><span class=\"lit isBall1\" data-osb-component=\"field\" data-osb-field=\"isBall1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall2\" data-osb-component=\"field\" data-osb-field=\"isBall2\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall3\" data-osb-component=\"field\" data-osb-field=\"isBall3\" style=\"opacity: 0\"></span></span></span></span><span>S<span class=\"dots strike-dots\"><span class=\"dot\"><span class=\"lit isStrike1\" data-osb-component=\"field\" data-osb-field=\"isStrike1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isStrike2\" data-osb-component=\"field\" data-osb-field=\"isStrike2\" style=\"opacity: 0\"></span></span></span></span><span>O<span class=\"dots out-dots\"><span class=\"dot\"><span class=\"lit isOut1\" data-osb-component=\"field\" data-osb-field=\"isOut1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isOut2\" data-osb-component=\"field\" data-osb-field=\"isOut2\" style=\"opacity: 0\"></span></span></span></span></span><span class=\"cover isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0\"><b>End of</b><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\"></span></span><span class=\"cover fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\">Final</span></div>\n<div class=\"foot\"><span class=\"ticks\" aria-label=\"Innings\"><span class=\"tick\"><span class=\"tick-on isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"></span></span></span></div>\n</div>\n<span class=\"sr\"><span class=\"battingSide\" data-osb-component=\"field\" data-osb-field=\"battingSide\"></span><span class=\"bases\" data-osb-component=\"field\" data-osb-field=\"bases\"></span><span class=\"outs\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></span><span class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></span></span>\n</main></body></html>\n","css":""}
