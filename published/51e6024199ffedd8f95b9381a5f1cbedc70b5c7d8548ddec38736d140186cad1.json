{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Inning Break Card</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.teamAName:empty::before{content:\"Team A\"}.teamBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}\n.slab{position:relative;flex:none;overflow:hidden}.slab>.jc{position:absolute;inset:0}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.25rem)}\n.dot{position:relative;flex:none;width:var(--dot,.82rem);height:var(--dot,.82rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18))}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.st{position:relative;display:inline-grid;align-items:center;white-space:nowrap}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.45em}.st-live-in>i{flex:none;width:.9rem;height:.9rem;border-radius:50%;background:var(--live,#ff3b30);box-shadow:0 0 .45rem var(--live,#ff3b30);animation:osb-pulse 1.4s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.7}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ls{display:flex}\n.ls-col{position:relative}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.ls-gate{display:flex;flex-direction:column;position:relative}\n.ls-cur{position:absolute;inset:0;pointer-events:none}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#f6f4ef;background:transparent;--live:#ff3b30;--gold:#ffd166;--ink:#2a0d13;--mute:#cdb9bb}\n.card{width:74rem;display:flex;flex-direction:column;gap:1.1rem;padding:1.7rem 2.2rem 2rem;border-radius:1rem;background:linear-gradient(160deg,#4a1420 0%,#1c0b10 100%);box-shadow:0 1.2rem 3rem rgba(0,0,0,.45),inset 0 0 0 .08rem rgba(255,255,255,.07)}\n/* head: sport and status, event, then the state headline (FIRST PITCH, the live half, END OF a half, FINAL) */\n.head{display:flex;flex-direction:column;align-items:center;gap:.6rem;text-align:center}\n.spk{display:flex;align-items:center;gap:1rem;font:700 1.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.24em;color:var(--gold)}\n.spk .st{font:700 1.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em}\n.spk .st-pre{padding:.4rem .8rem;border-radius:.25rem;box-shadow:inset 0 0 0 .1rem rgba(255,255,255,.35);color:var(--mute)}\n.spk .st-live{padding:.4rem .8rem;border-radius:.25rem;background:rgba(255,59,48,.16);box-shadow:inset 0 0 0 .1rem rgba(255,59,48,.6);color:#fff}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .spk .st{display:none}\n.ev{display:flex;align-items:baseline;justify-content:center;gap:.9rem;max-width:62rem;min-width:0;font:700 1.35rem/1.2 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);white-space:nowrap}\n.ev>span{min-width:0;overflow:hidden;text-overflow:ellipsis}.ev>.ev-r{flex:none}\n.ev-e:empty,.ev-r:empty,.ev-e:empty+.sep,.sep:has(+.ev-r:empty){display:none}\n.sep{flex:none;font-style:normal;opacity:.8}\n.state{display:grid;place-items:center;min-height:5.2rem}\n.state>*{grid-area:1/1}\n.hl{display:flex;align-items:center;gap:1.4rem;font:700 4.6rem/1 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.03em;text-transform:uppercase}\n.s-pre,.s-brk,.s-live,.s-fin{opacity:0}\n.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .s-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .s-fin{opacity:1}\n.s-brk{gap:1.2rem}\n.s-brk .chip{padding:.55rem 1.4rem;border-radius:.3rem;background:var(--gold);color:var(--ink);font:700 1.8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.2em}\n.s-brk .periodLabel{color:var(--gold)}\n.s-live{font-size:3.2rem;color:#fff}.s-live .periodLabel{color:#fff;padding-bottom:.35rem;box-shadow:inset 0 -.25rem 0 #d72a22}\n.s-live .lv{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem .9rem;border-radius:.3rem;background:#d72a22;font:700 1.4rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em}\n.s-live .lv>i{width:.8rem;height:.8rem;border-radius:50%;background:#fff}\n.board:has(.st-live[style*=\"opacity: 1\"]):not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):not(:has(.isComplete[style*=\"opacity: 1\"])) .s-live{opacity:1}\n.s-fin{color:var(--gold)}\n/* team panels */\n.teams{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}\n.tp{position:relative;display:grid;grid-template-columns:1fr 9rem;align-items:stretch;height:8.6rem;border-radius:.6rem;overflow:hidden;background:rgba(255,255,255,.07)}\n.tp.b{grid-template-columns:9rem 1fr}.tp.b .rb{order:1}.tp.b .tx{order:2;align-items:flex-end;text-align:right}\n.tx{display:flex;flex-direction:column;justify-content:center;gap:.6rem;min-width:0;padding:0 1.6rem}\n.kk{display:grid;font:700 1.05rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:var(--mute)}.kk>*{grid-area:1/1}\n.tp.b .kk{justify-items:end}.kk>.hm{color:var(--gold)}\n.kk>.kv{opacity:0}.teams:has(.isBHome[style*=\"opacity: 1\"]) .tp.a .kv,.teams:has(.isAHome[style*=\"opacity: 1\"]) .tp.b .kv{opacity:1}\n.nm{font:700 2.4rem/1.02 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.01em}\n.sub{display:flex;align-items:center;gap:1.3rem;font:700 1.45rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.08em;color:var(--mute)}\n.sub .he{color:#fff;margin-left:.45rem}\n.slot{display:grid;align-items:center}.slot>*{grid-area:1/1}.tp.b .slot{order:-1;justify-items:end}\n.batl{display:flex;align-items:center;gap:.5rem;padding:.35rem .7rem;border-radius:.25rem;background:rgba(255,209,102,.16);color:var(--gold);font-size:1.15rem;letter-spacing:.14em;text-transform:uppercase;opacity:0}\n.batl:has(>.bat[style*=\"opacity: 1\"]){opacity:1}.batl .bat{width:.9rem;height:.9rem;border-radius:50%;background:var(--gold)}\n.dup{padding:.35rem .7rem;border-radius:.25rem;box-shadow:inset 0 0 0 .1rem rgba(255,209,102,.6);color:var(--gold);font-size:1.15rem;letter-spacing:.14em;text-transform:uppercase;opacity:0}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .tp.a .dup,.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .tp.a .dup{opacity:1}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .card:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 1\"]+.pb[style*=\"opacity: 0\"]) .tp.a .dup,.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .card:has(.isAHome[style*=\"opacity: 1\"]):not(:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 0\"]+.pb[style*=\"opacity: 1\"])) .tp.a .dup,.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .card:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 1\"]+.pb[style*=\"opacity: 0\"]) .tp.a .dup,.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .card:has(.isAHome[style*=\"opacity: 1\"]):not(:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 0\"]+.pb[style*=\"opacity: 1\"])) .tp.a .dup{opacity:0}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .card:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 1\"]+.pb[style*=\"opacity: 0\"]) .tp.b .dup,.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .card:has(.isAHome[style*=\"opacity: 1\"]):not(:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 0\"]+.pb[style*=\"opacity: 1\"])) .tp.b .dup,.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .card:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 1\"]+.pb[style*=\"opacity: 0\"]) .tp.b .dup,.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .card:has(.isAHome[style*=\"opacity: 1\"]):not(:has(.ls-gate[style*=\"opacity: 1\"]>.pa[style*=\"opacity: 0\"]+.pb[style*=\"opacity: 1\"])) .tp.b .dup{opacity:1}\n.rb{position:relative;display:flex;align-items:center;justify-content:center}\n.rb>.slab{position:absolute;inset:0;width:auto}.slab{background:var(--fb)}.slab-a{--fb:#56739a}.slab-b{--fb:#a3634f}\n.rb::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(0,0,0,.3))}\n.rb .runs{position:relative;z-index:1;font:700 4.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;color:#fff;text-shadow:0 .1rem .5rem rgba(0,0,0,.5)}\n/* final: the winner is outlined in gold with a check marker on its runs box; the loser keeps its colours, its text steps back */\n.tp::before{content:\"\";position:absolute;inset:0;z-index:2;border-radius:inherit;box-shadow:inset 0 0 0 .25rem var(--gold);opacity:0;pointer-events:none}\n.tp:has(.win[style*=\"opacity: 1\"])::before{opacity:1}\n.win{position:absolute;top:.6rem;z-index:3;display:flex;align-items:center;justify-content:center;width:2.2rem;height:2.2rem;border-radius:50%;background:var(--gold)}\n.win::after{content:\"\";width:.55rem;height:1rem;margin-top:-.2rem;border:solid var(--ink);border-width:0 .25rem .25rem 0;transform:rotate(45deg)}\n.tp.a .win{right:.6rem}.tp.b .win{left:.6rem}\n.teams:has(.isBWinner[style*=\"opacity: 1\"]) .tp.a :is(.nm,.sub,.he,.kk>*),.teams:has(.isAWinner[style*=\"opacity: 1\"]) .tp.b :is(.nm,.sub,.he,.kk>*){color:#a99598}\n/* line score */\n.lsw{--hh:2.3rem;--ch:3.6rem;display:flex;border-radius:.5rem;overflow:hidden;background:rgba(255,255,255,.05)}\n.ls-h{display:flex;align-items:center;justify-content:center;height:var(--hh);background:rgba(255,255,255,.1);color:#ecdedc;font:700 1.25rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif}\n.ls-col{display:flex;flex-direction:column;flex:1 1 0;min-width:0;border-left:.07rem solid rgba(255,255,255,.08)}\n.ls-col::after{content:\"\";position:absolute;left:0;right:0;top:calc(var(--hh) + var(--ch));height:.07rem;background:rgba(255,255,255,.08)}\n.ls-p,.v,.ln{height:var(--ch)}\n.v+.v,.ln+.ln{border-top:.07rem solid rgba(255,255,255,.08)}\n.ls-p{display:flex;align-items:center;justify-content:center}\n.ls-p,.v{font:700 1.8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.ls-cur{background:rgba(255,209,102,.14)}\n.ls-col:has(>.ls-cur[style*=\"opacity: 1\"])>.ls-h{background:var(--gold);color:var(--ink)}\n.ls-extra .ls-h{color:var(--gold)}\n.lnames{flex:0 1 auto;min-width:15rem;max-width:30rem;display:flex;flex-direction:column}\n.lsw .ls{flex:1;min-width:0}\n.ln{display:flex;align-items:center}\n.ln>.slab{align-self:stretch;width:1rem}\n.lnw{min-width:0;padding:0 1.2rem 0 1rem}\n.lbl{display:block;font:700 1.45rem/1.05 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#f6f4ef;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}\n.tot{flex:none;display:flex;border-left:.15rem solid rgba(255,255,255,.12)}\n.tot>span{display:flex;flex-direction:column;width:3.6rem;border-left:.07rem solid rgba(255,255,255,.08)}\n.v{display:flex;align-items:center;justify-content:center;color:var(--mute)}\n.tot>span:first-child{width:4.2rem;border-left:0}.tot>span:first-child .v{color:#fff;font-size:2.1rem}\n.card:has(.isBWinner[style*=\"opacity: 1\"]) :is(.ln-a .lbl,.pa,.va),.card:has(.isAWinner[style*=\"opacity: 1\"]) :is(.ln-b .lbl,.pb,.vb){color:#a99598!important}\n/* situation: live only, four labelled zones across the card */\n.sit{position:relative;display:grid;grid-template-columns:repeat(4,1fr);height:6.8rem;overflow:hidden;border-radius:.5rem;background:rgba(255,255,255,.07)}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .sit{height:4.6rem}\n.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .sit,.board:has(.isInBetweenGames[style*=\"opacity: 1\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .sit{display:none}\n.z{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.55rem;min-width:0}\n.z+.z{border-left:.08rem solid rgba(255,255,255,.12)}\n.zl{font:700 1.15rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--mute)}\n.zv{display:flex;align-items:center;justify-content:center;gap:1rem;height:3.6rem}\n.inn{display:flex;align-items:center;gap:.3rem;font:700 3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;--half-on:var(--gold);--half-off:rgba(255,255,255,.2);--half-h:3rem;--half-size:1.3rem}\n.inn-n{min-width:1.1em;text-align:left}\n.diamond{--d:5rem;--base-edge:#f1e6e4;--base-off:rgba(255,255,255,.06);--base-on:var(--gold);--base-line:.16rem}\n.count{font:700 3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.02em}.count .dash{opacity:.6;margin:0 .08em}\n.bs{display:flex;flex-direction:column;gap:.4rem;--dot:1.15rem;--dot-gap:.3rem;--dot-off:rgba(255,255,255,.18)}\n.bs>span{display:flex;align-items:center;gap:.5rem;font:700 1.15rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;color:var(--mute)}.bs b{width:1rem}\n.ball-dots{--dot-on:#4fdc8a}.strike-dots{--dot-on:#ff5a52}\n.out-dots{--dot:1.5rem;--dot-gap:.6rem;--dot-off:rgba(255,255,255,.18);--dot-on:var(--gold)}\n.c-fin{position:absolute;inset:0;display:none;align-items:center;justify-content:center;border-radius:.5rem;background:#2e1218}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .c-fin{display:flex}\n.inns{display:flex;align-items:baseline;gap:.45em;font:700 2.1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:var(--mute);text-transform:uppercase}\n.inns>.inning{color:var(--gold)}\n</style></head><body><main class=\"board\" aria-label=\"Baseball full-screen scoreboard\">\n<section class=\"card columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball inning break\">\n<div class=\"head\"><span class=\"spk\">BASEBALL<span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span></span></span><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">·</i><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"state\"><span class=\"hl s-pre\">First pitch</spa