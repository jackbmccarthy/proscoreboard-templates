{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Porcelain Inkline Volleyball — Paired Rows</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { width: 100%; min-height: 100%; margin: 0; background: transparent; }\n    body { font-family: Arial, Helvetica, sans-serif; }\n    .stage { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 12px; }\n    .board { display: flex; flex-direction: column; width: min(61vw, 1120px); max-width: 100%; overflow: hidden; background: #f0f1ed; color: #202a2e; container-type: inline-size; }\n    .header { display: flex; align-items: stretch; height: 7.4cqw; min-height: 30px; background: #202a2e; color: #fff; border-bottom: .45cqw solid #397a78; }\n    .sport { display: flex; align-items: center; flex: 1 1 0; min-width: 0; padding-left: 3.2cqw; font-size: 4.15cqw; font-weight: 800; line-height: 1; white-space: nowrap; }\n    .header-label { display: flex; align-items: center; justify-content: center; flex: none; font-size: 2.35cqw; font-weight: 700; line-height: 1; }\n    .sets-track { width: 14.3%; }\n    .points-track { width: 19.7%; }\n    .teams { display: flex; flex-direction: column; min-width: 0; }\n    .team { display: flex; align-items: stretch; height: 11.65cqw; min-height: 56px; background: #f0f1ed; }\n    .team + .team { border-top: 1px solid #c6cbc7; }\n    .tick { display: block; flex: 0 0 3%; background: #397a78; }\n    .jerseyColorB { background: #7da2a1; }\n    .name { display: block; align-content: center; flex: 1 1 0; min-width: 0; overflow: hidden; padding: 0 2.6cqw; color: #202a2e; font-size: 5.8cqw; font-weight: 700; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .score { display: flex; align-items: center; justify-content: center; flex: none; border-left: 1px solid #c6cbc7; color: #202a2e; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n    .sets-score { font-size: 5.5cqw; }\n    .points-score { font-size: 8.5cqw; }\n    .footer { display: flex; align-items: center; justify-content: center; height: 7.5cqw; min-height: 40px; background: #202a2e; color: #fff; }\n    .set-group { display: flex; align-items: center; justify-content: center; gap: 1.6cqw; height: 50%; padding: 0 2.6cqw; border-right: .35cqw solid #397a78; border-left: .35cqw solid #397a78; white-space: nowrap; }\n    .set-label { color: #c1cfcd; font-size: 2.8cqw; font-weight: 700; line-height: 1; }\n    .set-value { color: #fff; font-size: 5.2cqw; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }\n    .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint,\n    .point-slot:has(> .isMatchPoint[style*=\"opacity:1\"]) > .isGamePoint { opacity: 0 !important; }\n    @media (max-width: 600px) {\n      .board { width: 100%; }\n      .header { height: 32px; border-bottom-width: 2px; }\n      .sport { padding-left: 10px; font-size: 15px; }\n      .header-label { font-size: 10px; }\n      .team { height: 58px; }\n      .name { padding: 0 9px; font-size: clamp(18px, 5.8vw, 25px); }\n      .sets-score { font-size: 24px; }\n      .points-score { font-size: 35px; }\n      .footer { height: 40px; }\n      .set-group { gap: 8px; padding: 0 13px; border-width: 2px; }\n      .set-label { font-size: 13px; }\n      .set-value { font-size: 23px; }\n    }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n  <main class=\"stage\" data-osb-component=\"layout\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"sport\" data-osb-component=\"text\">VOLLEYBALL</span>\n        <span class=\"header-label sets-track\" data-osb-component=\"text\">SETS</span>\n        <span class=\"header-label points-track\" data-osb-component=\"text\">POINTS</span>\n      </header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <span class=\"score sets-score sets-track currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n          <span class=\"score points-score points-track currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span>\n        </div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <span class=\"score sets-score sets-track currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n          <span class=\"score points-score points-track currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span>\n        </div>\n      </div>\n      <footer class=\"footer rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"set-group rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"set-label\" data-osb-component=\"text\">SET</span><span class=\"set-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></div>\n      </footer>\n      <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
