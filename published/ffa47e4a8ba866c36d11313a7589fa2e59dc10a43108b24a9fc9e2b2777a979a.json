{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Burgundy Sand soccer 1</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#273537}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;min-width:0;padding:14px 0}.board{width:min(55.8vw,calc((100vh - 28px)*2.6));max-width:1330px;container-type:inline-size;min-width:0;background:#e8e4db;border:1px solid #b6b4ad;overflow:hidden}.header{display:flex;align-items:center;min-width:0;min-height:6.1cqw;background:#e8e4db;border-bottom:1px solid #b6b4ad}.sport-tab{display:block;flex:0 0 27.5%;min-width:0;margin:0;background:#893d4d;color:#ffffff;font-size:3.5cqw;line-height:1.1;padding:1.1cqw 2cqw;white-space:nowrap}.column-label{display:block;flex:0 0 24.5%;min-width:0;margin-left:auto;text-align:center;font-size:3.5cqw;line-height:1.1;white-space:nowrap}.row{display:flex;align-items:stretch;min-width:0;min-height:11.7cqw;background:#e8e4db;border-bottom:1px solid #b6b4ad}.identity{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:1.2cqw 2cqw;gap:4.1cqw}.tick{display:block;flex:0 0 3px;min-width:0;height:8.5cqw;background:#893d4d}.name{display:block;flex:1 1 0;min-width:0;font-size:5.9cqw;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.025em;color:#273537}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-zone{display:flex;align-items:center;justify-content:center;flex:0 0 24.5%;min-width:0;background:#183336}.score{display:block;width:100%;min-width:0;text-align:center;white-space:nowrap;font-size:8.75cqw;line-height:1.1;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:#ffffff}.footer{display:flex;align-items:stretch;justify-content:center;min-width:0;min-height:10.2cqw;padding:1cqw 0;background:#183336;color:#ffffff}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:2cqw;padding:0 .8cqw}.stat+.stat{border-left:1px solid #b6b4ad}.label{display:block;font-size:2.8cqw;line-height:1.1;white-space:nowrap;color:#d3828d}.value{display:block;font-size:5.3cqw;line-height:1.1;font-variant-numeric:tabular-nums;color:#ffffff}.basketball.variant-1 .stat,.soccer.variant-1 .stat{flex-direction:column;gap:.3cqw}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}.variant-2{width:min(81vw,calc((100vh - 28px)*5.7));max-width:1760px}.duel{display:flex;align-items:stretch;min-width:0;min-height:7.65cqw;border-bottom:1px solid #b6b4ad}.endcap{display:flex;align-items:center;justify-content:center;flex:0 0 13.6cqw;min-width:0;background:#893d4d;color:#ffffff}.endcap .sport-title{display:block;min-width:0;margin:0;font-size:1.6cqw;line-height:1.1;padding:.8cqw .5cqw;white-space:nowrap;color:#ffffff}.competitors{display:flex;align-items:stretch;flex:1 1 0;min-width:0}.variant-2 .row{flex:1 1 0;min-width:0;min-height:7.65cqw;border-bottom:0}.variant-2 .row+.row{border-left:1px solid #b6b4ad}.variant-2 .identity{padding:.9cqw 2.3cqw;gap:2.3cqw}.variant-2 .tick{height:5.5cqw}.variant-2 .name{font-size:3.8cqw}.variant-2 .score-zone{flex:0 0 15.5cqw;flex-direction:column;gap:.4cqw}.variant-2 .score-zone .label{font-size:1.8cqw;color:#ffffff}.variant-2 .score{font-size:4.6cqw}.variant-2 .footer{min-height:5.25cqw;padding:.8cqw 0}.variant-2 .footer .label{font-size:1.9cqw}.variant-2 .value{font-size:3.1cqw}.variant-2 .stat{gap:2.8cqw}.soccer.variant-1{width:min(58.5vw,calc((100vh - 28px)*2.4));max-width:1410px}.soccer.variant-1 .header{min-height:6.2cqw}.soccer.variant-1 .sport-tab{flex-basis:18.8%;font-size:3.3cqw;padding:1cqw 2cqw}.soccer.variant-1 .column-label{flex-basis:26%;font-size:3.4cqw}.soccer.variant-1 .row{min-height:11.86cqw}.soccer.variant-1 .identity{padding:1.2cqw 2.5cqw;gap:4cqw}.soccer.variant-1 .tick{height:9.1cqw}.soccer.variant-1 .name{font-size:6.6cqw}.soccer.variant-1 .score-zone{flex-basis:26%}.soccer.variant-1 .score{font-size:8.9cqw}.soccer.variant-1 .footer{min-height:12.4cqw;padding:1.6cqw 0}.soccer.variant-1 .stat{flex:0 0 27cqw}.soccer.variant-1 .footer .label{font-size:3.2cqw}.soccer.variant-1 .value{font-size:5.3cqw}.soccer.variant-2{width:min(77.4vw,calc((100vh - 28px)*6));max-width:1680px}.soccer.variant-2 .endcap{flex-basis:11.4cqw}.soccer.variant-2 .endcap .sport-title{font-size:2.1cqw}.soccer.variant-2 .duel,.soccer.variant-2 .row{min-height:7.57cqw}.soccer.variant-2 .identity{padding:.8cqw 1.8cqw;gap:2.2cqw}.soccer.variant-2 .name{font-size:3.8cqw}.soccer.variant-2 .tick{height:4.8cqw}.soccer.variant-2 .score-zone{flex-basis:13.25cqw;gap:.4cqw}.soccer.variant-2 .score-zone .label{font-size:1.8cqw}.soccer.variant-2 .score{font-size:4.9cqw}.soccer.variant-2 .footer{min-height:4.86cqw;padding:.8cqw 0;gap:4cqw}.soccer.variant-2 .stat,.soccer.variant-2 .stat.clock{flex:none;gap:2.8cqw;padding:0}.soccer.variant-2 .stat+.stat{padding-left:4cqw}.soccer.variant-2 .footer .label{font-size:2.15cqw}.soccer.variant-2 .value{font-size:3cqw}@media(max-width:600px){.board,.variant-2,.soccer.variant-1,.soccer.variant-2{width:94vw}.header,.soccer.variant-1 .header{min-height:44px}.sport-tab,.soccer.variant-1 .sport-tab{flex:0 1 auto;padding:10px 12px;font-size:14px}.column-label,.soccer.variant-1 .column-label{flex:0 0 80px;font-size:12px}.row,.soccer.variant-1 .row{min-height:64px}.identity,.soccer.variant-1 .identity{padding:10px 12px;gap:12px}.tick,.soccer.variant-1 .tick{flex-basis:3px;height:36px}.name,.soccer.variant-1 .name{font-size:22px}.score-zone,.soccer.variant-1 .score-zone{flex-basis:84px}.score,.soccer.variant-1 .score{font-size:34px}.footer,.soccer.variant-1 .footer{min-height:60px;padding:10px 0}.stat{gap:8px;padding:0 5px}.footer .label,.variant-2 .footer .label,.soccer.variant-1 .footer .label,.soccer.variant-2 .footer .label{font-size:11px}.value,.variant-2 .value,.soccer.variant-1 .value,.soccer.variant-2 .value{font-size:20px}.duel{flex-direction:column}.endcap,.soccer.variant-2 .endcap{flex:none;width:100%;min-height:44px;justify-content:flex-start;padding:10px 14px}.endcap .sport-title,.soccer.variant-2 .endcap .sport-title{font-size:15px;padding:0}.competitors{flex-direction:column;width:100%;min-width:0}.variant-2 .row,.soccer.variant-2 .row{flex:none;width:100%;min-height:64px}.variant-2 .row+.row{border-left:0;border-top:1px solid #b6b4ad}.variant-2 .identity,.soccer.variant-2 .identity{padding:10px 14px;gap:12px}.variant-2 .tick,.soccer.variant-2 .tick{height:36px}.variant-2 .name,.soccer.variant-2 .name{font-size:22px}.variant-2 .score-zone,.soccer.variant-2 .score-zone{flex-basis:84px;gap:3px;padding:5px 0}.variant-2 .score-zone .label{font-size:10px}.variant-2 .score,.soccer.variant-2 .score{font-size:34px}.variant-2 .footer,.soccer.variant-2 .footer{min-height:58px;padding:10px 0;gap:0}.variant-2 .stat{gap:8px;padding:0 5px}.soccer.variant-2 .stat,.soccer.variant-2 .stat.clock{gap:8px;padding:0 14px}.soccer.variant-2 .stat+.stat{padding-left:14px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer soccer variant-1\" data-osb-component=\"layout\"><header class=\"header rowContainer\" data-osb-component=\"layout\"><h1 class=\"sport-tab\" data-osb-component=\"text\">SOCCER</h1><span class=\"column-label\" data-osb-component=\"text\">GOALS</span></header><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-zone columnContainer\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-zone columnContainer\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section><footer class=\"footer rowContainer\" data-osb-component=\"layout\"><div class=\"stat clock rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat half rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">HALF</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\" currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\" currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
