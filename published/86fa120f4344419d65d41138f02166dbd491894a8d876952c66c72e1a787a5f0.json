{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Final Line Score</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;text-wrap:balance}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.22rem)}\n.dot{position:relative;flex:none;width:var(--dot,.62rem);height:var(--dot,.62rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18));box-shadow:inset 0 0 0 .08rem var(--dot-edge,transparent)}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:not(:empty)+.ev-r:not(:empty)::before{content:\"\\00b7\";margin:0 .4em;opacity:.7}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.3em}.st-live-in>i{width:.5em;height:.5em;border-radius:50%;background:currentColor;animation:osb-pulse 1.6s ease-in-out infinite}\n@keyframes osb-pulse{50%{transform:scale(.55)}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\n.ls{display:flex}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.tick{position:relative}.tick>.tick-on{position:absolute;inset:0;border-radius:inherit;background:var(--tick-on,#fff)}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#f5f8f3;background:radial-gradient(ellipse at 50% 30%,rgba(22,58,40,.96),rgba(6,18,12,.97))}\n.sum{width:68rem;display:flex;flex-direction:column;gap:1.2rem}\n.topr{display:flex;align-items:flex-end;justify-content:space-between}\n.ttl{display:flex;flex-direction:column;gap:.5rem}\n.kick{font:700 1.15rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#9fbaa8}\n.ev{font:700 2.6rem/1 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.01em}\n.ev .ev-e:not(:empty)+.ev-r:not(:empty)::before{margin:0 .3em}\n.ev .ev-r{color:#e4f23a}\n.badge{position:relative;display:grid;align-items:center;justify-items:end}\n.badge>*{grid-area:1/1}\n.badge .st{font:700 1.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#e4f23a}\n.isComplete{padding:.55rem 1.4rem;border-radius:.3rem;background:#e4f23a;color:#10261b;font:700 1.9rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em}\n.lsw-wrap{position:relative}\n.lsw .ls-names{position:relative}\n\n.lsw{display:flex;background:#10261b;border-radius:.4rem;overflow:hidden}\n.ls-col{display:flex;flex-direction:column;width:3.5rem;flex:none}\n.ls-h{display:flex;align-items:center;justify-content:center;height:2.3rem;background:#1c3d2c;color:#c8dccf;font:700 1.1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.06em}\n.ls-gate{display:flex;flex-direction:column}\n.ls-v,.runs,.he,.ls-n{display:flex;align-items:center;justify-content:center;height:4.2rem;font:700 1.9rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.ls-v+.ls-v,.runs+.runs,.he+.he,.ls-n+.ls-n{border-top:.06rem solid rgba(255,255,255,.08)}\n.ls-col+.ls-col{border-left:.06rem solid rgba(255,255,255,.08)}\n.ls-extra .ls-h{color:#e4f23a}\n.ls-names{width:auto;flex:1;min-width:0}\n.ls-n{justify-content:flex-start;padding:0 1.2rem 0 2.9rem}\n.ls-n .nm{font:700 1.9rem/1 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.01em}\n.rcol{width:4.4rem;border-left:.18rem solid #1c3d2c!important}.rcol .runs{background:#e4f23a;color:#10261b;font-size:2.5rem}\n.hcol .he{color:#9fbaa8}\n.lsw{box-shadow:0 .6rem 2rem rgba(0,0,0,.4)}\n.sw{position:absolute;left:0;width:.55rem;height:4.2rem}.sw.a{top:2.3rem}.sw.b{top:6.56rem}\n.bot{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:5.2rem;padding:0 1.5rem;border-radius:.4rem;background:#10261b}\n.sit{position:relative;display:flex;align-items:center;gap:2rem;height:5.2rem}\n.lbl{font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#9fbaa8;text-transform:uppercase}\n\n.inn{display:flex;align-items:center;gap:.15rem;font:700 2.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;--half-on:#e4f23a;--half-off:rgba(255,255,255,.2);--half-h:2.2rem;--half-size:0.95rem}\n.sit .diamond{--d:4rem;--base-edge:#e7f0e9;--base-off:rgba(255,255,255,.05);--base-on:#e4f23a;--base-line:.13rem}\n.cnt{display:flex;flex-direction:column;align-items:center;gap:.3rem}\n.count{font:700 2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}.count .dash{opacity:.55;margin:0 .06em}\n.bs{display:flex;gap:.45rem;--dot:0.55rem;--dot-gap:.17rem;--dot-off:rgba(255,255,255,.16);--dot-edge:transparent}.ball-dots{--dot-on:#5bd98c}.strike-dots{--dot-on:#ff6a6a}\n.outw{display:flex;flex-direction:column;align-items:center;gap:.3rem;--dot:0.8rem;--dot-gap:.3rem;--dot-off:rgba(255,255,255,.16);--dot-edge:transparent;--dot-on:#e4f23a}\n.outs-l{font:700 .74rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#9fbaa8}\n.outw{flex-direction:row;align-items:center;gap:.6rem}.outs-l{font-size:.95rem}\n.leg{display:flex;align-items:center;gap:1.4rem;font:700 .95rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.12em;color:#9fbaa8;text-transform:uppercase}\n.leg>span{display:flex;align-items:center;gap:.5rem}.leg i{position:static!important;display:inline-block}\n.bat{position:absolute;left:1.75rem;width:.7rem;height:.7rem;border-radius:50%;background:#e4f23a}.bat.a{top:4.1rem}.bat.b{top:8.36rem}\n.hm{position:absolute;left:.95rem;width:.55rem;height:.58rem;background:#9fbaa8;clip-path:polygon(0 0,100% 0,100% 55%,50% 100%,0 55%)}.hm.a{top:4.1rem}.hm.b{top:8.36rem}\n.leg .bat,.leg .hm{position:static}\n.cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.25rem;background:#10261b;text-transform:uppercase;text-align:center;z-index:2}\n.cover b{font:700 .78rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#9fbaa8}\n.cover .periodLabel{font:700 1.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em}\n.cover.fin{font:700 1.8399999999999999rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;color:#e4f23a}\n.cover{flex-direction:row;gap:.8rem}\n.fin-s{display:none;font:700 1.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#9fbaa8}.board:has(.isComplete[style*=\"opacity: 1\"]) .fin-s{display:flex}\n</style></head><body><main class=\"board\" aria-label=\"Softball full-screen scoreboard\">\n<section class=\"sum columnCo