{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Plum Mist Open Namebed soccer 1</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;width:100%;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f9f7f7}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{width:min(60vw,1040px);max-width:100%;overflow:hidden;border-radius:3px;background:#403943;font-variant-numeric:tabular-nums}\n.header{height:56px;min-width:0;display:flex;align-items:center;gap:24px;padding:0 16px;background:#403943;border-bottom:1px solid #867d89}\n.sport-tab{flex:none;display:flex;align-items:center;justify-content:center;min-width:156px;height:40px;margin:0;padding:0 13px;border-radius:3px;background:#e7e5e6;color:#403943;font-size:20px;font-weight:800;letter-spacing:.01em;line-height:1;white-space:nowrap}\n.utility{display:flex;align-items:center;gap:16px;min-width:0;white-space:nowrap}\n.status{display:flex;align-items:baseline;gap:8px;color:#f9f7f7;font-size:15px;line-height:1;font-weight:600}\n.status+.status{border-left:1px solid #aba3ad;padding-left:16px}\n.status strong{font-size:20px;font-weight:800}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{height:124px;min-width:0;display:flex;align-items:stretch;background:#403943}\n.lane+.lane{border-top:1px solid #867d89}\n.identity-tick{flex:0 0 10px;margin:10px 0 10px 14px;background:#3186a8}\n.side-b .identity-tick{background:#c96b71}\n.namebed{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:7px;padding:7px 22px}\n.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#f9f7f7;font-size:52px;line-height:1.05;font-weight:700}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.support{display:flex;align-items:baseline;gap:12px;min-width:0;color:#f9f7f7;font-size:22px;line-height:1;font-weight:600;white-space:nowrap}\n.support-value{font-size:23px;font-weight:800}\n.primary-track{flex:0 0 132px;width:132px;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:3px 4px 5px;background:#403943;color:#f9f7f7}\n.primary-number{display:block;width:100%;min-width:0;text-align:center;white-space:nowrap;font-size:64px;line-height:1;font-weight:800;letter-spacing:-.035em}\n.primary-caption{display:block;text-align:center;font-size:18px;line-height:1;font-weight:700;white-space:nowrap}\n.horizontal{width:min(88vw,1600px)}\n.horizontal .header{height:55px;gap:24px}\n.horizontal .lanes{flex-direction:row}\n.horizontal .lane{flex:1 1 0;height:142px;border-top:0}\n.horizontal .lane+.lane{border-left:1px solid #867d89}\n.horizontal .identity-tick{margin-left:15px}\n.horizontal .namebed{padding-left:24px;padding-right:8px}\n.horizontal .primary-track{flex-basis:138px;width:138px}\n.horizontal .primary-track{border-left:1px solid #867d89}\n.hidden-match,.point-slot{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:1300px){\n.board{width:min(65vw,1040px)}\n.horizontal{width:min(94vw,1600px)}\n.header{height:44px;gap:14px;padding:0 12px}\n.sport-tab{min-width:118px;height:31px;font-size:15px}\n.utility{gap:9px}\n.status{font-size:11px;gap:5px}\n.status+.status{padding-left:9px}\n.status strong{font-size:15px}\n.lane{height:96px}\n.horizontal .lane{height:110px}\n.namebed{padding:5px 16px;gap:5px}\n.name{font-size:38px}\n.support{font-size:16px;gap:8px}\n.support-value{font-size:17px}\n.primary-track{flex-basis:104px;width:104px}\n.primary-number{font-size:48px}\n.primary-caption{font-size:13px}\n.horizontal .header{height:44px;gap:14px}\n.horizontal .namebed{padding-left:16px}\n.horizontal .primary-track{flex-basis:108px;width:108px}\n}\n@media(max-width:600px){\n.stage{padding:5px}\n.board,.horizontal{width:100%}\n.header,.horizontal .header{height:55px;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px;padding:3px 7px}\n.sport-tab{min-width:75px;height:20px;padding:0 6px;font-size:11px}\n.utility{width:100%;gap:8px;margin-left:0!important}\n.status{font-size:11px;gap:3px}\n.status+.status{padding-left:8px}\n.status strong{font-size:13px}\n.horizontal .lanes{flex-direction:column}\n.lane,.horizontal .lane{height:72px}\n.horizontal .lane+.lane{border-left:0;border-top:1px solid #867d89}\n.identity-tick,.horizontal .identity-tick{flex-basis:5px;margin:7px 0 7px 7px}\n.namebed,.horizontal .namebed{padding:4px 8px;gap:3px}\n.name{font-size:23px}\n.support{font-size:11px;gap:5px}\n.support-value{font-size:13px}\n.primary-track,.horizontal .primary-track{flex-basis:68px;width:68px;padding:2px 2px 3px}\n.primary-number{font-size:31px}\n.primary-caption{font-size:9px}\n}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer compact soccer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"soccer scoreboard\">\n <header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><h1 class=\"sport-tab\" data-osb-component=\"text\">SOCCER</h1><div class=\"utility rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">CLOCK</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</strong></span><span class=\"status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">HALF</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</strong></span></div></header>\n <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><section class=\"lane side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n <span class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n <div class=\"namebed columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n  <div class=\"support rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-a\">0</span></div>\n </div>\n <div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">GOALS</span>\n </div>\n <span class=\"hidden-match currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\" hidden>0</span>\n</section><section class=\"lane side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n <span class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n <div class=\"namebed columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n  <div class=\"support rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-b\">0</span></div>\n </div>\n <div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">GOALS</span>\n </div>\n <span class=\"hidden-match currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\" hidden>0</span>\n</section></div>\n <div class=\"point-slot\" data-osb-component=\"layout\" hidden><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n</article></main></body></html>\n","css":""}
