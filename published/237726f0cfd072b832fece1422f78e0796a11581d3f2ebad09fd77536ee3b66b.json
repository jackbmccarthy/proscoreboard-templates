{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Arena Board</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px 50px 28px; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .osb { position: relative; display: grid; grid-template-columns: 1fr 268px 1fr; width: 1000px; color: #fff; background: #0c1220; border-radius: 6px; overflow: hidden; box-shadow: 0 10px 26px #000b; }\n    .side { display: grid; grid-template-rows: 44px 96px; min-width: 0; background: linear-gradient(180deg, #172238, #0f1729); }\n    .hd { position: relative; display: grid; grid-template-columns: 14px minmax(0, 1fr); align-items: center; background: #1f2c45; border-bottom: 1px solid #2c3b59; overflow: hidden; }\n    .hd .kitw { position: absolute; inset: 0; }\n    .hd .kitw::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(90deg, #0000 0, #0000 10px, #00000040 10px, #0000008c 100%); }\n    .side.B .hd .kitw::after { background: linear-gradient(270deg, #0000 0, #0000 10px, #00000040 10px, #0000008c 100%); }\n    .hd .nm { position: relative; z-index: 1; grid-column: 2; text-shadow: 0 1px 2px #0008; }\n    .side.B .hd .nm { grid-column: 1; }\n    .kitw { align-self: stretch; display: flex; background: #b9c2d0; }\n    .side.B .kitw { background: #5d6a80; }\n    .kit { flex: 1; background-color: transparent; }\n    .nm { padding: 0 16px; font-size: 24px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .body { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 122px 34px; align-items: center; padding: 0 4px 0 16px; }\n    .side.A .lamp { order: 3; } .side.A .digits { order: 2; } .side.A .stats { order: 1; }\n    .side.B .hd { grid-template-columns: minmax(0, 1fr) 14px; }\n    .side.B .hd .kitw { order: 2; }\n    .side.B .hd .nm { text-align: right; }\n    .side.B .body { grid-template-columns: 34px 122px minmax(0, 1fr); padding: 0 16px 0 4px; }\n    .side.B .stats { align-items: flex-end; }\n    .lamp { display: flex; justify-content: center; }\n    .arrow { font-size: 26px; line-height: 1; color: #ffc233; }\n    .digits { position: relative; align-self: stretch; display: flex; align-items: center; justify-content: center; }\n    .pts { position: relative; z-index: 1; font-family: \"DIN Alternate\", \"DIN Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 76px; font-weight: 700; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }\n    .stats { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 0 6px; }\n    .st { display: flex; align-items: center; gap: 8px; }\n    .st i { font-style: normal; font-size: 16px; font-weight: 700; letter-spacing: 1.5px; color: #c3cddc; }\n    .led-s { font-family: \"DIN Alternate\", \"DIN Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 24px; font-weight: 700; line-height: 1; color: #fff; }\n    .pips { display: flex; gap: 4px; }\n    .pip { width: 12px; height: 12px; border-radius: 2px; background: #ffc233; }\n    .bonus { font-size: 16px; font-weight: 700; letter-spacing: 1.5px; color: #0c1220; background: #ffc233; padding: 2px 7px 1px; border-radius: 2px; }\n    .bonus:empty { display: none; }\n    .to { position: absolute; top: 14px; bottom: 14px; left: 12px; right: 170px; align-items: center; justify-content: center; gap: 14px; background: #ffc233; border-radius: 3px; color: #0c1220; }\n    .side.B .to { left: 170px; right: 12px; }\n    .side.B .bonus { order: -1; }\n    .to-l { font-size: 20px; font-weight: 700; letter-spacing: 3px; }\n    .to-c { font-family: \"DIN Alternate\", \"DIN Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 32px; font-weight: 700; line-height: 1; }\n    .mid { display: grid; grid-template-rows: 44px 96px; background: #060a14; border-left: 1px solid #2c3b59; border-right: 1px solid #2c3b59; }\n    .mid > .brk, .mid > .fin { grid-area: 2 / 1 / 3 / 2; }\n    .mid > .phd { grid-area: 1 / 1; } .mid > .live { grid-area: 2 / 1; }\n    .phd { display: flex; align-items: center; justify-content: center; gap: 10px; background: #1f2c45; border-bottom: 1px solid #2c3b59; }\n    .per { font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 22px; font-weight: 700; letter-spacing: 1px; color: #0c1220; background: #fff; padding: 2px 10px 1px; border-radius: 2px; }\n    .per:empty { display: none; }\n    .prog { display: flex; gap: 4px; align-items: center; }\n    .q { position: relative; width: 14px; height: 5px; background: #33415e; border-radius: 1px; }\n    .q > span { position: absolute; inset: 0; background: #ffc233; border-radius: 1px; }\n    .ot { width: 20px; height: 5px; margin-left: 2px; padding: 0; overflow: hidden; font-size: 16px; line-height: 5px; border-radius: 1px; background: #ff5a3d; color: transparent; }\n    .live { position: relative; display: flex; align-items: center; justify-content: center; gap: 14px; }\n    .gc { font-family: \"DIN Alternate\", \"DIN Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 64px; font-weight: 700; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }\n    .gc b { color: #ffc233; padding: 0 1px; }\n    .shot { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 52px; height: 58px; background: #d7262e; border-radius: 4px; }\n    .shot i { font-style: normal; font-size: 16px; font-weight: 700; letter-spacing: 1px; line-height: 1; color: #fff; }\n    .shot-v { font-family: \"DIN Alternate\", \"DIN Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 30px; font-weight: 700; line-height: 1; color: #fff; }\n    .run-shot { position: absolute; left: 6px; right: 6px; bottom: -6px; height: 3px; background: #d7262e; border-radius: 1px; }\n    .runbar { position: absolute; left: 24px; right: 24px; bottom: 0; height: 3px; background: #ffc233; }\n    .state { z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; background: #ffc233; color: #0c1220; }\n    .st-s { font-size: 20px; font-weight: 700; letter-spacing: 4px; }\n    .st-b { font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 58px; font-weight: 700; line-height: 1; margin-top: 4px; }\n    .brk { flex-direction: row; align-items: baseline; justify-content: center; gap: 12px; padding-top: 6px; }\n    .brk .st-b { font-size: 52px; }\n    .brk .half-t { font-size: 46px; }\n    .fin { z-index: 2; background: #fff; color: #0c1220; }\n    .fin-ot { font-size: 20px; font-weight: 700; letter-spacing: 4px; margin-top: 4px; }\n    .ev { grid-column: 1 / -1; display: flex; justify-content: center; gap: 14px; padding: 7px 16px 6px; background: #060a14; border-top: 1px solid #2c3b59; font-size: 16px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #a9b4c7; white-space: nowrap; order: 9; }\n    .ev .matchRound { color: #ffc233; }\n    .half-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .end-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .half-t { display: block; }\n    .fin-ot { display: none; }\n    .osb:has(.isGame5Started[style*=\"opacity: 1\"]) .fin-ot { display: block; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .final-dim { opacity: .5; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .stats { visibility: hidden; }\n    .st:has(.pips):not(:has(.pip[style*=\"opacity: 1\"])) { visibility: hidden; }\n    .win { position: absolute; left: 8px; right: 8px; top: 12px; bottom: 12px; background: #ffc233; border-radius: 4px; }\n    .digits:has(> .win[style*=\"opacity: 1\"]) .pts { color: #0c1220; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .side.B :is(.nm, .pts), .osb:has(.isBWinner[style*=\"opacity: 1\"]) .side.A :is(.nm, .pts) { color: #a3aec0; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .side.B .kitw, .osb:has(.isBWinner[style*=\"opacity: 1\"]) .side.A .kitw { filter: saturate(.35) brightness(.6); }\n    .pips { gap: 0 !important; }\n    .pips > [class*=\"TimeoutLeft\"] { margin-right: 4px; }\n    .pips > [style*=\"opacity: 0\"] { width: 0 !important; margin: 0 !important; }\n    .pips > .pip[style*=\"opacity: 0\"] { display: none !important; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<article class=\"osb\" aria-label=\"Basketball arena scoreboard\">\n  <div class=\"side A\"><div class=\"hd\"><span class=\"kitw\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"body\"><span class=\"lamp final-dim\"><span class=\"arrow isAPossession\" data-osb-component=\"field\" data-osb-field=\"isAPossession\" style=\"opacity: 0;\">&#9664;</span></span><span class=\"digits\"><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0;\"></span><span class=\"pts currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><div class=\"stats\"><span class=\"st\"><i>FOULS</i><b class=\"led-s teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</b><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span></span><span class=\"st\"><i>TO</i><span class=\"pips final-dim\"><span class=\"pip isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft5\" style=\"opacity: 0;\"></span></span></span></div><span class=\"to isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIME OUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></div></div>\n  <div class=\"mid\">\n    <div class=\"phd\">PERIOD <span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"prog\"><span class=\"q\"><span class=\"isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"ot isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\">OT</span></span></div>\n    <div class=\"live\"><span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"shot isShotClockActive\" data-osb-component=\"field\" data-osb-field=\"isShotClockActive\" style=\"opacity: 0;\"><i>SHOT</i><span class=\"shot-v\" data-osb-static=\"true\" data-sport-stat=\"shotClock\"></span><span class=\"run-shot isShotClockRunning\" data-osb-component=\"field\" data-osb-field=\"isShotClockRunning\" style=\"opacity: 0;\"></span></span><span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span></div>\n    <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"end-t st-s\">END OF</span><span class=\"end-t st-b\"><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span></span><span class=\"half-t st-b\">HALFTIME</span></div>\n    <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FINAL</span><span class=\"fin-ot\">OVERTIME</span></div>\n  </div>\n  <div class=\"side B\"><div class=\"hd\"><span class=\"kitw\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"body\"><span class=\"lamp final-dim\"><span class=\"arrow isBPossession\" data-osb-component=\"field\" data-osb-field=\"isBPossession\" style=\"opacity: 0;\">&#9654;</span></span><span class=\"digits\"><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0;\"></span><span class=\"pts currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><div class=\"stats\"><span class=\"st\"><i>FOULS</i><b class=\"led-s teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</b><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span></span><span class=\"st\"><i>TO</i><span class=\"pips final-dim\"><span class=\"pip isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft5\" style=\"opacity: 0;\"></span></span></span></div><span class=\"to isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIME OUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></div></div>\n  <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span><span class=\"timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span><span class=\"possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
