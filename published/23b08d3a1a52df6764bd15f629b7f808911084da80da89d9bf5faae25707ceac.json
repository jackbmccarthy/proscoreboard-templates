{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Stone Gold Broadcast PICKLEBALL 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f4f4f0}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--view-width),var(--max-width),var(--height-width));position:relative;container-type:inline-size;background:transparent;padding-bottom:20px}.desk{width:100%;min-width:0;background:#273745;border:1px solid #75818c}.header{background:#ddc79f;color:#101d2b;min-width:0}.sport-caption{white-space:nowrap;line-height:1.1}.row,.lane,.name-cell,.name-wrap{min-width:0}.name-cell{display:flex;align-items:center;flex:1 1 0}.name-wrap{display:flex;align-items:center;flex:1 1 0;gap:5px;min-width:0}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{display:block;flex-shrink:0;background:#ddc79f}.serve{display:block;flex:0 0 12px;width:12px;height:12px;font-size:8px;line-height:12px;text-align:center}.score,.match-score{display:block;width:100%;font-size:var(--score-font);line-height:1.1;text-align:center;white-space:nowrap;font-variant-numeric:tabular-nums}.match-score{font-size:var(--match-font)}.label{font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.point-cell{background:#101d2b;color:#fff}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:200px;max-width:90%;height:16px;font-size:12px;text-align:center}.point{position:absolute;inset:0;background:#273745;color:#f4f4f0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:63vw;--max-width:1300px;--height-width:250vh;--name-font:4.75cqw;--score-font:6.2cqw;--match-font:5.3cqw;--label-font:3.5cqw;--games-width:18%;--points-width:19.5%}.header{display:flex;align-items:center;min-height:6.6cqw;border-bottom:1px solid #75818c}.title-lane{flex:1;min-width:0;padding:0 3.25cqw}.sport-caption{font-size:4.5cqw}.header .games,.game-cell{flex:0 0 var(--games-width)}.header .points,.point-cell{flex:0 0 var(--points-width)}.header>.label{display:flex;align-items:center;justify-content:center;border-left:1px solid #75818c}.row{display:flex;align-items:stretch;min-height:11.1cqw}.row+.row{border-top:1px solid #75818c}.name-cell{gap:3.7cqw;padding:1cqw 1.7cqw}.identity{width:1.2cqw;height:8.2cqw}.game-cell,.point-cell{display:flex;align-items:center;justify-content:center;border-left:1px solid #75818c}@media(max-width:600px){.board{--view-width:94vw}.sport-caption{font-size:4.1cqw}.name{font-size:5.8cqw}.label{font-size:2.6cqw}}\n\n/* Reserved conditional match states: all score and name tracks remain fixed. */\n.osb-conditional-rail{--osb-rail-bg:#101d2b;--osb-rail-fg:#f9fbfa;box-sizing:border-box!important;position:relative!important;inset:auto!important;transform:none!important;grid-column:1/-1!important;display:flex!important;align-items:center!important;justify-content:space-between!important;flex:0 0 auto!important;width:100%!important;min-width:0!important;min-height:28px!important;height:28px!important;margin:0!important;padding:2px 7px!important;gap:5px!important;overflow:hidden!important;background:var(--osb-rail-bg)!important;color:var(--osb-rail-fg)!important;border:0!important;font:700 11px/1 Arial,Helvetica,sans-serif!important;letter-spacing:0!important;text-transform:none!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-condition-side{all:unset!important;box-sizing:border-box!important;display:flex!important;align-items:center!important;flex:1 1 35%!important;width:35%!important;min-width:0!important;height:22px!important;gap:2px!important;position:relative!important;overflow:hidden!important}\n.osb-conditional-rail .osb-condition-side-b{justify-content:flex-end!important}\n.osb-conditional-rail .osb-condition-slot{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 21px!important;width:21px!important;height:18px!important;position:relative!important}\n.osb-conditional-rail .osb-condition-timeoutused{flex-basis:21px!important;width:21px!important}\n.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:17px!important;width:17px!important}\n.osb-conditional-rail .osb-condition-badge{box-sizing:border-box!important;align-items:center!important;justify-content:center!important;width:100%!important;height:18px!important;min-width:0!important;margin:0!important;padding:0 2px!important;border:1px solid rgba(255,255,255,.3)!important;border-radius:2px!important;background:rgba(255,255,255,.12)!important;color:var(--osb-rail-fg)!important;font:800 9px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-timeout-icon{position:relative!important;display:flex;align-items:center!important;justify-content:center!important;padding:0!important;color:var(--osb-rail-fg)!important}\n.osb-conditional-rail .osb-timeout-icon::before{content:\"\"!important;display:block!important;width:11px!important;height:11px!important;border:1.5px solid currentColor!important;border-radius:50%!important;background:transparent!important}\n.osb-conditional-rail .osb-timeout-icon::after{content:\"\"!important;position:absolute!important;left:50%!important;top:3px!important;width:3px!important;height:6px!important;border-left:1.5px solid currentColor!important;border-bottom:1.5px solid currentColor!important;transform:translateX(-25%) rotate(-35deg)!important;transform-origin:bottom left!important}\n.osb-conditional-rail .isATimeOutActive,.osb-conditional-rail .isBTimeOutActive{background:#f3d27a!important;color:#253641!important;border-color:#f3d27a!important}\n.osb-conditional-rail .isATimeOutUsed,.osb-conditional-rail .isBTimeOutUsed{background:transparent!important;color:#b8c7ca!important;border-color:#b8c7ca!important}\n.osb-conditional-rail .isAYellowCarded,.osb-conditional-rail .isBYellowCarded{background:#e5c94e!important;color:#253641!important;border-color:#e5c94e!important}\n.osb-conditional-rail .isARedCarded,.osb-conditional-rail .isBRedCarded{background:#c94747!important;color:#fff!important;border-color:#c94747!important}\n.osb-conditional-rail .point-slot.osb-shared-point{all:unset!important;box-sizing:border-box!important;position:relative!important;display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 30%!important;width:30%!important;min-width:78px!important;max-width:130px!important;height:22px!important;min-height:22px!important;inset:auto!important;margin:0!important;padding:0!important;transform:none!important;overflow:hidden!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important}\n.osb-conditional-rail .point-slot.osb-shared-point>.isGamePoint,.osb-conditional-rail .point-slot.osb-shared-point>.isMatchPoint{box-sizing:border-box!important;position:absolute!important;inset:0!important;display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;transform:none!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:390px){.osb-conditional-rail{padding:2px 4px!important;gap:3px!important}.osb-conditional-rail .osb-condition-side{gap:1px!important}.osb-conditional-rail .osb-condition-slot{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-timeoutused{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:15px!important;width:15px!important}.osb-conditional-rail .point-slot.osb-shared-point{min-width:76px!important}}\n\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><div class=\"title-lane\"><div class=\"sport-caption\">PICKLEBALL</div></div><div class=\"label games\">GAMES</div><div class=\"label points\">POINTS</div></header><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><div class=\"osb-conditional-rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Conditional match states\"><div class=\"osb-condition-side osb-condition-side-a\" data-osb-component=\"layout\"><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div><span class=\"point-slot osb-shared-point\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><div class=\"osb-condition-side osb-condition-side-b\" data-osb-component=\"layout\"><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div></div></article></main></body>\n</html>\n","css":""}
