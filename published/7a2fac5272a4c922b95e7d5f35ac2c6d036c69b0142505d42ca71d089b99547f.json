{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Slate Lime Desk soccer 1</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f1f4f6}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:14px 0;min-width:0}.board{width:min(68vw,calc((100vh - 28px)*2.65));max-width:1500px;container-type:inline-size;min-width:0;background:#20262e;border:1px solid #607080;border-radius:3px;overflow:hidden}.header{display:flex;align-items:center;min-width:0;min-height:5.6cqw;border-bottom:2px solid #b6cf61;background:#20262e}.sport-title{flex:1 1 0;min-width:0;margin:0;padding:1.2cqw 2.6cqw;font-size:3cqw;line-height:1.1;color:#a8bbca;font-weight:700}.column-label{flex:0 0 21.5%;min-width:0;text-align:center;font-size:2.45cqw;line-height:1.1;color:#a8bbca}.row{display:flex;align-items:stretch;min-width:0;min-height:10.8cqw;background:#2a3440;border-bottom:1px solid #607080}.identity{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:1.3cqw 1.6cqw;gap:3.2cqw}.tick{display:block;flex:0 0 1.6cqw;min-width:0;height:8cqw;background:#b6cf61}.name{display:block;flex:1 1 0;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:6.2cqw;line-height:1.1;color:#f1f4f6;font-weight:700;letter-spacing:-.025em}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-terminal{display:flex;align-items:center;justify-content:center;flex:0 0 21.5%;min-width:0;background:#374451}.score{display:block;width:100%;min-width:0;text-align:center;font-size:7.3cqw;line-height:1.1;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.02em;color:#f1f4f6;white-space:nowrap}.footer{display:flex;align-items:stretch;justify-content:center;min-width:0;min-height:7.7cqw;padding:1.2cqw 0;background:#20262e}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:2.4cqw;padding:0 1cqw}.stat.clock{flex:1.3 1 0}.stat+.stat{border-left:1px solid #607080}.label{display:block;font-size:2.4cqw;line-height:1.1;font-weight:700;color:#a8bbca;white-space:nowrap}.value{display:block;font-size:4.2cqw;line-height:1.1;font-weight:700;font-variant-numeric:tabular-nums;color:#f1f4f6;white-space:nowrap}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}.variant-2{width:min(88vw,calc((100vh - 28px)*5));max-width:1800px;border-top:2px solid #b6cf61}.duel{display:flex;align-items:stretch;min-width:0;border-bottom:1px solid #607080;min-height:9.7cqw}.endcap{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 12cqw;min-width:0;gap:.6cqw;border-right:1px solid #607080;background:#20262e}.endcap .sport-title{flex:none;font-size:1.5cqw;text-align:center;padding:0;white-space:nowrap}.ball{position:relative;display:block;min-width:0;width:5.5cqw;height:5.5cqw;border-radius:50%;overflow:hidden;flex:none}.ball.basketball{background:#bd6a25}.basketball.ball::before,.basketball.ball::after{content:\"\";position:absolute;background:#20262e;z-index:1}.basketball.ball::before{left:0;right:0;top:calc(50% - .16cqw);height:.32cqw}.basketball.ball::after{top:0;bottom:0;left:calc(50% - .16cqw);width:.32cqw}.arc{position:absolute;top:-10%;height:120%;width:60%;border-radius:50%;border:0 solid #20262e}.arc.left{left:-25%;border-right-width:.3cqw}.arc.right{right:-25%;border-left-width:.3cqw}.ball.soccer{background:#f1f4f6;border:.12cqw solid #a8bbca}.patch{position:absolute;width:29%;height:29%;background:#20262e;clip-path:polygon(50% 0,100% 38%,82% 100%,18% 100%,0 38%)}.patch.center{top:33%;left:33%;width:35%;height:35%}.patch.north{top:-4%;left:36%}.patch.northwest{top:19%;left:-3%;transform:rotate(-55deg)}.patch.northeast{top:19%;right:-3%;transform:rotate(55deg)}.patch.southwest{bottom:-3%;left:12%;transform:rotate(-125deg)}.patch.southeast{bottom:-3%;right:12%;transform:rotate(125deg)}.competitors{display:flex;align-items:stretch;flex:1 1 0;min-width:0}.variant-2 .row{flex:1 1 0;min-width:0;border-bottom:0;min-height:9.7cqw}.variant-2 .row+.row{border-left:1px solid #607080}.variant-2 .identity{padding:1cqw 2cqw;gap:2.2cqw}.variant-2 .tick{flex-basis:1.1cqw;height:4.6cqw}.variant-2 .name{font-size:3.6cqw}.score-zone{display:flex;flex-direction:column;align-items:stretch;justify-content:center;flex:0 0 12cqw;min-width:0;gap:.4cqw;margin:.8cqw .8cqw .8cqw 0}.score-zone .label{text-align:center;font-size:1.55cqw}.score-zone .score-terminal{flex:none;min-height:5.3cqw}.variant-2 .score{font-size:4.3cqw}.variant-2 .footer{min-height:4.7cqw;padding:.8cqw 0}.variant-2 .footer .label{font-size:1.65cqw}.variant-2 .value{font-size:2.8cqw}.soccer.variant-1{width:min(62vw,calc((100vh - 28px)*2.05));max-width:1370px}.soccer.variant-1 .header{min-height:7.6cqw}.soccer.variant-1 .sport-title{font-size:4.1cqw;padding:1.4cqw 3cqw}.soccer.variant-1 .column-label{flex-basis:18.1%;font-size:3.2cqw}.soccer.variant-1 .row{min-height:13.7cqw}.soccer.variant-1 .identity{padding:2cqw 2.3cqw;gap:3.8cqw}.soccer.variant-1 .tick{flex-basis:1.35cqw;height:7cqw}.soccer.variant-1 .name{font-size:6.3cqw}.soccer.variant-1 .score-terminal{flex-basis:18.1%}.soccer.variant-1 .score{font-size:9.3cqw}.soccer.variant-1 .footer{min-height:10.3cqw;padding:2cqw 0}.soccer.variant-1 .footer .label{font-size:3.2cqw}.soccer.variant-1 .value{font-size:6.3cqw}.soccer.variant-2{width:min(84vw,calc((100vh - 28px)*4.6));max-width:1800px}.soccer.variant-2 .endcap{flex-basis:10.5cqw}.soccer.variant-2 .duel,.soccer.variant-2 .row{min-height:10.9cqw}.soccer.variant-2 .ball{width:5.2cqw;height:5.2cqw}.soccer.variant-2 .endcap .sport-title{font-size:1.65cqw}.soccer.variant-2 .score-zone{flex-basis:13cqw;margin:.4cqw .5cqw .4cqw 0;gap:1cqw;background:#374451;padding:.5cqw 0;border-radius:3px}.soccer.variant-2 .score-zone .label{font-size:1.65cqw}.soccer.variant-2 .score-zone .score-terminal{min-height:5.7cqw}.soccer.variant-2 .score{font-size:5.5cqw}.soccer.variant-2 .footer{min-height:5.3cqw}.soccer.variant-2 .stat{flex:none;padding:0 3cqw}.soccer.variant-2 .stat.clock{flex:none}@media(max-width:600px){.board,.variant-2,.soccer.variant-1,.soccer.variant-2{width:94vw}.header{min-height:40px}.sport-title,.soccer.variant-1 .sport-title{font-size:17px;padding:10px 12px}.column-label,.soccer.variant-1 .column-label{font-size:12px}.row,.soccer.variant-1 .row{min-height:58px}.identity,.soccer.variant-1 .identity{padding:10px 12px;gap:12px}.tick,.soccer.variant-1 .tick{flex-basis:4px;height:32px}.name,.soccer.variant-1 .name{font-size:22px}.score,.soccer.variant-1 .score{font-size:32px}.score-terminal,.soccer.variant-1 .score-terminal{flex-basis:80px}.footer,.soccer.variant-1 .footer{min-height:56px;padding:10px 0}.stat{gap:8px;padding:0 5px}.footer .label,.soccer.variant-1 .footer .label{font-size:11px}.value,.soccer.variant-1 .value{font-size:20px}.duel{flex-direction:column;min-height:0}.endcap,.soccer.variant-2 .endcap{flex:none;width:100%;flex-direction:row;justify-content:flex-start;padding:10px 14px;gap:10px;border-right:0;border-bottom:1px solid #607080}.ball,.soccer.variant-2 .ball{width:28px;height:28px}.endcap .sport-title,.soccer.variant-2 .endcap .sport-title{font-size:13px}.competitors{flex-direction:column;width:100%;min-width:0}.variant-2 .row,.soccer.variant-2 .row{flex:none;width:100%;min-height:72px}.variant-2 .row+.row{border-left:0;border-top:1px solid #607080}.variant-2 .identity{padding:12px 14px;gap:12px}.variant-2 .tick{flex-basis:4px;height:30px}.variant-2 .name{font-size:22px}.score-zone,.soccer.variant-2 .score-zone{flex-basis:84px;margin:8px 12px 8px 0;gap:3px;padding:0;background:transparent}.score-zone .label,.soccer.variant-2 .score-zone .label{font-size:10px}.score-zone .score-terminal,.soccer.variant-2 .score-zone .score-terminal{min-height:44px}.variant-2 .score,.soccer.variant-2 .score{font-size:36px}.variant-2 .footer,.soccer.variant-2 .footer{min-height:56px;padding:10px 0}.variant-2 .footer .label{font-size:11px}.variant-2 .value{font-size:20px}.soccer.variant-2 .stat{padding:0 18px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer soccer variant-1\" data-osb-component=\"layout\"><header class=\"header rowContainer\" data-osb-component=\"layout\"><h1 class=\"sport-title\" data-osb-component=\"text\">SOCCER</h1><span class=\"column-label\" data-osb-component=\"text\">GOALS</span></header><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-terminal\" data-osb-component=\"decoration\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-terminal\" data-osb-component=\"decoration\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section><footer class=\"footer rowContainer\" data-osb-component=\"layout\"><div class=\"stat clock rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat half rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">HALF</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\" currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\" currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
