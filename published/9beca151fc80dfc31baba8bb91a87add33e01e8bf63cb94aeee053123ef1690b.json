{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Copper Cream Keyline Stat 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(94vw,1186px);max-width:100%;aspect-ratio:2.82;overflow:hidden;border-radius:7px;background:#f2efe8;color:#263540;container-type:inline-size}\n.head{display:flex;align-items:center;justify-content:space-between;flex:0 0 20.5%;min-width:0;padding:0 34px;background:#78544a;color:#fbfaf6}\n.sport-tag{display:block;min-width:0;overflow:hidden;font-size:clamp(20px,3.5cqw,46px);font-weight:800;line-height:1;text-overflow:ellipsis;white-space:nowrap}\n.status{display:flex;align-items:center;align-self:stretch;gap:.35em;padding-left:42px;border-left:2px solid #fbfaf6;font-size:clamp(19px,2.9cqw,38px);font-weight:800;line-height:1;white-space:nowrap}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.teams{display:flex;flex:1 1 0;min-height:0;flex-direction:column}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0;min-width:0}\n.team+.team{border-top:2px solid #aeb9b0}\n.identity{display:block;flex:0 0 24px;align-self:stretch;margin:8px 0 8px 8px;background:#3a95e5}\n.jerseyColorB{background:#f26872}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 38px;color:#263540;font-size:clamp(29px,6cqw,76px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.sets,.points{display:flex;align-items:center;justify-content:center;min-width:0;flex-direction:column;gap:2px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sets{flex:0 0 13.8%;margin:16px 0;border:2px solid #aeb9b0;border-radius:8px;background:#f2efe8;color:#263540}\n.points{flex:0 0 19%;margin:10px 10px 10px 16px;border-radius:8px;background:#263540;color:#fff}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(34px,5cqw,65px);font-weight:800;line-height:1;text-align:center}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(53px,8.1cqw,106px);font-weight:800;line-height:1;text-align:center}\n.label{display:block;max-width:100%;overflow:hidden;font-size:clamp(13px,1.9cqw,26px);font-weight:750;line-height:1}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:6px}\n .board{width:100%;height:180px;aspect-ratio:auto;border-radius:3px}\n .head{flex-basis:21%;padding:0 8px}\n .sport-tag{font-size:clamp(10px,3cqw,14px)}\n .status{padding-left:8px;border-width:1px;font-size:clamp(10px,3cqw,14px)}\n .team+.team{border-width:1px}\n .identity{flex-basis:5px;margin:5px 0 5px 3px}\n .name{padding:0 8px;font-size:clamp(16px,4.8cqw,22px)}\n .sets{flex-basis:19%;margin:8px 0;border-width:1px;border-radius:3px;gap:1px}\n .points{flex-basis:24%;margin:5px 5px 5px 5px;border-radius:3px;gap:1px}\n .set-score{font-size:clamp(21px,6cqw,29px)}\n .score{font-size:clamp(28px,8.1cqw,38px)}\n .label{font-size:clamp(8px,2.3cqw,11px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n  <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"label\" data-osb-component=\"text\">SETS</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label\" data-osb-component=\"text\">POINTS</span></div></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"label\" data-osb-component=\"text\">SETS</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label\" data-osb-component=\"text\">POINTS</span></div></div>\n  </div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
