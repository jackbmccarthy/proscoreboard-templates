{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Ivory Cobalt Line Volleyball — Horizontal Lanes</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #152842; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { display: flex; flex-direction: column; width: 100%; max-width: 720px; overflow: hidden; border: 2px solid #1557b0; border-radius: 2px; background: #faf9f3; }\n.main { display: flex; min-height: 50px; }\n.sport { display: flex; align-items: center; justify-content: center; flex: 0 0 17.8%; padding: 8px; background: #1557b0; color: #fff; font-size: 18px; font-weight: 700; line-height: 1; }\n.team { flex: 1 1 0; display: flex; align-items: stretch; }\n.team + .team { border-left: 1px solid #587089; }\n.identity { flex: 1 1 0; display: flex; align-items: center; gap: 10px; padding: 7px 8px; }\n.tick { display: block; flex: 0 0 3px; width: 3px; height: 34px; background: #1557b0; }\n.name { flex: 1 1 0; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26px; font-weight: 700; line-height: 1; color: #152842; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex: 0 0 18%; border-left: 1px solid #587089; background: #e4ecf8; }\n.points-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; flex: 0 0 26.5%; border-left: 1px solid #587089; background: #1557b0; color: #fff; }\n.label { display: block; font-size: 13px; font-weight: 700; line-height: 1; }\n.match-score, .primary-score { display: block; width: 100%; text-align: center; font-size: 22px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { font-size: 34px; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 30px; gap: 8px; border-top: 1px solid #587089; background: #152842; color: #fff; font-size: 15px; font-weight: 700; line-height: 1; }\n.set-value { display: block; width: 21px; text-align: center; font-size: 18px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .main { flex-direction: column; }\n  .sport { flex-basis: auto; min-height: 32px; justify-content: flex-start; padding: 8px 12px; font-size: 15px; }\n  .team { flex-basis: auto; min-height: 54px; }\n  .team + .team { border-left: 0; border-top: 1px solid #587089; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <div class=\"main rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><header class=\"sport\">VOLLEYBALL</header>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
