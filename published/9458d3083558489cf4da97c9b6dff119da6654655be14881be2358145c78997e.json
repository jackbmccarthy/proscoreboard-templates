{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Sage Slate Data Console 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;width:min(96vw,1780px);height:auto;aspect-ratio:11.4 / 1;max-width:100%;overflow:hidden;border:2px solid #a8bfbd;border-radius:5px;background:#e4ebe8;color:#203338;container-type:inline-size}\n.console{display:flex;flex:0 0 18.5%;min-width:0;flex-direction:column;justify-content:center;padding:7px 24px;background:#25393d;color:#e9efed;text-align:center}\n.sport-tag{display:block;overflow:hidden;font-size:clamp(14px,1.9cqw,33px);font-weight:800;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.stat-labels,.stat-values{display:flex;align-items:center;justify-content:space-around;font-variant-numeric:tabular-nums}\n.stat-labels{margin-top:9px;color:#b7cbca;font-size:clamp(10px,1.4cqw,22px);font-weight:750}\n.stat-values{margin-top:4px;color:#fff;font-size:clamp(22px,2.7cqw,46px);font-weight:800;line-height:1}\n.stat-labels>*+*,.stat-values>*+*{border-left:2px solid #acc1bd}\n.stat-labels>*,.stat-values>*{display:block;flex:1 1 0;min-width:0;text-align:center}\n.set-score{font-variant-numeric:tabular-nums}\n.teams{display:flex;flex:1 1 0;min-width:0}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.team+.team{border-left:2px solid #688982}\n.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;background:#e4ebe8}\n.identity{display:block;flex:0 0 14px;align-self:stretch;margin:23px 0 23px 18px;background:#176dbb}\n.jerseyColorB{background:#d92437}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;padding:0 26px;color:#203338;font-size:clamp(22px,3.2cqw,56px);font-weight:750;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.score-terminal{display:flex;align-items:center;justify-content:center;flex:0 0 22%;min-width:0;margin:5px 5px 5px 0;background:#597d74;color:#fff;flex-direction:column}\n.score-label{display:block;color:#e3eae6;font-size:clamp(10px,1.5cqw,25px);font-weight:750;line-height:1;white-space:nowrap}\n.score{display:block;max-width:100%;overflow:hidden;margin-top:8px;font-size:clamp(35px,5cqw,80px);font-weight:800;font-variant-numeric:tabular-nums;line-height:1;white-space:nowrap}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:7px}\n .board{width:100%;height:93px;aspect-ratio:auto}\n .console{flex-basis:26%;padding:7px 3px}\n .sport-tag{font-size:clamp(10px,2.4vw,13px)}\n .stat-labels{margin-top:9px;font-size:8px}\n .stat-values{font-size:18px}\n .identity{flex-basis:4px;margin:14px 0 14px 4px}\n .name{padding:0 4px;font-size:clamp(12px,3.4vw,17px)}\n .score-terminal{flex-basis:27%;margin:3px 3px 3px 0}\n .score-label{font-size:7px}\n .score{font-size:clamp(23px,6.6vw,33px);margin-top:4px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <aside class=\"console columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span>\n   <div class=\"stat-labels\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span data-osb-component=\"text\">SET</span><span data-osb-component=\"text\">SETS</span></div>\n   <div class=\"stat-values\" data-osb-component=\"layout\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n  </aside>\n  <div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-terminal\" data-osb-component=\"layout\"><span class=\"score-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-terminal\" data-osb-component=\"layout\"><span class=\"score-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n  </div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
