{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Box Score</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { display: flex; align-items: center; justify-content: center; width: 100vw; height: 100vh; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .osb { position: relative; width: 1160px; padding: 40px 48px 44px; border-radius: 14px; background: radial-gradient(ellipse at top, #1d2f50, #0b1424 75%); color: #e8edf5; box-shadow: 0 20px 50px #000c; }\n    .head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 20px; padding-bottom: 16px; border-bottom: 3px solid #f08a24; }\n    .ev { display: flex; flex-direction: column; gap: 4px; }\n    .ev .eventName { font-size: 44px; font-weight: 700; line-height: 1.02; letter-spacing: .5px; text-transform: uppercase; }\n    .ev .matchRound { font-size: 20px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #f08a24; }\n    .status { display: grid; min-width: 270px; height: 84px; border-radius: 8px; overflow: hidden; background: #0a1220; border: 1px solid #2a3c5c; }\n    .status > * { grid-area: 1 / 1; }\n    .live { position: relative; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 0 18px; }\n    .per { font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 26px; font-weight: 700; color: #0a1220; background: #f08a24; padding: 2px 10px 1px; border-radius: 4px; }\n    .gc { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 44px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .gc b { color: #f08a24; padding: 0 1px; }\n    .runbar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #f08a24; }\n    .state { z-index: 1; display: flex; align-items: center; justify-content: center; gap: 12px; line-height: 1; background: #f08a24; color: #0a1220; }\n    .st-s { font-size: 20px; font-weight: 700; letter-spacing: 3px; }\n    .st-b { font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 42px; font-weight: 700; }\n    .fin { z-index: 2; background: #e8edf5; }\n    .fin-ot { font-size: 20px; font-weight: 700; letter-spacing: 2px; }\n    table { width: 100%; margin-top: 20px; border-collapse: separate; border-spacing: 0 10px; }\n    thead th { padding: 0 0 2px; font-size: 18px; font-weight: 700; letter-spacing: 2px; color: #a9b8d1; text-align: center; }\n    thead th.tmh { text-align: left; padding-left: 24px; min-width: 290px; }\n    .r { background: #142540; }\n    .tm { position: relative; display: grid; grid-template-columns: 14px minmax(0, 1fr) 34px; align-items: center; height: 122px; text-align: left; }\n    .tochip { align-items: center; gap: 8px; height: 24px; padding: 0 8px; border-radius: 3px; background: #f08a24; color: #0a1220; font-size: 16px; font-weight: 800; letter-spacing: 1.5px; }\n    .tochip .timeoutClock { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 18px; letter-spacing: 0; }\n    .kitw { align-self: stretch; display: flex; background: #b9c3d3; border-radius: 6px 0 0 6px; }\n    .r.B .kitw { background: #5d6c86; }\n    .kit { flex: 1; background-color: transparent; border-radius: 6px 0 0 6px; }\n    .nmw { display: flex; flex-direction: column; gap: 8px; padding: 0 18px; min-width: 0; }\n    .nm { font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 34px; font-weight: 700; line-height: 1; text-transform: uppercase; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; text-wrap: balance; overflow: hidden; overflow-wrap: normal; word-break: normal; hyphens: none; }\n    .sub { display: flex; align-items: center; gap: 16px; height: 24px; font-size: 17px; font-weight: 700; letter-spacing: 1.5px; color: #b3c0d6; }\n    .tor { display: flex; align-items: center; gap: 7px; }\n    .pips { display: flex; gap: 5px; }\n    .pip { width: 14px; height: 14px; border-radius: 50%; background: #f08a24; box-shadow: inset 0 0 0 2px #ffb15e; }\n    .fl b { color: #fff; margin-left: 4px; }\n    .bonus { font-weight: 700; font-size: 12px; letter-spacing: 1.5px; color: #0a1220; background: #f08a24; padding: 2px 6px 1px; border-radius: 2px; }\n    .bonus:empty { display: none; }\n    .poss { display: flex; justify-content: center; }\n    .arrow { width: 0; height: 0; border-top: 10px solid transparent; border-bottom: 10px solid transparent; border-right: 14px solid #f08a24; }\n    .c { width: 104px; text-align: center; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 46px; font-weight: 700; color: #e8edf5; font-variant-numeric: tabular-nums; border-left: 1px solid #1f3457; }\n    .c .v { justify-content: center; }\n    .dash { display: none; }\n    .c:has(.v[style*=\"opacity: 1\"]) .dash { display: none; }\n    .otc { width: 108px; }\n    .c.otc:not(:has(.v[style*=\"opacity: 1\"])), th.oth { display: none; }\n    .osb:has(.r.A .otc.o5 .v[style*=\"opacity: 1\"]) th.oth.o5, .osb:has(.r.A .otc.o6 .v[style*=\"opacity: 1\"]) th.oth.o6 { display: table-cell; }\n    .tot { position: relative; width: 156px; text-align: center; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 66px; font-weight: 700; color: #0a1220; background: #f08a24; border-radius: 0 6px 6px 0; font-variant-numeric: tabular-nums; }\n    .foot { display: flex; justify-content: space-between; margin-top: 10px; font-size: 15px; font-weight: 700; letter-spacing: 2px; color: #8fa1bf; text-transform: uppercase; }\n    .foot .shot { position: relative; display: flex; gap: 8px; }\n    .foot .shot-v { color: #fff; }\n    .run-shot { position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: #f08a24; }\n    .prog { display: flex; align-items: center; gap: 4px; }\n    .q { position: relative; width: 22px; height: 5px; background: #2a3c5c; }\n    .q > span { position: absolute; inset: 0; background: #f08a24; }\n    .ot { font-size: 11px; padding: 1px 4px; line-height: 1; background: #f08a24; color: #0a1220; }\n    .half-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .end-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .half-t { display: block; }\n    .fin-ot { display: none; }\n    .osb:has(.isGame5Started[style*=\"opacity: 1\"]) .fin-ot { display: block; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .final-dim { opacity: .5; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .sub > :not(.win) { display: none; }\n    .tor:not(:has(.pip[style*=\"opacity: 1\"])) { display: none; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .sub.final-dim { opacity: 1; }\n    .win { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 1px 10px 0; border-radius: 3px; background: #f08a24; color: #0a1220; font-size: 17px; font-weight: 700; letter-spacing: 2px; }\n    .win[style*=\"opacity: 0\"] { display: none; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .r.B :is(.nm, .c), .osb:has(.isBWinner[style*=\"opacity: 1\"]) .r.A :is(.nm, .c) { color: #95a5c0; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .r.B .kitw, .osb:has(.isBWinner[style*=\"opacity: 1\"]) .r.A .kitw { opacity: .45; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .r.B .tot, .osb:has(.isBWinner[style*=\"opacity: 1\"]) .r.A .tot { background: #33415c; color: #9fadc5; }\n    .pips { gap: 0 !important; }\n    .pips > [class*=\"TimeoutLeft\"] { margin-right: 4px; }\n    .pips > [style*=\"opacity: 0\"] { width: 0 !important; margin: 0 !important; }\n    .pips > .pip[style*=\"opacity: 0\"] { display: none !important; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.fl,.teamFoulsA,.teamFoulsB,.ot.isGame5Started,.shot.isShotClockActive,.bonus.bonusA,.bonus.bonusB{font-size:16px!important}\n/* end stream-size floor */\n\n  </style>\n</head>\n<body>\n<article class=\"osb\" aria-label=\"Basketball box score\">\n  <div class=\"head\">\n    <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n    <div class=\"status\">\n      <div class=\"live\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span></div>\n      <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"end-t st-s\">END OF</span><span class=\"end-t st-b\"><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span></span><span class=\"half-t st-b\">HALFTIME</span></div>\n      <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FINAL</span><span class=\"fin-ot\">OVERTIME</span></div>\n    </div>\n  </div>\n  <table>\n    <thead><tr><th class=\"tmh\">TEAM</th><th>Q1</th><th>Q2</th><th>Q3</th><th>Q4</th><th class=\"oth o5\">OT1</th><th class=\"oth o6\">OT2</th><th>T</th></tr></thead>\n    <tbody><tr class=\"r A\"><th class=\"tm\"><span class=\"kitw\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><span class=\"nmw\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"sub final-dim\"><span class=\"tor\"><span>TO</span><span class=\"pips\"><span class=\"pip isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\">FOULS <b class=\"teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</b></span><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0;\">WINNER</span><span class=\"tochip isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\">TIMEOUT <span class=\"timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></span></span><span class=\"poss final-dim\"><span class=\"arrow isAPossession\" data-osb-component=\"field\" data-osb-field=\"isAPossession\" style=\"opacity: 0;\"></span></span></th><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"><span class=\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span></td><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span></td><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span></td><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span></td><td class=\"c otc o5\"><span class=\"v isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\"><span class=\"game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span></td><td class=\"c otc o6\"><span class=\"v isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"display: none; opacity: 0;\"><span class=\"game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span></td><td class=\"tot\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></td></tr><tr class=\"r B\"><th class=\"tm\"><span class=\"kitw\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><span class=\"nmw\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"sub final-dim\"><span class=\"tor\"><span>TO</span><span class=\"pips\"><span class=\"pip isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\">FOULS <b class=\"teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</b></span><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0;\">WINNER</span><span class=\"tochip isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\">TIMEOUT <span class=\"timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></span></span><span class=\"poss final-dim\"><span class=\"arrow isBPossession\" data-osb-component=\"field\" data-osb-field=\"isBPossession\" style=\"opacity: 0;\"></span></span></th><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></td><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></td><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></td><td class=\"c\"><span class=\"dash\">&ndash;</span><span class=\"v isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></td><td class=\"c otc o5\"><span class=\"v isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\"><span class=\"game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></td><td class=\"c otc o6\"><span class=\"v isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"display: none; opacity: 0;\"><span class=\"game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></td><td class=\"tot\"><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></td></tr></tbody>\n  </table>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span><span class=\"timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span><span class=\"possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
