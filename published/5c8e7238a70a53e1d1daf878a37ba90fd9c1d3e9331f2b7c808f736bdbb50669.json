{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Possession Rail</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px 50px 28px; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .osb { position: relative; display: grid; grid-template-columns: 1fr 300px 1fr; width: 1180px; height: 96px; color: #fff; background: #08090b; border-top: 4px solid #e8ff3a; filter: drop-shadow(0 8px 18px #000a); }\n    .team { display: grid; grid-template-columns: 124px minmax(0, 1fr); min-width: 0; }\n    .team.B { grid-template-columns: minmax(0, 1fr) 124px; }\n    .team.B > .kit { order: 2; } .team.B .who { text-align: right; align-items: flex-end; }\n    .kit { display: flex; align-items: center; justify-content: center; background-color: #59616e; }\n    .pts { min-width: 96px; padding: 4px 0 0; text-align: center; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 54px; font-weight: 700; line-height: 1; color: #fff; background: #000c; border-radius: 4px; font-variant-numeric: tabular-nums; }\n    .who { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 7px; min-width: 0; padding: 0 22px; }\n    .nm { font-size: 32px; font-weight: 700; line-height: 1; letter-spacing: .5px; text-transform: uppercase; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; max-width: 100%; }\n    .meta { display: flex; align-items: center; gap: 16px; font-size: 16px; font-weight: 600; letter-spacing: 1.5px; color: #9aa1ab; }\n    .team.B .meta { flex-direction: row-reverse; }\n    .pips { display: flex; gap: 5px; }\n    .pip { width: 16px; height: 6px; background: #e8ff3a; }\n    .fl b { color: #fff; margin-left: 4px; }\n    .bonus { font-size: 14px; font-weight: 700; letter-spacing: 1.5px; color: #08090b; background: #e8ff3a; padding: 2px 7px 1px; }\n    .bonus:empty { display: none; }\n    .to { position: absolute; left: 16px; right: 16px; bottom: 10px; height: 30px; align-items: center; justify-content: center; gap: 14px; background: #e8ff3a; color: #08090b; }\n    .to-l { font-size: 18px; font-weight: 700; letter-spacing: 4px; }\n    .to-c { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 21px; font-weight: 700; }\n    .mid { display: grid; background: #15171b; border-left: 1px solid #2c3036; border-right: 1px solid #2c3036; }\n    .mid > * { grid-area: 1 / 1; }\n    .live { position: relative; display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; justify-items: center; }\n    .pa { display: flex; align-items: center; justify-content: center; width: 44px; height: 100%; }\n    .arrow { width: 0; height: 0; border-top: 16px solid transparent; border-bottom: 16px solid transparent; }\n    .pa.A .arrow { border-right: 22px solid #e8ff3a; }\n    .pa.B .arrow { border-left: 22px solid #e8ff3a; }\n    .pa::before { content: \"\"; position: absolute; width: 0; height: 0; border-top: 16px solid transparent; border-bottom: 16px solid transparent; }\n    .core { display: flex; flex-direction: column; align-items: center; gap: 3px; }\n    .gc { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 48px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n    .gc b { color: #e8ff3a; padding: 0 1px; }\n    .sub { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; letter-spacing: 1.5px; color: #9aa1ab; }\n    .per { font-size: 18px; font-weight: 700; color: #08090b; background: #fff; padding: 1px 8px 0; }\n    .shot { position: relative; display: flex; align-items: center; gap: 5px; }\n    .shot-v { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 20px; font-weight: 700; color: #e8ff3a; min-width: 24px; text-align: right; }\n    .run-shot { position: absolute; left: 0; right: 0; bottom: -3px; height: 2px; background: #e8ff3a; }\n    .runbar { position: absolute; left: 60px; right: 60px; bottom: 0; height: 3px; background: #e8ff3a; }\n    .prog { display: flex; gap: 3px; align-items: center; }\n    .q { position: relative; width: 14px; height: 3px; background: #393d44; }\n    .q > span { position: absolute; inset: 0; background: #e8ff3a; }\n    .ot { font-size: 9px; font-weight: 700; padding: 1px 3px 0; line-height: 1; background: #e8ff3a; color: #08090b; }\n    .state { z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; background: #e8ff3a; color: #08090b; }\n    .st-s { font-size: 17px; font-weight: 700; letter-spacing: 3px; }\n    .st-b { font-size: 46px; font-weight: 700; margin-top: 2px; }\n    .brk .half-t { font-size: 44px; }\n    .fin { z-index: 2; background: #fff; }\n    .fin-ot { font-size: 17px; font-weight: 700; letter-spacing: 3px; margin-top: 3px; }\n    .ev { position: absolute; left: 50%; bottom: 100%; transform: translateX(-50%); display: flex; gap: 12px; padding: 6px 16px 4px; background: #e8ff3a; color: #08090b; font-size: 15px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; white-space: nowrap; }\n    .wrap { padding-top: 30px; }\n    .half-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .end-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .half-t { display: block; }\n    .fin-ot { display: none; }\n    .osb:has(.isGame5Started[style*=\"opacity: 1\"]) .fin-ot { display: block; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .final-dim { opacity: .3; filter: grayscale(1); }\n    .pips { gap: 0 !important; }\n    .pips > [class*=\"TimeoutLeft\"] { margin-right: 4px; }\n    .pips > [style*=\"opacity: 0\"] { width: 0 !important; margin: 0 !important; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.ev-n.eventName,.ev-r.matchRound,.ot.isGame5Started,.shot.isShotClockActive{font-size:16px!important}\n/* end stream-size floor */\n\n  </style>\n</head>\n<body>\n<div class=\"wrap\">\n<article class=\"osb\" aria-label=\"Basketball lower third\">\n  <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n  <div class=\"team A\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"pts currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><div class=\"who\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"meta\"><span class=\"pips final-dim\"><span class=\"pip isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft5\" style=\"opacity: 0;\"></span></span><span class=\"fl\">FOULS <b class=\"teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</b></span><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span></div><span class=\"to isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></div></div>\n  <div class=\"mid\">\n    <div class=\"live\"><span class=\"pa A final-dim\"><span class=\"arrow isAPossession\" data-osb-component=\"field\" data-osb-field=\"isAPossession\" style=\"opacity: 0;\"></span></span><span class=\"core\"><span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"sub\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"prog\"><span class=\"q\"><span class=\"isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"ot isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\">OT</span></span><span class=\"shot isShotClockActive\" data-osb-component=\"field\" data-osb-field=\"isShotClockActive\" style=\"opacity: 0;\">SHOT<span class=\"shot-v\" data-osb-static=\"true\" data-sport-stat=\"shotClock\"></span><span class=\"run-shot isShotClockRunning\" data-osb-component=\"field\" data-osb-field=\"isShotClockRunning\" style=\"opacity: 0;\"></span></span></span></span><span class=\"pa B final-dim\"><span class=\"arrow isBPossession\" data-osb-component=\"field\" data-osb-field=\"isBPossession\" style=\"opacity: 0;\"></span></span><span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span></div>\n    <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"end-t st-s\">END OF</span><span class=\"end-t st-b\"><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span></span><span class=\"half-t st-b\">HALFTIME</span></div>\n    <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FINAL</span><span class=\"fin-ot\">OVERTIME</span></div>\n  </div>\n  <div class=\"team B\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"pts currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><div class=\"who\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"meta\"><span class=\"pips final-dim\"><span class=\"pip isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft5\" style=\"opacity: 0;\"></span></span><span class=\"fl\">FOULS <b class=\"teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</b></span><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span></div><span class=\"to isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></div></div>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span><span class=\"timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span><span class=\"possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</div>\n</body>\n</html>\n","css":""}
