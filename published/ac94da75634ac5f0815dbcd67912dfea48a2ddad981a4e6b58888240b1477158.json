{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Evergreen Sand soccer 1</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#174b40}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;min-width:0;padding:14px 0}.board{width:min(70.5vw,calc((100vh - 28px)*2.45));max-width:1520px;container-type:inline-size;min-width:0;background:#f4f0e8;border:1px solid #c7c2b7;border-radius:6px;overflow:hidden}.header{display:flex;align-items:center;min-width:0;min-height:7.8cqw;background:#174b40;color:#ffffff;border-bottom:1px solid #c7c2b7}.sport-title{flex:1 1 0;min-width:0;margin:0;padding:1.3cqw 3.7cqw;font-size:4.6cqw;line-height:1.1;white-space:nowrap}.column-label{display:block;flex:0 0 28%;min-width:0;text-align:center;font-size:3.6cqw;line-height:1.1;white-space:nowrap}.row{display:flex;align-items:stretch;min-width:0;min-height:10cqw;border-bottom:1px solid #c7c2b7;background:#f4f0e8}.identity{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:1.2cqw 2.6cqw;gap:5cqw}.tick{display:block;flex:0 0 3px;min-width:0;height:6.6cqw;background:#174b40}.name{display:block;flex:1 1 0;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:5.6cqw;line-height:1.1;letter-spacing:-.025em;color:#174b40}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-zone{display:flex;align-items:center;justify-content:center;flex:0 0 28%;min-width:0;background:#174b40;color:#ffffff}.score{display:block;width:100%;min-width:0;text-align:center;white-space:nowrap;font-size:8.4cqw;line-height:1.1;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:#ffffff}.footer{display:flex;align-items:stretch;justify-content:center;min-width:0;min-height:9.9cqw;padding:1.2cqw 0;background:#e8decc}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:3cqw;padding:0 1cqw}.stat.clock{flex:1.12 1 0}.stat+.stat{border-left:1px solid #c7c2b7}.label{display:block;font-size:2.7cqw;line-height:1.1;white-space:nowrap}.value{display:block;font-size:5.5cqw;line-height:1.1;font-variant-numeric:tabular-nums;white-space:nowrap}.basketball.variant-1 .stat{flex-direction:column;gap:.3cqw}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}.variant-2{width:min(92.1vw,calc((100vh - 28px)*5));max-width:2000px}.variant-2 .header{min-height:3.92cqw;justify-content:center}.variant-2 .sport-title{flex:none;text-align:center;font-size:3.3cqw;padding:.7cqw 1cqw}.competitors{display:flex;align-items:stretch;min-width:0}.variant-2 .row{flex:1 1 0;min-width:0;min-height:8.48cqw}.variant-2 .identity{padding:1cqw 1.7cqw;gap:2.8cqw}.variant-2 .tick{height:4.4cqw}.variant-2 .row+.row{border-left:1px solid #c7c2b7}.variant-2 .score-zone{flex:0 0 13.15cqw;flex-direction:column;gap:.6cqw}.variant-2 .score-zone .label{font-size:1.5cqw;color:#ffffff}.variant-2 .score{font-size:5.2cqw}.variant-2 .footer{min-height:5.41cqw;padding:.8cqw 0}.variant-2 .footer .label{font-size:1.7cqw}.variant-2 .value{font-size:3.2cqw}.variant-2 .stat{gap:2cqw}.soccer.variant-1{width:min(66vw,calc((100vh - 28px)*2.5));max-width:1420px}.soccer.variant-1 .header{min-height:7.2cqw}.soccer.variant-1 .sport-title{font-size:5cqw;padding:1.1cqw 2.9cqw}.soccer.variant-1 .column-label{flex-basis:19.4%;font-size:4cqw}.soccer.variant-1 .row{min-height:10.5cqw}.soccer.variant-1 .identity{padding:1.2cqw 1.2cqw;gap:4.75cqw}.soccer.variant-1 .tick{height:8.2cqw}.soccer.variant-1 .name{font-size:6.8cqw}.soccer.variant-1 .score-zone{flex-basis:19.4%}.soccer.variant-1 .score{font-size:9.1cqw}.soccer.variant-1 .footer{min-height:9.1cqw;padding:1.2cqw 0}.soccer.variant-1 .footer .label{font-size:3.2cqw}.soccer.variant-1 .value{font-size:5.4cqw}.soccer.variant-2{width:min(85.1vw,calc((100vh - 28px)*5.3));max-width:1900px}.soccer.variant-2 .header{min-height:4.3cqw}.soccer.variant-2 .sport-title{font-size:3cqw}.soccer.variant-2 .row{min-height:7.8cqw}.soccer.variant-2 .identity{padding:.9cqw 1.6cqw;gap:2.2cqw}.soccer.variant-2 .name{font-size:4.1cqw}.soccer.variant-2 .tick{height:4.6cqw}.soccer.variant-2 .score-zone{flex-basis:10.7cqw;gap:.6cqw}.soccer.variant-2 .score-zone .label{font-size:1.6cqw}.soccer.variant-2 .score{font-size:4.7cqw}.soccer.variant-2 .footer{min-height:4.65cqw;padding:.8cqw 0}.soccer.variant-2 .footer .label{font-size:1.8cqw}.soccer.variant-2 .value{font-size:2.9cqw}.soccer.variant-2 .stat,.soccer.variant-2 .stat.clock{flex:none;padding:0 3.2cqw;gap:2.5cqw}@media(max-width:600px){.board,.variant-2,.soccer.variant-1,.soccer.variant-2{width:94vw}.header,.variant-2 .header,.soccer.variant-1 .header,.soccer.variant-2 .header{min-height:44px}.sport-title,.variant-2 .sport-title,.soccer.variant-1 .sport-title,.soccer.variant-2 .sport-title{font-size:17px;padding:10px 12px}.column-label,.soccer.variant-1 .column-label{flex-basis:80px;font-size:12px}.row,.variant-2 .row,.soccer.variant-1 .row,.soccer.variant-2 .row{min-height:64px}.identity,.variant-2 .identity,.soccer.variant-1 .identity,.soccer.variant-2 .identity{padding:10px 12px;gap:12px}.tick,.variant-2 .tick,.soccer.variant-1 .tick,.soccer.variant-2 .tick{flex-basis:3px;height:36px}.name,.variant-2 .name,.soccer.variant-1 .name,.soccer.variant-2 .name{font-size:22px}.score-zone,.soccer.variant-1 .score-zone{flex-basis:84px}.score,.soccer.variant-1 .score{font-size:34px}.footer,.variant-2 .footer,.soccer.variant-1 .footer,.soccer.variant-2 .footer{min-height:60px;padding:10px 0}.stat{gap:8px;padding:0 5px}.footer .label,.variant-2 .footer .label,.soccer.variant-1 .footer .label,.soccer.variant-2 .footer .label{font-size:11px}.value,.variant-2 .value,.soccer.variant-1 .value,.soccer.variant-2 .value{font-size:20px}.basketball.variant-1 .value{font-size:22px}.competitors{flex-direction:column;min-width:0}.variant-2 .row{flex:none;width:100%}.variant-2 .row+.row{border-left:0;border-top:1px solid #c7c2b7}.variant-2 .score-zone,.soccer.variant-2 .score-zone{flex-basis:84px;gap:3px;padding:5px 0}.variant-2 .score-zone .label{font-size:10px}.variant-2 .score,.soccer.variant-2 .score{font-size:34px}.variant-2 .stat,.variant-2 .stat.clock{flex:1 1 0;gap:8px;padding:0 5px}.soccer.variant-2 .stat,.soccer.variant-2 .stat.clock{flex:none;padding:0 14px;gap:8px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer soccer variant-1\" data-osb-component=\"layout\"><header class=\"header rowContainer\" data-osb-component=\"layout\"><h1 class=\"sport-title\" data-osb-component=\"text\">SOCCER</h1><span class=\"column-label\" data-osb-component=\"text\">GOALS</span></header><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-zone columnContainer\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-zone columnContainer\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section><footer class=\"footer rowContainer\" data-osb-component=\"layout\"><div class=\"stat clock rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat half rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">HALF</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\" currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\" currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
