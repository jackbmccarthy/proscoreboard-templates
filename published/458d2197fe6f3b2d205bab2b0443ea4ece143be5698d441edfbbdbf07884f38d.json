{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Score Halo TABLE TENNIS 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f6f7f7}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh}.board{width:min(var(--width),1500px);position:relative;container-type:inline-size;display:flex;flex-direction:column;background:transparent}.header{font-size:var(--title-font);line-height:1;margin:0 0 var(--title-gap);text-align:center;white-space:nowrap;letter-spacing:.12cqw}.name-lane{position:relative;min-width:0}.name{display:block;width:100%;min-width:0;font-size:var(--name-font);line-height:1.05;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.14cqw}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{position:absolute;top:-1.8cqw;right:1cqw;width:1.5cqw;height:1.5cqw;font-size:1.5cqw}.cell{min-width:0;flex-shrink:0}.halo{border-radius:50%;background-color:#9fbb99;padding:var(--outer-stroke);aspect-ratio:1;width:100%;display:flex}.gap{border-radius:50%;padding:var(--ring-gap);background:transparent;width:100%;display:flex}.inner-ring{border-radius:50%;background:#9fbb99;padding:var(--inner-stroke);width:100%;display:flex}.face{width:100%;border-radius:50%;background:#e5eddc;color:#102329;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:inset 0 0 0 .18cqw #101e20;min-width:0}.halo>.gap{background:#071013}.label{font-size:var(--point-label);letter-spacing:var(--label-spacing);line-height:1.1;text-align:center;white-space:nowrap}.score{display:block;width:100%;min-width:0;text-align:center;line-height:1;letter-spacing:-.06em;font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;font-variant-numeric:tabular-nums;white-space:nowrap;font-size:var(--point-font)}.secondary .label{font-size:var(--game-label)}.secondary .score{font-size:var(--game-font)}.primary .label{margin-bottom:.7cqw}.secondary .label{margin-bottom:.4cqw}.point-slot{position:absolute;top:calc(100% + 1cqw);left:50%;transform:translateX(-50%);height:2.5cqw;width:30cqw;font-size:1.8cqw;text-align:center}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw}.point-slot{font-size:2.1cqw}.header{letter-spacing:0}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--width:73vw;--title-font:6.15cqw;--title-gap:4.7cqw;--name-font:12.1cqw;--point-font:13cqw;--game-font:7.2cqw;--point-label:2.3cqw;--game-label:1.9cqw;--label-spacing:.4cqw;--outer-stroke:.45cqw;--ring-gap:.65cqw;--inner-stroke:.45cqw}.rows{display:flex;flex-direction:column;gap:3.2cqw}.row{display:flex;align-items:center;gap:2.5cqw}.name-lane{flex:1}.primary{flex:0 0 26.2%}.secondary{flex:0 0 16.5%}.secondary{transform:translateY(.5cqw)}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">TABLE TENNIS</h1><div class=\"rows columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"cell primary\"><div class=\"halo jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><div class=\"gap\"><div class=\"inner-ring\"><div class=\"face\"><div class=\"label\">POINTS</div><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div></div></div><div class=\"cell secondary\"><div class=\"halo \"><div class=\"gap\"><div class=\"inner-ring\"><div class=\"face\"><div class=\"label\">GAMES</div><span class=\"score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div></div></div></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"cell primary\"><div class=\"halo jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><div class=\"gap\"><div class=\"inner-ring\"><div class=\"face\"><div class=\"label\">POINTS</div><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div></div><div class=\"cell secondary\"><div class=\"halo \"><div class=\"gap\"><div class=\"inner-ring\"><div class=\"face\"><div class=\"label\">GAMES</div><span class=\"score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
