{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Oyster Slate Underbar 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(96vw,1530px);max-width:100%;aspect-ratio:1530/176;overflow:hidden;border-radius:3px;background:#ece8df;color:#283844;container-type:inline-size}\n.lanes{display:flex;flex:1 1 0;min-height:0}\n.lane{display:flex;flex:1 1 0;min-width:0;min-height:0;background:#ece8df}\n.lane+.lane{border-left:2px solid #283844}\n.identity{flex:0 0 3.8%;align-self:stretch;background:#2684a3}\n.jerseyColorB{background:#c86a61}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 5.4%;font-size:clamp(22px,3.8cqw,56px);font-weight:700;line-height:1.08;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.primary,.support{display:flex;align-items:center;justify-content:center;flex-direction:column;min-width:0;font-variant-numeric:tabular-nums;white-space:nowrap}\n.primary{flex:0 0 21%;background:#283844;color:#f8f7f2}\n.support{flex:0 0 20.5%;background:#ece8df;color:#283844}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(34px,4.4cqw,66px);font-weight:800;line-height:1.1;text-align:center}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(28px,3.4cqw,49px);font-weight:800;line-height:1.1;text-align:center}\n.caption{display:block;max-width:100%;overflow:hidden;font-size:clamp(10px,1.45cqw,22px);font-weight:700;line-height:1.1}\n.support .caption{font-size:clamp(10px,1.35cqw,21px)}\n.underbar{display:flex;align-items:center;justify-content:space-between;flex:0 0 31%;min-width:0;padding:0 2%;background:#283844;color:#f8f7f2;font-size:clamp(16px,2cqw,29px);font-weight:700;line-height:1;white-space:nowrap}\n.sport-tag{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.set-status{display:flex;align-items:center;gap:.3em;align-self:stretch;padding-left:2.5%;border-left:1px solid #b8c1be}\n.current-set{display:inline-block;min-width:1ch;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:6px}\n .board{width:100%;height:154px;aspect-ratio:auto}\n .lanes{flex-direction:column}\n .lane+.lane{border-left:0;border-top:1px solid #283844}\n .identity{flex-basis:4%}\n .name{padding:0 7px;font-size:clamp(15px,5cqw,21px)}\n .primary{flex-basis:21%}\n .support{flex-basis:17%}\n .score{font-size:clamp(27px,8.4cqw,38px)}\n .set-score{font-size:clamp(21px,6.6cqw,29px)}\n .caption,.support .caption{font-size:clamp(8px,2.3cqw,10px)}\n .underbar{flex-basis:22%;padding:0 12px;font-size:clamp(12px,3.3cqw,16px)}\n .set-status{padding-left:12px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\" data-osb-component=\"text\">POINTS</span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\" data-osb-component=\"text\">SETS</span></div></div>\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\" data-osb-component=\"text\">POINTS</span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\" data-osb-component=\"text\">SETS</span></div></div>\n  </div>\n  <div class=\"underbar rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
