{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Cobalt Fog Leadchip 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(96vw,1845px);max-width:100%;aspect-ratio:9;overflow:hidden;border-radius:4px;background:#23394b;color:#f7faf9;container-type:inline-size}\n.header{display:flex;align-items:center;flex:0 0 32%;min-width:0;padding:0 2.3%;border-bottom:1px solid #94a9b2}\n.sport-tag{flex:0 1 auto;min-width:0;overflow:hidden;font-size:clamp(15px,2.35cqw,44px);font-weight:750;line-height:1;text-overflow:ellipsis;white-space:nowrap}\n.status{display:flex;align-items:center;gap:.45em;flex:none;margin-left:2.5%;padding-left:2.5%;border-left:1px solid #94a9b2;font-size:clamp(14px,1.8cqw,34px);font-weight:700;line-height:1;white-space:nowrap}\n.current-set{font-variant-numeric:tabular-nums}\n.lanes{display:flex;flex:1 1 0;min-height:0}\n.lane{display:flex;align-items:stretch;flex:1 1 0;min-width:0;min-height:0}\n.lane+.lane{border-left:1px solid #94a9b2}\n.identity{display:block;flex:0 0 2.2%;align-self:stretch;margin:2% 0;background:#3186a8}\n.jerseyColorB{background:#c76c69}\n.support-track{display:flex;align-items:center;justify-content:center;flex:0 0 12.4%;min-width:0;flex-direction:column;align-self:stretch;gap:1px;margin:1.5% 0 1.5% 1.8%;border-radius:4px;background:#c9d7d7;color:#23394b;font-variant-numeric:tabular-nums}\n.support-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(22px,2.8cqw,52px);font-weight:800;line-height:1}\n.support-caption{display:block;max-width:100%;overflow:hidden;font-size:clamp(10px,1.3cqw,24px);font-weight:700;line-height:1;white-space:nowrap}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 4%;font-size:clamp(24px,3.4cqw,63px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.primary-track{display:flex;align-items:center;justify-content:center;flex:0 0 18.5%;min-width:0;flex-direction:column;align-self:stretch;gap:1px;margin:1% 1% 1% 0;background:#23394b;color:#f7faf9;font-variant-numeric:tabular-nums;white-space:nowrap}\n.primary-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(42px,4.8cqw,88px);font-weight:800;line-height:1}\n.primary-caption{display:block;max-width:100%;overflow:hidden;font-size:clamp(11px,1.5cqw,27px);font-weight:700;line-height:1}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:6px}\n .board{width:100%;height:176px;aspect-ratio:auto}\n .header{flex-basis:23%;padding:0 10px}\n .sport-tag{font-size:clamp(13px,4vw,20px)}\n .status{margin-left:12px;padding-left:12px;font-size:clamp(11px,3.2vw,16px)}\n .lanes{flex-direction:column}\n .lane+.lane{border-top:1px solid #94a9b2;border-left:0}\n .identity{flex-basis:6px;margin:0}\n .support-track{flex-basis:17%;margin:4px 0 4px 6px;gap:0}\n .support-score{font-size:clamp(22px,6vw,32px)}\n .support-caption{font-size:clamp(9px,2.5vw,12px)}\n .name{padding:0 8px;font-size:clamp(16px,5vw,25px)}\n .primary-track{flex-basis:25%;gap:0;margin:4px 0}\n .primary-score{font-size:clamp(25px,8vw,40px)}\n .primary-caption{font-size:clamp(8px,2.3vw,12px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n  <div class=\"lanes\" data-osb-component=\"layout\">\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-caption\" data-osb-component=\"text\">SETS</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">POINTS</span></div></div>\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-caption\" data-osb-component=\"text\">SETS</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">POINTS</span></div></div>\n  </div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
