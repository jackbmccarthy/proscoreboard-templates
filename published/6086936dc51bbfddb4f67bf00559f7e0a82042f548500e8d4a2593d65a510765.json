{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>SOFTBALL · Spruce Pearl Leadnote</title><style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f9fbf8}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px;background:transparent}\n.board{width:min(59vw,1180px);min-width:0;overflow:hidden;border:1px solid #a7bcb4;border-radius:4px;background:#28443f;container-type:inline-size;font-variant-numeric:tabular-nums}\n.board.horizontal{width:min(82vw,1660px)}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{display:flex;align-items:stretch;min-width:0;height:13.8cqw;background:#28443f}\n.lane+.lane{border-top:1px solid #a7bcb4}\n.identity{display:block;flex:0 0 2.2cqw;min-width:6px;background:#3185aa}\n.jerseyColorB{background:#c96d70}\n.primary-track{flex:0 0 19%;width:19%;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:#e4e9e3;color:#28443f;white-space:nowrap}\n.primary-number{display:block;max-width:100%;font-size:8cqw;font-weight:700;line-height:.9;font-variant-numeric:tabular-nums}\n.primary-caption{display:block;margin-top:.4cqw;font-size:2.3cqw;font-weight:700;line-height:1;white-space:nowrap}\n.namebed{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.6cqw;padding:0 2.6cqw;overflow:hidden}\n.support-line{display:flex;align-items:baseline;gap:1.2cqw;min-width:0;white-space:nowrap;line-height:1.1}\n.support-caption{font-size:2.3cqw;font-weight:700;letter-spacing:.012em}\n.support-number{font-size:3cqw;font-weight:700;font-variant-numeric:tabular-nums}\n.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:6cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.utility{min-height:5.8cqw;display:flex;align-items:center;min-width:0;padding:0 2.1cqw;background:#e4e9e3;color:#28443f;border-top:1px solid #a7bcb4;white-space:nowrap}\n.sport-tag{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:3.2cqw;font-weight:700;line-height:1;letter-spacing:.005em}\n.status{display:flex;align-items:center;justify-content:flex-end;min-width:0;flex:0 0 auto}\n.status-item{display:flex;align-items:baseline;justify-content:center;gap:.7cqw;min-width:0;padding:0 1.2cqw;border-left:1px solid #60776e;font-size:2cqw;font-weight:700;line-height:1}\n.status-value{font-size:1.25em;font-weight:700;font-variant-numeric:tabular-nums}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.horizontal .lanes{flex-direction:row}\n.horizontal .lane{height:9.8cqw;flex:1 1 50%}\n.horizontal .lane+.lane{border-top:0;border-left:1px solid #a7bcb4}\n.horizontal .identity{flex-basis:1.7cqw}\n.horizontal .primary-track{flex-basis:20%;width:20%}\n.horizontal .primary-number{font-size:5.5cqw}\n.horizontal .primary-caption{font-size:1.4cqw;margin-top:.2cqw}\n.horizontal .namebed{padding:0 1.8cqw;gap:.25cqw}\n.horizontal .support-caption{font-size:1.6cqw}\n.horizontal .support-number{font-size:2.1cqw}\n.horizontal .name{font-size:3.9cqw}\n.horizontal .utility{min-height:4cqw}\n.horizontal .sport-tag{font-size:2.4cqw}\n.horizontal .status-item{font-size:1.5cqw}\n@media(max-width:650px){\n .board,.board.horizontal{width:94vw;container-type:normal}\n .lanes,.horizontal .lanes{flex-direction:column}\n .lane,.horizontal .lane{height:82px;flex:0 0 auto}\n .lane+.lane,.horizontal .lane+.lane{border-left:0;border-top:1px solid #a7bcb4}\n .identity,.horizontal .identity{flex-basis:7px}\n .primary-track,.horizontal .primary-track{flex-basis:23%;width:23%}\n .primary-number,.horizontal .primary-number{font-size:38px}\n .primary-caption,.horizontal .primary-caption{font-size:10px;margin-top:2px}\n .namebed,.horizontal .namebed{padding:0 12px;gap:3px}\n .support-line{gap:5px}\n .support-caption,.horizontal .support-caption{font-size:11px}\n .support-number,.horizontal .support-number{font-size:14px}\n .name,.horizontal .name{font-size:clamp(20px,6.6vw,27px)}\n .utility,.horizontal .utility{min-height:57px;flex-direction:column;align-items:stretch;justify-content:center;gap:4px;padding:5px 8px}\n .sport-tag,.horizontal .sport-tag{flex:none;font-size:12px}\n .status{flex:none;justify-content:space-between}\n .status-item,.horizontal .status-item{flex:1 1 auto;gap:3px;padding:0 5px;font-size:10px}\n .status-item:first-child{border-left:0;padding-left:0}\n .status-item:last-child{padding-right:0}\n .status-value{font-size:12px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scoreboard\">\n <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"lane rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n    <div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">RUNS</span></div>\n    <div class=\"namebed\" data-osb-component=\"layout\"><div class=\"support-line\" data-osb-component=\"layout\"><span class=\"support-caption\" data-osb-component=\"text\">HITS</span><span class=\"support-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div>\n    <span class=\"hidden-match currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\" hidden>0</span>\n  </div><div class=\"lane rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n    <div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\" data-osb-component=\"text\">RUNS</span></div>\n    <div class=\"namebed\" data-osb-component=\"layout\"><div class=\"support-line\" data-osb-component=\"layout\"><span class=\"support-caption\" data-osb-component=\"text\">HITS</span><span class=\"support-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div>\n    <span class=\"hidden-match currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\" hidden>0</span>\n  </div></div>\n <footer class=\"utility\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">SOFTBALL</span><div class=\"status\" data-osb-component=\"layout\"><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></span><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></span></div></footer>\n <div class=\"point-slot\" data-osb-component=\"layout\" hidden><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n</article></main></body></html>\n","css":""}
