{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Plum Pearl Outboard Volleyball — Compact</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { width: 100%; min-height: 100%; margin: 0; background: transparent; }\n    body { font-family: Arial, Helvetica, sans-serif; }\n    .stage { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 12px; }\n    .board { display: flex; flex-direction: column; width: min(62vw, 1120px); max-width: 100%; overflow: hidden; border: 1px solid #bdb5bd; border-radius: 3px; color: #faf8f7; background: #302b38; container-type: inline-size; }\n    .header { position: relative; display: flex; align-items: end; height: 6cqw; min-height: 43px; border-bottom: 1px solid #bdb5bd; background: #ece7e9; color: #272331; }\n    .sport { display: flex; align-items: start; align-self: stretch; flex: 1 1 auto; min-width: 0; padding-top: .7cqw; padding-left: 1.5cqw; font-size: 3.5cqw; font-weight: 800; line-height: 1; white-space: nowrap; }\n    .points-label { position: absolute; left: 0; bottom: .28cqw; display: flex; justify-content: center; width: 16%; font-size: 1.15cqw; font-weight: 700; line-height: 1; }\n    .sets-label { display: flex; justify-content: center; align-items: center; flex: 0 0 15%; align-self: stretch; margin-left: auto; font-size: 2.2cqw; font-weight: 700; line-height: 1; }\n    .teams { display: flex; flex-direction: column; min-width: 0; }\n    .team { display: flex; align-items: stretch; height: 11.2cqw; min-height: 57px; min-width: 0; background: #302b38; }\n    .team + .team { border-top: 1px solid #bdb5bd; }\n    .score { display: flex; align-items: center; justify-content: center; flex: 0 0 16%; min-width: 0; background: #ece7e9; color: #272331; font-size: 7.9cqw; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n    .tick { display: block; flex: 0 0 2.6%; background: #836a87; }\n    .jerseyColorB { background: #9c807f; }\n    .name { display: block; align-content: center; flex: 1 1 auto; min-width: 0; overflow: hidden; padding: 0 3.1cqw; color: #faf8f7; font-size: 4.9cqw; font-weight: 700; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .sets { display: flex; align-items: center; justify-content: center; flex: 0 0 15%; min-width: 0; color: #faf8f7; font-size: 4cqw; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }\n    .footer { display: flex; align-items: center; justify-content: center; height: 6.1cqw; min-height: 40px; border-top: 1px solid #bdb5bd; background: #302b38; }\n    .set-label { color: #ece7e9; font-size: 2.35cqw; font-weight: 700; line-height: 1; }\n    .set-value { margin-left: 2.2cqw; color: #faf8f7; font-size: 4.7cqw; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }\n    .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint,\n    .point-slot:has(> .isMatchPoint[style*=\"opacity:1\"]) > .isGamePoint { opacity: 0 !important; }\n    @media (max-width: 600px) {\n      .board { width: 100%; }\n      .header { height: 43px; }\n      .sport { padding-top: 5px; padding-left: 9px; font-size: 18px; }\n      .points-label { padding-bottom: 2px; font-size: 9px; }\n      .sets-label { font-size: 11px; }\n      .team { height: 61px; }\n      .score { font-size: 36px; }\n      .name { padding: 0 9px; font-size: 21px; }\n      .sets { font-size: 22px; }\n      .footer { height: 40px; }\n      .set-label { font-size: 13px; }\n      .set-value { margin-left: 9px; font-size: 25px; }\n    }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n  <main class=\"stage\" data-osb-component=\"layout\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"sport\" data-osb-component=\"text\">VOLLEYBALL</span>\n        <span class=\"points-label\" data-osb-component=\"text\">POINTS</span>\n        <span class=\"sets-label\" data-osb-component=\"text\">SETS</span>\n      </header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span>\n          <span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <span class=\"sets currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n        </div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span>\n          <span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <span class=\"sets currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n        </div>\n      </div>\n      <footer class=\"footer rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"set-label\" data-osb-component=\"text\">SET</span><span class=\"set-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
