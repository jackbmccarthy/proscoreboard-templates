{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Table Green</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\nhtml,body{height:100%;overflow:hidden}\n.osb-core-fields{display:none!important}\n.board{position:fixed;inset:0;display:flex;flex-direction:column;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:#0b1f17;-webkit-font-smoothing:antialiased;overflow:hidden}\n.bar{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:2vw;flex:0 0 14vh;padding:0 2.4vw;background:#08140f}\n.info{display:flex;flex-direction:column;justify-content:center;gap:.6vh;min-width:0;text-transform:uppercase;white-space:nowrap}\n.info>*{overflow:hidden;text-overflow:ellipsis}\n.teamlbl{display:none;font-size:4vh;font-weight:800;letter-spacing:.08em}\n.info:not(:has(.ev:not(:empty))):not(:has(.rd:not(:empty))) .teamlbl{display:block}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.info:not(:has(.rd:not(:empty))):not(:has(.bo:not(:empty))) .l2{display:none}\n.ev{font-size:4vh;font-weight:800;letter-spacing:.06em}\n.l2{display:flex;align-items:center;font-size:3vh;font-weight:700;letter-spacing:.08em;color:#9cc9b2}\n.l2 .sep{font-style:normal;padding:0 .6em}\n.l2 .rd:empty+.sep,.l2 .sep:has(+.bo:empty){display:none}\n.center{display:flex;align-items:center;gap:1vw}\n.tagslot{width:33vh;height:9vh}\n.tagslot>*{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.gtag{background:#fff;color:#0b3d2a}\n.fin{background:#ffd23f;color:#111}\n.banner{width:47vh;height:9vh}\n.bn{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.bn-warm,.bn-break{box-shadow:inset 0 0 0 .5vh #fff;color:#fff}\n.bn-gp{background:#ff8a1c;color:#111}\n.bn-mp{background:#e3262f;color:#fff}\n.chips{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:.8vh}\n.chip{width:24vh;height:4.8vh}\n.fl{border-radius:.6vh;font-size:2.8vh;font-weight:800;letter-spacing:.06em;text-transform:uppercase;box-shadow:inset 0 0 0 .3vh #9cc9b2;color:#e7f5ee}\n.table{display:flex;flex:1 1 auto;min-height:0;margin:2.4vh 2.4vw 3vh;border:1vh solid #f4f4ef;border-radius:.6vh;background:#13623f;box-shadow:0 1vh 3vh rgba(0,0,0,.45)}\n.net{flex:0 0 1.2vw;background:repeating-linear-gradient(0deg,#1c1c1c 0 .6vh,#3b3b3b .6vh 1.2vh);box-shadow:inset .25vw 0 0 #f4f4ef,inset -.25vw 0 0 #f4f4ef}\n.end{position:relative;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto 1fr auto;grid-template-areas:\"gw who\" \"pts pts\" \"foot foot\";flex:1 1 0;min-width:0;padding:2.6vh 2vw 2vh}\n.eB{grid-template-columns:1fr auto;grid-template-areas:\"who gw\" \"pts pts\" \"foot foot\"}\n.kit{position:absolute;left:0;right:0;bottom:0;height:1.2vh;background:#7aa08d}\n.who{grid-area:who;display:flex;align-items:center;gap:1.2vw;min-width:0;padding-left:1.6vw}\n.eB .who{padding:0 1.6vw 0 0}\n.eB .who{flex-direction:row-reverse;text-align:right}\n.flag{flex:0 0 auto;width:7vh;height:4.7vh;object-fit:cover;border-radius:.4vh;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.nm{display:flex;flex-direction:column;gap:.6vh;min-width:0}\n.eB .nm{align-items:flex-end}\n.name{font-size:4.8vh;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;hyphens:none}\n.team{display:flex;align-items:center;gap:1vw;font-size:3.2vh;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#bfe0cf}\n.eB .team{flex-direction:row-reverse}\n.tlogo{width:5vh;height:5vh;object-fit:contain}\n.tie{display:inline-flex;align-items:center;gap:.6vw;padding:0 1vw;height:5vh;border-radius:.6vh;background:#0b3d2a;color:#fff;flex:0 0 auto}\n.tie i{font-style:normal;color:#9cc9b2}\n.team:not(:has(.tname:not(:empty))){display:none}\n.nm:has(.name:empty) .team{flex-wrap:wrap;font-size:4.6vh;color:#fff}\n.nm:has(.name:empty) .tname{line-height:1.05}\n.gw{grid-area:gw;display:flex;flex-direction:column;align-items:center;gap:.4vh;padding:1vh 1.2vw;border:.5vh solid #f4f4ef;border-radius:1vh;font-weight:900;text-transform:uppercase}\n.gw i{font-style:normal;font-size:2.8vh;letter-spacing:.18em;color:#d8eee2}\n.gn{font-size:9vh;line-height:.9;font-variant-numeric:tabular-nums}\n.pts{grid-area:pts;display:flex;align-items:center;justify-content:center;min-height:0}\n.big{font-size:44vh;line-height:.8;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em;text-shadow:0 1vh 2.4vh rgba(0,0,0,.25)}\n.foot{grid-area:foot;display:flex;align-items:center;gap:1.2vw;min-height:9vh}\n.eB .foot{flex-direction:row-reverse}\n.hist{position:relative;display:flex;gap:.7vw}\n.hg{display:flex;align-items:center;gap:.6vw;height:6.4vh;padding:0 1.1vw;border-radius:.8vh;font-weight:800;font-variant-numeric:tabular-nums}\n.hl{font-style:normal;font-size:2.8vh;letter-spacing:.08em;opacity:.8}\n.gs{font-size:4.2vh}\n\n.hg:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;padding:0!important;margin:0!important;border:0!important}\n.hg .won{display:none}\n.hg{background:#0e4a30;color:#8fbfa6}\n.end[data-osb-resolved-court-side=\"A\"] .hg:has(.wA[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"] .hg:has(.wB[style*=\"opacity: 1\"]){background:#f4f4ef;color:#0b3d2a}\n.end[data-osb-resolved-court-side=\"A\"] .isBWinner,.end[data-osb-resolved-court-side=\"B\"] .isAWinner,.end:not([data-osb-resolved-court-side]) :is(.isAWinner,.isBWinner){display:none!important}\n\n.to-slot{width:17vh;height:6vh}\n.to-on,.to-used{border-radius:.6vh;font-size:3vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.to-on{background:#ffd23f;color:#111}\n.to-used{box-shadow:inset 0 0 0 .4vh #8fbfa6;color:#d8eee2}\n.cs{width:4.2vh;height:6vh}\n.card{border-radius:.6vh;box-shadow:0 0 0 .3vh rgba(0,0,0,.3)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.ss{width:9vh;height:9vh;margin-left:auto}\n.eB .ss{margin-left:0;margin-right:auto}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .5vh rgba(0,0,0,.25),0 0 3vh rgba(255,138,28,.5)}\n.win{grid-area:gw;align-self:center;display:flex;align-items:center;height:8vh;padding:0 2vw;border-radius:1vh;background:#ffd23f;color:#111;font-size:3.6vh;font-weight:900;letter-spacing:.16em;text-transform:uppercase}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .big{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{grid-area:pts;align-self:center;justify-self:center;flex-direction:column-reverse;border:0;padding:0;gap:2vh}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{font-size:40vh;line-height:.8}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw i{font-size:4.2vh}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]{box-shadow:inset 0 0 0 .8vh #ffd23f}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]{background:#0d3f29}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) :is(.gn,.name,.flag,.hist){opacity:.45}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]) .gn{color:#ffd23f}\n\n</style>\n</head>\n<body>\n<main class=\"board t-table\" data-osb-component=\"layout\"><div class=\"bar\" data-osb-component=\"layout\"><span class=\"info\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></spa