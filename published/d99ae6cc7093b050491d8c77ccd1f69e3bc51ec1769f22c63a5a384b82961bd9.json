{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pearl Graphite Rightdock — Soccer 1</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.board{display:flex;overflow:hidden;background:#e8ebe7;color:#26363e;border:1px solid #b5c0bd;border-radius:2px;font-variant-numeric:tabular-nums}.lanes{display:flex;flex:1 1 auto;min-width:0}.competitor{display:flex;align-items:stretch;min-width:0;background:#e8ebe7}.tick{display:block;flex:0 0 9px;background:#2b85a3}.jerseyColorB{background:#c76b64}.name{display:flex;align-items:center;flex:1 1 auto;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;padding:0 18px 0 26px;font-size:clamp(21px,3cqw,52px);font-weight:700;line-height:1}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.support-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 85px;min-width:0;background:#e8ebe7;text-align:center}.support-number{font-size:30px;font-weight:700;line-height:1}.support-label{margin-top:3px;font-size:11px;font-weight:700;line-height:1.1;letter-spacing:.02em}.primary-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 116px;min-width:0;background:#26363e;color:#f8faf8;text-align:center}.primary-number{font-size:60px;font-weight:800;line-height:.98}.primary-label{margin-top:4px;font-size:12px;font-weight:700;letter-spacing:.025em}.dock{display:flex;flex-direction:column;flex:0 0 20%;min-width:0;background:#26363e;color:#f8faf8;border-left:1px solid #62777d}.dock-title{font-size:17px;font-weight:800;letter-spacing:.015em;line-height:1.1}.stat{display:flex;min-width:0}.stat-label{font-size:11px;font-weight:700;color:#d8e0de;line-height:1.1}.stat-value{font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained{display:none}.compact{width:min(60vw,930px);height:188px;container-type:inline-size}.compact .lanes{flex-direction:column}.compact .competitor{flex:1 1 0}.compact .competitor+.competitor{border-top:1px solid #b5c0bd}.compact .dock{padding:16px 15px 12px}.compact .dock-title{text-align:center;margin-bottom:11px}.compact .stat{flex:1 1 0;flex-direction:column;justify-content:center;gap:3px;padding:4px 0 3px 5px;border-top:1px solid #62777d}.compact .stat-value{font-size:22px}.wide{width:min(94vw,1640px);height:154px;container-type:inline-size}.wide .lanes{flex-direction:row}.wide .competitor{flex:1 1 50%}.wide .competitor+.competitor{border-left:1px solid #b5c0bd}.wide .dock{flex-basis:17%;padding:14px 15px 12px}.wide .dock-title{margin-bottom:auto;text-align:center}.wide .stats{display:flex;align-items:stretch;gap:0}.wide .stat{flex:1 1 0;align-items:center;justify-content:center;flex-direction:column;gap:6px;padding:3px}.wide .stat+.stat{border-left:1px solid #62777d}.wide .stat-value{font-size:20px}.wide .support-track{border-left:1px solid #b5c0bd}@media(max-width:800px){.stage{padding:8px}.board{width:100%;height:138px}.compact .dock{flex-basis:24%;padding:8px 6px}.compact .sport-title,.wide .dock-title{font-size:clamp(10px,2.2vw,15px)}.compact .stat-label,.wide .stat-label{font-size:clamp(8px,1.8vw,10px)}.compact .stat-value,.wide .stat-value{font-size:clamp(13px,3vw,20px)}.name{padding:0 5px 0 9px;font-size:clamp(14px,3.8vw,25px)}.tick{flex-basis:5px}.support-track{flex-basis:46px}.support-number{font-size:20px}.support-label{font-size:8px}.primary-track{flex-basis:57px}.primary-number{font-size:35px}.primary-label{font-size:8px}.wide .dock{flex-basis:20%;padding:8px 5px}.wide .stats{flex-direction:column}.wide .stat{flex-direction:row;justify-content:space-between;gap:2px;padding:2px 0}.wide .stat+.stat{border-left:0;border-top:1px solid #62777d}.wide .dock-title{margin-bottom:auto}.wide .name{font-size:clamp(12px,2.4vw,20px);padding-left:5px}.wide .support-track{flex-basis:36px}.wide .primary-track{flex-basis:48px}.wide .primary-number{font-size:30px}.wide .support-number{font-size:17px}.wide .support-label,.wide .primary-label{font-size:7px}}@media(max-width:460px){.compact .dock-title{font-size:9px;letter-spacing:0}.wide{height:110px}.wide .name{font-size:12px;padding:0 2px}.wide .support-track{flex-basis:26px}.wide .primary-track{flex-basis:34px}.wide .support-number{font-size:15px}.wide .primary-number{font-size:19px}.wide .support-label,.wide .primary-label{font-size:6px}.wide .dock{flex-basis:22%;padding:5px 3px}.wide .dock-title{font-size:9px}.wide .stat-label{font-size:7px}.wide .stat-value{font-size:10px}.wide .tick{flex-basis:3px}}\n.board{position:relative}.neutral-point-slot{position:absolute;width:0;height:0;overflow:hidden;pointer-events:none}.neutral-point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint,.neutral-point-slot:has(.isMatchPoint[style*=\"opacity:1\"]) .isGamePoint{opacity:0!important}</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board compact rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Soccer scoreboard\"><div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-a\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-b\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><aside class=\"dock columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Editable static soccer status\"><span class=\"dock-title\" data-osb-component=\"text\">SOCCER</span><div class=\"stats\" data-osb-component=\"layout\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></div></aside><span class=\"neutral-point-slot\" aria-hidden=\"true\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\"></span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\"></span></span></article></main></body></html>\n","css":""}
