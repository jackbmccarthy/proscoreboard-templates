{"html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Open Corner Grid Volleyball 2</title><style>*{box-sizing:border-box}html,body{margin:0;background:transparent;color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;font-weight:700}.rowContainer{display:flex;flex-direction:row}.columnContainer{display:flex;flex-direction:column}.stage{min-height:100vh;align-items:center;justify-content:center;padding:24px}.board{width:80vw;max-width:1500px;container-type:inline-size;background:transparent}.sport{font-size:5.1cqw;line-height:1.08;margin:0 0 2.5cqw;letter-spacing:.01em}.sport::after{content:\"\";display:block;width:29cqw;height:.5cqw;background:#ef442c;margin-top:1.2cqw}.competitor{min-width:0;align-items:center;gap:6.8cqw;min-height:16.5cqw;border-bottom:1px solid #f4f6f8}.name{flex:1 1 0;min-width:0;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:6.6cqw;line-height:1.2}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.numeric-col{flex:0 0 15%;min-width:0;align-items:center;gap:1.2cqw}.label{font-size:2.5cqw;line-height:1.1;white-space:nowrap;letter-spacing:.025em}.bracket{position:relative;width:12.3cqw;height:10.5cqw;display:flex;align-items:center;justify-content:center;flex:none}.value{display:block;width:100%;text-align:center;font-size:8.2cqw;font-family:\"Arial Black\",Arial,sans-serif;font-weight:900;line-height:1;font-variant-numeric:tabular-nums}.corner{position:absolute;width:17%;height:18%;border-color:#f4f6f8;border-style:solid;border-width:0;pointer-events:none}.tl{top:0;left:0;border-top-width:3px;border-left-width:3px}.tr{top:0;right:0;border-top-width:3px;border-right-width:3px}.bl{bottom:0;left:0;border-bottom-width:3px;border-left-width:3px}.br{bottom:0;right:0;border-bottom-width:3px;border-right-width:3px}.footer{justify-content:center;align-items:center;gap:1.8cqw;margin-top:2.4cqw;font-size:3.2cqw}.footer .counter{font-size:5.8cqw;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}\n.sport{text-align:center;font-size:6cqw;margin-bottom:5cqw}.sport::after{display:none}.duel{align-items:stretch}.side{flex:1 1 0;min-width:0;align-items:stretch;padding:0 3.5cqw;gap:3.4cqw}.side+.side{border-left:3px solid #ef442c}.side .name{font-size:5.9cqw;text-align:center;flex:none;width:100%}.score-pair{align-items:stretch;justify-content:space-between;gap:4.5cqw}.score-pair .numeric-col{flex:1 1 0;min-width:0}.score-pair .label{font-size:3cqw}.score-pair .bracket{width:18cqw;height:16cqw}.score-pair .value{font-size:12.5cqw}.footer{margin-top:4cqw}\n@media(max-width:600px){.stage{padding:14px}.board{width:100%}.sport{font-size:6.5cqw}.competitor{min-height:20cqw;gap:4cqw}.name{font-size:6cqw}.label{font-size:clamp(8px,2.5cqw,16px)}.corner{border-width:0}.tl{border-top-width:2px;border-left-width:2px}.tr{border-top-width:2px;border-right-width:2px}.bl{border-bottom-width:2px;border-left-width:2px}.br{border-bottom-width:2px;border-right-width:2px}.footer{font-size:4cqw}.footer .counter{font-size:7cqw}.side{padding:0 2.5cqw}.side .name{font-size:5.5cqw}.side+.side{border-left-width:2px}.score-pair{gap:3cqw}.score-pair .label{font-size:clamp(8px,3cqw,14px)}}</style></head><body><main class=\"stage columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"sport\">VOLLEYBALL</header><div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-pair rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"numeric-col columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"bracket\"><i class=\"corner tl\"></i><i class=\"corner tr\"></i><i class=\"corner bl\"></i><i class=\"corner br\"></i><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div><div class=\"numeric-col columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"bracket\"><i class=\"corner tl\"></i><i class=\"corner tr\"></i><i class=\"corner bl\"></i><i class=\"corner br\"></i><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div></div>\n<div class=\"side columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-pair rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"numeric-col columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"bracket\"><i class=\"corner tl\"></i><i class=\"corner tr\"></i><i class=\"corner bl\"></i><i class=\"corner br\"></i><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"numeric-col columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"bracket\"><i class=\"corner tl\"></i><i class=\"corner tr\"></i><i class=\"corner bl\"></i><i class=\"corner br\"></i><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div></div><footer class=\"footer rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SET</span><span class=\"counter\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer><div class=\"retained\"><span class=\" jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\" jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></div><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
