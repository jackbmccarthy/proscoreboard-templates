{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Team Tie</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%;background:#000;overflow:hidden}\n.stage{position:fixed;inset:0;container-type:size;display:grid;place-items:center}\n.board{--u:calc(min(100cqw,177.7778cqh)/1920);position:relative;overflow:hidden;width:min(100cqw,177.7778cqh);height:min(56.25cqw,100cqh);font-family:\"Helvetica Neue\",Arial,sans-serif;font-variant-numeric:lining-nums tabular-nums}\n.name,.team{display:flex;align-items:safe center;justify-content:center;text-align:center;overflow:hidden;overflow-wrap:anywhere;line-height:1.05}\n.game,.games,.teamScore{white-space:nowrap;line-height:1;text-align:center}\nimg:not([src]),img[src=\"\"]{display:none}\n.isGamePoint,.isMatchPoint,.isInBetweenGames,.isSwitched,.isCourtSideScoreboardFlipped,.courtSideIsACurrentlyServing,.courtSideIsBCurrentlyServing,.isAYellowCarded,.isBYellowCarded,.isARedCarded,.isBRedCarded,.isATimeOutActive,.isBTimeOutActive{opacity:0}\n.pointSlot{position:absolute}\n.ban{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap;font-weight:900}\n.pointSlot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint,.pointSlot:has(.isInBetweenGames[style*=\"opacity: 1\"]) :is(.isGamePoint,.isMatchPoint){opacity:0!important}\n.chip{position:absolute;display:flex;align-items:center;justify-content:center;white-space:nowrap;font-weight:800}\n.serve{position:absolute}\n\n.board{background:#17262f;color:#f9fbfa}\n.panel{position:absolute;top:0;bottom:0;width:calc(960*var(--u))}\n.pA{left:0;background:#23394b}.pB{left:calc(960*var(--u));background:#35505e}\n.panel::before{content:\"\";position:absolute;left:0;right:0;top:0;height:calc(200*var(--u));background:#17262f;border-bottom:calc(10*var(--u)) solid #2678a9}\n.pB::before{border-bottom-color:#c85e66}\n.tlogo{position:absolute;top:calc(36*var(--u));width:calc(130*var(--u));height:calc(130*var(--u));object-fit:contain}\n.pA .tlogo{left:calc(40*var(--u))}.pB .tlogo{right:calc(40*var(--u))}\n.team{position:absolute;top:calc(36*var(--u));width:calc(450*var(--u));height:calc(130*var(--u));font-size:calc(54*var(--u));font-weight:800;color:#b8c7ca}\n.pA .team{left:calc(190*var(--u));justify-content:flex-start;text-align:left}.pB .team{right:calc(190*var(--u));justify-content:flex-end;text-align:right}\n.teamScore{position:absolute;top:calc(30*var(--u));width:calc(150*var(--u));height:calc(140*var(--u));border-radius:calc(14*var(--u));background:#f3d27a;color:#17262f;font-size:calc(120*var(--u));line-height:calc(140*var(--u));font-weight:900}\n.pA .teamScore{left:calc(660*var(--u))}.pB .teamScore{right:calc(660*var(--u))}\n.hdr{position:absolute;left:calc(820*var(--u));width:calc(280*var(--u));top:calc(20*var(--u));height:calc(160*var(--u));display:flex;flex-direction:column;align-items:center;justify-content:center;gap:calc(6*var(--u));font-size:calc(28*var(--u));color:#9bb1bd;letter-spacing:.08em;text-transform:uppercase;z-index:2}\n.hdr .matchRound{font-size:calc(40*var(--u));color:#f3d27a;font-weight:800}\n.name{position:absolute;left:calc(160*var(--u));right:calc(170*var(--u));top:calc(218*var(--u));height:calc(170*var(--u));font-size:calc(78*var(--u));font-weight:800}\n.serve{top:calc(260*var(--u));width:calc(64*var(--u));height:calc(64*var(--u));border-radius:50%;background:#f3d27a;box-shadow:0 0 0 calc(8*var(--u)) rgba(243,210,122,.3)}\n.pA .serve{left:calc(56*var(--u))}.pB .serve{right:calc(56*var(--u))}\n.card{position:absolute;width:calc(40*var(--u));height:calc(58*var(--u));border-radius:calc(5*var(--u))}.yc{background:#e5c94e}.rc{background:#c94747}\n.card{top:calc(244*var(--u))}.pA .yc{right:calc(112*var(--u))}.pA .rc{right:calc(56*var(--u))}.pB .yc{left:calc(112*var(--u))}.pB .rc{left:calc(56*var(--u))}\n.to{position:absolute;left:calc(260*var(--u));width:calc(440*var(--u));top:calc(392*var(--u));height:calc(66*var(--u));display:flex;align-items:center;justify-content:center;border:calc(4*var(--u)) solid #f3d27a;border-radius:calc(33*var(--u));background:#17262f;color:#f3d27a;font-size:calc(38*var(--u));font-weight:800;letter-spacing:.08em;z-index:1}\n.game{position:absolute;left:0;right:0;top:calc(390*var(--u));height:calc(520*var(--u));font-size:calc(520*var(--u));line-height:calc(520*var(--u));font-weight:900}\n.lbl{position:absolute;bottom:calc(100*var(--u));font-size:calc(44*var(--u));font-weight:800;letter-spacing:.12em;color:#9bb1bd}\n.pA .lbl{left:calc(56*var(--u))}.pB .lbl{right:calc(56*var(--u))}\n.games{position:absolute;bottom:calc(62*var(--u));width:calc(170*var(--u));height:calc(150*var(--u));font-size:calc(140*var(--u));line-height:calc(150*var(--u));font-weight:900;color:#f3d27a}\n.pA .games{left:calc(230*var(--u))}.pB .games{right:calc(230*var(--u))}\n.div{position:absolute;left:calc(956*var(--u));width:calc(8*var(--u));top:calc(210*var(--u));bottom:0;background:#f3d27a;z-index:1}\n.pointSlot{left:calc(640*var(--u));width:calc(640*var(--u));top:calc(930*var(--u));height:calc(110*var(--u));z-index:3}\n.ban{font-size:calc(70*var(--u));border-radius:calc(14*var(--u));letter-spacing:.04em}\n.gp{background:#f3d27a;color:#17262f}.mp{background:#c94747;color:#f9fbfa}.bt{background:#f9fbfa;color:#23394b;font-size:calc(58*var(--u))}\n.chip{bottom:calc(12*var(--u));height:calc(34*var(--u));padding:0 calc(18*var(--u));border-radius:calc(17*var(--u));background:rgba(0,0,0,.35);color:#b8c7ca;font-size:calc(20*var(--u));letter-spacing:.08em}\n.chipS{left:calc(24*var(--u))}.chipF{right:calc(24*var(--u))}\n\n.osb-core-fields{display:none!important}\n</style>\n</head>\n<body>\n<div class=\"stage\"><div class=\"board\">\n  <section class=\"courtSideAView panel pA \">\n    <img class=\"teamLogoURLA tlogo\" alt=\"\">\n    <div class=\"teamAName team\"></div>\n    <div class=\"teamAScore teamScore\">0</div>\n    <div class=\"courtSideIsACurrentlyServing serve\"></div>\n    <div class=\"courtSideCombinedAName name\"></div>\n    <div class=\"isAYellowCarded card yc\"></div>\n    <div class=\"isARedCarded card rc\"></div>\n    <div class=\"courtSideAGameScore game\">0</div>\n    <div class=\"lbl\">GAMES</div>\n    <div class=\"courtSideAMatchScore games\">0</div>\n    <div class=\"isATimeOutActive to\">TIME-OUT</div>\n  </section>\n  <section class=\"courtSideBView panel pB \">\n    <img class=\"teamLogoURLB tlogo\" alt=\"\">\n    <div class=\"teamBName team\"></div>\n    <div class=\"teamBScore teamScore\">0</div>\n    <div class=\"courtSideIsBCurrentlyServing serve\"></div>\n    <div class=\"courtSideCombinedBName name\"></div>\n    <div class=\"isBYellowCarded card yc\"></div>\n    <div class=\"isBRedCarded card rc\"></div>\n    <div class=\"courtSideBGameScore game\">0</div>\n    <div class=\"lbl\">GAMES</div>\n    <div class=\"courtSideBMatchScore games\">0</div>\n    <div class=\"isBTimeOutActive to\">TIME-OUT</div>\n  </section>\n  <div class=\"div\"></div>\n  <div class=\"hdr\"><span class=\"eventName\"></span><span class=\"matchRound\"></span></div>\n  <div class=\"pointSlot \">\n    <div class=\"isInBetweenGames ban bt\">BETWEEN GAMES</div>\n    <div class=\"isMatchPoint ban mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</div>\n    <div class=\"isGamePoint ban gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</div>\n  </div>\n  <div class=\"isSwitched chip chipS\">ENDS SWITCHED</div>\n  <div class=\"isCourtSideScoreboardFlipped chip chipF\">BOARD FLIPPED</div>\n</div></div>\n<div class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n</body>\n</html>\n","css":""}
