{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>baseball score halo 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#f8f9fa}body{font-family:Arial,sans-serif;font-weight:700}.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}.board{width:min(76vw,1460px);container-type:inline-size;display:flex;flex-direction:column;position:relative}.sport{font-size:6.6cqw;letter-spacing:0cqw;line-height:1;text-align:center}.competitors{display:flex;flex-direction:row;margin-top:4.5cqw;}.competitor{display:flex;min-width:0;flex:1 1 0;flex-direction:column;align-items:center;}.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.8cqw;line-height:1.05;width:100%;text-align:center;margin-bottom:2.5cqw;}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.runs{display:flex;flex-direction:column;align-items:center;flex:none}.run-label{font-size:3.1cqw;line-height:1;letter-spacing:.65cqw;order:2;margin-top:1.1cqw;}.halo{position:relative;display:flex;align-items:center;justify-content:center;width:29cqw;height:29cqw;padding:.55cqw;background:#99b890;border-radius:50%;flex:none}.ring{width:100%;height:100%;display:flex;align-items:center;justify-content:center;border-radius:50%;border:.55cqw solid #071315;padding:.55cqw;background:#99b890;}.center{display:flex;align-items:center;justify-content:center;width:100%;height:100%;border-radius:50%;background:#e1ead8;color:#0c2224;border:.4cqw solid #071315;}.score{display:block;width:100%;text-align:center;font-size:17.7cqw;font-weight:900;line-height:1;font-variant-numeric:tabular-nums}.stats{display:flex;align-items:flex-start;gap:0;margin-top:6.2cqw}.stat{display:flex;flex-direction:row;gap:1.8cqw;align-items:center;justify-content:center;flex:1 1 0;min-width:0}.stat-label{font-size:3.2cqw;letter-spacing:.45cqw;line-height:1;white-space:nowrap}.stat-number{font-size:3.5cqw;line-height:1;font-variant-numeric:tabular-nums}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:100%}.stat-label{letter-spacing:.25cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><header class=\"sport\" data-osb-static=\"true\">BASEBALL</header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><div class=\"halo jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><div class=\"ring\" data-osb-component=\"layout\"><div class=\"center\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div></div></div><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><div class=\"halo jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><div class=\"ring\" data-osb-component=\"layout\"><div class=\"center\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
