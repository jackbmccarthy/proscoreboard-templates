{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Corner — Glass Plates</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.stage{position:fixed;inset:0;display:flex;align-items:flex-start;justify-content:flex-start;padding:3.2vw 0 0 3.2vw;pointer-events:none}\n.board{font-size:calc(100vw / 80);font-family:var(--font);color:var(--ink);display:flex;flex-direction:column;width:max-content;max-width:60vw;-webkit-font-smoothing:antialiased}\n.head{display:flex;align-items:center;height:1.75em;padding:0 .75em;font-size:.85em;font-weight:700;letter-spacing:.09em;text-transform:uppercase}\n.main{display:flex;align-items:stretch}\n.players{display:flex;flex-direction:column;flex:0 0 22.5em;width:22.5em}\n.row{display:flex;align-items:center;gap:.5em;height:2.6em;padding:0 .55em 0 0;min-width:0}\n.chip{flex:0 0 .4em;align-self:stretch;background:var(--chip-default,#8a96a3)}\n.flag{flex:0 0 auto;width:1.8em;height:1.2em;object-fit:cover;border-radius:.1em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.who{display:flex;flex-direction:column;justify-content:center;flex:1 1 auto;min-width:0}\n.name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:1.2em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:break-word}\n.team{display:flex;align-items:center;gap:.35em;min-width:0;font-size:.78em;font-weight:700;letter-spacing:.05em;text-transform:uppercase;opacity:.85}\n.tlogo{width:1.2em;height:1.2em;object-fit:contain}\n.tname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.tscore{padding:0 .35em;border-radius:.2em;background:rgba(127,127,127,.28);font-variant-numeric:tabular-nums}\n.who:has(.name:empty) .team{font-size:1.05em;opacity:1}\n.who:has(.name:empty) .tname{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.05}\n.marks{display:flex;align-items:center;gap:.2em;flex:0 0 auto}\n.to-slot{width:2.1em;height:1.25em}\n.to-on,.to-used{border-radius:.18em;font-size:.78em;font-weight:900}\n.to-on{background:#ffd23f;color:#111}\n.to-used{border:.12em solid currentColor;opacity:.75}\n.card-slot{width:.85em;height:1.2em}\n.card{border-radius:.1em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.srv{flex:0 0 1em;display:flex;align-items:center;justify-content:center}\n.srv-ball{display:block;width:.95em;height:.95em;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 18%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .13em rgba(0,0,0,.25)}\n.hist{display:flex}\n.col,.hcol{display:flex;flex-direction:column}\n.cell,.hc{display:flex;align-items:center;justify-content:center;height:2.6em;font-variant-numeric:tabular-nums;font-weight:800;line-height:1}\n.hcol{width:1.95em}.hc>*{font-size:1em}\n.gcol{width:2.5em}.gcol .cell>*{font-size:1.4em}\n.pcol{width:3em}.pcol .cell>*{font-size:1.8em}\n.tabs{display:flex;align-items:center;gap:.35em;height:1.9em;padding-top:.3em}\n.gtag{display:inline-flex;align-items:center;gap:.3em;height:1.6em;padding:0 .6em;border-radius:.2em;font-size:.85em;font-weight:800;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}\n.state{width:8.8em;height:1.6em}\n.st{border-radius:.2em;font-size:.85em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.split .players,.split .main{background:transparent!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .5em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.head:not(:has(.meta>:not(.sep):not(:empty))),.band:not(:has(.meta>:not(.sep):not(:empty))),.top:not(:has(.meta>:not(.sep):not(:empty))){display:none}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.team:not(:has(.tname:not(:empty))){display:none}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])) .hcol:not([style*=\"display: none\"]):not([style*=\"display:none\"]):not(:has(~ .hcol:not([style*=\"display: none\"]):not([style*=\"display:none\"])))>*>*{opacity:.4}\n.t-glass{--font:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;--ink:#fff;filter:drop-shadow(0 .3em .8em rgba(0,0,0,.4))}\n.t-glass .head{align-self:flex-start;margin-bottom:.3em;border-radius:.3em;background:rgba(12,17,24,.92);color:#c9c2ff}\n.t-glass .players,.t-glass .col,.t-glass .hcol{gap:.3em}\n.t-glass .row{background:rgba(16,22,32,.9);border-radius:.3em 0 0 .3em;overflow:hidden}\n.t-glass .hc{background:rgba(26,34,48,.9);color:#a7b0c2;border-left:1px solid rgba(255,255,255,.08)}\n.t-glass .gcol .cell{background:rgba(44,52,70,.95);color:#fff}\n.t-glass .pcol .cell{background:#7c5cff;color:#fff;border-radius:0 .3em .3em 0}\n.t-glass .gtag{background:rgba(12,17,24,.92);color:#fff;box-shadow:inset 0 0 0 .1em #7c5cff}\n.t-glass .st-warm,.t-glass .st-break{background:rgba(12,17,24,.92);color:#fff;box-shadow:inset 0 0 0 .12em #5a6478}\n.t-glass .st-gp{background:#ff8a1c;color:#111}\n.t-glass .st-mp{background:#e3262f;color:#fff}\n.t-glass .st-final{background:#fff;color:#0c1118}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.eventName.ev,.sep.s1,.matchRound.rd,.sep.s2,.matchFormatLabel.bestOf.bo,.isATimeOutActive.to-on,.isBTimeOutActive.to-on,.isMatchStarted.gtag,.currentGame.cg,.isComplete.st.st-final,.isMatchPoint.st.st-mp,.isATimeOutUsed.to-used,.isBTimeOutUsed.to-used,.isGamePoint.st.st-gp,.isWarmUpStarted.st.st-warm{font-size:1.25vw!important}\n/* end stream-size floor */\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-glass split\" data-osb-component=\"layout\"><div class=\"head\" data-osb-component=\"layout\"><span class=\"meta\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep s1\">·</i><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep s2\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span></div><div class=\"main\" data-osb-component=\"layout\"><div class=\"players\" data-osb-component=\"layout\"><div class=\"row rA\" data-osb-component=\"layout\"><span class=\"jerseyColorA chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"who\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></span><span class=\"srv\"><span class=\"isACurrentlyServing servingA srv-ball\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity:0\" isa=\"true\"></span></span></div><div class=\"row rB\" data-osb-component=\"layout\"><span class=\"jerseyColorB chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"who\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"team\"><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isBTimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isBTimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T</span></span><span class=\"slot card-slot\"><span class=\"isBYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isBRedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></span><span class=\"srv\"><span class=\"isBCurrentlyServing servingB srv-ball\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"></span></span></div></div><div class=\"hist\" data-osb-component=\"layout\"><div class=\"hcol isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hc\"><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"hcol isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hc\"><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"hcol isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"hc\"><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"hcol isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"hc\"><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"hcol isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"hc\"><span class=\"game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"hcol isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"hc\"><span class=\"game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"hcol isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"hc\"><span class=\"game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div></div><div class=\"col gcol\" data-osb-component=\"layout\"><span class=\"cell\"><span class=\"currentAMatchScore AScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"cell\"><span class=\"currentBMatchScore BScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span></div><div class=\"col pcol\" data-osb-component=\"layout\"><span class=\"cell\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"cell\"><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></div></div><div class=\"tabs\" data-osb-component=\"layout\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"slot state\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isComplete st st-final\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></div></article></main>\n</body>\n</html>\n","css":""}
