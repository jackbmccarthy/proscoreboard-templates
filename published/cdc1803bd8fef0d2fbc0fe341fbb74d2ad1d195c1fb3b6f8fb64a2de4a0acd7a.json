{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Arena Stack</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px 28px 28px; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .osb { position: relative; display: grid; grid-template-columns: 1fr 156px; width: 620px; color: #f4f5f7; filter: drop-shadow(0 6px 16px #000a); }\n    .ev { grid-column: 1 / -1; justify-self: start; display: flex; align-items: center; gap: 10px; padding: 5px 12px 4px; background: #12161c; border-radius: 5px 5px 0 0; font-size: 15px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; color: #cfd5dd; white-space: nowrap; }\n    .ev .matchRound { color: #ffb020; }\n    .teams { background: #12161c; border-radius: 0 0 0 6px; overflow: hidden; }\n    .osb:not(:has(.ev .eventName:not(:empty))):not(:has(.ev .matchRound:not(:empty))) .teams { border-radius: 6px 0 0 6px; }\n    .row { position: relative; display: grid; grid-template-columns: 10px 24px minmax(0, 1fr) 136px 76px; align-items: center; height: 60px; background: linear-gradient(90deg, #20262f, #151a21); }\n    .row + .row { border-top: 1px solid #2c333e; }\n    .kitw { align-self: stretch; display: flex; background: #c3c9d2; }\n    .row.b .kitw { background: #5b6472; }\n    .kit { flex: 1; background-color: transparent; }\n    .poss { display: flex; align-items: center; justify-content: center; }\n    .arrow { width: 0; height: 0; border-top: 8px solid transparent; border-bottom: 8px solid transparent; border-left: 11px solid #ffb020; }\n    .nm { padding-right: 8px; font-size: 23px; font-weight: 700; line-height: 1.02; letter-spacing: .3px; text-transform: uppercase; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: normal; word-break: normal; hyphens: none; text-wrap: balance; }\n    .info { position: relative; align-self: stretch; display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: 6px; padding-right: 12px; }\n    .tor { display: flex; align-items: center; gap: 6px; }\n    .cap { font-size: 16px; font-weight: 600; letter-spacing: 1px; color: #aab2bd; }\n    .pips { display: flex; gap: 4px; height: 7px; }\n    .pip { width: 14px; height: 6px; border-radius: 1px; background: #ffb020; }\n    .fl { display: flex; align-items: center; gap: 6px; font-size: 16px; font-weight: 600; letter-spacing: 1px; color: #aab2bd; }\n    .fl b { color: #fff; font-weight: 700; min-width: 9px; text-align: right; }\n    .bonus { font-size: 13px; font-weight: 700; letter-spacing: 1px; background: #ffb020; color: #12161c; padding: 2px 5px 1px; border-radius: 2px; }\n    .bonus:empty { display: none; }\n    .to { position: absolute; inset: 6px 6px 6px 0; flex-direction: column; align-items: center; justify-content: center; background: #ffb020; color: #12161c; border-radius: 3px; line-height: 1; }\n    .to-l { font-size: 14px; font-weight: 700; letter-spacing: 2px; }\n    .to-c { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 20px; font-weight: 700; margin-top: 2px; }\n    .pts { position: relative; z-index: 1; align-self: stretch; display: flex; align-items: center; justify-content: center; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 40px; font-weight: 700; background: #0a0c10; font-variant-numeric: tabular-nums; }\n    .tower { position: relative; display: grid; background: #000; border-left: 3px solid #ffb020; border-radius: 0 6px 6px 0; overflow: hidden; }\n    .tower > * { grid-area: 1 / 1; }\n    .live { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding-top: 4px; }\n    .top { display: flex; align-items: center; gap: 8px; }\n    .per { font-size: 19px; font-weight: 700; letter-spacing: 1px; background: #f4f5f7; color: #111; padding: 2px 8px 1px; border-radius: 2px; }\n    .per:empty { display: none; }\n    .shot { position: relative; display: flex; align-items: center; gap: 5px; background: #ffb020; color: #12161c; border-radius: 3px; padding: 1px 6px 0; }\n    .shot[style*=\"opacity: 0\"] { display: none; }\n    .shot-l { font-size: 12px; font-weight: 700; letter-spacing: 1px; }\n    .shot-v { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 21px; font-weight: 700; min-width: 24px; text-align: right; font-variant-numeric: tabular-nums; }\n    .run-shot { position: absolute; left: 4px; right: 4px; bottom: -5px; height: 2px; background: #ffb020; }\n    .gc { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 48px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n    .gc b { color: #ffb020; padding: 0 1px; }\n    .prog { display: flex; gap: 4px; align-items: center; height: 9px; }\n    .q { position: relative; width: 20px; height: 4px; background: #39404b; border-radius: 1px; }\n    .q > span { position: absolute; inset: 0; background: #ffb020; border-radius: 1px; }\n    .ot { font-size: 11px; font-weight: 700; line-height: 1; padding: 1px 3px 0; background: #ffb020; color: #111; border-radius: 1px; }\n    .runbar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #ffb020; }\n    .state { z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; background: #ffb020; color: #111; }\n    .st-s { font-size: 16px; font-weight: 700; letter-spacing: 3px; }\n    .st-b { font-size: 40px; font-weight: 700; letter-spacing: 1px; margin-top: 3px; }\n    .brk .half-t { font-size: 30px; }\n    .fin { z-index: 2; background: #f4f5f7; }\n    .fin .st-b { font-size: 44px; }\n    .fin-ot { font-size: 16px; font-weight: 600; letter-spacing: 2px; margin-top: 4px; }\n    .half-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .end-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .half-t { display: block; }\n    .fin-ot { display: none; }\n    .osb:has(.isGame5Started[style*=\"opacity: 1\"]) .fin-ot { display: block; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .final-dim { opacity: .5; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .pip { background: #8a93a0; }\n    .win { position: absolute; top: 0; right: 0; bottom: 0; width: 76px; background: #ffb020; }\n    .row:has(> .win[style*=\"opacity: 1\"]) .pts { background: transparent; color: #12161c; }\n    .row:has(> .win[style*=\"opacity: 1\"]) .nm { color: #fff; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .row.b :is(.nm, .pts, .info), .osb:has(.isBWinner[style*=\"opacity: 1\"]) .row.a :is(.nm, .pts, .info) { opacity: .45; }\n    .pips { gap: 0 !important; }\n    .pips > [class*=\"TimeoutLeft\"] { margin-right: 4px; }\n    .pips > [style*=\"opacity: 0\"] { width: 0 !important; margin: 0 !important; }\n    .pips > .pip[style*=\"opacity: 0\"] { display: none !important; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.ev-n.eventName,.ev-r.matchRound,.to-l,.shot-l,.ot.isGame5Started,.bonus.bonusA,.bonus.bonusB{font-size:16px!important}\n.arrow.isAPossession,.arrow.isBPossession{width:12px!important;height:16px!important;min-width:0!important;flex-shrink:0!important}\n.pip.isATimeoutLeft1,.pip.isATimeoutLeft2,.pip.isATimeoutLeft3,.pip.isATimeoutLeft4,.pip.isATimeoutLeft5,.pip.isBTimeoutLeft1,.pip.isBTimeoutLeft2,.pip.isBTimeoutLeft3,.pip.isBTimeoutLeft4,.pip.isBTimeoutLeft5{width:14px!important;height:12px!important;min-width:0!important;flex-shrink:0!important}\n/* end stream-size floor */\n\n  </style>\n</head>\n<body>\n<article class=\"osb\" aria-label=\"Basketball scorebug\">\n  <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n  <div class=\"teams\">\n    <div class=\"row a\"><span class=\"kitw\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><span class=\"poss final-dim\"><span class=\"arrow isAPossession\" data-osb-component=\"field\" data-osb-field=\"isAPossession\" style=\"opacity: 0;\"></span></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"info\"><span class=\"tor final-dim\"><span class=\"cap\">TO</span><span class=\"pips\"><span class=\"pip isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\"><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span>FOULS <b class=\"teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</b></span><span class=\"to isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></span><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0;\"></span><span class=\"pts currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n    <div class=\"row b\"><span class=\"kitw\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><span class=\"poss final-dim\"><span class=\"arrow isBPossession\" data-osb-component=\"field\" data-osb-field=\"isBPossession\" style=\"opacity: 0;\"></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"info\"><span class=\"tor final-dim\"><span class=\"cap\">TO</span><span class=\"pips\"><span class=\"pip isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\"><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span>FOULS <b class=\"teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</b></span><span class=\"to isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></span><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0;\"></span><span class=\"pts currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n  </div>\n  <div class=\"tower\">\n    <div class=\"live\">\n      <div class=\"top\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"shot isShotClockActive\" data-osb-component=\"field\" data-osb-field=\"isShotClockActive\" style=\"opacity: 0;\"><span class=\"shot-l\">SHOT</span><span class=\"shot-v\" data-osb-static=\"true\" data-sport-stat=\"shotClock\"></span><span class=\"run-shot isShotClockRunning\" data-osb-component=\"field\" data-osb-field=\"isShotClockRunning\" style=\"opacity: 0;\"></span></span></div>\n      <span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span>\n      <span class=\"prog\"><span class=\"q\"><span class=\"isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"ot isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\">OT</span></span>\n      <span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span>\n    </div>\n    <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"end-t st-s\">END OF</span><span class=\"end-t st-b\"><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span></span><span class=\"half-t st-b\">HALFTIME</span></div>\n    <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FINAL</span><span class=\"fin-ot\">OVERTIME</span></div>\n  </div>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span><span class=\"timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span><span class=\"possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
