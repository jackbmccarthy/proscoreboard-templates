{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Spike Slash</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1;position:relative}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.18)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing,.ldot{animation:none!important;transition:none!important}}\n.nm{display:block;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;line-height:1.02}\n.bal{text-wrap:balance}\n.st,.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hv{position:relative;display:inline-grid;place-items:center}.hv>*{grid-area:1/1}.hv>.w{display:block;align-self:stretch;justify-self:stretch}.hv>.num{position:relative}\n.ev,.rd{white-space:nowrap}\n.hc:not([style*=\"opacity: 1\"]),.cell:not([style*=\"opacity: 1\"]){display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 0 .15rem #0b1a12,0 0 .4rem #0007}\n\n.stage{position:fixed;left:4rem;right:4rem;bottom:4rem}\n.board{position:relative;display:flex;align-items:stretch;height:7.2rem;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff;filter:drop-shadow(0 .5rem 1.2rem #000a)}\n.evb{width:25rem;flex:none;display:flex;flex-direction:column;justify-content:center;gap:.5rem;padding:.4rem 3rem 0 1.6rem;background:#ff2d8a;clip-path:polygon(0 0,100% 0,calc(100% - 2rem) 100%,0 100%);font-size:1.7rem;letter-spacing:.07em;text-transform:uppercase;line-height:1}\n.evb .ev,.evb .rd{display:block;overflow:hidden;text-overflow:ellipsis}.evb .rd{color:#2a0838}.evb .sep{display:none}\n.band{flex:1;min-width:0;display:flex;align-items:stretch;margin-left:-1.4rem;background:#24093f;clip-path:polygon(2rem 0,100% 0,calc(100% - 2rem) 100%,0 100%);padding:0 2.6rem 0 2.4rem}\n.side{position:relative;flex:1;min-width:0;display:flex;align-items:stretch}.sB{flex-direction:row-reverse}\n.chip{width:.8rem;flex:none;margin:1rem 0;transform:skewX(-16deg)}.chipA{background:#43a5ff}.chipB{background:#ffcc3d}\n.who{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.5rem;padding:.4rem 1rem 0}\n.sB .who{align-items:flex-end;text-align:right}\n.nm{font-size:2.5rem;font-weight:700;text-transform:uppercase;letter-spacing:.02em}\n.pips{display:flex;gap:.4rem}.pip{position:relative;display:block;width:2.2rem;height:.8rem;transform:skewX(-16deg);box-shadow:inset 0 0 0 .15rem #c79bf2}.pip>.lit{position:absolute;inset:0;background:#ff2d8a}\n.sv{width:3.4rem;flex:none;place-items:center}.vball{width:2.4rem;height:2.4rem}\n.win{display:grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%;background:#ff2d8a;color:#fff;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;font-size:1.9rem;font-weight:900}\n.setbox{width:5.2rem;flex:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.15rem}\n.setbox>i{font-style:normal;font-size:1.6rem;letter-spacing:.08em;color:#b88be6;padding-top:.2rem}\n.sets{color:#ff63aa;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3rem;font-weight:700;line-height:1}\n.pts{width:7.6rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem;margin:.6rem 0;background:#fff;color:#24093f;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:4.4rem;font-weight:700;clip-path:polygon(.9rem 0,100% 0,calc(100% - .9rem) 100%,0 100%)}\n.mid{width:13rem;flex:none;display:flex;padding:.6rem .4rem}\n.sslot{flex:1}.sslot>.st{flex-direction:column;padding-top:.3rem;font-size:1.9rem;letter-spacing:.07em;line-height:1;text-align:center;white-space:normal;background:#ff2d8a;clip-path:polygon(.9rem 0,100% 0,calc(100% - .9rem) 100%,0 100%)}\n.sslot .num{display:block;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.8rem;font-weight:700}\n.sslot>.sdec{background:#ffcc3d;color:#24093f;font-size:2.1rem;padding:0 1.4rem}.sslot>.sbrk{background:#4a1f7a}.sslot>.sbrk .num{font-size:2.6rem}.sslot>.sfin{background:#fff;color:#24093f;font-size:2.7rem}\n.sslot>.gp{background:#ffcc3d;color:#24093f;font-size:2.2rem;padding:0 1.6rem}.sslot>.mp{background:#ff1f4b;color:#fff;font-size:2.2rem;padding:0 1.6rem;box-shadow:inset 0 0 0 .3rem #fff}\n.tob{position:absolute;bottom:100%;display:flex;align-items:center;gap:.6rem;height:3.2rem;padding:.35rem 1.4rem 0;background:#ffcc3d;color:#24093f;font-size:1.8rem;letter-spacing:.06em;white-space:nowrap;clip-path:polygon(.8rem 0,100% 0,100% 100%,0 100%)}.sA .tob{left:0}.sB .tob{right:0;clip-path:polygon(0 0,calc(100% - .8rem) 0,100% 100%,0 100%)}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.2rem}\n.hb{position:absolute;right:2.2rem;top:100%;display:flex;align-items:center;height:3.2rem;padding:0 1rem;background:#16052a;clip-path:polygon(0 0,100% 0,calc(100% - 1rem) 100%,1rem 100%)}\n.hist{display:flex;align-items:center}\n.hc{display:flex;align-items:center;gap:.25rem;padding:.3rem .7rem 0;font-size:1.7rem}.hc+.hc{border-left:.1rem solid #ffffff22}\n.hc .hl{color:#b88be6;margin-right:.3rem}.hc .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:1.9rem}.hc .hd{font-style:normal;color:#b88be6}\n.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .hb,.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .hb .hist{height:0!important;min-height:0!important;padding-top:0!important;padding-bottom:0!important;margin-top:0!important;margin-bottom:0!important;border-width:0!important;overflow:hidden!important;align-items:flex-start!important;box-shadow:none!important;background:none!important}\n\n.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])){max-width:1px!important;min-width:0!important;padding:0!important;margin:0!important;border:0!important;overflow:hidden;color:transparent!important;background:none!important;box-shadow:none!important}.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])) *{color:transparent!important;background:none!important;box-shadow:none!important;border-color:transparent!important}\n.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .hist,.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])) .hist .hist{height:0!important;min-height:0!important;padding-top:0!important;padding-bottom:0!important;margin-top:0!important;margin-bottom:0!important;border-width:0!important;overflow:hidden!important;align-items:flex-start!important;box-shadow:none!important;background:none!important}\n.hc .hv{padding:.15rem .45rem 0;border-radius:.2rem}\n.hc .hv>.w{border-radius:.2rem;background:#ff2d8a;margin:-.15rem -.45rem 0}\n.hc .hv:has(>.w[style*=\"opacity: 1\"])>.num{color:#fff}\n.hc:has(.w[style*=\"opacity: 1\"]) .hv:not(:has(>.w[style*=\"opacity: 1\"]))>.num{color:#a985cf}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{color:#ff2d8a}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{background:#ff2d8a;color:#fff}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .sA .sets,.board:has(.isBWinner[style*=\"opacity: 1\"]) .sB .sets{color:#fff;text-shadow:0 0 1rem #ff2d8a}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.sB .who,.sB .setbox,.sB .pts),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.sA .who,.sA .setbox,.sA .pts){opacity:0.4}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<span class=\"evb\"><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span>\n<div class=\"band\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side sA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipA jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"who\"><span class=\"nm bal combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity:0\"></b></i></span></span><span class=\"slot sv\"><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"win winA isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"><b>&#10003;</b></span></span><span class=\"setbox\"><i>SETS</i><span class=\"sets num setsA setsWonA currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"pts num ptsA currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"tob tobA isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span></div><div class=\"mid\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"slot sslot pslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span><span class=\"st pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"st pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span></div><div class=\"side sB\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipB jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"who\"><span class=\"nm bal combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity:0\"></b></i></span></span><span class=\"slot sv\"><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"win winB isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\"><b>&#10003;</b></span></span><span class=\"setbox\"><i>SETS</i><span class=\"sets num setsB setsWonB currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span><span class=\"pts num ptsB currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"tob tobB isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></div></div>\n<div class=\"hb\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"hist\"><span class=\"hc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><b class=\"hl\">S1</b><span class=\"hv a\"><i class=\"w isGame1AWon\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></i><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame1BWon\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></i><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"hc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><b class=\"hl\">S2</b><span class=\"hv a\"><i class=\"w isGame2AWon\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></i><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame2BWon\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></i><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"hc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><b class=\"hl\">S3</b><span class=\"hv a\"><i class=\"w isGame3AWon\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></i><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame3BWon\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></i><span class=\"num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"hc isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><b class=\"hl\">S4</b><span class=\"hv a\"><i class=\"w isGame4AWon\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></i><span class=\"num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame4BWon\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></i><span class=\"num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"hc isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><b class=\"hl\">S5</b><span class=\"hv a\"><i class=\"w isGame5AWon\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></i><span class=\"num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><i class=\"hd\">-</i><span class=\"hv b\"><i class=\"w isGame5BWon\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></i><span class=\"num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span></span></div>\n<span class=\"osb-core-fields\"><span class=\"num timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\">0</span><span class=\"num timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\">0</span></span></section></main>\n</body>\n</html>\n","css":""}
