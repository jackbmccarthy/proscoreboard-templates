{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Limestone Inset Subscore compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#243941}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;flex-direction:column;width:min(58vw,1100px);max-width:100%;min-width:0;overflow:hidden;border:1px solid #aeb9b5;border-radius:4px;background:#ebe9e2;container-type:inline-size}\n.competitors{display:flex;flex-direction:column;min-width:0}\n.competitor{display:flex;align-items:center;min-width:0;height:12.4cqw;background:#ebe9e2}\n.competitor+.competitor{border-top:1px solid #aeb9b5}\n.identity{display:block;flex:none;width:1.2cqw;height:72%;margin:0 2.3cqw 0 1.3cqw;background:#1686d6}\n.jerseyColorB{background:#df243a}\n.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#243941;font-size:6.2cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.hits-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:9.7%;height:82%;min-width:0;background:#365d67;color:#fff;border-radius:2px}\n.cell-label{display:block;color:#fff;font-size:2.1cqw;font-weight:700;line-height:1;white-space:nowrap}\n.hit-value{display:block;max-width:100%;overflow:hidden;color:#fff;font-size:6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.score-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 18%;min-width:0;align-self:stretch;background:#ebe9e2;color:#243941}\n.score-label{display:block;color:#243941;font-size:2.3cqw;font-weight:700;line-height:1;white-space:nowrap}\n.score{display:block;max-width:100%;overflow:hidden;color:#243941;font-size:8.5cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center}\n.baseline{display:flex;align-items:center;min-width:0;height:7.4cqw;border-top:1px solid #aeb9b5;background:#ebe9e2}\n.sport-tag{display:block;flex:1 1 auto;min-width:0;padding:0 2.2cqw;color:#243941;font-size:2.6cqw;font-weight:800;line-height:1;white-space:nowrap}\n.stats{display:flex;align-items:center;justify-content:flex-end;flex:none;min-width:0}\n.stat{display:flex;align-items:baseline;justify-content:center;gap:.65cqw;min-width:0;padding:0 1.5cqw;color:#243941;font-size:1.85cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stat:first-child{border-left:1px solid #aeb9b5}.stat+.stat{border-left:1px solid #aeb9b5}\n.stat strong{color:#243941;font-size:2.4cqw;font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%}.competitor{height:70px}.identity{width:5px;height:72%;margin:0 8px 0 6px}.name{font-size:clamp(19px,6vw,28px)}.hits-cell{width:16%;height:82%}.cell-label{font-size:10px}.hit-value{font-size:clamp(24px,7vw,34px)}.score-track{flex-basis:22%}.score-label{font-size:10px}.score{font-size:clamp(28px,9vw,42px)}.baseline{height:48px;flex-direction:column;align-items:stretch;justify-content:center;gap:4px}.sport-tag{flex:none;padding:0 7px;font-size:11px}.stats{justify-content:space-between}.stat{font-size:9px;gap:2px;padding:0 5px}.stat strong{font-size:10px}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Softball scoreboard\">\n<div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"hits-cell columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"cell-label\" data-osb-component=\"text\">HITS</span><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong></div><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score-label\" data-osb-component=\"text\">RUNS</span><strong class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"hits-cell columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"cell-label\" data-osb-component=\"text\">HITS</span><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong></div><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score-label\" data-osb-component=\"text\">RUNS</span><strong class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"baseline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOFTBALL</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static softball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
