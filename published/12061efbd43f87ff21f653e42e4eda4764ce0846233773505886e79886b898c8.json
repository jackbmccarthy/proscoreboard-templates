{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Hinge Rail soccer 1</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f3ecd9}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:73vw;max-width:1400px;container-type:inline-size;display:flex;flex-direction:column;gap:.7cqw;min-width:0;background:transparent}.rail{background:#283132;border-radius:.65cqw}.heading{font-size:3.2cqw;line-height:1;letter-spacing:.3em;text-align:center;padding:1.15cqw 1cqw;margin:0;font-weight:700}.lane{display:flex;align-items:stretch;min-width:0;height:16.5cqw;padding:1cqw 0}.name{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;line-height:1.15;font-size:8cqw;letter-spacing:.045em}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.lane>.name{flex:1 1 0;align-self:center;padding:0 4cqw}.points{flex:0 0 40%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.8cqw;min-width:0;border-left:.2cqw solid #171d1e;padding-right:13cqw}.label{display:block;font-family:monospace;font-weight:700;font-size:1.7cqw;line-height:1.2;letter-spacing:.25em;white-space:nowrap}.tile{position:relative;display:inline-flex;align-items:center;justify-content:center;border-radius:.65cqw;background:#f3ecd9;color:#05090a;min-width:0}.tile::after{content:\"\";position:absolute;left:0;right:0;top:50%;height:.1cqw;background:#171d1e;z-index:2;pointer-events:none}.hinge{position:absolute;top:35%;height:30%;width:.8cqw;background:#b97a50;border-radius:.1cqw;z-index:3;pointer-events:none}.hinge-left{left:-.55cqw}.hinge-right{right:-.55cqw}.score-tile{width:18cqw;height:10.7cqw;flex:none}.score{display:block;width:100%;font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;font-size:9.8cqw;line-height:1;text-align:center;font-variant-numeric:tabular-nums;letter-spacing:-.065em}.footer{display:flex;align-items:stretch;min-width:0;padding:1.7cqw 3cqw;gap:3.5cqw}.stat{display:flex;align-items:center;justify-content:center;gap:3cqw;min-width:0;flex:1 1 0}.stat+.stat{border-left:.1cqw solid #a4a69c;padding-left:3.5cqw}.stat.clock{flex:1.6 1 0}.stat-value{display:inline-flex;align-items:center;justify-content:center;gap:.35cqw;white-space:nowrap;min-width:0;font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;font-size:4.9cqw;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.02em}.stat-value>.tile{height:6cqw;padding:0 .9cqw}.stat-value>.tile .hinge{width:.65cqw}.stat-value.digits>.digit{width:4.3cqw;padding:0;height:6.5cqw}.stat-value.digits>.colon{color:#f3ecd9;padding:0 .25cqw}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}.variant-2{width:81vw;max-width:1550px;gap:.55cqw}.variant-2 .heading{font-size:3.55cqw;padding:1.1cqw}.duel{display:flex;align-items:stretch;min-width:0;padding:1.2cqw 0}.team{flex:1 1 0;min-width:0;display:flex;align-items:center;flex-direction:column;padding:.4cqw 2cqw .5cqw;gap:1.6cqw}.team+.team{border-left:.25cqw solid #b97a50}.team .name{width:100%;text-align:center;font-size:5cqw}.team .score-tile{width:22cqw;height:13.3cqw}.team .score{font-size:13.2cqw}.team .label{font-size:2.15cqw}.variant-2 .footer{padding:1.8cqw 3cqw;gap:3cqw}.variant-2 .stat{gap:3cqw}.variant-2 .stat+.stat{border-color:#b97a50;border-width:.25cqw;padding-left:3cqw}.variant-2 .stat.clock{flex:2 1 0}.variant-2 .footer .label{font-size:2.15cqw}.variant-2 .footer .stat-value{font-size:6.8cqw}.variant-2 .footer .stat-value>.tile{height:7.6cqw;padding:0 1.1cqw}.variant-2 .footer .stat-value.digits>.digit{width:5.3cqw;padding:0}.soccer.variant-1{width:56.2vw;max-width:1080px;gap:1.1cqw}.soccer.variant-1 .heading{font-family:monospace;font-size:3.4cqw;padding:1.35cqw}.soccer.variant-1 .lane{height:19.2cqw}.soccer.variant-1 .lane>.name{font-size:9.5cqw;padding:0 3.5cqw}.soccer.variant-1 .points{flex-basis:31%;border:0;padding-right:12.5cqw}.soccer.variant-1 .score-tile{width:12.5cqw;height:11.9cqw}.soccer.variant-1 .score{font-size:9.6cqw}.soccer.variant-1 .label{font-size:2.1cqw}.soccer.variant-1 .footer{padding:1.6cqw 17cqw 1.6cqw 20cqw;gap:6cqw}.soccer.variant-1 .stat{gap:3cqw}.soccer.variant-1 .stat+.stat{padding-left:6cqw}.soccer.variant-1 .stat-value{font-size:4.2cqw}.soccer.variant-1 .stat-value>.tile{height:5.2cqw}.soccer.variant-1 .stat-value.digits>.digit{width:3.9cqw;height:5.2cqw}.soccer.variant-2{width:68vw;max-width:1300px;gap:.3cqw}.soccer.variant-2 .heading{font-family:monospace;font-size:5.8cqw;letter-spacing:.27em;padding:1.3cqw}.soccer.variant-2 .duel{padding:.6cqw 0}.soccer.variant-2 .team{gap:1.8cqw;padding:1cqw 2cqw 1.8cqw}.soccer.variant-2 .name{font-size:6cqw}.soccer.variant-2 .score-tile{width:18.5cqw;height:15.8cqw;border:.17cqw solid #171d1e}.soccer.variant-2 .score{font-size:15.1cqw}.soccer.variant-2 .label{font-size:2.8cqw}.soccer.variant-2 .footer{padding:1.8cqw 15cqw;gap:6cqw}.soccer.variant-2 .stat{gap:3cqw}.soccer.variant-2 .stat.clock{flex:2 1 0}.soccer.variant-2 .stat+.stat{padding-left:6cqw}.soccer.variant-2 .footer .label{font-size:2.6cqw}.soccer.variant-2 .footer .stat-value{font-size:5.5cqw;color:#f3ecd9}@media(max-width:600px){.board,.variant-2,.soccer.variant-1,.soccer.variant-2{width:94vw}.footer{gap:2cqw;padding-left:2cqw;padding-right:2cqw}.stat{gap:1.8cqw}.stat+.stat{padding-left:2cqw}.soccer.variant-1 .footer{padding-left:12cqw;padding-right:12cqw}}@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer soccer variant-1\" data-osb-component=\"layout\"><h1 class=\"heading rail\" data-osb-component=\"text\">SOCCER</h1><section class=\"lane rail rowContainer\" data-osb-component=\"layout\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"points columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">GOALS</span><span class=\"tile score-tile\" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span></div></section><section class=\"lane rail rowContainer\" data-osb-component=\"layout\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"points columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">GOALS</span><span class=\"tile score-tile\" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></div></section><footer class=\"footer rail rowContainer\" data-osb-component=\"layout\"><div class=\"stat clock rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value digits\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\"><span class=\"tile digit\" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i>0</span><span class=\"tile digit\" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i>0</span><span class=\"colon\">:</span><span class=\"tile digit\" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i>0</span><span class=\"tile digit\" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i>0</span></span></div><div class=\"stat half rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value \" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\"><span class=\"tile \" data-osb-component=\"decoration\"><i class=\"hinge hinge-left\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i><i class=\"hinge hinge-right\" aria-hidden=\"true\" data-osb-component=\"decoration\"></i>0</span></span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\" currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\" currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\" jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\" jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
