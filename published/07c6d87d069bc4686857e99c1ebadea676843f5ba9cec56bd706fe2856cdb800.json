{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Cyan Blue Broadcast Volleyball — Horizontal Lanes</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #19384c; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 580px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #9bb1bd; border-radius: 3px; background: #e6eef1; }\n.sport-title { display: flex; align-items: center; justify-content: center; min-height: 26px; padding: 4px 12px; background: #a3cbd2; color: #19384c; font-size: 18px; font-weight: 700; line-height: 1; white-space: nowrap; }\n.lanes { display: flex; min-height: 50px; }\n.team { display: flex; align-items: stretch; flex: 1 1 0; }\n.team + .team { border-left: 1px solid #9bb1bd; }\n.identity { display: flex; align-items: center; flex: 1 1 0; gap: 10px; padding: 6px 8px; }\n.tick { display: block; width: 3px; flex: 0 0 3px; height: 29px; background: #78c9d7; }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24px; font-weight: 700; line-height: 1; color: #19384c; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex: 0 0 17%; }\n.points-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; flex: 0 0 24%; background: #19384c; color: #fff; }\n.label { display: block; font-size: 11px; font-weight: 700; line-height: 1; }\n.match-score, .primary-score { display: block; width: 100%; text-align: center; font-size: 21px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { font-size: 32px; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 36px; border-top: 1px solid #9bb1bd; background: #142b3a; color: #fff; }\n.footer-frame { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 30px; padding: 0 25px; border-left: 1px solid #9bb1bd; border-right: 1px solid #9bb1bd; }\n.footer-label { display: block; font-size: 11px; font-weight: 700; line-height: 1; }\n.set-value { display: block; width: 19px; text-align: center; font-size: 18px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .lanes { flex-direction: column; }\n  .team { flex-basis: auto; min-height: 50px; }\n  .team + .team { border-left: 0; border-top: 1px solid #9bb1bd; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"sport-title\">VOLLEYBALL</header>\n      <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n      </div>\n      <footer class=\"set-footer\"><span class=\"footer-frame\"><span class=\"footer-label\">SET</span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
