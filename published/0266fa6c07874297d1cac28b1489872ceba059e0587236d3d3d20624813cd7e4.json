{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Inverted Splitline Volleyball — Separate Panels</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { color: #f3f0e6; font-family: Arial, Helvetica, sans-serif; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 1424px; display: flex; flex-direction: column; background: transparent; }\n.title { font-size: 96px; font-weight: 800; line-height: 1; text-align: center; margin-bottom: 28px; }\n.duel { display: flex; gap: 36px; }\n.team { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; }\n.identity { min-width: 0; display: flex; align-items: center; gap: 20px; height: 94px; padding: 12px 25px; background: #e5b333; color: #080a0b; }\n.name { flex: 1 1 0; min-width: 0; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 58px; font-weight: 800; line-height: 1; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-band { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; font-size: 40px; font-weight: 800; line-height: 1; }\n.match-score { display: block; width: 65px; text-align: center; font-size: 58px; font-variant-numeric: tabular-nums; }\n.panel { position: relative; isolation: isolate; display: flex; flex-direction: column; align-items: center; height: 558px; padding: 20px 24px 18px; background: #15161a; }\n.panel::before, .panel::after { content: \"\"; position: absolute; inset: 0 0 50%; z-index: -1; background: #f3f0e6; }\n.panel::after { inset: 50% 0 0; background: #15161a; }\n.primary-score { width: 100%; display: flex; align-items: center; justify-content: center; height: 458px; flex: 0 0 458px; color: #fff; mix-blend-mode: difference; font-family: \"Arial Black\", Arial, sans-serif; font-size: 520px; font-weight: 900; line-height: 1; letter-spacing: -.08em; font-variant-numeric: tabular-nums; }\n.points-label { display: block; margin-top: 10px; font-size: 52px; font-weight: 800; line-height: 1; }\n.set-footer { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 48px; font-size: 74px; font-weight: 800; line-height: 1; }\n.set-value { display: block; width: 85px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-height: 800px) and (min-width: 701px) {\n  .title { font-size: 58px; margin-bottom: 20px; }\n  .identity { height: 70px; }\n  .name { font-size: 40px; }\n  .sets-band { font-size: 28px; }\n  .match-score { font-size: 40px; width: 48px; }\n  .team { gap: 10px; }\n  .panel { height: 380px; padding: 16px 24px 18px; }\n  .primary-score { font-size: 340px; height: 300px; flex-basis: 300px; }\n  .points-label { font-size: 36px; }\n  .set-footer { margin-top: 26px; font-size: 40px; }\n  .set-value { width: 48px; }\n}\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .title { font-size: 30px; margin-bottom: 23px; }\n  .duel { gap: 20px; }\n  .team { gap: 8px; }\n  .identity { height: 56px; padding: 10px; gap: 6px; }\n  .name { font-size: 21px; }\n  .sets-band { font-size: 12px; gap: 4px; }\n  .match-score { font-size: 16px; width: 22px; }\n  .panel { height: 225px; padding: 12px 12px 11px; }\n  .primary-score { font-size: 120px; height: 175px; flex-basis: 175px; }\n  .points-label { margin-top: 6px; font-size: 21px; }\n  .set-footer { font-size: 33px; margin-top: 28px; gap: 9px; }\n  .set-value { width: 38px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"identity jerseyColorA rowContainer\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"sets-band\"><span>SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div><div class=\"panel columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div>\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"identity jerseyColorB rowContainer\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"sets-band\"><span>SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"panel columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
