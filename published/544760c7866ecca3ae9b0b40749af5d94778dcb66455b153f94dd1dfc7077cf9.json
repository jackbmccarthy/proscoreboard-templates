{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Wire Numeral TABLE TENNIS 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f6f7f7}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--board-width),1400px);container-type:inline-size;position:relative;background:transparent;display:flex;flex-direction:column}.header{margin:0 0 var(--header-gap);font-size:var(--title-size);text-align:center;line-height:1;white-space:nowrap;letter-spacing:var(--title-tracking)}.name-lane{min-width:0;position:relative}.name{display:block;width:100%;font-size:var(--name-size);line-height:1.06;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.03em}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{position:absolute;right:.5cqw;top:-2cqw;width:1.5cqw;height:1.5cqw;font-size:1.5cqw}.primary{min-width:0;display:flex;flex-direction:column;align-items:center}.score{display:block;width:100%;font-family:Arial,Helvetica,sans-serif;font-weight:700;font-size:var(--score-size);line-height:.82;text-align:center;color:transparent;-webkit-text-fill-color:transparent;-webkit-text-stroke:var(--wire-width) #96efeb;letter-spacing:-.065em;font-variant-numeric:tabular-nums;white-space:nowrap;padding:0 .6cqw}.label{font-size:var(--label-size);letter-spacing:var(--label-tracking);line-height:1.1;white-space:nowrap;text-align:center}.primary .label{margin-top:var(--point-gap)}.accent{display:block;width:var(--rule-width);height:var(--rule-height);background:#96efeb;margin:var(--rule-gap) auto;flex-shrink:0}.match-score{display:block;font-size:var(--match-size);line-height:1;min-width:2ch;text-align:center;font-variant-numeric:tabular-nums}.secondary{display:flex;align-items:center;justify-content:center;gap:var(--secondary-gap)}.point-slot{position:absolute;top:calc(100% + 1cqw);left:50%;transform:translateX(-50%);width:34cqw;height:2.5cqw;font-size:2cqw;text-align:center}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw}.point-slot{font-size:2.3cqw}.header{letter-spacing:0}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--board-width:45vw;--title-size:8.2cqw;--title-tracking:.9cqw;--header-gap:8cqw;--name-size:12cqw;--score-size:43cqw;--wire-width:.9cqw;--label-size:4.3cqw;--label-tracking:.7cqw;--point-gap:3.1cqw;--rule-width:40cqw;--rule-height:1cqw;--rule-gap:3cqw;--match-size:11.4cqw;--secondary-gap:1.6cqw}.rows{display:flex;flex-direction:column;gap:10cqw}.row{display:flex;align-items:center;gap:0}.primary{flex:0 0 50%}.identity-block{flex:0 0 50%;min-width:0;margin-left:-6cqw}.secondary{flex-direction:column}.name-lane{text-align:left}.secondary .label{font-size:4.2cqw}.row .score{transform:scaleX(.94)}.row .primary{padding-bottom:1cqw}\n.board{--score-size:36cqw;--name-size:13cqw}.identity-block{margin-left:0}.score{font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900}.row .score{transform:scaleY(1.15);line-height:.9}.row{gap:0}.primary .label{margin-top:4cqw}.rows{gap:9cqw}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">TABLE TENNIS</h1><div class=\"rows columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"primary\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><div class=\"label\">POINTS</div></div><div class=\"identity-block\"><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><span class=\"accent jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"secondary\"><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><div class=\"label\">GAMES</div></div></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"primary\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><div class=\"label\">POINTS</div></div><div class=\"identity-block\"><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><span class=\"accent jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"secondary\"><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"label\">GAMES</div></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
