{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Hinge Rail Volleyball — Duel</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f4efdf; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { --rail: #222d2e; --ivory: #f0eade; --copper: #b67b51; width: 100%; max-width: 1328px; display: flex; flex-direction: column; gap: 2px; }\n.rail { background: var(--rail); border-radius: 4px; }\n.title { display: flex; align-items: center; justify-content: center; min-height: 100px; font-size: 64px; font-weight: 700; letter-spacing: .22em; padding-left: .22em; }\n.duel { display: flex; min-height: 368px; }\n.team { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: stretch; padding: 15px 34px 28px; }\n.team + .team { border-left: 4px solid var(--copper); }\n.name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-size: 64px; line-height: 1.35; letter-spacing: .09em; font-weight: 700; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.scores { display: flex; flex: 1 1 auto; align-items: flex-end; justify-content: space-between; gap: 34px; padding: 20px 40px 0; }\n.score-track { flex: 0 1 194px; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }\n.label { font-size: 27px; font-weight: 700; letter-spacing: .19em; line-height: 1; }\n.module { position: relative; display: flex; align-items: center; width: 100%; height: 181px; background: var(--ivory); border-radius: 5px; color: #070c0c; }\n.value { display: block; width: 100%; font-family: \"Liberation Mono\", \"Courier New\", monospace; font-feature-settings: \"zero\" 1; font-variant-numeric: tabular-nums slashed-zero; text-align: center; font-size: 132px; font-weight: 900; line-height: 1; letter-spacing: -.07em; padding-right: .07em; }\n.module::before, .module::after { content: \"\"; position: absolute; z-index: 2; top: calc(50% - 13px); width: 13px; height: 26px; background: var(--copper); }\n.module::before { left: -7px; }\n.module::after { right: -7px; }\n.seam { position: absolute; z-index: 1; width: 100%; top: 50%; height: 1px; background: #777b73; pointer-events: none; }\n.set-rail { min-height: 90px; display: flex; align-items: center; justify-content: center; font-size: 42px; font-weight: 700; letter-spacing: .2em; gap: 27px; }\n.set-value { width: 55px; text-align: center; font-family: \"Liberation Mono\", \"Courier New\", monospace; font-variant-numeric: tabular-nums; letter-spacing: 0; }\n.runtime-reserve, .point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1350px) {\n  .title { font-size: clamp(27px, 4.8vw, 64px); }\n  .name { font-size: clamp(25px, 4.7vw, 64px); }\n  .scores { padding-right: 20px; padding-left: 20px; }\n  .score-track { flex-basis: 40%; }\n  .value { font-size: clamp(44px, 9vw, 120px); }\n}\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .title { min-height: 60px; font-size: 27px; letter-spacing: .15em; }\n  .duel { min-height: 200px; }\n  .team { padding: 14px 12px 20px; }\n  .team + .team { border-left-width: 2px; }\n  .name { font-size: 24px; letter-spacing: .04em; }\n  .scores { padding: 20px 2px 0; gap: 17px; }\n  .score-track { flex: 1 1 0; gap: 13px; }\n  .label { font-size: 12px; letter-spacing: .1em; }\n  .module { height: 88px; border-radius: 3px; }\n  .value { font-size: 38px; }\n  .module::before, .module::after { width: 6px; height: 16px; top: calc(50% - 8px); }\n  .module::before { left: -3px; }\n  .module::after { right: -3px; }\n  .set-rail { min-height: 52px; font-size: 25px; gap: 12px; }\n  .set-value { width: 35px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title rail\">VOLLEYBALL</header>\n      <div class=\"duel rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <div class=\"scores rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n            <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"module\"><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n            <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"module\"><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n          </div>\n        </div>\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <div class=\"scores rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n            <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"module\"><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n            <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"module\"><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n          </div>\n        </div>\n      </div>\n      <footer class=\"set-rail rail\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"runtime-reserve\"><span class=\"jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></div>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
