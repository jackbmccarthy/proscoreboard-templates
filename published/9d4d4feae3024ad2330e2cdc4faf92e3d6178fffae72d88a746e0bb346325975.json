{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Match Summary</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.25)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing{animation:none!important;transition:none!important}}\n.clamp2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;overflow-wrap:anywhere;line-height:1;text-wrap:balance}\n\n.sslot{align-items:center}.sslot>.st{display:flex;align-items:center;justify-content:center;gap:.4em;white-space:nowrap;height:100%}\n.pslot>.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hist:not(:has(>[style*=\"opacity: 1\"])){display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .srv[style*=\"opacity: 1\"]{opacity:.3!important;filter:grayscale(1)}\n.pip{position:relative;display:block}.pip>.lit{position:absolute;inset:0;border-radius:inherit}\n\n.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#eef1f5,#d7dde6)}\n.board{position:relative;width:100rem;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;color:#151a22;background:#fff;box-shadow:0 2rem 4rem #1c27384d;border-top:1rem solid #151a22}\n.head{display:flex;align-items:center;justify-content:space-between;height:8rem;padding:0 3.6rem;border-bottom:.2rem solid #e6e9ee}\n.ctx{display:flex;align-items:center;gap:1rem;font-size:2.4rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#5b6474;min-width:0;white-space:nowrap;overflow:hidden}.ctx .sep{font-style:normal;color:#e5243b}\n.hr{display:flex;align-items:stretch;gap:1.2rem;flex:none}\n.live{display:flex;align-items:center;gap:.8rem;padding:0 1.6rem;background:#f3f5f8;font-size:2.6rem;font-weight:800}.live .ll{font-size:1.8rem;letter-spacing:.14em;color:#8a93a3}.live .lv{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif}.live .ld{font-style:normal;color:#b3bac6}\n.sslot{min-width:24rem;height:4.8rem}.sslot>.st{padding:0 2rem;font-size:2.4rem;font-weight:800;letter-spacing:.14em;background:#151a22;color:#fff}.sslot>.sdec{background:#e5243b}.sslot>.sbrk{background:#5b6474}.sslot>.sfin{background:#e5243b}\n.score{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:2.4rem;padding:4.4rem 3.6rem 3.6rem}\n.team{display:flex;align-items:center;gap:2rem;min-width:0}.tB{flex-direction:row-reverse;text-align:right}\n.chip{width:1.4rem;height:9rem;flex:none;border-radius:.3rem}\n.nm{font-size:4.2rem;font-weight:800;letter-spacing:-.02em;line-height:1.05}\n.board{width:108rem}\n.big{display:flex;align-items:center;gap:2rem;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:14rem;font-weight:700;line-height:1}\n.big .dash{font-style:normal;color:#c3c9d3;font-size:8rem}\n.sets{min-width:9rem;text-align:center}\n.score .pslot{display:grid;justify-content:center;margin-top:1.2rem;min-height:4rem}.score .pt{padding:0 1.8rem;font-size:2rem;font-weight:800;letter-spacing:.14em;background:#151a22;color:#fff}.score .pt.mp{background:#e5243b}\n.lbl{display:block;text-align:center;font-size:2rem;font-weight:700;letter-spacing:.2em;color:#8a93a3;margin-top:-1.4rem}\n.strip{display:flex;justify-content:center;gap:1.6rem;padding:0 3.6rem 4.4rem}\n.sc{display:flex;flex-direction:column;align-items:center;min-width:15rem;padding:1.6rem 2rem;background:#f3f5f8;border-radius:.6rem}\n.sc .sl{font-size:2rem;font-weight:700;letter-spacing:.16em;color:#8a93a3}\n.sc .sv{display:flex;align-items:center;gap:.8rem;margin-top:.6rem;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:5.4rem;font-weight:700}.sc .sv i{font-style:normal;color:#b3bac6;font-size:3rem}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<header class=\"head\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"ctx\"><span class=\"eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"hr\"><span class=\"live\"><b class=\"ll\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></b><span class=\"lv num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"ld\">&ndash;</i><span class=\"lv num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"slot sslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span></span></span></header>\n<div class=\"score\"><span class=\"team tA\"><i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"nm clamp2 combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span><span class=\"big\"><span class=\"sets num setsWonA currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><i class=\"dash\">&ndash;</i><span class=\"sets num setsWonB currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span><b class=\"lbl\">SETS</b><span class=\"slot pslot\"><span class=\"pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span></span><span class=\"team tB\"><i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"nm clamp2 combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span></div>\n<div class=\"strip\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><b class=\"sl\">SET 1</b><span class=\"sv\"><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><i>&ndash;</i><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"sc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><b class=\"sl\">SET 2</b><span class=\"sv\"><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><i>&ndash;</i><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"sc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><b class=\"sl\">SET 3</b><span class=\"sv\"><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><i>&ndash;</i><span class=\"num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"sc isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><b class=\"sl\">SET 4</b><span class=\"sv\"><span class=\"num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><i>&ndash;</i><span class=\"num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"sc isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><b class=\"sl\">SET 5</b><span class=\"sv\"><span class=\"num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><i>&ndash;</i><span class=\"num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span></div></section></main>\n</body>\n</html>\n","css":""}
