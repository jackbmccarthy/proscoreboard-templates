{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Cobalt Fog Leadchip — BASKETBALL compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:6px}.board{width:min(64vw,1200px);aspect-ratio:3.72;display:flex;flex-direction:column;overflow:hidden;border:1px solid #8ca9b8;border-radius:4px;background:#23394b;color:#f7faf9;container-type:inline-size;font-variant-numeric:tabular-nums}.header{flex:0 0 25%;min-height:0;display:flex;align-items:center;gap:2.2cqw;padding:0 3%;background:#23394b;border-bottom:1px solid #94a9b2;white-space:nowrap}.sport-tag{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:4cqw;font-weight:750;line-height:1}.stats{display:flex;align-items:center;gap:2cqw;height:100%;margin-left:auto;}.stat{display:flex;align-items:baseline;gap:.8cqw;white-space:nowrap}.stat-label{color:#c9d7d7;font-size:2.1cqw;font-weight:600}.stat-value{font-size:3.2cqw;font-weight:750}.divider{height:58%;width:1px;background:#94a9b2}.lanes{display:flex;flex:1 1 auto;min-height:0;flex-direction:column}.lane{display:flex;align-items:stretch;flex:1 1 0;min-height:0;background:#23394b}.lane+.lane{border-top:1px solid #94a9b2}.identity{display:block;flex:0 0 3%;height:100%;align-self:center;background:#3186a8}.jerseyColorB{background:#c76c69}.support-track{display:flex;flex:0 0 12%;min-width:0;align-items:center;justify-content:center;padding:0 .8%}.support-chip{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;border-radius:0;background:#c9d7d7;color:#172f3f}.support-value{font-size:4.8cqw;font-weight:800;line-height:1}.support-label{font-size:2cqw;font-weight:700;line-height:1.15}.name-track{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:0 2.8%}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:5.9cqw;font-weight:700;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.primary-track{display:flex;flex:0 0 23%;min-width:0;align-items:center;justify-content:center;gap:1.5cqw;flex-direction:row;margin:0;border-left:1px solid #94a9b2;background:#23394b}.score{display:block;max-width:100%;white-space:nowrap;font-size:8.1cqw;font-weight:800;line-height:.95;font-variant-numeric:tabular-nums}.primary-label{font-size:2.1cqw;font-weight:700;line-height:1.05;white-space:nowrap}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;height:168px;aspect-ratio:auto;border-radius:3px}.header{flex:0 0 26%;gap:1.4cqw;padding:0 3%}.sport-tag{flex:1 1 auto;font-size:3.7cqw}.stats{gap:1.1cqw;margin-left:auto}.stat{gap:.5cqw}.stat-label{font-size:1.8cqw}.stat-value{font-size:2.7cqw}.lanes{flex-direction:column}.lane+.lane{border-left:0;border-top:1px solid #94a9b2}.identity{flex-basis:3%;height:100%}.support-track{flex-basis:17%;padding:0 .8%}.support-chip{height:90%;border-radius:3px}.support-value{font-size:5.8cqw}.support-label{font-size:2.2cqw}.name-track{padding:0 2%}.name{font-size:5.7cqw}.primary-track{flex-basis:24%;flex-direction:column;gap:0;margin:0}.score{font-size:8cqw}.primary-label{font-size:2.3cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"BASKETBALL scoreboard\"><div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">BASKETBALL</span><div class=\"stats\" data-osb-component=\"layout\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><span class=\"divider\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">PERIOD</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"period\" data-osb-static=\"true\">0</span></div><span class=\"divider\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">SHOT</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"shot\" data-osb-static=\"true\">00</span></div></div></div><div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"support-track\" data-osb-component=\"layout\"><div class=\"support-chip\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsA\" data-osb-static=\"true\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div></div><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"support-track\" data-osb-component=\"layout\"><div class=\"support-chip\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsB\" data-osb-static=\"true\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div></div><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
