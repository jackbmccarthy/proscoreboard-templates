{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Box Score</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { font-family: \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif; }\n    .screen { position: relative; display: flex; flex-direction: column; justify-content: center; gap: 28px; width: 100vw; height: 100vh; padding: 5vh 7vw; background: radial-gradient(ellipse at top, #1b2c4a, #0b1424 70%); color: #e8edf5; }\n    .head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 3px solid #f08a24; padding-bottom: 12px; }\n    .ev { display: flex; flex-direction: column; gap: 4px; }\n    .ev-name { font-size: 40px; font-weight: 700; letter-spacing: .5px; }\n    .ev-round { font-size: 18px; font-weight: 600; letter-spacing: 3px; color: #f08a24; text-transform: uppercase; }\n    .flags { display: flex; gap: 10px; }\n    .flag { padding: 6px 16px; background: #f08a24; color: #0b1424; font-size: 18px; font-weight: 700; letter-spacing: 3px; border-radius: 3px; }\n    .table { display: grid; grid-template-columns: minmax(0, 1fr) auto 150px; background: #15233b; border-radius: 8px; overflow: hidden; box-shadow: 0 20px 40px #0007; }\n    .names { display: grid; grid-template-rows: 46px 90px 90px; }\n    .hcell { display: flex; align-items: center; padding: 0 24px; background: #0b1424; font-size: 14px; font-weight: 700; letter-spacing: 3px; color: #8a9ab5; }\n    .team { display: flex; align-items: center; gap: 18px; padding-right: 20px; border-top: 1px solid #22344f; }\n    .kit { align-self: stretch; width: 14px; background-color: #3a4a66; }\n    .nm { font-size: 40px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .periods { display: flex; }\n    .col { display: grid; grid-template-rows: 46px 90px 90px; width: 92px; text-align: center; }\n    .col > * { display: flex; align-items: center; justify-content: center; }\n    .col > .ga, .col > .gb { border-top: 1px solid #22344f; border-left: 1px solid #22344f; font-size: 32px; font-weight: 600; font-variant-numeric: tabular-nums; color: #c3cee0; }\n    .col > .ph { background: #0b1424; border-left: 1px solid #22344f; font-size: 14px; font-weight: 700; letter-spacing: 2px; color: #8a9ab5; }\n    .tot { display: grid; grid-template-rows: 46px 90px 90px; background: #f08a24; color: #0b1424; text-align: center; }\n    .tot > * { display: flex; align-items: center; justify-content: center; }\n    .tot > .ph { background: #c96f17; font-size: 14px; font-weight: 700; letter-spacing: 3px; }\n    .pts { border-top: 1px solid #0b142433; font-size: 56px; font-weight: 800; font-variant-numeric: tabular-nums; }\n    .foot { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; font-size: 18px; font-weight: 600; letter-spacing: 2px; color: #8a9ab5; }\n    .foot .s { display: flex; gap: 22px; }\n    .foot .s.b { justify-content: flex-end; }\n    .fl, .tol-v { color: #e8edf5; margin-left: 8px; }\n    .tol::before { content: \"TIMEOUTS\"; }\n    .tol:has(.tol-v:empty) { display: none; }\n    .bonus { color: #f08a24; }\n    .bonus:empty { display: none; }\n    .now { display: flex; align-items: center; gap: 14px; padding: 8px 22px; background: #15233b; border-radius: 30px; color: #e8edf5; }\n    .per { font-size: 30px; font-weight: 800; color: #f08a24; }\n    .per:empty { display: none; }\n    .gc { font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .osb-aux, .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<main class=\"screen\" aria-label=\"Basketball box score\">\n  <header class=\"head\"><span class=\"ev\"><span class=\"ev-name eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"flags\"><span class=\"flag isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\">BREAK</span><span class=\"flag isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\">FINAL</span></span></header>\n  <section class=\"table\">\n    <div class=\"names\"><span class=\"hcell\">TEAM</span><span class=\"team\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"team\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span></div>\n    <div class=\"periods\">\n      <div class=\"col\"><span class=\"ph\">Q1</span><span class=\"g ga game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><span class=\"g gb game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></div>\n      <div class=\"col\"><span class=\"ph\">Q2</span><span class=\"g ga game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><span class=\"g gb game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></div>\n      <div class=\"col\"><span class=\"ph\">Q3</span><span class=\"g ga game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><span class=\"g gb game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></div>\n      <div class=\"col\"><span class=\"ph\">Q4</span><span class=\"g ga game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><span class=\"g gb game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></div>\n      <div class=\"otwrap isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\"><div class=\"col\"><span class=\"ph\">OT1</span><span class=\"g ga game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><span class=\"g gb game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></div></div>\n      <div class=\"otwrap isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"display: none; opacity: 0;\"><div class=\"col\"><span class=\"ph\">OT2</span><span class=\"g ga game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span><span class=\"g gb game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></div></div>\n    </div>\n    <div class=\"tot\"><span class=\"ph\">T</span><span class=\"pts currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"pts currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n  </section>\n  <footer class=\"foot\">\n    <span class=\"s\"><span>FOULS<span class=\"fl teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</span></span><span class=\"tol\"><span class=\"tol-v timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span></span><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span></span>\n    <span class=\"now\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"gc\"><span class=\"cm clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b class=\"colon\">:</b><span class=\"cs clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span></span>\n    <span class=\"s b\"><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span><span class=\"tol\"><span class=\"tol-v timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span></span><span>FOULS<span class=\"fl teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</span></span></span>\n  </footer>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><span class=\"possession\" data-osb-component=\"field\" data-osb-field=\"possession\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</main>\n</body>\n</html>\n","css":""}
