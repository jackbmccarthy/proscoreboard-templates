{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Vertical Name Spine Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f8f5ee; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { --panel-height: 306px; --spine-width: 132px; width: 100%; max-width: 1266px; display: flex; flex-direction: column; background: transparent; }\n.title { text-align: center; font-size: 82px; line-height: 1; font-weight: 700; margin-bottom: 26px; }\n.teams { display: flex; flex-direction: column; gap: 32px; }\n.team { display: flex; height: var(--panel-height); }\n.spine { flex: 0 0 var(--spine-width); width: var(--spine-width); min-width: 0; height: var(--panel-height); display: flex; align-items: center; justify-content: center; overflow: hidden; background: #102a36; }\n.name { display: block; flex: 0 0 calc(var(--panel-height) - 48px); width: calc(var(--panel-height) - 48px); height: 72px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-size: 60px; font-weight: 700; line-height: 72px; transform: rotate(-90deg); }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-pane { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f2eee6; color: #102a36; padding: 16px; }\n.sets-band { display: flex; align-items: center; justify-content: center; gap: 13px; color: #b85c3a; font-size: 44px; font-weight: 700; line-height: 1; }\n.match-score { display: block; width: 70px; text-align: left; font-variant-numeric: tabular-nums; }\n.primary-score { display: block; width: 100%; height: 174px; margin-top: 8px; font-family: \"Arial Black\", Arial, sans-serif; font-size: 210px; font-weight: 900; line-height: .9; text-align: center; letter-spacing: -.06em; font-variant-numeric: tabular-nums; }\n.points-label { display: block; text-align: center; margin-top: 13px; font-size: 44px; font-weight: 700; line-height: 1; }\n.set-footer { display: flex; align-items: center; justify-content: center; gap: 15px; margin-top: 32px; font-size: 48px; font-weight: 700; line-height: 1; }\n.set-value { display: block; width: 54px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-height: 800px) and (min-width: 701px) {\n  .board { --panel-height: 245px; }\n  .title { font-size: 60px; margin-bottom: 20px; }\n  .teams { gap: 20px; }\n  .name { height: 60px; line-height: 60px; font-size: 48px; }\n  .score-pane { padding: 10px; }\n  .sets-band { font-size: 30px; }\n  .primary-score { font-size: 160px; height: 135px; margin-top: 4px; }\n  .points-label { font-size: 32px; margin-top: 8px; }\n  .set-footer { font-size: 36px; margin-top: 24px; }\n}\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .board { --panel-height: 200px; --spine-width: 60px; }\n  .title { font-size: 30px; margin-bottom: 22px; }\n  .teams { gap: 22px; }\n  .name { flex-basis: calc(var(--panel-height) - 24px); width: calc(var(--panel-height) - 24px); height: 42px; line-height: 42px; font-size: 33px; }\n  .score-pane { padding: 10px; }\n  .sets-band { font-size: 23px; gap: 8px; }\n  .match-score { width: 40px; }\n  .primary-score { font-size: 136px; height: 115px; margin-top: 5px; }\n  .points-label { font-size: 23px; margin-top: 7px; }\n  .set-footer { font-size: 29px; margin-top: 25px; gap: 9px; }\n  .set-value { width: 33px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-pane columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sets-band rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-pane columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sets-band rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
