{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Atlantic Open Flank 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(94vw,1335px);max-width:100%;aspect-ratio:3.56;overflow:hidden;border:2px solid #5c7379;border-radius:5px;background:#21343c;color:#f6f8f5;container-type:inline-size}\n.teams{display:flex;flex:1 1 0;min-height:0;flex-direction:column}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0;min-width:0}\n.team+.team{border-top:2px solid #5c7379}\n.identity{display:block;flex:0 0 14px;align-self:stretch;margin:19px 0 19px 16px;background:#39a6e4}\n.jerseyColorB{background:#ed6c74}\n.sets,.points{display:flex;align-items:center;justify-content:center;flex-direction:column;min-width:0;gap:2px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sets{flex:0 0 13%;color:#a5c5c3}\n.points{flex:0 0 16%;color:#f6f8f5}\n.label{display:block;max-width:100%;overflow:hidden;font-size:clamp(14px,1.8cqw,26px);font-weight:700;line-height:1}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(32px,5cqw,71px);font-weight:800;line-height:1;text-align:center}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(46px,6.2cqw,90px);font-weight:800;line-height:1;text-align:center}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 38px;color:#f6f8f5;font-size:clamp(30px,6.3cqw,83px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.utility{display:flex;align-items:center;justify-content:space-between;flex:0 0 18%;min-width:0;padding:0 25px;border-top:2px solid #5c7379;font-size:clamp(17px,2.4cqw,31px);font-weight:750;letter-spacing:.04em;line-height:1;white-space:nowrap}\n.sport-tag{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.set-status{display:flex;align-items:center;gap:.3em;color:#a5c5c3}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:7px}\n .board{width:100%;height:168px;aspect-ratio:auto;border-width:1px;border-radius:3px}\n .team+.team,.utility{border-width:1px}\n .identity{flex-basis:5px;margin:11px 0 11px 6px}\n .sets{flex-basis:17%}\n .points{flex-basis:19%}\n .label{font-size:clamp(8px,2.4cqw,11px)}\n .set-score{font-size:clamp(21px,6cqw,28px)}\n .score{font-size:clamp(27px,8cqw,38px)}\n .name{padding:0 8px;font-size:clamp(16px,5cqw,23px)}\n .utility{padding:0 9px;font-size:clamp(11px,3cqw,15px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"points\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"points\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n  </div>\n  <div class=\"utility rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
