{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Varsity Card</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px; font-family: \"Rockwell\", \"Roboto Slab\", Georgia, serif; }\n    .card { position: relative; width: 400px; background: #fbf7ee; color: #1a2340; border: 2px solid #1a2340; border-radius: 4px; box-shadow: 4px 4px 0 #1a2340, 0 10px 22px #0006; }\n    .ev { display: flex; justify-content: space-between; padding: 5px 12px 4px; border-bottom: 2px solid #1a2340; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }\n    .ev-round { color: #b3202a; }\n    .ev:has(.eventName:empty):has(.matchRound:empty) { display: none; }\n    .row { position: relative; display: grid; grid-template-columns: 16px minmax(0, 1fr) 78px; align-items: center; height: 54px; }\n    .row + .row { border-top: 1px dashed #b9ad92; }\n    .kit { align-self: stretch; background-color: #b9ad92; clip-path: polygon(0 0, 100% 0, 55% 50%, 100% 100%, 0 100%); }\n    .nm { padding: 0 10px; font-size: 26px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .ledger { position: absolute; left: 30px; bottom: 3px; display: flex; gap: 10px; font-family: \"Arial Narrow\", Arial, sans-serif; font-size: 11px; letter-spacing: 1.2px; color: #6b6450; }\n    .fl, .tol-v { color: #1a2340; font-weight: 700; }\n    .tol::before { content: \"T.O. \"; }\n    .tol:has(.tol-v:empty) { display: none; }\n    .bonus { color: #b3202a; font-weight: 700; }\n    .bonus:empty { display: none; }\n    .pts { align-self: stretch; display: flex; align-items: center; justify-content: center; border-left: 2px solid #1a2340; font-size: 40px; font-weight: 700; font-variant-numeric: tabular-nums; background: #f3ecdc; }\n    .band { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 12px; background: #b3202a; color: #fbf7ee; border-top: 2px solid #1a2340; }\n    .per { font-size: 20px; font-weight: 700; }\n    .per:empty { display: none; }\n    .gc { font-size: 32px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .shot { font-family: \"Arial Narrow\", Arial, sans-serif; font-size: 13px; letter-spacing: 1px; }\n    .shot::before { content: \"SHOT \"; }\n    .sc-v { display: inline-block; min-width: 28px; padding: 1px 4px; text-align: center; background: #fbf7ee; color: #b3202a; font-family: \"Rockwell\", Georgia, serif; font-size: 18px; font-weight: 700; border-radius: 2px; }\n    .shot:has(.sc-v:empty) { display: none; }\n    .meta { display: flex; align-items: center; gap: 8px; font-family: \"Arial Narrow\", Arial, sans-serif; font-size: 12px; letter-spacing: 1px; }\n    .pips { display: flex; gap: 3px; }\n    .pip { position: relative; width: 10px; height: 10px; border: 1px solid #fbf7ee; border-radius: 50%; }\n    .pip-on { position: absolute; inset: 1px; border-radius: 50%; background: #fbf7ee; }\n    .pip.pip-ot { width: auto; height: auto; border-radius: 2px; padding: 0 3px; background: #fbf7ee; color: #b3202a; font-size: 9px; }\n    .poss::before { content: \"POSS \"; }\n    .poss:has(.poss-v:empty) { display: none; }\n    .to-flag { position: absolute; inset: 0; align-items: center; justify-content: center; gap: 8px; background: #1a2340; color: #fbf7ee; font-size: 20px; font-weight: 700; letter-spacing: 3px; }\n    .brk { position: absolute; right: 10px; top: -14px; padding: 3px 10px; background: #1a2340; color: #fbf7ee; font-size: 12px; font-weight: 700; letter-spacing: 2px; border-radius: 2px; }\n    .osb-aux, .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<article class=\"card\" aria-label=\"Basketball scorecard\">\n  <span class=\"ev\"><span class=\"ev-name eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span>\n  <div class=\"row\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"pts currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"ledger\"><span>FOULS <span class=\"fl teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</span></span><span class=\"tol\"><span class=\"tol-v timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span></span><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span></span><div class=\"to-flag isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\">TIMEOUT <span class=\"to-clock timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></div></div>\n  <div class=\"row\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"pts currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"ledger\"><span>FOULS <span class=\"fl teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</span></span><span class=\"tol\"><span class=\"tol-v timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span></span><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span></span><div class=\"to-flag isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\">TIMEOUT <span class=\"to-clock timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></div></div>\n  <div class=\"band\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"gc\"><span class=\"cm clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b class=\"colon\">:</b><span class=\"cs clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"meta\"><span class=\"pips\"><span class=\"pip\"><span class=\"pip-on isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"pip\"><span class=\"pip-on isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"pip\"><span class=\"pip-on isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"pip\"><span class=\"pip-on isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"pip pip-ot isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\">OT</span></span><span class=\"poss\"><span class=\"poss-v possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span></span></span><span class=\"shot\"><span class=\"sc-v\" data-osb-static=\"true\" data-sport-stat=\"shotClock\"></span></span></div>\n  <span class=\"brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\">BREAK</span>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><span class=\"possession\" data-osb-component=\"field\" data-osb-field=\"possession\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
