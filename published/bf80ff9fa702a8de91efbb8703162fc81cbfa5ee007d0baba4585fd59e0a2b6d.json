{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Daylight</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\nhtml,body{height:100%;overflow:hidden}\n.osb-core-fields{display:none!important}\n.board{position:fixed;inset:0;display:flex;flex-direction:column;gap:2vh;padding:3vh 2vw 2vh;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#17202e;background:#e9e5da;-webkit-font-smoothing:antialiased;overflow:hidden}\n.row{display:flex;flex:1 1 auto;min-height:0;gap:0}\n.end{position:relative;display:grid;grid-template-rows:auto 1fr auto;flex:1 1 0;min-width:0;padding:3.6vh 2.4vw 2.6vh;border-radius:1.6vh;background:#fff;box-shadow:0 .6vh 2.4vh rgba(40,30,10,.18)}\n.kit{position:absolute;left:0;right:0;top:0;height:1.6vh;border-radius:1.6vh 1.6vh 0 0;background:#8a93a3}\n.who{display:grid;grid-template-columns:auto minmax(0,1fr) 7vh;align-items:center;gap:1.4vw;min-width:0}\n.flag{width:7vh;height:4.7vh;object-fit:cover;border-radius:.4vh;box-shadow:0 0 0 1px rgba(0,0,0,.18)}\n.flag:not([src]){display:block;width:0;margin-right:-1.4vw;box-shadow:none}\n.nm{display:flex;flex-direction:column;gap:.6vh;min-width:0}\n.name{font-size:4.4vh;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;hyphens:none}\n.team{display:flex;align-items:center;gap:1vw;font-size:3.2vh;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#5b6577}\n.tlogo{width:5vh;height:5vh;object-fit:contain}\n.tie{display:inline-flex;align-items:center;gap:.6vw;padding:0 1vw;height:5vh;border-radius:.6vh;background:#17202e;color:#fff;flex:0 0 auto}\n.tie i{font-style:normal;color:#b9c2d3}\n.team:not(:has(.tname:not(:empty))){display:none}\n.nm:has(.name:empty) .team{flex-wrap:wrap;font-size:4.2vh;color:#17202e}\n.nm:has(.name:empty) .tname{line-height:1.05}\n.ss{width:7vh;height:7vh}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .5vh rgba(0,0,0,.12),0 .6vh 1.6vh rgba(214,95,0,.45)}\n.win{border-radius:50%;background:#1aa260}\n.win::after{content:\"\";width:2vh;height:3.8vh;margin-top:-.8vh;border:solid #fff;border-width:0 1vh 1vh 0;transform:rotate(45deg)}\n.pts{display:flex;align-items:center;justify-content:center;min-height:0}\n.big{font-size:44vh;line-height:.8;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.03em;color:#17202e}\n.foot{display:flex;align-items:center;justify-content:space-between;gap:1.4vw;min-height:7vh}\n.hist{position:relative;display:flex;gap:.7vw}\n.hg{display:flex;align-items:center;gap:.6vw;height:6.4vh;padding:0 1.1vw;border-radius:.8vh;font-weight:800;font-variant-numeric:tabular-nums}\n.hl{font-style:normal;font-size:2.8vh;letter-spacing:.08em;opacity:.75}\n.gs{font-size:4.2vh}\n\n.hg:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;padding:0!important;margin:0!important;border:0!important}\n.hg .won{display:none}\n.hg{background:#eeeae0;color:#7d8696}\n.end[data-osb-resolved-court-side=\"A\"] .hg:has(.wA[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"] .hg:has(.wB[style*=\"opacity: 1\"]){background:#17202e;color:#fff}\n.end[data-osb-resolved-court-side=\"A\"] .isBWinner,.end[data-osb-resolved-court-side=\"B\"] .isAWinner,.end:not([data-osb-resolved-court-side]) :is(.isAWinner,.isBWinner){display:none!important}\n\n.marks{display:flex;align-items:center;gap:1vw;margin-left:auto}\n.to-slot{width:17vh;height:6vh}\n.to-on,.to-used{border-radius:.6vh;font-size:3vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.to-on{background:#ffcc00;color:#111}\n.to-used{box-shadow:inset 0 0 0 .4vh #c4c9d3;color:#5b6577}\n.cs{width:4.2vh;height:6vh}\n.card{border-radius:.6vh;box-shadow:0 0 0 .2vh rgba(0,0,0,.25)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n/* the games tiles sit in the centre spine, beside each other under its GAMES label */\n.gw{position:absolute;top:50%;display:flex;align-items:center;justify-content:center;width:8.8vw;height:8.8vw;margin-top:-4.4vw;border-radius:1.2vh;background:#17202e;color:#fff;box-shadow:0 .6vh 1.6vh rgba(0,0,0,.2)}\n.eA .gw{left:calc(100% + .9vw)}\n.eB .gw{right:calc(100% + .9vw)}\n.gn{font-size:6.8vw;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}\n.spine{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:space-between;flex:0 0 20vw;padding:2vh 0}\n.tagslot{width:16vw;height:13vh}\n.tagslot>*{flex-direction:column;gap:.4vh;border-radius:1.2vh;font-weight:900;text-transform:uppercase;line-height:1}\n.tagslot i{font-style:normal;font-size:3vh;letter-spacing:.16em}\n.now,.nx,.fin{display:flex;flex-direction:column;align-items:center;gap:.4vh}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:flex}\n.cg,.ng,.tagslot b{font-size:7vh;letter-spacing:.02em}\n.gtag{background:#17202e;color:#fff}\n.gtag i{color:#b9c2d3}\n.fin{background:#1aa260;color:#fff}\n.pre{font-size:7vh;color:#a8a293;letter-spacing:.06em}\n.tagslot:has(>.gtag[style*=\"opacity: 1\"]) .pre,.tagslot:has(>.fin[style*=\"opacity: 1\"]) .pre{opacity:0}\n.glabel{position:absolute;top:50%;margin-top:calc(-4.4vw - 5.4vh);font-size:3.4vh;font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:#5b6577}\n.banner{width:16vw;height:9vh}\n.bn{border-radius:1.2vh;font-size:3.8vh;font-weight:900;letter-spacing:.1em;text-transform:uppercase}\n.bn-warm,.bn-break{background:#fff;color:#17202e;box-shadow:inset 0 0 0 .4vh #17202e}\n.bn-gp{background:#ff8a1c;color:#111}\n.bn-mp{background:#e3262f;color:#fff}\n.bar{display:flex;align-items:center;justify-content:space-between;gap:2vw;flex:0 0 7vh;padding:0 1vw}\n.info{display:flex;align-items:center;min-width:0;font-size:3.6vh;font-weight:800;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;overflow:hidden}\n.info>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.info .sep{flex:0 0 auto;font-style:normal;padding:0 .6em;color:#8a93a3}\n.info .ev:empty+.sep,.info .rd:empty+.s2,.info .sep:has(+.rd:empty),.info .s2:has(+.bo:empty){display:none}\n.chips{display:flex;gap:1vw}\n.teamlbl{display:none}\n.info:not(:has(.ev:not(:empty))):not(:has(.rd:not(:empty))) .teamlbl{display:inline}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.chip{width:24vh;height:5.6vh}\n.fl{border-radius:.6vh;font-size:3vh;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:#17202e;color:#fff}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .big{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .glabel{display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{left:50%!important;right:auto!important;top:47%;transform:translate(-50%,-50%);margin:0;width:auto;height:auto;flex-direction:column;gap:1vh;background:none;box-shadow:none;color:#17202e}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{font-size:38vh;line-height:.8}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw::after{content:\"Games won\";font-size:3.6vh;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#5b6577}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]{box-shadow:0 0 0 .8vh #1aa260,0 .6vh 2.4vh rgba(40,30,10,.18)}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]{background:#f4f2ec}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) :is(.big,.name,.flag){opacity:.4}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]) .gn{color:#1aa260}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) .gn{color:#b3b0a6}\n\n/* round 3: games won live on each player's card (labelled), bigger names, team band, labelled cards */\n.end{grid-template-rows:auto auto 1fr auto;grid-template-areas:\"band\" \"who\" \"pts\" \"foot\"}\n.tband{grid-area:band}.who{grid-area:who}.pts{grid-area:pts}.foot{grid-area:foot}\n.who{grid-template-columns:auto minmax(0,1fr) 7vh;grid-template-rows:auto auto;row-gap:1.4vh}\n.name{font-size:5.2vh}\n.gw{position:static;grid-column:1 / -1;grid-row:2;justify-self:start;display:flex;align-items:center;gap:1.2vw;width:auto;height:7vh;margin:0;padding:0 1.4vw 0 1.6vw;border-radius:1vh}\n.gw::before{content:\"Games\";font-size:3vh;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#c9d0dc}\n.gn{font-size:5.6vh}\n.big{font-size:40vh}\n.spine{flex-basis:15vw;justify-content:space-between}\n.tagslot{width:13vw}\n.banner{width:14vw;height:12vh}\n.bn{font-size:3.6vh;white-space:normal!important;text-align:center;line-height:1.05;padding:0 1vw}\n.foot{flex-wrap:wrap;row-gap:1vh}\n.info .rd,.info .bo{flex-shrink:0}\n.tband{display:none;align-items:center;gap:1.2vw;margin-bottom:1.6vh;padding:0 1.2vw;min-height:7vh;border-radius:.8vh;background:#17202e;color:#fff;font-size:3.4vh;font-weight:800;letter-spacing:.05em;text-transform:uppercase}\n.board:has(.tname:not(:empty)) .tband{display:flex}\n.tband .tlogo{width:5vh;height:5vh;object-fit:contain;flex:0 0 auto}\n.tband .tname{flex:1 1 auto;min-width:0;line-height:1.05;overflow-wrap:normal;hyphens:none}\n.tband .tie{display:inline-flex;align-items:center;gap:1vw;flex:0 0 auto;height:5.2vh;padding:0 1.2vw;border-radius:.6vh;background:#ffcc00;color:#17202e}\n.tband .tie i{font-style:normal;font-size:2.8vh;letter-spacing:.14em;color:#17202e}\n.tband .tscore{font-size:4.2vh;font-variant-numeric:tabular-nums}\n.board:has(.tname:not(:empty)) .big{font-size:33vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.who,.pts,.foot,.spine,.bar){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .row{gap:2vw}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband{grid-row:1 / -1;flex-direction:column;justify-content:center;gap:5vh;margin:0;background:none;color:#17202e;font-size:7vh;text-align:center}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tlogo{width:14vh;height:14vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tname{flex:0 0 auto}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie{height:auto;padding:2vh 4vw;border-radius:1.6vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tscore{font-size:22vh;line-height:.9}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie i{font-size:4vh}\n.cs{width:16.5vh;height:6vh}\n.to-slot{width:14vh}\n.to-on,.to-used{font-size:2.6vh}\n.marks{gap:.8vw}\n.card{display:flex;align-items:center;justify-content:flex-start;gap:.8vw;padding:0 .9vw;border-radius:.6vh;font-size:2.6vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase;background:#eeeae0;color:#17202e;box-shadow:none}\n.card b{flex:0 0 auto;width:2.9vh;height:4vh;border-radius:.4vh;box-shadow:0 0 0 .2vh rgba(0,0,0,.25)}\n.yc,.rc{background:#eeeae0}\n.yc b{background:#ffd400}.rc b{background:#e3262f}\n.to-used{box-shadow:none;background:#e3dfd3;color:#3b4456}\n.hg{background:#eeeae0;color:#4e586a}\n.hl{opacity:1}\n.info{font-size:3.8vh}\n.chip{height:5.6vh}\n/* final: the loser card steps back, still readable */\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) :is(.big,.name){opacity:1;color:#5b6577}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) .flag{opacity:.55}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) .gn{color:#6f7788}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{position:absolute;grid-column:auto;grid-row:auto;padding:0}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw::before{content:none}\n</style>\n</head>\n<body>\n<main class=\"board t-day\" data-osb-component=\"layout\"><div class=\"row\" data-osb-component=\"layout\"><div class=\"courtSideAView end eA\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"tband\" data-osb-component=\"layout\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tie\"><i>Tie</i><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></div><div class=\"who\" data-osb-component=\"layout\"><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nm\"><span class=\"courtSideCombinedAName name\" data-osb-component=\"field\" data-osb-field=\"courtSideCombinedAName\"></span></span><span class=\"slot ss\"><span class=\"courtSideIsACurrentlyServing ball\" data-osb-component=\"field\" data-osb-field=\"courtSideIsACurrentlyServing\" style=\"opacity:0\"></span><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"></span><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"op