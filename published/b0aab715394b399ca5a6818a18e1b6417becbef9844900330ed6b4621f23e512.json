{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Charcoal Outline Sidecar — Soccer compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.shell{position:relative;width:min(88vw,1150px,calc((100vh - 32px)*3.8));max-width:100%;padding-top:42px;container-type:inline-size}.sport-tag{position:absolute;top:0;left:0;display:flex;align-items:center;height:42px;min-width:170px;padding:0 21px;background:#dce3e2;color:#20272c;font-size:2.8cqw;font-weight:800;line-height:1;white-space:nowrap}.board{display:flex;width:100%;height:265px;min-width:0;overflow:hidden;background:#20272c;color:#f2f3ee;border:1px solid #a8b8bc;border-radius:2px;font-variant-numeric:tabular-nums}.competitors{display:flex;flex:1 1 78%;min-width:0;flex-direction:column}.competitor{display:flex;align-items:center;flex:1 1 0;min-width:0}.competitor+.competitor{border-top:1px solid #7e958f}.identity{display:block;flex:none;width:16px;height:90%;margin-left:4px;background:#087bf0}.jerseyColorB{background:#ef2535}.name{display:block;flex:1 1 0;min-width:0;margin-left:38px;padding-right:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.6cqw;font-weight:700;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex:none;width:22%;height:87%;margin-right:9px;border:1px solid #a8b8bc;background:#20272c}.score{display:block;width:100%;text-align:center;font-size:7.9cqw;font-weight:800;line-height:1;color:#fff;white-space:nowrap;font-variant-numeric:tabular-nums}.dock{display:flex;flex:0 0 22%;min-width:0;flex-direction:column;background:#dce3e2;color:#20272c}.stat{display:flex;align-items:flex-start;justify-content:center;flex:1 1 0;min-height:0;flex-direction:column;gap:2px;padding:0 24px;white-space:nowrap}.stat+.stat{border-top:1px solid #a8b8bc}.stat-label{font-size:2.5cqw;font-weight:700}.stat-value{font-size:4.6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.stage{padding:10px}.shell{width:100%;padding-top:29px}.sport-tag{height:29px;min-width:85px;padding:0 7px;font-size:12px}.board{height:152px}.competitors{flex-basis:72%}.identity{width:5px;margin-left:3px}.name{margin-left:8px;padding-right:3px;font-size:clamp(14px,4.4cqw,20px)}.score-track{width:52px;height:80%;margin-right:4px}.score{font-size:clamp(26px,8cqw,33px)}.dock{flex-basis:28%}.stat{padding:0 7px;gap:1px}.stat-label{font-size:clamp(8px,2.4cqw,10px)}.stat-value{font-size:clamp(17px,5cqw,22px)}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><div class=\"shell\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Soccer scoreboard\"><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><aside class=\"dock columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Editable static soccer counters\"><div class=\"stat columnContainer\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat columnContainer\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></aside><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></div></main></body></html>\n","css":""}
