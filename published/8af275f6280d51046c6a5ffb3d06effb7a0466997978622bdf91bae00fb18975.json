{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Charcoal Ivory Open Score — Pickleball 2</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{position:relative;width:min(92vw,1760px);min-width:0;container-type:inline-size}.surface{overflow:hidden;border:1px solid #53615c;border-radius:3px;background:#232c2b}.header{height:3.05cqw;min-height:32px;display:flex;align-items:center;justify-content:center;background:#e9e6da;color:#232c2b;border-bottom:2px solid #718779;font-size:2.1cqw;font-weight:700;letter-spacing:.02em;white-space:nowrap}.lanes{display:flex;min-width:0}.lane{display:flex;align-items:center;flex:1 1 0;min-width:0;height:8.8cqw;min-height:75px;background:#232c2b;color:#f6f7f2}.lane+.lane{border-left:1px solid #718779}.identity{display:block;flex:0 0 .75cqw;width:.75cqw;height:5.8cqw;background:#718779;margin-left:1.5cqw}.jerseyColorB{background:#ab9470;margin-left:0;margin-right:1.5cqw}.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;gap:.5cqw;padding:0 1.65cqw}.lane-b .name-lane{justify-content:flex-end}.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.2cqw;line-height:1.1;font-weight:700}.lane-b .name{text-align:right}.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}.serve{display:block;flex:0 0 .5cqw;width:.5cqw;height:.5cqw;border-radius:50%;background:#e9e6da}.number-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 8.8cqw;height:100%;min-width:0;gap:.35cqw}.point-track{flex-basis:11.6cqw}.label{font-size:1.25cqw;font-weight:700;color:#e9e6da;line-height:1;white-space:nowrap}.match-score,.score{display:block;width:100%;text-align:center;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}.match-score{font-size:3.15cqw}.score{font-size:5.5cqw;font-weight:700}.point-slot{position:absolute;top:100%;left:50%;transform:translateX(-50%);width:170px;height:18px;text-align:center;color:#f6f7f2;font-size:11px;font-weight:700}.point-state{position:absolute;inset:0;display:block;background:#232c2b;border-top:2px solid #718779}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw}.header{height:38px;font-size:15px}.lanes{flex-direction:column}.lane{height:77px;flex:none;width:100%}.lane+.lane{border-left:0;border-top:1px solid #718779}.identity{flex-basis:5px;width:5px;height:48px;margin-left:9px}.jerseyColorB{margin-left:0;margin-right:9px}.name-lane{padding:0 10px;gap:5px}.name{font-size:20px}.serve{flex-basis:6px;width:6px;height:6px}.number-track{flex-basis:48px;gap:3px}.point-track{flex-basis:61px}.label{font-size:9px}.match-score{font-size:26px}.score{font-size:37px}.point-slot{height:16px;font-size:10px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"surface columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\">PICKLEBALL</header><div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"number-track\"><span class=\"label\">GAMES</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"number-track point-track\"><span class=\"label\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"number-track point-track\"><span class=\"label\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><div class=\"number-track\"><span class=\"label\">GAMES</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"name-lane\"><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></div></div></div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
