{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Inverted Splitline TABLE TENNIS 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f2eee3}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh}.board{width:min(var(--view-width),1500px,var(--height-width));container-type:inline-size;position:relative;display:flex;flex-direction:column;background:transparent;padding-bottom:3.5cqw}.header{text-align:center;margin:0 0 var(--header-gap);font-size:var(--header-size);line-height:1;white-space:nowrap}.cap{position:relative;display:flex;align-items:center;gap:1.6cqw;min-width:0;padding:0 var(--cap-pad);height:var(--cap-height);background:#eab743;color:#121316}.name{flex:1;min-width:0;display:block;font-size:var(--name-font);line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.025em}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.secondary{display:flex;align-items:center;justify-content:center;font-size:var(--games-font);gap:.8cqw;flex-shrink:0;white-space:nowrap}.match-score{display:block;min-width:2ch;font-variant-numeric:tabular-nums;text-align:center}.serve{position:absolute;top:.25cqw;right:.3cqw;width:1.2cqw;height:1.2cqw;font-size:1.2cqw}.panel{height:var(--panel-height);position:relative;isolation:isolate;background:#121316;display:flex}.panel:before{content:\"\";position:absolute;left:0;right:0;top:0;height:50%;background:#f2eee3;z-index:0}.score-track{position:relative;min-width:0;flex:1;height:100%}.score{position:absolute;top:46%;left:0;display:block;width:100%;font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;font-size:var(--score-font);line-height:.7;text-align:center;font-variant-numeric:tabular-nums;letter-spacing:-.07em;white-space:nowrap;color:#fff;mix-blend-mode:difference;transform:translateY(-50%) scaleY(var(--score-stretch));padding:0 1cqw}.label{position:absolute;bottom:var(--label-bottom);left:0;width:100%;font-size:var(--label-size);line-height:1.1;text-align:center;color:#f2eee3;white-space:nowrap}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:36cqw;height:2.5cqw;font-size:1.9cqw;text-align:center}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{--view-width:94vw}.point-slot{font-size:2.3cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:84.5vw;--height-width:143vh;--header-size:7.8cqw;--header-gap:3.7cqw;--cap-pad:2.4cqw;--cap-height:7.1cqw;--name-font:4.6cqw;--games-font:2.9cqw;--panel-height:45.5cqw;--score-font:35cqw;--score-stretch:1.3;--label-size:4.3cqw;--label-bottom:2.7cqw}.caps{display:flex;gap:9.7cqw;padding:0 .7cqw;margin-bottom:1.2cqw}.cap{flex:1}\n.score{top:39%}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">TABLE TENNIS</h1><div class=\"caps rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"cap jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"secondary\"><span>GAMES</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"cap jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"secondary\"><span>GAMES</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"panel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-track\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><div class=\"label\">POINTS</div></div><div class=\"score-track\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><div class=\"label\">POINTS</div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
