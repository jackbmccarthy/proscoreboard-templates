3, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;ascent-override:95%;descent-override:25%;line-gap-override:0%}@font-face{font-family:\"OSB Barlow\";font-style:normal;font-weight:500;font-display:block;src:url(\"/fonts/scoreboard/barlow-500-latin-ext.woff2\") format(\"woff2\");unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;ascent-override:95%;descent-override:25%;line-gap-override:0%}@font-face{font-family:\"OSB Barlow\";font-style:normal;font-weight:600;font-display:block;src:url(\"/fonts/scoreboard/barlow-600-latin.woff2\") format(\"woff2\");unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;ascent-override:95%;descent-override:25%;line-gap-override:0%}@font-face{font-family:\"OSB Barlow\";font-style:normal;font-weight:600;font-display:block;src:url(\"/fonts/scoreboard/barlow-600-latin-ext.woff2\") format(\"woff2\");unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;ascent-override:95%;descent-override:25%;line-gap-override:0%}@font-face{font-family:\"OSB Barlow\";font-style:normal;font-weight:700;font-display:block;src:url(\"/fonts/scoreboard/barlow-700-latin.woff2\") format(\"woff2\");unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;ascent-override:95%;descent-override:25%;line-gap-override:0%}@font-face{font-family:\"OSB Barlow\";font-style:normal;font-weight:700;font-display:block;src:url(\"/fonts/scoreboard/barlow-700-latin-ext.woff2\") format(\"woff2\");unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;ascent-override:95%;descent-override:25%;line-gap-override:0%}\n\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\n.stage{position:fixed;inset:0;display:flex;align-items:flex-start;justify-content:flex-start;padding:2.6vw 0 0 2.6vw;pointer-events:none}\n.board{position:relative;width:35em;font-size:1.25vw;font-family:\"OSB Barlow Condensed\",\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#15233f;-webkit-font-smoothing:antialiased}\n.pcard{border-radius:.35em;overflow:hidden;background:#fbf7ee;box-shadow:0 .4em 1.3em rgba(0,0,0,.45)}\n/* header: event left, the GAMES / GAME n labels over their columns */\n.hd{display:flex;align-items:stretch;height:1.9em;background:#15233f;color:#f4efe4;font-weight:800;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap}\n.hd .meta{flex:1 1 auto;padding:0 .8em}\n.hd .lbl{flex:0 0 3.6em;display:flex;align-items:center;justify-content:center;color:#c9c0aa}\n.hd .ph{flex:0 0 4.2em;height:auto;background:#c8102e;color:#fff}\n.ph>*{font-weight:800;letter-spacing:.06em}\n.ph:has(>.gtag[style*=\"opacity: 1\"]) .plbl,.ph:has(>.fin[style*=\"opacity: 1\"]) .plbl{opacity:0}\n.row{display:flex;align-items:center;height:3.2em;gap:.5em;min-width:0}\n.row+.row{border-top:1px solid #e3dac6}\n.kit{flex:0 0 .45em;align-self:stretch;background:#9aa3b2}\n.flag{flex:0 0 auto;width:1.8em;height:1.2em;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.2)}\n.name{flex:1 1 auto;min-width:0;font-size:1.25em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;word-break:normal;hyphens:none}\n.marks{display:flex;align-items:center;gap:.25em;flex:0 0 auto}\n.to-slot{width:2.2em;height:1.4em}\n.to-on,.to-used{border-radius:.2em;font-size:1em;font-weight:900;letter-spacing:.02em}\n.to-on{background:#ffd23f;color:#111}\n.to-used{background:#e3dac6;color:#3d3628}\n.card-slot{width:.85em;height:1.2em}\n.marks .card{border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.3)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.s2slot{width:1.15em;height:1.3em}\n.ss2{border-radius:.2em;background:#15233f;color:#fff;font-size:1em;font-weight:900}\n.srv{width:1.35em;height:1.35em;margin-right:.15em}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff9a3c 45%,#d65f00 100%);box-shadow:0 0 0 .1em rgba(0,0,0,.18)}\n.win{border-radius:50%;background:#c8102e}\n.win::after{content:\"\";width:.34em;height:.62em;margin-top:-.14em;border:solid #fff;border-width:0 .16em .16em 0;transform:rotate(45deg)}\n.gw,.pt{flex:0 0 auto;align-self:stretch;display:flex;align-items:center;justify-content:center;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}\n.gw{width:3.6em;font-size:1em;background:#efe7d6;border-left:1px solid #e0d6c0}\n.gw span{display:flex;align-items:center;justify-content:center;width:1.7em;height:1.7em;border-radius:50%;box-shadow:inset 0 0 0 .1em #15233f;font-size:1.35em}\n.pt{width:4.2em;background:#15233f;color:#fff;font-size:2em;width:calc(4.2em / 2)}\n.row+.row .pt{box-shadow:inset 0 1px 0 #34405c}\n/* footer: format on the left, finished games on the right (one strip, attached) */\n.ft{display:flex;align-items:center;gap:.6em;height:2.1em;padding:0 .4em 0 .8em;background:#efe7d6;border-top:1px solid #e0d6c0;font-weight:800;text-transform:uppercase;white-space:nowrap}\n.ft .bo2{flex:1 1 auto;color:#5a5240;letter-spacing:.07em}\n.hist{display:flex;align-items:center;gap:1em}\n.hcol{display:flex;align-items:center;height:1.55em;font-variant-numeric:tabular-nums}\n.hl{color:#8a7f66;letter-spacing:.06em;margin-right:.25em}\n.hc{position:relative;display:flex;align-items:center;justify-content:center;width:1.6em;height:1.35em;border-radius:.2em;background:#fbf7ee;box-shadow:inset 0 0 0 1px #d9cfb8;color:#6b6352}\n.hcol{gap:.2em}\n.hl{order:0}.hc.a{order:1}.hc.b{order:3}\n.hcol::after{content:\"–\";order:2;color:#8a7f66;font-weight:700}\n.hc .won{inset:0;border-radius:.2em;background:#15233f}\n.hc:has(.won[style*=\"opacity: 1\"]){color:#fff}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;white-space:nowrap;padding:0!important;margin:0!important;border:0!important}\n.tabs{display:flex;justify-content:flex-start;height:2em;padding-left:.8em}\n.state{width:11.5em;height:2em}\n.st{border-radius:0 0 .3em .3em;font-size:1em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.st-warm,.st-break{background:#15233f;color:#fff}\n.st-gp{background:#ff9a3c;color:#111}\n.st-mp{background:#c8102e;color:#fff}\n.fin{background:#c8102e;color:#fff;letter-spacing:.08em}\n/* team tie strip above the card */\n.tiebar{display:none;align-items:center;gap:.6em;min-height:2.5em;padding:.2em .7em;margin-bottom:.25em;border-radius:.35em;background:#15233f;color:#f4efe4;box-shadow:0 .3em 1em rgba(0,0,0,.4);font-weight:800;text-transform:uppercase;letter-spacing:.04em}\n.board:has(.tname:not(:empty)) .tiebar{display:flex}\n.tside{display:flex;align-items:center;gap:.4em;flex:1 1 0;min-width:0}\n.tb{justify-content:flex-end;text-align:right}\n.tlogo{width:1.35em;height:1.35em;object-fit:contain;flex:0 0 auto}\n.tname{min-width:0;overflow:hidden;white-space:normal;overflow-wrap:normal;hyphens:none;line-height:1.05;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}\n.tbox{display:flex;align-items:center;gap:.3em;flex:0 0 auto;height:1.6em;padding:0 .5em;border-radius:.25em;background:#fbf7ee;color:#15233f;font-variant-numeric:tabular-nums}\n.tbox i{font-style:normal;letter-spacing:.1em;margin-right:.2em;color:#8a7f66}\n.tbox .tscore{font-size:1.2em}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.pcard,.tabs){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tiebar{font-size:1.3em;width:23.85em;min-height:3em}\n/* final: p