{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Editorial Quotient Volleyball — Duel</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #231b17; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 1366px; display: flex; flex-direction: column; padding: 28px 48px 25px; background: #fbf5ed; }\n.title { text-align: center; font-size: 44px; font-weight: 600; letter-spacing: .25em; padding-left: .25em; line-height: 1.25; margin-bottom: 22px; }\n.duel { display: flex; }\n.team { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; padding-right: 34px; }\n.team + .team { border-left: 2px solid #231b17; padding-right: 0; padding-left: 36px; }\n.name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-family: \"Times New Roman\", Times, serif; font-style: italic; font-weight: 700; font-size: 116px; line-height: 1.12; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-band { display: flex; flex-direction: column; align-items: center; margin-top: 9px; margin-bottom: 9px; gap: 8px; }\n.label { display: block; text-align: center; font-size: 32px; line-height: 1; letter-spacing: .1em; font-weight: 600; }\n.match-score { display: block; width: 100%; height: 48px; font-size: 48px; line-height: 1; text-align: center; font-variant-numeric: tabular-nums; }\n.rule { display: block; width: 100%; height: 2px; flex: 0 0 2px; background: #231b17; }\n.score { display: block; width: 100%; height: 238px; margin-top: 17px; color: #a74620; font-family: \"Times New Roman\", Times, serif; font-size: 280px; font-weight: 700; line-height: .9; text-align: center; font-variant-numeric: tabular-nums; }\n.points-label { margin-top: 7px; }\n.set-footer { display: flex; align-items: center; justify-content: center; padding-top: 20px; gap: 15px; font-size: 34px; font-weight: 600; line-height: 1; letter-spacing: .08em; }\n.set-value { display: block; width: 36px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1400px) {\n  .name { font-size: clamp(32px, 8.2vw, 116px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .board { padding: 22px 16px 18px; }\n  .title { font-size: 22px; letter-spacing: .13em; margin-bottom: 22px; }\n  .team { padding-right: 12px; }\n  .team + .team { padding-left: 12px; }\n  .name { font-size: 29px; }\n  .sets-band { margin-top: 15px; margin-bottom: 9px; gap: 6px; }\n  .label { font-size: 14px; letter-spacing: .08em; }\n  .match-score { height: 27px; font-size: 27px; }\n  .score { font-size: 95px; height: 86px; margin-top: 16px; }\n  .points-label { margin-top: 6px; }\n  .set-footer { padding-top: 20px; font-size: 21px; gap: 8px; }\n  .set-value { width: 24px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <div class=\"sets-band columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n          <span class=\"rule jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n          <span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label points-label\">POINTS</span>\n        </div>\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <div class=\"sets-band columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n          <span class=\"rule jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n          <span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label points-label\">POINTS</span>\n        </div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
