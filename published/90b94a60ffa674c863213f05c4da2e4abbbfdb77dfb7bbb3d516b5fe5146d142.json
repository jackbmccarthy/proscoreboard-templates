{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>PICKLEBALL · Plum Mist Open Namebed</title>\n<style>\n:root{color-scheme:light}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f9f7f7}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;background:transparent}\n.board{width:54vw;max-width:1040px;min-width:0;overflow:hidden;border:1px solid #6d6672;border-radius:3px;background:#403943;container-type:inline-size}\n.board.horizontal{width:82vw;max-width:1660px}\n.utility{height:5.5cqw;min-height:29px;position:relative;display:flex;align-items:center;padding:0 1.5cqw;background:#403943;border-bottom:1px solid #aba3ad}\n.sport-tab{display:flex;align-items:center;height:82%;padding:0 2.4cqw;border-radius:3px;background:#e7e5e6;color:#403943;font-size:2.65cqw;font-weight:700;line-height:1;white-space:nowrap}\n.point-slot{position:absolute;right:1.6cqw;top:50%;transform:translateY(-50%);width:19cqw;height:1.8em;pointer-events:none;text-align:right}\n.point-state{position:absolute;inset:0;color:#f9f7f7;font-size:1.5cqw;font-weight:700;line-height:1.8em;white-space:nowrap;background:#403943}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{height:13.1cqw;min-height:75px;flex:0 0 auto;display:flex;align-items:stretch;min-width:0;background:#403943}\n.lane+.lane{border-top:1px solid #aba3ad}\n.identity{display:block;flex:0 0 1.55cqw;min-width:5px;margin:1.15cqw 0 1.15cqw 1.5cqw;background:#3186a8;border-radius:2px}\n.jerseyColorB{background:#c96b71}\n.namebed{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.45cqw;padding:0 3.9cqw;overflow:hidden}\n.name-line{display:flex;align-items:center;gap:1cqw;min-width:0;height:6cqw}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.25cqw;font-weight:700;line-height:1.1}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{flex:0 0 2cqw;text-align:center;font-size:1.9cqw;line-height:1;color:#f9f7f7}\n.support-line{display:flex;align-items:baseline;gap:1.7cqw;min-width:0;line-height:1.1}\n.support-caption{font-size:2.45cqw;font-weight:700;letter-spacing:.02em;white-space:nowrap}\n.support-number{font-size:2.55cqw;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}\n.primary-track{flex:0 0 18%;width:18%;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;background:#403943;color:#f9f7f7;overflow:hidden}\n.primary-track::before{content:\"\";position:absolute;left:0;top:10%;bottom:10%;width:1px;background:#aba3ad}\n.primary-number{font-size:7.5cqw;font-weight:700;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}\n.primary-caption{margin-top:.3cqw;font-size:2.25cqw;font-weight:700;line-height:1.05;white-space:nowrap}\n.horizontal .utility{height:3.25cqw}\n.horizontal .sport-tab{font-size:1.65cqw;padding:0 2cqw}\n.horizontal .point-state{font-size:1cqw}\n.horizontal .lanes{flex-direction:row}\n.horizontal .lane{height:9.1cqw;flex:1 1 50%}\n.horizontal .lane+.lane{border-top:0;border-left:1px solid #aba3ad}\n.horizontal .identity{flex-basis:.8cqw;margin:.9cqw 0 .9cqw .9cqw}\n.horizontal .namebed{padding:0 2.1cqw;gap:.2cqw}\n.horizontal .name-line{height:4.5cqw}\n.horizontal .name{font-size:3.8cqw}\n.horizontal .serve{flex-basis:1.5cqw;font-size:1.25cqw}\n.horizontal .support-caption{font-size:1.7cqw}\n.horizontal .support-number{font-size:2.1cqw}\n.horizontal .primary-track{flex-basis:22%;width:22%}\n.horizontal .primary-number{font-size:5.3cqw}\n.horizontal .primary-caption{font-size:1.55cqw;margin-top:.1cqw}\n@media(max-width:650px){\n .board,.board.horizontal{width:94vw}\n .utility,.horizontal .utility{height:9cqw;padding:0 2cqw}\n .sport-tab,.horizontal .sport-tab{font-size:3.1cqw;padding:0 2.6cqw}\n .point-slot{right:2cqw;width:27cqw}\n .point-state,.horizontal .point-state{font-size:2.2cqw}\n .lanes,.horizontal .lanes{flex-direction:column}\n .lane,.horizontal .lane{height:21cqw;min-height:77px;flex:0 0 auto}\n .lane+.lane,.horizontal .lane+.lane{border-left:0;border-top:1px solid #aba3ad}\n .identity,.horizontal .identity{flex-basis:2.3cqw;margin:2cqw 0 2cqw 2cqw}\n .namebed,.horizontal .namebed{padding:0 3cqw;gap:0}\n .name-line,.horizontal .name-line{height:9.8cqw}\n .name,.horizontal .name{font-size:5.7cqw}\n .serve,.horizontal .serve{flex-basis:2.3cqw;font-size:2.3cqw}\n .support-caption,.horizontal .support-caption{font-size:3cqw}\n .support-number,.horizontal .support-number{font-size:3.2cqw}\n .primary-track,.horizontal .primary-track{flex-basis:23%;width:23%}\n .primary-number,.horizontal .primary-number{font-size:9.5cqw}\n .primary-caption,.horizontal .primary-caption{font-size:2.6cqw;margin-top:.1cqw}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board columnContainer paired\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <header class=\"utility\"><div class=\"sport-tab\">PICKLEBALL</div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></header>\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lane rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n      <div class=\"namebed\"><div class=\"name-line\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\" aria-label=\"Serving\">●</span></div><div class=\"support-line\"><span class=\"support-caption\">GAMES</span><span class=\"support-number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div>\n      <div class=\"primary-track\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n    </div>\n    <div class=\"lane rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n      <div class=\"namebed\"><div class=\"name-line\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\" aria-label=\"Serving\">●</span></div><div class=\"support-line\"><span class=\"support-caption\">GAMES</span><span class=\"support-number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n      <div class=\"primary-track\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n    </div>\n  </div>\n</article></main>\n</body>\n</html>\n","css":""}
