{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Full Screen — Linescore</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\nhtml,body{height:100%;overflow:hidden}\n.board{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.1em;padding:0 5vw;font-size:2.15vw;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:radial-gradient(ellipse at 50% 20%,#1d2f52 0%,#0a1222 72%);-webkit-font-smoothing:antialiased}\n.board::before{content:\"\";position:absolute;left:0;right:0;top:0;height:.35em;background:linear-gradient(90deg,#ffd23f,#ff9a3c)}\n.osb-core-fields{display:none!important}\n.title{display:flex;flex-direction:column;align-items:center;gap:.3em;max-width:40em;text-transform:uppercase;text-align:center}\n.title .ev{max-width:100%;font-size:2.2em;font-weight:800;letter-spacing:.04em;line-height:1.05;white-space:normal;overflow-wrap:normal;hyphens:none;text-wrap:balance;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}\n.title .sub{display:flex;align-items:center;font-size:1.05em;font-weight:700;letter-spacing:.16em;color:#a9bbdd}\n.sub .sep{font-style:normal;padding:0 .6em}\n.sub .rd:empty+.sep,.sub .sep:has(+.bo:empty){display:none}\n.title:not(:has(.ev:not(:empty))) .ev{display:none}\n/* team tie strip */\n.tiebar{display:none;align-items:center;gap:.8em;width:40em;min-height:2.6em;padding:.2em 1em;border-radius:.35em;background:#13203a;box-shadow:inset 0 0 0 1px #2a3d63;font-weight:800;text-transform:uppercase;letter-spacing:.04em}\n.board:has(.tname:not(:empty)) .tiebar{display:flex}\n.tside{display:flex;align-items:center;gap:.5em;flex:1 1 0;min-width:0}\n.tb{justify-content:flex-end;text-align:right}\n.tlogo{width:1.5em;height:1.5em;object-fit:contain;flex:0 0 auto}\n.tname{min-width:0;white-space:normal;overflow-wrap:normal;hyphens:none;line-height:1.05}\n.tbox{display:flex;align-items:center;gap:.35em;flex:0 0 auto;height:1.8em;padding:0 .6em;border-radius:.25em;background:#ffd23f;color:#111;font-variant-numeric:tabular-nums}\n.tbox i{font-style:normal;letter-spacing:.12em;margin-right:.25em}\n.tbox .tscore{font-size:1.25em}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.table,.foot){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tiebar{font-size:1.4em;width:30em;min-height:3.4em}\n.tielbl{display:none;font-size:1.3em;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#a9bbdd}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tielbl{display:block}\n/* the line score */\n.table{display:flex;align-items:stretch;width:40em;background:#101b30;border-radius:.4em;overflow:hidden;box-shadow:0 .6em 2em rgba(0,0,0,.5),inset 0 0 0 1px #24365a}\n.hd{display:flex;align-items:center;justify-content:center;height:2em;background:#0a1222;color:#a9bbdd;font-size:1em;font-weight:800;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}\n.players{display:flex;flex-direction:column;flex:1 1 auto;min-width:15em}\n.ph{display:block;position:relative;width:100%}\n.ph>*{justify-content:flex-start;padding:0 1em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.ph:has(>.gtag[style*=\"opacity: 1\"]) .plbl,.ph:has(>.fin[style*=\"opacity: 1\"]) .plbl{opacity:0}\n.gtag{color:#ffd23f}\n.fin{color:#ffd23f}\n.row{display:flex;align-items:center;gap:.6em;height:4.6em;padding-right:.8em;min-width:0}\n.row+.row,.hc+.hc,.cell+.cell{border-top:1px solid #24365a}\n.kit{flex:0 0 .5em;align-self:stretch;background:#55647e}\n.flag{flex:0 0 auto;width:2.1em;height:1.4em;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.name{flex:1 1 auto;min-width:0;font-size:1.45em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;word-break:normal;hyphens:none}\n.marks{display:flex;align-items:center;gap:.3em;flex:0 0 auto}\n.to-slot{width:2.4em;height:1.45em}\n.to-on,.to-used{border-radius:.2em;font-size:1em;font-weight:900;letter-spacing:.03em}\n.to-on{background:#ffd23f;color:#111}\n.to-used{background:#2a3d63;color:#dfe7f6}\n.card-slot{width:1em;height:1.4em}\n.card{border-radius:.14em;box-shadow:0 0 0 1px rgba(0,0,0,.35);transform:rotate(-8deg)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.s2slot{width:1.25em;height:1.4em}\n.ss2{border-radius:.2em;background:#dfe7f6;color:#0a1222;font-size:1em;font-weight:900}\n.srv{width:1.5em;height:1.5em}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff9a3c 45%,#d65f00 100%);box-shadow:0 0 0 .12em rgba(0,0,0,.3),0 0 .6em rgba(255,154,60,.5)}\n.win{border-radius:50%;background:#ffd23f}\n.win::after{content:\"\";width:.38em;height:.7em;margin-top:-.14em;border:solid #111;border-width:0 .18em .18em 0;transform:rotate(45deg)}\n/* games in order; the one in play is the live column, its points the biggest numbers on screen */\n.hist{position:relative;display:flex}\n.hcol{display:flex;flex-direction:column;flex:0 0 auto;width:3.5em;border-left:1px solid #24365a}\n.hl{color:#a9bbdd}\n.hc{position:relative;display:flex;align-items:center;justify-content:center;height:calc(4.6em / 1.45);font-size:1.45em;font-weight:800;font-variant-numeric:tabular-nums;color:#8293b3}\n.hc .won{inset:.45em .35em;border-radius:.2em;background:#2a3d63}\n.hc:has(.won[style*=\"opacity: 1\"]){color:#fff}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])){width:6em;background:#ffd23f;border-left:0}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hl{background:#e8b900;color:#111}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hl::after{content:\"\\00a0·\\00a0live\"}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hc{font-size:2.7em;height:calc(4.6em / 2.7);color:#111}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hc+.hc{border-top-color:#e8b900}\n.gcol{display:flex;flex-direction:column;flex:0 0 auto;width:4.6em;background:#1a2a48;border-left:.25em solid #0a1222}\n.gcol .hd{background:#13203a;color:#fff}\n.cell{display:flex;align-items:center;justify-content:center;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;font-size:1.8em;height:calc(4.6em / 1.8)}\n.foot{display:flex;justify-content:center;height:2.6em}\n.banner{width:16em;height:2.6em}\n.bn{border-radius:.3em;font-size:1.2em;font-weight:800;letter-spacing:.14em;text-transform:uppercase}\n.bn-warm,.bn-break{background:#1a2a48;color:#fff;box-shadow:inset 0 0 0 .08em #3b5285}\n.bn-gp{background:#ff9a3c;color:#111}\n.bn-mp{background:#e3262f;color:#fff}\n/* final: the games total is the result; winner row lit, loser row steps back (still readable) */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gcol{width:6em;background:#ffd23f;color:#111;border-left-color:#0a1222}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gcol .hd{background:#e8b900;color:#111}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gcol .cell{font-size:2.7em;height:calc(4.6em / 2.7)}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.row.b,.gcol .b),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.row.a,.gcol .a){color:#8293b3}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .gcol .b,.board:has(.isBWinner[style*=\"opacity: 1\"]) .gcol .a{background:#1a2a48}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .row.b .flag,.board:has(.isBWinner[style*=\"opacity: 1\"]) .row.a .flag{opacity:.5}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .row.a,.board:has(.isBWinner[style*=\"opacity: 1\"]) .row.b{background:#16264a}\n\n</style>\n</head>\n<body>\n<main class=\"board t-line\" data-osb-component=\"layout\"><header class=\"title\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"sub\"><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span></header><span class=\"tielbl\">Team match</span><div class=\"tiebar\" data-osb-component=\"layout\"><span class=\"tside ta\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span></span><span class=\"tbox\"><i>Tie</i><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span><b>–</b><span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span><span class=\"tside tb\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"></span></div><div class=\"table\" data-osb-component=\"layout\"><div class=\"players\" data-osb-component=\"layout\"><span class=\"hd slot ph\"><span class=\"plbl\">Match</span><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\"><span class=\"now\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span> in play</span><span class=\"nx\">Game <span class=\"nextGame ng\" data-osb-component=\"field\" data-osb-field=\"nextGame\"></span> next</span></span><span class=\"isComplete fin\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final result</span></span><div class=\"row rA a\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></span><span class=\"slot s2slot isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><span class=\"isSecondServer ss2\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" style=\"opacity:0\" isa=\"true\">2</span></span><span class=\"slot srv\"><span class=\"isACurrentlyServing servingA ball\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity:0\" isa=\"true\"></span><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"></span></span></div><div class=\"row rB b\" data-osb-component=\"layout\"><span class=\"jerseyColorB kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isBTimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isBTimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T/O</span></span><span class=\"slot card-slot\"><span class=\"isBYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isBRedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></span><span class=\"slot s2slot isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><span class=\"isSecondServer ss2\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" style=\"opacity:0\">2</span></span><span class=\"slot srv\"><span class=\"isBCurrentlyServing servingB ball\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"></span><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\"></span></span></div></div><div class=\"hist\" data-osb-component=\"layout\"><div class=\"hcol isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"hd hl\">G1</span><span class=\"hc a\"><span class=\"isGame1AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame1BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1BScore gs\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"hcol isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"hd hl\">G2</span><span class=\"hc a\"><span class=\"isGame2AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame2BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2BScore gs\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"hcol isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"hd hl\">G3</span><span class=\"hc a\"><span class=\"isGame3AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></span><span class=\"game3AScore gs\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame3BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></span><span class=\"game3BScore gs\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"hcol isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"hd hl\">G4</span><span class=\"hc a\"><span class=\"isGame4AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></span><span class=\"game4AScore gs\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame4BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></span><span class=\"game4BScore gs\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"hcol isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"hd hl\">G5</span><span class=\"hc a\"><span class=\"isGame5AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></span><span class=\"game5AScore gs\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame5BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></span><span class=\"game5BScore gs\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"hcol isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"hd hl\">G6</span><span class=\"hc a\"><span class=\"isGame6AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame6AWon\" style=\"opacity:0\"></span><span class=\"game6AScore gs\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame6BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame6BWon\" style=\"opacity:0\"></span><span class=\"game6BScore gs\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"hcol isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"hd hl\">G7</span><span class=\"hc a\"><span class=\"isGame7AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame7AWon\" style=\"opacity:0\"></span><span class=\"game7AScore gs\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame7BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame7BWon\" style=\"opacity:0\"></span><span class=\"game7BScore gs\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div><div class=\"hcol isGame8Started\" data-osb-component=\"layout\" data-osb-field=\"isGame8Started\" style=\"display:none\"><span class=\"hd hl\">G8</span><span class=\"hc a\"><span class=\"isGame8AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame8AWon\" style=\"opacity:0\"></span><span class=\"game8AScore gs\" data-osb-component=\"field\" data-osb-field=\"game8AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame8BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame8BWon\" style=\"opacity:0\"></span><span class=\"game8BScore gs\" data-osb-component=\"field\" data-osb-field=\"game8BScore\">0</span></span></div><div class=\"hcol isGame9Started\" data-osb-component=\"layout\" data-osb-field=\"isGame9Started\" style=\"display:none\"><span class=\"hd hl\">G9</span><span class=\"hc a\"><span class=\"isGame9AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame9AWon\" style=\"opacity:0\"></span><span class=\"game9AScore gs\" data-osb-component=\"field\" data-osb-field=\"game9AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame9BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame9BWon\" style=\"opacity:0\"></span><span class=\"game9BScore gs\" data-osb-component=\"field\" data-osb-field=\"game9BScore\">0</span></span></div></div><div class=\"col gcol\" data-osb-component=\"layout\"><span class=\"hd\">Games</span><span class=\"cell a\"><span class=\"currentAMatchScore AScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"cell b\"><span class=\"currentBMatchScore BScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span></div></div><div class=\"foot\"><span class=\"slot banner\"><span class=\"isWarmUpStarted bn bn-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames bn bn-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isGamePoint bn bn-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint bn bn-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></div><div class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></main>\n</body>\n</html>\n","css":""}
