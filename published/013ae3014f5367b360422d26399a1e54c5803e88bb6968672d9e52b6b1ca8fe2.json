{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Final Line Score</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.teamAName:empty::before{content:\"Team A\"}.teamBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}\n.slab{position:relative;flex:none;overflow:hidden}.slab>.jc{position:absolute;inset:0}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.74)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.25);height:calc(var(--d,3rem)*.25);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:37.5%;top:calc(var(--d,3rem)*.06)}.diamond>.base.third{left:7%;top:calc(var(--d,3rem)*.39)}.diamond>.base.first{left:68%;top:calc(var(--d,3rem)*.39)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.diamond>.base:has(>.runner[style*=\"opacity: 1\"]){border-color:var(--base-on,#f5cf52);box-shadow:0 0 calc(var(--d,3rem)*.1) var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.25rem)}\n.dot{position:relative;flex:none;width:var(--dot,.82rem);height:var(--dot,.82rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18))}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.st{position:relative;display:inline-grid;align-items:center;white-space:nowrap}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.45em}.st-live-in>i{flex:none;width:.9rem;height:.9rem;border-radius:50%;background:var(--live,#ff3b30);box-shadow:0 0 .45rem var(--live,#ff3b30);animation:osb-pulse 1.4s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.7}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ls{display:flex}\n.ls-col{position:relative}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.ls-gate{display:flex;flex-direction:column;position:relative}\n.ls-cur{position:absolute;inset:0;pointer-events:none}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff;background:transparent;--live:#e5262d;--optic:#d4f53c;--violet:#22175a;--deep:#170f40;--row:#2a1f66;--ink:#1d1638;--mute:#cfc8ee;--line:rgba(255,255,255,.1)}\n.sb{width:62rem;display:grid;grid-template-columns:minmax(0,1fr) 17rem;grid-template-rows:auto auto;gap:1rem 1.2rem;padding:1.3rem 1.6rem 1.6rem;border-radius:1rem;background:var(--violet);box-shadow:0 .8rem 2.2rem rgba(0,0,0,.4)}\n.top{grid-column:1 / -1;display:flex;align-items:center;gap:1rem;min-width:0}\n.tag{flex:none;padding:.45rem .9rem;border-radius:2rem;background:var(--optic);color:var(--ink);font:700 1.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.2em}\n.ev{display:flex;flex-direction:column;justify-content:center;gap:.2rem;flex:1;min-width:0;text-transform:uppercase}\n.ev-e{font:700 1.45rem/1.1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.06em;color:#fff;overflow-wrap:normal;hyphens:none}.ev-r{font:700 1.15rem/1.1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.12em;color:var(--mute)}\n.ev>.sep{display:none}\n.ev-e:empty,.ev-r:empty,.ev-e:empty+.sep,.sep:has(+.ev-r:empty){display:none}\n.sep{flex:none;font-style:normal;opacity:.8}\n.badge{flex:none;display:grid;align-items:center;justify-items:end}\n.badge>*{grid-area:1/1}\n.badge .st{justify-items:end;font:700 1.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em}\n.badge .st-pre{padding:.45rem .9rem;border-radius:2rem;box-shadow:inset 0 0 0 .14rem rgba(255,255,255,.55);color:#fff}\n.badge .st-live{padding:.45rem .95rem;border-radius:2rem;background:#fff;color:var(--ink)}\n.badge .isComplete{padding:.45rem 1rem;border-radius:2rem;background:var(--optic);color:var(--ink);font:700 1.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.18em}\n/* the scorebook */\n.book{display:flex;flex-direction:column;border-radius:.6rem;overflow:hidden;background:var(--deep);--lab:4rem}\n.thead,.rrow,.herow{display:flex}\n.corner,.rl,.hl{flex:none;width:var(--lab);display:flex;align-items:center;justify-content:center;font:700 1.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;color:var(--mute)}\n.th{position:relative;flex:1;min-width:0;display:flex;flex-direction:column;justify-content:flex-end;gap:.35rem;height:6.6rem;padding:.5rem .9rem .7rem;background:var(--row);border-left:.1rem solid var(--line)}\n.th>.slab{position:absolute;left:0;right:0;top:0;height:.55rem;width:auto}\n.slab{background:var(--fb)}.slab-a{--fb:#4f7be0}.slab-b{--fb:#e0583a}\n.krow{display:flex;align-items:center;justify-content:space-between;gap:.5rem;min-height:1.9rem}\n.kk{display:grid;font:700 1.15rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--mute)}.kk>*{grid-area:1/1}\n.kk>.kv{opacity:0}\n.book:has(.isBHome[style*=\"opacity: 1\"]) .th-a .kv,.book:has(.isAHome[style*=\"opacity: 1\"]) .th-b .kv{opacity:1}\n.batw{display:grid;place-items:center end}.batw>*{grid-area:1/1}\n.bat,.wtag{display:flex;align-items:center;gap:.35rem;padding:.35rem .6rem;border-radius:2rem;background:var(--optic);color:var(--ink);font:700 1.05rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}\n.bat::before{content:\"\";width:.6rem;height:.6rem;border-radius:50%;background:var(--ink)}\n.nm{font:700 1.8rem/1.02 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.01em}\n.rrow{height:4.4rem;border-top:.1rem solid var(--line)}\n.rl{color:var(--optic);font-size:1.6rem}\n.rt{position:relative;flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;border-left:.1rem solid var(--deep)}\n.rt>.slab{position:absolute;inset:0;width:auto}\n.rt::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(0,0,0,.24))}\n.runs{position:relative;z-index:1;font:700 3.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;color:#fff;text-shadow:0 .1rem .4rem rgba(0,0,0,.45)}\n.rt>.win{position:absolute;inset:0;z-index:2;box-shadow:inset 0 0 0 .4rem var(--optic)}\n.ls{display:flex;flex-direction:column}\n.ls-col{display:flex;height:2.1rem;border-top:.07rem solid var(--line)}\n.ls-h{flex:none;width:var(--lab);display:flex;align-items:center;justify-content:center;font:700 1.25rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;color:var(--mute)}\n.ls-gate{flex:1;flex-direction:row!important}\n.ls-c{flex:1;display:flex;align-items:center;justify-content:center;border-left:.1rem solid var(--line);font:700 1.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.ls-cur{background:rgba(212,245,60,.14)}\n.ls-col:has(>.ls-cur[style*=\"opacity: 1\"])>.ls-h{background:var(--optic);color:var(--ink)}\n.ls-extra>.ls-h{color:#fff;box-shadow:inset .3rem 0 0 #8f7ff0}\n.herow{height:2.4rem;border-top:.18rem solid var(--violet)}\n.v{flex:1;display:flex;align-items:center;justify-content:center;border-left:.1rem solid var(--line);font:700 1.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;color:#ece8fb}\n/* final: winner's runs outlined optic, loser's column steps back */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .book:has(.isAWinner[style*=\"opacity: 1\"]) :is(.th-b,.rt-b),.board:has(.isComplete[style*=\"opacity: 1\"]) .book:has(.isBWinner[style*=\"opacity: 1\"]) :is(.th-a,.rt-a){opacity:.5}\n.book:has(.isAWinner[style*=\"opacity: 1\"]) :is(.ls-c:nth-child(2 of .ls-c),.vb),.book:has(.isBWinner[style*=\"opacity: 1\"]) :is(.ls-c:nth-child(1 of .ls-c),.va){color:#9d96c2}\n/* side column: the situation while live, otherwise the state */\n.side{position:relative;display:grid;grid-template-rows:repeat(4,1fr);gap:.55rem;min-height:0}\n.z{display:flex;align-items:center;justify-content:space-between;gap:.6rem;min-width:0;padding:0 1rem;border-radius:.55rem;background:var(--row)}\n.zl{font:700 1.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--mute)}\n.zv{display:flex;align-items:center;justify-content:flex-end;gap:.6rem}\n.inn{display:flex;align-items:center;gap:.25rem;font:700 2.8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;--half-on:var(--optic);--half-off:rgba(255,255,255,.2);--half-h:2.8rem;--half-size:1.2rem}\n.inn-n{min-width:1.1em;text-align:left}\n.diamond{--d:5.6rem;--base-edge:rgba(236,233,251,.55);--base-off:rgba(255,255,255,.04);--base-on:var(--optic);--base-line:.16rem}\n.count{font:700 2.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}.count .dash{opacity:.6;margin:0 .06em}\n.bs{display:flex;flex-direction:column;gap:.3rem;--dot:1.1rem;--dot-gap:.25rem;--dot-off:rgba(255,255,255,.18)}\n.bs>span{display:flex;align-items:center;gap:.35rem;font:700 1.15rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;color:#ece8fb}.bs b{width:1rem}\n.ball-dots{--dot-on:#3fe08a}.strike-dots{--dot-on:#ff5a52}\n.out-dots{--dot:1.7rem;--dot-gap:.5rem;--dot-off:rgba(255,255,255,.18);--dot-on:var(--optic)}\n.st8{position:absolute;inset:0;z-index:2;display:none;flex-direction:column;align-items:center;justify-content:center;gap:1rem;padding:1rem;border-radius:.55rem;background:var(--row);text-align:center;font:700 3.6rem/.95 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.02em;text-transform:uppercase}\n.board:has(.st-live[style*=\"opacity: 0\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .c-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .c-fin{display:flex}.brk{display:flex;z-index:3}\n.st8 small{font:700 1.3rem/1.2 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.18em;color:var(--mute)}.st8 small b{color:var(--optic)}\n.brk .chip{padding:.5rem 1rem;border-radius:2rem;background:var(--optic);color:var(--ink);font:700 1.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em}\n.c-fin{z-index:4}.c-fin .fw{color:var(--optic)}\n</style></head><body><main class=\"board\" aria-label=\"Softball full-screen scoreboard\">\n<section class=\"sb columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scorebook\">\n<div class=\"top\"><span class=\"tag\">SOFTBALL</span><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">·</i><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"badge\"><span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span></span><span class=\"isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\">FINAL</span></span></div>\n<div class=\"book\"><span class=\"thead\"><span class=\"corner\">INN</span><span class=\"th th-a\"><span class=\"slab slab-a\"><span class=\"jc jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><span class=\"krow\"><span class=\"kk\"><span class=\"kv\">Away</span><span class=\"hm isAHome\" data-osb-component=\"field\" data-osb-field=\"isAHome\" style=\"opacity: 0\">Home</span></span><span class=\"batw\"><span class=\"bat isABatting\" data-osb-component=\"field\" data-osb-field=\"isABatting\" style=\"opacity: 0\">At bat</span><span class=\"wtag isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0\">Win</span></span></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"th th-b\"><span class=\"slab slab-b\"><span class=\"jc jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><span class=\"krow\"><span class=\"kk\"><span class=\"kv\">Away</span><span class=\"hm isBHome\" data-osb-component=\"field\" data-osb-field=\"isBHome\" style=\"opacity: 0\">Home</span></span><span class=\"batw\"><span class=\"bat isBBatting\" data-osb-component=\"field\" data-osb-field=\"isBBatting\" style=\"opacity: 0\">At bat</span><span class=\"wtag isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0\">Win</span></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span></span><span class=\"rrow\"><span class=\"rl\">R</span><span class=\"rt rt-a\"><span class=\"slab slab-a\"><span class=\"jc jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><span class=\"runs currentAGameScore\" data-