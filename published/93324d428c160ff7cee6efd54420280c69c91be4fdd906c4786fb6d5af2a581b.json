{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Table Green</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\nhtml,body{height:100%;overflow:hidden}\n.osb-core-fields{display:none!important}\n.end[data-osb-resolved-court-side=\"A\"] .isBWinner,.end[data-osb-resolved-court-side=\"B\"] .isAWinner,.end:not([data-osb-resolved-court-side]) :is(.isAWinner,.isBWinner){display:none!important}\n.hg:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;padding:0!important;margin:0!important;border:0!important}\n.hg .won{display:none}\n.name{overflow-wrap:normal;word-break:normal;hyphens:none}\n/* status chips flow: an empty chip takes no room, so both ends keep the same packed order */\n.to-slot:not(:has(>[style*=\"opacity: 1\"])),.card:not([style*=\"opacity: 1\"]){display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .big{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n\n.board{position:fixed;inset:0;display:flex;flex-direction:column;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:transparent;-webkit-font-smoothing:antialiased;overflow:hidden}\n.bar{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:2vw;flex:0 0 14vh;padding:0 2.4vw;background:#08140f}\n.info{display:flex;flex-direction:column;justify-content:center;gap:.6vh;min-width:0;text-transform:uppercase;white-space:nowrap}\n.info>*{overflow:hidden;text-overflow:ellipsis}\n.ev{font-size:4.6vh;font-weight:800;letter-spacing:.06em}\n.rd{font-size:3.4vh;font-weight:700;letter-spacing:.08em;color:#bfe0cf}\n.rd:empty{display:none}\n.teamlbl{display:none;font-size:4vh;font-weight:800;letter-spacing:.08em}\n.info:not(:has(.ev:not(:empty))):not(:has(.rd:not(:empty))) .teamlbl{display:block}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.tagslot{width:33vh;height:9vh}\n.tagslot>*{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.gtag{background:#fff;color:#0b3d2a}\n.pre{box-shadow:inset 0 0 0 .4vh #2d6b4f;color:#bfe0cf}\n.tagslot:has(>.gtag[style*=\"opacity: 1\"]) .pre,.tagslot:has(>.fin[style*=\"opacity: 1\"]) .pre{opacity:0}\n.fin{background:#ffd23f;color:#111}\n.right{display:flex;align-items:center;justify-content:flex-end;gap:1vw;min-width:0}\n.chip{width:21vh;height:6vh}\n.fl{border-radius:.7vh;font-size:2.7vh;font-weight:800;letter-spacing:.06em;text-transform:uppercase;box-shadow:inset 0 0 0 .3vh #9cc9b2;color:#e7f5ee}\n.banner{width:40vh;height:9vh}\n.bn{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.bn-warm,.bn-break{box-shadow:inset 0 0 0 .5vh #fff;color:#fff}\n.bn-gp{background:#ff8a1c;color:#111}\n.bn-mp{background:#e3262f;color:#fff}\n.banner>.bo{justify-content:flex-end;font-size:4.2vh;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#bfe0cf}\n.board:not(:has(.isMatchStarted[style*=\"opacity: 1\"])) .banner:has(>.isWarmUpStarted[style*=\"opacity: 1\"])>.bo,\n.board:not(:has(.isComplete[style*=\"opacity: 1\"])) .banner:has(>:is(.isInBetweenGames,.isGamePoint,.isMatchPoint)[style*=\"opacity: 1\"])>.bo{opacity:0}\n.table{display:flex;flex:1 1 auto;min-height:0;margin:2.4vh 2.4vw 3vh;border:1vh solid #f4f4ef;border-radius:.6vh;background:#13623f;box-shadow:0 1vh 3vh rgba(0,0,0,.45)}\n.net{flex:0 0 1.2vw;background:repeating-linear-gradient(0deg,#1c1c1c 0 .6vh,#3b3b3b .6vh 1.2vh);box-shadow:inset .25vw 0 0 #f4f4ef,inset -.25vw 0 0 #f4f4ef}\n.end{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:auto 17vh minmax(0,1fr) 7vh;grid-template-areas:\"band band\" \"gw who\" \"pts pts\" \"hist hist\";row-gap:0;flex:1 1 0;min-width:0;padding:2.6vh 2vw 3.4vh}\n.eB{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:\"band band\" \"who gw\" \"pts pts\" \"hist hist\"}\n.kit{position:absolute;left:0;right:0;bottom:0;height:1.2vh;background:#7aa08d}\n.tband{grid-area:band;display:none;align-items:center;gap:1.2vw;margin-bottom:1.6vh;padding:0 1.4vw;min-height:7vh;border-radius:.8vh;background:#0b3d2a;font-size:3.4vh;font-weight:800;letter-spacing:.05em;text-transform:uppercase}\n.eB .tband{flex-direction:row-reverse;text-align:right}\n.board:has(.tname:not(:empty)) .tband{display:flex}\n.tband .tlogo{width:5vh;height:5vh;object-fit:contain;flex:0 0 auto}\n.tband .tname{flex:1 1 auto;min-width:0;line-height:1.05;overflow-wrap:normal;hyphens:none}\n.tband .tie{display:inline-flex;align-items:center;gap:1vw;flex:0 0 auto;height:5.2vh;padding:0 1.2vw;border-radius:.6vh;background:#f4f4ef;color:#0b3d2a}\n.tband .tie i{font-style:normal;font-size:2.8vh;letter-spacing:.14em}\n.tband .tscore{font-size:4.2vh;font-variant-numeric:tabular-nums}\n/* GAMES box at the outer corner */\n.gw{grid-area:gw;align-self:start;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.4vh;width:16vh;height:15vh;border:.5vh solid #f4f4ef;border-radius:1vh;font-weight:900;text-transform:uppercase}\n.gw i{font-style:normal;font-size:2.6vh;letter-spacing:.18em;line-height:1;color:#d8eee2}\n.gn{font-size:9vh;line-height:.9;font-variant-numeric:tabular-nums}\n/* identity: flag + name on top, the player's own status line under it, serve ball on the inner side */\n.who{grid-area:who;display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:minmax(0,1fr) 5.8vh;grid-template-areas:\"flag name\" \"marks marks\";column-gap:1.2vw;row-gap:1vh;align-items:center;min-width:0;height:15vh;padding:0 0 0 1.6vw}\n.eB .who{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:\"name flag\" \"marks marks\";padding:0 1.6vw 0 0}\n.flag{grid-area:flag;width:7vh;height:4.7vh;object-fit:cover;border-radius:.4vh;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.nm{grid-area:name;min-width:0}\n.eB .nm{text-align:right}\n.name{display:block;font-size:4.8vh;line-height:1.02;font-weight:800;text-transform:uppercase}\n.pts{position:relative}\n.ss{position:absolute;top:50%;width:8vh;height:8vh;margin-top:-4vh}\n.eA .ss{right:0}\n.eB .ss{left:0}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .5vh rgba(0,0,0,.25),0 0 3vh rgba(255,138,28,.5)}\n.marks{grid-area:marks;display:flex;align-items:center;gap:.8vw;min-width:0;height:5.8vh}\n.eB .marks{justify-content:flex-end}\n.to-slot{width:14vh;height:5.4vh}\n.to-on,.to-used{border-radius:.6vh;font-size:2.6vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.to-on{background:#ffd23f;color:#111}\n.to-used{background:#0b3d2a;color:#e7f5ee}\n.card{display:inline-flex;align-items:center;gap:.7vw;height:5.4vh;padding:0 1.3vw 0 .9vw;border-radius:.6vh;font-size:2.6vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase;background:#0b3d2a;color:#fff;white-space:nowrap}\n.card b{flex:0 0 auto;width:2.6vh;height:3.6vh;border-radius:.4vh;box-shadow:0 0 0 .25vh rgba(0,0,0,.35)}\n.yc b{background:#ffd400}.rc b{background:#e3262f}\n.win{display:none;align-items:center;height:5.4vh;padding:0 1.4vw;border-radius:.6vh;background:#ffd23f;color:#111;font-size:2.8vh;font-weight:900;letter-spacing:.16em;text-transform:uppercase}\n.win[style*=\"opacity: 1\"]{display:inline-flex}\n.pts{grid-area:pts;display:flex;align-items:center;justify-content:center;min-height:0}\n.big{font-size:46vh;line-height:.78;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em;text-shadow:0 1vh 2.4vh rgba(0,0,0,.25)}\n/* finished games along the outer baseline, mirrored */\n.hist{grid-area:hist;position:relative;display:flex;align-items:center;gap:.6vw}\n.eB .hist{justify-content:flex-end}\n.hg{display:flex;align-items:center;gap:.5vw;height:6.4vh;padding:0 .9vw;border-radius:.8vh;font-weight:800;font-variant-numeric:tabular-nums;background:#0b3d2a;color:#cfe6da}\n.hl{font-style:normal;font-size:2.8vh;letter-spacing:.08em}\n.gs{font-size:4.2vh}\n.end[data-osb-resolved-court-side=\"A\"] .hg:has(.wA[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"] .hg:has(.wB[style*=\"opacity: 1\"]){background:#f4f4ef;color:#0b3d2a}\n/* team tie */\n.board:has(.tname:not(:empty)) .big{font-size:38vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.who,.gw,.pts,.hist,.bar){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband,.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .eB .tband{grid-row:1 / -1;grid-column:1 / -1;flex-direction:column;justify-content:center;gap:5vh;margin:4vh 2vw;background:none;font-size:7vh;text-align:center}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tlogo{width:14vh;height:14vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tname{flex:0 0 auto}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie{height:auto;padding:2vh 4vw;border-radius:1.6vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tscore{font-size:22vh;line-height:.9}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie i{font-size:4vh}\n/* final: games won is the big number, .board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]NER opens the winner's status line */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .end{grid-template-areas:\"band band\" \"who who\" \"pts pts\" \"hist hist\"}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .eA .who{padding-left:0}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .eB .who{padding-right:0}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{grid-area:pts;align-self:center;justify-self:center;flex-direction:column-reverse;width:auto;height:auto;border:0;gap:2vh}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{font-size:40vh;line-height:.8}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw i{font-size:4.2vh}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]){box-shadow:inset 0 0 0 .8vh #ffd23f}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]) .gn{color:#ffd23f}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]){background:#0d3f29}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) :is(.gn,.name,.gw i){color:#a9cbb9}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) .flag{opacity:.55}\n</style>\n</head>\n<body>\n<main class=\"board t-green\" data-osb-component=\"layout\"><div class=\"bar\" data-osb-component=\"layout\"><span class=\"info\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><span class=\"teamlbl\">Team match</span></span><span class=\"slot tagslot\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\"><span class=\"now\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"nx\">Game <span class=\"nextGame ng\" data-osb-component=\"field\" data-osb-field=\"nextGame\"></span> next</span></span><span class=\"isComplete fin\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span><span class=\"pre\">Pre-match</span></span><span class=\"right\"><span class=\"slot chip\"><span class=\"isCourtSideScoreboardFlipped fl\" data-osb-component=\"field\" data-osb-field=\"isCourtSideScoreboardFlipped\" style=\"opacity:0\">View flipped</span></span><span class=\"slot banner\"><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span><span class=\"isWarmUpStarted bn bn-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames bn bn-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Change ends</span><span class=\"isGamePoint bn bn-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint bn bn-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></span></div><div class=\"table\" data-osb-component=\"layout\"><div class=\"courtSideAView end eA\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"tband\" data-osb-component=\"layout\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tie\"><i>Tie</i><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></div><span class=\"gw\"><i>Games</i><span class=\"courtSideAMatchScore gn\" data-osb-component=\"field\" data-osb-field=\"courtSideAMatchScore\">0</span></span><div class=\"who\" data-osb-component=\"layout\"><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nm\"><span class=\"courtSideCombinedAName name\" data-osb-component=\"field\" data-osb-field=\"courtSideCombinedAName\"></span></span><span class=\"marks\" data-osb-component=\"layout\"><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\">Winner</span><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\">Winner</span><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">Time-out</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"><b></b>Yellow</span><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"><b></b>Red</span></span></div><div class=\"pts\" data-osb-component=\"layout\"><span class=\"courtSideAGameScore big\" data-osb-component=\"field\" data-osb-field=\"courtSideAGameScore\">0</span><span class=\"slot ss\"><span class=\"courtSideIsACurrentlyServing ball\" data-osb-component=\"field\" data-osb-field=\"courtSideIsACurrentlyServing\" style=\"opacity:0\"></span></span></div><div class=\"hist\" data-osb-component=\"layout\"><span class=\"hg isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><i class=\"hl\">G1</i><span class=\"isGame1AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"isGame1BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hg isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><i class=\"hl\">G2</i><span class=\"isGame2AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"isGame2BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hg isGame3Started\" data-osb-c