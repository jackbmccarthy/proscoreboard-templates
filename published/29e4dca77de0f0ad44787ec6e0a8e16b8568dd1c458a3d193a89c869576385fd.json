rem;font-size:1.7rem;font-weight:700;letter-spacing:.06em;background:#123528;color:#c6f432}\n.sslot .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;margin-left:.4rem}.sslot>.swarm{background:#fbbf24;color:#123528}.sslot>.sbrk{background:#fff;color:#123528}.sslot>.sfin{background:#fff;color:#123528}\n.sslot>.gp{background:#c6f432;color:#123528}.sslot>.mp{background:#ef4444;color:#fff}\n.cbox{position:relative;z-index:1;flex:1;display:flex;align-items:center;justify-content:center;padding-top:.3rem}\n.call{padding:.3rem 1rem 0;border-radius:.3rem;background:#123528;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3rem;font-weight:700;gap:.15rem;color:#fff}\n.tob{position:absolute;bottom:100%;display:flex;align-items:center;gap:.6rem;height:3.2rem;padding:.2rem 1.1rem 0;background:#c6f432;color:#123528;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;font-size:1.9rem;letter-spacing:.06em;white-space:nowrap;border-radius:.4rem .4rem 0 0}.sA .tob{left:0}.sB .tob{right:0}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.3rem}\n.htab{display:flex;justify-content:center;height:3.2rem;padding:0 .6rem;background:#123528;border-radius:0 0 .6rem .6rem}\n.hist{display:flex;align-items:stretch}\n.hc{display:flex;align-items:center;gap:.3rem;padding:.2rem .9rem 0;font-size:1.6rem}.hc+.hc{border-left:.1rem solid #ffffff1c}\n.hc .hl{font-weight:700;color:#9fcfb7;margin-right:.3rem}.hc .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:1.9rem}.hc .hd{font-style:normal;color:#9fcfb7}\n.board:not(:has(.isGame2Started[style*=\"opacity: 1\"])):not(:has(.isInBetweenGames[style*=\"opacity: 1\"])) .hta