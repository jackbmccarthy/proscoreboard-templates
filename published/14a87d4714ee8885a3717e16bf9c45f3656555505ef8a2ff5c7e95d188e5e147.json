{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Stone Ink Lead Bay 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(94vw,1121px);max-width:100%;aspect-ratio:3.51;overflow:hidden;border:2px solid #b4bfbb;border-radius:7px;background:#e9e7e1;color:#263741;container-type:inline-size}\n.teams{display:flex;flex:1 1 0;min-height:0;flex-direction:column}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0;min-width:0}\n.team+.team{border-top:2px solid #b4bfbb}\n.bay{display:flex;align-items:stretch;flex:0 0 12.8%;min-width:0;flex-direction:column;background:#263741;color:#f7f7f4;font-variant-numeric:tabular-nums}\n.primary,.secondary{display:flex;align-items:center;justify-content:center;min-height:0;flex-direction:column;white-space:nowrap}\n.primary{flex:0 0 62%;padding-top:4px}\n.secondary{flex:1 1 0}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(30px,4.7cqw,54px);font-weight:800;line-height:1;text-align:center}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(18px,2.2cqw,27px);font-weight:700;line-height:1;text-align:center}\n.label{display:block;max-width:100%;overflow:hidden;font-size:clamp(9px,1.35cqw,16px);font-weight:750;line-height:1}\n.identity{display:block;flex:0 0 23px;align-self:stretch;background:#3989ee}\n.jerseyColorB{background:#f26168}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 32px;color:#11191c;font-size:clamp(27px,5.1cqw,64px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.utility{display:flex;align-items:center;justify-content:space-between;flex:0 0 22.5%;min-width:0;padding:0 30px;border-top:2px solid #b4bfbb;font-size:clamp(17px,2.4cqw,30px);font-weight:700;line-height:1;white-space:nowrap}\n.sport-tag{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.set-status{display:flex;align-items:center;align-self:stretch;gap:.3em;padding-left:35px;border-left:2px solid #b4bfbb}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:7px}\n .board{width:100%;height:206px;aspect-ratio:auto;border-width:1px;border-radius:3px}\n .team+.team,.utility{border-width:1px}\n .bay{flex-basis:19%}\n .score{font-size:clamp(26px,7.5cqw,35px)}\n .set-score{font-size:clamp(15px,4.2cqw,20px)}\n .label{font-size:clamp(8px,2.3cqw,11px)}\n .identity{flex-basis:5px}\n .name{padding:0 8px;font-size:clamp(17px,5.2cqw,24px)}\n .utility{padding:0 8px;font-size:clamp(11px,3.1cqw,15px)}\n .set-status{padding-left:9px;border-width:1px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"primary\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label\" data-osb-component=\"text\">POINTS</span></div><div class=\"secondary\" data-osb-component=\"layout\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"label\" data-osb-component=\"text\">SETS</span></div></div><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"primary\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label\" data-osb-component=\"text\">POINTS</span></div><div class=\"secondary\" data-osb-component=\"layout\"><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"label\" data-osb-component=\"text\">SETS</span></div></div><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div>\n  </div>\n  <div class=\"utility rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
