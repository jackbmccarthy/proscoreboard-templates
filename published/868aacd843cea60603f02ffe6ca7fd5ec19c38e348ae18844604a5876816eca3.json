{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pearl Ledger Side Index — Basketball horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:6px}.board{width:min(81vw,1460px);aspect-ratio:5.35;display:flex;overflow:hidden;border:2px solid #a7b7b4;border-radius:6px;background:#e9eeeb;color:#24373c;container-type:inline-size;font-variant-numeric:tabular-nums}.index{flex:0 0 19.2%;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:2%;padding:1.5%;border-right:2px solid #a7b7b4;background:transparent}.sport-tag{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:3cqw;font-weight:800;line-height:1.1}.index-rule{display:none}.stat{display:flex;align-items:baseline;gap:.48em;min-width:0;white-space:nowrap;font-size:1.95cqw;font-weight:600;line-height:1.2}.stat-value{font-size:1.55em;font-weight:800;font-variant-numeric:tabular-nums}.teams{display:flex;flex:1 1 0;min-width:0;flex-direction:column}.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0}.team+.team{border-top:2px solid #a7b7b4}.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;gap:4%;padding:0 1%}.identity{flex:none;width:1.7%;height:90%;background:#2178d8}.jerseyColorB{background:#f35760}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:5.5cqw;font-weight:750;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.support{display:flex;flex:0 0 14%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:1%;background:transparent}.support-label,.primary-label{font-size:1.75cqw;font-weight:650;line-height:1}.support-value{font-size:3.5cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.primary{position:relative;display:flex;flex:0 0 18.5%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:1%;background:transparent}.primary:before{content:\"\";position:absolute;left:0;top:17%;height:66%;width:2px;background:#a7b7b4}.score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:6.7cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;height:165px;aspect-ratio:auto;border-width:1px;border-radius:3px}.index{flex-basis:19%;border-width:1px;padding:3px;gap:4px}.sport-tag{font-size:2.35cqw}.stat{font-size:1.85cqw;gap:2px}.stat-value{font-size:1.25em}.team+.team{border-width:1px}.identity{width:4px}.name{font-size:5cqw}.support{flex-basis:16%}.support-label,.primary-label{font-size:2cqw}.support-value{font-size:4cqw}.primary{flex-basis:22%}.primary:before{width:1px}.score{font-size:6.5cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(98vw,1920px);aspect-ratio:8.5}.index{flex-basis:17%}.sport-tag{font-size:1.9cqw}.stat{font-size:1.65cqw}.teams{flex-direction:row}.team{min-width:0}.team+.team{border-top:0;border-left:2px solid #a7b7b4}.name-lane{gap:4%;padding:0 2%}.identity{width:2.5%;height:66%}.name{font-size:4.1cqw}.support{flex-basis:16%}.support-label,.primary-label{font-size:1.35cqw}.support-value{font-size:3.5cqw}.primary{flex-basis:23%}.score{font-size:6cqw}@media(max-width:520px){.board{width:100%;height:150px;aspect-ratio:auto}.index{flex-basis:18%}.sport-tag{font-size:2.35cqw}.stat{font-size:1.85cqw}.team+.team{border-width:1px}.identity{width:4px}.name{font-size:4cqw}.support{flex-basis:18%}.support-label,.primary-label{font-size:1.85cqw}.support-value{font-size:5cqw}.primary{flex-basis:25%}.score{font-size:5.6cqw}}\n.index{padding:.5% 1.5%;justify-content:space-evenly;gap:0}.stat{font-size:1.55cqw}.stat-value{font-size:1.3em}.score{font-size:5.3cqw}@media(max-width:520px){.index{padding:3px}.stat{font-size:1.85cqw}.stat-value{font-size:1.25em}.score{font-size:5.6cqw}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Basketball scoreboard\"><aside class=\"index columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport-tag\" data-osb-component=\"text\">BASKETBALL</span><span class=\"index-rule\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">PERIOD</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"period\" data-osb-static=\"true\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SHOT</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"shot\" data-osb-static=\"true\">00</span></div></aside><div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsA\" data-osb-static=\"true\">0</span></div><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsB\" data-osb-static=\"true\">0</span></div><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
