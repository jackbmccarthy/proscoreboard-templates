{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Champagne Graphite Columnrail Volleyball — Rows</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { font-family: Arial, Helvetica, sans-serif; color: #f7f5f0; }\n    .stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n    .board { width: min(100%, 1400px); background: #2b3036; }\n    .header { height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 30px; background: #d8c9ae; color: #2b3036; font-weight: 700; text-transform: uppercase; }\n    .sport { font-size: 38px; line-height: 1; letter-spacing: .015em; }\n    .status { height: 44px; min-width: 185px; display: flex; align-items: center; justify-content: flex-end; gap: 20px; border-left: 1px solid #2b3036; font-size: 30px; white-space: nowrap; }\n    .set-number { font-variant-numeric: tabular-nums; }\n    .lanes { display: flex; flex-direction: column; }\n    .lane { min-height: 132px; display: grid; grid-template-columns: 30px minmax(0, 1fr) minmax(124px, 17%) minmax(148px, 19%); align-items: stretch; }\n    .lane + .lane { border-top: 1px solid #67737b; }\n    .tick { min-width: 0; }\n    .tick-a { background: #2b8aa8; }\n    .tick-b { background: #d06461; }\n    .name { min-width: 0; display: block; align-self: center; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0 34px; font-size: clamp(24px, 5.1vw, 72px); font-weight: 700; line-height: 1.1; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .stat { min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border-left: 1px solid #67737b; font-variant-numeric: tabular-nums; }\n    .value { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: .95; font-weight: 700; }\n    .sets .value { font-size: clamp(30px, 4.4vw, 64px); }\n    .points .value { font-size: clamp(44px, 6vw, 88px); }\n    .caption { margin-top: 10px; color: #c9c0b0; font-size: 16px; font-weight: 700; line-height: 1; text-transform: uppercase; }\n    .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    @media (max-width: 700px) {\n      .stage { padding: 12px; }\n      .header { height: 44px; padding: 0 14px; gap: 10px; }\n      .sport { font-size: clamp(16px, 5vw, 24px); }\n      .status { height: 27px; min-width: 82px; gap: 7px; padding-left: 10px; font-size: 16px; }\n      .lane { min-height: 78px; grid-template-columns: 8px minmax(0, 1fr) 57px 69px; }\n      .name { padding: 0 9px; font-size: clamp(15px, 5vw, 21px); }\n      .sets .value { font-size: 25px; }\n      .points .value { font-size: 38px; }\n      .caption { margin-top: 6px; font-size: 9px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport sport-tag\">VOLLEYBALL</span><span class=\"status\">SET <span class=\"set-number\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></span></header>\n      <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick tick-a jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"stat sets support\"><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">SETS</span></span><span class=\"stat points primary\"><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></span></div>\n        <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick tick-b jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"stat sets support\"><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">SETS</span></span><span class=\"stat points primary\"><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></span></div>\n      </div>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
