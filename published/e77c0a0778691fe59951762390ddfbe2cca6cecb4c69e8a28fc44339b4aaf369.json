{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Varsity Card</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px 28px 28px; font-family: \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif; }\n    .osb { position: relative; width: 530px; border-radius: 8px; overflow: hidden; background: #fbf8f0; color: #10241c; box-shadow: 0 8px 22px #0009; }\n    .ev { display: flex; justify-content: space-between; gap: 14px; padding: 7px 14px 6px; background: #0f3b2e; color: #f3e3b5; font-size: 14px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; white-space: nowrap; }\n    .ev .eventName { min-width: 0; overflow: hidden; text-overflow: ellipsis; }\n    .ev .matchRound { flex: none; }\n    .ev .matchRound { color: #e2b23a; }\n    .row { position: relative; display: grid; grid-template-columns: 12px 22px minmax(0, 1fr) 132px 76px; align-items: center; height: 58px; }\n    .row + .row { border-top: 1px solid #e3dccb; }\n    .kitw { align-self: stretch; display: flex; background: #9aa7a0; }\n    .row.b .kitw { background: #3e4d46; }\n    .kit { flex: 1; background-color: transparent; }\n    .poss { display: flex; justify-content: center; }\n    .arrow { width: 0; height: 0; border-top: 7px solid transparent; border-bottom: 7px solid transparent; border-left: 10px solid #c8962a; }\n    .nm { padding-right: 6px; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 23px; font-weight: 700; line-height: 1.02; text-transform: uppercase; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: normal; word-break: normal; hyphens: none; text-wrap: balance; }\n    .info { position: relative; align-self: stretch; display: flex; flex-direction: column; justify-content: center; align-items: flex-end; gap: 6px; padding-right: 10px; }\n    .tor { display: flex; align-items: center; gap: 6px; }\n    .cap { font-size: 16px; font-weight: 700; letter-spacing: 1px; color: #5d6b63; }\n    .pips { display: flex; gap: 4px; height: 12px; }\n    .pip { width: 8px; height: 8px; border-radius: 50%; background: #c8962a; }\n    .fl { display: flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 700; letter-spacing: 1px; color: #5d6b63; }\n    .fl b { font-size: 16px; color: #10241c; }\n    .bonus { font-size: 11px; font-weight: 700; letter-spacing: 1px; padding: 2px 5px 1px; border-radius: 2px; background: #0f3b2e; color: #f3e3b5; }\n    .bonus:empty { display: none; }\n    .to { position: absolute; inset: 7px 6px 7px 0; flex-direction: column; align-items: center; justify-content: center; background: #c8962a; color: #fff; border-radius: 4px; line-height: 1.1; }\n    .to-l { font-size: 12px; font-weight: 700; letter-spacing: 1.5px; }\n    .to-c { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 19px; font-weight: 700; }\n    .pts { position: relative; z-index: 1; align-self: stretch; display: flex; align-items: center; justify-content: center; background: #0f3b2e; color: #fff; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 38px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .row + .row .pts { border-top: 1px solid #1d5544; }\n    .bar { display: grid; height: 64px; background: #10241c; color: #fff; }\n    .bar > * { grid-area: 1 / 1; }\n    .live { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 14px; }\n    .lft { display: flex; align-items: center; gap: 10px; }\n    .per { font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 20px; font-weight: 700; color: #10241c; background: #e2b23a; padding: 2px 9px 1px; border-radius: 3px; }\n    .gc { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 50px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n    .gc b { color: #e2b23a; padding: 0 1px; }\n    .shot { position: relative; justify-self: end; display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 4px 0 9px; background: #e2b23a; color: #10241c; border-radius: 4px; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; }\n    .shot-v { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 26px; font-weight: 700; color: #fff; background: #10241c; border-radius: 3px; min-width: 38px; padding: 0 4px; line-height: 28px; text-align: center; }\n    .run-shot { position: absolute; left: 0; right: 0; bottom: -5px; height: 2px; background: #e2b23a; }\n    .runbar { position: absolute; left: 0; right: 0; top: 0; height: 3px; background: #e2b23a; }\n    .prog { display: flex; gap: 3px; align-items: center; }\n    .q { position: relative; width: 14px; height: 5px; background: #31473d; }\n    .q > span { position: absolute; inset: 0; background: #e2b23a; }\n    .ot { font-size: 10px; font-weight: 700; padding: 1px 3px 0; line-height: 1; background: #e2b23a; color: #10241c; }\n    .state { z-index: 1; display: flex; align-items: center; justify-content: center; gap: 10px; background: #e2b23a; color: #10241c; line-height: 1; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .st-s { font-size: 17px; font-weight: 700; letter-spacing: 2px; }\n    .st-b { font-size: 36px; font-weight: 700; letter-spacing: 1px; }\n    .fin { z-index: 2; background: #0f3b2e; color: #fff; border-top: 3px solid #e2b23a; }\n    .fin-ot { font-size: 17px; font-weight: 700; letter-spacing: 1.5px; color: #e2b23a; }\n    .half-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .end-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .half-t { display: block; }\n    .fin-ot { display: none; }\n    .osb:has(.isGame5Started[style*=\"opacity: 1\"]) .fin-ot { display: block; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .final-dim { opacity: .55; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .pip { background: #9aa7a0; }\n    .win { position: absolute; top: 0; right: 0; bottom: 0; width: 76px; background: #e2b23a; }\n    .row:has(> .win[style*=\"opacity: 1\"]) .pts { background: transparent; color: #10241c; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .row.b :is(.nm, .pts, .info), .osb:has(.isBWinner[style*=\"opacity: 1\"]) .row.a :is(.nm, .pts, .info) { opacity: .45; }\n    .pips { gap: 0 !important; }\n    .pips > [class*=\"TimeoutLeft\"] { margin-right: 4px; }\n    .pips > [style*=\"opacity: 0\"] { width: 0 !important; margin: 0 !important; }\n    .pips > .pip[style*=\"opacity: 0\"] { display: none !important; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.ev-n.eventName,.ev-r.matchRound,.fl,.to-l,.ot.isGame5Started,.shot.isShotClockActive,.bonus.bonusA,.bonus.bonusB{font-size:16px!important}\n.arrow.isAPossession,.arrow.isBPossession{width:12px!important;height:14px!important;min-width:0!important;flex-shrink:0!important}\n.pip.isATimeoutLeft1,.pip.isATimeoutLeft2,.pip.isATimeoutLeft3,.pip.isATimeoutLeft4,.pip.isATimeoutLeft5,.pip.isBTimeoutLeft1,.pip.isBTimeoutLeft2,.pip.isBTimeoutLeft3,.pip.isBTimeoutLeft4,.pip.isBTimeoutLeft5{width:12px!important;height:12px!important;min-width:0!important;flex-shrink:0!important}\n/* end stream-size floor */\n\n  </style>\n</head>\n<body>\n<article class=\"osb\" aria-label=\"Basketball scorebug\">\n  <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n  <div class=\"row a\"><span class=\"kitw\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><span class=\"poss final-dim\"><span class=\"arrow isAPossession\" data-osb-component=\"field\" data-osb-field=\"isAPossession\" style=\"opacity: 0;\"></span></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"info\"><span class=\"tor final-dim\"><span class=\"cap\">TO</span><span class=\"pips\"><span class=\"pip isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\"><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span>FOULS <b class=\"teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</b></span><span class=\"to isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></span><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0;\"></span><span class=\"pts currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n  <div class=\"row b\"><span class=\"kitw\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><span class=\"poss final-dim\"><span class=\"arrow isBPossession\" data-osb-component=\"field\" data-osb-field=\"isBPossession\" style=\"opacity: 0;\"></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"info\"><span class=\"tor final-dim\"><span class=\"cap\">TO</span><span class=\"pips\"><span class=\"pip isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\"><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span>FOULS <b class=\"teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</b></span><span class=\"to isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></span><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0;\"></span><span class=\"pts currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n  <div class=\"bar\">\n    <div class=\"live\"><span class=\"lft\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"prog\"><span class=\"q\"><span class=\"isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"q\"><span class=\"isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"ot isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\">OT</span></span></span><span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"shot isShotClockActive\" data-osb-component=\"field\" data-osb-field=\"isShotClockActive\" style=\"opacity: 0;\">SHOT<span class=\"shot-v\" data-osb-static=\"true\" data-sport-stat=\"shotClock\"></span><span class=\"run-shot isShotClockRunning\" data-osb-component=\"field\" data-osb-field=\"isShotClockRunning\" style=\"opacity: 0;\"></span></span><span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span></div>\n    <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"end-t st-s\">END OF</span><span class=\"end-t st-b\"><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span></span><span class=\"half-t st-b\">HALFTIME</span></div>\n    <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FINAL</span><span class=\"fin-ot\">OVERTIME</span></div>\n  </div>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span><span class=\"timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span><span class=\"possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
