{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Warm Paper Rightnote — SOCCER 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{position:relative;display:flex;overflow:hidden;background:#f2efe9;color:#293a44;border-radius:6px;font-variant-numeric:tabular-nums;container-type:inline-size}\n.lanes{display:flex;flex:1 1 auto;min-width:0}\n.lane{display:flex;align-items:stretch;flex:1 1 0;min-width:0;background:#f2efe9}\n.tick{display:block;flex:0 0 9px;background:#2f86a7}\n.jerseyColorB{background:#c77469}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;flex-direction:column;justify-content:center;padding:0 18px 0 22px}\n.name{display:block;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:clamp(20px,3.5cqw,46px);font-weight:800;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.support-track{display:flex;align-items:baseline;gap:7px;margin-top:5px;white-space:nowrap;line-height:1}\n.support-number{font-size:clamp(15px,1.65cqw,23px);font-weight:800}\n.support-label{font-size:clamp(10px,1.12cqw,16px);font-weight:700;letter-spacing:.015em}\n.primary-track{display:flex;flex:0 0 110px;min-width:0;flex-direction:column;align-items:center;justify-content:center;align-self:stretch;background:#f2efe9;text-align:center}\n.primary-number{display:block;font-size:clamp(42px,5.4cqw,60px);font-weight:800;line-height:.98;font-variant-numeric:tabular-nums}\n.primary-label{margin-top:3px;font-size:clamp(11px,1.2cqw,16px);font-weight:700;line-height:1.1;letter-spacing:.02em}\n.dock{display:flex;flex:0 0 24%;min-width:0;flex-direction:column;background:#293a44;color:#faf9f5}\n.dock-title{font-size:clamp(15px,1.65cqw,23px);font-weight:800;line-height:1.05;letter-spacing:.015em}\n.stats{display:flex;min-width:0}\n.stat{display:flex;min-width:0}\n.stat-label{color:#b9c2bf;font-size:clamp(10px,1.02cqw,14px);font-weight:700;line-height:1.1}\n.stat-value{font-size:clamp(21px,2.45cqw,34px);font-weight:800;line-height:1;font-variant-numeric:tabular-nums}\n.retained{display:none}\n.neutral-point-slot{position:absolute;width:0;height:0;overflow:hidden;pointer-events:none}\n.neutral-point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint,.neutral-point-slot:has(.isMatchPoint[style*=\"opacity:1\"]) .isGamePoint{opacity:0!important}\n.compact{width:min(60vw,930px);aspect-ratio:3.65}\n.compact .lanes{flex-direction:column}\n.compact .lane+.lane{border-top:1px solid #b9c2bf}\n.compact .dock{align-items:center;padding:13px 13px 12px;text-align:center}\n.compact .dock-title{margin:0 0 13px}\n.compact .stats{flex:1;flex-direction:column;justify-content:space-around;width:100%}\n.compact .stat{flex-direction:column;align-items:center;gap:3px}\n.wide{width:min(88vw,1660px);aspect-ratio:9.8}\n.wide .lanes{flex-direction:row}\n.wide .lane+.lane{border-left:1px solid #b9c2bf}\n.wide .dock{flex-basis:22%;padding:14px 16px}\n.wide .dock-title{margin:0 0 auto}\n.wide .stats{align-items:stretch}\n.wide .stat{flex:1 1 0;flex-direction:column;align-items:center;justify-content:center;gap:5px;text-align:center}\n.wide .stat+.stat{border-left:1px solid #667a7d}\n.wide .primary-track{flex-basis:103px}\n.wide .name-lane{padding-left:19px}\n@media(max-width:800px){\n.stage{padding:8px}\n.compact{width:100%;aspect-ratio:auto;height:174px}\n.wide{width:100%;aspect-ratio:auto;height:132px}\n.tick{flex-basis:6px}\n.name-lane{padding-left:11px;padding-right:4px}\n.name{font-size:clamp(15px,4.1vw,28px)}\n.support-track{gap:4px;margin-top:3px}\n.support-number{font-size:15px}\n.support-label{font-size:10px}\n.primary-track,.wide .primary-track{flex-basis:65px}\n.primary-number{font-size:37px}\n.primary-label{font-size:9px}\n.compact .dock{flex-basis:25%;padding:10px 5px}\n.wide .dock{flex-basis:24%;padding:10px 6px}\n.dock-title{font-size:clamp(10px,2vw,16px)}\n.stat-label{font-size:9px}\n.stat-value{font-size:18px}\n.wide .name-lane{padding-left:8px}\n.wide .name{font-size:clamp(13px,2.6vw,22px)}\n.wide .stats{flex-direction:column}\n.wide .stat{flex-direction:row;justify-content:space-between;gap:3px;text-align:left}\n.wide .stat+.stat{border-left:0;border-top:1px solid #667a7d}\n}\n@media(max-width:460px){\n.wide{height:120px}\n.wide .tick{flex-basis:4px}\n.wide .name-lane{padding:0 2px 0 5px}\n.wide .name{font-size:clamp(10px,3vw,14px)}\n.wide .support-number{font-size:11px}\n.wide .support-label{font-size:7px}\n.wide .primary-track{flex-basis:50px}\n.wide .primary-number{font-size:27px}\n.wide .primary-label{font-size:7px}\n.wide .dock{flex-basis:25%;padding:7px 4px}\n.wide .dock-title{font-size:9px}\n.wide .stat-label{font-size:7px}\n.wide .stat-value{font-size:11px}\n}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n<article class=\"board compact rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"SOCCER scoreboard\">\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n  <span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n  <div class=\"name-lane\" data-osb-component=\"layout\">\n    <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n    <span class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-a\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></span>\n  </div>\n  <div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span></div>\n  <span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n</div>\n  <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n  <span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n  <div class=\"name-lane\" data-osb-component=\"layout\">\n    <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n    <span class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-b\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></span>\n  </div>\n  <div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span></div>\n  <span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n</div>\n  </div>\n  <aside class=\"dock columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Editable static soccer status\">\n    <span class=\"dock-title\" data-osb-component=\"text\">SOCCER</span>\n    <div class=\"stats\" data-osb-component=\"layout\">\n      <div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div>\n      <div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div>\n    </div>\n  </aside>\n  <span class=\"neutral-point-slot\" aria-hidden=\"true\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\"></span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\"></span></span>\n</article>\n</main>\n</body>\n</html>\n","css":""}
