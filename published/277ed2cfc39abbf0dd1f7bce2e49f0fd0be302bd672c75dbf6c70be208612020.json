{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>TABLE TENNIS · Indigo Pearl Namebed</title>\n<style>\n:root{color-scheme:light}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f8faf9}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;background:transparent}\n.board{width:60.4vw;max-width:1238px;min-width:0;overflow:hidden;border:1px solid #677b92;border-radius:4px;background:#292f4b;container-type:inline-size}\n.board.horizontal{width:81vw;max-width:1660px}\n.header{position:relative;height:4.55cqw;min-height:28px;display:flex;align-items:center;padding:0 2cqw;background:#dfe6e8;color:#292f4b;border-bottom:1px solid #677b92}\n.sport-tag{font-size:2.75cqw;font-weight:700;line-height:1;letter-spacing:.012em;white-space:nowrap}\n.point-slot{position:absolute;right:1.7cqw;top:50%;transform:translateY(-50%);width:15cqw;height:1.8em;pointer-events:none;text-align:right}\n.point-state{position:absolute;inset:0;background:#dfe6e8;color:#292f4b;font-size:1.25cqw;font-weight:700;line-height:1.8em;white-space:nowrap}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{height:12.05cqw;min-height:72px;flex:0 0 auto;display:flex;align-items:stretch;min-width:0;background:#292f4b}\n.lane+.lane{border-top:1px solid #aebdca}\n.identity{display:block;flex:0 0 1.9cqw;min-width:5px;background:#3184a9}\n.jerseyColorB{background:#c87175}\n.namebed{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.7cqw;padding:0 2.35cqw;overflow:hidden}\n.name-line{display:flex;align-items:center;gap:1cqw;min-width:0;height:5.7cqw}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.25cqw;font-weight:700;line-height:1.1}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{flex:0 0 1.8cqw;text-align:center;font-size:1.8cqw;line-height:1;color:#f8faf9}\n.support-line{display:flex;align-items:baseline;gap:1cqw;min-width:0;line-height:1.05}\n.support-caption{font-size:2.1cqw;font-weight:700;letter-spacing:.025em;white-space:nowrap}\n.support-number{font-size:2.55cqw;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}\n.primary-track{flex:0 0 18.8%;width:18.8%;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#dfe6e8;color:#292f4b;overflow:hidden}\n.primary-number{font-size:7.25cqw;font-weight:700;line-height:.9;white-space:nowrap;font-variant-numeric:tabular-nums}\n.primary-caption{margin-top:.45cqw;font-size:1.95cqw;font-weight:700;line-height:1.1;letter-spacing:.01em;white-space:nowrap}\n.horizontal .header{height:2.9cqw}\n.horizontal .sport-tag{font-size:1.8cqw}\n.horizontal .point-state{font-size:.9cqw}\n.horizontal .lanes{flex-direction:row}\n.horizontal .lane{height:9.65cqw;flex:1 1 50%}\n.horizontal .lane+.lane{border-top:0;border-left:1px solid #aebdca}\n.horizontal .identity{flex-basis:1.5cqw}\n.horizontal .namebed{padding:0 2cqw;gap:.25cqw}\n.horizontal .name-line{height:4.2cqw}\n.horizontal .name{font-size:3.5cqw}\n.horizontal .serve{flex-basis:1.4cqw;font-size:1.4cqw}\n.horizontal .support-caption{font-size:1.7cqw}\n.horizontal .support-number{font-size:2cqw}\n.horizontal .primary-track{flex-basis:19%;width:19%}\n.horizontal .primary-number{font-size:5.2cqw}\n.horizontal .primary-caption{font-size:1.45cqw;margin-top:.2cqw}\n@media(max-width:650px){\n .board,.board.horizontal{width:94vw}\n .header,.horizontal .header{height:9cqw;padding:0 3cqw}\n .sport-tag,.horizontal .sport-tag{font-size:4.1cqw}\n .point-slot{right:2.5cqw;width:23cqw}\n .point-state,.horizontal .point-state{font-size:2.2cqw}\n .lanes,.horizontal .lanes{flex-direction:column}\n .lane,.horizontal .lane{height:20cqw;min-height:73px;flex:0 0 auto}\n .lane+.lane,.horizontal .lane+.lane{border-left:0;border-top:1px solid #aebdca}\n .identity,.horizontal .identity{flex-basis:2cqw}\n .namebed,.horizontal .namebed{gap:0;padding:0 3cqw}\n .name-line,.horizontal .name-line{height:10cqw}\n .name,.horizontal .name{font-size:5.8cqw}\n .serve,.horizontal .serve{flex-basis:2.3cqw;font-size:2.3cqw}\n .support-caption,.horizontal .support-caption{font-size:3cqw}\n .support-number,.horizontal .support-number{font-size:3.4cqw}\n .primary-track,.horizontal .primary-track{flex-basis:20%;width:20%}\n .primary-number,.horizontal .primary-number{font-size:10cqw}\n .primary-caption,.horizontal .primary-caption{font-size:2.55cqw;margin-top:.1cqw}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board columnContainer horizontal\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <header class=\"header\"><div class=\"sport-tag\">TABLE TENNIS</div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></header>\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lane rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n      <div class=\"namebed\">\n        <div class=\"name-line\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\" aria-label=\"Serving\">●</span></div>\n        <div class=\"support-line\"><span class=\"support-caption\">GAMES</span><span class=\"support-number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n      </div>\n      <div class=\"primary-track\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n    </div>\n    <div class=\"lane rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n      <div class=\"namebed\">\n        <div class=\"name-line\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\" aria-label=\"Serving\">●</span></div>\n        <div class=\"support-line\"><span class=\"support-caption\">GAMES</span><span class=\"support-number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n      </div>\n      <div class=\"primary-track\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n    </div>\n  </div>\n</article></main>\n</body>\n</html>\n","css":""}
