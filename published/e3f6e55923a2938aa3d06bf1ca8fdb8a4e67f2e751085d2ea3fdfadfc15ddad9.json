{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>softball midnight teal capsule 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#f7fbfc}body{font-family:Arial,sans-serif;font-weight:700}.stage{display:flex;align-items:center;justify-content:center;width:100%;min-height:100vh;padding:16px}.board{width:min(85vw,calc((100vh - 40px) * 4.8),1760px);container-type:inline-size;position:relative;display:flex;flex-direction:column;background:#102331;border:1px solid #36545e;border-radius:8px;overflow:hidden}.header{display:flex;align-items:center;justify-content:space-between;min-width:0;height:2.8cqw;padding:0 2.5cqw;background:#b9e2df;color:#102331;border-bottom:1px solid #36545e}.sport{font-size:2.05cqw;line-height:1;white-space:nowrap;max-width:100%}.column-label{font-size:3.6cqw;text-align:center;flex:0 0 12.6cqw;margin-right:-2.8cqw}.competitors{display:flex;flex-direction:row;min-width:0}.competitor{display:flex;align-items:center;min-width:0;flex:1 1 0;min-height:8.9cqw}.competitor+.competitor{border-left:1px solid #36545e}.identity-tick{display:block;width:3px;flex:none;height:6.2cqw;background:#147d86;margin-left:1.7cqw;margin-right:2.7cqw}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.9cqw;line-height:1.08;color:#f7fbfc}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 12.6cqw;align-self:stretch;min-width:0;background:#147d86;color:#f7fbfc;gap:.55cqw;border-left:1px solid #36545e}.run-label{font-size:1.5cqw;line-height:1;color:#f7fbfc}.score{display:block;width:100%;text-align:center;font-size:5.1cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.stats{display:flex;align-items:center;min-height:4.65cqw;border-top:1px solid #36545e;padding:.9cqw 0;background:#102331}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:2cqw;min-height:3cqw}.stat+.stat{border-left:1px solid #82aeaf}.stat-label{font-size:1.65cqw;line-height:1;color:#b9e2df;white-space:nowrap}.stat-number{font-size:2.7cqw;line-height:1;color:#f7fbfc;font-variant-numeric:tabular-nums}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:100%}.header{height:34px;padding:0 14px}.sport{font-size:15px}.competitors{flex-direction:column}.competitor{min-height:76px}.competitor+.competitor{border-left:0;border-top:1px solid #36545e}.identity-tick{height:46px;margin-left:14px;margin-right:14px}.name{font-size:24px}.score-track{flex-basis:88px;gap:4px}.run-label{font-size:11px}.score{font-size:34px}.stats{min-height:48px;padding:8px 0}.stat{gap:6px;min-height:30px}.stat-label{font-size:11px}.stat-number{font-size:18px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-static=\"true\">SOFTBALL</span></header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
