{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>SOCCER — Copper Cream Keyline Stat compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#263540}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}.board{display:flex;flex-direction:column;width:min(66vw,1350px);max-width:100%;min-width:0;overflow:hidden;border:1px solid #aeb9b0;border-radius:4px;background:#f2efe8;container-type:inline-size;font-variant-numeric:tabular-nums}.header{display:flex;align-items:center;justify-content:space-between;flex:none;height:8cqw;min-width:0;padding:0 2.5cqw;background:#78544a;color:#fbfaf6}.sport-tag{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;color:#fbfaf6;font-size:3.8cqw;font-weight:800;line-height:1;white-space:nowrap}.stats{display:flex;align-items:center;justify-content:flex-end;min-width:0}.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;min-width:0;padding:0 1.4cqw;color:#fbfaf6;font-size:1.35cqw;font-weight:700;line-height:1;white-space:nowrap}.stat+.stat{border-left:1px solid #d2c8bf}.stat-value{font-size:1.6em;font-variant-numeric:tabular-nums}.competitors{display:flex;flex-direction:column;min-width:0}.competitor{display:flex;align-items:stretch;flex:none;min-width:0;height:13cqw;background:#f2efe8}.competitor+.competitor{border-top:1px solid #aeb9b0}.identity{display:block;align-self:center;flex:none;width:2.7%;height:96%;background:#2685e2;border-radius:3px}.jerseyColorB{background:#ee665f}.name{display:block;align-content:center;flex:1 1 0;width:100%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2.5cqw;color:#263540;font-size:6.1cqw;font-weight:800;line-height:1.05}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.support{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 15%;min-width:0;align-self:center;height:82%;margin:0 .7cqw;border:1px solid #839096;border-radius:4px;background:#f2efe8;color:#263540}.support-value{display:block;max-width:100%;overflow:hidden;font-size:5.2cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}.support-label{display:block;font-size:1.85cqw;font-weight:700;line-height:1;white-space:nowrap}.primary{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 19%;min-width:0;align-self:center;height:96%;margin-right:.5cqw;border-radius:4px;background:#263540;color:#fbfaf6}.score-row{display:flex;width:100%;align-items:center;justify-content:center}.score{display:block;max-width:100%;overflow:hidden;color:#fbfaf6;font-size:8cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center}.score-label{display:block;color:#fbfaf6;font-size:1.85cqw;font-weight:700;line-height:1;white-space:nowrap}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.board{width:100%}.header{height:48px;padding:0 6px;flex-direction:column;align-items:stretch;justify-content:center;gap:3px}.sport-tag{font-size:11px}.stats{justify-content:space-between}.stat{flex-direction:row;align-items:baseline;gap:2px;font-size:9px;padding:0 3px}.stat-value{font-size:1.15em}.competitor{height:76px}.identity{width:4px}.name{font-size:clamp(16px,5vw,27px);padding:0 8px}.support{flex-basis:23%;height:82%;margin:0 3px}.support-value{font-size:23px}.support-label{font-size:9px}.primary{flex-basis:28%;height:92%;margin-right:3px}.score{font-size:clamp(25px,7vw,34px)}.score-label{font-size:9px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"SOCCER scoreboard\"><div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static soccer counters\"><span class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><strong class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"clock\">00:00</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><strong class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</strong></span></div></div><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</strong><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"primary columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"score-row\" data-osb-component=\"layout\"><strong class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong></div><span class=\"score-label\" data-osb-component=\"text\">GOALS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</strong><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"primary columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"score-row\" data-osb-component=\"layout\"><strong class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong></div><span class=\"score-label\" data-osb-component=\"text\">GOALS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
