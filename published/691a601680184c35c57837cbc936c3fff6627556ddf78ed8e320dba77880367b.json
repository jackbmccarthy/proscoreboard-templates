{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>PICKLEBALL · Porcelain Umber Leadbed</title>\n<style>\n:root{color-scheme:light}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#403938}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;background:transparent}\n.board{width:58vw;max-width:1120px;min-width:0;overflow:hidden;border:1px solid #aeb9b3;border-radius:5px;background:#e7e9e5;container-type:inline-size}\n.board.horizontal{width:84vw;max-width:1720px}\n.utility{position:relative;height:6.6cqw;min-height:38px;display:flex;align-items:center;min-width:0;padding:0 2.2cqw;background:#e7e9e5;border-bottom:1px solid #aeb9b3}\n.sport-tab{font-size:3.4cqw;font-weight:700;line-height:1;white-space:nowrap;letter-spacing:0}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{height:14cqw;min-height:82px;display:flex;align-items:stretch;flex:0 0 auto;min-width:0;background:#e7e9e5}\n.lane+.lane{border-top:1px solid #aeb9b3}\n.identity{display:block;flex:0 0 2.65cqw;min-width:7px;background:#3186a8}\n.jerseyColorB{background:#c96b71}\n.primary-track{display:flex;flex:0 0 20.5%;width:20.5%;min-width:0;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;background:#403938;color:#f8f6f2;font-variant-numeric:tabular-nums}\n.primary-number{display:block;max-width:100%;font-size:8.3cqw;font-weight:700;line-height:.9;white-space:nowrap;font-variant-numeric:tabular-nums}\n.primary-caption{display:block;margin-top:.5cqw;font-size:2.2cqw;font-weight:700;line-height:1;white-space:nowrap}\n.namebed{flex:1 1 0;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.55cqw;overflow:hidden;padding:0 3.2cqw;background:#e7e9e5}\n.name-line{display:flex;align-items:center;gap:1cqw;min-width:0}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.55cqw;font-weight:700;line-height:1.08;color:#403938}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 1.8cqw;width:1.8cqw;text-align:center;font-size:1.45cqw;line-height:1;color:#566862}\n.support-line{display:flex;align-items:baseline;gap:.9cqw;min-width:0;white-space:nowrap;line-height:1.12;color:#403938;font-variant-numeric:tabular-nums}\n.support-caption{font-size:2.25cqw;font-weight:700}\n.support-number{font-size:2.45cqw;font-weight:700;font-variant-numeric:tabular-nums}\n.point-slot{position:absolute;right:2cqw;top:50%;transform:translateY(-50%);width:20cqw;height:2em;text-align:right;pointer-events:none}\n.point-state{position:absolute;inset:0;background:#e7e9e5;color:#403938;font-size:1.5cqw;font-weight:700;line-height:2em;white-space:nowrap}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.horizontal .utility{height:3.8cqw;min-height:38px}\n.horizontal .sport-tab{font-size:2.2cqw}\n.horizontal .lanes{flex-direction:row}\n.horizontal .lane{height:9.6cqw;flex:1 1 50%}\n.horizontal .lane+.lane{border-top:0;border-left:1px solid #aeb9b3}\n.horizontal .identity{flex-basis:1.75cqw}\n.horizontal .primary-track{flex-basis:23%;width:23%}\n.horizontal .primary-number{font-size:5.6cqw}\n.horizontal .primary-caption{font-size:1.5cqw;margin-top:.2cqw}\n.horizontal .namebed{padding:0 1.7cqw;gap:.3cqw}\n.horizontal .name{font-size:3.5cqw}\n.horizontal .support-caption{font-size:1.7cqw}\n.horizontal .support-number{font-size:1.9cqw}\n.horizontal .serve{flex-basis:1.25cqw;width:1.25cqw;font-size:1.1cqw}\n.horizontal .point-state{font-size:1.1cqw}\n@media(max-width:650px){\n .board,.board.horizontal{width:94vw}\n .utility,.horizontal .utility{height:10.8cqw;min-height:39px;padding:0 3cqw}\n .sport-tab,.horizontal .sport-tab{font-size:4.2cqw}\n .lanes,.horizontal .lanes{flex-direction:column}\n .lane,.horizontal .lane{height:23.5cqw;min-height:85px;flex:0 0 auto}\n .lane+.lane,.horizontal .lane+.lane{border-left:0;border-top:1px solid #aeb9b3}\n .identity,.horizontal .identity{flex-basis:2.2cqw}\n .primary-track,.horizontal .primary-track{flex-basis:24%;width:24%}\n .primary-number,.horizontal .primary-number{font-size:9.6cqw}\n .primary-caption,.horizontal .primary-caption{font-size:2.6cqw;margin-top:.2cqw}\n .namebed,.horizontal .namebed{padding:0 3cqw;gap:.4cqw}\n .name,.horizontal .name{font-size:6.1cqw}\n .support-caption,.horizontal .support-caption{font-size:3cqw}\n .support-number,.horizontal .support-number{font-size:3.3cqw}\n .serve,.horizontal .serve{flex-basis:2.2cqw;width:2.2cqw;font-size:1.9cqw}\n .point-slot{right:3cqw;width:30cqw}\n .point-state,.horizontal .point-state{font-size:2.1cqw}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board columnContainer paired horizontal\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <header class=\"utility rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tab\">PICKLEBALL</span><span class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></span></header>\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lane rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n      <div class=\"primary-track\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n      <div class=\"namebed\"><div class=\"name-line\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\" aria-label=\"Serving\">●</span></div><div class=\"support-line\"><span class=\"support-caption\">GAMES:</span><span class=\"support-number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div>\n    </div>\n    <div class=\"lane rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n      <div class=\"primary-track\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n      <div class=\"namebed\"><div class=\"name-line\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\" aria-label=\"Serving\">●</span></div><div class=\"support-line\"><span class=\"support-caption\">GAMES:</span><span class=\"support-number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n    </div>\n  </div>\n</article></main>\n</body>\n</html>\n","css":""}
