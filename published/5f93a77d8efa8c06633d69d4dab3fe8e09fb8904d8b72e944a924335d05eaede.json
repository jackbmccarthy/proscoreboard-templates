{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Table Green</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\nhtml,body{height:100%;overflow:hidden}\n.osb-core-fields{display:none!important}\n.end[data-osb-resolved-court-side=\"A\"] .isBWinner,.end[data-osb-resolved-court-side=\"B\"] .isAWinner,.end:not([data-osb-resolved-court-side]) :is(.isAWinner,.isBWinner){display:none!important}\n.hg:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;padding:0!important;margin:0!important;border:0!important}\n.hg .won{display:none}\n.name{overflow-wrap:normal;word-break:normal;hyphens:none}\n/* status chips flow: an empty chip takes no room, so both ends keep the same packed order */\n.to-slot:not(:has(>[style*=\"opacity: 1\"])),.card:not([style*=\"opacity: 1\"]){display:none}\n.end:has(.to-on[style*=\"opacity: 1\"]) .to-used{opacity:0!important}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .big{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n\n.board{position:fixed;inset:0;display:flex;flex-direction:column;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:transparent;-webkit-font-smoothing:antialiased;overflow:hidden;--paper:#f4f4ef;--felt:#13623f;--deep:#0b3d2a;--gold:#ffd23f;--mint:#cfe6da}\n/* header bar: event and round, the match state tag, best-of or a match-level banner */\n.bar{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:2vw;flex:0 0 14vh;padding:0 2.4vw;background:#08140f}\n.info{display:flex;flex-direction:column;justify-content:center;gap:.6vh;min-width:0;text-transform:uppercase;white-space:nowrap}\n.info>*{overflow:hidden;text-overflow:ellipsis}\n.ev{font-size:4.8vh;font-weight:800;letter-spacing:.06em}\n.rd{font-size:3.6vh;font-weight:700;letter-spacing:.08em;color:#bfe0cf}\n.rd:empty{display:none}\n.teamlbl{display:none;font-size:4.4vh;font-weight:800;letter-spacing:.08em}\n.info:not(:has(.ev:not(:empty))):not(:has(.rd:not(:empty))) .teamlbl{display:block}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.tagslot{width:36vh;height:9vh}\n.tagslot>*{border-radius:1vh;font-size:4.6vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.gtag{background:#fff;color:var(--deep)}\n.pre{box-shadow:inset 0 0 0 .4vh #2d6b4f;color:#bfe0cf}\n.tagslot:has(>.gtag[style*=\"opacity: 1\"]) .pre,.tagslot:has(>.fin[style*=\"opacity: 1\"]) .pre,.board:has(.isWarmUpStarted[style*=\"opacity: 1\"]) .pre{opacity:0}\n.fin{background:var(--gold);color:#111}\n.right{display:flex;align-items:center;justify-content:flex-end;gap:1vw;min-width:0}\n.chip{width:24vh;height:6.6vh}\n.fl{border-radius:.7vh;font-size:3.2vh;font-weight:800;letter-spacing:.06em;text-transform:uppercase;box-shadow:inset 0 0 0 .3vh #9cc9b2;color:#e7f5ee}\n.banner{width:44vh;height:9vh}\n.bn{border-radius:1vh;font-size:4.6vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.bn-warm{background:#fff;color:var(--deep)}\n.bn-break{box-shadow:inset 0 0 0 .5vh #fff;color:#fff}\n.banner>.bo{justify-content:flex-end;font-size:4.4vh;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#bfe0cf}\n.board:not(:has(.isMatchStarted[style*=\"opacity: 1\"])) .banner:has(>.isWarmUpStarted[style*=\"opacity: 1\"])>.bo,\n.board:not(:has(.isComplete[style*=\"opacity: 1\"])) .banner:has(>.isInBetweenGames[style*=\"opacity: 1\"])>.bo{opacity:0}\n/* the table: one half per court end, the net between them */\n.table{display:flex;flex:1 1 auto;min-height:0;margin:2.4vh 2.4vw 3vh;border:1vh solid var(--paper);border-radius:.6vh;background:var(--felt);box-shadow:0 1vh 3vh rgba(0,0,0,.45)}\n.net{flex:0 0 1.2vw;background:repeating-linear-gradient(0deg,#1c1c1c 0 .6vh,#3b3b3b .6vh 1.2vh);box-shadow:inset .25vw 0 0 var(--paper),inset -.25vw 0 0 var(--paper)}\n.end{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-rows:auto 18vh 9vh minmax(0,1fr) 11vh;grid-template-areas:\"band band\" \"gw who\" \"marks marks\" \"pts pts\" \"hist hist\";row-gap:0;flex:1 1 0;min-width:0;overflow:hidden;padding:2.4vh 1.8vw 2.6vh}\n.eB{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:\"band band\" \"who gw\" \"marks marks\" \"pts pts\" \"hist hist\"}\n.kit{position:absolute;left:0;right:0;bottom:0;height:1.2vh;background:#7aa08d}\n/* team tie strip */\n.tband{grid-area:band;display:none;align-items:center;gap:1.4vw;margin-bottom:1.6vh;padding:1vh 1.6vw;min-height:11vh;border-radius:.8vh;background:var(--deep);font-size:5vh;font-weight:800;letter-spacing:.04em;text-transform:uppercase}\n.eB .tband{flex-direction:row-reverse;text-align:right}\n.board:has(.tname:not(:empty)) .tband{display:flex}\n.tband .tlogo{width:7.5vh;height:7.5vh;object-fit:contain;flex:0 0 auto}\n.tband .tname{flex:1 1 auto;min-width:0;line-height:1.05;overflow-wrap:normal;hyphens:none}\n.tband .tie{display:inline-flex;align-items:center;gap:1vw;flex:0 0 auto;height:8vh;padding:0 1.5vw;border-radius:.6vh;background:var(--paper);color:var(--deep)}\n.tband .tie i{font-style:normal;font-size:4vh;letter-spacing:.12em}\n.tband .tscore{font-size:6.4vh;font-variant-numeric:tabular-nums}\n/* GAMES box at the outer corner */\n.gw{grid-area:gw;align-self:start;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.6vh;width:21vh;height:16.5vh;border:.5vh solid var(--paper);border-radius:1vh;font-weight:900;text-transform:uppercase}\n.gw i{font-style:normal;font-size:4.2vh;letter-spacing:.12em;line-height:1;color:#e3f3ea}\n.gn{font-size:10.5vh;line-height:.9;font-variant-numeric:tabular-nums}\n/* identity: flag + name on top, the player's own status line under it */\n.who{display:contents}\n.who>.flag,.who>.nm{grid-area:who;align-self:start;margin-top:4.6vh}\n.eA .who>.nm{margin-left:calc(8.4vh + 2.2vw);padding-left:0}.eA .who>.flag{margin-left:1.6vw}\n.eB .who>.nm{margin-right:calc(8.4vh + 2.2vw)}.eB .who>.flag{justify-self:end;margin-right:1.6vw}\n.board:has(.flag:not([src])) .who>.nm{margin-left:1.6vw;margin-right:1.6vw}\n.flag{width:8.4vh;height:5.6vh;object-fit:cover;border-radius:.4vh;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.nm{min-width:0}\n.eB .nm{text-align:right}\n.name{display:block;font-size:4.9vh;line-height:1.02;font-weight:800;text-transform:uppercase}\n.marks{grid-area:marks;display:flex;align-items:center;gap:1vw;min-width:0;overflow:hidden}\n.eB .marks{justify-content:flex-end}\n.to-slot{width:24vh;height:7.4vh}\n.to-used{border-radius:.8vh;font-size:4.2vh;font-weight:900;letter-spacing:.04em;text-transform:uppercase;background:var(--deep);color:#e7f5ee}\n.card{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:8vh;height:7.4vh;padding:0;border-radius:.8vh;font-size:0;font-weight:900;letter-spacing:.05em;text-transform:uppercase;background:var(--deep);color:#fff;white-space:nowrap}\n.card b{flex:0 0 auto;width:4.2vh;height:5.8vh;border-radius:.4vh;box-shadow:0 0 0 .25vh rgba(0,0,0,.35)}\n.yc b{background:#ffd400}.rc b{background:#e3262f}\n.win{display:none;align-items:center;height:7.4vh;padding:0 1.6vw;border-radius:.8vh;background:var(--gold);color:#111;font-size:4.2vh;font-weight:900;letter-spacing:.14em;text-transform:uppercase}\n.win[style*=\"opacity: 1\"]{display:inline-flex}\n/* game point / match point: in the leading player's own panel (the neutral label, shown at the end whose side has the point) */\n.ptslot{display:none;width:36vh;height:7.4vh}\n.end[data-osb-resolved-court-side=\"A\"]:has(:is(.isAGamePoint,.isAMatchPoint)[style*=\"opacity: 1\"]) .ptslot,.end[data-osb-resolved-court-side=\"B\"]:has(:is(.isBGamePoint,.isBMatchPoint)[style*=\"opacity: 1\"]) .ptslot{display:inline-block}\n.pt{border-radius:.8vh;background:var(--paper);color:var(--deep);font-size:4.6vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.pside{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}\n.end[data-osb-resolved-court-side=\"A\"]:has(:is(.isAGamePoint,.isAMatchPoint)[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"]:has(:is(.isBGamePoint,.isBMatchPoint)[style*=\"opacity: 1\"]){box-shadow:inset 0 0 0 .7vh var(--paper)}\n/* points, and the serve marker inside the server's own half */\n.pts{grid-area:pts;position:relative;display:grid;grid-template-columns:minmax(0,1fr) 17vh;align-items:center;justify-items:center;min-height:0}\n.eB .pts{grid-template-columns:17vh minmax(0,1fr)}.eB .pts>.big{order:2}\n.big{font-size:36vh;line-height:.78;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em;text-shadow:0 1vh 2.4vh rgba(0,0,0,.25)}\n.ss{width:17vh;height:22vh}\n.srv{flex-direction:column;gap:1.2vh;border-radius:2vh;background:rgba(0,0,0,.28);font-size:4vh;font-weight:900;letter-spacing:.1em;text-transform:uppercase}\n.s2{padding:.4vh 1vh;border-radius:.6vh;background:var(--paper);color:var(--deep);font-size:3.4vh}\n.ball{flex:0 0 auto;width:9vh;height:9vh;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .4vh rgba(0,0,0,.25),0 0 2.4vh rgba(255,138,28,.55)}\n/* finished games along the outer baseline, mirrored */\n.hist{grid-area:hist;position:relative;display:flex;align-items:center;gap:.8vw}\n.eB .hist{justify-content:flex-end}\n.hg{display:flex;align-items:center;gap:.8vw;height:10vh;padding:0 1.4vw;border-radius:.8vh;font-weight:800;font-variant-numeric:tabular-nums;background:var(--deep);color:var(--mint)}\n.hl{font-style:normal;font-size:4.2vh;letter-spacing:.06em}\n.gs{font-size:7vh}\n.end[data-osb-resolved-court-side=\"A\"] .hg:has(.wA[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"] .hg:has(.wB[style*=\"opacity: 1\"]){background:var(--paper);color:var(--deep)}\n/* active time-out: a banner with its countdown over the history row of that player's half */\n.tob{grid-area:hist;z-index:2;align-self:center;justify-self:start;display:flex;align-items:center;gap:1.4vw;height:10vh;padding:0 1.8vw;border-radius:.8vh;background:var(--gold);color:#111;font-size:5.2vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}\n.eB .tob{justify-self:end}\n.tclock{display:inline-flex;align-items:center;justify-content:center;min-width:11vh;height:7.6vh;padding:0 1.2vh;border-radius:.6vh;background:#111;color:var(--gold);font-size:6vh;font-variant-numeric:tabular-nums}\n.end:has(.tob[style*=\"opacity: 1\"]) .hist{visibility:hidden}\n/* between games: the finished game is the story, the 0-0 of the next one steps back */\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .big{font-size:24vh;opacity:.4}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .end{grid-template-rows:auto 18vh 9vh minmax(0,1fr) 16vh}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .hg{height:15vh;padding:0 2vw;gap:1.4vw}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .hl{font-size:5vh}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]):not(:has(.isComplete[style*=\"opacity: 1\"])) .gs{font-size:10vh}\n/* team tie */\n.board:has(.tname:not(:empty)) .big{font-size:25vh}\n.board:has(.tname:not(:empty)) .ss{height:17vh}.board:has(.tname:not(:empty)) .ball{width:7vh;height:7vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.who,.gw,.pts,.hist){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband,.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .eB .tband{grid-row:1 / -1;grid-column:1 / -1;flex-direction:column;justify-content:center;gap:5vh;margin:4vh 2vw;background:none;font-size:7vh;text-align:center}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tlogo{width:14vh;height:14vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tname{flex:0 0 auto}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie{height:auto;gap:2vw;padding:2vh 4vw;border-radius:1.6vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tscore{font-size:22vh;line-height:.9}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie i{font-size:5vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .bar .pre{opacity:0}\n/* final: games won is the big number; the winner's half is framed in gold, the loser's in white, both readable */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .end{grid-template-areas:\"band band\" \"who who\" \"marks marks\" \"pts pts\" \"hist hist\"}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .eA .who>.nm{margin-left:calc(8.4vh + 1.6vw)}.board:has(.isComplete[style*=\"opacity: 1\"]) .eA .who>.flag{margin-left:0}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .eB .who>.nm{margin-right:calc(8.4vh + 2.2vw)}.board:has(.isComplete[style*=\"opacity: 1\"]) .eB .who>.flag{margin-right:0}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{grid-area:pts;align-self:center;justify-self:center;flex-direction:column-reverse;width:auto;height:auto;border:0;gap:2vh}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{font-size:34vh;line-height:.8}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw i{font-size:4.4vh}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .end{box-shadow:inset 0 0 0 .6vh rgba(244,244,239,.7)}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]){box-shadow:inset 0 0 0 .9vh var(--gold)}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]) .gn{color:var(--gold)}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]){background:#0f4a31}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) :is(.gn,.name){color:#e3efe8}\n</style>\n</head>\n<body>\n<main class=\"board t-green\" data-osb-component=\"layout\"><div class=\"bar\" data-osb-component=\"layout\"><span class=\"info\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><span class=\"teamlbl\">Team match</span></span><span class=\"slot tagslot\"><span class=\"isMatchStarted gtag\" data-osb-