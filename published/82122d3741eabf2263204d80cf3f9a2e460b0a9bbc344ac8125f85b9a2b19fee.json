{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pickleball Between Games</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;font-family:\"Avenir Next\",\"Helvetica Neue\",Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.rowContainer{display:flex;flex-direction:row}.columnContainer{display:flex;flex-direction:column}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\nimg.logo:not([src]),img.logo[src=\"\"]{display:none}\n.pt-slot{position:relative;display:block}.pt-slot>.pt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.pt-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint,.pt-slot:has(> .isMatchPoint[style*=\"opacity:1\"]) > .isGamePoint{opacity:0!important}\n.pt-slot .isMatchPoint{animation:osbPulse 1.8s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.3)}}\n@media (prefers-reduced-motion: reduce) {\n.pt-slot .isGamePoint,.pt-slot .isMatchPoint{animation:none!important;transition:none!important}\n}\n.pips{display:inline-flex;gap:.35rem;align-items:center}.pip{position:relative;display:block;width:.7rem;height:.7rem;border-radius:50%;background:currentColor}\n.pip-used{position:absolute;inset:-1px;border-radius:50%;background:var(--pip-off,#0009)}\n.to-left:empty{display:none}\n.isACurrentlyServing,.isBCurrentlyServing{transition:opacity .2s}\n.dbl-probe{display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff9 0 18%,transparent 40%),conic-gradient(from 20deg,#ffd23f 0 120deg,#1d4fbf 0 240deg,#f4f6fb 0);box-shadow:inset 0 0 0 .12rem #0005}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 32%,#0003 0 9%,transparent 10%),radial-gradient(circle at 66% 30%,#0003 0 9%,transparent 10%),radial-gradient(circle at 50% 62%,#0003 0 9%,transparent 10%),radial-gradient(circle at 24% 70%,#0002 0 7%,transparent 8%),radial-gradient(circle at 78% 70%,#0002 0 7%,transparent 8%),radial-gradient(circle at 38% 30%,#fbffb0,#d4f02b 60%,#a9c414)}\n.sn{position:relative;display:inline-grid}.sn>i,.cn>i{grid-area:1/1;font-style:normal}\n.sn:has(> .isSecondServer[style*=\"opacity: 1\"]) > .one,.sn:has(> .isSecondServer[style*=\"opacity:1\"]) > .one{opacity:0}\n.cn{position:relative;display:inline-grid}.cn:has(> .isSecondServer[style*=\"opacity: 1\"]) > .one,.cn:has(> .isSecondServer[style*=\"opacity:1\"]) > .one{opacity:0}\n.call{display:inline-flex;align-items:baseline}.call>i{font-style:normal}.call .ca{order:1}.call .cd1{order:2}.call .cb{order:3}.call .cd2{order:4}.call .cn{order:5}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .ca,.board:has(.isBCurrentlyServing[style*=\"opacity:1\"]) .call .ca{order:3}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .cb,.board:has(.isBCurrentlyServing[style*=\"opacity:1\"]) .call .cb{order:1}\n.board:has(.playerA2:empty) .sn,.board:has(.playerA2:empty) .cn,.board:has(.playerA2:empty) .cd2{display:none}\n.gstack{display:inline-grid}.gstack>.gs{grid-area:1/1;white-space:nowrap}.gstack>.gs:has(~ .gs[style*=\"opacity: 1\"]),.gstack>.gs:has(~ .gs[style*=\"opacity:1\"]){visibility:hidden}\n.tie{display:none}\n.cards{display:inline-flex;gap:.25rem}.card{display:block;width:.8rem;height:1.1rem;border-radius:.15rem;box-shadow:0 0 0 1px #0003}.yc{background:#ffd200}.rc{background:#e3262f}\n.live{display:inline-flex;align-items:center;gap:.35rem}.live::before{content:\"\";width:.6rem;height:.6rem;border-radius:50%;background:#ff3b30}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{position:relative;width:112rem;height:62rem;padding:3rem 5rem;justify-content:space-between;color:#fff;font-family:\"Avenir Next\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;background:radial-gradient(110% 80% at 50% 0,#1d4d38,#0a1d15 70%);outline:.2rem solid #ffffff1f;outline-offset:-1.6rem;border-radius:1rem;box-shadow:0 1rem 3rem #0008;overflow:hidden}\n.head{position:relative;z-index:1;justify-content:space-between;align-items:center;font-size:1.7rem;letter-spacing:.14em;color:#a7d8bd}\n.state{display:grid}.state>*{grid-area:1/1}.between{color:#d4f02b}.stx{color:#d4f02b}\n.state:has(.between:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"])) .stx{opacity:0}\n.face{position:relative;z-index:1;align-items:center;justify-content:center;gap:3rem}\n.team{flex:1;min-width:0;align-items:center;gap:1rem}\n.chip{width:10rem;height:.6rem;border-radius:.3rem;background:#3d7bff}.team.b .chip{background:#ff6b5a}\n.nm{max-width:100%;font-size:4rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.srvl{display:flex;gap:.6rem;align-items:center;font-size:1.3rem;color:#d4f02b}.srv{display:flex;align-items:center;gap:.4rem}.pball{width:2.4rem;height:2.4rem}.sn{font-size:1.6rem}\n.won{min-width:11rem;text-align:center;font-size:13rem;line-height:1}\n.dash{font-size:7rem;color:#d4f02b}\n.lbl{position:relative;z-index:1;text-align:center;font-size:1.5rem;letter-spacing:.3em;color:#a7d8bd}\n.table{position:relative;z-index:1;align-self:center;gap:.8rem;font-size:3.6rem}\n.rl{display:grid;grid-template-rows:2.6rem 5rem 5rem;width:12rem}.rl>i{display:block;height:.6rem;align-self:center;border-radius:.3rem;background:#3d7bff}.rl>i.jerseyColorB{background:#ff6b5a}.rl>span{align-self:center;font-size:1.2rem;letter-spacing:.2em;color:#a7d8bd}\n.hcol{display:grid;grid-template-rows:2.6rem 5rem 5rem;width:10rem;text-align:center;background:#ffffff14;border-radius:.5rem;overflow:hidden}\n.hh{align-self:center;font-size:1.2rem;letter-spacing:.14em;color:#d4f02b}.ha,.hb{align-self:center}\n.hcol:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"]):has(+ :not([style*=\"opacity: 1\"]):not([style*=\"opacity:1\"])),.hcol.hlast:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"]){background:#d4f02b;color:#0f2a1f}.hcol:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"]):has(+ :not([style*=\"opacity: 1\"]):not([style*=\"opacity:1\"])) .hh,.hcol.hlast:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"]) .hh{color:inherit;opacity:.7}\n.foot{position:relative;z-index:1;justify-content:space-between;align-items:center;font-size:1.4rem;letter-spacing:.12em;color:#a7d8bd}\n.cbox{display:flex;align-items:center;gap:1rem}.call{font-size:3rem;gap:.2rem;color:#fff}.call>i{opacity:.6}\n.mid{align-items:center;gap:.5rem}.mid .pt-slot{width:22rem;height:2.6rem}.mid .pt{border-radius:.4rem;background:#d4f02b;color:#0f2a1f}\n.st{display:flex;align-items:center;gap:.4rem}.to-used{font-size:1rem;color:#d4f02b}\n.tie{position:absolute;left:5rem;right:5rem;top:7rem;z-index:1}\n.tolive{position:absolute;left:5rem;right:5rem;bottom:1rem;z-index:1;display:flex;justify-content:space-between}.to-live,.to-any{gap:.4rem;padding:.4rem 1rem;border-radius:.4rem;background:#d4f02b;color:#0f2a1f;font-size:1.4rem}.to-any{display:none!important}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<header class=\"head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"state\"><span class=\"between isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">BETWEEN GAMES</span><span class=\"stx\"><span class=\"gstack\"><span class=\"gs isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\">GAME 1</span><span class=\"gs isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\">GAME 2</span><span class=\"gs isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\">GAME 3</span><span class=\"gs isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\">GAME 4</span><span class=\"gs isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\">GAME 5</span></span></span></span><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></header>\n<div class=\"face rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"team a columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"srvl\"><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"pball\"></i><b class=\"sn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" isA=\"true\" data-osb-component=\"field\" style=\"opacity:0\">2</i></b></span><span class=\"st\"><span class=\"to-used isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\">T/O USED</span><span class=\"cards\"><span class=\"card yc isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span><span class=\"card rc isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></span></span></div><span class=\"won num currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"dash\">:</span><span class=\"won num currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"team b columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"srvl\"><span class=\"st\"><span class=\"to-used isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\">T/O USED</span><span class=\"cards\"><span class=\"card yc isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span><span class=\"card rc isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></span><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"pball\"></i><b class=\"sn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" data-osb-component=\"field\" style=\"opacity:0\">2</i></b></span></span></div></div>\n<div class=\"lbl\">GAMES WON</div>\n<div class=\"table rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"rl\"><span>GAME</span><i class=\"rc jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><i class=\"rc jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i></span><span class=\"hcol isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\"><b class=\"hh\">G1</b><span class=\"ha num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><span class=\"hb num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span><span class=\"hcol isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\"><b class=\"hh\">G2</b><span class=\"ha num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><span class=\"hb num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span><span class=\"hcol isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\"><b class=\"hh\">G3</b><span class=\"ha num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><span class=\"hb num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span><span class=\"hcol isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\"><b class=\"hh\">G4</b><span class=\"ha num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><span class=\"hb num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span><span class=\"hcol hlast isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\"><b class=\"hh\">G5</b><span class=\"ha num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><span class=\"hb num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div>\n<footer class=\"foot rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span><span class=\"live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">MATCH LIVE</span></span><div class=\"mid columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"pt-slot\"><span class=\"pt isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"pt isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"cbox\">SCORE CALL <span class=\"call\"><span class=\"ca num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"cd1\">-</i><span class=\"cb num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><i class=\"cd2\">-</i><b class=\"cn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" isA=\"true\" data-osb-component=\"field\" style=\"opacity:0\">2</i><i class=\"two isSecondServer\" data-osb-component=\"field\" style=\"opacity:0\">2</i></b></span></span></div><span>CURRENT <span class=\"pts num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span> - <span class=\"pts num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></footer>\n<div class=\"tolive\"><span class=\"to-live isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT <span class=\"to-clock num timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</span></span><span class=\"to-any isTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isTimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT</span><span class=\"to-live isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT <span class=\"to-clock num timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</span></span></div><span class=\"dbl-probe playerA2\" data-osb-component=\"field\" data-osb-field=\"playerA2\"></span><span class=\"tie\"><img class=\"logo teamLogoURLA\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><i class=\"tchip teamJerseyColorA\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorA\"></i><span class=\"tn teamAName\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"ts num teamAScore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span><i class=\"tdash\">-</i><span class=\"ts num teamBScore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span><span class=\"tn teamBName\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><i class=\"tchip teamJerseyColorB\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorB\"></i><img class=\"logo teamLogoURLB\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"></span></section></main>\n</body>\n</html>\n","css":""}
