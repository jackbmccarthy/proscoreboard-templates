{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Charcoal Outline Sidecar — Basketball horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.shell{position:relative;width:min(96vw,1880px,calc((100vh - 32px)*8));max-width:100%;padding-top:40px;container-type:inline-size}.sport-tag{position:absolute;top:0;left:0;display:flex;align-items:center;height:40px;min-width:240px;padding:0 25px;background:#dce3e2;color:#20272c;font-size:1.55cqw;font-weight:800;letter-spacing:.07em;line-height:1;white-space:nowrap}.board{display:flex;width:100%;height:145px;min-width:0;overflow:hidden;background:#20272c;color:#f2f3ee;border:1px solid #a8b8bc;border-radius:2px;font-variant-numeric:tabular-nums}.competitors{display:flex;flex:1 1 74%;min-width:0}.competitor{display:flex;align-items:center;flex:1 1 0;min-width:0}.competitor+.competitor{border-left:1px solid #a8b8bc}.identity{display:block;flex:none;width:16px;height:86%;margin-left:16px;background:#087bf0}.jerseyColorB{background:#ef2535}.name{display:block;flex:1 1 0;min-width:0;margin-left:28px;padding-right:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:4.15cqw;font-weight:700;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex:none;width:22%;height:80%;margin-right:15px;border:1px solid #a8b8bc;background:#20272c}.score{display:block;width:100%;text-align:center;font-size:6cqw;font-weight:800;line-height:1;color:#fff;white-space:nowrap;font-variant-numeric:tabular-nums}.dock{display:flex;flex:0 0 26%;min-width:0;align-items:stretch;background:#dce3e2;color:#20272c}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;flex-direction:column;gap:11px;white-space:nowrap}.stat+.stat{border-left:1px solid #7e958f}.clock{flex:1.4 1 0}.stat-label{font-size:1.35cqw;font-weight:700;letter-spacing:.07em}.stat-value{font-size:2.65cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.stage{padding:9px}.shell{width:100%;padding-top:22px}.sport-tag{height:22px;min-width:106px;padding:0 7px;font-size:10px;letter-spacing:0}.board{height:77px}.competitors{flex-basis:68%}.identity{width:4px;height:80%;margin-left:4px}.name{margin-left:5px;padding-right:2px;font-size:clamp(11px,3.2cqw,14px)}.score-track{width:37px;height:75%;margin-right:3px}.score{font-size:clamp(21px,6.6cqw,28px)}.dock{flex-basis:32%}.stat{gap:5px}.clock{flex:1.6 1 0}.stat-label{font-size:clamp(7px,1.9cqw,9px);letter-spacing:0}.stat-value{font-size:clamp(11px,3cqw,14px)}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.shell{padding-top:2.2cqw}.sport-tag{height:2.2cqw}.board{height:7.4cqw}@media(max-width:700px){.shell{padding-top:22px}.sport-tag{height:22px}.board{height:77px}}\n.score{font-size:4.6cqw}\n@media(max-width:700px){.score{font-size:19px}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><div class=\"shell\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">BASKETBALL</span><article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Basketball scoreboard\"><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><aside class=\"dock rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static basketball counters\"><div class=\"stat clock\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">PERIOD</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">SHOT</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"shot-clock\">00</span></div></aside><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></div></main></body></html>\n","css":""}
