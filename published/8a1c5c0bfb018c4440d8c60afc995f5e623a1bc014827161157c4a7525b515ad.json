{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pewter Columnhead — Soccer compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.package{width:min(82vw,800px);max-width:100%;color:#25343a;container-type:inline-size}.caps{height:60px;display:flex;align-items:stretch}.cap-name{flex:1 1 0;min-width:0;display:flex;align-items:stretch}.sport-tab,.score-cap{height:100%;display:flex;align-items:center;justify-content:center;background:#25343a;color:#f5f7f4;border-radius:4px 4px 0 0;font-weight:800;letter-spacing:.025em;white-space:nowrap}.sport-tab{padding:0 32px;font-size:3.2cqw}.score-cap{flex:0 0 29%;font-size:3.2cqw}.board{display:flex;flex-direction:column;width:100%;height:250px;overflow:hidden;border:1px solid #8da1a5;border-radius:0 0 4px 4px;background:#dfe6e5;font-variant-numeric:tabular-nums}.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0}.team+.team{border-top:1px solid #8da1a5}.name-track{display:flex;align-items:center;flex:1 1 0;min-width:0}.identity{flex:none;display:block;align-self:stretch;width:17px;background:#167bea}.jerseyColorB{background:#ea2637}.name{flex:1 1 0;min-width:0;display:block;margin-left:35px;padding-right:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:7.6cqw;font-weight:700;line-height:1.1}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex:0 0 29%;min-width:0;border-left:1px solid #8da1a5;background:#bccdd0}.score{display:block;min-width:0;width:100%;overflow:hidden;text-align:center;white-space:nowrap;font-size:8.6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.stage{padding:8px}.package{width:100%}.caps{height:28px}.sport-tab{padding:0 11px;font-size:12px}.score-cap{font-size:12px}.board{height:134px}.identity{width:6px}.name{margin-left:9px;padding-right:3px;font-size:clamp(19px,5cqw,24px)}.score{font-size:clamp(29px,8cqw,34px)}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><div class=\"package\" data-osb-component=\"layout\"><div class=\"caps rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"cap-name\" data-osb-component=\"layout\"><span class=\"sport-tab sport-tag\" data-osb-component=\"text\">SOCCER</span></div><span class=\"score-cap\" data-osb-component=\"text\">GOALS</span></div><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></div></main></body></html>\n","css":""}
