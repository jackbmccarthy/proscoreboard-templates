{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Violet Ash Open Register — Soccer compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:6px}.board{width:min(65vw,1160px);aspect-ratio:2.7;display:flex;flex-direction:column;overflow:hidden;border:2px solid #b4bfc4;border-radius:4px;background:#e7e8ec;color:#28323d;container-type:inline-size;font-variant-numeric:tabular-nums}.header{height:17%;min-height:0;display:flex;align-items:center;gap:2%;padding:0 2%;border-bottom:2px solid #b4bfc4;background:transparent;white-space:nowrap}.sport-tag{flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:3cqw;font-weight:750}.stat{display:flex;align-items:baseline;gap:.5em;flex:none;font-size:2.1cqw;font-weight:700}.stat-value{font-variant-numeric:tabular-nums}.divider{height:60%;width:2px;background:#b4bfc4}.teams{height:83%;min-height:0;display:flex;flex-direction:column}.team{display:flex;flex:1 1 0;min-height:0}.team+.team{border-top:2px solid #b4bfc4}.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;gap:4%;padding:0 1.8%}.identity{flex:none;width:1.5%;height:72%;background:#2677c7}.jerseyColorB{background:#e65e65}.name{display:block;flex:1 1 0;width:100%;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:\"Arial Narrow\",Arial,Helvetica,sans-serif;font-size:6.5cqw;font-weight:700;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.numeric-track{display:flex;flex:0 0 16%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:3%;padding:0 1%;background:transparent}.support-row{display:flex;align-items:baseline;justify-content:center;gap:.35em;white-space:nowrap;font-family:\"Arial Narrow\",Arial,Helvetica,sans-serif;font-size:2cqw;font-weight:700}.support-value{font-variant-numeric:tabular-nums}.primary-row{display:flex;width:100%;flex-direction:column;align-items:center;justify-content:center;gap:0;white-space:nowrap}.primary-label{font-family:\"Arial Narrow\",Arial,Helvetica,sans-serif;font-size:1.95cqw;font-weight:700}.score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:6.6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;height:165px;aspect-ratio:auto;border-width:1px;border-radius:3px}.header,.team+.team{border-width:1px}.sport-tag{font-size:2.7cqw}.stat{font-size:2.1cqw;gap:.3em}.divider{width:1px}.identity{width:4px}.name{font-size:6.2cqw}.numeric-track{flex-basis:20%;gap:2%}.support-row{font-size:2cqw}.primary-label{font-size:2cqw}.score{font-size:6.8cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(68vw,1240px);aspect-ratio:3.18}.header{height:18%}.teams{height:82%}.sport-tag{font-size:3.1cqw}.stat{font-size:2.7cqw}.name{font-size:6cqw}.numeric-track{flex-basis:17%}.support-row{font-size:2.1cqw}.primary-row{flex-direction:row;justify-content:space-between;gap:2%}.primary-label{font-size:2cqw}.score{font-size:6.3cqw}@media(max-width:520px){.board{width:100%;height:165px;aspect-ratio:auto}.header{height:18%}.teams{height:82%}.sport-tag{font-size:3cqw}.stat{font-size:2.5cqw}.name{font-size:6.2cqw}.numeric-track{flex-basis:20%}.support-row{font-size:2cqw}.primary-label{font-size:2cqw}.score{font-size:6.3cqw}}\n.primary-row{width:100%}.primary-label{font-size:1.5cqw}.score{font-size:5.8cqw}@media(max-width:520px){.primary-label{font-size:1.8cqw}.score{font-size:5.8cqw}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><span class=\"divider\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"half\" data-osb-static=\"true\">0</span></div></div><div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"numeric-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"support-row\" data-osb-component=\"layout\"><span data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsA\" data-osb-static=\"true\">0</span></div><div class=\"primary-row\" data-osb-component=\"layout\"><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"numeric-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"support-row\" data-osb-component=\"layout\"><span data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsB\" data-osb-static=\"true\">0</span></div><div class=\"primary-row\" data-osb-component=\"layout\"><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
