{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Outfield Wall</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}\n.slab{position:relative;flex:none;overflow:hidden}.slab>.jc{position:absolute;inset:0}\n.slab>.home{position:absolute;left:50%;bottom:.35rem;width:.8rem;height:.82rem;margin-left:-.4rem;background:#fff;clip-path:polygon(0 0,100% 0,100% 58%,50% 100%,0 58%)}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.25rem)}\n.dot{position:relative;flex:none;width:var(--dot,.82rem);height:var(--dot,.82rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18))}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inn-n{min-width:1.1em;text-align:left}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:.5em;overflow-wrap:normal;word-break:normal;hyphens:none}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:has(+.ev-r:not(:empty))::after{content:\"\\00b7\";margin-left:.5em;opacity:.75}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end;white-space:nowrap}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.4em}.st-live-in>i{flex:none;width:.8rem;height:.8rem;border-radius:50%;background:var(--live,#ff3b30);box-shadow:0 0 .45rem var(--live,#ff3b30);animation:osb-pulse 1.4s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.7}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ls{display:flex}\n.ls-col{position:relative}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.ls-gate{display:flex;flex-direction:column;position:relative}\n.ls-c{position:relative;display:flex;align-items:center;justify-content:center}\n\n.ls-cur{position:absolute;inset:0;pointer-events:none}\n.tick{position:relative}.tick>.tick-on,.tick>.tick-cur{position:absolute;inset:0;border-radius:inherit}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;left:2rem;top:1.6rem;color:#f5f3ea;font-family:\"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;--live:#ff5a45}\n.wall{width:29rem;padding:.6rem .7rem .6rem;border-radius:.35rem;background:#1f4d33;box-shadow:0 .45rem 1.2rem rgba(0,0,0,.5),inset 0 0 0 .2rem #163a26}\n.topr{display:flex;align-items:flex-start;justify-content:space-between;gap:.8rem;min-height:1.6rem;padding:.1rem .2rem 0;font:700 1.1rem/1.2 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#c9d8c6;--evlh:1.2}\n\n.ev{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:1em;overflow:hidden;min-width:0;--evg:1em}\n.ev>span{min-width:0;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.ev>.ev-e::after{content:none!important}\n.ev>.ev-r{margin-left:calc(-1 * var(--evg));padding-left:var(--evg);background:radial-gradient(circle closest-side,currentColor 62%,transparent 76%) calc((var(--evg) - .36em) / 2) 46%/.36em .36em no-repeat}\n.ev.one{height:calc(1em * var(--evlh));line-height:var(--evlh)}\n.topr .st{flex:none;justify-items:end;color:#f5f3ea}\n\n.st-pre{color:#c9d8c6}\n.st-fin{padding:.2rem .5rem .14rem;border-radius:.2rem;background:#ffc93c;color:#10291c;letter-spacing:.14em}\n.grid{display:grid;grid-template-columns:1fr 1.5rem 3.6rem 2.5rem 2.5rem;column-gap:.32rem;align-items:center;margin-top:.3rem}\n.colh{height:1.4rem;display:flex;align-items:flex-end;justify-content:center;font:700 1.1rem/1 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.1em;color:#c9d8c6}\n.tm{display:contents}\n.nmw{min-width:0;display:flex;align-items:center;gap:.7rem;height:3.3rem}\n.slab{align-self:stretch;width:1.1rem;border-radius:.12rem;background:var(--fb)}.slab-a{--fb:#56739a}.slab-b{--fb:#a3634f}\n.nm{font:700 1.6rem/.98 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.035em;text-transform:uppercase;padding-top:.15rem}\n.sep{grid-column:1/-1;height:.1rem;margin:.28rem 0;background:#163a26}\n.batw{display:flex;justify-content:center}.bat{width:.85rem;height:.85rem;border-radius:50%;background:#ffc93c;box-shadow:0 0 .5rem #ffc93c}\n.cell{position:relative;display:flex;align-items:center;justify-content:center;height:2.9rem;background:#10291c;border-radius:.14rem;box-shadow:inset 0 .14rem .3rem rgba(0,0,0,.55);font:700 1.6rem/1 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;font-variant-numeric:tabular-nums}\n.cell>span{padding-top:.18rem}\n.cell.rc{height:3.2rem;font-size:2.5rem;color:#ffd34d}\n.rc>.win{position:absolute;inset:0;border-radius:.14rem;box-shadow:inset 0 0 0 .2rem #ffc93c,0 0 .6rem #ffc93c}\n\n.wall:has(.isBWinner[style*=\"opacity: 1\"]) .tm-a :is(.nm,.runs,.he),.wall:has(.isAWinner[style*=\"opacity: 1\"]) .tm-b :is(.nm,.runs,.he){color:#9fb3a5}\n.wall:has(.isBWinner[style*=\"opacity: 1\"]) .tm-a :is(.slab),.wall:has(.isAWinner[style*=\"opacity: 1\"]) .tm-b :is(.slab){opacity:.5}\n.lamps{position:relative;display:flex;align-items:center;justify-content:space-between;margin-top:.55rem;height:4.3rem;padding:0 .9rem 0 .85rem;background:#10291c;border-radius:.15rem;box-shadow:inset 0 .14rem .3rem rgba(0,0,0,.55)}\n\n.inn{display:flex;align-items:center;gap:.2rem;font:700 2.3rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;--half-on:#ffc93c;--half-off:rgba(255,255,255,.12);--half-h:2.3rem;--half-size:1.01rem}\n.inn{font-family:\"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;padding:.15rem 1rem 0 0;height:3rem;border-right:.1rem solid #163a26}\n.cl{flex:1;display:flex;align-items:center;justify-content:center;gap:.85rem}\n.diamond{--d:3.5rem;--base-edge:#f5f3ea;--base-off:transparent;--base-on:#ffc93c;--base-line:.14rem}\n.count{min-width:3.1rem;text-align:center;padding-top:.2rem;font:700 2.3rem/1 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;font-variant-numeric:tabular-nums;color:#f5f3ea}.count .dash{opacity:.6;margin:0 .06em}\n.lg{display:flex;flex-direction:column;align-items:flex-start;gap:.4rem;font:700 1rem/1 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.12em;color:#c9d8c6}\n.lamps .dots{--dot:.85rem;--dot-gap:.28rem;--dot-off:rgba(255,255,255,.12);--dot-on:#ffc93c}\n.lamps .ball-dots{--dot-on:#7be08f}.lamps .strike-dots{--dot-on:#ff6a55}\n.lamps .dot>.lit{box-shadow:0 0 .45rem var(--dot-on)}\n\n.cover{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;gap:.7rem;background:#10291c;text-transform:uppercase;text-align:center;white-space:nowrap}\n.cover b{font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#c9d8c6}\n.cover .pl{font:700 1.8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.06em;color:#f5f3ea}\n.cover{border-radius:.15rem}.cover b,.cover .pl{font-family:\"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif}.cover b{font-size:1.15rem}\n.foot{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;margin-top:.55rem;height:1.2rem;font:700 1.05rem/1 \"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.16em;color:#ffc93c}\n.foot .sp{justify-self:end}\n\n.prog{position:relative;display:flex;align-items:center}\n.ticks{display:flex;gap:0.26rem}.tick{width:1.15rem;height:0.3rem;border-radius:0.15rem;background:rgba(255,255,255,.12)}\n.tick>.tick-on{background:rgba(255,255,255,.45)}.tick>.tick-cur{background:#ffc93c}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .tick>.tick-on{background:#ffc93c}\n.foot:has(.xchip[style*=\"opacity: 1\"]) .sp{visibility:hidden}\n.xchip{position:absolute;left:calc(100% + .5rem);top:50%;transform:translateY(-50%);padding:.16rem .38rem .1rem;border-radius:.2rem;background:#ffc93c;color:#10291c;font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em;white-space:nowrap}\n.xchip{font-family:\"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;font-size:1.05rem;padding:.14rem .36rem .06rem}\n</style></head><body><main class=\"board\" aria-label=\"Baseball corner scoreboard\">\n<article class=\"wall columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball wall scoreboard\">\n<div class=\"topr\"><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span><span class=\"st-fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\">FINAL</span></span></div>\n<div class=\"grid\"><i></i><i></i><span class=\"colh\">R</span><span class=\"colh\">H</span><span class=\"colh\">E</span><span class=\"tm tm-a\"><span class=\"nmw\"><span class=\"slab slab-a\"><span class=\"jc jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"home isAHome\" data-osb-component=\"field\" data-osb-field=\"isAHome\" style=\"opacity: 0\"></span></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"batw\"><span class=\"bat isABatting\" data-osb-component=\"field\" data-osb-field=\"isABatting\" style=\"opacity: 0\"></span></span><span class=\"cell rc\"><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0\"></span><span class=\"runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"cell\"><span class=\"he hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span></span><span class=\"cell\"><span class=\"he errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span></span></span><span class=\"sep\"></span><span class=\"tm tm-b\"><span class=\"nmw\"><span class=\"slab slab-b\"><span class=\"jc jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"home isBHome\" data-osb-component=\"field\" data-osb-field=\"isBHome\" style=\"opacity: 0\"></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span><span class=\"batw\"><span class=\"bat isBBatting\" data-osb-component=\"field\" data-osb-field=\"isBBatting\" style=\"opacity: 0\"></span></span><span class=\"cell rc\"><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0\"></span><span class=\"runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"cell\"><span class=\"he hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span></span><span class=\"cell\"><span class=\"he errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></span></span></div>\n<div class=\"lamps\"><span class=\"inn\"><span class=\"half\" aria-hidden=\"true\"><span class=\"half-dim\"></span><span class=\"half-win\"><span class=\"inningHalf\" data-osb-component=\"field\"></span></span></span><span class=\"inn-n inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"cl\"><span class=\"diamond\" aria-label=\"Bases\"><span class=\"base second\"><span class=\"runner isRunnerOnSecond\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnSecond\" style=\"opacity: 0\"></span></span><span class=\"base third\"><span class=\"runner isRunnerOnThird\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnThird\" style=\"opacity: 0\"></span></span><span class=\"base first\"><span class=\"runner isRunnerOnFirst\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnFirst\" style=\"opacity: 0\"></span></span></span><span class=\"count\"><span class=\"cb balls\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"dash\" aria-hidden=\"true\">-</span><span class=\"cs strikes\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"lg\">BALL<span class=\"dots ball-dots\"><span class=\"dot\"><span class=\"lit isBall1\" data-osb-component=\"field\" data-osb-field=\"isBall1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall2\" data-osb-component=\"field\" data-osb-field=\"isBall2\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall3\" data-osb-component=\"field\" data-osb-field=\"isBall3\" style=\"opacity: 0\"></span></span></span></span><span class=\"lg\">STRIKE<span class=\"dots strike-dots\"><span class=\"dot\"><span class=\"lit isStrike1\" data-osb-component=\"field\" data-osb-field=\"isStrike1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isStrike2\" data-osb-component=\"field\" data-osb-field=\"isStrike2\" style=\"opacity: 0\"></span></span></span></span><span class=\"lg\">OUT<span class=\"dots out-dots\"><span class=\"dot\"><span class=\"lit isOut1\" data-osb-component=\"field\" data-osb-field=\"isOut1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isOut2\" data-osb-component=\"field\" data-osb-field=\"isOut2\" style=\"opacity: 0\"></span></span></span></span></span><span class=\"cover brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0\"><b>End of</b><span class=\"pl periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\"></span></span><span class=\"cover fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\"><b>After</b><span class=\"pl\"><span class=\"fi inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span> innings</span></span></div>\n<div class=\"foot\"><i></i><span class=\"prog\"><span class=\"ticks\" aria-label=\"Innings\"><span class=\"tick\"><span class=\"tick-on isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning1Current\" data-osb-component=\"field\" data-osb-field=\"isInning1Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning2Current\" data-osb-component=\"field\" data-osb-field=\"isInning2Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning3Current\" data-osb-component=\"field\" data-osb-field=\"isInning3Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning4Current\" data-osb-component=\"field\" data-osb-field=\"isInning4Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning5Current\" data-osb-component=\"field\" data-osb-field=\"isInning5Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning6Current\" data-osb-component=\"field\" data-osb-field=\"isInning6Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning7Current\" data-osb-component=\"field\" data-osb-field=\"isInning7Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame8Started\" data-osb-component=\"field\" data-osb-field=\"isGame8Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning8Current\" data-osb-component=\"field\" data-osb-field=\"isInning8Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame9Started\" data-osb-component=\"field\" data-osb-field=\"isGame9Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning9Current\" data-osb-component=\"field\" data-osb-field=\"isInning9Current\" style=\"opacity: 0\"></span></span></span><span class=\"xchip isGame10Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span>TH</span></span><i></i></div>\n</article>\n<span class=\"sr\"><span class=\"battingSide\" data-osb-component=\"field\" data-osb-field=\"battingSide\"></span><span class=\"bases\" data-osb-component=\"field\" data-osb-field=\"bases\"></span><span class=\"outs\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></span><span class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></span></span>\n</main></body></html>\n","css":""}
