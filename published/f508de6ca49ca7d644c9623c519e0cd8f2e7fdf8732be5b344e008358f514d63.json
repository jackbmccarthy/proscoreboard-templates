{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Hinge Rail PICKLEBALL 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:\"Courier New\",monospace;font-weight:700;color:#f3efdf}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh}.board{width:min(var(--board-width),1400px);display:flex;flex-direction:column;position:relative;container-type:inline-size}.rail{background:#202a2a;border-radius:.75cqw}.header{display:flex;align-items:center;justify-content:center;min-height:var(--header-height);font-family:Arial,sans-serif;font-size:var(--header-font);letter-spacing:var(--header-spacing);line-height:1;white-space:nowrap}.identity-name{display:flex;align-items:center;min-width:0;position:relative}.name{display:block;width:100%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--name-font);letter-spacing:.08cqw;line-height:1.1}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{width:0;height:0;flex:0 0 0}.serve{position:absolute;width:1.4cqw;height:1.4cqw;font-size:1.4cqw;right:.5cqw;top:0}.module{display:flex;align-items:center;justify-content:center;width:100%;height:var(--module-height);position:relative;background:#f1ecde;border:1px solid #e9e4d6;border-radius:.85cqw;color:#030403}.module:after{content:\"\";position:absolute;left:0;right:0;top:50%;height:1px;background:#514c43;pointer-events:none}.score{display:block;width:100%;min-width:0;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",monospace;font-size:var(--score-font);font-weight:700;line-height:1;text-align:center;letter-spacing:-.06em;font-variant-numeric:tabular-nums;white-space:nowrap}.tab{position:absolute;top:50%;transform:translateY(-50%);width:.85cqw;height:2.7cqw;background:#bc825b;border:1px solid #704e36;border-radius:.15cqw;z-index:1}.tab-left{left:-.45cqw}.tab-right{right:-.45cqw}.label{font-size:var(--label-font);line-height:1;letter-spacing:.45cqw;text-align:center;white-space:nowrap}.point-slot{position:absolute;top:calc(100% + .9cqw);left:50%;transform:translateX(-50%);width:30cqw;height:2cqw;font:700 1.6cqw Arial,sans-serif;text-align:center}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw}.label{font-size:2.25cqw;letter-spacing:.35cqw}.module{border-width:.5px}.tab{border-width:.5px}.point-slot{font-size:2.2cqw;height:2.5cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--board-width:64vw;--header-height:5.5cqw;--header-font:3.8cqw;--header-spacing:.9cqw;--name-font:7.1cqw;--module-height:11.9cqw;--score-font:10cqw;--label-font:1.85cqw;gap:.8cqw}.rows{display:flex;flex-direction:column;gap:.7cqw;}.row{display:flex;align-items:center;min-height:18.3cqw;padding:2cqw 4cqw;gap:3cqw}.identity-name{flex:1;min-width:0}.numbers{display:flex;flex:0 0 34%;justify-content:space-between;gap:4cqw;align-items:flex-end}.cell{flex:1;min-width:0;display:flex;flex-direction:column;gap:1.4cqw}.row+.row{}.numbers{position:relative}.numbers:before{content:\"\";position:absolute;left:-3.2cqw;top:-2cqw;bottom:-2cqw;width:1px;background:#0b1010}\n.label{font-family:Arial,Helvetica,sans-serif}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header rail\">PICKLEBALL</header><div class=\"rows columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"row rowContainer rail\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-name\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"numbers\"><div class=\"cell\"><div class=\"label\">GAMES</div><div class=\"module\"><span class=\"score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><i class=\"tab tab-left\" aria-hidden=\"true\"></i><i class=\"tab tab-right\" aria-hidden=\"true\"></i></div></div><div class=\"cell\"><div class=\"label\">POINTS</div><div class=\"module\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"tab tab-left\" aria-hidden=\"true\"></i><i class=\"tab tab-right\" aria-hidden=\"true\"></i></div></div></div></div><div class=\"row rowContainer rail\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-name\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"numbers\"><div class=\"cell\"><div class=\"label\">GAMES</div><div class=\"module\"><span class=\"score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><i class=\"tab tab-left\" aria-hidden=\"true\"></i><i class=\"tab tab-right\" aria-hidden=\"true\"></i></div></div><div class=\"cell\"><div class=\"label\">POINTS</div><div class=\"module\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><i class=\"tab tab-left\" aria-hidden=\"true\"></i><i class=\"tab tab-right\" aria-hidden=\"true\"></i></div></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
