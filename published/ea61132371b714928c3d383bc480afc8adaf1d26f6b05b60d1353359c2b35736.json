{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Arena Split</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\nhtml,body{height:100%;overflow:hidden}\n.osb-core-fields{display:none!important}\n.end[data-osb-resolved-court-side=\"A\"] .isBWinner,.end[data-osb-resolved-court-side=\"B\"] .isAWinner,.end:not([data-osb-resolved-court-side]) :is(.isAWinner,.isBWinner){display:none!important}\n.hg:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;padding:0!important;margin:0!important;border:0!important}\n.hg .won{display:none}\n.name{overflow-wrap:normal;word-break:normal;hyphens:none}\n/* status chips flow: an empty chip takes no room, so both ends keep the same packed order */\n.to-slot:not(:has(>[style*=\"opacity: 1\"])),.card:not([style*=\"opacity: 1\"]){display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .big{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n\n.board{position:fixed;inset:0;display:flex;flex-direction:column;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:#060b14;-webkit-font-smoothing:antialiased;overflow:hidden}\n.ends{display:flex;flex:1 1 auto;min-height:0;gap:.5vw}\n.end{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);grid-template-rows:auto 16vh minmax(0,1fr) 8vh 14vh;grid-template-areas:\"band band band\" \"who who who\" \"pts pts pts\" \"hist hist hist\" \"rl gw rr\";column-gap:1.2vw;flex:1 1 0;min-width:0;padding:0 2.4vw 2.6vh;background:#0d1a2e;overflow:hidden}\n.eB{background:#101f37}\n.kit{position:absolute;left:0;right:0;top:0;height:1.4vh;background:#5b6c86}\n.tband{grid-area:band;min-width:0;display:none;align-items:center;gap:1.4vw;margin-top:2.6vh;padding:0 1.6vw;min-height:7.5vh;border-radius:1vh;background:#16294a;font-size:3.4vh;font-weight:800;letter-spacing:.05em;text-transform:uppercase}\n.board:has(.tname:not(:empty)) .tband{display:flex}\n.tband .tlogo{width:5vh;height:5vh;object-fit:contain;flex:0 0 auto}\n.tband .tname{flex:1 1 auto;min-width:0;line-height:1.05;overflow-wrap:normal;hyphens:none}\n.tband .tie{display:inline-flex;align-items:center;gap:1vw;flex:0 0 auto;height:5.4vh;padding:0 1.2vw;border-radius:.7vh;background:#ffd23f;color:#111}\n.tband .tie i{font-style:normal;font-size:2.8vh;letter-spacing:.14em}\n.tband .tscore{font-size:4.2vh;font-variant-numeric:tabular-nums}\n/* name block: flag, name and serve ball travel as one centred group; a wrapped name stays flush beside its flag */\n.who{grid-area:who;display:flex;align-items:center;justify-content:center;gap:1.4vw;min-width:0;padding-top:2.6vh}\n.flag{flex:0 0 auto;width:7.2vh;height:4.8vh;object-fit:cover;border-radius:.4vh;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.nm{flex:0 1 auto;min-width:0;text-align:left}\n.name{display:block;font-size:6vh;line-height:1.02;font-weight:800;text-transform:uppercase}\n.ss{width:7.5vh;height:7.5vh}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .5vh rgba(0,0,0,.25),0 0 3vh rgba(255,138,28,.55)}\n.pts{grid-area:pts;display:flex;align-items:center;justify-content:center;min-height:0}\n.big{font-size:48vh;line-height:.78;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n.hist{grid-area:hist;position:relative;display:flex;align-items:center;justify-content:center;gap:.8vw}\n.hg{display:flex;align-items:center;gap:.7vw;height:6.4vh;padding:0 1.2vw;border-radius:.7vh;font-weight:800;font-variant-numeric:tabular-nums;background:#1d3354;color:#c6d4ec}\n.hl{font-style:normal;font-size:2.8vh;letter-spacing:.1em}\n.gs{font-size:4.2vh}\n.end[data-osb-resolved-court-side=\"A\"] .hg:has(.wA[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"] .hg:has(.wB[style*=\"opacity: 1\"]){background:#ffd23f;color:#111}\n/* the rail: GAMES tile dead centre under the points, time-out mirrored to its left, cards to its right */\n.gw{grid-area:gw;justify-self:center;align-self:center;display:flex;flex-direction:column;align-items:center;justify-content:center;width:15vh;height:13vh;border-radius:1.2vh;background:#ffd23f;color:#111;font-weight:900;text-transform:uppercase}\n.gw i{font-style:normal;font-size:2.4vh;letter-spacing:.2em;line-height:1}\n.gn{font-size:9vh;line-height:.95;font-variant-numeric:tabular-nums}\n.rl,.rr{display:flex;align-items:center;gap:.8vw;min-width:0}\n.rl{grid-area:rl;justify-content:flex-end}\n.rr{grid-area:rr;flex-direction:column;align-items:flex-start;justify-content:center;gap:.8vh}\n.to-slot{width:15vh;height:6vh}\n.to-on,.to-used{border-radius:.7vh;font-size:2.7vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.to-on{background:#fff;color:#0d1a2e}\n.to-used{background:#2a4570;color:#e6eefb}\n.card{display:inline-flex;align-items:center;gap:.7vw;height:6vh;padding:0 1.4vw 0 1vw;border-radius:.7vh;font-size:2.7vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase;background:#1d3354;color:#fff;white-space:nowrap}\n.card b{flex:0 0 auto;width:2.9vh;height:4vh;border-radius:.4vh;box-shadow:0 0 0 .25vh rgba(0,0,0,.35)}\n.yc b{background:#ffd400}.rc b{background:#e3262f}\n.win:not([style*=\"opacity: 1\"]){display:none}\n.win{grid-area:gw;justify-self:center;align-self:center;display:flex;align-items:center;justify-content:center;height:8vh;padding:0 2vw;border-radius:1vh;background:#ffd23f;color:#111;font-size:3.6vh;font-weight:900;letter-spacing:.16em;text-transform:uppercase}\n/* status bar: event on the left, the game tag dead centre, the state banner (or the match format) on the right */\n.bar{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:2vw;flex:0 0 14vh;padding:0 2vw;background:#060b14}\n.info{display:flex;flex-direction:column;justify-content:center;gap:.6vh;min-width:0;text-transform:uppercase;white-space:nowrap}\n.info>*{overflow:hidden;text-overflow:ellipsis}\n.ev{font-size:4vh;font-weight:800;letter-spacing:.06em}\n.rd{font-size:3.2vh;font-weight:700;letter-spacing:.08em;color:#93a9c9}\n.rd:empty{display:none}\n.teamlbl{display:none;font-size:4vh;font-weight:800;letter-spacing:.08em}\n.info:not(:has(.ev:not(:empty))):not(:has(.rd:not(:empty))) .teamlbl{display:block}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.tagslot{width:33vh;height:9vh}\n.tagslot>*{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.gtag{background:#1d3354;color:#fff}\n.pre{box-shadow:inset 0 0 0 .4vh #2a4570;color:#93a9c9}\n.tagslot:has(>.gtag[style*=\"opacity: 1\"]) .pre,.tagslot:has(>.fin[style*=\"opacity: 1\"]) .pre{opacity:0}\n.fin{background:#fff;color:#111}\n.right{display:flex;align-items:center;justify-content:flex-end;gap:1vw;min-width:0}\n.chip{width:21vh;height:6vh}\n.fl{border-radius:.7vh;font-size:2.7vh;font-weight:800;letter-spacing:.06em;text-transform:uppercase;background:#1d3354;color:#e6eefb}\n.banner{width:40vh;height:9vh}\n.bn{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.bn-warm,.bn-break{background:#1d3354;color:#e6eefb}\n.bn-gp{background:#ff8a1c;color:#111}\n.bn-mp{background:#e3262f;color:#fff}\n.banner>.bo{justify-content:flex-end;font-size:4vh;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#93a9c9}\n.board:not(:has(.isMatchStarted[style*=\"opacity: 1\"])) .banner:has(>.isWarmUpStarted[style*=\"opacity: 1\"])>.bo,\n.board:not(:has(.isComplete[style*=\"opacity: 1\"])) .banner:has(>:is(.isInBetweenGames,.isGamePoint,.isMatchPoint)[style*=\"opacity: 1\"])>.bo{opacity:0}\n/* team tie */\n.board:has(.tname:not(:empty)) .who{padding-top:1.4vh}\n.board:has(.tname:not(:empty)) .big{font-size:40vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.who,.pts,.hist,.gw,.rl,.rr,.bar){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband{grid-row:1 / -1;grid-column:1 / -1;flex-direction:column;justify-content:center;gap:5vh;margin:6vh 0;background:none;font-size:7vh;text-align:center}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tlogo{width:14vh;height:14vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tname{flex:0 0 auto}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie{height:auto;padding:2vh 4vw;border-radius:1.6vh}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tscore{font-size:22vh;line-height:.9}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tband .tie i{font-size:4vh}\n/* final: games won becomes the big number, .board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]NER takes the tile's place on the rail */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{grid-area:pts;width:auto;height:auto;flex-direction:column-reverse;gap:2vh;background:none;color:#fff}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{font-size:40vh;line-height:.8}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw i{font-size:4.4vh;color:#c6d4ec}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]){grid-template-columns:minmax(0,1fr) 0 minmax(0,1fr);background:#0a1322}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]){box-shadow:inset 0 0 0 .8vh #ffd23f}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]) .gn{color:#ffd23f}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) :is(.name,.gn,.gw i){color:#8fa3c4}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]) .flag{opacity:.55}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]):not(:has(.rl [style*=\"opacity: 1\"])) .rr{grid-column:1 / -1;align-items:center}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]):not(:has(.rr .card[style*=\"opacity: 1\"])) .rl{grid-column:1 / -1;justify-content:center}\n</style>\n</head>\n<body>\n<main class=\"board t-arena\" data-osb-component=\"layout\"><div class=\"ends\" data-osb-component=\"layout\"><div class=\"courtSideAView end eA\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"tband\" data-osb-component=\"layout\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tie\"><i>Tie</i><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></div><div class=\"who\" data-osb-component=\"layout\"><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nm\"><span class=\"courtSideCombinedAName name\" data-osb-component=\"field\" data-osb-field=\"courtSideCombinedAName\"></span></span><span class=\"slot ss\"><span class=\"courtSideIsACurrentlyServing ball\" data-osb-component=\"field\" data-osb-field=\"courtSideIsACurrentlyServing\" style=\"opacity:0\"></span></span></div><div class=\"pts\" data-osb-component=\"layout\"><span class=\"courtSideAGameScore big\" data-osb-component=\"field\" data-osb-field=\"courtSideAGameScore\">0</span></div><div class=\"hist\" data-osb-component=\"layout\"><span class=\"hg isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><i class=\"hl\">G1</i><span class=\"isGame1AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"isGame1BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hg isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><i class=\"hl\">G2</i><span class=\"isGame2AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"isGame2BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hg isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><i class=\"hl\">G3</i><span class=\"isGame3AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></span><span class=\"isGame3BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></span><span class=\"game3AScore gs\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"hg isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><i class=\"hl\">G4</i><span class=\"isGame4AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></span><span class=\"isGame4BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></span><span class=\"game4AScore gs\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"hg isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><i class=\"hl\">G5</i><span class=\"isGame5AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></span><span class=\"isGame5BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></span><span class=\"game5AScore gs\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"hg isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><i class=\"hl\">G6</i><span class=\"isGame6AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame6AWon\" style=\"opacity:0\"></span><span class=\"isGame6BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame6BWon\" style=\"opacity:0\"></span><span class=\"game6AScore gs\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"hg isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><i class=\"hl\">G7</i><span class=\"isGame7AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame7AWon\" style=\"opacity:0\"></span><span class=\"isGame7BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame7BWon\" style=\"opacity:0\"></span><span class=\"game7AScore gs\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span></div><div class=\"rl\" data-osb-component=\"layout\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">Time-out</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O used</span></span></div><span class=\"gw\"><i>Games</i><span class=\"courtSideAMatchScore gn\" data-osb-component=\"field\" data-osb-field=\"courtSideAMatchScore\">0</span></span><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\">Winner</span><span class=\"isBWi