{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Marine Pearl Centerbank, horizontal</title><style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#23343b}\n.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{--navy:#152f3c;--pearl:#edf0ed;--marine:#284e5d;--ink:#23343b;--rule:#90a8a7;position:relative;display:flex;flex-direction:row;min-width:0;max-width:100%;overflow:hidden;border:1px solid var(--rule);border-radius:2px;background:var(--pearl);container-type:inline-size}\n.board.compact{width:min(77vw,1460px,calc((100vh - 24px)*4))}\n.board.horizontal{width:min(92vw,1760px,calc((100vh - 24px)*8))}\n.sport-band{display:flex;align-items:center;justify-content:center;flex:0 0 17%;min-width:0;padding:0 1cqw;background:var(--navy);border-right:2px solid var(--rule);color:#fff;font-size:2.7cqw;font-weight:800;line-height:1.07;text-align:center;overflow-wrap:anywhere}\n.compact .sport-band{padding:0 .2cqw;font-size:2.45cqw}\n.data-area{display:flex;flex-direction:column;flex:1 1 0;min-width:0}\n.competitors{display:flex;flex-direction:row;min-width:0}\n.competitor{display:flex;align-items:stretch;min-width:0;flex:1 1 0;background:var(--pearl)}\n.compact .competitor{flex:0 0 auto;height:10cqw}\n.compact .competitor+.competitor{border-top:2px solid var(--rule)}\n.horizontal .competitor{height:6.6cqw}\n.horizontal.softball .competitor{height:7.8cqw}\n.identity{display:block;flex:0 0 2.8%;min-width:8px;background:#5d9387}\n.jerseyColorB{background:#6086a0}\n.name{display:block;align-content:center;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2.3cqw;font-size:3.25cqw;font-weight:700;line-height:1.08;color:var(--ink)}\n.compact.softball .name{font-size:5.5cqw}\n.combinedAName:empty:before{content:\"Team A\"}\n.combinedBName:empty:before{content:\"Team B\"}\n.score-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;min-width:0;background:var(--marine);border-left:2px solid var(--rule)}\n.compact .score-track{width:19%;border-right:0}\n.horizontal .score-track{width:14cqw}\n.horizontal .side-a .score-track{border-right:2px solid var(--rule)}\n.horizontal .side-b .score-track{border-left:0;border-right:2px solid var(--rule)}\n.score{display:block;width:100%;text-align:center;color:#fff;font-size:5.2cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.score-caption{display:block;margin-bottom:.15cqw;color:#fff;font-size:2.1cqw;font-weight:700;line-height:1}\n.stats{display:flex;align-items:stretch;min-width:0;background:var(--pearl);border-top:2px solid var(--rule)}\n.compact .stats{height:4.3cqw}\n.horizontal .stats{height:3.25cqw}\n.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;padding:0 .35cqw;white-space:nowrap}\n.stat+.stat{border-left:2px solid var(--rule)}\n.compact:not(.softball) .stat{flex-direction:column;gap:.3cqw}\n.compact.softball .stat,.horizontal .stat{gap:1.2cqw}\n.stat-label{color:var(--ink);font-size:1.75cqw;font-weight:700;line-height:1}\n.stat-value{color:var(--ink);font-size:2.6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){\n .board.compact,.board.horizontal{width:100%}\n .sport-band{font-size:10px;padding:0 2px;border-right-width:1px}\n .compact .sport-band{font-size:10px;padding:0 2px}\n .compact .competitor{height:58px}\n .horizontal .competitor,.horizontal.softball .competitor{height:74px}\n .identity{min-width:5px}\n .name{padding:0 4px;font-size:17px}\n .horizontal .name,.compact.softball .name{font-size:17px}\n .score-track,.horizontal .side-a .score-track,.horizontal .side-b .score-track{border-width:1px}\n .compact .score-track{width:54px}\n .horizontal .score-track{width:44px}\n .score{font-size:31px}\n .score-caption{font-size:10px;margin-bottom:1px}\n .compact .stats,.horizontal .stats{height:43px}\n .stat{padding:0 1px}\n .stat+.stat,.stats{border-width:1px}\n .compact.softball .stat,.horizontal .stat{flex-direction:column;gap:3px}\n .compact:not(.softball) .stat{gap:3px}\n .stat-label{font-size:8px}\n .stat-value{font-size:17px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board horizontal softball columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Softball scoreboard\">\n  <div class=\"sport-band\" data-osb-component=\"text\">SOFTBALL</div>\n  <div class=\"data-area columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n    <footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">INNING</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">BALLS</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">STRIKES</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">OUTS</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer>\n  </div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</article></main></body></html>\n","css":""}
