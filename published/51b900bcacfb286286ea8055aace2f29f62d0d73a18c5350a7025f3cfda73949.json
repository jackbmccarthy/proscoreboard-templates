{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Corner — Paper Card</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\n.stage{position:fixed;inset:0;display:flex;align-items:flex-start;justify-content:flex-start;padding:2.6vw 0 0 2.6vw;pointer-events:none}\n.board{font-size:1.25vw;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#15233f;width:max-content;-webkit-font-smoothing:antialiased}\n.grid{display:grid;grid-template-columns:minmax(13.6em,max-content) 3.9em 3.7em 3.7em 3.9em minmax(13.6em,max-content);grid-template-rows:1.9em 1.75em 3.3em auto auto;filter:drop-shadow(0 .35em .9em rgba(0,0,0,.45))}\n.lb{display:flex;align-items:center;justify-content:center;height:1.75em;background:#e3dac6;color:#5a5240;font-size:1em;font-weight:800;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}\n.lb-meta{grid-column:1 / -1;justify-content:flex-start;height:1.9em;padding:0 .8em;border-radius:.3em .3em 0 0;background:#15233f;color:#f4efe4;overflow:hidden}\n.lb-meta .meta{min-width:0}\n.lb-end{grid-column:6}.lb-st{grid-column:1}\n.teamlbl{display:none}\n.lb-meta:not(:has(.meta>:not(.sep):not(:empty))) .teamlbl{display:inline}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.lb-mid{grid-column:3 / span 2;display:block;position:relative;width:100%;background:#15233f;color:#fff}\n.lb-mid>*{font-weight:800;letter-spacing:.08em;text-transform:uppercase}\n.lb-mid:has(>.gtag[style*=\"opacity: 1\"]) .plbl,.lb-mid:has(>.fin[style*=\"opacity: 1\"]) .plbl{opacity:0}\n.fin{background:#c8102e;color:#fff}\n.nm{display:flex;align-items:center;gap:.5em;height:3.3em;background:#fbf7ee;min-width:0}\n.lb-meta{grid-row:1}.lb-gA{grid-column:2;grid-row:2}.lb-gB{grid-column:5;grid-row:2}.lb-mid,.lb-end,.lb-st{grid-row:2}\n.nA,.nB,.gw,.pt{grid-row:3}.gA{grid-column:2}.pA{grid-column:3}.pB{grid-column:4}.gB{grid-column:5}\n.nA{grid-column:1;padding-right:.55em;border-radius:0 0 0 .3em}\n.nB{grid-column:6;flex-direction:row-reverse;padding-left:.55em;border-radius:0 0 .3em 0}\n.kit{flex:0 0 .42em;align-self:stretch;background:#9aa3b2}\n.nA .kit{border-radius:0 0 0 .3em}.nB .kit{border-radius:0 0 .3em 0}\n.flag{flex:0 0 auto;width:1.75em;height:1.17em;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.2)}\n.who{display:flex;flex-direction:column;justify-content:center;flex:0 1 auto;min-width:0;max-width:10.2em}.nA .who{margin-right:auto}.nB .who{margin-left:auto}\n.nB .who{align-items:flex-end;text-align:right}\n.name{font-size:1.2em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;hyphens:none}\n.team{display:flex;align-items:center;gap:.35em;font-size:1em;font-weight:700;text-transform:uppercase;color:#5a5240}\n.nB .team{flex-direction:row-reverse}\n.tlogo{width:1.3em;height:1.3em;object-fit:contain;flex:0 0 auto}\n.tname{line-height:1.05}\n.team:not(:has(.tname:not(:empty))){display:none}\n.who:has(.name:empty) .team{font-size:1.1em;color:#15233f}\n.srv{width:1.3em;height:1.3em}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff9a3c 45%,#d65f00 100%);box-shadow:0 0 0 .1em rgba(0,0,0,.18)}\n.win{border-radius:50%;background:#c8102e}\n.win::after{content:\"\";width:.34em;height:.62em;margin-top:-.14em;border:solid #fff;border-width:0 .16em .16em 0;transform:rotate(45deg)}\n.gw,.pt{display:flex;align-items:center;justify-content:center;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}\n.gw{background:#efe7d6;color:#15233f;font-size:1.55em;box-shadow:inset 0 0 0 .06em #d6ccb6}\n.pt{background:#15233f;color:#fff;font-size:2.05em}\n.pA{box-shadow:inset -.03em 0 0 rgba(255,255,255,.25)}\n.mk{display:flex;align-items:flex-start;gap:.3em;height:2.05em;padding:0 .55em;grid-row:4;position:relative;z-index:1}\n.mkA{grid-column:1;justify-content:flex-start}\n.mkB{grid-column:6;flex-direction:row-reverse;justify-content:flex-end}\n.to-slot{width:5.4em;height:1.55em}\n.to-on,.to-used{border-radius:0 0 .25em .25em;font-size:1em;font-weight:800;letter-spacing:.04em;text-transform:uppercase}\n.to-on{background:#ffd23f;color:#111}\n.to-used{background:#fbf7ee;color:#5a5240}\n.card-slot{width:.9em;height:1.3em;margin-top:.12em}\n.card{border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.3)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.tie{display:none;align-items:center;gap:.3em;height:1.55em;padding:0 .5em;border-radius:0 0 .25em .25em;background:#15233f;color:#fff;font-size:1em;font-weight:800;letter-spacing:.06em;text-transform:uppercase}\n.board:has(.tname:not(:empty)) .tie{display:inline-flex}\n.hist{grid-column:2 / span 4;grid-row:4;position:relative;display:flex;justify-content:center;align-self:start;gap:.2em}\n.hcol{display:flex;align-items:center;gap:.25em;height:1.75em;padding:0 .5em;border-radius:0 0 .25em .25em;background:#fbf7ee;font-weight:800;font-variant-numeric:tabular-nums}\n.hl{color:#8a7f66;letter-spacing:.06em;margin-right:.1em}\n.hc{position:relative;display:flex;align-items:center;justify-content:center;min-width:1.5em;height:1.4em;color:#9a917c}\n.hc.a::after{content:\"–\";position:absolute;right:-.42em;color:#9a917c}\n.hc+.hc{margin-left:.3em}\n.hc .won{inset:0;border-radius:.2em;background:#15233f}\n.hc:has(.won[style*=\"opacity: 1\"]){color:#fff}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;white-space:nowrap;padding:0!important;margin:0!important;border:0!important}\n.grid{position:relative}\n.state{position:absolute;right:0;bottom:100%;width:12em;height:1.9em}\n.st{border-radius:.3em .3em 0 0;font-size:1em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.st-warm,.st-break{background:#15233f;color:#fff}\n.st-gp{background:#ff9a3c;color:#111}\n.st-mp{background:#c8102e;color:#fff}\n/* final: the loser's half steps back, the winner's points tile turns brick red */\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .nm.b,.board:has(.isBWinner[style*=\"opacity: 1\"]) .nm.a{color:#a39a85;background:#efe9dc}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .nm.b .flag,.board:has(.isBWinner[style*=\"opacity: 1\"]) .nm.a .flag{opacity:.45}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .pA,.board:has(.isBWinner[style*=\"opacity: 1\"]) .pB{background:#c8102e}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .pB,.board:has(.isBWinner[style*=\"opacity: 1\"]) .pA{opacity:1;background:#3a4660;color:#c9cfdb}\n.board:has(.isComplete[style*=\"opacity: 1\"]) :is(.lb-gA,.lb-gB){display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .lb-mid{grid-column:2 / span 4}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .pt{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gA{grid-column:2 / span 2}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gB{grid-column:4 / span 2}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{font-size:2.05em;background:#15233f;color:#fff;box-shadow:none}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .gA,.board:has(.isBWinner[style*=\"opacity: 1\"]) .gB{background:#c8102e}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .gB,.board:has(.isBWinner[style*=\"opacity: 1\"]) .gA{opacity:1;background:#3a4660;color:#c9cfdb}\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-paper\" data-osb-component=\"layout\"><div class=\"grid\" data-osb-component=\"layout\"><span class=\"lb lb-meta\"><span class=\"meta\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep s1\">·</i><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep s2\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span><span class=\"teamlbl\">Team match</span></span><span class=\"lb lb-gA\">Games</span><span class=\"lb lb-mid slot ph\"><span class=\"plbl\">Points</span><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\"><span class=\"now\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"nx\">Game <span class=\"nextGame ng\" data-osb-component=\"field\" data-osb-field=\"nextGame\"></span></span></span><span class=\"isComplete fin\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span></span><span class=\"lb lb-gB\">Games</span><span class=\"lb lb-st\"></span><span class=\"lb lb-end\"></span><div class=\"nm nA a\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"who\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span></span></span><span class=\"slot srv\"><span class=\"isACurrentlyServing servingA ball\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity:0\" isa=\"true\"></span><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"></span></span></div><span class=\"gw gA a\"><span class=\"currentAMatchScore AScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"pt pA a\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"pt pB b\"><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"gw gB b\"><span class=\"currentBMatchScore BScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span><div class=\"nm nB b\" data-osb-component=\"layout\"><span class=\"jerseyColorB kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"who\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"team\"><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span></span></span><span class=\"slot srv\"><span class=\"isBCurrentlyServing servingB ball\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"></span><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\"></span></span></div><div class=\"mk mkA\" data-osb-component=\"layout\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">Time-out</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span><span class=\"tie\">Tie <span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></div><div class=\"hist\" data-osb-component=\"layout\"><div class=\"hcol isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"hl\">G1</span><span class=\"hc a\"><span class=\"isGame1AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame1BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1BScore gs\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"hcol isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"hl\">G2</span><span class=\"hc a\"><span class=\"isGame2AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame2BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2BScore gs\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"hcol isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"hl\">G3</span><span class=\"hc a\"><span class=\"isGame3AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></span><span class=\"game3AScore gs\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame3BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></span><span class=\"game3BScore gs\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"hcol isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"hl\">G4</span><span class=\"hc a\"><span class=\"isGame4AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></span><span class=\"game4AScore gs\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame4BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></span><span class=\"game4BScore gs\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"hcol isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"hl\">G5</span><span class=\"hc a\"><span class=\"isGame5AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></span><span class=\"game5AScore gs\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame5BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></span><span class=\"game5BScore gs\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"hcol isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"hl\">G6</span><span class=\"hc a\"><span class=\"isGame6AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame6AWon\" style=\"opacity:0\"></span><span class=\"game6AScore gs\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame6BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame6BWon\" style=\"opacity:0\"></span><span class=\"game6BScore gs\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"hcol isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"hl\">G7</span><span class=\"hc a\"><span class=\"isGame7AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame7AWon\" style=\"opacity:0\"></span><span class=\"game7AScore gs\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame7BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame7BWon\" style=\"opacity:0\"></span><span class=\"game7BScore gs\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div></div><div class=\"mk mkB\" data-osb-component=\"layout\"><span class=\"slot to-slot\"><span class=\"isBTimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\">Time-out</span><span class=\"isBTimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"slot card-slot\"><span class=\"isBYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isBRedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span><span class=\"tie\">Tie <span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span></div><span class=\"slot state\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></div></article></main>\n</body>\n</html>\n","css":""}
