{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Editorial Quotient PICKLEBALL 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#231b17}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--width),1500px);background:#fbf5ed;position:relative;container-type:inline-size;display:flex;flex-direction:column}.header{text-align:center;font-size:var(--header-font);letter-spacing:var(--header-tracking);font-weight:700;line-height:1;min-height:var(--header-height);display:flex;align-items:center;justify-content:center;margin:0;white-space:nowrap}.name-lane{position:relative;min-width:0}.name{display:block;width:100%;font-family:\"Times New Roman\",Times,serif;font-style:italic;font-weight:700;font-size:var(--name-font);line-height:1.15;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 .6cqw}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{position:absolute;right:.6cqw;top:0;width:1.3cqw;height:1.3cqw;font-size:1.3cqw}.scores{min-width:0}.secondary{display:flex;align-items:center;justify-content:space-between;min-height:var(--secondary-height)}.label{font-size:var(--label-font);letter-spacing:var(--label-tracking);font-weight:700;line-height:1.1;white-space:nowrap;text-align:center}.match-score{font-family:\"Times New Roman\",Times,serif;font-weight:700;font-size:var(--match-font);color:var(--match-color);text-align:center;min-width:2ch;line-height:1.1}.rule{position:relative;height:2px;background:#231b17;flex-shrink:0}.accent{position:absolute;left:0;top:0;width:1.6cqw;height:2px;background:#231b17}.score{display:block;width:100%;font-family:\"Times New Roman\",Times,serif;font-weight:700;font-size:var(--score-font);line-height:1.08;color:#a74620;font-variant-numeric:tabular-nums;text-align:center;letter-spacing:-.07em;white-space:nowrap}.primary{display:flex;flex-direction:column;align-items:center}.point-slot{position:absolute;top:calc(100% + .9cqw);left:50%;transform:translateX(-50%);width:30cqw;height:2cqw;text-align:center;font-size:1.7cqw;color:#231b17;background:#fbf5ed}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw}.rule,.accent{height:1px}.point-slot{font-size:2.2cqw}.label{letter-spacing:.2cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--width:82vw;--header-font:3.8cqw;--header-tracking:.6cqw;--header-height:7.6cqw;--name-font:8.5cqw;--secondary-height:7.6cqw;--label-font:2.2cqw;--label-tracking:.4cqw;--match-font:4.1cqw;--match-color:#231b17;--score-font:20.6cqw;padding-bottom:2.7cqw}.duel{display:flex;position:relative;padding:0 3.5cqw;gap:5.3cqw}.duel:after{content:\"\";position:absolute;top:0;bottom:-1cqw;left:50%;width:2px;background:#231b17}.side{flex:1;min-width:0}.name-lane{text-align:center;margin-bottom:1.7cqw}.secondary{flex-direction:column;justify-content:center;gap:.45cqw;padding-bottom:1.2cqw;}.primary .score{padding-top:.8cqw}.primary .label{font-size:2.5cqw;margin-top:.5cqw}.scores .match-score{min-width:2ch}@media(max-width:600px){.duel:after{width:1px}}\n.score{line-height:.8}.point-slot{background:transparent}.point{background:#fbf5ed}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">PICKLEBALL</h1><div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"scores\"><div class=\"secondary\"><div class=\"label\">GAMES</div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"rule\"><span class=\"accent jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></div><div class=\"primary\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><div class=\"label\">POINTS</div></div></div></div><div class=\"side columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"scores\"><div class=\"secondary\"><div class=\"label\">GAMES</div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"rule\"><span class=\"accent jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></div><div class=\"primary\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><div class=\"label\">POINTS</div></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
