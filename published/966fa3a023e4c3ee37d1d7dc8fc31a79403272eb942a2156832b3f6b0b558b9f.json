{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pewter Columnhead — Basketball horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.package{width:min(96vw,1770px);max-width:100%;color:#25343a;container-type:inline-size}.caps,.board{display:flex;width:100%;min-width:0}.caps{height:30px}.board{height:86px;overflow:hidden;border:1px solid #8da1a5;border-radius:0 0 4px 4px;background:#dfe6e5;font-variant-numeric:tabular-nums}.team-heads,.teams{display:flex;flex:1 1 70%;min-width:0}.status-caps,.status{display:flex;flex:0 0 30%;min-width:0}.team-head,.team{display:flex;flex:1 1 0;min-width:0}.head-name,.name-track{display:flex;flex:1 1 0;min-width:0}.sport-tab,.column-cap{display:flex;align-items:center;justify-content:center;height:100%;background:#25343a;color:#f5f7f4;font-weight:800;white-space:nowrap}.sport-tab{align-self:stretch;width:12cqw;min-width:0;padding:0 10px;border-radius:4px 4px 0 0;font-size:1.45cqw}.column-cap{font-size:1.4cqw;letter-spacing:.015em;border-left:1px solid #8da1a5}.score-cap,.score-track{flex:0 0 28%}.score-cap{border-radius:4px 4px 0 0}.status-caps .column-cap,.status .stat{flex:1 1 0;min-width:0}.status-caps .clock,.status .clock{flex:1.35 1 0}.name-track{align-items:center}.identity{flex:none;display:block;align-self:stretch;width:17px;background:#167bea}.jerseyColorB{background:#ea2637}.name{display:block;flex:1 1 0;min-width:0;margin-left:30px;padding-right:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.2cqw;font-weight:700;line-height:1.08}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track,.stat{display:flex;align-items:center;justify-content:center;min-width:0;border-left:1px solid #8da1a5;background:#bccdd0}.score,.stat-value{display:block;min-width:0;width:100%;overflow:hidden;text-align:center;white-space:nowrap;font-variant-numeric:tabular-nums;font-weight:800;line-height:1}.score{font-size:4.1cqw}.stat-value{font-size:2.5cqw}.status .clock .stat-value{font-size:2.3cqw}.status-caps .column-cap{border-radius:0}.status-caps .column-cap:last-child{border-radius:0 4px 0 0}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.stage{padding:5px}.package{width:100%}.caps{height:24px}.board{height:75px}.sport-tab{width:auto;min-width:0;padding:0 4px;font-size:8px;letter-spacing:0}.column-cap{font-size:7px;letter-spacing:0}.team-heads,.teams{flex-basis:71%}.status-caps,.status{flex-basis:29%}.score-cap,.score-track{flex-basis:29%}.identity{width:4px}.name{margin-left:5px;padding-right:2px;font-size:clamp(10px,3.2cqw,13px)}.score{font-size:clamp(17px,5.1cqw,23px)}.stat-value,.status .clock .stat-value{font-size:clamp(9px,2.7cqw,13px)}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><div class=\"package\" data-osb-component=\"layout\"><div class=\"caps rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"team-heads rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"team-head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"head-name\" data-osb-component=\"layout\"><span class=\"sport-tab sport-tag\" data-osb-component=\"text\">BASKETBALL</span></div><span class=\"column-cap score-cap\" data-osb-component=\"text\">POINTS</span></div><div class=\"team-head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"head-name\" data-osb-component=\"layout\"></div><span class=\"column-cap score-cap\" data-osb-component=\"text\">POINTS</span></div></div><div class=\"status-caps rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"column-cap clock\" data-osb-component=\"text\">CLOCK</span><span class=\"column-cap \" data-osb-component=\"text\">PERIOD</span><span class=\"column-cap \" data-osb-component=\"text\">SHOT</span></div></div><article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Basketball scoreboard\"><div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><aside class=\"status rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static basketball counters\"><div class=\"stat clock\" data-osb-component=\"layout\"><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat \" data-osb-component=\"layout\"><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></div><div class=\"stat \" data-osb-component=\"layout\"><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"shot-clock\">00</span></div></aside><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></div></main></body></html>\n","css":""}
