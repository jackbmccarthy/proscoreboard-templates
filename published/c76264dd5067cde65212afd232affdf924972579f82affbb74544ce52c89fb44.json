{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Baseball carbon-copy ticket 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#080808}body{font-family:\"Courier New\",monospace;font-weight:700}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;width:100%;padding:14px}.ticket{container-type:inline-size;width:min(86vw,1640px);position:relative;isolation:isolate;background:#f3eee2;padding:1cqw 3.3cqw;mask-image:radial-gradient(circle at 0% 0%, transparent 2.8cqw, #000 2.9cqw), radial-gradient(circle at 100% 0%, transparent 2.8cqw, #000 2.9cqw), radial-gradient(circle at 0% 48%, transparent 2.8cqw, #000 2.9cqw), radial-gradient(circle at 100% 48%, transparent 2.8cqw, #000 2.9cqw), radial-gradient(circle at 0% 100%, transparent 2.8cqw, #000 2.9cqw), radial-gradient(circle at 100% 100%, transparent 2.8cqw, #000 2.9cqw);mask-composite:intersect}.frame{display:flex;flex-direction:column;border:2px solid #080808}.sport{margin:0;text-align:center;font-size:4.8cqw;line-height:1.13;padding:.5cqw 1cqw;border-bottom:2px solid #080808}.competitors{display:flex;}.competitor{display:flex;min-width:0;flex:1 1 0;flex-direction:column;align-items:center;padding:.55cqw 1.5cqw 1cqw;}.competitor+.competitor{border-left:2px dashed #080808}.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5cqw;line-height:1;width:100%;text-align:center;}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.runs{display:flex;align-items:center;flex-direction:column;justify-content:center;}.run-label{font-size:2.8cqw;line-height:1.15;order:2}.score{font-family:Arial,sans-serif;font-weight:800;font-variant-numeric:tabular-nums;font-size:16cqw;line-height:.88;display:block;text-align:center;min-width:2.2ch;max-width:100%;padding:.35cqw 0;}.stats{display:flex;border-top:2px solid #080808;padding:1.1cqw 0}.stat{flex:1 1 0;min-width:0;text-align:center;font-size:2.65cqw;line-height:1.4;white-space:nowrap}.stat+.stat{border-left:2px dashed #080808}.stat span+span{font-family:Arial,sans-serif;font-size:1.2em;margin-left:.3em}.identity,.match{display:none}.point-slot{position:absolute;bottom:0;left:0;width:100%;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.ticket{width:100%;padding:2cqw 4cqw}.sport{font-size:6cqw}.frame,.sport,.stats,.competitor+.competitor,.runs,.stat+.stat{border-width:1px}.stat{font-size:2.4cqw}.name{font-size:5cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"ticket columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><div class=\"frame columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"sport\" data-osb-static=\"true\">BASEBALL</header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"match currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"match currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-static=\"true\">INNING</span> <span data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-static=\"true\">BALLS</span> <span data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-static=\"true\">STRIKES</span> <span data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-static=\"true\">OUTS</span> <span data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
