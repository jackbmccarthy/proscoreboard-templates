{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Optic Diamond Box</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;text-wrap:balance}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.22rem)}\n.dot{position:relative;flex:none;width:var(--dot,.62rem);height:var(--dot,.62rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18));box-shadow:inset 0 0 0 .08rem var(--dot-edge,transparent)}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:not(:empty)+.ev-r:not(:empty)::before{content:\"\\00b7\";margin:0 .4em;opacity:.7}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.3em}.st-live-in>i{width:max(.5em,12px);height:max(.5em,12px);border-radius:50%;background:currentColor;animation:osb-pulse 1.6s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.35}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\n.ls{display:flex}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.tick{position:relative}.tick>.tick-on{position:absolute;inset:0;border-radius:inherit;background:var(--tick-on,#fff)}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;left:2rem;top:1.6rem;font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#f6f9f2}\n.bug{display:grid;grid-template-columns:auto auto;filter:drop-shadow(0 .3rem .7rem rgba(0,0,0,.4))}\n.hdr{grid-column:1/3;display:grid;grid-template-columns:1fr 2.9rem 1.75rem 1.75rem 9.8rem;align-items:center;height:1.45rem;background:#e0ef2a;color:#15211a;font:700 .8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;border-radius:.35rem .35rem 0 0}\n.hdr .ev{padding:0 .7rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.hdr .colh{text-align:center;opacity:.85}\n.hdr .st{justify-self:stretch;padding:0 .7rem;justify-items:end;font-size:.8rem}\n.teams{display:flex;flex-direction:column;width:21.5rem;background:#13241b}\n.row{display:flex;align-items:stretch;height:2.65rem}\n.row+.row{border-top:.06rem solid rgba(255,255,255,.12)}\n.chip{position:relative;flex:none;width:.55rem;background:#e0ef2a}\n.home{position:absolute;left:50%;bottom:.35rem;width:.36rem;height:.36rem;transform:translateX(-50%);background:#fff;clip-path:polygon(0 0,100% 0,100% 55%,50% 100%,0 55%)}\n.nmw{flex:1;min-width:0;display:flex;align-items:center;padding:0 .4rem 0 .7rem}\n.nm{font-weight:700;font-size:1.3rem;line-height:1;letter-spacing:.01em;text-transform:uppercase}\n.batw{flex:none;width:1.1rem;display:flex;align-items:center;justify-content:center}\n.bat{width:.6rem;height:.6rem;border-radius:50%;background:#e0ef2a;box-shadow:0 0 0 .12rem #13241b,0 0 0 .2rem #e0ef2a}\n.runs{flex:none;width:2.9rem;display:flex;align-items:center;justify-content:center;background:#1f3a2b;color:#fff;font:700 1.85rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.he{flex:none;width:1.75rem;display:flex;align-items:center;justify-content:center;font:700 1.05rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;color:#b6c7bb;font-variant-numeric:tabular-nums}\n.sit{position:relative;display:grid;grid-template-columns:auto auto;grid-template-rows:1fr auto;column-gap:.6rem;align-items:center;width:9.8rem;padding:.35rem .7rem .4rem;background:#0c1912;border-left:.06rem solid rgba(255,255,255,.12)}\n.sit .diamond{grid-row:1;grid-column:1;--d:3.7rem;--base-edge:#e8efe5;--base-off:rgba(255,255,255,.06);--base-on:#e0ef2a;--base-line:.13rem;justify-self:center}\n.outw{grid-row:2;grid-column:1;justify-self:center;display:flex;align-items:center;gap:.35rem;--dot:.62rem;--dot-gap:.28rem;--dot-off:rgba(255,255,255,.16);--dot-on:#e0ef2a}\n.outs-l{font:700 .72rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;color:#b6c7bb}\n.inn{grid-row:1;grid-column:2;display:flex;align-items:center;gap:.15rem;font:700 1.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;--half-on:#e0ef2a;--half-off:rgba(255,255,255,.2);--half-h:1.6rem;--half-size:.68rem}\n.cnt{grid-row:2;grid-column:2;display:flex;flex-direction:column;align-items:center;gap:.22rem}\n.count{font:700 1.35rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.02em}\n.bs{display:flex;gap:.4rem;--dot:.55rem;--dot-gap:.17rem;--dot-off:rgba(255,255,255,.16)}.ball-dots{--dot-on:#6fdc9a}.strike-dots{--dot-on:#ff7a5c}\n.count .dash{margin:0 .08em;opacity:.6}\n.cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.25rem;background:#0c1912;text-transform:uppercase;text-align:center}\n.cover b{font:700 .75rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#b6c7bb}\n.cover .periodLabel{font:700 1.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em}\n.isComplete{font:700 1.75rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.08em;color:#e0ef2a}\n.foot{grid-column:1/3;display:flex;align-items:center;justify-content:space-between;height:1.2rem;padding:0 .7rem;background:#e0ef2a;border-radius:0 0 .35rem .35rem;color:#15211a;font:700 .7rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em}\n.ticks{display:flex;gap:.22rem}.tick{width:.85rem;height:.3rem;border-radius:.15rem;background:rgba(21,33,26,.22);--tick-on:#15211a}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.ev-e.eventName,.ev-r.matchRound::before,.ev-r.matchRound,.colh,.outs-l,.cover.isInBetweenGames>b,.foot>span,.st-live-in,.st-pre{font-size:1.25vw!important}\n.home.isAHome,.bat.isABatting,.home.isBHome,.bat.isBBatting,.dot,.lit.isOut1,.lit.isOut2,.lit.isBall1,.lit.isBall2,.lit.isBall3,.lit.isStrike1,.lit.isStrike2{width:1.016vw!important;height:1.016vw!important;min-width:0!important;flex-shrink:0!important}\n.st-live-in>i{width:0.938vw!important;height:0.938vw!important;min-width:0!important;flex-shrink:0!important}\n/* end stream-size floor */\n\n</style></head><body><main class=\"board\" aria-label=\"Softball corner scoreboard\">\n<article class=\"bug columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball score bug\">\n<div class=\"hdr\"><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"colh\">R</span><span class=\"colh\">H</span><span class=\"colh\">E</span><span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span></span></div>\n<div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"row row-a\"><span class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"home isAHome\" data-osb-component=\"field\" data-osb-field=\"isAHome\" style=\"opacity: 0\"><i></i></span></span><span class=\"nmw\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"batw\"><span class=\"bat isABatting\" data-osb-component=\"field\" data-osb-field=\"isABatting\" style=\"opacity: 0\"></span></span><span class=\"runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"he h hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"he e errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span></div><div class=\"row row-b\"><span class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"home isBHome\" data-osb-component=\"field\" data-osb-field=\"isBHome\" style=\"opacity: 0\"><i></i></span></span><span class=\"nmw\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span><span class=\"batw\"><span class=\"bat isBBatting\" data-osb-component=\"field\" data-osb-field=\"isBBatting\" style=\"opacity: 0\"></span></span><span class=\"runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"he h hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span><span class=\"he e errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></div></div>\n<div class=\"sit\"><span class=\"diamond\" aria-label=\"Bases\"><span class=\"base second\"><span class=\"runner isRunnerOnSecond\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnSecond\" style=\"opacity: 0\"></span></span><span class=\"base third\"><span class=\"runner isRunnerOnThird\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnThird\" style=\"opacity: 0\"></span></span><span class=\"base first\"><span class=\"runner isRunnerOnFirst\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnFirst\" style=\"opacity: 0\"></span></span></span><span class=\"outw\"><span class=\"dots out-dots\"><span class=\"dot\"><span class=\"lit isOut1\" data-osb-component=\"field\" data-osb-field=\"isOut1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isOut2\" data-osb-component=\"field\" data-osb-field=\"isOut2\" style=\"opacity: 0\"></span></span></span><span class=\"outs-l\">OUT</span></span><span class=\"inn\"><span class=\"half\" aria-hidden=\"true\"><span class=\"half-dim\"></span><span class=\"half-win\"><span class=\"inningHalf\" data-osb-component=\"field\"></span></span></span><span class=\"inn-n inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"cnt\"><span class=\"count\"><span class=\"cb balls\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"dash\" aria-hidden=\"true\">-</span><span class=\"cs strikes\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"bs\"><span class=\"dots ball-dots\"><span class=\"dot\"><span class=\"lit isBall1\" data-osb-component=\"field\" data-osb-field=\"isBall1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall2\" data-osb-component=\"field\" data-osb-field=\"isBall2\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall3\" data-osb-component=\"field\" data-osb-field=\"isBall3\" style=\"opacity: 0\"></span></span></span><span class=\"dots strike-dots\"><span class=\"dot\"><span class=\"lit isStrike1\" data-osb-component=\"field\" data-osb-field=\"isStrike1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isStrike2\" data-osb-component=\"field\" data-osb-field=\"isStrike2\" style=\"opacity: 0\"></span></span></span></span></span><span class=\"cover isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0\"><b>End of</b><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\"></span></span><span class=\"cover isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\">Final</span></div>\n<div class=\"foot\"><span>SOFTBALL</span><span class=\"ticks\" aria-label=\"Innings\"><span class=\"tick\"><span class=\"tick-on isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"></span></span></span></div>\n</article>\n<span class=\"sr\"><span class=\"battingSide\" data-osb-component=\"field\" data-osb-field=\"battingSide\"></span><span class=\"bases\" data-osb-component=\"field\" data-osb-field=\"bases\"></span><span class=\"outs\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></span><span class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></span></span>\n</main></body></html>\n","css":""}
