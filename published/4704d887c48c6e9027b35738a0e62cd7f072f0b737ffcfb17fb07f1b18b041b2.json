{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>baseball brace register 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#f5efe0}body{font-family:Arial,sans-serif;font-weight:700}.stage{display:flex;align-items:center;justify-content:center;width:100%;min-height:100vh;padding:16px}.board{width:min(56vw,calc((100vh - 48px) * 1.58),1240px);container-type:inline-size;display:flex;flex-direction:column;position:relative}.sport{font-size:4.5cqw;line-height:1;letter-spacing:.9cqw;text-align:center}.enclosure{position:relative;width:100%;height:48cqw;margin-top:.5cqw;display:flex;align-items:center}.brace{position:absolute;top:calc(50% - 3cqw);transform:translate(-50%,-50%) scaleX(.45);font-family:Georgia,\"Times New Roman\",serif;font-weight:400;font-size:54cqw;line-height:1;color:#e3d8aa;width:30cqw;text-align:center;pointer-events:none}.brace.left{left:5cqw}.brace.right{left:95cqw}.competitors{display:flex;flex-direction:row;align-items:center;width:78%;margin:0 11%;}.competitor{display:flex;min-width:0;flex:1 1 0;flex-direction:column;align-items:center;}.identity{display:block;min-width:0;background-color:#9ed4bf;background-clip:text;-webkit-background-clip:text;width:100%;margin-bottom:2cqw;}.name{display:block;min-width:0;width:100%;color:transparent;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:7.1cqw;line-height:1.05;text-align:center;}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.runs{display:flex;flex-direction:column;align-items:center;width:100%;}.score-track{display:flex;align-items:center;justify-content:center;width:100%;height:23cqw;flex:none}.score{display:block;width:89.285714%;text-align:center;font-family:\"Arial Black\",Arial,sans-serif;font-size:25.7cqw;font-weight:900;line-height:.8;transform:scale(1.12,1.06);transform-origin:center;font-variant-numeric:tabular-nums}.run-label{font-size:5cqw;line-height:1;margin-top:1.3cqw}.stats{display:flex;align-items:center;justify-content:center;margin-top:4cqw;padding:0 11cqw;gap:0}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:1cqw}.stat-label,.stat-number,.comma{font-size:3.4cqw;line-height:1;font-weight:700;white-space:nowrap;letter-spacing:.1cqw}.stat-number{font-variant-numeric:tabular-nums}.comma{margin-left:-.8cqw}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:min(100%,calc((100vh - 48px) * 1.58))}.stats{padding-left:5cqw;padding-right:5cqw}.stat{gap:.8cqw}.stat-label,.stat-number,.comma{font-size:3.65cqw;letter-spacing:0}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><header class=\"sport\" data-osb-static=\"true\">BASEBALL</header><div class=\"enclosure\" data-osb-component=\"layout\"><span class=\"brace left\" data-osb-static=\"true\" aria-hidden=\"true\">{</span><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"runs\" data-osb-component=\"layout\"><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"run-label\" data-osb-static=\"true\">RUNS</span></div><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"runs\" data-osb-component=\"layout\"><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"run-label\" data-osb-static=\"true\">RUNS</span></div><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><span class=\"brace right\" data-osb-static=\"true\" aria-hidden=\"true\">}</span></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span><span class=\"comma\" data-osb-static=\"true\">,</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"comma\" data-osb-static=\"true\">,</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span><span class=\"comma\" data-osb-static=\"true\">,</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
