{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Kit Split</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px 24px 48px; font-family: \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif; }\n    .wrap { position: relative; display: inline-block; filter: drop-shadow(0 8px 18px #0009); }\n    .halves { display: flex; width: 1000px; height: 70px; }\n    .half { position: relative; flex: 1; display: flex; align-items: center; gap: 12px; padding: 0 130px 0 28px; background: #3a3f47; color: #fff; overflow: hidden; }\n    .half.a { clip-path: polygon(0 0, 100% 0, calc(100% - 22px) 100%, 0 100%); }\n    .half.b { margin-left: -18px; padding: 0 28px 0 130px; justify-content: flex-end; clip-path: polygon(22px 0, 100% 0, 100% 100%, 0 100%); }\n    .kit { position: absolute; inset: 0; }\n    .half::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(180deg, #ffffff26, #0000 50%, #0000004d); }\n    .nm { position: relative; z-index: 1; min-width: 0; font-size: 30px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 2px 4px #0006; }\n    .card { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 14px; height: 20px; border-radius: 2px; font-size: 10px; font-weight: 800; box-shadow: 0 1px 3px #0006; }\n    .card.red { background: #e5262b; }\n    .card.yellow { background: #f7d117; color: #14161a; }\n    .capsule { position: absolute; left: 50%; top: -8px; transform: translateX(-50%); display: flex; align-items: center; gap: 14px; height: 86px; padding: 0 30px; background: #fff; color: #14161a; border-radius: 10px; font-size: 52px; font-weight: 800; font-variant-numeric: tabular-nums; box-shadow: 0 6px 16px #0006; }\n    .capsule .dash { font-size: 30px; color: #9aa0a8; }\n    .clock { position: absolute; left: 50%; top: 78px; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; padding: 4px 14px; background: #14161a; color: #fff; border-radius: 0 0 8px 8px; white-space: nowrap; }\n    .gc { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .added { font-size: 15px; font-weight: 800; color: #f7d117; }\n    .added:has(.at:empty) { display: none; }\n    .half-l { font-size: 12px; font-weight: 700; letter-spacing: 1px; padding: 1px 6px; background: #fff; color: #14161a; border-radius: 3px; }\n    .half-l:empty { display: none; }\n    .live { width: 7px; height: 7px; border-radius: 50%; background: #e5262b; animation: blink 1.6s ease-in-out infinite; }\n    @keyframes blink { 50% { opacity: .25; } }\n    .ht { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #fff; color: #14161a; font-size: 16px; font-weight: 800; letter-spacing: 3px; border-radius: 0 0 8px 8px; }\n    .ev { position: absolute; left: 0; top: -22px; display: flex; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 2px; color: #fff; text-transform: uppercase; text-shadow: 0 1px 3px #000; }\n    .pens { display: none; }\n    .osb-aux, .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<article class=\"wrap\" aria-label=\"Soccer lower third\">\n  <span class=\"ev\"><span class=\"ev-name eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span>\n  <div class=\"halves\">\n    <span class=\"half a\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"card yellow isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity: 0;\"><span class=\"cn yellowCardsA\" data-osb-component=\"field\" data-osb-field=\"yellowCardsA\"></span></span><span class=\"card red isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity: 0;\"><span class=\"cn redCardsA\" data-osb-component=\"field\" data-osb-field=\"redCardsA\"></span></span></span>\n    <span class=\"half b\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"card yellow isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity: 0;\"><span class=\"cn yellowCardsB\" data-osb-component=\"field\" data-osb-field=\"yellowCardsB\"></span></span><span class=\"card red isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity: 0;\"><span class=\"cn redCardsB\" data-osb-component=\"field\" data-osb-field=\"redCardsB\"></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span>\n  </div>\n  <span class=\"capsule\"><span class=\"sa currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><b class=\"dash\">-</b><span class=\"sb currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span>\n  <span class=\"clock\"><span class=\"live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0;\"></span><span class=\"gc\"><span class=\"cm clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b class=\"colon\">:</b><span class=\"cs clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"added addedTimeVisible\"><span class=\"at addedTime\" data-osb-component=\"field\" data-osb-field=\"addedTime\"></span></span><span class=\"half-l periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"half\"></span><span class=\"ht isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\">HT</span></span>\n  <span class=\"pens shootoutAttempts\"><b class=\"pens-l\">PENS</b><span class=\"pen-a shootoutAScore\" data-osb-component=\"field\" data-osb-field=\"shootoutAScore\"></span><b class=\"pens-d\">-</b><span class=\"pen-b shootoutBScore\" data-osb-component=\"field\" data-osb-field=\"shootoutBScore\"></span></span>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
