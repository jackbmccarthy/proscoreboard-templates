{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Wire Numeral Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { color: #fff; font-family: Arial, Helvetica, sans-serif; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { display: flex; flex-direction: column; width: 100%; max-width: 740px; background: transparent; }\n.title { text-align: center; font-size: 70px; font-weight: 700; letter-spacing: .15em; padding-left: .15em; line-height: 1; margin-bottom: 56px; }\n.teams { display: flex; flex-direction: column; gap: 50px; }\n.team { display: flex; align-items: center; height: 275px; }\n.primary-track { display: flex; flex-direction: column; align-items: center; flex: 0 0 320px; min-width: 0; }\n.primary-score { display: block; width: 100%; height: 242px; text-align: center; font-family: \"Arial Black\", Arial, sans-serif; font-size: 250px; font-weight: 900; line-height: .84; letter-spacing: -.07em; color: transparent; -webkit-text-stroke: 5px #86f4f3; font-variant-numeric: tabular-nums; transform: scaleY(1.2); transform-origin: center; }\n.label { font-size: 32px; line-height: 1; font-weight: 600; letter-spacing: .17em; }\n.points-label { margin-top: 12px; }\n.details { display: flex; flex-direction: column; align-items: flex-start; flex: 1 1 0; min-width: 0; padding-left: 8px; }\n.name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 96px; font-weight: 700; line-height: 1.12; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.identity-rule { display: block; width: 225px; max-width: 80%; height: 7px; flex: 0 0 7px; background: #86f4f3; margin-top: 14px; margin-bottom: 16px; }\n.match-score { display: block; width: 115px; height: 75px; text-align: left; font-size: 72px; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; padding-left: 12px; }\n.sets-label { padding-left: 13px; }\n.set-footer { display: flex; justify-content: center; align-items: center; gap: 24px; margin-top: 52px; font-size: 44px; font-weight: 700; letter-spacing: .13em; line-height: 1; }\n.set-value { display: block; width: 55px; text-align: center; font-size: 58px; letter-spacing: 0; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 780px) {\n  .title { font-size: clamp(30px, 8vw, 70px); }\n  .primary-track { flex-basis: 43%; }\n  .primary-score { font-size: clamp(85px, 29vw, 225px); }\n  .name { font-size: clamp(34px, 10vw, 80px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .title { font-size: 29px; margin-bottom: 32px; letter-spacing: .1em; }\n  .teams { gap: 35px; }\n  .team { height: 168px; }\n  .primary-track { flex-basis: 43%; }\n  .primary-score { height: 133px; font-size: 120px; -webkit-text-stroke-width: 2.5px; transform: scaleY(1.25); }\n  .label { font-size: 15px; letter-spacing: .12em; }\n  .points-label { margin-top: 10px; }\n  .details { padding-left: 10px; }\n  .name { font-size: 37px; }\n  .identity-rule { width: 115px; height: 4px; flex-basis: 4px; margin-top: 12px; margin-bottom: 12px; }\n  .match-score { font-size: 35px; width: 75px; height: 39px; padding-left: 4px; }\n  .sets-label { padding-left: 4px; }\n  .set-footer { margin-top: 32px; font-size: 25px; gap: 12px; }\n  .set-value { width: 35px; font-size: 34px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label points-label\">POINTS</span></div>\n          <div class=\"details columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"identity-rule jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"label sets-label\">SETS</span></div>\n        </div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label points-label\">POINTS</span></div>\n          <div class=\"details columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"identity-rule jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"label sets-label\">SETS</span></div>\n        </div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
