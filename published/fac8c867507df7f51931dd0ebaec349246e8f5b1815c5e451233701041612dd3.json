{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Glacier Ink Footline Volleyball 2</title><style>\n:root{color-scheme:light}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}.board{--ice:#e2eaeb;--ink:#253c49;--rule:#a8b9bf;--blue:#2b88a9;--coral:#c66d68;width:min(calc(100vw - 48px),1142px);color:var(--ink);border-radius:6px;overflow:hidden;container-type:inline-size}.lanes{display:flex;flex-direction:column;background:var(--ice)}.lane{display:flex;align-items:stretch;min-width:0;height:128px;background:var(--ice)}.lane+.lane{border-top:1px solid var(--rule)}.identity{flex:0 0 24px;background:var(--blue)}.lane-b .identity{background:var(--coral)}.name{display:flex;align-items:center;flex:1 1 auto;min-width:0;margin:0;padding:0 30px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink);font-size:58px;line-height:1.05;font-weight:700}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.support-track{display:flex;flex:0 0 188px;min-width:0;align-items:center;justify-content:center;flex-direction:column;gap:2px;align-self:stretch;position:relative;background:var(--ice);color:var(--ink)}.support-track::before{content:\"\";position:absolute;left:0;top:16px;bottom:16px;width:1px;background:var(--rule)}.support-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:56px;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.support-score:empty::before{content:\"0\"}.caption{display:block;font-size:22px;line-height:1;font-weight:700}.primary-track{display:flex;flex:0 0 182px;min-width:0;align-self:stretch;align-items:center;justify-content:center;flex-direction:column;gap:2px;background:var(--ink);color:#f7faf9}.primary-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;text-align:center;font-size:64px;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.primary-score:empty::before{content:\"0\"}.primary-track .caption{color:#f7faf9}.footline{display:flex;align-items:center;gap:34px;min-height:77px;padding:0 38px;background:var(--ink);color:#f7faf9}.sport-tag{display:block;flex:0 0 auto;font-size:38px;line-height:1;font-weight:700;letter-spacing:.015em}.static-set{display:block;border-left:1px solid #a8b9bf;padding-left:36px;font-size:28px;line-height:1;font-weight:700;white-space:nowrap}.point-slot{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.point-slot .point-state{position:absolute;inset:0;opacity:0}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.board{width:min(calc(100vw - 48px),1640px)}.lanes{flex-direction:row}.lane{flex:1 1 0;width:50%;height:8.17cqw}.lane+.lane{border-top:0;border-left:1px solid var(--rule)}.identity{flex-basis:.98cqw;margin:.91cqw 0 .91cqw .85cqw}.name{padding:0 1.95cqw;font-size:3.41cqw}.support-track{flex-basis:8.84cqw}.support-track::before{top:.98cqw;bottom:.98cqw}.support-score{font-size:3.05cqw}.support-track .caption{font-size:1.34cqw}.primary-track{flex-basis:10.67cqw}.primary-score{font-size:5.24cqw}.primary-track .caption{font-size:1.52cqw}.footline{min-height:4.45cqw;padding:0 2.01cqw;gap:2.68cqw}.sport-tag{font-size:2.32cqw}.static-set{font-size:1.89cqw;padding-left:2.87cqw}\n@media(max-width:700px){.stage{padding:12px}.board{width:min(calc(100vw - 24px),520px)}.lanes{flex-direction:column}.lane{width:100%;height:84px;flex:auto}.lane+.lane{border-top:1px solid var(--rule);border-left:0}.identity{flex-basis:10px;margin:0}.name{padding:0 11px;font-size:clamp(20px,5vw,34px)}.support-track{flex-basis:68px;gap:1px}.support-track::before{top:10px;bottom:10px}.support-score{font-size:31px}.caption,.support-track .caption,.primary-track .caption{font-size:11px}.primary-track{flex-basis:86px}.primary-score{font-size:45px}.footline{min-height:45px;padding:0 16px;gap:17px}.sport-tag{font-size:17px}.static-set{padding-left:18px;font-size:15px}}@media(max-width:350px){.name{padding:0 7px;font-size:20px}.support-track{flex-basis:57px}.primary-track{flex-basis:72px}.primary-score{font-size:40px}.footline{padding:0 10px;gap:10px}.static-set{padding-left:11px}}</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\"><div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support-track\"><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">SETS</span></div><div class=\"primary-track\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div></div>\n<div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support-track\"><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">SETS</span></div><div class=\"primary-track\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div></div>\n</div><div class=\"footline\"><span class=\"sport-tag\">VOLLEYBALL</span><span class=\"static-set\" contenteditable=\"true\" aria-label=\"Manual set label\">SET 0</span></div><div class=\"point-slot\" aria-hidden=\"true\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
