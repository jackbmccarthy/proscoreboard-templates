{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Graphite Amber Band PICKLEBALL 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:\"Arial Narrow\",Arial,Helvetica,sans-serif;font-weight:700;color:#f3f0e9}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh}.board{width:min(var(--view-width),var(--max-width),var(--height-width));container-type:inline-size;position:relative;background:transparent;padding-bottom:3cqw}.desk{width:100%;min-width:0;border:1px solid #937c54;border-radius:4px;overflow:hidden;background:#252322}.row,.lane,.name-cell,.name-wrap{min-width:0}.name-wrap{display:flex;align-items:center;flex:1 1 0;gap:.7cqw}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{display:block;flex-shrink:0;background:#e9b64d;border-radius:1px}.serve{display:block;flex:0 0 1.2cqw;width:1.2cqw;font-size:1.2cqw;text-align:center;line-height:1}.score,.match-score{display:block;width:100%;font-family:Arial,Helvetica,sans-serif;font-size:var(--score-font);line-height:1.1;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}.match-score{font-size:var(--match-font)}.label{font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.point-cell{background:#e9b64d;color:#252322}.sport-caption{white-space:nowrap;line-height:1.1}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:36cqw;height:2cqw;font-size:1.5cqw;text-align:center}.point{position:absolute;inset:0;background:#fefaf0;color:#252322}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:63vw;--max-width:1200px;--height-width:250vh;--name-font:5.7cqw;--score-font:6.6cqw;--match-font:5.2cqw;--label-font:3cqw;--games-width:20%;--points-width:20%}.header{min-height:6.2cqw;display:flex;align-items:stretch;border-bottom:1px solid #937c54}.title-lane{flex:1;min-width:0;display:flex;align-items:stretch}.sport-caption{display:flex;align-items:center;justify-content:center;background:#e9b64d;color:#252322;width:31cqw;padding:0 1.8cqw;font-size:3.8cqw;border-radius:0 4px 4px 0;}.header .games,.game-cell{flex:0 0 var(--games-width)}.header .points,.point-cell{flex:0 0 var(--points-width)}.header>.label{display:flex;align-items:center;justify-content:center}.row{display:flex;align-items:stretch;min-height:11.4cqw;background:#252322}.row+.row{border-top:1px solid #937c54}.name-cell{flex:1 1 0;display:flex;align-items:center;gap:2.3cqw;padding:1.2cqw 2.8cqw}.identity{width:1.1cqw;height:7.7cqw}.game-cell,.point-cell{display:flex;align-items:center;justify-content:center}.point-cell{border-left:1px solid #937c54}@media(max-width:600px){.board{--view-width:94vw}.sport-caption{font-size:3.6cqw}.name{font-size:6cqw}.point-slot{height:2.3cqw;font-size:2cqw}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><div class=\"title-lane\"><div class=\"sport-caption\">PICKLEBALL</div></div><div class=\"label games\">GAMES</div><div class=\"label points\">POINTS</div></header><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
