{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Indigo Open Data Lane — Soccer horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:5px}.board{width:min(96vw,1770px);aspect-ratio:9.72;display:flex;flex-direction:column;overflow:hidden;border:2px solid #7ea6aa;background:#1b2d3b;color:#f0f2ed;container-type:inline-size;font-variant-numeric:tabular-nums}.header{flex:0 0 31%;display:flex;align-items:center;gap:1.5%;padding:0 1.8%;min-height:0;border-bottom:2px solid #82a8ac;white-space:nowrap}.sport-tag{flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:1.65cqw;font-weight:700;letter-spacing:.09em}.stat{display:flex;align-items:baseline;gap:.45em;flex:none;font-size:1.52cqw;font-weight:600}.stat-label{color:#f0f2ed;letter-spacing:.045em}.stat-value{color:#fff;font-size:1.05em;font-variant-numeric:tabular-nums}.divider{width:2px;height:46%;background:#82a8ac}.teams{flex:1 1 0;min-height:0;display:flex}.team{display:flex;flex:1 1 0;min-width:0;min-height:0}.team+.team{border-left:2px solid #82a8ac}.name-lane{display:flex;align-items:center;gap:5%;flex:1 1 0;min-width:0;padding:0 3.8%}.identity{flex:none;width:2.1%;height:62%;background:#92b3b1}.jerseyColorB{background:#92b3b1}.name{flex:1 1 0;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:3.3cqw;font-weight:700;line-height:1.04;letter-spacing:.045em;text-transform:uppercase}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.data-lane{flex:0 0 24%;display:flex;align-items:center;justify-content:center;min-width:0;margin:1.5% 0;border-left:2px solid #82a8ac;background:transparent}.score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;text-align:center;color:#fff;font-size:6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;height:112px;aspect-ratio:auto;border-width:1px}.header,.team+.team,.data-lane{border-width:1px}.header{gap:1%;padding:0 2%}.sport-tag{font-size:10px}.stat{font-size:7.5px;gap:.25em}.divider{width:1px}.name-lane{gap:4%;padding:0 2%}.name{font-size:14px}.identity{width:3px}.data-lane{flex-basis:26%}.score{font-size:27px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(97vw,1800px);aspect-ratio:10.5}.header{flex-basis:35%}.sport-tag{font-size:1.75cqw}.stat{font-size:1.75cqw}.data-lane{flex-basis:33%;justify-content:space-between;gap:5%;padding:0 3.5%}.score-label{flex:1 1 0;min-width:0;color:#92b3b1;font-size:1.8cqw;font-weight:600;white-space:nowrap}.score{flex:none;font-size:5.3cqw}.name{font-size:3.1cqw}@media(max-width:520px){.board{width:100%;height:112px;aspect-ratio:auto}.header{flex-basis:35%}.sport-tag{font-size:10px}.stat{font-size:8px}.data-lane{flex-basis:34%;padding:0 3%}.score-label{font-size:8px}.score{font-size:27px}.name{font-size:14px}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"half\" data-osb-static=\"true\">0</span></div></div>\n<div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"data-lane\" data-osb-component=\"layout\"><span class=\"score-label\" data-osb-component=\"text\">GOALS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"data-lane\" data-osb-component=\"layout\"><span class=\"score-label\" data-osb-component=\"text\">GOALS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
