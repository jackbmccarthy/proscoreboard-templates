{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Lower Third Palette G Mint And Berry High Key Editorial Paddle Blade Silhoue - HTML Replication</title>\n  <style>\n:root {\n  color-scheme: light;\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  background: transparent;\n  margin: 0;\n}\n\n.osb-catalog-body {\n  min-height: 100vh;\n  background: transparent;\n  color: #0f172a;\n}\n\n.osb-catalog {\n  margin: 0 auto;\n  max-width: 1560px;\n  padding: 32px;\n}\n\n.osb-catalog > header {\n  display: flex;\n  justify-content: space-between;\n  gap: 24px;\n  align-items: end;\n  margin-bottom: 28px;\n}\n\n.osb-catalog h1,\n.osb-catalog h2,\n.osb-catalog p {\n  margin: 0;\n}\n\n.osb-catalog h1 {\n  font-size: 30px;\n  line-height: 1.1;\n}\n\n.osb-catalog p {\n  color: #475569;\n  margin-top: 8px;\n  max-width: 820px;\n}\n\n.osb-catalog-count {\n  background: #0f172a;\n  border-radius: 6px;\n  color: white;\n  flex: 0 0 auto;\n  font-weight: 800;\n  padding: 10px 14px;\n}\n\n.osb-catalog-grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 22px;\n}\n\n.osb-replication-card {\n  background: rgba(255, 255, 255, 0.88);\n  border: 1px solid #dbe3ef;\n  border-radius: 8px;\n  flex: 1 1 560px;\n  overflow: hidden;\n}\n\n.osb-replication-card__header {\n  border-bottom: 1px solid #e2e8f0;\n  display: flex;\n  gap: 16px;\n  justify-content: space-between;\n  padding: 14px 16px;\n}\n\n.osb-replication-card__title {\n  font-size: 14px;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.osb-replication-card__meta {\n  color: #64748b;\n  font-size: 12px;\n  margin-top: 4px;\n}\n\n.osb-source-link {\n  color: #0f766e;\n  flex: 0 0 auto;\n  font-size: 12px;\n  font-weight: 800;\n  text-decoration: none;\n}\n\n.osb-reference {\n  background: #f8fafc;\n  border-bottom: 1px solid #e2e8f0;\n  padding: 12px 16px;\n}\n\n.osb-reference img {\n  aspect-ratio: 16 / 9;\n  border: 1px solid #dbe3ef;\n  border-radius: 6px;\n  display: block;\n  object-fit: contain;\n  width: 100%;\n}\n\n.osb-render-stage {\n  align-items: center;\n  aspect-ratio: 16 / 9;\n  background: transparent;\n  display: flex;\n  justify-content: center;\n  overflow: hidden;\n  padding: 22px;\n}\n\n.osb-individual-body {\n  align-items: center;\n  background: transparent;\n  display: flex;\n  justify-content: center;\n  min-height: 100vh;\n  padding: 5vw;\n}\n\n.osb-scoreboard {\n  color: var(--osb-text);\n  display: flex;\n  flex-direction: column;\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  letter-spacing: 0;\n  position: relative;\n}\n\n.osb-scoreboard [data-osb-component=\"field\"] {\n  min-width: 0;\n}\n\n.osb-score-surface,\n.osb-full-main,\n.osb-courtside-surface {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n}\n\n.osb-competitor-row {\n  align-items: center;\n  display: flex;\n  flex-direction: row;\n  flex-wrap: nowrap;\n  min-width: 0;\n  width: 100%;\n}\n\n.osb-identity {\n  display: flex;\n  flex: 1 1 0;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.osb-name {\n  align-items: center;\n  display: flex;\n  flex: 1 1 auto;\n  font-weight: 900;\n  line-height: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  text-transform: uppercase;\n  white-space: nowrap;\n  width: 100%;\n}\n\n.osb-meta-line {\n  align-items: center;\n  color: var(--osb-muted);\n  display: flex;\n  font-size: 10px;\n  font-weight: 800;\n  gap: 6px;\n  margin-top: 4px;\n  overflow: hidden;\n  text-transform: uppercase;\n  white-space: nowrap;\n  width: 100%;\n}\n\n.osb-rank,\n.osb-rating {\n  align-items: center;\n  display: flex;\n}\n\n.osb-flag {\n  border-radius: 2px;\n  box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.16);\n  flex: 0 0 27px;\n  height: 18px;\n  object-fit: cover;\n  width: 27px;\n}\n\n.osb-jersey {\n  align-self: stretch;\n  flex: 0 0 7px;\n  width: 7px;\n}\n\n.osb-jersey-a {\n  background: var(--osb-accent-a);\n}\n\n.osb-jersey-b {\n  background: var(--osb-accent-b);\n}\n\n.osb-serve {\n  align-items: center;\n  display: flex;\n  flex: 0 0 24px;\n  height: 22px;\n  justify-content: center;\n  width: 24px;\n}\n\n.osb-serve span {\n  background: var(--osb-highlight);\n  border-radius: 999px;\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--osb-highlight), transparent 72%);\n  display: block;\n  height: 8px;\n  width: 8px;\n}\n\n.osb-match-score,\n.osb-current-score {\n  align-items: center;\n  display: flex;\n  font-variant-numeric: tabular-nums;\n  justify-content: center;\n}\n\n.osb-match-score {\n  color: var(--osb-muted);\n  flex: 0 0 36px;\n  font-size: 16px;\n  font-weight: 900;\n  width: 36px;\n}\n\n.osb-current-score {\n  color: var(--osb-score);\n  flex: 0 0 58px;\n  font-size: 34px;\n  font-weight: 950;\n  letter-spacing: 0;\n  line-height: 1;\n  width: 58px;\n}\n\n.osb-event,\n.osb-round,\n.osb-mini-sport {\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 0;\n  text-transform: uppercase;\n}\n\n.osb-event {\n  color: var(--osb-muted);\n}\n\n.osb-round {\n  color: var(--osb-text);\n}\n\n.osb-game-history {\n  display: flex;\n  gap: 14px;\n}\n\n.osb-history-row {\n  display: flex;\n  gap: 4px;\n}\n\n.osb-history-cell {\n  align-items: center;\n  border-top: 2px solid var(--osb-highlight);\n  color: var(--osb-muted);\n  display: flex;\n  font-size: 10px;\n  font-weight: 900;\n  height: 18px;\n  justify-content: center;\n  min-width: 22px;\n}\n\n.osb-signature-detail {\n  inset: 0;\n  overflow: hidden;\n  pointer-events: none;\n  position: absolute;\n}\n\n.osb-signature-detail span {\n  border: 2px solid color-mix(in srgb, var(--osb-highlight), transparent 35%);\n  border-bottom: 0;\n  border-left: 0;\n  border-radius: 999px;\n  display: block;\n  height: 52px;\n  position: absolute;\n  right: 20px;\n  top: -8px;\n  transform: rotate(-8deg);\n  width: 160px;\n}\n\n.osb-lower-third {\n  background: var(--osb-board);\n  border: 1px solid var(--osb-outline);\n  border-radius: 8px;\n  box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);\n  max-width: 780px;\n  min-height: 116px;\n  overflow: hidden;\n  padding: 12px 16px 10px;\n  width: min(92%, 780px);\n}\n\n.osb-top-ribbon {\n  align-items: center;\n  border-bottom: 3px solid var(--osb-highlight);\n  display: flex;\n  gap: 10px;\n  justify-content: space-between;\n  margin-bottom: 8px;\n  padding-bottom: 5px;\n}\n\n.osb-ribbon-dots {\n  display: flex;\n  gap: 5px;\n}\n\n.osb-ribbon-dots i,\n.osb-full-serve-strip span,\n.osb-table-top span {\n  background: var(--osb-highlight);\n  display: block;\n}\n\n.osb-ribbon-dots i {\n  border-radius: 999px;\n  height: 5px;\n  width: 5px;\n}\n\n.osb-lower-third .osb-score-surface {\n  gap: 3px;\n}\n\n.osb-row-lower {\n  background: var(--osb-panel);\n  border-radius: 5px;\n  gap: 9px;\n  min-height: 36px;\n  padding: 5px 7px 5px 0;\n}\n\n.osb-row-lower.osb-side-b {\n  background: var(--osb-panel-2);\n}\n\n.osb-row-lower .osb-name {\n  font-size: 18px;\n}\n\n.osb-lower-third .osb-game-history {\n  justify-content: center;\n  margin-top: 6px;\n}\n\n.osb-corner-bug {\n  background: var(--osb-board);\n  border: 1px solid var(--osb-outline);\n  border-radius: 7px 7px 3px 3px;\n  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.28);\n  max-width: 420px;\n  min-height: 92px;\n  overflow: hidden;\n  padding: 0;\n  width: min(72%, 420px);\n}\n\n.osb-corner-cap {\n  align-items: center;\n  background: color-mix(in srgb, var(--osb-panel), black 12%);\n  border-bottom: 2px solid var(--osb-highlight);\n  display: flex;\n  justify-content: space-between;\n  padding: 4px 8px;\n}\n\n.osb-row-corner {\n  background: var(--osb-panel);\n  gap: 7px;\n  min-height: 30px;\n  padding: 3px 6px 3px 0;\n}\n\n.osb-row-corner.osb-side-b {\n  background: color-mix(in srgb, var(--osb-panel), white 7%);\n}\n\n.osb-row-corner .osb-name {\n  font-size: 13px;\n}\n\n.osb-row-corner .osb-flag {\n  flex-basis: 23px;\n  height: 15px;\n  width: 23px;\n}\n\n.osb-row-corner .osb-current-score {\n  background: linear-gradient(135deg, var(--osb-accent-a), var(--osb-accent-b));\n  color: #ffffff;\n  flex-basis: 42px;\n  font-size: 22px;\n  height: 30px;\n  width: 42px;\n}\n\n.osb-corner-tail {\n  background: var(--osb-highlight);\n  clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);\n  height: 5px;\n  width: 42%;\n}\n\n.osb-fullscreen-card {\n  aspect-ratio: 16 / 9;\n  background:\n    linear-gradient(135deg, color-mix(in srgb, var(--osb-bg), white 18%), var(--osb-bg)),\n    var(--osb-bg);\n  border: 1px solid var(--osb-outline);\n  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);\n  justify-content: space-between;\n  max-width: 860px;\n  overflow: hidden;\n  padding: 34px 44px 30px;\n  width: min(96%, 860px);\n}\n\n.osb-full-header,\n.osb-full-footer {\n  align-items: center;\n  display: flex;\n  justify-content: space-between;\n  position: relative;\n  z-index: 1;\n}\n\n.osb-full-header {\n  border-bottom: 3px solid var(--osb-highlight);\n  padding-bottom: 10px;\n}\n\n.osb-full-serve-strip {\n  display: flex;\n  gap: 8px;\n}\n\n.osb-full-serve-strip span {\n  border-radius: 999px;\n  height: 7px;\n  width: 28px;\n}\n\n.osb-full-main {\n  gap: 13px;\n  position: relative;\n  z-index: 1;\n}\n\n.osb-row-full {\n  background: color-mix(in srgb, var(--osb-panel), white 8%);\n  border: 1px solid var(--osb-outline);\n  border-radius: 7px;\n  gap: 14px;\n  min-height: 84px;\n  padding: 12px 15px 12px 0;\n}\n\n.osb-row-full.osb-side-b {\n  background: var(--osb-panel-2);\n}\n\n.osb-row-full .osb-name {\n  font-size: 34px;\n}\n\n.osb-row-full .osb-current-score {\n  flex-basis: 112px;\n  font-size: 74px;\n  width: 112px;\n}\n\n.osb-row-full .osb-match-score {\n  background: color-mix(in srgb, var(--osb-highlight), white 55%);\n  border-radius: 4px;\n  color: var(--osb-score-text);\n  flex-basis: 46px;\n  height: 46px;\n  width: 46px;\n}\n\n.osb-row-full .osb-flag {\n  flex-basis: 45px;\n  height: 30px;\n  width: 45px;\n}\n\n.osb-point-state {\n  display: flex;\n  gap: 8px;\n}\n\n.osb-state-pill {\n  border: 1px solid var(--osb-outline);\n  border-radius: 999px;\n  color: var(--osb-muted);\n  font-size: 10px;\n  font-weight: 900;\n  padding: 5px 8px;\n  text-transform: uppercase;\n}\n\n.osb-courtside-board {\n  aspect-ratio: 16 / 9;\n  background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--osb-highlight), transparent 62%), transparent 34%), var(--osb-bg);\n  border: 1px solid var(--osb-outline);\n  justify-content: center;\n  max-width: 860px;\n  overflow: hidden;\n  padding: 74px 70px 88px;\n  width: min(96%, 860px);\n}\n\n.osb-table-top {\n  display: flex;\n  gap: 8px;\n  left: 50%;\n  position: absolute;\n  top: 42px;\n  transform: translateX(-50%);\n}\n\n.osb-table-top span {\n  height: 8px;\n  width: 56px;\n}\n\n.osb-courtside-header {\n  align-items: center;\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 14px;\n}\n\n.osb-courtside-surface {\n  background: color-mix(in srgb, var(--osb-board), black 12%);\n  border: 4px solid var(--osb-outline);\n  box-shadow: 0 20px 0 color-mix(in srgb, var(--osb-board), black 28%);\n}\n\n.osb-row-court {\n  background: var(--osb-panel);\n  border-bottom: 2px solid var(--osb-outline);\n  gap: 12px;\n  min-height: 76px;\n  padding: 10px 12px 10px 0;\n}\n\n.osb-row-court.osb-side-b {\n  background: var(--osb-panel-2);\n  border-bottom: 0;\n}\n\n.osb-row-court .osb-name {\n  font-size: 28px;\n}\n\n.osb-row-court .osb-current-score {\n  background: var(--osb-highlight);\n  border-radius: 2px;\n  color: var(--osb-score-text);\n  flex-basis: 86px;\n  font-size: 58px;\n  height: 64px;\n  width: 86px;\n}\n\n.osb-row-court .osb-match-score {\n  flex-basis: 42px;\n  font-size: 22px;\n  width: 42px;\n}\n\n.osb-courtside-history {\n  display: flex;\n  justify-content: center;\n  margin-top: 22px;\n}\n\n.osb-motif-led-ribbon .osb-top-ribbon,\n.osb-motif-led-ribbon .osb-full-header {\n  border-bottom-style: dotted;\n}\n\n.osb-motif-paddle-blade .osb-signature-detail span {\n  border-radius: 80% 20% 80% 20%;\n  height: 84px;\n  right: -18px;\n  top: 10px;\n  transform: rotate(18deg);\n  width: 84px;\n}\n\n.osb-motif-net-knot .osb-signature-detail span {\n  border-left: 2px solid color-mix(in srgb, var(--osb-highlight), transparent 30%);\n  border-radius: 10px;\n  height: 68px;\n  right: 34px;\n  top: -20px;\n  transform: rotate(42deg);\n  width: 68px;\n}\n\n.osb-motif-spin-arc .osb-signature-detail span {\n  height: 80px;\n  right: 8px;\n  top: -24px;\n  width: 230px;\n}\n\n.osb-motif-hex-table .osb-courtside-surface,\n.osb-motif-hex-table .osb-lower-third {\n  clip-path: polygon(4% 0, 96% 0, 100% 18%, 100% 82%, 96% 100%, 4% 100%, 0 82%, 0 18%);\n}\n\n@media (max-width: 720px) {\n  .osb-catalog {\n    padding: 18px;\n  }\n\n  .osb-catalog > header {\n    align-items: start;\n    flex-direction: column;\n  }\n\n  .osb-catalog-grid {\n    flex-direction: column;\n  }\n\n  .osb-render-stage {\n    padding: 10px;\n  }\n\n  .osb-row-full .osb-name {\n    font-size: 22px;\n  }\n\n  .osb-row-full .osb-current-score {\n    flex-basis: 76px;\n    font-size: 48px;\n    width: 76px;\n  }\n\n  .osb-row-lower .osb-name {\n    font-size: 13px;\n  }\n\n  .osb-current-score {\n    flex-basis: 44px;\n    font-size: 26px;\n    width: 44px;\n  }\n\n  .osb-flag,\n  .osb-meta-line,\n  .osb-game-history {\n    display: none;\n  }\n}\n\n/* OpenScoreboard paired A/B layout override */\nhtml, body, body.osb-individual-body, .osb-render-stage { background: transparent !important; }\nbody.osb-individual-body { min-height: 100vh; padding: clamp(.65rem, 3vw, 2.4rem); }\n.osb-scoreboard { max-width: 100%; min-width: 0; width: fit-content; }\n.osb-render-stage [data-osb-component=\"layout\"] { display: flex; min-width: 0; }\n.osb-render-stage .rowContainer { flex-direction: row; }\n.osb-render-stage .columnContainer { flex-direction: column; }\n.osb-paired-surface {\n  align-items: stretch;\n  display: flex !important;\n  flex-direction: row !important;\n  gap: 0 !important;\n  max-width: 100%;\n  min-width: 0;\n  overflow: hidden;\n  padding: 0 !important;\n  width: fit-content !important;\n}\n.osb-field-stack {\n  align-items: stretch;\n  display: flex !important;\n  flex: 0 0 auto;\n  flex-direction: column !important;\n  min-width: 0;\n}\n.osb-field-stack > [data-osb-field],\n.osb-field-stack > .osb-player-cell,\n.osb-field-stack > .osb-field-slot {\n  align-items: center;\n  display: flex;\n  flex: 1 1 0 !important;\n  justify-content: center;\n  min-block-size: var(--osb-row-height, clamp(2.9rem, 6vw, 4.4rem));\n  min-width: 0;\n}\n.osb-field-stack > * + * { border-top: 1px solid var(--osb-outline); }\n.osb-jersey-stack { flex-basis: .48rem !important; }\n.osb-jersey { flex: 1 1 0 !important; height: auto !important; min-inline-size: .48rem; width: auto !important; }\n.osb-jersey-a { background: var(--osb-accent-a); }\n.osb-jersey-b { background: var(--osb-accent-b); }\n.osb-flag-stack { padding-inline: .28rem; }\n.osb-flag {\n  aspect-ratio: 3 / 2;\n  flex: 0 1 auto !important;\n  height: auto !important;\n  margin: .42rem .22rem;\n  max-inline-size: clamp(2rem, 4.8vw, 3.1rem);\n  object-fit: cover;\n  width: auto !important;\n}\n.osb-name-stack { flex: 1 1 auto !important; inline-size: fit-content; max-inline-size: min(58vw, 36rem); min-width: 0; }\n.osb-player-cell { align-items: stretch !important; flex-direction: column; justify-content: center !important; padding: .5rem clamp(.62rem, 1.8vw, 1.15rem); }\n.osb-player-cell.osb-side-a { background: var(--osb-panel); }\n.osb-player-cell.osb-side-b { background: var(--osb-panel-2); }\n.osb-name { flex: 0 1 auto !important; height: auto !important; max-width: 100%; min-inline-size: min(28vw, 9ch); min-width: 0; width: auto !important; }\n.osb-meta-line { width: auto !important; }\n.osb-service-stack { padding-inline: .32rem; }\n.osb-field-slot { min-inline-size: 1.3rem; }\n.osb-serve { flex: 1 1 0 !important; height: 100% !important; width: 100% !important; }\n.isBCurrentlyServing { opacity: 0; }\n.osb-match-score-stack, .osb-current-score-stack { flex: 0 0 auto !important; }\n.osb-match-score, .osb-current-score {\n  flex: 1 1 0 !important;\n  font-variant-numeric: tabular-nums;\n  height: auto !important;\n  min-inline-size: 2.3ch;\n  padding-inline: clamp(.42rem, 1.2vw, .72rem);\n  width: auto !important;\n}\n.osb-current-score.osb-side-a { background: var(--osb-accent-a); color: var(--osb-accent-a-text); }\n.osb-current-score.osb-side-b { background: var(--osb-accent-b); color: var(--osb-accent-b-text); }\n.osb-history-pairs { align-items: stretch; display: flex; flex-direction: row; flex-wrap: nowrap; width: fit-content; }\n.osb-history-stack { border-left: 1px solid var(--osb-outline); display: flex; flex-direction: column; }\n.osb-history-stack:last-child { border-right: 1px solid var(--osb-outline); }\n.osb-history-cell {\n  align-items: center;\n  display: flex !important;\n  flex: 1 1 0;\n  font-variant-numeric: tabular-nums;\n  justify-content: center;\n  line-height: 1.1;\n  min-inline-size: 2.35ch;\n  padding: .2rem .38rem !important;\n  width: auto !important;\n}\n.osb-history-cell + .osb-history-cell { border-top: 1px solid var(--osb-outline); }\n.osb-lower-third { max-width: 92vw; }\n.osb-corner-bug { --osb-row-height: clamp(2.5rem, 5vw, 3.35rem); max-width: 78vw; }\n.osb-fullscreen-card {\n  --osb-row-height: clamp(4.6rem, 9vw, 8rem);\n  aspect-ratio: 16 / 9;\n  justify-content: center;\n  max-width: 96vw;\n  min-height: min(84vh, 42rem);\n  padding: clamp(1.4rem, 4vw, 4rem) !important;\n  width: min(96vw, 72rem) !important;\n}\n.osb-fullscreen-card .osb-paired-surface { width: 100% !important; }\n.osb-fullscreen-card .osb-name-stack { max-inline-size: none; }\n.osb-fullscreen-card .osb-game-history { display: flex; flex: 1 1 auto; justify-content: flex-end; }\n.osb-courtside-board {\n  --osb-row-height: clamp(4rem, 8vw, 6.4rem);\n  max-width: 96vw;\n  padding: clamp(1rem, 2.8vw, 2.5rem) !important;\n  width: min(94vw, 68rem) !important;\n}\n.osb-courtside-board .osb-paired-surface { width: 100% !important; }\n.osb-courtside-board .osb-name-stack { max-inline-size: none; }\n@media (max-width: 38rem) {\n  body.osb-individual-body { padding: .45rem; }\n  .osb-flag-stack { display: none !important; }\n  .osb-name { min-inline-size: 7ch; }\n  .osb-player-cell { padding-inline: .45rem; }\n  .osb-fullscreen-card { aspect-ratio: auto; min-height: 72vh; width: 96vw !important; }\n}\n  </style>\n</head>\n<body class=\"osb-individual-body\">\n<main class=\"osb-render-stage\">\n<article class=\"osb-scoreboard osb-placement-lower-third osb-palette-g osb-motif-paddle-blade osb-lower-third columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" data-source-image=\"Lower-third---Palette-G-Mint-and-Berry-High-Key-Editorial---Paddle-blade-silhoue__20260828_152109_c10bab45.png\" style=\"--osb-bg:#f4fff8;--osb-board:#e8fff5;--osb-panel:#ffffff;--osb-panel-2:#fef7fb;--osb-text:#17352f;--osb-muted:#6a7d76;--osb-accent-a:#0c8f79;--osb-accent-a-text:#ffffff;--osb-accent-b:#b93b68;--osb-accent-b-text:#ffffff;--osb-highlight:#8de8cf;--osb-score:#0b2f29;--osb-score-text:#0b2f29;--osb-outline:#b6ebdb\">\n  <div class=\"osb-top-ribbon\"><div class=\"osb-event eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></div><div class=\"osb-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></div><span class=\"osb-ribbon-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span></div>\n  <div class=\"osb-paired-surface osb-row-lower rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <div class=\"osb-field-stack osb-jersey-stack columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-colum