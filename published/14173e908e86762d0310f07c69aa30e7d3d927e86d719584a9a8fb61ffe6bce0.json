{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Maroon Frost Matchline horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#26343b}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;flex-direction:column;width:min(98vw,1900px);max-width:100%;min-width:0;overflow:hidden;border-radius:4px;background:#e9edef;container-type:inline-size}\n.matchline{display:flex;align-items:center;justify-content:space-between;flex:none;height:3.4cqw;min-width:0;padding:0 1.6cqw;background:#572f3c;color:#f8f6f2}\n.sport-tag{display:block;flex:none;color:#f8f6f2;font-size:2.25cqw;font-weight:800;line-height:1;white-space:nowrap}\n.stats{display:flex;align-items:center;justify-content:flex-end;min-width:0}\n.stat{display:flex;align-items:baseline;gap:.5cqw;min-width:0;padding:0 1.65cqw;color:#f8f6f2;font-size:1.55cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stat+.stat{border-left:1px solid #bec8cb}.stat strong{font-variant-numeric:tabular-nums}\n.competitors{display:flex;align-items:stretch;min-width:0}\n.competitor{display:flex;align-items:stretch;flex:1 1 50%;min-width:0;height:9cqw;background:#e9edef}\n.competitor+.competitor{border-left:2px solid #bec8cb}\n.identity{display:block;flex:none;width:1.6cqw;height:100%;background:#2190e9}\n.jerseyColorB{background:#ef6568}\n.namefoot{display:flex;flex-direction:column;justify-content:center;flex:1 1 auto;min-width:0;gap:.4cqw;padding:0 2.1cqw}\n.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#26343b;font-size:3.8cqw;font-weight:800;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.support{display:flex;align-items:baseline;gap:.6cqw;color:#26343b;font-weight:700;line-height:1;white-space:nowrap}\n.support strong{font-size:2.2cqw;font-variant-numeric:tabular-nums}.support span{font-size:1.8cqw}\n.scorecap{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 24%;min-width:0;background:#572f3c;color:#f8f6f2}\n.score{display:block;max-width:100%;overflow:hidden;color:#f8f6f2;font-size:5.6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center}\n.score-label{display:block;color:#f8f6f2;font-size:1.8cqw;font-weight:700;line-height:1;white-space:nowrap}\n.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%}.matchline{height:48px;padding:0 6px;flex-direction:column;align-items:stretch;justify-content:center;gap:4px}.sport-tag{font-size:10px}.stats{justify-content:space-between}.stat{font-size:9px;gap:2px;padding:0 3px}.competitor{height:72px}.competitor+.competitor{border-left-width:1px}.identity{width:3px}.namefoot{gap:3px;padding:0 5px}.name{font-size:clamp(13px,3.5vw,20px)}.support{gap:2px}.support strong{font-size:11px}.support span{font-size:9px}.scorecap{flex-basis:34%}.score{font-size:clamp(20px,5.5vw,27px)}.score-label{font-size:9px}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Softball scoreboard\">\n<div class=\"matchline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOFTBALL</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static softball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></div>\n<div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"namefoot columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong><span data-osb-component=\"text\">HITS</span></div></div><div class=\"scorecap columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong><span class=\"score-label\" data-osb-component=\"text\">RUNS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"namefoot columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong><span data-osb-component=\"text\">HITS</span></div></div><div class=\"scorecap columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong><span class=\"score-label\" data-osb-component=\"text\">RUNS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
