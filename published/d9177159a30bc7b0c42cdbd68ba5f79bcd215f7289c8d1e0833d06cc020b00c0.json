{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Inverted Splitline Volleyball — Shared Panel</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { color: #f3f0e6; font-family: Arial, Helvetica, sans-serif; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 1366px; display: flex; flex-direction: column; background: transparent; }\n.title { font-size: 104px; font-weight: 800; text-align: center; line-height: 1; margin-bottom: 33px; }\n.headers { display: flex; gap: 84px; padding: 0 46px; margin-bottom: 24px; }\n.identity { display: flex; align-items: center; flex: 1 1 0; min-width: 0; gap: 18px; height: 102px; padding: 13px 30px; background: #ffc42b; color: #080a0b; }\n.name { flex: 1 1 0; min-width: 0; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 74px; font-weight: 800; line-height: 1; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-band { display: flex; align-items: center; gap: 12px; flex: 0 0 auto; font-size: 40px; line-height: 1; font-weight: 800; }\n.match-score { display: block; width: 58px; font-size: 52px; text-align: center; font-variant-numeric: tabular-nums; }\n.panel { position: relative; isolation: isolate; height: 582px; display: flex; background: #15161a; }\n.panel::before, .panel::after { content: \"\"; position: absolute; inset: 0 0 50%; z-index: -1; background: #f3f0e6; }\n.panel::after { inset: 50% 0 0; background: #15161a; }\n.score-track { display: flex; flex-direction: column; align-items: center; flex: 1 1 0; min-width: 0; padding: 20px 24px 12px; }\n.primary-score { display: flex; align-items: center; justify-content: center; width: 100%; height: 480px; flex: 0 0 480px; font-family: \"Arial Black\", Arial, sans-serif; font-size: 540px; font-weight: 900; color: #fff; mix-blend-mode: difference; line-height: 1; letter-spacing: -.09em; font-variant-numeric: tabular-nums; }\n.points-label { display: block; font-size: 56px; font-weight: 800; line-height: 1; margin-top: 14px; }\n.set-footer { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 31px; font-size: 56px; font-weight: 800; line-height: 1; }\n.set-value { display: block; width: 64px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1400px) and (min-width: 701px) {\n  .headers { gap: 50px; padding: 0 32px; }\n  .name { font-size: 58px; }\n  .primary-score { font-size: 470px; }\n}\n@media (max-height: 800px) and (min-width: 701px) {\n  .title { font-size: 58px; margin-bottom: 18px; }\n  .headers { margin-bottom: 14px; }\n  .identity { height: 62px; padding-top: 8px; padding-bottom: 8px; }\n  .name { font-size: 40px; }\n  .sets-band { font-size: 27px; }\n  .match-score { font-size: 37px; width: 44px; }\n  .panel { height: 340px; }\n  .score-track { padding: 18px 24px; }\n  .primary-score { font-size: 320px; height: 262px; flex-basis: 262px; }\n  .points-label { font-size: 32px; margin-top: 10px; }\n  .set-footer { font-size: 38px; margin-top: 24px; }\n  .set-value { width: 44px; }\n}\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .title { font-size: 30px; margin-bottom: 24px; }\n  .headers { gap: 20px; padding: 0; margin-bottom: 12px; }\n  .identity { height: 56px; padding: 10px; gap: 6px; }\n  .name { font-size: 21px; }\n  .sets-band { font-size: 12px; gap: 4px; }\n  .match-score { font-size: 16px; width: 22px; }\n  .panel { height: 242px; }\n  .score-track { padding: 12px 12px 15px; }\n  .primary-score { font-size: 130px; height: 187px; flex-basis: 187px; }\n  .points-label { font-size: 21px; margin-top: 7px; }\n  .set-footer { font-size: 30px; margin-top: 26px; gap: 8px; }\n  .set-value { width: 35px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"headers rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity jerseyColorA rowContainer\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"sets-band\"><span>SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div><div class=\"identity jerseyColorB rowContainer\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"sets-band\"><span>SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div>\n      <div class=\"panel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"points-label\">POINTS</span></div><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
