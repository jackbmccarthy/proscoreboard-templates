ot,.82rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18))}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inn-n{min-width:1.1em;text-align:left}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:.5em;overflow-wrap:normal;word-break:normal;hyphens:none}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:has(+.ev-r:not(:empty))::after{content:\"\\00b7\";margin-left:.5em;opacity:.75}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end;white-space:nowrap}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.4em}.st-live-in>i{flex:none;width:.8rem;height:.8rem;border-radius:50%;background:var(--live,#ff3b30);box-shadow:0 0 .45rem var(--live,#ff3b30);animation:osb-pulse 1.4s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.7}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ls{display:flex}\n.ls-col{position:relative}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.ls-gate{display:flex;flex-direction:column;position:relative}\n.ls-c{position:relative;display:flex;align-items:center;justify-content:center}\n\n.ls-cur{position:absolute;inset:0;pointer-events:none}\n.tick{position:relative}.tick>.tick-on,.tick>.tick-cur{position:absolute;inset:0;border-radius:inherit}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;left:2rem;top:1.6rem;color:#1d2a44;font-family:\"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;--live:#ff4a3d}\n.card{width:27.5rem;border-radius:.5rem;overflow:hidden;background:#f7f1e3;box-shadow:0 .45rem 1.2rem rgba(0,0,0,.4)}\n.hdr{display:grid;grid-template-columns:1fr 3.4rem 2.2rem 2.2rem;align-items:end;min-height:2.3rem;padding:.45rem .2rem .32rem 0;background:#1d2a44;color:#f7f1e3;font:700 1rem/1.25 \"OSB Barlow Condensed\",\"DIN Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;letter-spacing:.08em;text-transform:uppercase;--evlh:1.25}\n.hdr .ev{margin:0 .6rem 0 .95rem}.hdr>.c{font-family:\"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;text-align:center;letter-spacing:.1em;color:#b9c1d3}\n\n.ev{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:1em;overflow:hidden;min-width:0;--evg:1em}\n.ev>span{min-width:0;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.ev>.ev-e::after{content:none!important}\n.ev>.ev-r{margin-left:calc(-1 * var(--evg));padding-left:var(--evg);background:radial-gradient(circle closest-side,currentColor 62%,transparent 76%) calc((var(--evg) - .36em) / 2) 46%/.36em .36em no-repeat}\n.ev.one{height:calc(1em * var(--evlh));line-height:var(--evlh)}\n.row{display:grid;grid-template-columns:1.15rem 1fr 1.6rem 3.4rem 2.2rem 2.2rem;align-items:center;height:3.1rem;padding-right:.2rem}\n.row+.row{border-top:.08rem solid rgba(29,42,68,.14)}\n.slab{align-self:stretch;background:var(--fb)}.slab-a{--fb:#56739a}.slab-b{--fb:#a3634f}\n.nmw{min-width:0;padding:0 .3rem 0 .8rem}\n.nm{font:700 1.2rem/1.08 \"OSB Barlow\",Arial,sans-serif;letter-spacing:-.005em;padding-top:.18rem}\n.batw{display:flex;justify-content:center}\n.bat{width:.9rem;height:.9rem;border-radius:50%;background:#c41f2f;box-shadow:0 0 0 .14rem #f7f1e3,0 0 0 .24rem #c41f2f}\n.rc{position:relative;align-self:stretch;display:flex;align-items:center;justify-content:center;background:#1d2a44}\n.rc>.win{position:absolute;inset:0;background:#c41f2f}\n.runs{position:relative;font:700 2.1rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;color:#fff}\n.he{text-align:center;font:700 1.25rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;color:#5b6478;font-variant-numeric:tabular-nums}\n\n.card:has(.isBWinner[style*=\"opacity: 1\"]) .row-a :is(.nm,.he),.card:has(.isAWinner[style*=\"opacity: 1\"]) .row-b :is(.nm,.he){color:#626a7e}\n.card:has(.isBWinner[style*=\"opacity: 1\"]) .row-a :is(.slab),.card:has(.isAWinner[style*=\"opacity: 1\"]) .row-b :is(.slab){opacity:.5}\n.card:has(.isBWinner[style*=\"opacity: 1\"]) .row-a .runs,.card:has(.isAWinner[style*=\"opacity: 1\"]) .row-b .runs{color:#8d97ab}\n.bay{position:relative;display:flex;align-items:center;justify-content:space-between;height:5rem;padding:0 .9rem 0 1rem;background:#ece3cf;border-top:.14rem solid #1d2a44}\n\n.inn{display:flex;align-items:center;gap:.2rem;font:700 2rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;--half-on:#c41f2f;--half-off:rgba(29,42,68,.2);--half-h:2rem;--half-size:0.88rem}\n.inn{height:3rem;padding-right:1rem;border-right:.1rem solid rgba(29,42,68,.14)}\n.cl{flex:1;display:flex;align-items:center;justify-content:center;gap:.9rem}\n.diamond{--d:4rem;--base-edge:#1d2a44;--base-off:transparent;--base-on:#c41f2f;--base-line:.14rem}\n.cp{display:flex;align-items:center;gap:.85rem;height:3.9rem;padding:0 .8rem 0 .85rem;border-radius:.35rem;background:rgba(29,42,68,.075)}\n.count{font:700 1.95rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.02em}.count .dash{opacity:.6;margin:0 .08em}\n.bso{display:grid;grid-template-columns:auto auto;align-items:center;column-gap:.5rem;row-gap:.2rem;font:700 1rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.06em;color:#5b6478;--dot:.8rem;--dot-gap:.22rem;--dot-off:rgba(29,42,68,.17)}\n.bso>b{text-align:right}\n.ball-dots{--dot-on:#2f8a4c}.strike-dots{--dot-on:#c41f2f}.out-dots{--dot-on:#1d2a44}\n\n.cover{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;gap:.7rem;background:#ece3cf;text-transform:uppercase;text-align:center;white-space:nowrap}\n.cover b{font:700 1rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#5b6478}\n.cover .pl{font:700 1.6rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.06em;color:#1d2a44}\n.foot{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.8rem;height:2.05rem;padding:0 .9rem;background:#1d2a44;color:#f7f1e3;font:700 1rem/1 \"OSB Barlow\",\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\"