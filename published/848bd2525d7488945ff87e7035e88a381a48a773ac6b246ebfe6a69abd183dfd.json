{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Set Break</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1;position:relative}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.18)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing,.ldot{animation:none!important;transition:none!important}}\n.nm{display:block;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;line-height:1.02}\n.bal{text-wrap:balance}\n.st,.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hv{position:relative;display:inline-grid;place-items:center}.hv>*{grid-area:1/1}.hv>.w{display:block;align-self:stretch;justify-self:stretch}.hv>.num{position:relative}\n.ev,.rd{white-space:nowrap}\n.hc:not([style*=\"opacity: 1\"]),.cell:not([style*=\"opacity: 1\"]){display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 0 .15rem #0b1a12,0 0 .4rem #0007}\n\n.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}\n.board{position:relative;width:90rem;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff;background:linear-gradient(180deg,#0b2353,#071735);border-radius:.6rem;box-shadow:0 1.6rem 4rem #000b;overflow:hidden}\n.top{display:flex;flex-direction:column;align-items:center;gap:1.2rem;padding:2.6rem 4rem 2.4rem;border-bottom:.2rem solid #ffc629}\n.ctx{display:block;max-width:90rem;font-size:2rem;letter-spacing:.12em;text-transform:uppercase;color:#a9bde6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1}.ctx .sep{font-style:normal;color:#ffc629;margin:0 .7rem}\n.sslot{min-width:34rem}.sslot>.st{height:5.6rem;padding:.6rem 3rem 0;font-size:3.6rem;letter-spacing:.1em;background:#ffc629;color:#071735}\n.sslot .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;margin-left:.8rem}\n.sslot>.sdec{background:#ff6a1a;color:#fff}.sslot>.sbrk{background:#fff}.sslot>.sfin{background:#fff}\n.sslot>.gp{background:#ffe9a8;color:#071735;box-shadow:inset 0 -.6rem 0 #ffc629}.sslot>.mp{background:#e8202a;color:#fff}\n.labels{display:flex;align-items:stretch;height:3.6rem;padding:0 3rem;color:#8aa1d1;font-size:1.9rem;letter-spacing:.1em}\n.labels .team{flex:1;padding:1.2rem 0 0 2rem}\n.cells{display:flex;flex:none}.cell{width:7rem;display:flex;align-items:center;justify-content:center}\n.labels .cell{padding-top:.6rem}\n.colh{flex:none;display:flex;align-items:center;justify-content:center;padding-top:.6rem}.colh.p{width:8.6rem;color:#dfe8fb}.colh.s{width:9rem}\n.colh .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;margin-left:.4rem}\n.rows{padding:0 3rem 3rem}\n.r{position:relative;display:flex;align-items:stretch;height:9rem;background:#0f2b63;border-radius:.4rem}.rB{margin-top:.8rem}\n.chip{width:1.2rem;flex:none;border-radius:.4rem 0 0 .4rem}.chipA{background:#3d8bff}.chipB{background:#ff4b55}\n.who{flex:1;min-width:0;display:flex;align-items:center;gap:1.4rem;padding:.6rem 1.4rem 0 2rem}\n.nm{font-size:4.2rem;font-weight:700;text-transform:uppercase;line-height:1}\n.win{flex:none;padding:.5rem 1.2rem .2rem;border-radius:.3rem;background:#ffc629;color:#071735;font-size:2rem;letter-spacing:.1em}\n.r .cell .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:3.6rem;color:#fff}\n.cell .hv{min-width:5.4rem;height:5.4rem}\n.pts{width:8.6rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.4rem;margin:1rem 0;border-radius:.4rem;background:#fff;color:#071735;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:4.6rem;font-weight:700}\n.sets{width:9rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.4rem;margin-left:1rem;background:#ffc629;color:#071735;border-radius:0 .4rem .4rem 0;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:5.6rem;font-weight:700}\n.tw{flex:none;place-items:center start}.tob{display:flex;align-items:center;gap:.6rem;height:3rem;padding:.35rem 1rem 0;background:#ffc629;color:#071735;font-size:1.8rem;letter-spacing:.08em;border-radius:0 0 .3rem .3rem}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.2rem}\n\n.cells>.cell[style*=\"opacity: 1\"]:not(:has(~.cell[style*=\"opacity: 1\"])){max-width:1px!important;min-width:0!important;padding:0!important;margin:0!important;border:0!important;overflow:hidden;color:transparent!important;background:none!important;box-shadow:none!important}.cells>.cell[style*=\"opacity: 1\"]:not(:has(~.cell[style*=\"opacity: 1\"])) *{color:transparent!important;background:none!important;box-shadow:none!important;border-color:transparent!important}\n.cell .hv{min-width:3.6rem;height:3.6rem;padding-top:.3rem;border-radius:.3rem}\n.cell .hv>.w{background:#ffc629;border-radius:.3rem}\n.cell .hv:has(>.w[style*=\"opacity: 1\"])>.num{color:#071735}\n.cell:not(:has(.w[style*=\"opacity: 1\"])) .num{color:#7f95c4}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{background:#ffc629}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .rA,.board:has(.isBWinner[style*=\"opacity: 1\"]) .rB{background:#17408f;box-shadow:inset 0 0 0 .2rem #ffc629}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.rB .who,.rB .cells,.rB .pts,.rB .sets),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.rA .who,.rA .cells,.rA .pts,.rA .sets){opacity:0.45}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"top\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"ctx\"><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"slot sslot pslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span><span class=\"st pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"st pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span></div>\n<div class=\"labels\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"team\">TEAM</span><span class=\"cells\"><span class=\"cell ch c1 isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\">SET 1</span><span class=\"cell ch c2 isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\">SET 2</span><span class=\"cell ch c3 isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\">SET 3</span><span class=\"cell ch c4 isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\">SET 4</span><span class=\"cell ch c5 isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\">SET 5</span></span><span class=\"colh p\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"colh s\">SETS</span></div>\n<div class=\"rows\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"r rA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipA jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"who\"><span class=\"nm bal combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"slot tw\"><span class=\"win winA isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\">WINNER</span><span class=\"tob tobA isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span></span></span><span class=\"cells\"><span class=\"cell c1 isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame1AWon\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></i><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span></span><span class=\"cell c2 isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame2AWon\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></i><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span></span><span class=\"cell c3 isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame3AWon\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></i><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span></span><span class=\"cell c4 isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame4AWon\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></i><span class=\"num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span></span><span class=\"cell c5 isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame5AWon\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></i><span class=\"num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span></span></span><span class=\"pts num ptsA currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"sets num setsA setsWonA currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"r rB\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipB jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"who\"><span class=\"nm bal combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"slot tw\"><span class=\"win winB isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\">WINNER</span><span class=\"tob tobB isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></span></span><span class=\"cells\"><span class=\"cell c1 isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame1BWon\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></i><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"cell c2 isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame2BWon\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></i><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"cell c3 isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame3BWon\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></i><span class=\"num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"cell c4 isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame4BWon\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></i><span class=\"num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"cell c5 isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame5BWon\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></i><span class=\"num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span></span><span class=\"pts num ptsB currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"sets num setsB setsWonB currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<span class=\"osb-core-fields\"><span class=\"num timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\">0</span><span class=\"num timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\">0</span></span></section></main>\n</body>\n</html>\n","css":""}
