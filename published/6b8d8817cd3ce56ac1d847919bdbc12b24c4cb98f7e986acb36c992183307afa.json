{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dot Matrix Sentence Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { color: white; font-family: Arial, Helvetica, sans-serif; }\n.stage { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }\n.board { width: 100%; max-width: 1000px; display: flex; flex-direction: column; background: transparent; }\n.title { font-size: 90px; font-weight: 800; line-height: 1; text-align: center; margin-bottom: 54px; }\n.teams { display: flex; flex-direction: column; gap: 52px; }\n.team { display: flex; align-items: center; height: 300px; }\n.details { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; }\n.name-color { width: 100%; min-width: 0; display: block; background-color: #fff; background-clip: text; -webkit-background-clip: text; }\n.name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 132px; font-weight: 800; line-height: 1; color: transparent; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-line { display: flex; align-items: center; gap: 20px; margin-top: 12px; }\n.label { font-size: 52px; font-weight: 700; line-height: 1; }\n.match-score { display: block; width: 100px; height: 60px; font-size: 56px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-track { flex: 0 0 360px; min-width: 0; display: flex; flex-direction: column; align-items: center; }\n.primary-score { display: block; width: 100%; height: 250px; font-family: \"Arial Black\", Arial, sans-serif; font-size: 260px; font-weight: 900; line-height: .84; text-align: center; letter-spacing: -.07em; font-variant-numeric: tabular-nums; color: transparent; background-image: radial-gradient(ellipse 6px 4.8px at center, #ffc13a 98%, transparent 100%); background-size: 17px 13.6px; background-clip: text; -webkit-background-clip: text; transform: scaleY(1.25); transform-origin: center; }\n.points-label { font-size: 46px; margin-top: 7px; }\n.set-footer { display: flex; justify-content: center; align-items: center; gap: 17px; font-size: 58px; font-weight: 700; line-height: 1; margin-top: 32px; }\n.set-value { display: block; width: 66px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1040px) {\n  .title { font-size: clamp(28px, 8.5vw, 90px); }\n  .name { font-size: clamp(35px, 12vw, 125px); }\n  .primary-track { flex-basis: 36%; }\n  .primary-score { font-size: clamp(95px, 24vw, 260px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .title { font-size: 30px; margin-bottom: 33px; }\n  .teams { gap: 33px; }\n  .team { height: 162px; }\n  .name { font-size: 39px; }\n  .sets-line { gap: 8px; margin-top: 13px; }\n  .label { font-size: 24px; }\n  .match-score { width: 55px; height: 28px; font-size: 27px; }\n  .primary-track { flex-basis: 42%; }\n  .primary-score { height: 122px; font-size: 112px; background-image: radial-gradient(ellipse 2.6px 2.08px at center, #ffc13a 98%, transparent 100%); background-size: 7px 5.6px; }\n  .points-label { font-size: 18px; margin-top: 4px; }\n  .set-footer { font-size: 29px; margin-top: 30px; gap: 8px; }\n  .set-value { width: 33px; }\n}\n@media(min-width:601px) and (max-height:900px){.stage{height:100vh;min-height:0;overflow:hidden}.board{transform:scale(.74);transform-origin:center}}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"details columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"name-color jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label points-label\">POINTS</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"details columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"name-color jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label points-label\">POINTS</span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
