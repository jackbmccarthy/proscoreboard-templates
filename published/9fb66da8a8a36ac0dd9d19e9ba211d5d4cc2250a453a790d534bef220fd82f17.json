{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Split Court</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { display: flex; align-items: center; justify-content: center; width: 100vw; height: 100vh; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .osb { position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 64px 380px 132px; width: 1160px; border-radius: 14px; overflow: hidden; background: #0b0d12; color: #fff; box-shadow: 0 20px 50px #000c; }\n    .ev { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; gap: 18px; background: #0b0d12; font-size: 22px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: #c3c9d4; }\n    .ev .matchRound { color: #ff7a1a; }\n    .half { position: relative; display: grid; }\n    .half > * { grid-area: 1 / 1; }\n    .half.A { background: #33435e; } .half.B { background: #5c4b55; }\n    .wash { background-color: transparent; }\n    .wash::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(180deg, #0004, #000b); }\n    .half.A .wash::after { background: linear-gradient(90deg, #0003, #000c); }\n    .half.B .wash::after { background: linear-gradient(270deg, #0003, #000c); }\n    .wash { position: relative; }\n    .in { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 0 150px 0 40px; }\n    .half.B .in { padding: 0 40px 0 150px; }\n    .nm { max-width: 100%; font-size: 46px; font-weight: 700; line-height: 1; letter-spacing: 1px; text-transform: uppercase; text-align: center; text-shadow: 0 2px 8px #0008; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: normal; word-break: normal; hyphens: none; text-wrap: balance; }\n    .big { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 180px; font-weight: 700; line-height: 1; text-shadow: 0 6px 20px #0009; font-variant-numeric: tabular-nums; }\n    .meta { display: flex; align-items: center; gap: 18px; font-size: 20px; font-weight: 600; letter-spacing: 2px; color: #e5e8ee; }\n    .tor { display: flex; align-items: center; gap: 8px; }\n    .pips { display: flex; gap: 6px; }\n    .pip { width: 20px; height: 6px; background: #fff; }\n    .fl b { margin-left: 6px; }\n    .bonus { font-size: 16px; font-weight: 700; letter-spacing: 2px; padding: 3px 8px 2px; background: #ff7a1a; color: #0b0d12; }\n    .bonus:empty { display: none; }\n    .scw { position: relative; display: flex; justify-content: center; }\n    .poss { position: absolute; top: 50%; transform: translateY(-50%); display: flex; }\n    .half.A .poss { right: 100%; margin-right: 22px; } .half.B .poss { left: 100%; margin-left: 22px; }\n    .win { position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); width: 120px; height: 8px; border-radius: 4px; background: #ff7a1a; }\n    .arrow { padding: 4px 10px 3px; font-size: 16px; font-weight: 700; letter-spacing: 3px; background: #ff7a1a; color: #0b0d12; border-radius: 3px; }\n    .to { position: absolute; left: 40px; right: 150px; bottom: 34px; align-items: center; justify-content: center; gap: 14px; height: 70px; background: #ff7a1a; color: #0b0d12; border-radius: 4px; }\n    .half.B .to { left: 150px; right: 40px; }\n    .to-l { font-size: 24px; font-weight: 700; letter-spacing: 4px; }\n    .to-c { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 28px; font-weight: 700; }\n    .disc { position: absolute; left: 50%; top: calc(64px + 190px); transform: translate(-50%, -50%); z-index: 3; display: grid; width: 240px; height: 240px; border-radius: 50%; overflow: hidden; background: #0b0d12; border: 6px solid #ff7a1a; box-shadow: 0 10px 30px #000b; }\n    .disc > * { grid-area: 1 / 1; }\n    .live { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }\n    .per { font-size: 30px; font-weight: 700; letter-spacing: 2px; color: #0b0d12; background: #ff7a1a; padding: 2px 14px 1px; border-radius: 4px; }\n    .gc { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 66px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n    .gc b { color: #ff7a1a; padding: 0 2px; }\n    .shot { position: relative; display: flex; align-items: center; gap: 7px; height: 34px; padding: 0 4px 0 10px; background: #ff7a1a; color: #0b0d12; border-radius: 4px; font-size: 16px; font-weight: 700; letter-spacing: 2px; }\n    .shot-v { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 26px; font-weight: 700; line-height: 26px; color: #fff; background: #0b0d12; border-radius: 3px; min-width: 40px; padding: 0 5px; text-align: center; }\n    .run-shot { position: absolute; left: 0; right: 0; bottom: -6px; height: 3px; background: #ff7a1a; }\n    .runbar { position: absolute; left: 70px; right: 70px; bottom: 22px; height: 3px; border-radius: 2px; background: #ff7a1a; }\n    .state { z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; background: #ff7a1a; color: #0b0d12; }\n    .st-s { font-size: 22px; font-weight: 700; letter-spacing: 4px; }\n    .st-b { font-size: 70px; font-weight: 700; margin-top: 4px; }\n    .brk .half-t { font-size: 44px; }\n    .half-t { display: none; }\n    .fin { z-index: 2; background: #fff; }\n    .fin .st-b { font-size: 64px; }\n    .fin-ot { font-size: 22px; font-weight: 700; letter-spacing: 3px; margin-top: 4px; }\n    .lines { grid-column: 1 / -1; display: flex; align-items: stretch; justify-content: center; padding: 12px 0; background: #11141b; border-top: 1px solid #262b35; }\n    .col { display: grid; grid-template-rows: 26px 1fr 1fr; align-items: center; justify-items: center; width: 92px; }\n    .col i { font-style: normal; font-size: 16px; font-weight: 700; letter-spacing: 2px; color: #8b93a1; }\n    .col.key { width: 70px; justify-items: start; }\n    .key .k { display: flex; align-items: center; gap: 12px; min-width: 0; max-width: 100%; }\n    .chipw { display: flex; width: 44px; height: 26px; border-radius: 3px; background: #33435e; }\n    .k.b .chipw { background: #5c4b55; }\n    .chip { flex: 1; border-radius: 2px; background-color: transparent; }\n    .cell { position: relative; display: flex; align-items: center; justify-content: center; height: 100%; }\n    .cell > * { grid-area: 1 / 1; }\n    .v { display: flex; flex-direction: column; align-items: center; justify-content: space-around; height: 100%; }\n    .col > .v, .col > .dash { grid-row: 2 / 4; align-self: stretch; }\n    .num { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 30px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n    .dash { display: flex; flex-direction: column; align-items: center; justify-content: space-around; color: #4a505c; font-size: 30px; line-height: 1; }\n    .col:has(.v[style*=\"opacity: 1\"]) .dash { display: none; }\n    .col.ot:not(:has(.v[style*=\"opacity: 1\"])) { display: none; }\n    .col.tot { width: 108px; margin-left: 10px; background: #1b2029; border-radius: 6px; }\n    .col.tot .num { color: #ff7a1a; font-size: 34px; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .end-t { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .half-t { display: block; }\n    .fin-ot { display: none; }\n    .osb:has(.isGame5Started[style*=\"opacity: 1\"]) .fin-ot { display: block; }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .final-dim { opacity: .5; }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .half.B :is(.in, .wash), .osb:has(.isBWinner[style*=\"opacity: 1\"]) .half.A :is(.in, .wash) { opacity: .5; filter: grayscale(.6); }\n    .osb:has(.isAWinner[style*=\"opacity: 1\"]) .k.b, .osb:has(.isBWinner[style*=\"opacity: 1\"]) .k.a { opacity: .5; }\n    .pips { gap: 0 !important; }\n    .pips > [class*=\"TimeoutLeft\"] { margin-right: 4px; }\n    .pips > [style*=\"opacity: 0\"] { width: 0 !important; margin: 0 !important; }\n    .pips > .pip[style*=\"opacity: 0\"] { display: none !important; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<article class=\"osb\" aria-label=\"Basketball full-screen score\">\n  <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n  <div class=\"half A\"><span class=\"wash jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"in\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"scw\"><span class=\"poss final-dim\"><span class=\"arrow isAPossession\" data-osb-component=\"field\" data-osb-field=\"isAPossession\" style=\"opacity: 0;\">BALL</span></span><span class=\"big currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0;\"></span><div class=\"meta final-dim\"><span class=\"tor\"><span>TO</span><span class=\"pips\"><span class=\"pip isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isATimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\">FOULS <b class=\"teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</b></span><span class=\"bonus bonusA\" data-osb-component=\"field\" data-osb-field=\"bonusA\"></span></div><span class=\"to isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></div></div>\n  <div class=\"half B\"><span class=\"wash jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"in\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"scw\"><span class=\"poss final-dim\"><span class=\"arrow isBPossession\" data-osb-component=\"field\" data-osb-field=\"isBPossession\" style=\"opacity: 0;\">BALL</span></span><span class=\"big currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0;\"></span><div class=\"meta final-dim\"><span class=\"tor\"><span>TO</span><span class=\"pips\"><span class=\"pip isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft3\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft3\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft4\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft4\" style=\"opacity: 0;\"></span><span class=\"pip isBTimeoutLeft5\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft5\" style=\"opacity: 0;\"></span></span></span><span class=\"fl\">FOULS <b class=\"teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</b></span><span class=\"bonus bonusB\" data-osb-component=\"field\" data-osb-field=\"bonusB\"></span></div><span class=\"to isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display: none; opacity: 0;\"><span class=\"to-l\">TIMEOUT</span><span class=\"to-c timeoutClock\" data-osb-component=\"field\" data-osb-field=\"timeoutClock\"></span></span></div></div>\n  <div class=\"disc\">\n    <div class=\"live\"><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span><span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"shot isShotClockActive\" data-osb-component=\"field\" data-osb-field=\"isShotClockActive\" style=\"opacity: 0;\">SHOT<span class=\"shot-v\" data-osb-static=\"true\" data-sport-stat=\"shotClock\"></span><span class=\"run-shot isShotClockRunning\" data-osb-component=\"field\" data-osb-field=\"isShotClockRunning\" style=\"opacity: 0;\"></span></span><span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span></div>\n    <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"end-t st-s\">END OF</span><span class=\"end-t st-b\"><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"period\"></span></span><span class=\"half-t st-b\">HALFTIME</span></div>\n    <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FINAL</span><span class=\"fin-ot\">OVERTIME</span></div>\n  </div>\n  <div class=\"lines\"><span class=\"col key\"><i></i><span class=\"k a\"><span class=\"chipw\"><span class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span></span><span class=\"k b\"><span class=\"chipw\"><span class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span></span></span><span class=\"col\"><i>Q1</i><span class=\"dash\"><span>&ndash;</span><span>&ndash;</span></span><span class=\"v isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"col\"><i>Q2</i><span class=\"dash\"><span>&ndash;</span><span>&ndash;</span></span><span class=\"v isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"col\"><i>Q3</i><span class=\"dash\"><span>&ndash;</span><span>&ndash;</span></span><span class=\"v isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><span class=\"num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"col\"><i>Q4</i><span class=\"dash\"><span>&ndash;</span><span>&ndash;</span></span><span class=\"v isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"><span class=\"num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><span class=\"num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"col ot\"><i>OT</i><span class=\"dash\"><span>&ndash;</span><span>&ndash;</span></span><span class=\"v isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display: none; opacity: 0;\"><span class=\"num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><span class=\"num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span><span class=\"col tot\"><i>T</i><span class=\"v\"><span class=\"num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></span></div>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span><span class=\"timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span><span class=\"possessionSide\" data-osb-component=\"field\" data-osb-field=\"possessionSide\"></span><span class=\"shotClockStatus\" data-osb-component=\"field\" data-osb-field=\"shotClockStatus\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
