{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Box Score</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1;position:relative}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.18)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing,.ldot{animation:none!important;transition:none!important}}\n.nm{display:block;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;line-height:1.02}\n.bal{text-wrap:balance}\n.st,.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hv{position:relative;display:inline-grid;place-items:center}.hv>*{grid-area:1/1}.hv>.w{display:block;align-self:stretch;justify-self:stretch}.hv>.num{position:relative}\n.ev,.rd{white-space:nowrap}\n.hc:not([style*=\"opacity: 1\"]),.cell:not([style*=\"opacity: 1\"]){display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 0 .15rem #0b1a12,0 0 .4rem #0007}\n\n.stage{position:fixed;left:6.4rem;bottom:4.8rem}\n.board{position:relative;width:68rem;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff;filter:drop-shadow(0 .5rem 1.2rem #000a)}\n.head{display:flex;align-items:stretch;height:3.6rem;background:#07110f}\n.sslot{width:16rem;flex:none}.sslot>.st{padding:.35rem 1rem 0;font-size:1.9rem;letter-spacing:.08em;background:#22c06b;color:#04110b}\n.sslot .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;margin-left:.45rem}\n.sslot>.sdec{background:#ffb81c}.sslot>.sbrk{background:#2a3b37;color:#fff}.sslot>.sfin{background:#fff}\n.sslot>.gp{background:#e9fff2;color:#04110b;box-shadow:inset 0 -.5rem 0 #22c06b}.sslot>.mp{background:#ff3b3b;color:#fff}\n.ctx{flex:1;min-width:0;display:block;padding:1rem 1.2rem 0;font-size:1.7rem;letter-spacing:.07em;text-transform:uppercase;color:#a8c4ba;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1}.ctx .sep{font-style:normal;color:#22c06b;margin:0 .55rem}\n.labels{display:flex;align-items:stretch;height:2.6rem;background:#0f1d1a;color:#7f9e93;font-size:1.6rem;letter-spacing:.08em}\n.labels .team{flex:1;padding:.6rem 0 0 2.2rem}\n.cells{display:flex;flex:none}.cell{width:4.8rem;display:flex;align-items:center;justify-content:center}\n.labels .cell{padding-top:.35rem}\n.colh{flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem}.colh.s{width:5.6rem}.colh.p{width:8rem;background:#1b2e29;color:#cfe9de}\n.colh .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;margin-left:.35rem}\n.r{position:relative;display:flex;align-items:stretch;min-height:5.8rem;background:#13241f}.rB{border-top:.1rem solid #ffffff14}\n.chip{width:1rem;flex:none}.chipA{background:#2f80ff}.chipB{background:#ff4d4d}\n.nm{flex:1;align-self:center;padding:.5rem .8rem 0 1.2rem;font-size:2.6rem;font-weight:700;text-transform:uppercase}\n.sv{width:3.4rem;flex:none;place-items:center}.vball{width:2.4rem;height:2.4rem}\n.win{display:grid;place-items:center;width:2.7rem;height:2.7rem;border-radius:50%;background:#22c06b;color:#04110b;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;font-size:1.8rem;font-weight:900}\n.pips{flex:none;display:flex;flex-direction:column;justify-content:center;gap:.45rem;padding:0 1rem}.pip{position:relative;display:block;width:2.2rem;height:.8rem;border-radius:.1rem;box-shadow:inset 0 0 0 .15rem #7fd3a6}.pip>.lit{position:absolute;inset:0;border-radius:inherit;background:#22c06b}\n.r .cell .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:2.4rem;color:#e8f3ef}\n.sets{width:5.6rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem;background:#0f1d1a;color:#22c06b;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.2rem;font-weight:700}\n.pts{width:8rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.35rem;background:#fff;color:#07110f;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:4.4rem;font-weight:700}\n.rB .pts{border-top:.1rem solid #d5dfdb}\n.tob{position:absolute;left:100%;top:0;bottom:0;display:flex;align-items:center;gap:.6rem;padding:.35rem 1.1rem 0;background:#22c06b;color:#04110b;font-size:1.9rem;letter-spacing:.06em;white-space:nowrap}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.3rem}\n\n.cells>.cell[style*=\"opacity: 1\"]:not(:has(~.cell[style*=\"opacity: 1\"])){max-width:1px!important;min-width:0!important;padding:0!important;margin:0!important;border:0!important;overflow:hidden;color:transparent!important;background:none!important;box-shadow:none!important}.cells>.cell[style*=\"opacity: 1\"]:not(:has(~.cell[style*=\"opacity: 1\"])) *{color:transparent!important;background:none!important;box-shadow:none!important;border-color:transparent!important}\n.cell .hv{min-width:3.6rem;height:3.6rem;padding-top:.3rem;border-radius:.3rem}\n.cell .hv>.w{background:#22c06b;border-radius:.3rem}\n.cell .hv:has(>.w[style*=\"opacity: 1\"])>.num{color:#04110b}\n.cell:not(:has(.w[style*=\"opacity: 1\"])) .num{color:#7f9e93}\n.board:has(.isGame1AWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame2AWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame3AWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame4AWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsA,.board:has(.isGame5AWon[style*=\"opacity: 1\"]) .ptsA,.board:has(.isGame1BWon[style*=\"opacity: 1\"]):not(:has(.isGame2Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame2BWon[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:has(.isGame5BWon[style*=\"opacity: 1\"]) .ptsB{background:#22c06b}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .rA .sets,.board:has(.isBWinner[style*=\"opacity: 1\"]) .rB .sets{background:#22c06b;color:#04110b}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.rB .nm,.rB .sets,.rB .pts,.rB .pips,.rB .cells),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.rA .nm,.rA .sets,.rA .pts,.rA .pips,.rA .cells){opacity:0.42}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"head\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"slot sslot pslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span><span class=\"st pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"st pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"ctx\"><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span></div>\n<div class=\"labels\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"team\">TEAM</span><span class=\"cells\"><span class=\"cell ch c1 isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\">1</span><span class=\"cell ch c2 isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\">2</span><span class=\"cell ch c3 isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\">3</span><span class=\"cell ch c4 isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\">4</span><span class=\"cell ch c5 isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\">5</span></span><span class=\"colh s\">SETS</span><span class=\"colh p\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span></div>\n<div class=\"r rA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipA jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"nm bal combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"slot sv\"><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"win winA isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"><b>&#10003;</b></span></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity:0\"></b></i></span><span class=\"cells\"><span class=\"cell c1 isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame1AWon\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></i><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span></span><span class=\"cell c2 isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame2AWon\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></i><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span></span><span class=\"cell c3 isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame3AWon\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></i><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span></span><span class=\"cell c4 isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame4AWon\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></i><span class=\"num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span></span><span class=\"cell c5 isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><span class=\"hv a\"><i class=\"w isGame5AWon\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></i><span class=\"num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span></span></span><span class=\"sets num setsA setsWonA currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"pts num ptsA currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"tob tobA isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span></div>\n<div class=\"r rB\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip chipB jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"nm bal combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"slot sv\"><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"win winB isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\"><b>&#10003;</b></span></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity:0\"></b></i></span><span class=\"cells\"><span class=\"cell c1 isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame1BWon\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></i><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"cell c2 isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame2BWon\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></i><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"cell c3 isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame3BWon\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></i><span class=\"num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"cell c4 isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame4BWon\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></i><span class=\"num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"cell c5 isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><span class=\"hv b\"><i class=\"w isGame5BWon\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></i><span class=\"num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span></span><span class=\"sets num setsB setsWonB currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"pts num ptsB currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"tob tobB isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"num tclock timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></div>\n<span class=\"osb-core-fields\"><span class=\"num timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\">0</span><span class=\"num timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\">0</span></span></section></main>\n</body>\n</html>\n","css":""}
