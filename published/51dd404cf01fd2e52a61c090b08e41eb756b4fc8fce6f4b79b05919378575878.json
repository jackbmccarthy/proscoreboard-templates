{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Vertical Name Spine PICKLEBALL 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#0e2735}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh}.board{width:min(var(--view-width),1400px,var(--height-width));container-type:inline-size;position:relative;display:flex;flex-direction:column;background:transparent;padding-bottom:3.5cqw}.header{color:#f5f1e7;font-size:var(--header-size);line-height:1;margin:0 0 var(--header-gap);text-align:center;white-space:nowrap}.panes{display:flex;gap:var(--pane-gap)}.pane{display:flex;flex-shrink:0;min-width:0;height:var(--pane-height);background:#f1ede4}.spine{position:relative;flex:0 0 var(--spine-width);background:#0e2735;min-width:0;height:100%;overflow:hidden}.name{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-90deg);display:block;width:var(--name-length);height:calc(var(--name-font) * 1.12);font-size:var(--name-font);line-height:1.12;white-space:nowrap;text-align:center;color:#f5f1e7;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.025em}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{position:absolute;left:50%;bottom:.5cqw;transform:translateX(-50%);font-size:1.6cqw;width:1.6cqw;height:1.6cqw;color:#f5f1e7}.face{flex:1;min-width:0;display:flex;flex-direction:column;align-items:stretch;padding:var(--face-pad)}.secondary{display:flex;justify-content:center;align-items:center;color:#b66345;gap:1cqw;min-height:var(--secondary-height)}.label{font-size:var(--label-size);line-height:1.1;text-align:center;white-space:nowrap}.games,.match-score{font-size:var(--games-size);line-height:1.1}.match-score{min-width:2ch;font-variant-numeric:tabular-nums;text-align:center}.primary{min-width:0;display:flex;flex-direction:column;align-items:center;margin-top:var(--score-gap)}.score{display:block;width:100%;font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;font-size:var(--score-size);line-height:.9;text-align:center;letter-spacing:-.07em;white-space:nowrap;font-variant-numeric:tabular-nums;transform:scaleY(var(--score-stretch));transform-origin:center}.primary>.label{margin-top:var(--point-gap)}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:40cqw;height:2.3cqw;font-size:1.9cqw;text-align:center;color:#f5f1e7}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{--view-width:94vw}.point-slot{font-size:2.2cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:70vw;--height-width:121vh;--header-size:7.5cqw;--header-gap:2.8cqw;--pane-gap:2cqw;--pane-height:28.6cqw;--spine-width:11.3%;--name-length:24.6cqw;--name-font:5.5cqw;--face-pad:1.2cqw 4cqw;--secondary-height:4.5cqw;--games-size:3.6cqw;--score-size:19cqw;--score-stretch:1;--score-gap:0cqw;--point-gap:.2cqw;--label-size:4cqw}.panes{flex-direction:column}.pane{width:100%}\n@media(max-width:600px){.board{--view-width:94vw}.point-slot{font-size:clamp(10px,2.2cqw,14px)}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">PICKLEBALL</h1><div class=\"panes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"pane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"face columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"secondary\"><div class=\"label games\">GAMES</div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"primary\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><div class=\"label\">POINTS</div></div></div></div><div class=\"pane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"face columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"secondary\"><div class=\"label games\">GAMES</div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"primary\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><div class=\"label\">POINTS</div></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
