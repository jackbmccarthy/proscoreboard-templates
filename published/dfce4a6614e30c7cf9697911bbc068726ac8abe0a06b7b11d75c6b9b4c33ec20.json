{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Petrol Chalk Leadscore Volleyball 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f7f9f5}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}\n.board{width:min(55vw,1140px);min-width:0;background:#18353f;border:1px solid #4d6970;border-radius:3px;overflow:hidden}\n.header{height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 34px;border-bottom:1px solid #4d6970;background:#18353f;color:#f7f9f5;font-size:clamp(14px,1.7vw,32px);font-weight:700;letter-spacing:.035em;line-height:1}\n.sport-tag{white-space:nowrap}.status{white-space:nowrap}.status [data-sport-stat]{font-variant-numeric:tabular-nums}\n.lane{height:142px;display:flex;align-items:stretch;min-width:0;background:#18353f}\n.lane+.lane{border-top:1px solid #4d6970}\n.tick{width:32px;flex:none;border-right:4px solid #18353f}\n.jerseyColorA{background-color:#2786a5}.jerseyColorB{background-color:#c76a61}\n.primary{width:185px;flex:none;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#e9eee8;color:#18353f;border-right:1px solid #4d6970}\n.primary .value{font-size:90px;font-weight:700;line-height:.94;font-variant-numeric:tabular-nums}\n.primary .caption{margin-top:5px;font-size:23px;font-weight:700;line-height:1;letter-spacing:.02em}\n.name{flex:1;min-width:0;display:flex;align-items:center;padding:0 34px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#f7f9f5;font-size:70px;font-weight:700;line-height:1.1}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.support{width:142px;flex:none;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#18353f;color:#f7f9f5}\n.support .value{font-size:64px;font-weight:400;line-height:1;font-variant-numeric:tabular-nums}\n.support .caption{margin-top:5px;font-size:23px;font-weight:700;line-height:1}\n.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:1400px){.header{height:clamp(34px,3.28vw,68px);padding-inline:3%}.lane{height:clamp(68px,6.83vw,142px)}.tick{width:2.8%;border-right-width:2px}.primary{width:16.3%}.primary .value{font-size:clamp(39px,4.32vw,90px)}.primary .caption{font-size:clamp(10px,1.1vw,23px)}.name{padding-inline:3%;font-size:clamp(25px,3.37vw,70px)}.support{width:12.5%}.support .value{font-size:clamp(25px,3.08vw,64px)}.support .caption{font-size:clamp(10px,1.1vw,23px)}}\n@media(max-width:700px){.stage{padding:10px}.board{width:100%}.header{font-size:12px;height:32px;padding-inline:12px}.lane{height:68px}.tick{width:8px;border-right-width:1px}.primary{width:68px}.primary .value{font-size:38px}.primary .caption{font-size:9px;margin-top:2px}.name{font-size:clamp(18px,6vw,30px);padding-inline:12px}.support{width:50px}.support .value{font-size:29px}.support .caption{font-size:9px;margin-top:2px}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<header class=\"header\"><span class=\"sport-tag\">VOLLEYBALL</span><span class=\"status\">SET <span data-osb-static=\"true\" data-sport-stat=\"set\">0</span></span></header>\n<div class=\"lane\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"primary\"><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div><div class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></div><div class=\"support\"><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">SETS</span></div></div>\n<div class=\"lane\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"primary\"><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div><div class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></div><div class=\"support\"><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">SETS</span></div></div>\n<div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></div>\n</article>\n</main>\n</body>\n</html>\n","css":""}
