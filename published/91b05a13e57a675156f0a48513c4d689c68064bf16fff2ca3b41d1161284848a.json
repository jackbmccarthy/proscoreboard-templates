{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Table Tennis — Copper Cream Keyline Stat Lower Third</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--cream:#f2efe8;--copper:#78544a;--ink:#263540;--rule:#aeb9b0;--white:#fbfaf6;display:flex;flex-direction:column;width:min(80.5vw,1675px);min-width:0;overflow:hidden;border:1px solid var(--rule);border-radius:3px;background:var(--cream);color:var(--ink);container-type:inline-size}\n.topline{position:relative;display:flex;flex:0 0 auto;height:3.55cqw;align-items:center;padding:0 1.5cqw;background:var(--copper);color:var(--white);font-size:2.1cqw;line-height:1;font-weight:700;white-space:nowrap}\n.sides{display:flex;min-width:0}\n.side{display:flex;flex:1 1 50%;min-width:0;min-height:10.5cqw;align-items:stretch}\n.side+.side{border-left:1px solid var(--rule)}\n.identity{display:block;flex:0 0 3%;width:3%;background:#2685a2}\n.jerseyColorB{background:#c76863}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:.4cqw;padding:0 1.5cqw}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.5cqw;line-height:1.04;font-weight:700}\n.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 .4cqw;width:.4cqw;height:.4cqw;min-width:5px;min-height:5px;border-radius:50%;background:var(--ink)}\n.support-track,.scorecap{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;white-space:nowrap}\n.support-track{flex:0 0 16.6%;width:16.6%;align-self:stretch;margin:1.4cqw 0;border:1px solid var(--rule);border-radius:3px;background:var(--cream)}\n.scorecap{flex:0 0 22.7%;width:22.7%;align-self:stretch;margin:.6cqw .7cqw .6cqw 1cqw;border-radius:4px;background:var(--ink);color:var(--white)}\n.support-score,.primary-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.support-score{font-size:3.6cqw}.primary-score{font-size:4.7cqw}\n.support-label,.primary-label{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:1.3cqw;line-height:1;font-weight:700}\n.point-slot{position:absolute;right:1%;top:0;width:17%;height:100%;font-size:.8cqw;font-weight:700;text-align:center}\n.point-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--copper)}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:94vw}.topline{height:28px;padding:0 7px;font-size:12px}.side{min-height:86px}.identity{flex-basis:5px;width:5px}.name-lane{gap:2px;padding:0 3px}.name{font-size:13px}.serve{flex-basis:5px;width:5px;height:5px}.support-track{flex-basis:24%;width:24%;margin:6px 0}.scorecap{flex-basis:29%;width:29%;margin:3px 2px 3px 3px}.support-score{font-size:22px}.primary-score{font-size:30px}.support-label,.primary-label{font-size:7px}.point-slot{font-size:6px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"topline\"><span>TABLE TENNIS</span><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div><div class=\"sides rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"support-track\"><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-label\">GAMES</span></div><div class=\"scorecap\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\">POINTS</span></div></div><div class=\"side rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"support-track\"><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-label\">GAMES</span></div><div class=\"scorecap\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\">POINTS</span></div></div></div></article></main></body></html>\n","css":""}
