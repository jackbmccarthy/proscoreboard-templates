{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>BASKETBALL — Marine Parchment Terminal stacked</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}.board{--marine:#173947;--paper:#ece5d7;--white:#f7f9f6;display:flex;flex-direction:column;min-width:0;max-width:100%;overflow:hidden;border-radius:5px;background:var(--marine);container-type:inline-size;font-variant-numeric:tabular-nums}.board.stacked{width:min(72vw,1456px)}.board.horizontal{width:min(88vw,1910px)}.header{display:flex;align-items:center;flex:none;width:100%;min-width:0;background:var(--paper);color:var(--marine)}.stacked .header{height:6.6cqw;padding:0 2.5cqw}.horizontal .header{height:3.9cqw;padding:0 1.8cqw}.sport-tag{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:800;line-height:1}.stacked .sport-tag{flex:1 1 0;font-size:4.1cqw}.horizontal .sport-tag{flex:1 1 0;font-size:2.15cqw}.horizontal.soccer .sport-tag{flex:0 1 auto;margin-right:5.4cqw}.stats{display:flex;align-items:center;min-width:0}.stat{display:flex;align-items:center;white-space:nowrap;border-left:1px solid var(--marine);font-weight:700;line-height:1}.stacked .stat{gap:1.3cqw;padding:0 2.8cqw;font-size:1.5cqw}.stacked .stat-value{font-size:2.65cqw}.horizontal .stat{gap:1.1cqw;padding:0 2.5cqw;font-size:1.1cqw}.horizontal .stat-value{font-size:1.75cqw}.horizontal.basketball .stat:first-child{border-left:0}.competitors{display:flex;min-width:0}.stacked .competitors{flex-direction:column}.horizontal .competitors{flex-direction:row}.lane{display:flex;align-items:stretch;min-width:0;background:var(--marine)}.stacked .lane{height:11.35cqw}.horizontal .lane{flex:1 1 50%;height:7.25cqw}.stacked .lane+.lane{border-top:1px solid #aec1c2}.horizontal .lane+.lane{border-left:1px solid #aec1c2}.identity{display:block;flex:none;background:#2f8eaa}.stacked .identity{width:1.9%}.horizontal .identity{align-self:center;width:2.2%;height:88%;margin-left:.25cqw}.jerseyColorB{background:#cb746a}.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--white);font-weight:700;line-height:1.05}.stacked .name{padding:0 2.7cqw;font-size:5.35cqw}.horizontal .name{padding:0 1.8cqw;font-size:3.3cqw}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.support-track,.primary-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;min-width:0;text-align:center;line-height:1}.support-track{background:var(--marine);color:var(--paper)}.stacked .support-track{width:13%}.horizontal .support-track{width:13%}.support-value{display:block;max-width:100%;overflow:hidden;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}.stacked .support-value{font-size:4.5cqw}.horizontal .support-value{font-size:2.85cqw}.support-label{font-weight:700;white-space:nowrap}.stacked .support-label{font-size:1.6cqw}.horizontal .support-label{font-size:1.15cqw}.primary-track{align-self:center;background:var(--paper);color:var(--marine)}.stacked .primary-track{width:14.3%;height:84%;margin:0 .65cqw 0 1.7cqw;border-radius:5px}.horizontal .primary-track{width:18%;height:86%;margin:0 .55cqw 0 .7cqw;border-radius:5px}.primary-value{display:block;max-width:100%;overflow:hidden;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}.stacked .primary-value{font-size:6.5cqw}.horizontal .primary-value{font-size:4.25cqw}.primary-label{font-weight:800;white-space:nowrap}.stacked .primary-label{font-size:1.65cqw}.horizontal .primary-label{font-size:1.25cqw}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.board.stacked,.board.horizontal{width:100%}.header,.stacked .header,.horizontal .header{height:auto;min-height:49px;padding:5px 8px;flex-wrap:wrap;gap:3px 8px}.sport-tag,.stacked .sport-tag,.horizontal .sport-tag{flex:1 1 100%;font-size:17px}.horizontal.soccer .sport-tag{margin-right:0}.stats{width:100%;justify-content:flex-end}.stat,.stacked .stat,.horizontal .stat{gap:4px;padding:0 7px;font-size:10px}.stat:first-child{border-left:0}.stat-value,.stacked .stat-value,.horizontal .stat-value{font-size:14px}.horizontal .competitors{flex-direction:column}.lane,.stacked .lane,.horizontal .lane{flex:0 0 auto;height:78px}.horizontal .lane+.lane{border-left:0;border-top:1px solid #aec1c2}.identity,.stacked .identity{width:5px}.horizontal .identity{width:5px;margin-left:0}.name,.stacked .name,.horizontal .name{padding:0 10px;font-size:clamp(17px,6vw,27px)}.support-track,.stacked .support-track,.horizontal .support-track{width:56px}.support-value,.stacked .support-value,.horizontal .support-value{font-size:25px}.support-label,.stacked .support-label,.horizontal .support-label{font-size:9px}.primary-track,.stacked .primary-track,.horizontal .primary-track{width:84px;height:88%;margin:0 5px}.primary-value,.stacked .primary-value,.horizontal .primary-value{font-size:41px}.primary-label,.stacked .primary-label,.horizontal .primary-label{font-size:10px}}@media(max-width:380px){.support-track,.stacked .support-track,.horizontal .support-track{width:46px}.primary-track,.stacked .primary-track,.horizontal .primary-track{width:74px}.name,.stacked .name,.horizontal .name{padding:0 7px;font-size:16px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board stacked basketball columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"BASKETBALL scoreboard\"><div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">BASKETBALL</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static basketball counters\"><span class=\"stat\"><span data-osb-component=\"text\">CLOCK</span><strong class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"clock\">00:00</strong></span><span class=\"stat\"><span data-osb-component=\"text\">PERIOD</span><strong class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</strong></span><span class=\"stat\"><span data-osb-component=\"text\">SHOT</span><strong class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"shot\">00</strong></span></div></div><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</strong><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"primary-value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</strong><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"primary-value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong><span class=\"primary-label\" data-osb-component=\"text\">POINTS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
