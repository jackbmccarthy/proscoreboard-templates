onts/scoreboard/barlow-700-latin-ext.woff2\") format(\"woff2\");unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;ascent-override:95%;descent-override:25%;line-gap-override:0%}\n:root{--fc:\"OSB Barlow Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;--fn:\"OSB Barlow\",\"Roboto Condensed\",Arial,sans-serif;--navy:#06182c;--panel:#0f2b4b;--strip:#0b223d;--mid:#16365c;--cyan:#38bdf8;--ink:#e6f2ff;--soft:#c9dbef;--gold:#fbbf24;--red:#e11d48;--rowh:6.4rem;--cw:4.4rem;--gw:6.6rem;--sw:7.4rem;--pw:7.2rem}\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.osb-core-fields{display:none!important}\n.num{font-family:var(--fn);font-variant-numeric:tabular-nums;white-space:nowrap}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1}\ni{font-style:normal}\n.sn>i,.st>i,.hc>i,.tou>i,.tob>*,.tag>i,.lv>i,.ch>i,.cell .num,.sets,.pv,.win>i,.nm,.ev,.rd,.call>*,.cl,.dash{text-box:trim-both cap alphabetic}\n@keyframes osbPulse{50%{filter:brightness(1.25)}}\n@media (prefers-reduced-motion: reduce){.tag,.fill,.isMatchPoint{animation:none!important}}\n\n/* stage: lower third, bottom left */\n.stage{position:fixed;left:6.4rem;bottom:4.8rem}\n.board{position:relative;display:flex;flex-direction:column;width:max-content;font-family:var(--fc);font-weight:700;color:#fff;text-transform:uppercase;line-height:1;filter:drop-shadow(0 .4rem 1rem #000a)}\n\n/* team tie strip (team matches only) */\n.tie{display:flex;align-items:center;gap:1.4rem;height:4.4rem;padding:0 1.4rem;background:var(--ink);color:var(--navy);font-size:2.4rem;letter-spacing:.03em;white-space:nowrap}\n.tie:has(>.teamAName:empty):has(>.teamBName:empty),.tie:has(>.teamAName[style*=\"display: none\"]){display:none}\n.tlogo{display:block;width:3rem;height:3rem;object-fit:contain;flex:none}.tlogo:not([src]),.tlogo[src=\"\"]{display:none}\n.tchip{display:block;flex:none;width:.6rem;height:2.8rem}\n.tname{flex:1;text-box:trim-both cap alphabetic}.tname.tb{text-align:right}\n.tsc{display:flex;align-items:center;gap:.5rem;flex:none;padding:0 .6rem;font-size:3rem}.tdash{color:#4b6a8c}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>:not(.tie){display:none!important}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>.tie{height:6.4rem;font-size:2.6rem;background:var(--panel);color:#fff;box-shadow:inset .9rem 0 0 var(--cyan)}\n\n/* header: state | event . round | point tag | column heads | CALL */\n.head{display:flex;align-items:stretch;height:6.2rem;background:var(--navy);font-size:2.3rem;letter-spacing:.06em;white-space:nowrap}\n.stab{flex:none;display:flex;align-items:center;justify-content:center;gap:.8rem;padding:0 1.3rem;font-size:2.1rem;background:var(--cyan);color:var(--navy)}\n.stk{place-items:center end}.stk>.st{display:flex;align-items:center;justify-content:flex-end;white-space:nowrap}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .tpre,.board:has(.isWarmUpStarted[style*=\"opacity: 1\"]) .tpre,.board:has(.isComplete[style*=\"opacity: 1\"]) .tpre{visibility:hidden}\n.board:not(:has(.isMatchStarted[style*=\"opacity: 1\"])) .stab{background:var(--mid);color:var(--ink)}.board:has(.isWarmUpStarted[style*=\"opacity: 1\"]):not(:has(.isMatchStarted[style*=\"opacity: 1\"])) .stab{background:var(--gold);color:var(--navy)}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .swarm,.board:has(.isComplete[style*=\"opacity: 1\"]) .swarm{visibility:hidden}\n.slive{display:none!important}.board:has(.isMatchStarted[style*=\"opacity: 1\"]):not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):not(:has(.isComplete[style*=\"opacity: 1\"])) .slive{display:flex!important}\n.stab{position:relative}.sbar{position:absolute;left:0;right:0;bottom:0;height:.45rem;background:#f43f5e}.board:has(.isComplete[style*=\"opacity: 1\"]) .sbar{visibility:hidden}.lvs{flex:none;place-items:center}\n.sbrk{display:grid!important;place-items:center}.sbrk>.eg{grid-area:1/1;visibility:hidden}\n.lv{display:block;flex:none;width:1.4rem;height:1.4rem;border-radius:50%;background:#f43f5e;box-shadow:0 0 0 .25rem #0005}.lv>i{display:none}\n.ttop{display:flex;align-items:stretch;height:3.8rem;background:#041222}.ctx{flex:1;display:flex;align-items:center;gap:.8rem;padding:0 1.4rem;color:var(--soft);font-size:2.2rem;letter-spacing:.06em;white-space:nowrap}.hsp{flex:1}\n.rd::before{content:\"\\00b7\";margin-right:.8rem;color:var(--cyan)}.ev:empty+.rd::before{display:none}\n.ptag{flex:none;align-self:stretch;margin-left:1rem}\n.tag{display:flex;align-items:center;justify-content:center;height:6.2rem;padding:0 1rem;border-radius:0;font-size:2.3rem;letter-spacing:.06em;white-space:nowrap}\n.tag.gp{background:var(--gold);color:var(--navy)}\n.tag.mp{background:var(--red);color:#fff;box-shadow:inset 0 -.4rem 0 var(--gold);animation:osbPulse 1.6s ease-in-out infinite}\n.board:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint{visibility:hidden}\n.hcells{flex:none;display:flex;justify-content:flex-end;min-width:calc(3 * var(--cw))}\n.hc{flex:none;display:flex;align-items:center;justify-content:center;color:var(--soft)}\n.cell.ch{width:var(--cw);font-size:2.3rem}\n.hc.g{width:var(--gw);font-size:2rem;letter-spacing:0}\n.hcall{flex:none;width:calc(var(--sw) + var(--pw));padding-left:.7rem}\n.hcall>*{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;padding:0;background:var(--cyan);color:var(--navy)}\n.cl{font-size:1.6rem;letter-spacing:.12em}.cl{display:inline-grid}.cl>b{grid-area:1/1;font-weight:inherit;text-align:center}.cl>.ln{visibility:hidden}.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .cl>.lc{visibility:hidden}.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .cl>.ln{visibility:visible}\n.call{display:inline-flex;align-items:center;gap:.25rem;font-family:var(--fn);font-size:3rem;letter-spacing:0}\n.call>.ca{order:1}.call>.d1{order:2}.call>.cb{order:3}.call>.dbl{order:4;display:inline-flex;align-items:center;gap:.25rem}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call>.ca{order:3}.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call>.cb{order:1}\n.call>.dbl:not([style*=\"opacity: 1\"]){display:none}\n.cn{display:inline-grid}.cn>i{grid-area:1/1}.cn:has(>.isSecondServer[style*=\"opacity: 1\"])>.one{display:none}\n.board:not(:has(.isMatchStarted[style*=\"opacity: 1\"])) .hcall>.kcall{background:var(--mid);color:var(--soft)}\n.hcall>.kfin{display:none;background:var(--mid);color:var(--ink);font-size:2.1rem;letter-spacing:.08em}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .hcall>.kcall{display:none}.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .hcall>.kcall{background:var(--mid);color:var(--soft)}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .hcall>.kfin{display:flex}\n\n/* player rows */\n.r{display:flex;align-items:center;height:var(--rowh);background:var(--panel)}\n.rB{box-shadow:inset 0 .1rem 0 #ffffff24}\n.chip{align-self:stretch;width:1rem;flex:none}.chipA{background:#60a5fa}.chipB{background:#fb7185}\n.who{flex:1;display:flex;align-items:center;padding:0 1.6rem 0 1.4rem}\n.nm{display:block;font-size:3.4rem;letter-spacing:.01em;white-space:nowrap}\n.mk{flex:none;display:flex;align-items:center;gap:.8rem;padding-right:1.4rem}\n.cards{position:relative;width:3.2rem;height:2.9rem}.cards>.card{position:absolute;top:0}.cards>.yc{left:0}.cards>.rc{left:1.2rem}\n.card{display:block;width:2rem;height:2.9rem;border-radius:.2rem;box-shadow:0 0 0 .1rem #0008}.yc{background:#ffd200}.rc{background:#ef2b36}\n.toslot{justify-items:start;align-items:center}\n.toslot:has(>.tob[style*=\"opacity: 1\"]:not([style*=\"display: none\"]))>.tou{display:none}\n.tou,.tob{display:flex;align-items:center;justify-content:center;gap:.6rem;height:3.4rem;padding:0 .9rem;border-radius:.3rem;font-size:2.1rem;letter-spacing:.06em;white-space:nowrap}\n.tou{background:var(--soft);color:var(--navy)}\n.tob{background:var(--cyan);color:var(--navy);justify-self:stretch}.tob>b{font-family:var(--fn);font-size:2.4rem;letter-spacing:0}\n.ghost{visibility:hidden}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .toslot>.tou,.board:has(.isComplete[style*=\"opacity: 1\"]) .toslot>.tob{visibility:hidden}\n\n/* completed games, in order from G1, packed against GAMES; the game in play shows only as the live points */\n.cells{flex:none;display:flex;justify-content:flex-end;min-width:calc(3 * var(--cw))}\n.cell{flex:none;width:var(--cw);display:flex;align-items:center;justify-content:center}\n.hv{position:relative;display:grid;place-items:center;width:3.8rem;height:3.8rem;border-radius:.3rem;background:#163a60}.hv>*{grid-area:1/1}\n.hv>.w{position:absolute;left:12%;right:12%;bottom:.25rem;height:.35rem;border-radius:.2rem;background:var(--navy)}.hv{position:relative}\n.hv>.num{position:relative;font-size:2.7rem;color:#c3d6ec}\n.hv:has(>.w[style*=\"opacity: 1\"]){background:var(--cyan)}.hv:has(>.w[style*=\"opacity: 1\"])>.num{color:var(--navy)}\n.setc{flex:none;align-self:stretch;width:var(--gw);display:flex;align-items:center;justify-content:center;background:var(--strip)}\n.sets{font-size:3.3rem;color:#7dd3fc}\n.sv{flex:none;width:var(--sw);place-items:center}\n.srv{display:flex;align-items:center;gap:.5rem}\n.sn{display:grid;place-items:center;min-width:2.6rem;height:2.8rem;padding:0 .5rem;border-radius:.3rem;background:#f7f9e6;color:#0b1a12;font-family:var(--fn);font-size:2.1rem;font-weight:800;box-shadow:0 0 0 .12rem #0b1a12}.sn>i{grid-area:1/1}.sn:has(>.two[style*=\"opacity: 1\"])>.one{display:none}\n.pball{display:block;width:3.2rem;height:3.2rem;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 32%,#fbffb4,#d8f22c 58%,#a6c214);box-shadow:0 0 0 .14rem #0b1a12}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .srv{visibility:hidden}\n.pts{flex:none;position:relative;align-self:stretch;width:var(--pw);display:grid;place-items:center;background:#fff;color:var(--navy)}.pts>.pv,.pts>.dash,.pts>.win{grid-area:1/1}\n.rB .pts{box-shadow:inset 0 .1rem 0 #c7d6e6}\n.fill{position:absolute;left:0;top:0;bottom:0;width:.8rem;animation:none!important}.fill.gp{background:#fff7}.fill.mp{background:#fffb}\n.pts:has(>.fill.mp[style*=\"opacity: 1\"])>.fill.gp{visibility:hidden}\n.pts:has(>.fill.gp[style*=\"opacity: 1\"]){background:var(--gold)}.pts:has(>.fill.mp[style*=\"opacity: 1\"]){background:var(--red);color:#fff;animation:osbPulse 1.6s ease-in-out infinite}\n.pv{position:relative;font-size:4.4rem}\n.dash{display:none;font-size:3.4rem;color:#6d87a6}\n.win{display:none;align-items:center;justify-content:center;width:100%;height:100%;background:var(--cyan);color:var(--navy);font-size:2.3rem;letter-spacing:.08em}\n/* between games: no points for the game that has not started; at the final the points give way to the result */\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .pts,.board:has(.isComplete[style*=\"opacity: 1\"]) .pts{background:var(--strip);box-shadow:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .pv,.board:has(.isComplete[style*=\"opacity: 1\"]) .pv{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .dash{display:block}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .win{display:flex}\n.board:has(.isComplete[style*=\"opacity: 1\"]):has(.isAWinner[style*=\"opacity: 1\"]) .ptsB>.dash,.board:has(.isComplete[style*=\"opacity: 1\"]):has(.isBWinner[style*=\"opacity: 1\"]) .ptsA>.dash{display:block}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .rB .nm,.board:has(.isBWi