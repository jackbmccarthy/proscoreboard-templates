{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Oyster Slate Underbar — Soccer 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#283844}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(94vw,970px);container-type:inline-size;border-radius:3px;overflow:hidden}.lanes{background:#ece8df}.lane{display:grid;grid-template-columns:2.2% minmax(0,1fr) 18% 14%;height:12.5cqw;min-height:62px;max-height:140px;align-items:stretch}.lane+.lane{border-top:1px solid #aeb7b7}.tick{display:block;background:#2684a3}.jerseyColorB.tick{background:#c86a61}.name{min-width:0;display:flex;align-items:center;padding:0 3%;font-size:6.2cqw;font-weight:700;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.primary,.support{display:flex;flex-direction:column;justify-content:center;align-items:center;min-width:0;line-height:1}.primary{background:#283844;color:#fff}.primary-value{display:block;max-width:100%;font-size:7.4cqw;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}.caption{font-size:2.15cqw;font-weight:700;margin-top:.35cqw}.support{background:#ece8df}.support-value{font-size:5.6cqw;font-weight:700;font-variant-numeric:tabular-nums}.underbar{min-height:7.6cqw;background:#283844;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 2.8%;gap:2%;font-weight:700}.sport-tag{font-size:3.4cqw;white-space:nowrap}.status{display:flex;align-items:center;gap:0}.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:10cqw;padding:0 1.6cqw;white-space:nowrap}.stat+.stat{border-left:1px solid #b8c1be}.stat-label{font-size:1.55cqw}.stat-value{font-size:3.1cqw;font-variant-numeric:tabular-nums}.runtime-retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}@media(max-width:600px){.lane{grid-template-columns:2% minmax(0,1fr) 25% 15%;height:66px}.name{font-size:5.7cqw;padding:0 4%}.primary-value{font-size:8cqw}.caption{font-size:2.3cqw}.support-value{font-size:6cqw}.underbar{min-height:42px}.sport-tag{font-size:3.1cqw}.stat{min-width:12cqw;padding:0 1cqw}.stat-label{font-size:1.8cqw}.stat-value{font-size:3.5cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" aria-label=\"Soccer scoreboard\"><div class=\"lanes columnContainer\" data-osb-component=\"layout\"><div class=\"lane rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\" data-osb-component=\"text\">GOALS</span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-a\">0</span><span class=\"caption\" data-osb-component=\"text\">FOULS</span></div></div><div class=\"lane rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\" data-osb-component=\"text\">GOALS</span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"fouls-b\">0</span><span class=\"caption\" data-osb-component=\"text\">FOULS</span></div></div></div><footer class=\"underbar rowContainer\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"status rowContainer\" data-osb-component=\"layout\"><div class=\"stat\"><span class=\"stat-label\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat\"><span class=\"stat-label\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></div></div></footer><div class=\"runtime-retained\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body></html>\n","css":""}
