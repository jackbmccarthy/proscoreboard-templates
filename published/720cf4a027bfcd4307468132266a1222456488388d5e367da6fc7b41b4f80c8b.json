{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Slate Lime Desk PICKLEBALL 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f1f4f6}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--view-width),var(--max-width),var(--height-width));position:relative;container-type:inline-size;background:transparent;padding-bottom:3cqw}.desk{background:#20262e;border:1px solid #485766;border-radius:3px;overflow:hidden;min-width:0;width:100%}.row,.lane,.name-cell,.name-wrap{min-width:0}.identity{display:block;background:#b6cf61;flex-shrink:0}.name-wrap{display:flex;align-items:center;flex:1 1 0;gap:1cqw}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{display:block;flex:0 0 1.2cqw;width:1.2cqw;font-size:1.2cqw;line-height:1;text-align:center}.score,.match-score{display:block;width:100%;font-size:var(--score-font);line-height:1.1;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}.match-score{font-size:var(--match-font)}.label{color:#a8bbca;font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:36cqw;height:2cqw;font-size:1.5cqw;text-align:center;color:#f1f4f6}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}.pictogram{position:relative;width:5.2cqw;height:4.2cqw}.paddle{position:absolute;left:.3cqw;top:0;width:2.8cqw;height:3cqw;border-radius:50%;background:#a8bbca;transform:rotate(35deg)}.paddle:after{content:\"\";position:absolute;bottom:-1cqw;left:.8cqw;width:.65cqw;height:1.3cqw;background:#a8bbca;border-radius:.15cqw}.paddle.second{left:3.1cqw;top:.35cqw;width:2cqw;height:2.3cqw;transform:rotate(35deg)}.paddle.second:after{left:.55cqw}.ball{position:absolute;left:2cqw;bottom:0;width:.6cqw;height:.6cqw;border-radius:50%;background:#a8bbca}.ball.second{left:4.1cqw}.pickleball{border-radius:50%;width:4.2cqw;height:4.2cqw;background:#b6cf61}.hole{position:absolute;width:.58cqw;height:.72cqw;border-radius:50%;background:#20262e}.h0{left:1.8cqw;top:.25cqw}.h1{left:.5cqw;top:.9cqw;transform:rotate(30deg)}.h2{right:.5cqw;top:.9cqw;transform:rotate(-30deg)}.h3{left:1.8cqw;top:1.75cqw}.h4{left:.6cqw;bottom:.6cqw;transform:rotate(-30deg)}.h5{right:.6cqw;bottom:.6cqw;transform:rotate(30deg)}.h6{left:1.8cqw;bottom:.2cqw}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:62vw;--max-width:1200px;--height-width:250vh;--name-font:5.6cqw;--score-font:6.6cqw;--match-font:5.25cqw;--label-font:2.5cqw;--match-width:16.5%;--point-width:24%}.header{display:flex;align-items:center;min-height:6.4cqw;border-bottom:2px solid #b6cf61}.title{flex:1;min-width:0;padding-left:2.7cqw;font-size:3.7cqw;color:#a8bbca}.header .games,.game-cell{flex:0 0 var(--match-width)}.header .points,.point-cell{flex:0 0 var(--point-width)}.row{display:flex;align-items:stretch;min-height:11.6cqw;background:#2a3440}.row+.row{border-top:1px solid #52616f}.name-cell{display:flex;align-items:center;flex:1 1 0;padding:0 1.5cqw;gap:2.7cqw}.identity{width:1cqw;height:7.3cqw;border-radius:2px}.game-cell,.point-cell{display:flex;align-items:center;justify-content:center;border-left:1px solid #44525e}.point-cell{background:#374451}.row .name-wrap{gap:.6cqw}@media(max-width:600px){.board{--view-width:94vw;--label-font:2.5cqw;--name-font:5.8cqw}.point-slot{height:2.3cqw;font-size:2cqw}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><div class=\"title\">PICKLEBALL</div><div class=\"label games\">GAMES</div><div class=\"label points\">POINTS</div></header><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
