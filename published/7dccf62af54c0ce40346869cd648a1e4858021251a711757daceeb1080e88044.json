{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Table Tennis — Limestone Inset Subscore Scorebug</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--limestone:#ebe9e2;--ink:#243941;--teal:#365d67;--line:#aeb9b5;position:relative;display:flex;flex-direction:column;width:min(59vw,1110px);height:min(17.2vw,324px);min-width:0;min-height:0;overflow:visible;border:2px solid var(--line);border-radius:5px;background:var(--limestone);color:var(--ink);container-type:inline-size}\n.competitors{display:flex;flex:1 1 auto;flex-direction:column;min-width:0;min-height:0}\n.side{display:flex;flex:1 1 50%;min-width:0;min-height:0;align-items:stretch}\n.side+.side{border-top:2px solid var(--line)}\n.identity-name{display:flex;flex:1 1 auto;min-width:0;align-items:center}\n.identity{display:block;flex:0 0 1.2cqw;width:1.2cqw;height:75%;margin-left:1.2cqw;background:#e52b35}\n.jerseyColorB{background:#1458b5}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:.55cqw;padding:0 2.0cqw}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.35cqw;line-height:1;font-weight:700;letter-spacing:-.03em}\n.combinedAName:empty::before{content:'Player A'}.combinedBName:empty::before{content:'Player B'}\n.serve{display:block;flex:0 0 .55cqw;width:.55cqw;height:.55cqw;min-width:5px;min-height:5px;border-radius:50%;background:var(--teal)}\n.game-wrap{display:flex;flex:0 0 14%;min-width:0;align-items:center;justify-content:center}\n.game-cell{display:flex;flex:0 0 10.8cqw;width:10.8cqw;height:80%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:.2cqw;overflow:hidden;border-radius:2px;background:var(--teal);color:#fff}\n.games-label,.points-label{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:1.8cqw;line-height:1;font-weight:700;letter-spacing:.015em}\n.match-score{display:block;max-width:100%;min-width:0;overflow:hidden;white-space:nowrap;text-align:center;font-size:6.1cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.point-track{display:flex;flex:0 0 20%;min-width:0;align-items:center;justify-content:center;gap:1.1cqw;flex-direction:row;color:var(--ink)}\n.points-label{font-size:2.0cqw;font-weight:700}\n.primary-score{display:block;max-width:100%;min-width:0;overflow:hidden;white-space:nowrap;text-align:center;font-size:8.0cqw;line-height:1;font-weight:800;font-variant-numeric:tabular-nums;color:var(--ink)}\n.baseline{display:flex;flex:0 0 16%;min-height:0;align-items:center;padding:0 1.5cqw;border-top:2px solid var(--line)}\n.sport-tag{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:2.45cqw;line-height:1;font-weight:700;letter-spacing:.01em}\n.point-slot{position:absolute;right:0;bottom:100%;width:150px;height:18px;color:#fff;text-align:center;font-size:10px;font-weight:700}\n.point-state{position:absolute;inset:0;display:block;padding:3px 4px;background:var(--teal)}\n.point-slot:has(>.isMatchPoint[style*='opacity: 1'])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*='opacity:1'])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:96vw;height:188px;max-height:none}.baseline{flex-basis:29px;padding:0 7px}.sport-tag{font-size:12px}.identity{flex-basis:4px;width:4px;height:65%;margin-left:7px}.name-lane{gap:2px;padding:0 7px}.name{font-size:22px}.serve{flex-basis:5px;width:5px;height:5px}.game-wrap{flex-basis:59px}.game-cell{flex-basis:50px;width:50px;height:76%;gap:2px}.games-label,.points-label{font-size:9px}.match-score{font-size:30px}.point-track{flex-basis:73px;gap:0;flex-direction:column}.primary-score{font-size:41px}.point-slot{height:16px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><section class=\"side side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-name\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div></div><div class=\"game-wrap\"><div class=\"game-cell\"><span class=\"games-label\">GAMES</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div><div class=\"point-track\"><span class=\"points-label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"side side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-name\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div></div><div class=\"game-wrap\"><div class=\"game-cell\"><span class=\"games-label\">GAMES</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-track\"><span class=\"points-label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section></div><footer class=\"baseline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\">TABLE TENNIS</span></footer><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
