{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Oyster Slate Underbar TABLE TENNIS 1</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; min-height: 100%; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #283844; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; }\n.board { --board-width: 1160px; --row-direction: column; --lane-height: 137px; --tick-width: 36px; --name-padding: 42px; --name-size: clamp(30px, 4vw, 72px); --primary-width: 19%; --support-width: 17%; --primary-size: clamp(44px, 5vw, 88px); --support-size: clamp(32px, 3.5vw, 62px); --caption-size: clamp(13px, 1.2vw, 22px); --underbar-height: 68px; --underbar-padding: 42px; --sport-size: clamp(18px, 2vw, 35px); --row-border-top: 1px solid #aeb4b2; --row-border-left: 0; }\n.board { --oyster: #ece8df; --slate: #283844; width: min(100%, var(--board-width)); background: var(--oyster); border-radius: 3px; overflow: hidden; }\n.rows { display: flex; flex-direction: var(--row-direction); min-width: 0; }\n.lane { display: flex; flex: 1 1 0; min-width: 0; height: var(--lane-height); background: var(--oyster); }\n.lane { flex: 0 0 var(--lane-height); }\n.lane + .lane { border-top: var(--row-border-top); border-left: var(--row-border-left); }\n.identity { flex: 0 0 var(--tick-width); background: #2684a3; }\n.jerseyColorB { background: #c86a61; }\n.name-cell { display: flex; align-items: center; flex: 1 1 0; min-width: 0; gap: 8px; padding: 0 var(--name-padding); }\n.name { display: block; flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--name-size); line-height: 1.1; font-weight: 700; }\n.combinedAName:empty::before { content: \"Player A\"; }\n.combinedBName:empty::before { content: \"Player B\"; }\n.serve { flex: 0 0 12px; width: 12px; height: 12px; color: #283844; font-size: 11px; line-height: 12px; text-align: center; }\n.primary, .support { display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; min-width: 0; font-variant-numeric: tabular-nums; }\n.primary { flex-basis: var(--primary-width); color: #fff; background: var(--slate); }\n.support { flex-basis: var(--support-width); color: var(--slate); background: var(--oyster); }\n.value { display: block; width: 100%; text-align: center; font-weight: 700; white-space: nowrap; line-height: 1; }\n.primary .value { font-size: var(--primary-size); }\n.support .value { font-size: var(--support-size); }\n.caption { display: block; margin-top: 3px; font-size: var(--caption-size); line-height: 1; font-weight: 700; text-align: center; }\n.underbar { position: relative; display: flex; align-items: center; width: 100%; height: var(--underbar-height); padding: 0 var(--underbar-padding); background: var(--slate); color: #fff; border-top: 1px solid #b8c1be; }\n.sport-tag { font-size: var(--sport-size); font-weight: 700; letter-spacing: .045em; white-space: nowrap; }\n.point-slot { position: relative; margin-left: auto; width: 116px; height: 18px; font-size: 11px; line-height: 18px; text-align: right; }\n.point-label { position: absolute; inset: 0; white-space: nowrap; }\n.point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint { opacity: 0 !important; }\n@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n@media (max-width: 640px) {\n  .board { width: min(100%, 520px); --row-direction: column; --lane-height: 76px; --tick-width: 5px; --name-padding: 12px; --name-size: 22px; --primary-width: 76px; --support-width: 61px; --primary-size: 34px; --support-size: 27px; --caption-size: 10px; --underbar-height: 38px; --underbar-padding: 14px; --sport-size: 13px; --row-border-top: 1px solid #aeb4b2; --row-border-left: 0; }\n  .point-slot { width: 92px; font-size: 9px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n      <div class=\"rows columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n      <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n        <div class=\"name-cell\">\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span>\n        </div>\n        <div class=\"primary\"><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n        <div class=\"support\"><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">GAMES</span></div>\n      </div>\n      <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n        <div class=\"name-cell\">\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span>\n        </div>\n        <div class=\"primary\"><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n        <div class=\"support\"><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">GAMES</span></div>\n      </div>\n      </div>\n      <div class=\"underbar\">\n        <span class=\"sport-tag\">TABLE TENNIS</span>\n        <span class=\"point-slot\">\n          <span class=\"point-label isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span>\n          <span class=\"point-label isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span>\n        </span>\n      </div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
