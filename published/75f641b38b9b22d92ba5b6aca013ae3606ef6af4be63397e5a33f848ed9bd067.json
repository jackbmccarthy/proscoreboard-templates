{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Score Halo Volleyball — Duel</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #fafafa; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { display: flex; flex-direction: column; width: 100%; max-width: 1440px; }\n.title { text-align: center; font-weight: 800; font-size: 82px; line-height: 1; margin-bottom: 48px; }\n.duel { display: flex; gap: 170px; }\n.team { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; }\n.name { width: 100%; min-width: 0; text-align: center; font-size: 94px; font-weight: 800; line-height: 1; margin-bottom: 29px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.cluster { display: flex; align-items: flex-end; }\n.halo { display: flex; border-radius: 50%; background: #99b795; padding: 8px; aspect-ratio: 1; flex: 0 0 69%; min-width: 0; }\n.ring-gap { width: 100%; display: flex; border: 9px solid #07100d; border-radius: 50%; }\n.disc { width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; border: 6px solid #99b795; background: #e0e8d9; color: #0b1d1d; }\n.label { font-size: 39px; line-height: 1; letter-spacing: .11em; font-weight: 600; margin-bottom: 14px; }\n.score { width: 100%; display: block; text-align: center; font-size: 232px; font-weight: 800; line-height: .92; font-variant-numeric: tabular-nums; letter-spacing: -.05em; padding-right: .05em; }\n.sets-halo { flex-basis: 34%; padding: 6px; margin-left: -10px; margin-bottom: 18px; }\n.sets-halo .ring-gap { border-width: 7px; }\n.sets-halo .disc { border-width: 4px; }\n.sets-halo .label { font-size: 27px; letter-spacing: .09em; margin-bottom: 6px; }\n.sets-halo .score { font-size: 78px; line-height: .95; }\n.set-footer { display: flex; flex-direction: column; align-items: center; margin-top: -6px; gap: 5px; font-size: 32px; letter-spacing: .14em; font-weight: 600; }\n.set-value { display: block; width: 100px; text-align: center; font-size: 78px; line-height: 1; letter-spacing: 0; font-weight: 700; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1480px) {\n  .duel { gap: 9vw; }\n  .title { font-size: clamp(30px, 5.5vw, 82px); }\n  .name { font-size: clamp(27px, 6.1vw, 94px); }\n  .label { font-size: clamp(16px, 2.5vw, 39px); }\n  .score { font-size: clamp(46px, 15vw, 224px); }\n  .sets-halo .label { font-size: clamp(12px, 1.7vw, 27px); }\n  .sets-halo .score { font-size: clamp(24px, 5vw, 78px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .title { font-size: 29px; margin-bottom: 32px; }\n  .duel { gap: 24px; }\n  .name { font-size: 27px; margin-bottom: 17px; }\n  .halo { padding: 3px; flex-basis: 72%; }\n  .ring-gap { border-width: 3px; }\n  .disc { border-width: 2px; }\n  .label { font-size: 12px; letter-spacing: .05em; margin-bottom: 6px; }\n  .score { font-size: 48px; }\n  .sets-halo { flex-basis: 36%; padding: 2px; margin-left: -7px; margin-bottom: 4px; }\n  .sets-halo .ring-gap { border-width: 2px; }\n  .sets-halo .disc { border-width: 2px; }\n  .sets-halo .label { font-size: 9px; margin-bottom: 4px; }\n  .sets-halo .score { font-size: 24px; }\n  .set-footer { margin-top: 22px; font-size: 18px; gap: 5px; }\n  .set-value { width: 45px; font-size: 36px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <div class=\"cluster rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n            <div class=\"halo jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"label\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div>\n            <div class=\"halo sets-halo\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"label\">SETS</span><span class=\"score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div></div>\n          </div>\n        </div>\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <div class=\"cluster rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n            <div class=\"halo jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"label\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div>\n            <div class=\"halo sets-halo\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"label\">SETS</span><span class=\"score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div>\n          </div>\n        </div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
