{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Final Line Score</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}\n.slab{position:relative;flex:none;overflow:hidden}.slab>.jc{position:absolute;inset:0}\n.slab>.home{position:absolute;left:50%;bottom:.35rem;width:.8rem;height:.82rem;margin-left:-.4rem;background:#fff;clip-path:polygon(0 0,100% 0,100% 58%,50% 100%,0 58%)}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.25rem)}\n.dot{position:relative;flex:none;width:var(--dot,.82rem);height:var(--dot,.82rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18))}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inn-n{min-width:1.1em;text-align:left}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:.5em;overflow-wrap:normal;word-break:normal;hyphens:none}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:has(+.ev-r:not(:empty))::after{content:\"\\00b7\";margin-left:.5em;opacity:.75}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end;white-space:nowrap}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.4em}.st-live-in>i{flex:none;width:.8rem;height:.8rem;border-radius:50%;background:var(--live,#ff3b30);box-shadow:0 0 .45rem var(--live,#ff3b30);animation:osb-pulse 1.4s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.7}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ls{display:flex}\n.ls-col{position:relative}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.ls-gate{display:flex;flex-direction:column;position:relative}\n.ls-c{position:relative;display:flex;align-items:center;justify-content:center}\n\n.ls-cur{position:absolute;inset:0;pointer-events:none}\n.tick{position:relative}.tick>.tick-on,.tick>.tick-cur{position:absolute;inset:0;border-radius:inherit}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#f4f6fa;background:radial-gradient(ellipse at 50% 28%,rgba(26,40,68,.97),rgba(7,11,20,.98));--live:#ff3b30}\n.sum{width:72rem;display:flex;flex-direction:column;gap:1.4rem}\n.topr{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem}\n.ttl{display:flex;flex-direction:column;gap:.6rem;min-width:0}\n.kick{font:700 1.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#ffc83d}\n.ttl .ev{font:700 2.7rem/1.05 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.01em}\n.ttl .ev-r{color:#9aa7bc}\n.badge{position:relative;flex:none;display:grid;align-items:center;justify-items:end}\n.badge>*{grid-area:1/1}\n.badge .st{font:700 1.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em}.badge .st-pre{color:#9aa7bc}\n.badge .isComplete{padding:.6rem 1.5rem;border-radius:.3rem;background:#ffc83d;color:#111b2d;font:700 2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.18em}\n.lsw{display:flex;border-radius:.45rem;overflow:hidden;background:#111b2d;box-shadow:0 .7rem 2.2rem rgba(0,0,0,.45)}\n.ls-h{display:flex;align-items:center;justify-content:center;height:2.6rem;background:#1f2d48;color:#c9d3e3;font:700 1.25rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em}\n.ls-col{display:flex;flex-direction:column;width:3.3rem;flex:none}\n.ls-col,.tot{border-left:.08rem solid rgba(255,255,255,.08)}\n.ls-c,.v,.nmc{height:5rem}\n.ls-c+.ls-c,.v+.v,.nmc+.nmc{border-top:.08rem solid rgba(255,255,255,.08)}\n.ls-c{font:700 2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.ls-cur{background:rgba(255,200,61,.13)}\n.ls-col:has(>.ls-cur[style*=\"opacity: 1\"])>.ls-h{background:#ffc83d;color:#111b2d}\n.ls-extra .ls-h{color:#ffc83d}\n.names{flex:1;min-width:0;display:flex;flex-direction:column;background:#0d1626}\n.nmc{display:flex;align-items:center}\n.slab{align-self:stretch;width:1.1rem;background:var(--fb)}.slab-a{--fb:#5e6b80}.slab-b{--fb:#7d8798}\n.slab>.home{bottom:.5rem}\n.nmw{flex:1;min-width:0;padding:0 .8rem 0 1.4rem}\n.nm{font:700 2.3rem/1.02 \"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.01em}\n.batw{flex:none;width:4.4rem;display:grid;place-items:center}.batw>*{grid-area:1/1}\n.wtag{padding:.4rem .6rem;border-radius:.25rem;background:#ffc83d;color:#111b2d;font:700 1.1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em}.bat{width:1rem;height:1rem;border-radius:50%;background:#ffc83d;box-shadow:0 0 .6rem #ffc83d}\n.tot{display:flex;border-left:.2rem solid #1f2d48!important}\n.tot>span{display:flex;flex-direction:column;width:3.6rem}.tot>.rcol{width:4.8rem}\n.v{position:relative;display:flex;align-items:center;justify-content:center;font:700 2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;color:#9aa7bc}\n.rcol .v{color:#f4f6fa;font-size:2.7rem;background:#1a2740}\n.rcol .win{position:absolute;inset:0;background:#ffc83d}.rcol .runs{position:relative}\n.rcol .v:has(>.win[style*=\"opacity: 1\"]){color:#111b2d}\n.lsw:has(.isBWinner[style*=\"opacity: 1\"]) .nm-a :is(.nm,.slab),.lsw:has(.isAWinner[style*=\"opacity: 1\"]) .nm-b :is(.nm,.slab){opacity:.45}\n.lsw:has(.isBWinner[style*=\"opacity: 1\"]) :is(.ls-c:nth-child(1 of .ls-c),.va),.lsw:has(.isAWinner[style*=\"opacity: 1\"]) :is(.ls-c:nth-child(2 of .ls-c),.vb){opacity:.45}\n.bot{position:relative;display:flex;align-items:center;justify-content:space-between;gap:2rem;height:5.6rem;padding:0 1.8rem;border-radius:.45rem;background:#111b2d}\n.sit{display:flex;align-items:center;gap:2.2rem}\n\n.inn{display:flex;align-items:center;gap:.2rem;font:700 2.4rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;--half-on:#ffc83d;--half-off:rgba(255,255,255,.2);--half-h:2.4rem;--half-size:1.06rem}\n.diamond{--d:4.4rem;--base-edge:#e6ebf3;--base-off:rgba(255,255,255,.06);--base-on:#ffc83d;--base-line:.14rem}\n.cnt{display:flex;flex-direction:column;align-items:center;gap:.32rem}\n.count{font:700 2.1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.02em}.count .dash{opacity:.6;margin:0 .08em}\n.bs{display:flex;gap:.5rem;--dot:0.9rem;--dot-gap:.2rem;--dot-off:rgba(255,255,255,.17)}.ball-dots{--dot-on:#4fdc8a}.strike-dots{--dot-on:#ff5a52}\n.outw{display:flex;flex-direction:column;align-items:center;gap:.32rem;--dot:1rem;--dot-gap:.3rem;--dot-off:rgba(255,255,255,.17);--dot-on:#ffc83d}\n.outs-l{font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.12em;color:#9aa7bc}\n.outw{flex-direction:row;gap:.6rem}\n.leg{display:flex;align-items:center;gap:1.6rem;font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.12em;color:#9aa7bc;text-transform:uppercase}\n.leg>span{display:flex;align-items:center;gap:.55rem}\n.leg i{display:inline-block;width:.9rem;height:.9rem}.leg .lb{border-radius:50%;background:#ffc83d}.leg .lh{background:#9aa7bc;clip-path:polygon(0 0,100% 0,100% 58%,50% 100%,0 58%)}\n\n.cover{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;gap:.6rem;background:#111b2d;text-transform:uppercase;text-align:center;white-space:nowrap}\n.cover b{font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#9aa7bc}\n.cover .pl{font:700 1.8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.05em;color:#f4f6fa}\n.cover.fin{font:700 1.98rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#ffc83d}\n.cover{border-radius:.45rem}\n.inns{display:flex;align-items:baseline;gap:.45em;font:700 1.7rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#9aa7bc;text-transform:uppercase}\n.cover.fin{gap:1.4rem}\n.bot>.cover.fin{display:none}.board:has(.isComplete[style*=\"opacity: 1\"]) .bot>.cover.fin{display:flex}\n</style></head><body><main class=\"board\" aria-label=\"Baseball full-screen scoreboard\">\n<section class=\"sum columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball line score\">\n<div class=\"topr\"><div class=\"ttl\"><span class=\"kick\">BASEBALL · Line score</span><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchR