{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Score Halo Volleyball — Stacked</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f8fafb; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { --points-diameter: 280px; --sets-diameter: 180px; --label-space: 46px; width: 100%; max-width: 1000px; display: flex; flex-direction: column; }\n.title { text-align: center; font-size: 58px; font-weight: 700; letter-spacing: .16em; padding-left: .16em; margin-bottom: 50px; }\n.teams { display: flex; flex-direction: column; gap: 24px; }\n.team { display: flex; align-items: center; gap: 30px; height: calc(var(--points-diameter) + var(--label-space)); min-height: 0; }\n.name { flex: 1 1 0; min-width: 0; min-height: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 126px; line-height: 1.1; font-weight: 800; letter-spacing: -.03em; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-track { --diameter: var(--points-diameter); display: flex; flex-direction: column; align-items: center; gap: 14px; flex: 0 0 var(--diameter); min-width: 0; min-height: 0; }\n.sets-track { --diameter: var(--sets-diameter); }\n.label { font-size: 32px; letter-spacing: .14em; line-height: 1; }\n.halo { width: var(--diameter); height: var(--diameter); flex: 0 0 var(--diameter); min-width: 0; min-height: 0; border-radius: 50%; background: #9cbc94; padding: 5px; display: flex; }\n.ring-gap { width: 100%; min-width: 0; min-height: 0; border-radius: 50%; border: 7px solid #08120f; display: flex; }\n.disc { width: 100%; min-width: 0; min-height: 0; border-radius: 50%; border: 4px solid #9cbc94; background: #e5ebde; display: flex; align-items: center; justify-content: center; color: #081918; }\n.score { display: block; width: 100%; text-align: center; font-size: 154px; line-height: 1; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -.04em; padding-right: .04em; }\n.sets-track .halo { padding: 4px; }\n.sets-track .ring-gap { border-width: 5px; }\n.sets-track .disc { border-width: 3px; }\n.sets-track .score { font-size: 88px; }\n.set-footer { display: flex; justify-content: center; align-items: center; margin-top: 34px; gap: 24px; font-size: 44px; letter-spacing: .12em; }\n.set-value { display: block; width: 45px; text-align: center; font-variant-numeric: tabular-nums; letter-spacing: 0; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1050px) {\n  .board { --points-diameter: calc((100vw - 48px) * .28); --sets-diameter: calc((100vw - 48px) * .18); }\n  .name { font-size: clamp(24px, 10vw, 112px); }\n  .score { font-size: clamp(36px, 14vw, 145px); }\n  .sets-track .score { font-size: clamp(24px, 8vw, 84px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .board { --points-diameter: calc((100vw - 28px) * .29); --sets-diameter: calc((100vw - 28px) * .19); --label-space: 21px; }\n  .title { font-size: 26px; letter-spacing: .12em; margin-bottom: 30px; }\n  .team { gap: 13px; }\n  .teams { gap: 28px; }\n  .name { font-size: 36px; }\n  .score-track { gap: 8px; }\n  .label { font-size: 13px; letter-spacing: .08em; }\n  .halo { padding: 2px; }\n  .ring-gap { border-width: 3px; }\n  .disc { border-width: 2px; }\n  .score { font-size: 48px; }\n  .sets-track .halo { padding: 2px; }\n  .sets-track .ring-gap { border-width: 2px; }\n  .sets-track .disc { border-width: 2px; }\n  .sets-track .score { font-size: 28px; }\n  .set-footer { margin-top: 28px; font-size: 25px; gap: 10px; }\n  .set-value { width: 27px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n          <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"halo jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div></div>\n          <div class=\"score-track sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"halo\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div></div></div>\n        </div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n          <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n          <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"halo jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div>\n          <div class=\"score-track sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"halo\"><div class=\"ring-gap\"><div class=\"disc\"><span class=\"score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div></div>\n        </div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
