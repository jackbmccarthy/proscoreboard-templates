{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Plum Pearl Outboard — Soccer Wide</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.board{display:flex;flex-direction:column;width:min(80vw,1600px,calc((100vh - 24px)*4.3));max-width:100%;min-width:0;container-type:inline-size;overflow:hidden;border:1px solid #bdb5bd;border-radius:4px;background:#302b38;color:#faf8f7}.header{display:flex;align-items:center;justify-content:center;height:4cqw;min-height:32px;background:#ece7e9;color:#272331;border-bottom:1px solid #bdb5bd}.sport{font-size:3cqw;font-weight:700;line-height:1;white-space:nowrap}.competitors{display:flex;align-items:stretch;min-width:0;height:9.1cqw;min-height:76px}.side{display:flex;align-items:center;flex:1 1 0;min-width:0}.side-b{flex-direction:row}.score-track{display:flex;align-items:center;justify-content:center;align-self:stretch;flex:0 0 24%;min-width:0;background:#ece7e9}.side-a .score-track{border-right:1px solid #bdb5bd}.side-b .score-track{border-left:1px solid #bdb5bd}.score{display:block;width:100%;color:#272331;text-align:center;white-space:nowrap;font-weight:700;font-size:6.1cqw;line-height:1;font-variant-numeric:tabular-nums}.identity{display:block;flex:none;width:3%;align-self:stretch;background:#836a87}.jerseyColorB{background:#9c807f}.name{display:block;flex:1 1 0;min-width:0;padding:0 1.5cqw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#faf8f7;font-weight:700;font-size:4.5cqw;line-height:1.1;text-align:center}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.midrule{width:1px;flex:none;align-self:center;height:62%;background:#bdb5bd}.stats{display:flex;align-items:stretch;min-width:0;height:7cqw;min-height:49px;border-top:1px solid #bdb5bd}.stat{display:flex;align-items:center;justify-content:center;flex-direction:row;gap:2cqw;flex:1 1 0;min-width:0;white-space:nowrap}.stat+.stat{border-left:1px solid #bdb5bd}.stat-label{color:#cfc6d0;font-size:2cqw;font-weight:700;line-height:1}.stat-value{color:#faf8f7;font-size:3.3cqw;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}@media(max-width:600px){.board{width:100%}.header{height:39px}.sport{font-size:21px}.competitors{height:76px}.score-track{flex-basis:65px}.score{font-size:34px}.identity{width:5px}.name{font-size:20px;padding:0 4px}.stats{height:49px}.stat{gap:5px}.stat-label{font-size:9px}.stat-value{font-size:21px}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-component=\"text\">SOCCER</span></header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-track\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"midrule\" data-osb-component=\"layout\"></span><div class=\"side side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"score-track\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
