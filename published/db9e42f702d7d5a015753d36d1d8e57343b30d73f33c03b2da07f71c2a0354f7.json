{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Lower Third — Head to Head</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.stage{position:fixed;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:0 0 4.2vw;pointer-events:none}\n.board{font-size:calc(100vw / 80);font-family:var(--font);color:var(--ink);display:flex;flex-direction:column;align-items:center;-webkit-font-smoothing:antialiased}\n.top{display:flex;align-items:center;justify-content:center;height:1.9em;padding:0 1.4em;font-size:.95em;font-weight:700;letter-spacing:.1em;text-transform:uppercase;max-width:44em}\n.bar{display:flex;align-items:stretch;height:3.6em}\n.side{display:flex;align-items:center;gap:.6em;width:28em;min-width:0;padding:0 .7em 0 0}\n.side.sB{flex-direction:row-reverse;padding:0 0 0 .7em}\n.sB .who{text-align:right;align-items:flex-end}\n.chip{flex:0 0 .5em;align-self:stretch;background:var(--chip-default,#8a96a3)}\n.flag{flex:0 0 auto;width:2.2em;height:1.47em;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.who{display:flex;flex-direction:column;justify-content:center;flex:1 1 auto;min-width:0}\n.name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:1.35em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:break-word;text-wrap:balance}\n.team{display:flex;align-items:center;gap:.4em;min-width:0;font-size:.9em;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.85}\n.sB .team{flex-direction:row-reverse}\n.tlogo{width:1.3em;height:1.3em;object-fit:contain}\n.tname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.tscore{padding:0 .4em;border-radius:.2em;background:rgba(127,127,127,.25);font-variant-numeric:tabular-nums}\n.who:has(.name:empty) .team{font-size:1.2em;opacity:1}\n.who:has(.name:empty) .tname{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.05}\n.marks{display:flex;align-items:center;gap:.25em;flex:0 0 auto}\n.sB .marks{flex-direction:row-reverse}\n.to-slot{width:2.3em;height:1.35em}\n.to-on,.to-used{border-radius:.2em;font-size:.82em;font-weight:900}\n.to-on{background:#ffd23f;color:#111}\n.to-used{border:.12em solid currentColor;opacity:.75}\n.card-slot{width:.95em;height:1.35em}\n.card{border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.srv{flex:0 0 1.15em;display:flex;align-items:center;justify-content:center}\n.srv-ball{display:block;width:1.05em;height:1.05em;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 18%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .14em rgba(0,0,0,.25)}\n.gbox{flex:0 0 3em;align-self:stretch;display:flex;align-items:center;justify-content:center;font-weight:800;font-variant-numeric:tabular-nums}\n.gnum{font-size:1.8em}\n.mid{display:flex;align-items:stretch}\n.pts{display:flex;align-items:center;justify-content:center;width:3.4em;font-weight:900;font-variant-numeric:tabular-nums}\n.pts>*{font-size:2.5em;line-height:1}\n.foot{display:flex;align-items:center;justify-content:center;gap:.5em;height:2.1em;padding:0 .6em}\n.hist{display:flex;align-items:center;gap:.3em}\n.hchip{display:flex;align-items:center;gap:.15em;height:1.55em;padding:0 .55em;border-radius:.2em;font-weight:800;font-size:1em;font-variant-numeric:tabular-nums}\n.hchip i{font-style:normal;opacity:.6}\n.gtag{display:inline-flex;align-items:center;gap:.3em;height:1.55em;padding:0 .6em;border-radius:.2em;font-size:.9em;font-weight:800;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}\n.state{width:8.6em;height:1.55em}\n.st{border-radius:.2em;font-size:.9em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .5em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.head:not(:has(.meta>:not(.sep):not(:empty))),.band:not(:has(.meta>:not(.sep):not(:empty))),.top:not(:has(.meta>:not(.sep):not(:empty))){display:none}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.team:not(:has(.tname:not(:empty))){display:none}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])) .hchip:not([style*=\"display: none\"]):not([style*=\"display:none\"]):not(:has(~ .hchip:not([style*=\"display: none\"]):not([style*=\"display:none\"])))>*{opacity:.4}\n.t-h2h{--font:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;--ink:#f4f1ea}\n.t-h2h .top{background:#121418;color:#9fd8d6;border-radius:.3em .3em 0 0}\n.t-h2h .bar{background:#1b1f26;border-radius:.3em;box-shadow:0 .4em 1.4em rgba(0,0,0,.45);overflow:hidden}\n.t-h2h .gbox{background:#2a303a;color:#f4f1ea}\n.t-h2h .pts{background:#f4f1ea;color:#121418}\n.t-h2h .pts.pB{border-left:.16em solid #00a6a6}\n.t-h2h .foot{background:transparent}\n.t-h2h .hchip{background:#2a303a;color:#d9e2ea}\n.t-h2h .gtag{background:#00a6a6;color:#06201f}\n.t-h2h .st-warm,.t-h2h .st-break{color:#d9e2ea;box-shadow:inset 0 0 0 .12em #4a5462}\n.t-h2h .st-gp{background:#ff8a1c;color:#111}\n.t-h2h .st-mp{background:#e3262f;color:#fff}\n.t-h2h .st-final{background:#f4f1ea;color:#121418}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.eventName.ev,.sep.s1,.matchRound.rd,.sep.s2,.matchFormatLabel.bestOf.bo,.isATimeOutActive.to-on,.isBTimeOutActive.to-on,.isMatchStarted.gtag,.currentGame.cg,.isComplete.st.st-final,.isMatchPoint.st.st-mp,.isATimeOutUsed.to-used,.isBTimeOutUsed.to-used,.isGamePoint.st.st-gp,.isWarmUpStarted.st.st-warm,.isInBetweenGames.st.st-break{font-size:1.25vw!important}\n/* end stream-size floor */\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-h2h\" data-osb-component=\"layout\"><div class=\"top\" data-osb-component=\"layout\"><span class=\"meta\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep s1\">·</i><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep s2\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span></div><div class=\"bar\" data-osb-component=\"layout\"><div class=\"side sA\" data-osb-component=\"layout\"><span class=\"jerseyColorA chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"who\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></span><span class=\"srv\"><span class=\"isACurrentlyServing servingA srv-ball\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity:0\" isa=\"true\"></span></span><div class=\"gbox\" data-osb-component=\"layout\"><span class=\"currentAMatchScore AScore gnum\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div><div class=\"mid\" data-osb-component=\"layout\"><span class=\"pts pA\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"pts pB\"><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></div><div class=\"side sB\" data-osb-component=\"layout\"><span class=\"jerseyColorB chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"who\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"team\"><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isBTimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isBTimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T</span></span><span class=\"slot card-slot\"><span class=\"isBYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isBRedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></span><span class=\"srv\"><span class=\"isBCurrentlyServing servingB srv-ball\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"></span></span><div class=\"gbox\" data-osb-component=\"layout\"><span class=\"currentBMatchScore BScore gnum\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div><div class=\"foot\" data-osb-component=\"layout\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"hist\"><div class=\"hchip isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><i>-</i><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></div><div class=\"hchip isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><i>-</i><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></div><div class=\"hchip isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><i>-</i><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></div><div class=\"hchip isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><i>-</i><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></div><div class=\"hchip isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><i>-</i><span class=\"game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></div><div class=\"hchip isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span><i>-</i><span class=\"game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></div><div class=\"hchip isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span><i>-</i><span class=\"game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></div></span><span class=\"slot state\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isComplete st st-final\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></div></article></main>\n</body>\n</html>\n","css":""}
