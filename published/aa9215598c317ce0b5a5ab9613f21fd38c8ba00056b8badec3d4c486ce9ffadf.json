{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Ivory Cobalt Line Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #152842; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 380px; display: flex; flex-direction: column; overflow: hidden; border: 2px solid #1557b0; border-radius: 2px; background: #faf9f3; }\n.heading { display: flex; align-items: center; min-height: 29px; background: #fff; border-bottom: 1px solid #587089; font-size: 13px; font-weight: 700; line-height: 1; }\n.sport-title { display: block; flex: 1 1 0; padding: 6px 10px; font-size: 16px; }\n.sets-heading, .match-score { flex: 0 0 16.7%; }\n.points-heading, .primary-score { flex: 0 0 24.8%; }\n.sets-heading, .points-heading { display: flex; align-items: center; justify-content: center; align-self: stretch; text-align: center; border-left: 1px solid #587089; }\n.team { display: flex; align-items: stretch; min-height: 48px; }\n.team + .team { border-top: 1px solid #587089; }\n.identity { display: flex; align-items: center; gap: 10px; flex: 1 1 0; padding: 7px 8px; }\n.tick { display: block; width: 3px; flex: 0 0 3px; height: 34px; background: #1557b0; }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26px; font-weight: 700; line-height: 1; color: #152842; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.match-score { display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; line-height: 1; border-left: 1px solid #587089; background: #e4ecf8; font-variant-numeric: tabular-nums; }\n.primary-score { display: flex; align-items: center; justify-content: center; font-size: 34px; font-weight: 700; line-height: 1; border-left: 1px solid #587089; background: #1557b0; color: #fff; font-variant-numeric: tabular-nums; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 32px; border-top: 1px solid #587089; gap: 7px; background: #152842; color: #fff; font-size: 16px; font-weight: 700; line-height: 1; }\n.set-value { display: block; width: 20px; text-align: center; font-size: 18px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) { .stage { padding: 14px; } }\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"heading rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-title\">VOLLEYBALL</span><span class=\"sets-heading\">SETS</span><span class=\"points-heading\">POINTS</span></header>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
