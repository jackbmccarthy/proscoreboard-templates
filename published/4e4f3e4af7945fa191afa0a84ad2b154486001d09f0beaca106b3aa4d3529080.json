{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Open Corner Grid TABLE TENNIS 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{color:#f6f6f6;font-family:Arial,Helvetica,sans-serif;font-weight:700}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--width),1400px);position:relative;container-type:inline-size;background:transparent;display:flex;flex-direction:column;padding-bottom:3cqw}.header{font-size:var(--header-size);line-height:1;white-space:nowrap;font-weight:700;margin:0;flex-shrink:0}.name-wrap{display:flex;align-items:center;min-width:0;position:relative}.name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--name-size);line-height:1.1}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{width:0;height:0;flex:0 0 0}.serve{position:absolute;right:.3cqw;top:-1cqw;font-size:1.5cqw;width:1.5cqw;height:1.5cqw}.label{text-align:center;font-size:var(--label-size);line-height:1;white-space:nowrap}.track{position:relative;display:flex;align-items:center;justify-content:center;min-width:0;height:var(--track-height);flex:0 0 var(--track-width)}.score{display:block;width:100%;min-width:0;text-align:center;font-size:var(--score-size);line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}.corner{position:absolute;width:var(--corner-size);height:var(--corner-size);border-style:solid;border-color:currentColor;border-width:0;pointer-events:none}.tl{top:0;left:0;border-top-width:var(--stroke);border-left-width:var(--stroke)}.tr{top:0;right:0;border-top-width:var(--stroke);border-right-width:var(--stroke)}.bl{bottom:0;left:0;border-bottom-width:var(--stroke);border-left-width:var(--stroke)}.br{bottom:0;right:0;border-bottom-width:var(--stroke);border-right-width:var(--stroke)}.point-slot{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:30cqw;height:2cqw;text-align:center;font-size:1.7cqw}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw}.label{font-size:2.6cqw}.point-slot{font-size:2.2cqw;height:2.6cqw}.corner{--stroke:1.2px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--width:69vw;--header-size:6.4cqw;--name-size:5.6cqw;--label-size:2.5cqw;--track-height:15.4cqw;--track-width:38%;--score-size:13cqw;--corner-size:3cqw;--stroke:.45cqw}.header{text-align:center;margin-bottom:5.4cqw}.match{display:flex;position:relative;gap:15%;align-items:stretch}.match:after{content:\"\";position:absolute;left:50%;top:0;bottom:0;transform:translateX(-50%);width:.4cqw;background:#ff4933}.side{flex:1;min-width:0;display:flex;flex-direction:column}.name-wrap{text-align:center;margin-bottom:3.4cqw}.scores{display:flex;justify-content:space-between;gap:10%;}.cell{flex:0 0 38%;min-width:0;display:flex;flex-direction:column}.label{margin-bottom:1.55cqw}.cell .track{width:100%;flex:none}@media(max-width:600px){.match:after{width:1.5px}}\n.score{font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;letter-spacing:-.06em}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">TABLE TENNIS</h1><div class=\"match rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"name-wrap\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"scores rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"cell\"><div class=\"label\">GAMES</div><div class=\"track\"><span class=\"score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><i class=\"corner tl\" aria-hidden=\"true\"></i><i class=\"corner tr\" aria-hidden=\"true\"></i><i class=\"corner bl\" aria-hidden=\"true\"></i><i class=\"corner br\" aria-hidden=\"true\"></i></div></div><div class=\"cell\"><div class=\"label\">POINTS</div><div class=\"track\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"corner tl\" aria-hidden=\"true\"></i><i class=\"corner tr\" aria-hidden=\"true\"></i><i class=\"corner bl\" aria-hidden=\"true\"></i><i class=\"corner br\" aria-hidden=\"true\"></i></div></div></div></div><div class=\"side columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"name-wrap\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"scores rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"cell\"><div class=\"label\">GAMES</div><div class=\"track\"><span class=\"score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><i class=\"corner tl\" aria-hidden=\"true\"></i><i class=\"corner tr\" aria-hidden=\"true\"></i><i class=\"corner bl\" aria-hidden=\"true\"></i><i class=\"corner br\" aria-hidden=\"true\"></i></div></div><div class=\"cell\"><div class=\"label\">POINTS</div><div class=\"track\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><i class=\"corner tl\" aria-hidden=\"true\"></i><i class=\"corner tr\" aria-hidden=\"true\"></i><i class=\"corner bl\" aria-hidden=\"true\"></i><i class=\"corner br\" aria-hidden=\"true\"></i></div></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
