{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Champagne Graphite Columnrail 1</title><style>*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.board{background:#2b3036;color:#f7f5f0;container-type:inline-size;overflow:hidden}.board.compact{width:min(80vw,1330px)}.board.horizontal{width:min(91vw,1850px)}.header{display:flex;align-items:center;justify-content:space-between;gap:2cqw;min-height:6.2cqw;padding:0 2.5cqw;background:#d8c9ae;color:#2b3036}.horizontal .header{min-height:3.5cqw;padding:0 1.8cqw}.sport{font-size:4cqw;font-weight:800;line-height:1;white-space:nowrap}.horizontal .sport{font-size:2.4cqw}.status{display:flex;align-items:center;min-width:0}.stat{display:flex;align-items:baseline;gap:.7cqw;padding:0 2cqw;border-left:1px solid #67737b;white-space:nowrap;font-size:1.9cqw;font-weight:800}.stat:first-child{border-left:0}.stat:last-child{padding-right:0}.stat strong{font-size:2.45cqw;font-variant-numeric:tabular-nums}.horizontal .stat{font-size:1.4cqw;padding:0 1.55cqw}.horizontal .stat strong{font-size:1.6cqw}.lanes{display:flex;flex-direction:column}.horizontal .lanes{flex-direction:row}.lane{display:flex;align-items:stretch;min-width:0;height:12.6cqw;background:#2b3036}.lane+.lane{border-top:1px solid #67737b}.horizontal .lane{height:7.9cqw;flex:1 1 50%;width:50%}.horizontal .lane+.lane{border-top:0;border-left:1px solid #67737b}.tick{flex:0 0 2.2%;background:#2b8aa8}.tick.jerseyColorB{background:#d06461}.horizontal .tick{flex-basis:3.5%}.name{min-width:0;flex:1 1 0;display:flex;align-items:center;padding:0 3.6cqw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.3cqw;font-weight:700;line-height:1}.horizontal .name{padding:0 1.8cqw;font-size:3.3cqw}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.track{flex:0 0 15.5%;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;border-left:1px solid #67737b;text-align:center}.track.runs{flex-basis:24%}.horizontal .track{flex-basis:18%}.horizontal .track.runs{flex-basis:22%}.number{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:4.7cqw;font-weight:800;line-height:.94;font-variant-numeric:tabular-nums}.runs .number{font-size:7.2cqw}.horizontal .number{font-size:3.2cqw}.horizontal .runs .number{font-size:5.1cqw}.caption{margin-top:.5cqw;color:#c9c0b0;font-size:1.75cqw;font-weight:700;letter-spacing:.025em;line-height:1}.horizontal .caption{font-size:1.2cqw}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.stage{padding:8px}.board.compact,.board.horizontal{width:100%}.header,.horizontal .header{min-height:54px;padding:7px 12px;align-items:flex-start;flex-direction:column;justify-content:center;gap:5px}.sport,.horizontal .sport{font-size:18px}.status{width:100%;justify-content:space-between}.stat,.horizontal .stat{font-size:9px;gap:3px;padding:0 6px}.stat:first-child{padding-left:0}.stat strong,.horizontal .stat strong{font-size:12px}.horizontal .lanes{flex-direction:column}.lane,.horizontal .lane{height:83px;width:100%}.horizontal .lane+.lane{border-top:1px solid #67737b;border-left:0}.tick,.horizontal .tick{flex-basis:3%}.name,.horizontal .name{font-size:clamp(16px,5vw,24px);padding:0 10px}.track,.horizontal .track{flex-basis:16%}.track.runs,.horizontal .track.runs{flex-basis:21%}.number,.horizontal .number{font-size:23px}.runs .number,.horizontal .runs .number{font-size:35px}.caption,.horizontal .caption{font-size:9px;margin-top:5px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><main class=\"stage columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><article class=\"board compact columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Softball scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport sport-tag\" data-osb-static=\"true\">SOFTBALL</span><div class=\"status rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static softball counters\"><span class=\"stat\"><span data-osb-static=\"true\">INNING</span><strong data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\"><span data-osb-static=\"true\">BALLS</span><strong data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\"><span data-osb-static=\"true\">STRIKES</span><strong data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\"><span data-osb-static=\"true\">OUTS</span><strong data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></header><div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"track hits support columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"number\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong><span class=\"caption\" data-osb-static=\"true\">HITS</span></div><div class=\"track runs primary columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong><span class=\"caption\" data-osb-static=\"true\">RUNS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"track hits support columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"number\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong><span class=\"caption\" data-osb-static=\"true\">HITS</span></div><div class=\"track runs primary columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong><span class=\"caption\" data-osb-static=\"true\">RUNS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
