{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Editorial Quotient Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #231b17; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { display: flex; flex-direction: column; width: 100%; max-width: 1304px; padding: 18px 30px 27px; background: #fbf5ed; }\n.title { font-size: 46px; font-weight: 500; letter-spacing: .13em; text-align: center; line-height: 1.3; padding-bottom: 13px; border-bottom: 2px solid #231b17; }\n.team { display: flex; align-items: center; gap: 40px; height: 284px; padding: 18px 68px 20px 44px; }\n.team + .team { border-top: 2px solid #231b17; }\n.name { flex: 1 1 0; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-family: \"Times New Roman\", Times, serif; font-size: 140px; font-weight: 700; font-style: italic; line-height: 1.1; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-track { flex: 0 0 276px; min-width: 0; display: flex; flex-direction: column; align-items: stretch; }\n.sets-band { display: flex; align-items: center; justify-content: space-around; min-height: 53px; padding-bottom: 8px; }\n.label { font-size: 28px; line-height: 1; font-weight: 600; letter-spacing: .11em; }\n.match-score { width: 70px; flex: 0 0 70px; text-align: center; font-size: 44px; line-height: 1; font-variant-numeric: tabular-nums; }\n.rule { display: block; width: 100%; height: 2px; flex: 0 0 2px; background: #231b17; }\n.score { width: 100%; display: block; height: 143px; line-height: .9; text-align: center; font-family: \"Times New Roman\", Times, serif; font-size: 170px; font-weight: 700; font-variant-numeric: tabular-nums; color: #a74620; margin-top: 8px; }\n.points-label { display: block; text-align: center; margin-top: 8px; }\n.set-footer { display: flex; align-items: center; justify-content: center; gap: 20px; font-size: 36px; line-height: 1; letter-spacing: .08em; font-weight: 600; padding-top: 17px; }\n.set-value { display: block; width: 37px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1100px) {\n  .name { font-size: clamp(40px, 10.5vw, 140px); }\n  .team { padding-left: 24px; padding-right: 32px; }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .board { padding: 16px; }\n  .title { font-size: 23px; letter-spacing: .09em; padding-bottom: 12px; }\n  .team { height: 180px; gap: 12px; padding: 12px 0; }\n  .name { font-size: 38px; }\n  .score-track { flex-basis: 110px; }\n  .sets-band { min-height: 32px; padding-bottom: 7px; }\n  .label { font-size: 13px; letter-spacing: .06em; }\n  .match-score { width: 38px; flex-basis: 38px; font-size: 24px; }\n  .score { height: 77px; font-size: 82px; margin-top: 8px; }\n  .points-label { margin-top: 6px; }\n  .set-footer { font-size: 22px; gap: 9px; padding-top: 10px; }\n  .set-value { width: 24px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n        <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <div class=\"sets-band rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n          <span class=\"rule jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n          <span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label points-label\">POINTS</span>\n        </div>\n      </div>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n        <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n          <div class=\"sets-band rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n          <span class=\"rule jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n          <span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label points-label\">POINTS</span>\n        </div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
