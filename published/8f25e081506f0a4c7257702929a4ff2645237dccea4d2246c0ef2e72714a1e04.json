{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Table Green</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%;background:#000;overflow:hidden}\n.stage{position:fixed;inset:0;container-type:size;display:grid;place-items:center}\n.board{--u:calc(min(100cqw,177.7778cqh)/1920);position:relative;overflow:hidden;width:min(100cqw,177.7778cqh);height:min(56.25cqw,100cqh);font-family:\"Helvetica Neue\",Arial,sans-serif;font-variant-numeric:lining-nums tabular-nums}\n.name,.team{display:flex;align-items:safe center;justify-content:center;text-align:center;overflow:hidden;overflow-wrap:anywhere;line-height:1.05}\n.game,.games,.teamScore{white-space:nowrap;line-height:1;text-align:center}\nimg:not([src]),img[src=\"\"]{display:none}\n.isGamePoint,.isMatchPoint,.isInBetweenGames,.isSwitched,.isCourtSideScoreboardFlipped,.courtSideIsACurrentlyServing,.courtSideIsBCurrentlyServing,.isAYellowCarded,.isBYellowCarded,.isARedCarded,.isBRedCarded,.isATimeOutActive,.isBTimeOutActive{opacity:0}\n.pointSlot{position:absolute}\n.ban{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap;font-weight:900}\n.pointSlot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint,.pointSlot:has(.isInBetweenGames[style*=\"opacity: 1\"]) :is(.isGamePoint,.isMatchPoint){opacity:0!important}\n.chip{position:absolute;display:flex;align-items:center;justify-content:center;white-space:nowrap;font-weight:800}\n.serve{position:absolute}\n\n.board{background:#0f5a43;color:#fff}\n.board::before{content:\"\";position:absolute;inset:calc(36*var(--u));border:calc(10*var(--u)) solid rgba(255,255,255,.9);pointer-events:none}\n.net{position:absolute;left:calc(944*var(--u));width:calc(32*var(--u));top:calc(36*var(--u));bottom:calc(36*var(--u));background:repeating-linear-gradient(0deg,rgba(255,255,255,.35) 0 calc(6*var(--u)),rgba(255,255,255,.1) calc(6*var(--u)) calc(12*var(--u)));border-left:calc(4*var(--u)) solid #fff;border-right:calc(4*var(--u)) solid #fff}\n.hdr{position:absolute;left:calc(660*var(--u));width:calc(600*var(--u));top:calc(36*var(--u));height:calc(100*var(--u));background:#083024;border:calc(4*var(--u)) solid #fff;display:flex;align-items:center;justify-content:center;gap:calc(28*var(--u));font-size:calc(40*var(--u));font-weight:700;color:#cfe9df;z-index:2}\n.hdr .matchRound{color:#ffb15e;font-weight:800}\n.panel{position:absolute;top:0;bottom:0;width:calc(960*var(--u))}.pA{left:0}.pB{left:calc(960*var(--u))}\n.name{position:absolute;left:calc(180*var(--u));right:calc(180*var(--u));top:calc(130*var(--u));height:calc(160*var(--u));font-size:calc(76*var(--u));font-weight:800}\n.serve{top:calc(160*var(--u));width:calc(76*var(--u));height:calc(76*var(--u));border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffd9a8,#ff8a1f 55%,#c85d00);box-shadow:0 calc(6*var(--u)) 0 rgba(0,0,0,.35)}\n.pA .serve{left:calc(80*var(--u))}.pB .serve{right:calc(80*var(--u))}\n.card{position:absolute;width:calc(40*var(--u));height:calc(58*var(--u));border-radius:calc(5*var(--u))}.yc{background:#e5c94e}.rc{background:#c94747}\n.card{top:calc(158*var(--u));border:calc(3*var(--u)) solid #fff}.pA .yc{right:calc(126*var(--u))}.pA .rc{right:calc(70*var(--u))}.pB .yc{left:calc(126*var(--u))}.pB .rc{left:calc(70*var(--u))}\n.game{position:absolute;left:0;right:0;top:calc(290*var(--u));height:calc(600*var(--u));font-size:calc(600*var(--u));line-height:calc(600*var(--u));font-weight:900;text-shadow:0 calc(8*var(--u)) 0 rgba(0,0,0,.28)}\n.lbl{position:absolute;bottom:calc(92*var(--u));font-size:calc(42*var(--u));font-weight:800;letter-spacing:.1em;color:#bfe3d4}\n.pA .lbl{left:calc(90*var(--u))}.pB .lbl{right:calc(90*var(--u))}\n.games{position:absolute;bottom:calc(64*var(--u));width:calc(150*var(--u));height:calc(130*var(--u));font-size:calc(124*var(--u));line-height:calc(130*var(--u));font-weight:900;color:#ffb15e}\n.pA .games{left:calc(270*var(--u))}.pB .games{right:calc(270*var(--u))}\n.to{position:absolute;left:calc(280*var(--u));width:calc(400*var(--u));top:calc(310*var(--u));height:calc(64*var(--u));display:flex;align-items:center;justify-content:center;background:#083024;border:calc(4*var(--u)) solid #fff;border-radius:calc(32*var(--u));color:#fff;font-size:calc(36*var(--u));font-weight:800;letter-spacing:.08em}\n.pointSlot{left:calc(600*var(--u));width:calc(720*var(--u));top:calc(900*var(--u));height:calc(110*var(--u));z-index:3}\n.ban{font-size:calc(68*var(--u));border-radius:calc(12*var(--u));border:calc(4*var(--u)) solid #fff;letter-spacing:.04em}\n.gp{background:#ff8a1f;color:#fff}.mp{background:#c94747;color:#fff}.bt{background:#083024;color:#fff;font-size:calc(56*var(--u))}\n.chip{top:calc(60*var(--u));height:calc(42*var(--u));padding:0 calc(20*var(--u));border-radius:calc(21*var(--u));background:#083024;color:#cfe9df;font-size:calc(24*var(--u));letter-spacing:.08em;z-index:2}\n.chipS{left:calc(70*var(--u))}.chipF{right:calc(70*var(--u))}\n\n.osb-core-fields{display:none!important}\n</style>\n</head>\n<body>\n<div class=\"stage\"><div class=\"board\">\n  <div class=\"net\"></div>\n  <section class=\"courtSideAView panel pA \">\n    <div class=\"courtSideIsACurrentlyServing serve\"></div>\n    <div class=\"courtSideCombinedAName name\"></div>\n    <div class=\"isAYellowCarded card yc\"></div>\n    <div class=\"isARedCarded card rc\"></div>\n    <div class=\"isATimeOutActive to\">TIME-OUT</div>\n    <div class=\"courtSideAGameScore game\">0</div>\n    <div class=\"lbl\">GAMES</div>\n    <div class=\"courtSideAMatchScore games\">0</div>\n  </section>\n  <section class=\"courtSideBView panel pB \">\n    <div class=\"courtSideIsBCurrentlyServing serve\"></div>\n    <div class=\"courtSideCombinedBName name\"></div>\n    <div class=\"isBYellowCarded card yc\"></div>\n    <div class=\"isBRedCarded card rc\"></div>\n    <div class=\"isBTimeOutActive to\">TIME-OUT</div>\n    <div class=\"courtSideBGameScore game\">0</div>\n    <div class=\"lbl\">GAMES</div>\n    <div class=\"courtSideBMatchScore games\">0</div>\n  </section>\n  <div class=\"hdr\"><span class=\"eventName\"></span><span class=\"matchRound\"></span></div>\n  <div class=\"pointSlot \">\n    <div class=\"isInBetweenGames ban bt\">BETWEEN GAMES</div>\n    <div class=\"isMatchPoint ban mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</div>\n    <div class=\"isGamePoint ban gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</div>\n  </div>\n  <div class=\"isSwitched chip chipS\">ENDS SWITCHED</div>\n  <div class=\"isCourtSideScoreboardFlipped chip chipF\">BOARD FLIPPED</div>\n</div></div>\n<div class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n</body>\n</html>\n","css":""}
