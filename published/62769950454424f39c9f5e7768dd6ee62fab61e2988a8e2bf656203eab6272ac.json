{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pickleball — Pearl Slate Stat Lead Scorebug</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--pearl:#e8edea;--slate:#243b49;--glass:#bfd1ce;--ink:#1f3440;--white:#f6f8f5;--rule:#adbdbe;display:flex;flex-direction:column;width:min(67vw,1300px);min-width:0;overflow:hidden;border:1px solid var(--rule);border-radius:3px;background:var(--pearl);color:var(--ink);container-type:inline-size}\n.topline{position:relative;display:flex;flex:0 0 auto;height:6.4cqw;align-items:center;padding:0 2.6cqw;background:var(--slate);color:var(--white);font-size:3.4cqw;line-height:1;font-weight:700;white-space:nowrap}\n.rows{display:flex;flex:1 1 auto;min-width:0;flex-direction:column}\n.row{display:flex;flex:1 1 50%;min-width:0;min-height:12.6cqw;align-items:stretch}\n.row+.row{border-top:1px solid var(--rule)}\n.identity{display:block;flex:0 0 2.7%;width:2.7%;background:#2682a7}\n.jerseyColorB{background:#c66366}\n.support-cell{display:flex;flex:0 0 14%;width:14%;min-width:0;flex-direction:column;align-items:center;justify-content:center;background:var(--glass)}\n.support-score,.primary-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.support-score{font-size:5.7cqw}.primary-score{font-size:7.7cqw}\n.support-label,.primary-label{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:2cqw;line-height:1;font-weight:700}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:.7cqw;padding:0 4cqw}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.9cqw;line-height:1.04;font-weight:700}\n.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 .55cqw;width:.55cqw;height:.55cqw;min-width:6px;min-height:6px;border-radius:50%;background:var(--ink)}\n.primary-track{display:flex;flex:0 0 15%;width:15%;min-width:0;flex-direction:column;align-items:center;justify-content:center;background:var(--pearl)}\n.point-slot{position:absolute;right:1%;top:0;width:20%;height:100%;font-size:1.05cqw;font-weight:700;text-align:center}\n.point-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--slate)}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:94vw}.topline{height:32px;padding:0 8px;font-size:14px}.row{min-height:82px}.identity{flex-basis:5px;width:5px}.support-cell{flex-basis:21%;width:21%}.primary-track{flex-basis:22%;width:22%}.support-score{font-size:29px}.primary-score{font-size:37px}.support-label,.primary-label{font-size:8px}.name-lane{gap:2px;padding:0 7px}.name{font-size:17px}.serve{flex-basis:5px;width:5px;height:5px}.point-slot{font-size:7px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"topline\"><span>PICKLEBALL</span><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div><div class=\"rows columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"support-cell\"><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-label\">GAMES</span></div><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"primary-track\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\">POINTS</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"support-cell\"><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-label\">GAMES</span></div><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"primary-track\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\">POINTS</span></div></div></div></article></main></body></html>\n","css":""}
