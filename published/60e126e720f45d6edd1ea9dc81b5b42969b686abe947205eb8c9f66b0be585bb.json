{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Cloud Graphite Combined Bay 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(92vw,950px);max-width:100%;height:406px;overflow:hidden;border:2px solid #aebbb8;border-radius:10px;background:#e8edeb;color:#293b44;container-type:inline-size}\n.head{display:flex;align-items:center;justify-content:space-between;flex:0 0 15.5%;min-width:0;padding:0 25px;border-bottom:2px solid #aebbb8}\n.sport-tag,.set-status{display:block;overflow:hidden;font-size:clamp(17px,3cqw,34px);font-weight:800;line-height:1;text-overflow:ellipsis;white-space:nowrap}\n.set-status{display:flex;align-items:center;gap:.35em}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.teams{display:flex;flex:1 1 0;min-height:0;flex-direction:column}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-width:0;min-height:0}\n.team+.team{border-top:2px solid #aebbb8}\n.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0}\n.identity{display:block;align-self:stretch;flex:0 0 23px;background:#368ff0}\n.jerseyColorB{background:#f16661}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;padding:0 38px;color:#1b2e3a;font-size:clamp(30px,7.3cqw,74px);font-weight:750;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.bay{display:flex;align-items:stretch;flex:0 0 22%;min-width:0;flex-direction:column;padding:14px 30px 8px;background:#293b44;color:#fff;font-variant-numeric:tabular-nums}\n.sets{display:flex;align-items:center;justify-content:space-between;flex:0 0 28%;min-width:0;border-bottom:2px solid #8ca3a7;font-size:clamp(14px,2.3cqw,24px);font-weight:700;white-space:nowrap}\n.set-score{display:block;max-width:40%;overflow:hidden;font-size:1.3em;line-height:1;text-align:right}\n.points{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-height:0;flex-direction:column;gap:2px}\n.points-label{display:block;max-width:100%;overflow:hidden;font-size:clamp(15px,2.3cqw,25px);font-weight:700;line-height:1}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(47px,7.9cqw,81px);font-weight:800;line-height:1;text-align:center;white-space:nowrap}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:8px}\n .board{width:100%;height:175px;border-width:1px;border-radius:4px}\n .head{flex-basis:18%;padding:0 8px;border-width:1px}\n .sport-tag,.set-status{font-size:12px}\n .team+.team{border-width:1px}\n .identity{flex-basis:6px}\n .name{padding:0 8px;font-size:clamp(17px,5.4cqw,24px)}\n .bay{flex-basis:23%;padding:4px 6px 3px}\n .sets{font-size:clamp(8px,2.5cqw,12px);border-width:1px}\n .points-label{font-size:clamp(8px,2.5cqw,12px)}\n .score{font-size:clamp(24px,8cqw,36px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n  <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sets\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"points-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sets\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"points-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div>\n  </div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
