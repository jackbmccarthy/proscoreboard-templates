{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Charcoal Outline Sidecar 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.shell{position:relative;width:min(86vw,1080px);max-width:100%;padding-top:40px;container-type:inline-size}\n.sport-tag{position:absolute;top:0;left:0;display:flex;align-items:center;justify-content:center;width:230px;max-width:58%;height:40px;background:#dce3e2;color:#20272c;font-size:29px;font-weight:800;line-height:1;white-space:nowrap}\n.board{display:flex;width:100%;height:max(150px,25.9cqw);overflow:hidden;background:#20272c;color:#f2f3ee;border-radius:2px}\n.teams{display:flex;flex:1 1 0;flex-direction:column;min-width:0}\n.team{display:flex;align-items:center;flex:1 1 0;min-height:0;min-width:0}\n.team+.team{border-top:1px solid #a8b8bc}\n.identity{display:block;flex:0 0 2%;height:88%;margin-left:0;background:#0e87eb}\n.jerseyColorB{background:#f22e39}\n.name{display:block;align-content:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 4%;font-size:5.9cqw;font-weight:700;line-height:1.05;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.score-track{display:flex;align-items:center;justify-content:center;flex:0 0 22%;height:84%;margin-right:2%;min-width:0;border:1px solid #a8b8bc;background:#20272c}\n.score{display:block;min-width:0;color:#fff;font-size:7.8cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.dock{display:flex;align-items:center;flex:0 0 15.5%;flex-direction:column;min-width:0;padding:1% 2.1%;background:#dce3e2;color:#20272c}\n.dock-heading{display:flex;align-items:center;justify-content:center;flex:0 0 17%;font-size:2.7cqw;font-weight:800;line-height:1;white-space:nowrap}\n.sets-list{display:flex;align-items:center;justify-content:space-around;flex:1 1 0;flex-direction:column;min-height:0;width:100%}\n.set-score{display:block;font-size:4.8cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.set-current{display:flex;align-items:center;justify-content:center;flex:0 0 27%;gap:.6cqw;width:100%;border-top:1px solid #7e958f;font-size:2.5cqw;font-weight:800;line-height:1;white-space:nowrap}\n.set-current-value{font-variant-numeric:tabular-nums}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){\n .stage{padding:10px}\n .shell{width:100%;padding-top:25px}\n .sport-tag{width:132px;height:25px;font-size:16px}\n .board{height:150px}\n .dock{flex-basis:23%;padding:2px 4px}\n .identity{flex-basis:5px}\n .name{padding:0 8px;font-size:clamp(14px,5.2cqw,21px)}\n .score-track{flex-basis:27%;height:75%;margin-right:5px}\n .score{font-size:clamp(30px,9cqw,38px)}\n .dock-heading{font-size:12px}\n .set-score{font-size:26px}\n .set-current{gap:3px;font-size:12px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <div class=\"shell\">\n  <span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span>\n  <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Volleyball scoreboard\">\n   <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n     <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n     <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n     <div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n    </div>\n    <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n     <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n     <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n     <div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n    </div>\n   </div>\n   <aside class=\"dock columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Sets won and editable current set\">\n    <span class=\"dock-heading\" data-osb-component=\"text\">SETS</span>\n    <div class=\"sets-list columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n     <span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n     <span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n    </div>\n    <div class=\"set-current rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span data-osb-component=\"text\">SET</span><span class=\"set-current-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></div>\n   </aside>\n   <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n  </article>\n </div>\n</main>\n</body>\n</html>\n","css":""}
