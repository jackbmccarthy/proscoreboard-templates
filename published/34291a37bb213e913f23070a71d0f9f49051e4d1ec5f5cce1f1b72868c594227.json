{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Coral Slate Header Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f4f5f3; }\n.stage { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }\n.board { width: 100%; max-width: 480px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #59656a; border-radius: 6px; background: #1d2226; }\n.heading { display: flex; align-items: stretch; min-height: 33px; background: #e68a72; color: #1d2226; font-size: 12px; font-weight: 700; line-height: 1; }\n.sport-title { display: flex; align-items: center; flex: 1 1 0; padding: 4px 11px; font-size: 20px; white-space: nowrap; }\n.sets-heading, .points-heading { display: flex; align-items: center; justify-content: center; text-align: center; }\n.sets-heading, .match-score { flex: 0 0 16%; }\n.points-heading, .primary-score { flex: 0 0 19%; }\n.team { display: flex; align-items: stretch; min-height: 52px; }\n.team + .team { border-top: 1px solid #59656a; }\n.identity { display: flex; align-items: center; flex: 1 1 0; gap: 10px; padding: 8px 10px; }\n.tick { display: block; width: 24px; flex: 0 0 24px; height: 32px; background: #e68a72; clip-path: path(\"M0 0H4V32H0Z M10 0H14V32H10Z M20 0H24V32H20Z\"); }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23px; font-weight: 700; line-height: 1; color: #f4f5f3; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.match-score { display: flex; align-items: center; justify-content: center; font-size: 21px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { display: flex; align-items: center; justify-content: center; border-left: 1px solid #59656a; background: #30383d; color: #fff; font-size: 32px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 26px; gap: 14px; border-top: 1px solid #59656a; font-size: 14px; line-height: 1; font-weight: 700; }\n.footer-label { color: #e68a72; }\n.footer-separator { display: block; width: 1px; height: 17px; background: #59656a; }\n.set-value { display: block; width: 22px; text-align: center; font-size: 18px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) { .stage { padding: 14px; } .sport-title { font-size: 17px; } }\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"heading rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-title\">VOLLEYBALL</span><span class=\"sets-heading\">SETS</span><span class=\"points-heading\">POINTS</span></header>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n      <footer class=\"set-footer\"><span class=\"footer-label\">SET</span><span class=\"footer-separator\" aria-hidden=\"true\"></span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
