{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>softball editorial quotient 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#1d160f}body{font-family:Arial,sans-serif}.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}.board{container-type:inline-size;width:min(81vw,1550px);background:#f8f3ec;display:flex;flex-direction:column;padding:1.5% 2.1%;position:relative}.sport{margin:0;font-size:2.8cqw;font-weight:700;line-height:1;letter-spacing:.65cqw;text-align:center;padding-bottom:1.3cqw;border-bottom:.2cqw solid #1d160f;}.competitors{display:flex;flex-direction:column;}.competitor{display:flex;min-width:0;align-items:center;gap:3cqw;min-height:20.4cqw;padding:2.3cqw 4cqw;}.competitor+.competitor{border-top:.2cqw solid #1d160f}.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:\"Times New Roman\",Times,serif;font-style:italic;font-weight:700;font-size:12.5cqw;line-height:1.04;flex:1 1 0;}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.runs{display:flex;flex-direction:column;align-items:center;flex:0 0 18.5cqw;}.rule{display:block;width:100%;height:.2cqw;flex:none;background:#1d160f;margin-bottom:.7cqw}.score-track{width:100%;display:flex;align-items:center;justify-content:center;height:12.4cqw;flex:none}.score{display:block;width:100%;text-align:center;font-family:\"Times New Roman\",Times,serif;font-size:15.4cqw;font-weight:700;color:#b54718;line-height:.9;font-variant-numeric:tabular-nums}.run-label{font-size:2.7cqw;font-weight:700;line-height:1;letter-spacing:.25cqw;margin-top:.75cqw}.stats{display:flex;align-items:center;justify-content:center;margin-top:1cqw;padding:1.1cqw 8cqw 0;border-top:.2cqw solid #1d160f;}.stat{display:flex;align-items:center;justify-content:center;gap:1.65cqw;flex:1 1 0;min-width:0}.stat-label{font-size:2.55cqw;line-height:1;font-weight:700;letter-spacing:.14cqw;white-space:nowrap}.stat-number{font-family:Arial,sans-serif;font-size:2.7cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:100%;padding:3% 2.5%}.stat-label{letter-spacing:.05cqw}.stats{padding-left:3cqw;padding-right:3cqw}.stat{gap:1.2cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scoreboard\"><header class=\"sport\" data-osb-static=\"true\">SOFTBALL</header><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"rule jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"run-label\" data-osb-static=\"true\">RUNS</span></div></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"rule jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"run-label\" data-osb-static=\"true\">RUNS</span></div></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
