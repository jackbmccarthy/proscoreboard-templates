{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>PICKLEBALL · Basalt Bone Scorefoot</title>\n<style>\n:root{color-scheme:light}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f9faf8}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;background:transparent}\n.board{width:58vw;max-width:1160px;min-width:0;overflow:hidden;border:1px solid #5a727c;border-radius:4px;background:#253747;container-type:inline-size}\n.board.horizontal{width:86vw;max-width:1720px}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{height:18cqw;min-height:108px;flex:0 0 auto;display:flex;align-items:stretch;min-width:0;background:#253747}\n.lane+.lane{border-top:1px solid #5a727c}\n.identity{display:block;flex:0 0 2.2cqw;min-width:6px;background:#3186a8}\n.jerseyColorB{background:#c86d70}\n.name-lane{flex:1 1 0;min-width:0;display:flex;align-items:center;gap:1cqw;padding:0 3.6cqw;overflow:hidden}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:7.2cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 1.7cqw;width:1.7cqw;text-align:center;color:#f9faf8;font-size:1.5cqw;line-height:1}\n.score-terminal{flex:0 0 23%;width:23%;min-width:0;display:flex;flex-direction:column;align-items:stretch;overflow:hidden;background:#e8e1d4;color:#253747}\n.primary-track{flex:1 1 0;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}\n.primary-number{display:block;max-width:100%;font-size:9cqw;font-weight:700;line-height:.92;white-space:nowrap;font-variant-numeric:tabular-nums}\n.primary-caption{display:block;margin-top:.2cqw;font-size:2.1cqw;font-weight:700;line-height:1;white-space:nowrap}\n.support-foot{flex:0 0 34%;min-height:0;margin:0 1.8cqw;border-top:1px solid #5a727c;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}\n.support-number{display:block;max-width:100%;font-size:4cqw;font-weight:700;line-height:.88;white-space:nowrap;font-variant-numeric:tabular-nums}\n.support-caption{display:block;margin-top:.2cqw;font-size:1.9cqw;font-weight:700;line-height:1;white-space:nowrap}\n.utility{position:relative;height:6.5cqw;min-height:35px;display:flex;align-items:center;padding:0 2.5cqw;background:#253747;color:#f9faf8;border-top:1px solid #5a727c}\n.sport-tag{font-size:3.5cqw;font-weight:700;line-height:1;letter-spacing:.015em;white-space:nowrap}\n.point-slot{position:absolute;right:2cqw;top:50%;transform:translateY(-50%);width:19cqw;height:2em;text-align:right;pointer-events:none}\n.point-state{position:absolute;inset:0;background:#253747;color:#f9faf8;font-size:1.35cqw;font-weight:700;line-height:2em;white-space:nowrap}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.horizontal .lanes{flex-direction:row}\n.horizontal .lane{height:12.5cqw;flex:1 1 50%}\n.horizontal .lane+.lane{border-top:0;border-left:1px solid #5a727c}\n.horizontal .identity{flex-basis:1.8cqw}\n.horizontal .name-lane{padding:0 2.1cqw;gap:.7cqw}\n.horizontal .name{font-size:4.7cqw}\n.horizontal .serve{flex-basis:1.1cqw;width:1.1cqw;font-size:1.1cqw}\n.horizontal .score-terminal{flex-basis:23%;width:23%}\n.horizontal .primary-number{font-size:5.8cqw}\n.horizontal .primary-caption{font-size:1.45cqw}\n.horizontal .support-foot{margin:0 1cqw}\n.horizontal .support-number{font-size:2.6cqw}\n.horizontal .support-caption{font-size:1.25cqw}\n.horizontal .utility{height:4.4cqw}\n.horizontal .sport-tag{font-size:2.4cqw}\n.horizontal .point-state{font-size:.9cqw}\n@media(max-width:650px){\n .board,.board.horizontal{width:94vw}\n .lanes,.horizontal .lanes{flex-direction:column}\n .lane,.horizontal .lane{height:32cqw;min-height:115px;flex:0 0 auto}\n .lane+.lane,.horizontal .lane+.lane{border-left:0;border-top:1px solid #5a727c}\n .identity,.horizontal .identity{flex-basis:2cqw}\n .name-lane,.horizontal .name-lane{padding:0 3cqw}\n .name,.horizontal .name{font-size:6.3cqw}\n .serve,.horizontal .serve{flex-basis:2cqw;width:2cqw;font-size:1.8cqw}\n .score-terminal,.horizontal .score-terminal{flex-basis:28%;width:28%}\n .primary-number,.horizontal .primary-number{font-size:11cqw}\n .primary-caption,.horizontal .primary-caption{font-size:2.6cqw}\n .support-foot,.horizontal .support-foot{margin:0 1.5cqw}\n .support-number,.horizontal .support-number{font-size:5cqw}\n .support-caption,.horizontal .support-caption{font-size:2.3cqw}\n .utility,.horizontal .utility{height:10cqw;min-height:36px;padding:0 3cqw}\n .sport-tag,.horizontal .sport-tag{font-size:4.1cqw}\n .point-slot{right:2cqw;width:24cqw}\n .point-state,.horizontal .point-state{font-size:2cqw}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board columnContainer compact\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lane rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n      <div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\" aria-label=\"Serving\">●</span></div>\n      <div class=\"score-terminal\"><div class=\"primary-track\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div><div class=\"support-foot\"><span class=\"support-number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-caption\">GAMES</span></div></div>\n    </div>\n    <div class=\"lane rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n      <div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\" aria-label=\"Serving\">●</span></div>\n      <div class=\"score-terminal\"><div class=\"primary-track\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div><div class=\"support-foot\"><span class=\"support-number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-caption\">GAMES</span></div></div>\n    </div>\n  </div>\n  <footer class=\"utility\"><div class=\"sport-tag\">PICKLEBALL</div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></footer>\n</article></main>\n</body>\n</html>\n","css":""}
