{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Vertical Name Spine TABLE TENNIS 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#0e2735}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh}.board{width:min(var(--view-width),1400px,var(--height-width));container-type:inline-size;position:relative;display:flex;flex-direction:column;background:transparent;padding-bottom:3.5cqw}.header{color:#f5f1e7;font-size:var(--header-size);line-height:1;margin:0 0 var(--header-gap);text-align:center;white-space:nowrap}.panes{display:flex;gap:var(--pane-gap)}.pane{display:flex;flex-shrink:0;min-width:0;height:var(--pane-height);background:#f1ede4}.spine{position:relative;flex:0 0 var(--spine-width);background:#0e2735;min-width:0;height:100%;overflow:hidden}.name{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-90deg);display:block;width:var(--name-length);height:calc(var(--name-font) * 1.12);font-size:var(--name-font);line-height:1.12;white-space:nowrap;text-align:center;color:#f5f1e7;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.025em}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{position:absolute;left:50%;bottom:.5cqw;transform:translateX(-50%);font-size:1.6cqw;width:1.6cqw;height:1.6cqw;color:#f5f1e7}.face{flex:1;min-width:0;display:flex;flex-direction:column;align-items:stretch;padding:var(--face-pad)}.secondary{display:flex;justify-content:center;align-items:center;color:#b66345;gap:1cqw;min-height:var(--secondary-height)}.label{font-size:var(--label-size);line-height:1.1;text-align:center;white-space:nowrap}.games,.match-score{font-size:var(--games-size);line-height:1.1}.match-score{min-width:2ch;font-variant-numeric:tabular-nums;text-align:center}.primary{min-width:0;display:flex;flex-direction:column;align-items:center;margin-top:var(--score-gap)}.score{display:block;width:100%;font-family:\"Arial Black\",Arial,Helvetica,sans-serif;font-weight:900;font-size:var(--score-size);line-height:.9;text-align:center;letter-spacing:-.07em;white-space:nowrap;font-variant-numeric:tabular-nums;transform:scaleY(var(--score-stretch));transform-origin:center}.primary>.label{margin-top:var(--point-gap)}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:40cqw;height:2.3cqw;font-size:1.9cqw;text-align:center;color:#f5f1e7}.point{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{--view-width:94vw}.point-slot{font-size:2.2cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:66vw;--height-width:109vh;--header-size:7.8cqw;--header-gap:3.6cqw;--pane-gap:3.5cqw;--pane-height:31cqw;--spine-width:15.7%;--name-length:27cqw;--name-font:6.2cqw;--face-pad:1.6cqw 4cqw;--secondary-height:4.5cqw;--games-size:4cqw;--score-size:20.5cqw;--score-stretch:1;--score-gap:.6cqw;--point-gap:.2cqw;--label-size:4.5cqw}.panes{flex-direction:column}.pane{width:100%}\n@media(max-width:600px){.board{--view-width:94vw}.point-slot{font-size:clamp(10px,2.2cqw,14px)}}\n\n/* Reserved conditional match states: all score and name tracks remain fixed. */\n.osb-conditional-rail{--osb-rail-bg:#182b35;--osb-rail-fg:#f9fbfa;box-sizing:border-box!important;position:relative!important;inset:auto!important;transform:none!important;grid-column:1/-1!important;display:flex!important;align-items:center!important;justify-content:space-between!important;flex:0 0 auto!important;width:100%!important;min-width:0!important;min-height:28px!important;height:28px!important;margin:0!important;padding:2px 7px!important;gap:5px!important;overflow:hidden!important;background:var(--osb-rail-bg)!important;color:var(--osb-rail-fg)!important;border:0!important;font:700 11px/1 Arial,Helvetica,sans-serif!important;letter-spacing:0!important;text-transform:none!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-condition-side{all:unset!important;box-sizing:border-box!important;display:flex!important;align-items:center!important;flex:1 1 35%!important;width:35%!important;min-width:0!important;height:22px!important;gap:2px!important;position:relative!important;overflow:hidden!important}\n.osb-conditional-rail .osb-condition-side-b{justify-content:flex-end!important}\n.osb-conditional-rail .osb-condition-side-label{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 13px!important;width:13px!important;height:18px!important;color:var(--osb-rail-fg)!important;font:800 10px/1 Arial,Helvetica,sans-serif!important}\n.osb-conditional-rail .osb-condition-slot{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 21px!important;width:21px!important;height:18px!important;position:relative!important}\n.osb-conditional-rail .osb-condition-timeoutused{flex-basis:21px!important;width:21px!important}\n.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:17px!important;width:17px!important}\n.osb-conditional-rail .osb-condition-badge{box-sizing:border-box!important;align-items:center!important;justify-content:center!important;width:100%!important;height:18px!important;min-width:0!important;margin:0!important;padding:0 2px!important;border:1px solid rgba(255,255,255,.3)!important;border-radius:2px!important;background:rgba(255,255,255,.12)!important;color:var(--osb-rail-fg)!important;font:800 9px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-timeout-icon{position:relative!important;display:flex;align-items:center!important;justify-content:center!important;padding:0!important;color:var(--osb-rail-fg)!important}\n.osb-conditional-rail .osb-timeout-icon::before{content:\"\"!important;display:block!important;width:11px!important;height:11px!important;border:1.5px solid currentColor!important;border-radius:50%!important;background:transparent!important}\n.osb-conditional-rail .osb-timeout-icon::after{content:\"\"!important;position:absolute!important;left:50%!important;top:3px!important;width:3px!important;height:6px!important;border-left:1.5px solid currentColor!important;border-bottom:1.5px solid currentColor!important;transform:translateX(-25%) rotate(-35deg)!important;transform-origin:bottom left!important}\n.osb-conditional-rail .isATimeOutActive,.osb-conditional-rail .isBTimeOutActive{background:#f3d27a!important;color:#253641!important;border-color:#f3d27a!important}\n.osb-conditional-rail .isATimeOutUsed,.osb-conditional-rail .isBTimeOutUsed{background:transparent!important;color:#b8c7ca!important;border-color:#b8c7ca!important}\n.osb-conditional-rail .isAYellowCarded,.osb-conditional-rail .isBYellowCarded{background:#e5c94e!important;color:#253641!important;border-color:#e5c94e!important}\n.osb-conditional-rail .isARedCarded,.osb-conditional-rail .isBRedCarded{background:#c94747!important;color:#fff!important;border-color:#c94747!important}\n.osb-conditional-rail .point-slot.osb-shared-point{all:unset!important;box-sizing:border-box!important;position:relative!important;display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 30%!important;width:30%!important;min-width:78px!important;max-width:130px!important;height:22px!important;min-height:22px!important;inset:auto!important;margin:0!important;padding:0!important;transform:none!important;overflow:hidden!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important}\n.osb-conditional-rail .point-slot.osb-shared-point>.isGamePoint,.osb-conditional-rail .point-slot.osb-shared-point>.isMatchPoint{box-sizing:border-box!important;position:absolute!important;inset:0!important;display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;transform:none!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:390px){.osb-conditional-rail{padding:2px 4px!important;gap:3px!important}.osb-conditional-rail .osb-condition-side{gap:1px!important}.osb-conditional-rail .osb-condition-slot{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-timeoutused{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:15px!important;width:15px!important}.osb-conditional-rail .point-slot.osb-shared-point{min-width:76px!important}}\n\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><h1 class=\"header\">TABLE TENNIS</h1><div class=\"panes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"pane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"face columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"secondary\"><div class=\"label games\">GAMES</div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"primary\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><div class=\"label\">POINTS</div></div></div></div><div class=\"pane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"spine jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"face columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"secondary\"><div class=\"label games\">GAMES</div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"primary\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><div class=\"label\">POINTS</div></div></div></div></div><div class=\"osb-conditional-rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Conditional match states\"><div class=\"osb-condition-side osb-condition-side-a\" data-osb-component=\"layout\"><span class=\"osb-condition-side-label\">A</span><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div><span class=\"point-slot osb-shared-point\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><div class=\"osb-condition-side osb-condition-side-b\" data-osb-component=\"layout\"><span class=\"osb-condition-side-label\">B</span><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div></div></article></main></body>\n</html>\n","css":""}
