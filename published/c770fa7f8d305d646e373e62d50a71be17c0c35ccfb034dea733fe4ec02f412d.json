{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Silver Plum Ledger Volleyball — Horizontal Lanes</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #402944; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 480px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #bec7cd; border-bottom: 2px solid #402944; background: #e8edf0; }\n.sport-title { min-height: 20px; padding: 3px 10px; background: #402944; color: #fff; font-size: 14px; font-weight: 700; line-height: 1; text-align: center; white-space: nowrap; }\n.lanes { display: flex; min-height: 48px; }\n.team { display: flex; align-items: stretch; flex: 1 1 0; }\n.team + .team { border-left: 1px solid #bec7cd; }\n.identity { display: flex; align-items: center; flex: 1 1 0; gap: 8px; padding: 6px; }\n.tick { display: block; width: 3px; flex: 0 0 3px; height: 27px; background: #402944; }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20px; font-weight: 700; line-height: 1; color: #402944; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; flex: 0 0 17%; }\n.points-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; flex: 0 0 30%; margin: 2px; border: 1px solid #bec7cd; background: #fff; }\n.label { display: block; font-size: 11px; font-weight: 700; line-height: 1; }\n.match-score, .primary-score { display: block; width: 100%; font-size: 18px; font-weight: 700; line-height: 1; text-align: center; font-variant-numeric: tabular-nums; }\n.primary-score { font-size: 30px; }\n.set-footer { min-height: 20px; display: flex; align-items: center; justify-content: center; gap: 8px; border-top: 1px solid #bec7cd; font-size: 12px; font-weight: 700; line-height: 1; }\n.set-value { display: block; width: 21px; text-align: center; font-size: 18px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .lanes { flex-direction: column; }\n  .team { flex-basis: auto; min-height: 48px; }\n  .team + .team { border-left: 0; border-top: 1px solid #bec7cd; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"sport-title\">VOLLEYBALL</header>\n      <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
