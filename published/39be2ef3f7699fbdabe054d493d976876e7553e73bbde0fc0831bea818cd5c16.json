e>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<span class=\"tie\"><img class=\"tlogo teamLogoURLA\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><i class=\"tchip teamJerseyColorA\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorA\"></i><span class=\"tname ta teamAName\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tsc\"><span class=\"tscore num teamAScore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span><i class=\"tdash\">-</i><span class=\"tscore num teamBScore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span><span class=\"tname tb teamBName\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><i class=\"tchip teamJerseyColorB\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorB\"></i><img class=\"tlogo teamLogoURLB\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"></span>\n<div class=\"head\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"slot sslot pslot\"><span class=\"st sfmt\"><span class=\"matchFormatLabel\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span><span class=\"st swarm isWarmUpStarted\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">WARM-UP</span><span class=\"st sgame isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">GAME <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st scur isGame1Current\" data-osb-component=\"field\" data-osb-field=\"isGame1Current\" style=\"opacity:0\">GAME <span class=\"num\">1</span><b class=\"lv\">LIVE</b></span><span class=\"st scur isGame2Current\" data-osb-component=\"field\" data-osb-field=\"isGame2Current\" style=\"opacity:0