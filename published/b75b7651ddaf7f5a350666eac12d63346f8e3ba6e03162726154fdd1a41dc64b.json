{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Line Score Strip</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;text-wrap:balance}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.22rem)}\n.dot{position:relative;flex:none;width:var(--dot,.62rem);height:var(--dot,.62rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18));box-shadow:inset 0 0 0 .08rem var(--dot-edge,transparent)}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:not(:empty)+.ev-r:not(:empty)::before{content:\"\\00b7\";margin:0 .4em;opacity:.7}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.3em}.st-live-in>i{width:.5em;height:.5em;border-radius:50%;background:currentColor;animation:osb-pulse 1.6s ease-in-out infinite}\n@keyframes osb-pulse{50%{transform:scale(.55)}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\n.ls{display:flex}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.tick{position:relative}.tick>.tick-on{position:absolute;inset:0;border-radius:inherit;background:var(--tick-on,#fff)}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;left:50%;bottom:2.4rem;transform:translateX(-50%);font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#f2f8f8}\n.strip{display:flex;align-items:stretch;border-radius:.4rem;overflow:hidden;background:#0f2a2e;box-shadow:0 .35rem 1rem rgba(0,0,0,.4)}\n.teams{display:flex;flex-direction:column;width:15rem}\n.th{display:flex;align-items:center;height:1.5rem;padding:0 .8rem;background:#1b4a50;color:#d9ecee;font:700 .8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;overflow:hidden}\n.th .ev{overflow:hidden;text-overflow:ellipsis}\n.row{position:relative;display:flex;align-items:center;height:2.5rem;padding-left:1.1rem}\n.row+.row{border-top:.06rem solid rgba(255,255,255,.09)}\n.chip{position:absolute;left:0;top:0;bottom:0;width:.5rem}\n.home{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);width:.46rem;height:.48rem;background:#98b9bc;clip-path:polygon(0 0,100% 0,100% 55%,50% 100%,0 55%)}\n.nmw{flex:1;min-width:0;padding-left:.45rem}\n.nm{font-weight:700;font-size:1.25rem;line-height:1;text-transform:uppercase}\n.batw{flex:none;width:1.2rem;display:flex;justify-content:center}.bat{width:.55rem;height:.55rem;border-radius:50%;background:#f6e33a}\n.lsw{display:flex;flex-direction:column;background:#0b2124}\n.lsw .ls-h,.rhe .ls-h{background:#1b4a50;color:#d9ecee}\n.ls-col{display:flex;flex-direction:column;width:2rem}\n.ls-h{display:flex;align-items:center;justify-content:center;height:1.5rem;font:700 .82rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em}\n.ls-gate{display:flex;flex-direction:column}\n.ls-v{display:flex;align-items:center;justify-content:center;height:2.5rem;font:700 1.2rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;color:#f2f8f8}\n.ls-v+.ls-v{border-top:.06rem solid rgba(255,255,255,.09)}\n.ls-col+.ls-col{border-left:.06rem solid rgba(255,255,255,.09)}\n.ls-extra .ls-h{color:#f6e33a}\n.rhe{display:flex;border-left:.12rem solid #1b4a50}\n.rhe .ls-col{width:2.3rem}\n.rhe .runs,.rhe .he{display:flex;align-items:center;justify-content:center;height:2.5rem;font:700 1.25rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.rhe .runs{font-size:1.6rem;background:#f6e33a;color:#0f2a2e;width:2.9rem}\n.rhe .rcol{width:2.9rem}\n.rhe .he{color:#98b9bc}\n.rhe .he+.he,.rhe .runs+.runs{border-top:.06rem solid rgba(255,255,255,.09)}\n.sitw{display:flex;flex-direction:column;width:12rem;background:#08191c}\n.sitw .th{justify-content:flex-end}\n.sit{position:relative;flex:1;display:grid;grid-template-columns:auto auto auto;align-items:center;justify-content:space-evenly;column-gap:.5rem;padding:0 .6rem}\n.sit-r{display:flex;flex-direction:column;align-items:center;gap:.4rem}\n.sit-r .outw{--dot:.6rem;--dot-gap:.3rem;--dot-off:rgba(255,255,255,.16);--dot-on:#f6e33a}\n\n.inn{display:flex;align-items:center;gap:.15rem;font:700 1.7rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;--half-on:#f6e33a;--half-off:rgba(255,255,255,.2);--half-h:1.7rem;--half-size:0.73rem}\n.sit .diamond{--d:3.4rem;--base-edge:#e2f0f1;--base-off:rgba(255,255,255,.05);--base-on:#f6e33a;--base-line:.13rem}\n.cnt{display:flex;flex-direction:column;align-items:center;gap:.3rem}\n.count{font:700 1.45rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}.count .dash{opacity:.55;margin:0 .06em}\n.bs{display:flex;gap:.45rem;--dot:0.55rem;--dot-gap:.17rem;--dot-off:rgba(255,255,255,.16);--dot-edge:transparent}.ball-dots{--dot-on:#5bd98c}.strike-dots{--dot-on:#ff6a6a}\n.outw{display:flex;flex-direction:column;align-items:center;gap:.3rem;--dot:0.62rem;--dot-gap:.3rem;--dot-off:rgba(255,255,255,.16);--dot-edge:transparent;--dot-on:#f6e33a}\n.outs-l{font:700 .74rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#98b9bc}\n.outw{flex-direction:row}.outs-l{display:none}\n.cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.25rem;background:#08191c;text-transform:uppercase;text-align:center;z-index:2}\n.cover b{font:700 .78rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#98b9bc}\n.cover .periodLabel{font:700 1.45rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.04em}\n.cover.fin{font:700 1.6674999999999998rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.1em;color:#f6e33a}\n</style></head><body><main class=\"board\" aria-label=\"Softball lower-third scoreboard\">\n<div class=\"strip rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"softball line score\">\n<div class=\"teams\"><div class=\"th\"><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span></div><div class=\"row\"><span class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"home isAHome\" data-osb-component=\"field\" data-osb-field=\"isAHome\" style=\"opacity: 0\"></span></span><span class=\"nmw\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"batw\"><span class=\"bat isABatting\" data-osb-component=\"field\" data-osb-field=\"isABatting\" style=\"opacity: 0\"></span></span></div><div class=\"row\"><span class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"home isBHome\" data-osb-component=\"field\" data-osb-field=\"isBHome\" style=\"opacity: 0\"></span></span><span class=\"nmw\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span><span class=\"batw\"><span class=\"bat isBBatting\" data-osb-component=\"field\" data-osb-field=\"isBBatting\" style=\"opacity: 0\"></span></span></div></div>\n<div class=\"lsw\"><span class=\"ls\"><span class=\"ls-col\"><span class=\"ls-h\">1</span><span class=\"ls-gate isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"><span class=\"ls-v game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><span class=\"ls-v game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"ls-col\"><span class=\"ls-h\">2</span><span class=\"ls-gate isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"><span class=\"ls-v game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><span class=\"ls-v game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"ls-col\"><span class=\"ls-h\">3</span><span class=\"ls-gate isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"><span class=\"ls-v game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><span class=\"ls-v game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"ls-col\"><span class=\"ls-h\">4</span><span class=\"ls-gate isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"><span class=\"ls-v game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><span class=\"ls-v game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"ls-col\"><span class=\"ls-h\">5</span><span class=\"ls-gate isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"><span class=\"ls-v game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><span class=\"ls-v game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span><span class=\"ls-col\"><span class=\"ls-h\">6</span><span class=\"ls-gate isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"><span class=\"ls-v game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span><span class=\"ls-v game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></span><span class=\"ls-col\"><span class=\"ls-h\">7</span><span class=\"ls-gate isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"><span class=\"ls-v game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span><span class=\"ls-v game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></span><span class=\"ls-col ls-extra\"><span class=\"ls-h\">8</span><span class=\"ls-gate isGame8Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"ls-v game8AScore\" data-osb-component=\"field\">0</span><span class=\"ls-v game8BScore\" data-osb-component=\"field\">0</span></span></span><span class=\"ls-col ls-extra\"><span class=\"ls-h\">9</span><span class=\"ls-gate isGame9Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"ls-v game9AScore\" data-osb-component=\"field\">0</span><span class=\"ls-v game9BScore\" data-osb-component=\"field\">0</span></span></span><span class=\"ls-col ls-extra\"><span class=\"ls-h\">10</span><span class=\"ls-gate isGame10Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"ls-v game10AScore\" data-osb-component=\"field\">0</span><span class=\"ls-v game10BScore\" data-osb-component=\"field\">0</span></span></span></span></div>\n<div class=\"rhe\"><span class=\"ls-col rcol\"><span class=\"ls-h\">R</span><span class=\"runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"ls-col\"><span class=\"ls-h\">H</span><span class=\"he hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"he hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span></span><span class=\"ls-col\"><span class=\"ls-h\">E</span><span class=\"he errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span><span class=\"he errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></span></div>\n<div class=\"sitw\"><div class=\"th\"><span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span></span></div><div class=\"sit\"><span class=\"inn\"><span class=\"half\" aria-hidden=\"true\"><span class=\"half-dim\"></span><span class=\"half-win\"><span class=\"inningHalf\" data-osb-component=\"field\"></span></span></span><span class=\"inn-n inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"diamond\" aria-label=\"Bases\"><span class=\"base second\"><span class=\"runner isRunnerOnSecond\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnSecond\" style=\"opacity: 0\"></span></span><span class=\"base third\"><span class=\"runner isRunnerOnThird\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnThird\" style=\"opacity: 0\"></span></span><span class=\"base first\"><span class=\"runner isRunnerOnFirst\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnFirst\" style=\"opacity: 0\"></span></span></span><span class=\"sit-r\"><span class=\"cnt\"><span class=\"count\"><span class=\"cb balls\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"dash\" aria-hidden=\"true\">-</span><span class=\"cs strikes\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"bs\"><span class=\"dots ball-dots\"><span class=\"dot\"><span class=\"lit isBall1\" data-osb-component=\"field\" data-osb-field=\"isBall1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall2\" data-osb-component=\"field\" data-osb-field=\"isBall2\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall3\" data-osb-component=\"field\" data-osb-field=\"isBall3\" style=\"opacity: 0\"></span></span></span><span class=\"dots strike-dots\"><span class=\"dot\"><span class=\"lit isStrike1\" data-osb-component=\"field\" data-osb-field=\"isStrike1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isStrike2\" data-osb-component=\"field\" data-osb-field=\"isStrike2\" style=\"opacity: 0\"></span></span></span></span></span><span class=\"dots outw out-dots\"><span class=\"dot\"><span class=\"lit isOut1\" data-osb-component=\"field\" data-osb-field=\"isOut1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isOut2\" data-osb-component=\"field\" data-osb-field=\"isOut2\" style=\"opacity: 0\"></span></span></span></span><span class=\"cover isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0\"><b>End of</b><span class=\"periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\"></span></span><span class=\"cover fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\">Final</span></div></div>\n</div>\n<span class=\"sr\"><span class=\"battingSide\" data-osb-component=\"field\" data-osb-field=\"battingSide\"></span><span class=\"bases\" data-osb-component=\"field\" data-osb-field=\"bases\"></span><span class=\"outs\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></span><span class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></span></span>\n</main></body></html>\n","css":""}
