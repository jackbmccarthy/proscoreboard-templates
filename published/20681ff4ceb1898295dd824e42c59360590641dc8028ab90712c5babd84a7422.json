{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>PICKLEBALL — Pearl Graphite Rightdock</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--pearl:#e8ebe7;--graphite:#26363e;--white:#f8faf8;--rule:#aeb9b7;display:flex;min-width:0;overflow:hidden;border:1px solid var(--rule);border-radius:3px;background:var(--pearl);color:var(--graphite);container-type:inline-size}\n.board.compact.tt{width:min(69vw,1410px)}\n.board.compact.pb{width:min(55vw,1110px)}\n.board.horizontal{width:min(93vw,1900px)}\n.lanes{display:flex;min-width:0;flex:1 1 auto}\n.compact .lanes{flex-direction:column}\n.horizontal .lanes{flex-direction:row}\n.competitor{display:flex;min-width:0;flex:1 1 0;align-items:stretch;background:var(--pearl)}\n.compact.tt .competitor{flex:0 0 85px;height:85px}\n.compact.pb .competitor{flex:0 0 92px;height:92px}\n.horizontal.tt .competitor{height:104px}\n.horizontal.pb .competitor{height:93px}\n.compact .competitor+.competitor{border-top:1px solid var(--rule)}\n.identity{display:block;flex:0 0 2.2%;background:#2b85a3}\n.jerseyColorB{background:#c76b64}\n.horizontal .identity{flex-basis:2.8%}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:8px;padding:0 3.1%}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:clamp(18px,3.2cqw,56px);line-height:1.1;font-weight:700}\n.horizontal .name{font-size:clamp(18px,2.3cqw,48px)}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 9px;width:9px;height:9px;border-radius:50%;background:var(--graphite)}\n.support-track,.primary-track{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;text-align:center}\n.support-track{flex:0 0 13.5%;background:var(--pearl)}\n.primary-track{flex:0 0 16%;background:var(--graphite);color:var(--white)}\n.pb.compact .support-track{flex-basis:17%}\n.pb.compact .primary-track{flex-basis:19%}\n.horizontal .support-track{flex-basis:13%}\n.horizontal .primary-track{flex-basis:21%}\n.support-score,.primary-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-weight:700;font-variant-numeric:tabular-nums;line-height:.98}\n.support-score{font-size:clamp(26px,3.2cqw,61px)}\n.primary-score{font-size:clamp(39px,5.2cqw,96px)}\n.horizontal .support-score{font-size:clamp(25px,3cqw,59px)}\n.horizontal .primary-score{font-size:clamp(39px,4.8cqw,91px)}\n.support-label,.primary-label{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:clamp(9px,1.25cqw,23px);line-height:1.15;font-weight:700}\n.dock{position:relative;display:flex;flex:0 0 24.5%;min-width:0;align-items:center;justify-content:center;border-left:1px solid var(--rule);background:var(--graphite);color:var(--white)}\n.pb.compact .dock{flex-basis:22%}\n.horizontal .dock{flex-basis:17.5%}\n.dock-title{max-width:100%;overflow:hidden;white-space:nowrap;padding:0 5%;font-size:clamp(15px,2.3cqw,38px);line-height:1.1;font-weight:700;text-align:center}\n.horizontal .dock-title{font-size:clamp(14px,2.1cqw,37px)}\n.point-slot{position:absolute;right:0;bottom:3px;left:0;height:14px;font-size:10px;line-height:14px;font-weight:700;text-align:center;pointer-events:none}\n.point-state{position:absolute;inset:0;display:block;white-space:nowrap}\n.point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint,.point-slot:has(.isMatchPoint[style*=\"opacity:1\"]) .isGamePoint{opacity:0!important}\n@media(max-width:700px){\n  .board.compact.tt,.board.compact.pb,.board.horizontal{width:94vw}\n  .horizontal .lanes{flex-direction:column}\n  .compact.tt .competitor,.compact.pb .competitor,.horizontal.tt .competitor,.horizontal.pb .competitor{flex:0 0 82px;height:82px}\n  .horizontal .competitor+.competitor{border-top:1px solid var(--rule)}\n  .identity,.horizontal .identity{flex:0 0 5px}\n  .name-lane{padding:0 8px;gap:3px}\n  .name,.horizontal .name{font-size:clamp(12px,4vw,23px)}\n  .serve{flex-basis:5px;width:5px;height:5px}\n  .support-track,.pb.compact .support-track,.horizontal .support-track{flex:0 0 17%}\n  .primary-track,.pb.compact .primary-track,.horizontal .primary-track{flex:0 0 23%}\n  .support-score,.horizontal .support-score{font-size:clamp(20px,6vw,30px)}\n  .primary-score,.horizontal .primary-score{font-size:clamp(27px,8.5vw,42px)}\n  .support-label,.primary-label{font-size:8px}\n  .dock,.pb.compact .dock,.horizontal .dock{flex:0 0 24%}\n  .dock-title,.horizontal .dock-title{font-size:clamp(10px,2.8vw,19px);white-space:normal;overflow-wrap:anywhere}\n  .point-slot{font-size:7px}\n}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\">\n  <article class=\"board columnContainer compact pb\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lanes\"><div class=\"competitor rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n      <div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div>\n      <div class=\"support-track\"><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-label\">GAMES</span></div>\n      <div class=\"primary-track\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\">POINTS</span></div>\n    </div><div class=\"competitor rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n      <div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div>\n      <div class=\"support-track\"><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-label\">GAMES</span></div>\n      <div class=\"primary-track\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\">POINTS</span></div>\n    </div></div>\n    <div class=\"dock\"><span class=\"dock-title\">PICKLEBALL</span><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n  </article>\n</main>\n</body>\n</html>\n","css":""}
