{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Baseball — Charcoal Outline Sidecar 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}\n.shell{position:relative;max-width:100%;padding-top:0;container-type:inline-size}\n.board{display:flex;position:relative;width:100%;min-width:0;overflow:hidden;background:#20272c;color:#fff;border:1px solid #a8b8bc;border-radius:2px}\n.competitors{display:flex;position:relative;flex:1 1 75%;min-width:0;flex-direction:column;padding-top:3.8cqw}\n.competitor{display:flex;align-items:center;position:relative;flex:1 1 auto;min-width:0;background:#20272c}\n.competitor+.competitor{border-top:1px solid #a8b8bc}\n.identity{flex:none;width:15px;height:72%;margin-left:8px;background:#0e87eb}\n.jerseyColorB{background:#f22e39}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-left:28px;padding-right:10px;font-weight:700;line-height:1.05;color:#fff;font-size:5.8cqw}\n.combinedAName:empty:before{content:\"Team A\"}\n.combinedBName:empty:before{content:\"Team B\"}\n.score-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:22%;min-width:0;height:84%;margin-right:10px;background:#20272c;border:1px solid #dce3e2}\n.score{display:block;width:100%;min-width:0;color:#fff;text-align:center;font-size:6.1cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.inside-runs{color:#dce3e2;font-size:1.25cqw;font-weight:700;line-height:1;white-space:nowrap;margin-bottom:4px}\n.sport-tag{position:absolute;z-index:2;left:0;top:0;display:flex;align-items:center;justify-content:center;min-width:15.5cqw;height:3.8cqw;padding:0 1.8cqw;background:#dce3e2;color:#20272c;font-size:2.1cqw;font-weight:800;line-height:1;white-space:nowrap}\n.runs-heading{position:absolute;top:8px;right:calc(16% + 12px);color:#fff;font-size:2cqw;font-weight:700;line-height:1}\n.dock{display:flex;flex-direction:column;flex:0 0 25%;min-width:0;padding:12px 18px;background:#dce3e2;color:#20272c}\n.stat{display:flex;align-items:center;justify-content:space-between;gap:7px;flex:1 1 0;min-height:0;white-space:nowrap}\n.stat+.stat{border-top:1px solid #7e958f}\n.stat-label{font-size:2.2cqw;font-weight:700;line-height:1}\n.stat-value{font-size:3.15cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.shell{width:min(60vw,1100px,calc((100vh - 32px)*3.65))}\n.board{height:min(16.6vw,305px,calc((100vh - 32px)*.85))}\n@media(max-width:700px){\n.stage{padding:10px}\n.shell{width:100%;padding-top:0}\n.board{height:auto;min-height:159px}\n.competitors{flex-direction:column;padding-top:29px}\n.competitor{height:65px;flex:none}\n.competitor+.competitor{border-left:0;border-top:1px solid #a8b8bc}\n.identity{width:5px;margin-left:5px;height:72%}\n.name{font-size:clamp(14px,5cqw,20px);margin-left:9px;padding-right:2px}\n.score-track{width:53px;height:78%;margin-right:5px}\n.score{font-size:clamp(23px,7cqw,30px)}\n.inside-runs{font-size:8px;margin-bottom:2px}\n.sport-tag{height:29px;min-width:95px;padding:0 7px;top:0;font-size:12px}\n.runs-heading{top:6px;right:60px;font-size:10px}\n.dock{flex:0 0 33%;padding:6px}\n.stat{gap:2px}\n.stat-label{font-size:clamp(7px,2.3cqw,10px)}\n.stat-value{font-size:clamp(13px,4cqw,17px)}\n}\n@media(max-width:390px){.dock{flex-basis:34%}.score-track{width:48px}.name{font-size:17px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n  <div class=\"shell\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\">\n      <div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"competitor rowContainer side-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n  <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n  <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n  <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n  <span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n</div>\n<div class=\"competitor rowContainer side-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n  <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n  <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n  <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n  <span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n</div>\n        <span class=\"runs-heading\" data-osb-component=\"text\">RUNS</span>\n      </div>\n      <aside class=\"dock columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Editable static game counters\">\n<div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">INNING</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div>\n<div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">BALLS</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div>\n<div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">STRIKES</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div>\n<div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">OUTS</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div>\n      </aside>\n      <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n    </article>\n    <span class=\"sport-tag\" data-osb-component=\"text\">BASEBALL</span>\n  </div>\n</main>\n</body>\n</html>\n","css":""}
