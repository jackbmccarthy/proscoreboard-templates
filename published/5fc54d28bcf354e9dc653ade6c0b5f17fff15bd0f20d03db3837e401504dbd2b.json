{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Full Screen — Linescore</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\nhtml,body{height:100%;overflow:hidden}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.osb-core-fields{display:none!important}\n/* a card centred on a transparent page */\n.board{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.25vw;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:transparent;-webkit-font-smoothing:antialiased;--navy:#0d1830;--panel:#132244;--line:#26396a;--gold:#ffd23f;--mute:#a9bbdd}\n.card{display:flex;flex-direction:column;gap:1.1em;width:74em;padding:1.5em 1.8em 1.3em;border-radius:.8em;background:linear-gradient(180deg,#172a52 0%,#0b1429 100%);box-shadow:0 .5em 1.4em rgba(0,0,0,.35),inset 0 .3em 0 var(--gold)}\n/* header: event, round and format; the match state on the right */\n.top{display:flex;align-items:center;justify-content:space-between;gap:2em;min-width:0}\n.title{display:flex;flex-direction:column;gap:.35em;min-width:0;text-transform:uppercase}\n.kick{font-size:1.3em;font-weight:800;letter-spacing:.22em;color:var(--gold)}\n.ev{font-size:2.5em;font-weight:800;letter-spacing:.03em;line-height:1.04;overflow-wrap:normal;hyphens:none;text-wrap:balance}\n.ev:empty{display:none}\n.sub{display:flex;align-items:center;gap:.7em;font-size:1.55em;font-weight:700;letter-spacing:.12em;color:var(--mute)}\n.sub .sep{font-style:normal;opacity:.75}\n.sub .rd:empty+.sep,.sub .sep:has(+.bo:empty){display:none}\n.state{width:15em;height:3.2em}\n.state>*{border-radius:.3em;font-size:1.45em;font-weight:900;letter-spacing:.1em;text-transform:uppercase}\n.plbl{box-shadow:inset 0 0 0 .1em #3b5285;color:var(--mute)}\n.state:has(>.gtag[style*=\"opacity: 1\"]) .plbl,.state:has(>.fin[style*=\"opacity: 1\"]) .plbl,.board:has(.isWarmUpStarted[style*=\"opacity: 1\"]) .plbl{opacity:0}\n.gtag{background:#fff;color:var(--navy)}\n.fin{background:var(--gold);color:#111}\n.warm{background:#2a6df4;color:#fff}\n/* team tie strip */\n.tielbl{display:none;font-size:1.3em;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--mute)}\n.tiebar{display:none;align-items:center;gap:1em;min-height:3.6em;padding:.3em 1.2em;border-radius:.4em;background:var(--panel);box-shadow:inset 0 0 0 .08em var(--line);font-size:1.35em;font-weight:800;text-transform:uppercase;letter-spacing:.04em}\n.board:has(.tname:not(:empty)) .tiebar{display:flex}\n.tside{display:flex;align-items:center;gap:.6em;flex:1 1 0;min-width:0}\n.tb{justify-content:flex-end;text-align:right}\n.tlogo{width:1.8em;height:1.8em;object-fit:contain;flex:0 0 auto}\n.tname{min-width:0;line-height:1.05;overflow-wrap:normal;hyphens:none}\n.tbox{display:flex;align-items:center;gap:.4em;flex:0 0 auto;height:2em;padding:0 .7em;border-radius:.25em;background:var(--gold);color:#111;font-variant-numeric:tabular-nums}\n.tbox i{font-style:normal;letter-spacing:.12em;margin-right:.2em}\n.tbox .tscore{font-size:1.3em}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) :is(.table,.foot,.state){display:none}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tiebar{font-size:2em;min-height:3.6em}\n.board:has(.tname:not(:empty)):not(:has(.name:not(:empty))) .tielbl{display:block}\n/* the line score: players, every game in order (G1-G3 always framed), the game in play lit, games won */\n.table{display:flex;align-items:stretch;border-radius:.5em;overflow:hidden;background:var(--panel);box-shadow:inset 0 0 0 .08em var(--line)}\n.hd{display:flex;align-items:center;justify-content:center;height:2.5em;background:var(--navy);color:#d6e0f2;font-size:1.35em;font-weight:800;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}\n.players{display:flex;flex-direction:column;flex:1 1 auto;min-width:0}\n.players>.hd{justify-content:flex-start;padding:0 1.1em}\n.row{display:flex;align-items:center;gap:.7em;height:5.4em;padding-right:0;min-width:0}\n.row+.row,.hc+.hc,.cell+.cell{border-top:.08em solid var(--line)}\n.kit{flex:0 0 .55em;align-self:stretch;background:#55647e}\n.flag{flex:0 0 auto;width:2.6em;height:1.75em;object-fit:cover;border-radius:.15em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.nmw{display:flex;align-items:center;gap:.6em;flex:1 1 auto;min-width:0}\n.name{min-width:0;font-size:1.9em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;word-break:normal;hyphens:none}\n.wslot{width:2em;height:2em}\n.wslot:not(:has(>[style*=\"opacity: 1\"])){display:none}\n/* state column (time-out, cards) and serve column: fixed slots of their own, aligned in both rows */\n.win{border-radius:50%;background:var(--gold)}\n.win::after{content:\"\";width:.5em;height:.95em;margin-top:-.2em;border:solid #111;border-width:0 .22em .22em 0;transform:rotate(45deg)}\n.marks{display:flex;align-items:center;gap:.5em;flex:0 0 12.8em;align-self:stretch;padding:0 .7em;border-left:.08em solid var(--line)}\n.to-slot{width:8.8em;height:2.3em}\n\n.to-on,.to-used{gap:.4em;border-radius:.25em;font-size:1.15em;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.to-on{background:var(--gold);color:#111}\n.to-used{background:#2a3d63;color:#dfe7f6}\n.tclock{display:inline-flex;align-items:center;justify-content:center;min-width:1.9em;height:1.45em;border-radius:.2em;background:#111;color:var(--gold);font-variant-numeric:tabular-nums}\n.card-slot{width:1.3em;height:1.8em}\n.cardk{border-radius:.16em;box-shadow:0 0 0 1px rgba(0,0,0,.35);transform:rotate(-8deg)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.sv{display:flex;align-items:center;justify-content:flex-end;gap:.45em;flex:0 0 6.4em;align-self:stretch;padding:0 .8em;border-left:.08em solid var(--line)}\n.s2slot{width:2.9em;height:1.9em}\n.ss2{border-radius:.25em;background:#dfe7f6;color:var(--navy);font-size:1.15em;font-weight:900;letter-spacing:.06em}\n.srv{width:2.2em;height:2.2em}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff9a3c 45%,#d65f00 100%);box-shadow:0 0 0 .14em rgba(0,0,0,.3),0 0 .6em rgba(255,154,60,.5)}\n.hist{position:relative;display:flex}\n.hcol{display:flex;flex-direction:column;flex:0 0 auto;width:4.6em;border-left:.08em solid var(--line)}\n.hc{position:relative;display:flex;align-items:center;justify-content:center;height:calc(5.4em / 2);font-size:2em;font-weight:800;font-variant-numeric:tabular-nums;color:#8293b3}\n.hc .won{inset:.3em .3em;border-radius:.15em;background:#2a3d63}\n.hc:has(.won[style*=\"opacity: 1\"]){color:#fff}\n/* the game in play: the only started game nobody has won yet */\n.hcol:not(:has(.won[style*=\"opacity: 1\"])){width:7.6em;background:var(--gold);border-left:0}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hd{background:#e8b900;color:#111}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hd::after{content:\"\\00a0·\\00a0live\"}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hc{font-size:4.2em;height:calc(5.4em / 4.2);color:#111}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])) .hc+.hc{border-top-color:#e8b900}\n/* frames for G1-G3 before they start */\n.ph{display:none;flex-direction:column;flex:0 0 auto;width:4.6em;border-left:.08em solid var(--line)}\n.ph .hc{color:#4a5e8c}\n.hist:has(>.isGame1Started:is([style*=\"display:none\"],[style*=\"display: none\"]))>.ph1,.hist:has(>.isGame2Started:is([style*=\"display:none\"],[style*=\"display: none\"]))>.ph2,.hist:has(>.isGame3Started:is([style*=\"display:none\"],[style*=\"display: none\"]))>.ph3{display:flex}\n.ph1{order:1}.isGame1Started{order:1}.ph2{order:2}.isGame2Started{order:2}.ph3{order:3}.isGame3Started{order:3}.isGame4Started{order:4}.isGame5Started{order:5}.isGame6Started{order:6}.isGame7Started{order:7}.isGame8Started{order:8}.isGame9Started{order:9}\n.gcol{display:flex;flex-direction:column;flex:0 0 auto;width:6.4em;background:#1c2f5a;border-left:.3em solid var(--navy)}\n.gcol .hd{background:#13203a;color:#fff}\n.cell{display:flex;align-items:center;justify-content:center;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;font-size:2.2em;height:calc(5.4em / 2.2);color:#dbe4f5}\n/* footer: one match-level banner at a time (warm-up, change of ends, game point, match point) */\n.foot{display:flex;justify-content:center;height:3.4em}\n.foot:not(:has(.bn[style*=\"opacity: 1\"])){display:none}\n.banner{width:20em;height:3.4em}\n.bn{border-radius:.35em;font-size:1.5em;font-weight:900;letter-spacing:.14em;text-transform:uppercase}\n.bn-warm,.bn-break{background:var(--panel);color:#fff;box-shadow:inset 0 0 0 .08em #3b5285}\n.bn-gp,.bn-mp{background:#fff;color:var(--navy)}\n.bn-mp{box-shadow:inset 0 0 0 .2em var(--gold)}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .bn-warm{opacity:0!important}\n/* final: games won is the result; winner row lit with its check after the name, loser readable */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gcol{width:7em;background:var(--gold);color:#111;border-left-color:var(--navy)}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gcol .hd{background:#e8b900;color:#111}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gcol .cell{font-size:4em;height:calc(5.4em / 4);color:inherit}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.row.b,.gcol .b),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.row.a,.gcol .a){color:#a3b2cf}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .gcol .b,.board:has(.isBWinner[style*=\"opacity: 1\"]) .gcol .a{background:#1c2f5a}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .row.a,.board:has(.isBWinner[style*=\"opacity: 1\"]) .row.b{background:#1c3366}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .ph{display:none!important}\n</style>\n</head>\n<body>\n<main class=\"board t-line\" data-osb-component=\"layout\">\n<section class=\"card\" data-osb-component=\"layout\">\n<header class=\"top\"><span class=\"title\"><span class=\"kick\">Table tennis · Line score</span><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"sub\"><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span></span><span class=\"slot state\"><span class=\"plbl\">Pre-match</span><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\"><span class=\"now\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span> in play</span><span class=\"nx\">Game <span class=\"nextGame ng\" data-osb-component=\"field\" data-osb-field=\"nextGame\"></span> next</span></span><span class=\"isComplete fin\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final result</span></span></header>\n<span class=\"tielbl\">Team match</span>\n<div class=\"tiebar\" data-osb-component=\"layout\"><span class=\"tside ta\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span></span><span class=\"tbox\"><i>Tie</i><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span><b>–</b><span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span><span class=\"tside tb\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"></span></div>\n<div class=\"table\" data-osb-component=\"layout\"><div class=\"players\" data-osb-component=\"layout\"><span class=\"hd\">Players</span><div class=\"row rA a\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nmw\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"slot wslot\"><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"></span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">Time-out<b class=\"timeOutTimerA tclock\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded cardk yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded cardk rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></span><span class=\"sv\"><span class=\"slot s2slot isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><span class=\"isSecondServer ss2\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" style=\"opacity:0\" isa=\"true\">2nd</span></span><span class=\"slot srv\"><span class=\"isACurrentlyServing servingA ball\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity:0\" isa=\"true\"></span></span></span></div><div class=\"row rB b\" data-osb-component=\"layout\"><span class=\"jerseyColorB kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"nmw\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"slot wslot\"><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\"></span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isBTimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\">Time-out<b class=\"timeOutTimerB tclock\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span><span class=\"isBTimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"slot card-slot\"><span class=\"isBYellowCarded cardk yc\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isBRedCarded cardk rc\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></span><span class=\"sv\"><span class=\"slot s2slot isDoubles\" data-osb-component=\"field\" data-osb-field=\"isDoubles\" style=\"opacity:0\"><span class=\"isSecondServer ss2\" data-osb-component=\"field\" data-osb-field=\"isSecondServer\" style=\"opacity:0\">2nd</span></span><span class=\"slot srv\"><span class=\"isBCurrentlyServing servingB ball\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"></span></span></span></div></div><div class=\"hist\" data-osb-component=\"layout\"><div class=\"hcol isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"hd hl\">G1</span><span class=\"hc a\"><span class=\"isGame1AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame1BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1BScore gs\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"hcol isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"hd hl\">G2</span><span class=\"hc a\"><span class=\"isGame2AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame2BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2BScore gs\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"hcol isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span cl