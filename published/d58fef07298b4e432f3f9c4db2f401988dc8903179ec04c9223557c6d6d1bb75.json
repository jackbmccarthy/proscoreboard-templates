{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>baseball hinge rail 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#f3eee4}body{font-family:Arial,sans-serif;font-weight:700}.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}.board{width:min(75vw,1440px);container-type:inline-size;display:flex;flex-direction:column;gap:.35cqw;position:relative}.sport{font-size:4.7cqw;line-height:1;letter-spacing:.65cqw;text-align:center;padding:1.65cqw 1cqw;background:#20292a;border-radius:.35cqw}.competitors{display:flex;flex-direction:row;background:#20292a;border-radius:.4cqw;padding:1.5cqw 0;}.competitor{display:flex;min-width:0;flex:1 1 0;flex-direction:column;align-items:center;padding:0 3cqw 1.2cqw;}.competitor+.competitor{border-left:.2cqw solid #b57648}.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5cqw;line-height:1.1;letter-spacing:.25cqw;width:100%;text-align:center;margin-bottom:2cqw;}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.runs{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;}.run-label{font-size:1.85cqw;line-height:1;letter-spacing:.45cqw;margin-bottom:1.4cqw}.tile{position:relative;display:flex;align-items:center;justify-content:center;background:#f3edde;color:#080909;border-radius:.55cqw;border:.35cqw solid #0a1011;}.score-track{width:16.5cqw;height:14cqw}.score{display:block;width:100%;text-align:center;font-size:12.4cqw;font-weight:900;line-height:1;font-variant-numeric:tabular-nums}.tile:before{content:\"\";position:absolute;top:50%;left:0;right:0;height:.12cqw;background:#757568;pointer-events:none}.tab{position:absolute;top:40%;width:.75cqw;height:20%;border-radius:.1cqw;background:#b4774b;box-shadow:inset 0 0 0 .08cqw #c69570}.tab.left{left:-.4cqw}.tab.right{right:-.4cqw}.stats{display:flex;align-items:center;min-height:7.5cqw;background:#20292a;border-radius:.35cqw;padding:1.1cqw 0}.stat{display:flex;align-items:center;justify-content:center;gap:2.8cqw;flex:1 1 0;min-width:0;padding:.1cqw 1cqw;min-height:5.5cqw}.stat+.stat{border-left:.2cqw solid #b57648}.stat-label{font-family:\"Courier New\",monospace;font-size:1.8cqw;line-height:1;letter-spacing:.35cqw;white-space:nowrap}.stat-track{width:5.5cqw;height:5.6cqw;flex:none;background:transparent;color:#f3eee4;border:0;}.stat-number{display:block;width:100%;text-align:center;font-family:\"Courier New\",monospace;font-size:4.2cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.stat-track .tab{width:.45cqw;left:-.25cqw;height:25%;top:37.5%}.stat-track .tab.right{left:auto;right:-.25cqw}.stat-track:before{display:none}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:100%}.stat-label{letter-spacing:.15cqw}.stat{gap:1.8cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><header class=\"sport\" data-osb-static=\"true\">BASEBALL</header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"hidden jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><div class=\"score-track tile\" data-osb-component=\"layout\"><i class=\"tab left\" aria-hidden=\"true\"></i><i class=\"tab right\" aria-hidden=\"true\"></i><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div><div class=\"competitor columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"hidden jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"runs\" data-osb-component=\"layout\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><div class=\"score-track tile\" data-osb-component=\"layout\"><i class=\"tab left\" aria-hidden=\"true\"></i><i class=\"tab right\" aria-hidden=\"true\"></i><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><div class=\"stat-track tile\" data-osb-component=\"layout\"><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><div class=\"stat-track tile\" data-osb-component=\"layout\"><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><div class=\"stat-track tile\" data-osb-component=\"layout\"><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><div class=\"stat-track tile\" data-osb-component=\"layout\"><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
