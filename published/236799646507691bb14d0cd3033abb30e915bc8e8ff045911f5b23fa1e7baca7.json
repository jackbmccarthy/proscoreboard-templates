{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Broadcast Bar</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.osb-core-fields{display:none!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.nm{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance}\n.slab{position:relative;flex:none;overflow:hidden}.slab>.jc{position:absolute;inset:0}\n.slab>.home{position:absolute;left:50%;bottom:.35rem;width:.8rem;height:.82rem;margin-left:-.4rem;background:#fff;clip-path:polygon(0 0,100% 0,100% 58%,50% 100%,0 58%)}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.72)}\n.diamond>.base{position:absolute;width:calc(var(--d,3rem)*.3);height:calc(var(--d,3rem)*.3);transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.08rem);overflow:hidden}\n.diamond>.base.second{left:35%;top:calc(var(--d,3rem)*.082)}.diamond>.base.third{left:10%;top:calc(var(--d,3rem)*.332)}.diamond>.base.first{left:60%;top:calc(var(--d,3rem)*.332)}\n.diamond .runner{position:absolute;inset:0;background:var(--base-on,#f5cf52)}\n.dots{display:flex;gap:var(--dot-gap,.25rem)}\n.dot{position:relative;flex:none;width:var(--dot,.82rem);height:var(--dot,.82rem);border-radius:50%;background:var(--dot-off,rgba(255,255,255,.18))}\n.dot>.lit{position:absolute;inset:0;border-radius:50%;background:var(--dot-on,#f5cf52)}\n.half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.half-dim{position:absolute;inset:0}\n.half-dim::before,.half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.25))}\n.half-dim::before,.half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.half-dim::before,.inningHalf::after{clip-path:polygon(50% 6%,94% 42%,6% 42%)}\n.half-dim::after,.inningHalf::before{clip-path:polygon(6% 58%,94% 58%,50% 94%)}\n.half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inn-n{min-width:1.1em;text-align:left}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.ev{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:.5em;overflow-wrap:normal;word-break:normal;hyphens:none}\n.ev-e:empty,.ev-r:empty{display:none}.ev-e:has(+.ev-r:not(:empty))::after{content:\"\\00b7\";margin-left:.5em;opacity:.75}\n.st{position:relative;display:inline-grid;align-items:center;justify-items:end;white-space:nowrap}\n.st>*{grid-area:1/1}\n.st-pre{opacity:0}.st:has(>.isMatchStarted[style*=\"opacity: 0\"])>.st-pre{opacity:1}\n.st-live-in{display:inline-flex;align-items:center;gap:.4em}.st-live-in>i{flex:none;width:.8rem;height:.8rem;border-radius:50%;background:var(--live,#ff3b30);box-shadow:0 0 .45rem var(--live,#ff3b30);animation:osb-pulse 1.4s ease-in-out infinite}\n@keyframes osb-pulse{50%{opacity:.7}}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .st-pre,.board:has(.isComplete[style*=\"opacity: 1\"]) .st-live-in{visibility:hidden}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ls{display:flex}\n.ls-col{position:relative}\n.ls-extra{display:none!important}.ls-extra:has(>.ls-gate[style*=\"opacity: 1\"]){display:flex!important}\n.ls-gate{display:flex;flex-direction:column;position:relative}\n.ls-c{position:relative;display:flex;align-items:center;justify-content:center}\n.ls-p{position:absolute;width:0;height:0}.ls-c:has(>.ls-p[style*=\"opacity: 0\"])>.ls-v{color:transparent!important}\n.ls-cur{position:absolute;inset:0;pointer-events:none}\n.tick{position:relative}.tick>.tick-on,.tick>.tick-cur{position:absolute;inset:0;border-radius:inherit}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{position:fixed;left:50%;bottom:2.8rem;transform:translateX(-50%);font-family:\"Avenir Next Condensed\",\"Bahnschrift SemiCondensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#f5f7fb;--live:#fff}\n.wrap{display:flex;flex-direction:column;align-items:flex-start;filter:drop-shadow(0 .4rem .9rem rgba(0,0,0,.45))}\n.tab{display:flex;align-items:center;gap:1rem;min-height:1.9rem;padding:.25rem 1rem;background:#d50f2f;color:#fff;border-radius:.35rem .35rem 0 0;font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}\n.tab .sp{padding-right:1rem;border-right:.1rem solid rgba(255,255,255,.45)}\n.bar{display:flex;align-items:stretch;height:4.5rem;background:#0f1726;border-radius:0 .4rem .4rem .4rem;overflow:hidden}\n.team{display:flex;align-items:stretch}\n.team+.team{border-left:.08rem solid rgba(255,255,255,.1)}\n.slab{width:.9rem;background:var(--fb)}.slab-a{--fb:#5e6b80}.slab-b{--fb:#7d8798}\n.slab>.home{bottom:.4rem}\n.nmw{width:19rem;display:flex;align-items:center;padding:0 .4rem 0 1rem}\n.nm{font-weight:700;font-size:1.42rem;line-height:1;text-transform:uppercase;letter-spacing:.01em}\n.batw{flex:none;width:1.6rem;display:flex;align-items:center;justify-content:center}\n.bat{width:.85rem;height:.85rem;border-radius:50%;background:#ffc933}\n.rc{position:relative;flex:none;width:4rem;display:flex;align-items:center;justify-content:center;background:#1d2a42}\n.rc>.win{position:absolute;inset:0;background:#ffc933}\n.runs{position:relative;font:700 2.5rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums}\n.rc:has(>.win[style*=\"opacity: 1\"])>.runs{color:#1d1500}\n.bar:has(.isBWinner[style*=\"opacity: 1\"]) .team-a :is(.nm,.runs,.slab),.bar:has(.isAWinner[style*=\"opacity: 1\"]) .team-b :is(.nm,.runs,.slab){opacity:.45}\n.sit{position:relative;display:flex;align-items:center;gap:1.3rem;padding:0 1.2rem .45rem;background:#09101c;border-left:.08rem solid rgba(255,255,255,.1)}\n\n.inn{display:flex;align-items:center;gap:.2rem;font:700 1.95rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;--half-on:#ffc933;--half-off:rgba(255,255,255,.2);--half-h:1.95rem;--half-size:0.86rem}\n.diamond{--d:3.6rem;--base-edge:#e8edf4;--base-off:rgba(255,255,255,.06);--base-on:#ffc933;--base-line:.14rem}\n.cnt{display:flex;flex-direction:column;align-items:center;gap:.32rem}\n.count{font:700 1.65rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.02em}.count .dash{opacity:.6;margin:0 .08em}\n.bs{display:flex;gap:.5rem;--dot:0.82rem;--dot-gap:.2rem;--dot-off:rgba(255,255,255,.17)}.ball-dots{--dot-on:#4fdc8a}.strike-dots{--dot-on:#ff5a52}\n.outw{display:flex;flex-direction:column;align-items:center;gap:.32rem;--dot:0.9rem;--dot-gap:.3rem;--dot-off:rgba(255,255,255,.17);--dot-on:#ffc933}\n.outs-l{font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.12em;color:#a3afc2}\n.ticks{position:absolute;left:1.2rem;right:1.2rem;bottom:.32rem;display:flex;gap:.2rem}.tick{flex:1;height:.2rem;border-radius:.11rem;background:rgba(255,255,255,.1)}\n.tick>.tick-on{background:rgba(255,255,255,.35)}.tick>.tick-cur{background:#ffc933}\n\n.cover{position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;gap:.6rem;background:#09101c;text-transform:uppercase;text-align:center;white-space:nowrap}\n.cover b{font:700 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.16em;color:#a3afc2}\n.cover .pl{font:700 1.6rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.05em;color:#f5f7fb}\n.cover.fin{font:700 1.76rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",Arial,sans-serif;letter-spacing:.14em;color:#ffc933}\n</style></head><body><main class=\"board\" aria-label=\"Baseball lower-third scoreboard\">\n<div class=\"wrap columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"tab\"><span class=\"ev\"><span class=\"ev-e eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span><span class=\"st\"><span class=\"st-pre\">PREGAME</span><span class=\"st-live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0\"><span class=\"st-live-in\"><i></i>LIVE</span></span></span></div>\n<div class=\"bar rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"baseball score bar\"><div class=\"team team-a\"><span class=\"slab slab-a\"><span class=\"jc jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"home isAHome\" data-osb-component=\"field\" data-osb-field=\"isAHome\" style=\"opacity: 0\"></span></span><span class=\"nmw\"><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"batw\"><span class=\"bat isABatting\" data-osb-component=\"field\" data-osb-field=\"isABatting\" style=\"opacity: 0\"></span></span><span class=\"rc\"><span class=\"win isAWinner\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity: 0\"></span><span class=\"runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span></div><div class=\"team team-b\"><span class=\"slab slab-b\"><span class=\"jc jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"home isBHome\" data-osb-component=\"field\" data-osb-field=\"isBHome\" style=\"opacity: 0\"></span></span><span class=\"nmw\"><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span><span class=\"batw\"><span class=\"bat isBBatting\" data-osb-component=\"field\" data-osb-field=\"isBBatting\" style=\"opacity: 0\"></span></span><span class=\"rc\"><span class=\"win isBWinner\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity: 0\"></span><span class=\"runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></div><div class=\"sit\"><span class=\"inn\"><span class=\"half\" aria-hidden=\"true\"><span class=\"half-dim\"></span><span class=\"half-win\"><span class=\"inningHalf\" data-osb-component=\"field\"></span></span></span><span class=\"inn-n inning\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"diamond\" aria-label=\"Bases\"><span class=\"base second\"><span class=\"runner isRunnerOnSecond\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnSecond\" style=\"opacity: 0\"></span></span><span class=\"base third\"><span class=\"runner isRunnerOnThird\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnThird\" style=\"opacity: 0\"></span></span><span class=\"base first\"><span class=\"runner isRunnerOnFirst\" data-osb-component=\"field\" data-osb-field=\"isRunnerOnFirst\" style=\"opacity: 0\"></span></span></span><span class=\"cnt\"><span class=\"count\"><span class=\"cb balls\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span><span class=\"dash\" aria-hidden=\"true\">-</span><span class=\"cs strikes\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"bs\"><span class=\"dots ball-dots\"><span class=\"dot\"><span class=\"lit isBall1\" data-osb-component=\"field\" data-osb-field=\"isBall1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall2\" data-osb-component=\"field\" data-osb-field=\"isBall2\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isBall3\" data-osb-component=\"field\" data-osb-field=\"isBall3\" style=\"opacity: 0\"></span></span></span><span class=\"dots strike-dots\"><span class=\"dot\"><span class=\"lit isStrike1\" data-osb-component=\"field\" data-osb-field=\"isStrike1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isStrike2\" data-osb-component=\"field\" data-osb-field=\"isStrike2\" style=\"opacity: 0\"></span></span></span></span></span><span class=\"outw\"><span class=\"dots out-dots\"><span class=\"dot\"><span class=\"lit isOut1\" data-osb-component=\"field\" data-osb-field=\"isOut1\" style=\"opacity: 0\"></span></span><span class=\"dot\"><span class=\"lit isOut2\" data-osb-component=\"field\" data-osb-field=\"isOut2\" style=\"opacity: 0\"></span></span></span><span class=\"outs-l\">OUT</span></span><span class=\"ticks\" aria-label=\"Innings\"><span class=\"tick\"><span class=\"tick-on isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning1Current\" data-osb-component=\"field\" data-osb-field=\"isInning1Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning2Current\" data-osb-component=\"field\" data-osb-field=\"isInning2Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning3Current\" data-osb-component=\"field\" data-osb-field=\"isInning3Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning4Current\" data-osb-component=\"field\" data-osb-field=\"isInning4Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning5Current\" data-osb-component=\"field\" data-osb-field=\"isInning5Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning6Current\" data-osb-component=\"field\" data-osb-field=\"isInning6Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning7Current\" data-osb-component=\"field\" data-osb-field=\"isInning7Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame8Started\" data-osb-component=\"field\" data-osb-field=\"isGame8Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning8Current\" data-osb-component=\"field\" data-osb-field=\"isInning8Current\" style=\"opacity: 0\"></span></span><span class=\"tick\"><span class=\"tick-on isGame9Started\" data-osb-component=\"field\" data-osb-field=\"isGame9Started\" style=\"opacity: 0\"></span><span class=\"tick-cur isInning9Current\" data-osb-component=\"field\" data-osb-field=\"isInning9Current\" style=\"opacity: 0\"></span></span></span><span class=\"cover brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0\"><b>End of</b><span class=\"pl periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\"></span></span><span class=\"cover fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0\"><span>Final</span></span></div></div>\n</div>\n<span class=\"sr\"><span class=\"battingSide\" data-osb-component=\"field\" data-osb-field=\"battingSide\"></span><span class=\"bases\" data-osb-component=\"field\" data-osb-field=\"bases\"></span><span class=\"outs\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span><span class=\"hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span><span class=\"hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span><span class=\"errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></span><span class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></span></span>\n</main></body></html>\n","css":""}
