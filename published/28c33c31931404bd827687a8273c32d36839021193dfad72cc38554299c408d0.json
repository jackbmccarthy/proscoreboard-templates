{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Lower Third — Head to Head</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\n.stage{position:fixed;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:0 0 5.5vh;pointer-events:none}\n.board{font-size:1.3vw;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;width:max-content;-webkit-font-smoothing:antialiased}\n.grid{display:grid;grid-template-columns:18em 4.7em 1.1em 4.7em 18em;grid-template-rows:auto 3.5em 2.1em auto;filter:drop-shadow(0 .4em 1em rgba(0,0,0,.5))}\n.top{grid-column:1 / span 3;grid-row:1;justify-self:start;max-width:100%!important;overflow:hidden;display:flex;align-items:center;height:1.8em;padding:0 1em;border-radius:.3em .3em 0 0;background:#d7ff3a;color:#062a33;font-size:1em;font-weight:800;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}\n.top:not(:has(.meta>:not(.sep):not(:empty))):not(:has(.teamlbl)){display:none}\n.teamlbl{display:none}\n.top:not(:has(.meta>:not(.sep):not(:empty))) .teamlbl{display:inline}\n.board:not(:has(.tname:not(:empty))) .top:not(:has(.meta>:not(.sep):not(:empty))){visibility:hidden}\n.plate{grid-row:2;display:flex;align-items:center;gap:.55em;min-width:0;background:#062a33}\n.pA{grid-column:1;padding-right:.6em;border-radius:.3em 0 0 0}\n.pB{grid-column:5;flex-direction:row-reverse;padding-left:.6em;border-radius:0 .3em 0 0}\n.kit{flex:0 0 .45em;align-self:stretch;background:#5d7780}\n.pA .kit{border-radius:.3em 0 0 0}.pB .kit{border-radius:0 .3em 0 0}\n.flag{flex:0 0 auto;width:1.9em;height:1.27em;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.3)}\n.who{display:flex;flex-direction:column;justify-content:center;flex:0 1 auto;min-width:0}\n.pA .flag{margin-left:auto}.pB .flag{margin-right:auto}\n.pA:has(.flag:not([src])) .who{margin-left:auto}.pB:has(.flag:not([src])) .who{margin-right:auto}\n.pB .who{align-items:flex-end;text-align:right}\n.name{font-size:1.32em;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;hyphens:none}\n.team{display:flex;align-items:center;gap:.4em;font-size:1em;font-weight:700;text-transform:uppercase;color:#9fc3cb}\n.pB .team{flex-direction:row-reverse}\n.tlogo{width:1.3em;height:1.3em;object-fit:contain;flex:0 0 auto}\n.tname{line-height:1.05}\n.team:not(:has(.tname:not(:empty))){display:none}\n.who:has(.name:empty) .team{font-size:1.2em;color:#fff}\n.srv{width:1.45em;height:1.45em}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff9a3c 45%,#d65f00 100%);box-shadow:0 0 0 .12em rgba(0,0,0,.3)}\n.win{border-radius:50%;background:#d7ff3a}\n.win::after{content:\"\";width:.36em;height:.66em;margin-top:-.14em;border:solid #062a33;border-width:0 .17em .17em 0;transform:rotate(45deg)}\n.pt{grid-row:2;display:flex;align-items:center;justify-content:center;background:#fff;color:#062a33;font-size:2.3em;font-weight:800;font-variant-numeric:tabular-nums;line-height:1}\n.pA{}.pt.pA{grid-column:2}.pt.pB{grid-column:4}\n.colon{grid-column:3;grid-row:2;display:flex;align-items:center;justify-content:center;background:#fff;color:#8fb0b8;font-size:1.8em;font-weight:800;padding-bottom:.12em}\n.sub{grid-row:3;display:flex;align-items:center;gap:.3em;padding:0 .7em;background:#0b3d48}\n.sA{grid-column:1;border-radius:0 0 0 .3em}\n.sB{grid-column:5;flex-direction:row-reverse;border-radius:0 0 .3em 0}\n.to-slot{width:5.2em;height:1.45em}\n.to-on,.to-used{border-radius:.2em;font-size:1em;font-weight:800;letter-spacing:.04em;text-transform:uppercase}\n.to-on{background:#ffd23f;color:#111}\n.to-used{box-shadow:inset 0 0 0 .1em #4e7c86;color:#9fc3cb}\n.card-slot{width:.9em;height:1.3em}\n.card{border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.3)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.tie{display:none;align-items:center;gap:.3em;flex:0 0 auto;height:1.35em;padding:0 .5em;border-radius:.2em;background:#d7ff3a;color:#062a33;font-size:1em;font-weight:800;letter-spacing:.06em;text-transform:uppercase}\n.board:has(.tname:not(:empty)) .tie{display:inline-flex}\n.gw{grid-row:3;display:flex;align-items:center;gap:.45em;padding:0 .7em;font-weight:800;text-transform:uppercase;z-index:1}\n.gw i{font-style:normal;font-size:1em;letter-spacing:.1em;color:#9fc3cb}\n.gn{display:inline-flex;align-items:center;justify-content:center;min-width:1.5em;height:1.5em;border-radius:.2em;background:#d7ff3a;color:#062a33;font-size:1.15em;font-variant-numeric:tabular-nums}\n.gA{grid-column:1;justify-self:end}\n.gB{grid-column:5;justify-self:start;flex-direction:row-reverse}\n.mid{grid-column:2 / span 3;grid-row:3;width:auto;height:2.1em;background:#062a33}\n.mid>*{font-size:1em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.gtag{background:#062a33;color:#fff}\n.fin{background:#d7ff3a;color:#062a33}\n.st-warm,.st-break{background:#062a33;color:#d7ff3a;box-shadow:inset 0 0 0 .1em #d7ff3a}\n.pstate{grid-column:4 / span 2;grid-row:1;justify-self:start;width:11em;height:1.8em;z-index:2}\n.pstate>*{border-radius:.3em .3em 0 0;font-size:1em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.st-gp{background:#ff9a3c;color:#111}\n.st-mp{background:#e3262f;color:#fff}\n.hist{grid-column:1 / -1;grid-row:4;justify-self:center;position:relative;display:flex;gap:.25em;padding-top:.3em}\n.hcol{display:flex;align-items:center;gap:.3em;height:1.8em;padding:0 .55em;border-radius:.25em;background:rgba(6,42,51,.92);font-weight:800;font-variant-numeric:tabular-nums}\n.hl{color:#9fc3cb;letter-spacing:.06em}\n.hc{position:relative;display:flex;align-items:center;justify-content:center;min-width:1.5em;height:1.4em;color:#7fa2aa}\n.hc .won{inset:0;border-radius:.2em;background:#d7ff3a}\n.hc:has(.won[style*=\"opacity: 1\"]){color:#062a33}\n.hcol:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;white-space:nowrap;padding:0!important;margin:0!important;border:0!important}\n/* final: games won take the points box; the loser's side steps back */\n.board:has(.isComplete[style*=\"opacity: 1\"]) .pt{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{grid-row:2;justify-self:stretch;justify-content:center;padding:0;background:#fff}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw i{display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gA{grid-column:2}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gB{grid-column:4}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{background:none;font-size:2.3em;min-width:0;height:auto}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.plate.b,.sub.b),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.plate.a,.sub.a){background:#0d2328;color:#86a1a7}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .plate.b .flag,.board:has(.isBWinner[style*=\"opacity: 1\"]) .plate.a .flag{opacity:.5}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .gB .gn,.board:has(.isBWinner[style*=\"opacity: 1\"]) .gA .gn{color:#9bb3b8}\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-h2h\" data-osb-component=\"layout\"><div class=\"grid\" data-osb-component=\"layout\"><span class=\"top\"><span class=\"meta\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep s1\">·</i><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep s2\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span><span class=\"teamlbl\">Team match</span></span><div class=\"plate pA a\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"who\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tie\">Tie <span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span></span><span class=\"slot srv\"><span class=\"isACurrentlyServing servingA ball\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity:0\" isa=\"true\"></span><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\"></span></span></div><span class=\"pt pA a\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"colon\">:</span><span class=\"pt pB b\"><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><div class=\"plate pB b\" data-osb-component=\"layout\"><span class=\"jerseyColorB kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"who\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"team\"><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><span class=\"tie\">Tie <span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span></span></span><span class=\"slot srv\"><span class=\"isBCurrentlyServing servingB ball\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"></span><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\"></span></span></div><div class=\"sub sA a\" data-osb-component=\"layout\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">Time-out</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></div><span class=\"gw gA a\"><i>Games</i><span class=\"currentAMatchScore AScore gn\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"slot mid\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\"><span class=\"now\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"nx\">Game <span class=\"nextGame ng\" data-osb-component=\"field\" data-osb-field=\"nextGame\"></span></span></span><span class=\"isComplete fin\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span></span><span class=\"gw gB b\"><i>Games</i><span class=\"currentBMatchScore BScore gn\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span><div class=\"sub sB b\" data-osb-component=\"layout\"><span class=\"slot to-slot\"><span class=\"isBTimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\">Time-out</span><span class=\"isBTimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"opacity:0\">T/O used</span></span><span class=\"slot card-slot\"><span class=\"isBYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isBRedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></div><span class=\"slot pstate\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span><div class=\"hist\" data-osb-component=\"layout\"><div class=\"hcol isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"hl\">G1</span><span class=\"hc a\"><span class=\"isGame1AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame1BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1BScore gs\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"hcol isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"hl\">G2</span><span class=\"hc a\"><span class=\"isGame2AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame2BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2BScore gs\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"hcol isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"hl\">G3</span><span class=\"hc a\"><span class=\"isGame3AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></span><span class=\"game3AScore gs\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame3BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></span><span class=\"game3BScore gs\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"hcol isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"hl\">G4</span><span class=\"hc a\"><span class=\"isGame4AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame4AWon\" style=\"opacity:0\"></span><span class=\"game4AScore gs\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame4BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame4BWon\" style=\"opacity:0\"></span><span class=\"game4BScore gs\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"hcol isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"hl\">G5</span><span class=\"hc a\"><span class=\"isGame5AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame5AWon\" style=\"opacity:0\"></span><span class=\"game5AScore gs\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame5BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame5BWon\" style=\"opacity:0\"></span><span class=\"game5BScore gs\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"hcol isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"hl\">G6</span><span class=\"hc a\"><span class=\"isGame6AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame6AWon\" style=\"opacity:0\"></span><span class=\"game6AScore gs\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame6BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame6BWon\" style=\"opacity:0\"></span><span class=\"game6BScore gs\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"hcol isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"hl\">G7</span><span class=\"hc a\"><span class=\"isGame7AWon won\" data-osb-component=\"field\" data-osb-field=\"isGame7AWon\" style=\"opacity:0\"></span><span class=\"game7AScore gs\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"hc b\"><span class=\"isGame7BWon won\" data-osb-component=\"field\" data-osb-field=\"isGame7BWon\" style=\"opacity:0\"></span><span class=\"game7BScore gs\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div></div></div></article></main>\n</body>\n</html>\n","css":""}
