{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Staircase Stencil Volleyball — Alternating Rows</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f4eddf; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { box-sizing: content-box; container-type: inline-size; width: min(calc(100% - 8vw), 1100px, calc((100vh - 48px) * 1.02)); padding-inline: 4vw; min-width: 0; display: flex; flex-direction: column; background: transparent; }\n.title { font-size: 4.2cqw; font-weight: 700; line-height: 1.2; text-align: center; letter-spacing: .25em; padding-left: .25em; margin-bottom: 3.5cqw; }\n.teams { display: flex; flex-direction: column; min-width: 0; gap: 5cqw; }\n.team { display: flex; align-items: center; min-width: 0; height: 37cqw; }\n.name-color { display: block; flex: 1 1 0; min-width: 0; margin-left: 3cqw; background-color: #d87551; background-clip: text; -webkit-background-clip: text; }\n.team-b .name-color { margin-left: 4.5cqw; text-align: right; }\n.name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14cqw; font-weight: 800; line-height: 1; color: transparent; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-group { display: flex; align-items: flex-end; flex: 0 0 44cqw; min-width: 0; }\n.register { display: flex; align-items: center; min-width: 0; flex: 0 0 14cqw; margin-right: -10cqw; gap: 1.3cqw; padding-bottom: .1cqw; font-size: 3.2cqw; font-weight: 700; line-height: 1; }\n.match-score { display: block; width: 3.6cqw; min-width: 0; text-align: center; font-variant-numeric: tabular-nums; }\n.primary-track { display: flex; flex-direction: column; align-items: center; flex: 0 0 48cqw; min-width: 0; margin-left: -4cqw; margin-right: -4cqw; }\n.primary-score { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 30cqw; font-family: \"Arial Black\", Arial, sans-serif; font-size: 35.8cqw; font-weight: 900; line-height: 1; letter-spacing: normal; font-variant-numeric: tabular-nums; mask-image: linear-gradient(to bottom, #000 0 32%, transparent 32% 36%, #000 36% 66%, transparent 66% 70%, #000 70% 100%); -webkit-mask-image: linear-gradient(to bottom, #000 0 32%, transparent 32% 36%, #000 36% 66%, transparent 66% 70%, #000 70% 100%); }\n.points-label { display: block; margin-top: .6cqw; text-align: center; font-size: 3.6cqw; font-weight: 700; line-height: 1; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-width: 0; gap: 2cqw; margin-top: 5cqw; font-size: 4cqw; font-weight: 700; line-height: 1; letter-spacing: .08em; }\n.set-value { display: block; width: 4.5cqw; min-width: 0; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .title { font-size: 23px; margin-bottom: 27px; letter-spacing: .13em; }\n  .name-color { margin-left: 5px; }\n  .name { font-size: 34px; }\n  .register { font-size: 12px; gap: 3px; }\n  .match-score { width: 13px; }\n  .points-label { font-size: 13px; }\n  .teams { gap: 35px; }\n  .set-footer { font-size: 22px; gap: 8px; margin-top: 27px; }\n  .set-value { width: 24px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-color jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-group rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"register rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div></div>\n        <div class=\"team team-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-group rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"register rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"points-label\">POINTS</span></div></div><div class=\"name-color jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
