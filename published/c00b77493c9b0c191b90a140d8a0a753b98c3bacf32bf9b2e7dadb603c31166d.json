{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Half Time Report</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { display: flex; align-items: center; justify-content: center; width: 100vw; height: 100vh; font-family: \"Avenir Next\", \"Helvetica Neue\", Arial, sans-serif; }\n    .osb { position: relative; width: 1100px; border-radius: 14px; overflow: hidden; background: #f4f1ea; color: #15181d; box-shadow: 0 20px 50px #000c; }\n    .top { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 20px; padding: 24px 40px; background: #15181d; color: #fff; }\n    .ev { display: flex; flex-direction: column; gap: 4px; }\n    .ev .eventName { font-size: 30px; font-weight: 700; }\n    .ev .matchRound { font-size: 16px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #f5b82e; }\n    .status { display: grid; min-width: 280px; height: 60px; border-radius: 8px; overflow: hidden; background: #262a31; }\n    .status > * { grid-area: 1 / 1; }\n    .live { position: relative; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 0 16px; }\n    .dot { width: 10px; height: 10px; color: #ff4b4b; }\n    .per { font-size: 17px; font-weight: 800; letter-spacing: 1px; color: #f5b82e; }\n    .gc { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 34px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .add { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 20px; font-weight: 700; color: #15181d; background: #f5b82e; padding: 1px 7px; border-radius: 4px; }\n    .runbar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #f5b82e; }\n    .mp { display: flex; gap: 3px; }\n    .h { position: relative; width: 14px; height: 4px; background: #4a505b; }\n    .h > span { position: absolute; inset: 0; background: #f5b82e; }\n    .et { width: 7px; height: 4px; background: #fff; }\n    .state { z-index: 1; display: flex; align-items: center; justify-content: center; gap: 12px; line-height: 1; background: #f5b82e; color: #15181d; }\n    .st-b { font-size: 26px; font-weight: 800; letter-spacing: 3px; }\n    .b-ht { font-size: 0; } .b-ht::after { content: \"HALF TIME\"; font-size: 24px; }\n    .pens { z-index: 2; background: #fff; }\n    .st-s { font-size: 17px; font-weight: 800; letter-spacing: 3px; }\n    .st-v { font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 32px; font-weight: 700; }\n    .st-v b { padding: 0 5px; }\n    .fin { z-index: 3; background: #e5322d; color: #fff; }\n    .fin .st-b { font-size: 0; } .fin .st-b::after { content: \"FULL TIME\"; font-size: 24px; letter-spacing: 4px; }\n    .head { display: grid; grid-template-columns: 1fr 220px 1fr; align-items: center; padding: 26px 40px 20px; border-bottom: 2px solid #ddd6c8; }\n    .tm { display: flex; align-items: center; gap: 16px; min-width: 0; }\n    .tm.B { flex-direction: row-reverse; text-align: right; }\n    .kit { flex: 0 0 auto; width: 14px; height: 64px; border-radius: 3px; background-color: #59616e; }\n    .nm { min-width: 0; font-family: \"Avenir Next Condensed\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 40px; font-weight: 700; line-height: 1; text-transform: uppercase; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }\n    .score { display: flex; align-items: center; justify-content: center; gap: 16px; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 92px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n    .score b { font-size: 50px; color: #b5ad9c; }\n    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; padding: 20px 40px 30px; }\n    h3 { margin: 0 0 10px; font-size: 14px; font-weight: 800; letter-spacing: 3px; color: #8a8270; }\n    table { width: 100%; border-collapse: collapse; }\n    th, td { height: 48px; border-bottom: 1px solid #e3ddd0; }\n    th { text-align: left; font-size: 18px; font-weight: 700; color: #3d4048; }\n    td { width: 110px; text-align: center; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    td .v { justify-content: center; }\n    .nd { color: #c2baa8; }\n    td:has(.v[style*=\"opacity: 1\"]) .nd { display: none; }\n    .pr.p3:not(:has(.v[style*=\"opacity: 1\"])), .pr.p4:not(:has(.v[style*=\"opacity: 1\"])) { display: none; }\n    thead th { height: 32px; font-size: 13px; font-weight: 800; letter-spacing: 2px; color: #8a8270; text-align: center; }\n    thead th:first-child { text-align: left; }\n    .sw { display: inline-block; width: 44px; height: 8px; border-radius: 2px; background-color: #59616e; }\n    .disc td .cell { display: flex; align-items: center; justify-content: center; gap: 8px; }\n    .disc td b { font-size: 30px; }\n    .yc, .rc { width: 22px !important; margin: 0 !important; }\n    \n    .cards { display: flex; gap: 4px; flex: 0 0 auto; }\n    .yc, .rc { display: flex; align-items: center; justify-content: center; width: 22px; height: 30px; border-radius: 2px; font-family: \"DIN Alternate\", \"Roboto Condensed\", \"Arial Narrow\", Arial, sans-serif; font-size: 19px; font-weight: 700; line-height: 1; box-shadow: 0 1px 2px #0006; }\n    .yc { background: #ffd21f; color: #2a2300; }\n    .rc { background: #e3262e; color: #fff; }\n    .yc[style*=\"opacity: 0\"], .rc[style*=\"opacity: 0\"] { width: 0; margin-left: -4px; }\n    .brk .b-ft, .brk .b-eh, .brk .b-aet { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]) .brk .b-ht { display: none; }\n    .osb:has(.isGame2Started[style*=\"opacity: 1\"]):not(:has(.isGame3Started[style*=\"opacity: 1\"])) .brk .b-ft { display: inline; }\n    .osb:has(.isGame3Started[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .brk .b-eh { display: inline; }\n    .osb:has(.isGame4Started[style*=\"opacity: 1\"]) .brk .b-aet { display: inline; }\n    .osb:has(.isGame3Started[style*=\"opacity: 1\"]) .brk .b-ft { display: none; }\n    .add-v:empty::before { content: \"+0\"; }\n    .dot i { display: block; width: 100%; height: 100%; border-radius: 50%; background: currentColor; animation: osb-pulse 1.6s ease-in-out infinite; }\n    @keyframes osb-pulse { 50% { transform: scale(.55); } }\n    .osb:has(.isComplete[style*=\"opacity: 1\"]) .dot i { animation: none; }\n    .osb-aux { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    .ev:not(:has(.eventName:not(:empty))):not(:has(.matchRound:not(:empty))) { display: none; }\n    .ev-sep { display: none; }\n    .ev:has(.eventName:not(:empty)):has(.matchRound:not(:empty)) .ev-sep { display: inline; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.fpens{white-space:nowrap}\n.fpens:not([style*=\"opacity: 1\"]){display:none}\n.fin:has(.isDecidedOnPenalties[style*=\"opacity: 1\"]) .st-b::after{content:none}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.st-b,.grid>div>h3,.grid>div>table>thead>tr>th{font-size:16px!important}\n.dot.isMatchStarted>i,.et.isGame3Started,.et.isGame4Started{width:12px!important;height:12px!important;min-width:0!important;flex-shrink:0!important}\n/* end stream-size floor */\n\n  </style>\n</head>\n<body>\n<article class=\"osb\" aria-label=\"Soccer match report\">\n  <div class=\"top\">\n    <div class=\"ev\"><span class=\"ev-n eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-r matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div>\n    <div class=\"status\">\n      <div class=\"live\"><span class=\"dot isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0;\"><i></i></span><span class=\"per periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"half\"></span><span class=\"gc\"><span class=\"clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b>:</b><span class=\"clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"add addedTimeVisible\" data-osb-component=\"field\" data-osb-field=\"addedTimeVisible\" style=\"opacity: 0;\"><span class=\"add-v addedTime\" data-osb-component=\"field\" data-osb-field=\"addedTime\"></span></span><span class=\"mp\"><span class=\"h\"><span class=\"isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"h\"><span class=\"isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"et isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"></span><span class=\"et isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"></span></span><span class=\"runbar isGameClockRunning\" data-osb-component=\"field\" data-osb-field=\"isGameClockRunning\" style=\"opacity: 0;\"></span></div>\n      <div class=\"state brk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\"><span class=\"st-b b-ht\">HT</span><span class=\"st-b b-ft\">FT</span><span class=\"st-b b-eh\">ET HT</span><span class=\"st-b b-aet\">AET</span></div>\n      <div class=\"state pens isShootoutActive\" data-osb-component=\"field\" data-osb-field=\"isShootoutActive\" style=\"opacity: 0;\"><span class=\"st-s\">PENS</span><span class=\"st-v\"><span class=\"shootoutAScore\" data-osb-component=\"field\" data-osb-field=\"shootoutAScore\">0</span><b>-</b><span class=\"shootoutBScore\" data-osb-component=\"field\" data-osb-field=\"shootoutBScore\">0</span></span></div>\n      <div class=\"state fin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity: 0;\"><span class=\"st-b\">FT<span class=\"isDecidedOnPenalties fpens\" data-osb-component=\"field\" data-osb-field=\"isDecidedOnPenalties\" style=\"opacity:0\"> (<span class=\"shootoutAScore\" data-osb-component=\"field\" data-osb-field=\"shootoutAScore\">0</span>-<span class=\"shootoutBScore\" data-osb-component=\"field\" data-osb-field=\"shootoutBScore\">0</span> PENS)</span></span></div>\n    </div>\n  </div>\n  <div class=\"head\">\n    <div class=\"tm A\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div>\n    <div class=\"score\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><b>-</b><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n    <div class=\"tm B\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div>\n  </div>\n  <div class=\"grid\">\n    <div><h3>GOALS BY PERIOD</h3><table><thead><tr><th>PERIOD</th><th><span class=\"sw jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></th><th><span class=\"sw jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></th></tr></thead><tbody><tr class=\"pr p1\"><th>1st half</th><td><span class=\"nd\">&ndash;</span><span class=\"v isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"><span class=\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span></td><td><span class=\"nd\">&ndash;</span><span class=\"v isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display: none; opacity: 0;\"><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></td></tr><tr class=\"pr p2\"><th>2nd half</th><td><span class=\"nd\">&ndash;</span><span class=\"v isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span></td><td><span class=\"nd\">&ndash;</span><span class=\"v isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display: none; opacity: 0;\"><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></td></tr><tr class=\"pr p3\"><th>Extra time 1</th><td><span class=\"nd\">&ndash;</span><span class=\"v isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span></td><td><span class=\"nd\">&ndash;</span><span class=\"v isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display: none; opacity: 0;\"><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></td></tr><tr class=\"pr p4\"><th>Extra time 2</th><td><span class=\"nd\">&ndash;</span><span class=\"v isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span></td><td><span class=\"nd\">&ndash;</span><span class=\"v isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display: none; opacity: 0;\"><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></td></tr></tbody></table></div>\n    <div><h3>DISCIPLINE &amp; FOULS</h3><table class=\"disc\"><thead><tr><th>&nbsp;</th><th><span class=\"sw jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></th><th><span class=\"sw jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></th></tr></thead><tbody>\n      <tr><th>Yellow cards</th><td><span class=\"cell\"><span class=\"yc isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity: 0;\"></span><b class=\"yellowCardsA\" data-osb-component=\"field\" data-osb-field=\"yellowCardsA\"></b></span></td><td><span class=\"cell\"><span class=\"yc isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity: 0;\"></span><b class=\"yellowCardsB\" data-osb-component=\"field\" data-osb-field=\"yellowCardsB\"></b></span></td></tr>\n      <tr><th>Red cards</th><td><span class=\"cell\"><span class=\"rc isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity: 0;\"></span><b class=\"redCardsA\" data-osb-component=\"field\" data-osb-field=\"redCardsA\"></b></span></td><td><span class=\"cell\"><span class=\"rc isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity: 0;\"></span><b class=\"redCardsB\" data-osb-component=\"field\" data-osb-field=\"redCardsB\"></b></span></td></tr>\n      <tr><th>Fouls</th><td><b class=\"teamFoulsA\" data-osb-component=\"field\" data-osb-field=\"teamFoulsA\">0</b></td><td><b class=\"teamFoulsB\" data-osb-component=\"field\" data-osb-field=\"teamFoulsB\">0</b></td></tr>\n    </tbody></table></div>\n  </div>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"homeSide\" data-osb-component=\"field\" data-osb-field=\"homeSide\"></span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
