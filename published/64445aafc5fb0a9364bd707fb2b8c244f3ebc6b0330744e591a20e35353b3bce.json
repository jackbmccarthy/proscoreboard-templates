{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Pewter Columnhead 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.shell{width:min(92vw,1030px);max-width:100%;container-type:inline-size;color:#25343a}\n.header{display:flex;height:54px;align-items:stretch;min-width:0}\n.header-name{display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.sport-tab{display:flex;align-items:center;justify-content:center;width:255px;max-width:58%;background:#25343a;color:#f5f7f4;border-radius:4px 4px 0 0;font-size:clamp(15px,3cqw,30px);font-weight:800;line-height:1;white-space:nowrap}\n.columnhead{display:flex;align-items:center;justify-content:center;flex:0 0 21.5%;min-width:0;background:#25343a;color:#f5f7f4;border:1px solid #8da1a5;border-bottom:0;font-size:clamp(11px,2.8cqw,29px);font-weight:800;line-height:1;white-space:nowrap}\n.columnhead:first-of-type{border-radius:4px 0 0 0}\n.columnhead:last-child{border-radius:0 4px 0 0}\n.board{display:flex;flex-direction:column;width:100%;height:232px;overflow:hidden;border-radius:0 0 4px 4px;background:#dfe6e5}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0;min-width:0}\n.team+.team{border-top:1px solid #314a54}\n.name-zone{display:flex;align-items:center;flex:1 1 0;min-width:0;background:#dfe6e5}\n.identity{display:block;flex:0 0 16px;align-self:stretch;background:#1368c4}\n.jerseyColorB{background:#e11d32}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;padding:0 30px;color:#25343a;font-size:clamp(18px,6.5cqw,67px);font-weight:750;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.sets,.points{display:flex;align-items:center;justify-content:center;flex:0 0 21.5%;min-width:0;border-left:1px solid #8da1a5;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sets{background:#cbd8da;color:#25343a;font-size:clamp(28px,8.2cqw,84px);font-weight:750}\n.points{background:#bccdd0;color:#25343a;font-size:clamp(29px,8.7cqw,90px);font-weight:800}\n.set-score,.point-score{display:block;min-width:0;max-width:100%;overflow:hidden;font-variant-numeric:tabular-nums;line-height:1}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:8px}\n .shell{width:100%}\n .header{height:27px}\n .sport-tab{width:130px;font-size:12px}\n .columnhead{font-size:11px}\n .board{height:150px}\n .identity{flex-basis:6px}\n .name{padding:0 8px;font-size:clamp(15px,5cqw,20px)}\n .sets,.points{font-size:clamp(30px,8cqw,38px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <div class=\"shell columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"header-name\" data-osb-component=\"layout\"><span class=\"sport-tab sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span></div>\n   <span class=\"columnhead\" data-osb-component=\"text\">SETS</span><span class=\"columnhead\" data-osb-component=\"text\">POINTS</span>\n  </div>\n  <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard, generic manual scoring\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <div class=\"name-zone rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div>\n    <div class=\"sets\" data-osb-component=\"layout\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n    <div class=\"points\" data-osb-component=\"layout\"><span class=\"point-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n   </div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <div class=\"name-zone rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div>\n    <div class=\"sets\" data-osb-component=\"layout\"><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n    <div class=\"points\" data-osb-component=\"layout\"><span class=\"point-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n   </div>\n  </article>\n  <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n </div>\n</main>\n</body>\n</html>\n","css":""}
