{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Wire Numeral Volleyball — Duel</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { color: #fff; font-family: Arial, Helvetica, sans-serif; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 1000px; display: flex; flex-direction: column; background: transparent; }\n.title { text-align: center; font-size: 70px; font-weight: 700; letter-spacing: .15em; padding-left: .15em; line-height: 1; margin-bottom: 47px; }\n.duel { display: flex; gap: 200px; }\n.team { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; }\n.primary-score { display: block; width: 100%; height: 315px; color: transparent; -webkit-text-stroke: 6px #86f4f3; font-family: \"Arial Black\", Arial, sans-serif; font-size: 320px; font-weight: 900; line-height: .84; text-align: center; letter-spacing: -.07em; font-variant-numeric: tabular-nums; transform: scaleY(1.25); transform-origin: center; }\n.label { font-size: 34px; font-weight: 600; letter-spacing: .17em; line-height: 1; }\n.points-label { margin-top: 16px; }\n.name { display: block; width: 100%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; font-size: 74px; font-weight: 700; line-height: 1; margin-top: 19px; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.identity-rule { width: 163px; max-width: 70%; height: 9px; flex: 0 0 9px; background: #86f4f3; margin-top: 22px; margin-bottom: 24px; }\n.match-score { display: block; width: 100%; height: 60px; text-align: center; font-size: 58px; line-height: 1; font-weight: 700; margin-top: 7px; font-variant-numeric: tabular-nums; }\n.set-footer { display: flex; flex-direction: column; align-items: center; margin-top: 30px; gap: 5px; font-size: 34px; font-weight: 600; line-height: 1; letter-spacing: .13em; }\n.set-value { display: block; width: 80px; font-size: 70px; line-height: 1; text-align: center; font-weight: 700; letter-spacing: 0; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1050px) {\n  .title { font-size: clamp(30px, 6.8vw, 70px); }\n  .duel { gap: 15vw; }\n  .primary-score { font-size: clamp(90px, 30vw, 320px); }\n  .name { font-size: clamp(26px, 6.9vw, 74px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .title { font-size: 29px; letter-spacing: .1em; margin-bottom: 30px; }\n  .duel { gap: 28px; }\n  .primary-score { height: 138px; font-size: 128px; -webkit-text-stroke-width: 2.5px; }\n  .label { font-size: 15px; letter-spacing: .1em; }\n  .points-label { margin-top: 13px; }\n  .name { font-size: 29px; margin-top: 16px; }\n  .identity-rule { width: 85px; height: 4px; flex-basis: 4px; margin-top: 13px; margin-bottom: 17px; }\n  .match-score { height: 34px; font-size: 33px; margin-top: 7px; }\n  .set-footer { margin-top: 27px; font-size: 19px; gap: 6px; }\n  .set-value { width: 42px; font-size: 40px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"duel rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label points-label\">POINTS</span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"identity-rule jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n        <div class=\"team columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label points-label\">POINTS</span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"identity-rule jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
