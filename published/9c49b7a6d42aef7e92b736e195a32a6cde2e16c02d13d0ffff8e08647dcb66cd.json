{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Baseball — Oxblood Ivory In-Row Rail horizontal</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:\"Arial Narrow\",\"Helvetica Neue Condensed\",Arial,Helvetica,sans-serif;color:#252322}\n.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;flex-direction:column;width:min(90vw,1740px);max-width:100%;min-width:0;overflow:hidden;background:#eeeae4;border:5px solid #4e4945;container-type:inline-size}\n.competitors{display:flex;flex:0 0 auto;min-width:0}\n.competitor{display:flex;align-items:stretch;flex:1 1 50%;min-width:0;height:9.4cqw}\n.competitor+.competitor{border-left:2px solid #9e9690}\n.identity{display:block;align-self:center;flex:none;width:.75cqw;height:59%;margin:1.7cqw;background:#642438}\n.jerseyColorB{background:#642438}\n.name-stack{display:flex;flex-direction:column;justify-content:center;flex:1 1 auto;min-width:0;padding:0 1cqw}\n.sport-tag,.sport-spacer{display:block;flex:none;height:2.6cqw;color:#827b75;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:1.7cqw;line-height:1;letter-spacing:.12em;white-space:nowrap}\n.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#252322;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:4.6cqw;line-height:1.1;letter-spacing:.015em;text-transform:uppercase}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.score-stack{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:22%;min-width:0;padding:.3cqw .5cqw}\n.heading{display:block;flex:none;height:2.4cqw;color:#827b75;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:1.7cqw;line-height:1;white-space:nowrap}\n.score-cell{display:flex;align-items:center;justify-content:center;width:100%;height:5.7cqw;min-width:0;background:#68283b}\n.score{display:block;max-width:100%;overflow:hidden;text-align:center;color:#fff;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:4.8cqw;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.rail{display:flex;align-items:center;justify-content:center;flex:none;height:4cqw;border-top:2px solid #9e9690;padding:0 2cqw;color:#756e68}\n.stat{display:flex;align-items:baseline;justify-content:center;gap:.6cqw;flex:0 1 auto;min-width:0;padding:0 2.1cqw;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:1.8cqw;line-height:1;white-space:nowrap}\n.stat+.stat{border-left:2px solid #8b827b}\n.stat strong{color:#252322;font-weight:700;font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%;border-width:3px}.competitor{height:73px}.competitor+.competitor{border-left-width:1px}.identity{width:3px;height:54%;margin:5px}.name-stack{padding:0 2px}.sport-tag,.sport-spacer{height:14px;font-size:9px;letter-spacing:0}.name{font-size:clamp(17px,4.5vw,25px)}.score-stack{width:27%;padding:2px}.heading{height:13px;font-size:9px}.score-cell{height:39px}.score{font-size:clamp(19px,5vw,28px)}.rail{height:37px;border-top-width:1px;padding:0 4px}.stat{font-size:clamp(9px,2.4vw,12px);gap:2px;padding:0 5px}.stat+.stat{border-left-width:1px}}\n@media(max-width:390px){.score-stack{width:28%}.identity{margin:4px}.stat{padding:0 4px}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body><main class=\"stage\" data-osb-component=\"layout\">\n  <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball scoreboard\">\n    <div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-stack columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport-tag\" data-osb-component=\"text\">BASEBALL</span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-stack columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"heading\" data-osb-component=\"text\">RUNS</span><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n      <div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-stack columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport-spacer\" data-osb-component=\"text\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-stack columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"heading\" data-osb-component=\"text\">RUNS</span><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n    </div>\n    <div class=\"rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static baseball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div>\n    <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n  </article>\n</main></body>\n</html>\n","css":""}
