{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Slate Lime Desk Volleyball — Horizontal Lanes</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #fff; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 900px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #42535d; border-top: 4px solid #c0ed46; border-radius: 8px; background: #202a31; }\n.main { display: flex; min-height: 100px; }\n.sport { flex: 0 0 12.3%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; border-right: 1px solid #51636f; }\n.sport-label { display: block; font-size: 14px; font-weight: 700; color: #b5c9d8; line-height: 1; }\n.ball { position: relative; width: 44px; height: 44px; overflow: hidden; border-radius: 50%; background: #eef1f2; }\n.ball::before, .ball::after, .ball-seam { position: absolute; content: \"\"; width: 35px; height: 43px; border: 2px solid #29353d; border-radius: 50%; }\n.ball::before { left: -18px; top: -10px; transform: rotate(20deg); }\n.ball::after { left: 20px; top: 6px; transform: rotate(-20deg); }\n.ball-seam { left: -3px; top: 20px; width: 38px; height: 26px; transform: rotate(12deg); }\n.team { flex: 1 1 0; display: flex; align-items: center; padding: 6px 6px 6px 15px; background: #28343e; }\n.team + .team { border-left: 1px solid #536570; }\n.tick { display: block; flex: 0 0 8px; height: 40px; background: #c0ed46; margin-right: 15px; }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30px; line-height: 1; font-weight: 700; color: #fff; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-track { flex: 0 0 15%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; }\n.points-track { flex: 0 0 24%; align-self: stretch; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; margin-left: 6px; border-radius: 4px; background: #374853; }\n.label { display: block; font-size: 13px; font-weight: 700; line-height: 1; color: #b7cbd9; }\n.match-score, .primary-score { display: block; width: 100%; text-align: center; font-size: 28px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { font-size: 44px; }\n.set-footer { min-height: 34px; display: flex; align-items: center; justify-content: center; gap: 10px; border-top: 1px solid #4b5e69; font-size: 16px; line-height: 1; font-weight: 700; color: #b7cbd9; }\n.set-value { display: block; width: 28px; font-size: 24px; text-align: center; color: #fff; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .main { flex-direction: column; }\n  .sport { flex-basis: auto; min-height: 46px; flex-direction: row; gap: 11px; border-right: 0; border-bottom: 1px solid #4b5e69; }\n  .ball { width: 26px; height: 26px; }\n  .ball::before, .ball::after { width: 21px; height: 26px; border-width: 1.5px; }\n  .ball::before { left: -11px; top: -6px; }\n  .ball::after { left: 12px; top: 4px; }\n  .ball-seam { left: -2px; top: 12px; width: 23px; height: 16px; border-width: 1.5px; }\n  .team { flex-basis: auto; min-height: 70px; padding: 6px 6px 6px 12px; }\n  .team + .team { border-left: 0; border-top: 1px solid #536570; }\n  .tick { flex-basis: 7px; height: 36px; margin-right: 12px; }\n  .name { font-size: 27px; }\n  .sets-track { flex-basis: 58px; gap: 6px; }\n  .points-track { flex-basis: 86px; margin-left: 4px; gap: 5px; }\n  .label { font-size: 12px; }\n  .match-score { font-size: 24px; }\n  .primary-score { font-size: 36px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <div class=\"main rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"sport\"><div class=\"ball\" aria-hidden=\"true\"><i class=\"ball-seam\"></i></div><span class=\"sport-label\">VOLLEYBALL</span></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n      </div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
