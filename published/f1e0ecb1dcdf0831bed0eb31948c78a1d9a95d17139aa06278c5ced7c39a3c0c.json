{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pickleball Match Summary</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;font-family:\"Avenir Next\",\"Helvetica Neue\",Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.rowContainer{display:flex;flex-direction:row}.columnContainer{display:flex;flex-direction:column}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\nimg.logo:not([src]),img.logo[src=\"\"]{display:none}\n.pt-slot{position:relative;display:block}.pt-slot>.pt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.pt-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint,.pt-slot:has(> .isMatchPoint[style*=\"opacity:1\"]) > .isGamePoint{opacity:0!important}\n.pt-slot .isMatchPoint{animation:osbPulse 1.8s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.3)}}\n@media (prefers-reduced-motion: reduce) {\n.pt-slot .isGamePoint,.pt-slot .isMatchPoint{animation:none!important;transition:none!important}\n}\n.pips{display:inline-flex;gap:.35rem;align-items:center}.pip{position:relative;display:block;width:.7rem;height:.7rem;border-radius:50%;background:currentColor}\n.pip-used{position:absolute;inset:-1px;border-radius:50%;background:var(--pip-off,#0009)}\n.to-left:empty{display:none}\n.isACurrentlyServing,.isBCurrentlyServing{transition:opacity .2s}\n.dbl-probe{display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff9 0 18%,transparent 40%),conic-gradient(from 20deg,#ffd23f 0 120deg,#1d4fbf 0 240deg,#f4f6fb 0);box-shadow:inset 0 0 0 .12rem #0005}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 32%,#0003 0 9%,transparent 10%),radial-gradient(circle at 66% 30%,#0003 0 9%,transparent 10%),radial-gradient(circle at 50% 62%,#0003 0 9%,transparent 10%),radial-gradient(circle at 24% 70%,#0002 0 7%,transparent 8%),radial-gradient(circle at 78% 70%,#0002 0 7%,transparent 8%),radial-gradient(circle at 38% 30%,#fbffb0,#d4f02b 60%,#a9c414)}\n.sn{position:relative;display:inline-grid}.sn>i,.cn>i{grid-area:1/1;font-style:normal}\n.sn:has(> .isSecondServer[style*=\"opacity: 1\"]) > .one,.sn:has(> .isSecondServer[style*=\"opacity:1\"]) > .one{opacity:0}\n.cn{position:relative;display:inline-grid}.cn:has(> .isSecondServer[style*=\"opacity: 1\"]) > .one,.cn:has(> .isSecondServer[style*=\"opacity:1\"]) > .one{opacity:0}\n.call{display:inline-flex;align-items:baseline}.call>i{font-style:normal}.call .ca{order:1}.call .cd1{order:2}.call .cb{order:3}.call .cd2{order:4}.call .cn{order:5}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .ca,.board:has(.isBCurrentlyServing[style*=\"opacity:1\"]) .call .ca{order:3}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .cb,.board:has(.isBCurrentlyServing[style*=\"opacity:1\"]) .call .cb{order:1}\n.board:has(.playerA2:empty) .sn,.board:has(.playerA2:empty) .cn,.board:has(.playerA2:empty) .cd2{display:none}\n.gstack{display:inline-grid}.gstack>.gs{grid-area:1/1;white-space:nowrap}.gstack>.gs:has(~ .gs[style*=\"opacity: 1\"]),.gstack>.gs:has(~ .gs[style*=\"opacity:1\"]){visibility:hidden}\n.tie{display:none}\n.cards{display:inline-flex;gap:.25rem}.card{display:block;width:.8rem;height:1.1rem;border-radius:.15rem;box-shadow:0 0 0 1px #0003}.yc{background:#ffd200}.rc{background:#e3262f}\n.live{display:inline-flex;align-items:center;gap:.35rem}.live::before{content:\"\";width:.6rem;height:.6rem;border-radius:50%;background:#ff3b30}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{position:relative;width:108rem;padding:4rem 5rem;gap:2.4rem;color:#1d1d1b;font-family:\"Avenir Next\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;background:#fbfaf6;border-radius:1rem;border-left:1.2rem solid #2fa36b;box-shadow:0 1rem 3rem #0007}\n.mast{align-items:center;gap:1.4rem;border-bottom:.15rem solid #1d1d1b;padding-bottom:1.2rem}\n.ball{width:3.6rem;height:3.6rem}\n.mast .live{font-size:1.3rem;letter-spacing:.14em;color:#e94f37}.mast .ev{flex:1;font-size:3.4rem;letter-spacing:-.01em}.mast .rd{font-size:1.6rem;letter-spacing:.16em;color:#2fa36b;text-transform:uppercase}\n.kick{display:flex;justify-content:space-between;font-size:1.4rem;letter-spacing:.3em;color:#7a776c}\n.grid{display:grid;grid-template-columns:1rem minmax(0,1fr) 5rem 5rem repeat(5,7rem) 9rem;align-items:stretch;row-gap:1rem}\n.th{font-size:1.2rem;letter-spacing:.2em;color:#7a776c;text-align:center;padding-bottom:.4rem}\n.chip{background:#3d7bff;border-radius:.3rem}.chip.jerseyColorB{background:#e94f37}\n.nm{display:flex;align-items:center;padding:0 1.6rem;font-size:3.4rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;height:7.4rem}\n.srv{display:flex;align-items:center;justify-content:center;gap:.3rem}.pball{width:2.2rem;height:2.2rem}.sn{font-size:1.5rem;color:#2fa36b}\n.st{display:flex;align-items:center;justify-content:center;gap:.3rem;flex-direction:column}.to-used{font-size:.8rem;color:#2fa36b}\n.hc{display:flex;align-items:center;justify-content:center;font-size:3.2rem;border-left:1px solid #e3e0d4;color:#4a4842}\n.hc:has(> .hcv:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"])):has(+ .hc > .hcv:not([style*=\"opacity: 1\"]):not([style*=\"opacity:1\"])),.hc:has(+ .won):has(> .hcv:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"])){color:#2fa36b;background:#2fa36b14}\n.won{display:flex;align-items:center;justify-content:center;font-size:5rem;background:#1d1d1b;color:#fbfaf6;border-radius:.4rem}\n.foot{justify-content:space-between;align-items:center;font-size:1.5rem;letter-spacing:.12em;color:#7a776c;border-top:1px solid #e3e0d4;padding-top:1.2rem}\n.cbox{display:flex;align-items:center;gap:1rem}.call{font-size:2.6rem;gap:.2rem;color:#1d1d1b}.call>i{opacity:.5}.foot .pts{font-size:2.4rem;color:#1d1d1b}\n.pt-slot{width:22rem;height:2.6rem}.pt{border-radius:.4rem;background:#e94f37;color:#fff}\n.tie{position:absolute;right:5rem;top:1rem}\n.tolive{position:absolute;left:5rem;top:1rem;display:flex;gap:.6rem}.to-live,.to-any{gap:.4rem;padding:.3rem 1rem;border-radius:.4rem;background:#2fa36b;color:#fff;font-size:1.3rem}.to-any{display:none!important}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<header class=\"mast rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"pball ball\"></i><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">LIVE</span><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></header>\n<div class=\"kick\"><span>MATCH SUMMARY</span><span class=\"gstack\"><span class=\"gs isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\">GAME 1</span><span class=\"gs isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\">GAME 2</span><span class=\"gs isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\">GAME 3</span><span class=\"gs isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\">GAME 4</span><span class=\"gs isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\">GAME 5</span></span></div>\n<div class=\"grid\">\n<span></span><span></span><span class=\"th\">SERVE</span><span class=\"th\">T/O</span><span class=\"th\">GAME 1</span><span class=\"th\">GAME 2</span><span class=\"th\">GAME 3</span><span class=\"th\">GAME 4</span><span class=\"th\">GAME 5</span><span class=\"th\">GAMES</span>\n<i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"pball\"></i><b class=\"sn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" isA=\"true\" data-osb-component=\"field\" style=\"opacity:0\">2</i></b></span><span class=\"st\"><span class=\"to-used isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\">T/O USED</span><span class=\"cards\"><span class=\"card yc isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span><span class=\"card rc isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\"></span></span></span><span class=\"hc\"><span class=\"hcv isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\"><span class=\"hv num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\"><span class=\"hv num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\"><span class=\"hv num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\"><span class=\"hv num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\"><span class=\"hv num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span></span><span class=\"won num currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span>\n<i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"pball\"></i><b class=\"sn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" data-osb-component=\"field\" style=\"opacity:0\">2</i></b></span><span class=\"st\"><span class=\"to-used isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\">T/O USED</span><span class=\"cards\"><span class=\"card yc isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\"></span><span class=\"card rc isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\"></span></span></span><span class=\"hc\"><span class=\"hcv isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\"><span class=\"hv num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\"><span class=\"hv num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\"><span class=\"hv num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\"><span class=\"hv num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\"><span class=\"hv num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span><span class=\"won num currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span>\n</div>\n<footer class=\"foot rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"cbox\">CURRENT GAME <span class=\"pts num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span>-</span><span class=\"pts num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"pt-slot\"><span class=\"pt isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"pt isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"cbox\">SCORE CALL <span class=\"call\"><span class=\"ca num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"cd1\">-</i><span class=\"cb num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><i class=\"cd2\">-</i><b class=\"cn\"><i class=\"one\">1</i><i class=\"two isSecondServer\" isA=\"true\" data-osb-component=\"field\" style=\"opacity:0\">2</i><i class=\"two isSecondServer\" data-osb-component=\"field\" style=\"opacity:0\">2</i></b></span></span></footer>\n<div class=\"tolive\"><span class=\"to-live isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT <span class=\"to-clock num timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</span></span><span class=\"to-any isTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isTimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT</span><span class=\"to-live isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT <span class=\"to-clock num timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</span></span></div><span class=\"dbl-probe playerA2\" data-osb-component=\"field\" data-osb-field=\"playerA2\"></span><span class=\"tie\"><img class=\"logo teamLogoURLA\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><i class=\"tchip teamJerseyColorA\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorA\"></i><span class=\"tn teamAName\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"ts num teamAScore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span><i class=\"tdash\">-</i><span class=\"ts num teamBScore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span><span class=\"tn teamBName\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><i class=\"tchip teamJerseyColorB\" data-osb-component=\"field\" data-osb-field=\"teamJerseyColorB\"></i><img class=\"logo teamLogoURLB\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"></span></section></main>\n</body>\n</html>\n","css":""}
