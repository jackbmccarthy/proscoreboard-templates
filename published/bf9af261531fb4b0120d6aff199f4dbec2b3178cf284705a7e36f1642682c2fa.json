{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Oat Graphite Eyebrow 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(96vw,1640px);height:214px;max-width:100%;overflow:hidden;border-radius:5px;background:#e8e2d7;color:#293238;container-type:inline-size}\n.lanes{display:flex;flex:1 1 auto;min-height:0}\n.lane{display:flex;align-items:stretch;flex:1 1 0;min-width:0;min-height:0}\n.lane+.lane{border-left:7px solid transparent}\n.identity{display:block;align-self:stretch;flex:0 0 5.1%;background:#2f88a8}\n.jerseyColorB{background:#c46e6b}\n.name-lane{display:flex;justify-content:center;flex:1 1 auto;min-width:0;flex-direction:column;gap:7px;padding:3px 4.5%;background:#e8e2d7}\n.support{display:flex;align-items:baseline;gap:.4em;min-width:0;white-space:nowrap}\n.support-label{font-size:clamp(12px,1.65cqw,27px);font-weight:600;line-height:1}\n.support-score{display:block;max-width:4ch;overflow:hidden;font-size:clamp(15px,1.9cqw,31px);font-weight:700;line-height:1;font-variant-numeric:tabular-nums}\n.name{display:block;min-width:0;overflow:hidden;font-size:clamp(24px,3.85cqw,63px);font-weight:750;line-height:1.02;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.scorecap{display:flex;align-items:center;justify-content:center;flex:0 0 27%;min-width:0;flex-direction:column;gap:3px;background:#293238;color:#f8f7f2;font-variant-numeric:tabular-nums}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(44px,5.3cqw,88px);font-weight:800;line-height:.94;text-align:center}\n.score-caption{display:block;max-width:100%;overflow:hidden;font-size:clamp(11px,1.55cqw,25px);font-weight:750;line-height:1;white-space:nowrap}\n.footer{display:flex;align-items:center;flex:0 0 33%;min-width:0;gap:2.2%;padding:0 2%;background:#293238;color:#f8f7f2;white-space:nowrap}\n.sport{font-size:clamp(18px,1.98cqw,33px);font-weight:750;line-height:1}\n.footer-rule{align-self:center;width:1px;height:50%;background:#abb7b3}\n.set-status{display:flex;align-items:baseline;gap:.35em;font-size:clamp(17px,1.8cqw,30px);line-height:1}\n.set-number{font-variant-numeric:tabular-nums}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){\n .stage{padding:6px}\n .board{width:100%;height:182px}\n .lanes{flex-direction:column}\n .lane+.lane{border-left:0;border-top:1px solid #8c9696}\n .identity{flex-basis:10px}\n .name-lane{gap:3px;padding:3px 12px}\n .support-label{font-size:11px}.support-score{font-size:17px}\n .name{font-size:clamp(19px,6.2vw,27px)}\n .scorecap{flex-basis:25%;gap:2px}\n .score{font-size:clamp(32px,10vw,45px)}\n .score-caption{font-size:clamp(9px,2.7vw,12px)}\n .footer{flex-basis:29px;gap:14px;padding:0 13px}\n .sport{font-size:14px}.set-status{font-size:13px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-lane\" data-osb-component=\"layout\"><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">SETS</span><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"scorecap\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"score-caption\" data-osb-component=\"text\">POINTS</span></div></div>\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-lane\" data-osb-component=\"layout\"><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">SETS</span><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"scorecap\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"score-caption\" data-osb-component=\"text\">POINTS</span></div></div>\n  </div>\n  <div class=\"footer rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-component=\"text\">VOLLEYBALL</span><span class=\"footer-rule\" aria-hidden=\"true\"></span><span class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"set-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></span></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
