{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Pewter Columnhead compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#25343a}\n.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.shell{width:min(52vw,850px);max-width:100%;container-type:inline-size}\n.head{height:7.5cqw;display:flex;justify-content:space-between;align-items:stretch;padding-right:0}\n.sport,.heading{display:flex;align-items:center;justify-content:center;background:#25343a;color:#f5f7f4;font-weight:800;font-size:3.7cqw;line-height:1;border-radius:4px 4px 0 0}\n.sport{width:36%;letter-spacing:.01em}.heading{width:25.5%}\n.board{display:flex;flex-direction:column;width:100%;overflow:hidden;background:#dfe6e5;border:1px solid #8da1a5;border-radius:0 0 4px 4px}\n.competitor{display:flex;align-items:stretch;min-width:0;height:14cqw}\n.competitor+.competitor{border-top:1px solid #8da1a5}\n.tick{flex:0 0 2.2%;background:#1688e9}.jerseyColorB{background:#ec202f}\n.name{display:block;align-content:center;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 3.8cqw;font-size:7.4cqw;font-weight:800;line-height:1.05;color:#25343a}\n.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}\n.score-cell{display:flex;align-items:center;justify-content:center;flex:0 0 25.5%;min-width:0;background:#bccdd0;border-left:1px solid #8da1a5}\n.score{display:block;width:100%;text-align:center;font-size:9cqw;font-weight:800;line-height:1;color:#25343a;font-variant-numeric:tabular-nums;white-space:nowrap}\n.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.shell{width:100%}.head{height:29px}.sport,.heading{font-size:13px}.competitor{height:61px}.name{font-size:25px;padding:0 12px}.score{font-size:36px}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\" data-osb-component=\"layout\"><div class=\"shell\">\n  <div class=\"head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport sport-tag\" data-osb-component=\"text\">BASEBALL</span><span class=\"heading\" data-osb-component=\"text\">RUNS</span></div>\n  <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball scoreboard\">\n    <div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n    <div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n    <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n  </article>\n</div></main></body></html>\n","css":""}
