{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>TABLE TENNIS Scoreboard</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#f7f5f0}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(60vw,1180px);max-width:calc(100vw - 16px);container-type:inline-size;background:#2b3036}.board.horizontal{width:min(94vw,1860px)}.header{height:39px;padding:0 20px 0 22px;display:flex;align-items:center;justify-content:space-between;background:#d8c9ae;color:#2b3036}.sport{font-size:23px;font-weight:800;line-height:1;letter-spacing:.015em;white-space:nowrap}.point-slot{position:relative;min-width:120px;height:100%;font-size:11px;line-height:39px;font-weight:700;letter-spacing:.09em;text-align:right}.point-state{position:absolute;inset:0;white-space:nowrap}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}.rows{display:flex;flex-direction:column}.row{display:grid;grid-template-columns:12px minmax(0,1fr) minmax(75px,18%) minmax(93px,23%);min-width:0;height:72px;background:#2b3036}.row+.row{border-top:1px solid #67737b}.identity{width:100%;height:100%;background:#2b8aa8}.jerseyColorB{background:#d06461}.name-cell{min-width:0;display:flex;align-items:center;gap:8px;padding:0 15px}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:28px;font-weight:700;line-height:1.1}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{flex:0 0 9px;width:9px;height:9px;border-radius:50%;background:#d8c9ae}.number-cell{min-width:0;border-left:1px solid #67737b;display:flex;align-items:center;justify-content:center;flex-direction:column;overflow:hidden;font-variant-numeric:tabular-nums}.support-score,.primary-score{display:block;max-width:100%;font-weight:800;line-height:1;white-space:nowrap;overflow:hidden;text-overflow:clip}.support-score{font-size:31px}.primary-score{font-size:46px}.caption{margin-top:2px;color:#c9c0b0;font-size:10px;font-weight:700;line-height:1;letter-spacing:.07em}.horizontal .header{height:35px}.horizontal .point-slot{line-height:35px}.horizontal .rows{flex-direction:row}.horizontal .row{flex:1 1 0;grid-template-columns:12px minmax(0,1fr) minmax(75px,18%) minmax(93px,23%);height:78px}.horizontal .row+.row{border-top:0}.horizontal .name{font-size:27px}@media(max-width:700px){.board,.board.horizontal{width:calc(100vw - 16px)}.header,.horizontal .header{height:30px;padding:0 9px}.sport{font-size:15px}.point-slot,.horizontal .point-slot{min-width:85px;font-size:8px;line-height:30px}.row,.horizontal .row{grid-template-columns:5px minmax(0,1fr) minmax(45px,15%) minmax(52px,18%);height:65px}.name-cell{padding:0 7px;gap:4px}.name,.horizontal .name{font-size:clamp(13px,5vw,22px)}.support-score{font-size:20px}.primary-score{font-size:29px}.caption{font-size:7px}.horizontal .rows{flex-direction:column}.horizontal .row+.row{border-top:1px solid #67737b}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}.board:not(.horizontal) .header{height:6.5cqw;padding:0 2.8cqw}.board:not(.horizontal) .sport{font-size:4cqw}.board:not(.horizontal) .point-slot{line-height:6.5cqw;font-size:1.25cqw;min-width:17cqw}.board:not(.horizontal) .row{height:12.5cqw;grid-template-columns:2.7cqw minmax(0,1fr) minmax(75px,18%) minmax(93px,23%)}.board:not(.horizontal) .name-cell{padding:0 2.3cqw}.board:not(.horizontal) .name{font-size:4.3cqw}.board:not(.horizontal) .support-score{font-size:4.1cqw}.board:not(.horizontal) .primary-score{font-size:6.9cqw}.board:not(.horizontal) .caption{font-size:2cqw;margin-top:.3cqw}.horizontal .header{height:3.5cqw;padding:0 1.3cqw}.horizontal .sport{font-size:2.3cqw}.horizontal .point-slot{line-height:3.5cqw;font-size:.9cqw;min-width:12cqw}.horizontal .row{height:8cqw;grid-template-columns:1.4cqw minmax(0,1fr) minmax(75px,18%) minmax(93px,23%)}.horizontal .name-cell{padding:0 1.7cqw}.horizontal .name{font-size:3.2cqw}.horizontal .support-score{font-size:3.1cqw}.horizontal .primary-score{font-size:4.8cqw}.horizontal .caption{font-size:1.45cqw;margin-top:.15cqw}@media(max-width:700px){.board:not(.horizontal) .header,.horizontal .header{height:30px;padding:0 9px}.board:not(.horizontal) .sport,.horizontal .sport{font-size:15px}.board:not(.horizontal) .point-slot,.horizontal .point-slot{min-width:85px;font-size:8px;line-height:30px}.board:not(.horizontal) .row,.horizontal .row{grid-template-columns:5px minmax(0,1fr) minmax(45px,15%) minmax(52px,18%);height:65px}.board:not(.horizontal) .name-cell,.horizontal .name-cell{padding:0 7px}.board:not(.horizontal) .name,.horizontal .name{font-size:clamp(13px,5vw,22px)}.board:not(.horizontal) .support-score,.horizontal .support-score{font-size:20px}.board:not(.horizontal) .primary-score,.horizontal .primary-score{font-size:29px}.board:not(.horizontal) .caption,.horizontal .caption{font-size:7px;margin-top:2px}}\n</style></head><body><main class=\"stage\"><article class=\"board horizontal columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><span class=\"sport sport-tag\">TABLE TENNIS</span><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></header><div class=\"rows rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"row lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-cell\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"number-cell\"><span class=\"support support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">GAMES</span></div><div class=\"number-cell\"><span class=\"primary primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div></div><div class=\"row lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-cell\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"number-cell\"><span class=\"support support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">GAMES</span></div><div class=\"number-cell\"><span class=\"primary primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div></div></div></article></main></body></html>\n","css":""}
