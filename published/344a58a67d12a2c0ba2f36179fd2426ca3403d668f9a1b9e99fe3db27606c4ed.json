{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Ground LED</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px; font-family: \"DIN Alternate\", \"Arial Narrow\", Arial, sans-serif; }\n    .board { position: relative; display: grid; grid-template-columns: 1fr auto 1fr auto; align-items: center; gap: 18px; width: 1100px; height: 96px; padding: 0 22px; background-color: #050505; background-image: radial-gradient(circle, #1c1c1c 1px, transparent 1.5px); background-size: 5px 5px; border: 3px solid #262626; border-radius: 6px; color: #e8e8e8; box-shadow: inset 0 0 24px #000, 0 10px 22px #000a; }\n    .team { display: flex; align-items: center; gap: 12px; min-width: 0; }\n    .team.a { justify-content: flex-end; }\n    .kit { flex: 0 0 auto; width: 10px; height: 40px; border-radius: 1px; background-color: #333; }\n    .nm { min-width: 0; font-size: 34px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 0 6px #fff5; }\n    .card { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 14px; height: 20px; border-radius: 2px; font-size: 10px; font-weight: 700; }\n    .card.red { background: #ff2a2a; box-shadow: 0 0 8px #ff2a2a; }\n    .card.yellow { background: #ffd400; color: #050505; box-shadow: 0 0 8px #ffd400; }\n    .score { display: flex; align-items: center; gap: 14px; color: #ffb000; font-size: 66px; font-weight: 700; font-variant-numeric: tabular-nums; text-shadow: 0 0 12px #ffb000aa; }\n    .score .dash { width: 18px; height: 6px; background: #ffb000; box-shadow: 0 0 8px #ffb000; }\n    .clock { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; align-self: stretch; padding: 0 0 0 18px; border-left: 1px solid #262626; }\n    .gc { color: #ffb000; font-size: 34px; font-weight: 700; font-variant-numeric: tabular-nums; text-shadow: 0 0 8px #ffb000aa; }\n    .lo { display: flex; gap: 10px; align-items: center; font-size: 18px; letter-spacing: 2px; }\n    .added { color: #ff2a2a; font-size: 18px; text-shadow: 0 0 6px #ff2a2a; }\n    .added:has(.at:empty) { display: none; }\n    .half:empty { display: none; }\n    .live { width: 8px; height: 8px; border-radius: 50%; background: #ff2a2a; box-shadow: 0 0 6px #ff2a2a; animation: blink 1.6s ease-in-out infinite; }\n    @keyframes blink { 50% { opacity: .25; } }\n    .ht { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #050505; color: #ffb000; font-size: 40px; letter-spacing: 12px; text-shadow: 0 0 12px #ffb000; }\n    .ev { position: absolute; left: 22px; top: 6px; display: flex; gap: 10px; font-size: 11px; letter-spacing: 3px; color: #8a8a8a; text-transform: uppercase; }\n    .pens { display: none; }\n    .osb-aux, .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<article class=\"board\" aria-label=\"Soccer LED board\">\n  <span class=\"ev\"><span class=\"ev-name eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span>\n  <span class=\"team a\"><span class=\"card yellow isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity: 0;\"><span class=\"cn yellowCardsA\" data-osb-component=\"field\" data-osb-field=\"yellowCardsA\"></span></span><span class=\"card red isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity: 0;\"><span class=\"cn redCardsA\" data-osb-component=\"field\" data-osb-field=\"redCardsA\"></span></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span>\n  <span class=\"score\"><span class=\"sa currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><b class=\"dash\"></b><span class=\"sb currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span>\n  <span class=\"team b\"><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"card yellow isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity: 0;\"><span class=\"cn yellowCardsB\" data-osb-component=\"field\" data-osb-field=\"yellowCardsB\"></span></span><span class=\"card red isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity: 0;\"><span class=\"cn redCardsB\" data-osb-component=\"field\" data-osb-field=\"redCardsB\"></span></span></span>\n  <span class=\"clock\"><span class=\"gc\"><span class=\"cm clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b class=\"colon\">:</b><span class=\"cs clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"lo\"><span class=\"live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0;\"></span><span class=\"half periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"half\"></span><span class=\"added addedTimeVisible\"><span class=\"at addedTime\" data-osb-component=\"field\" data-osb-field=\"addedTime\"></span></span></span><span class=\"pens shootoutAttempts\"><b class=\"pens-l\">PENS</b><span class=\"pen-a shootoutAScore\" data-osb-component=\"field\" data-osb-field=\"shootoutAScore\"></span><b class=\"pens-d\">-</b><span class=\"pen-b shootoutBScore\" data-osb-component=\"field\" data-osb-field=\"shootoutBScore\"></span></span></span>\n  <span class=\"ht isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\">HT</span>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
