{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Limestone Inset Subscore 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(92vw,1067px);max-width:100%;height:378px;overflow:hidden;border:2px solid #aeb9b5;border-radius:8px;background:#ebe9e2;color:#243941;container-type:inline-size}\n.teams{display:flex;flex:1 1 0;min-height:0;flex-direction:column}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-width:0;min-height:0}\n.team+.team{border-top:2px solid #aeb9b5}\n.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0}\n.identity{display:block;align-self:stretch;flex:0 0 20px;margin:20px 0 20px 20px;background:#eb4050}\n.jerseyColorB{background:#3778e0}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;padding:0 28px;color:#243941;font-size:clamp(27px,6cqw,69px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.sets{display:flex;align-items:center;justify-content:center;flex:0 0 12.7%;min-width:0;flex-direction:column;gap:8px;margin:12px 0;background:#365d67;color:#fff;border-radius:3px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sets-label{display:block;max-width:100%;overflow:hidden;font-size:clamp(15px,2.3cqw,25px);font-weight:800;line-height:1}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(32px,5.1cqw,58px);font-weight:800;line-height:1;text-align:center}\n.points{display:flex;align-items:center;justify-content:center;flex:0 0 22.5%;min-width:0;color:#243941}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(55px,9cqw,106px);font-weight:800;font-variant-numeric:tabular-nums;line-height:1;text-align:center;white-space:nowrap}\n.baseline{display:flex;align-items:center;justify-content:space-between;flex:0 0 20%;min-width:0;padding:0 24px;border-top:2px solid #aeb9b5;color:#243941;font-size:clamp(16px,3cqw,37px);font-weight:800;line-height:1;white-space:nowrap}\n.sport-tag{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.set-status{display:flex;align-items:center;gap:.3em}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:8px}\n .board{width:100%;height:155px;border-width:1px;border-radius:4px}\n .team+.team,.baseline{border-width:1px}\n .identity{flex-basis:6px;margin:9px 0 9px 6px}\n .name{padding:0 8px;font-size:clamp(17px,5.6cqw,24px)}\n .sets{flex-basis:17%;gap:2px;margin:5px 0}\n .sets-label{font-size:clamp(8px,2.7cqw,12px)}\n .set-score{font-size:clamp(20px,6cqw,28px)}\n .points{flex-basis:20%}\n .score{font-size:clamp(31px,10cqw,44px)}\n .baseline{padding:0 8px;font-size:clamp(10px,3.4cqw,15px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets\" data-osb-component=\"layout\"><span class=\"sets-label\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets\" data-osb-component=\"layout\"><span class=\"sets-label\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n  </div>\n  <div class=\"baseline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
