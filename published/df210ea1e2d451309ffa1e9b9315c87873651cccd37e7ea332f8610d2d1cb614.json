{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Courtside — Arena Split</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isMatchPoint{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .45em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.won{position:absolute;z-index:0}\n.gs{position:relative;z-index:1}\n.gtag .nx{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .now{display:none}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .gtag .nx{display:inline}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\nhtml,body{height:100%;overflow:hidden}\n.osb-core-fields{display:none!important}\n.board{position:fixed;inset:0;display:flex;flex-direction:column;font-family:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;color:#fff;background:#060b14;-webkit-font-smoothing:antialiased;overflow:hidden}\n.ends{display:flex;flex:1 1 auto;min-height:0;gap:.5vw}\n.end{position:relative;display:grid;grid-template-rows:17vh 1fr auto 15vh;grid-template-columns:auto 1fr;grid-template-areas:\"who who\" \"pts pts\" \"hist hist\" \"gw foot\";flex:1 1 0;min-width:0;background:#0d1a2e;overflow:hidden}\n.eB{background:#101f37}\n.kit{position:absolute;left:0;right:0;top:0;height:1.4vh;background:#5b6c86}\n.win{position:absolute;bottom:3.4vh;right:2.6vw;display:flex;align-items:center;height:8vh;padding:0 2.4vw;border-radius:1vh;background:#ffd23f;color:#111;font-size:3.6vh;font-weight:900;letter-spacing:.16em;text-transform:uppercase;z-index:2}\n.who{grid-area:who;display:flex;align-items:center;justify-content:center;gap:1.4vw;padding:3vh 3vw 0;min-width:0}\n.flag{flex:0 0 auto;width:7.2vh;height:4.8vh;object-fit:cover;border-radius:.4vh;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.nm{display:flex;flex-direction:column;align-items:center;gap:.6vh;min-width:0;text-align:center}\n.name{font-size:6.2vh;line-height:1.02;font-weight:800;text-transform:uppercase;overflow-wrap:normal;hyphens:none}\n.team{display:flex;align-items:center;gap:1vw;font-size:3.2vh;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#93a9c9}\n.tlogo{width:5vh;height:5vh;object-fit:contain}\n.tie{display:inline-flex;align-items:center;gap:.6vw;padding:0 1vw;height:5vh;border-radius:.6vh;background:#1d3354;color:#fff}\n.tie i{font-style:normal;color:#93a9c9}\n.team:not(:has(.tname:not(:empty))){display:none}\n.nm:has(.name:empty) .team{font-size:5vh;color:#fff}\n.nm:has(.name:empty) .tname{line-height:1.05}\n.pts{grid-area:pts;display:flex;align-items:center;justify-content:center;min-height:0}\n.big{font-size:46vh;line-height:.8;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em}\n.hist{grid-area:hist;position:relative;display:flex;justify-content:center;gap:.8vw;min-height:6.4vh}\n.hg{display:flex;align-items:center;gap:.7vw;height:6.4vh;padding:0 1.2vw;border-radius:.7vh;font-weight:800;font-variant-numeric:tabular-nums}\n.hl{font-style:normal;font-size:2.8vh;letter-spacing:.1em;opacity:.8}\n.gs{font-size:4.2vh}\n\n.hg:not(:has(.won[style*=\"opacity: 1\"])){position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important;padding:0!important;margin:0!important;border:0!important}\n.hg .won{display:none}\n.hg{background:#16273f;color:#7f95b8}\n.end[data-osb-resolved-court-side=\"A\"] .hg:has(.wA[style*=\"opacity: 1\"]),.end[data-osb-resolved-court-side=\"B\"] .hg:has(.wB[style*=\"opacity: 1\"]){background:#ffd23f;color:#111}\n.end[data-osb-resolved-court-side=\"A\"] .isBWinner,.end[data-osb-resolved-court-side=\"B\"] .isAWinner,.end:not([data-osb-resolved-court-side]) :is(.isAWinner,.isBWinner){display:none!important}\n\n.foot{grid-area:foot;display:flex;align-items:center;gap:1.4vw;padding:0 2.6vw 1.6vh 1.4vw}\n.gw{grid-area:gw;padding:0 0 1.6vh 2.6vw;display:flex;align-items:center;gap:1vw;font-weight:800;text-transform:uppercase}\n.gw i{font-style:normal;font-size:3.2vh;letter-spacing:.16em;color:#93a9c9}\n.gn{display:flex;align-items:center;justify-content:center;min-width:11vh;height:11vh;border-radius:1vh;background:#ffd23f;color:#111;font-size:8.4vh;font-weight:900;font-variant-numeric:tabular-nums}\n.to-slot{width:17vh;height:6vh}\n.to-on,.to-used{border-radius:.6vh;font-size:3vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.to-on{background:#ffd23f;color:#111}\n.to-used{box-shadow:inset 0 0 0 .4vh #3f5a85;color:#a9bddb}\n.cs{width:4.4vh;height:6.2vh}\n.card{border-radius:.6vh;box-shadow:0 0 0 .3vh rgba(0,0,0,.35)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.ss{width:9vh;height:9vh;margin-left:auto}\n.ball{border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 16%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .5vh rgba(0,0,0,.25),0 0 3vh rgba(255,138,28,.55)}\n.bar{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:2vw;flex:0 0 14vh;padding:0 2vw;background:#060b14}\n.info{display:flex;flex-direction:column;justify-content:center;gap:.6vh;min-width:0;text-transform:uppercase;white-space:nowrap}\n.info>*{overflow:hidden;text-overflow:ellipsis}\n.teamlbl{display:none;font-size:4vh;font-weight:800;letter-spacing:.08em}\n.info:not(:has(.ev:not(:empty))):not(:has(.rd:not(:empty))) .teamlbl{display:block}\n.board:not(:has(.tname:not(:empty))) .teamlbl{display:none!important}\n.info:not(:has(.rd:not(:empty))):not(:has(.bo:not(:empty))) .l2{display:none}\n.ev{font-size:4vh;font-weight:800;letter-spacing:.06em}\n.l2{display:flex;align-items:center;font-size:3vh;font-weight:700;letter-spacing:.08em;color:#93a9c9}\n.l2 .sep{font-style:normal;padding:0 .6em}\n.l2 .rd:empty+.sep,.l2 .sep:has(+.bo:empty){display:none}\n.center{display:flex;align-items:center;gap:1vw}\n.tagslot{width:33vh;height:9vh}\n.tagslot>*{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.06em;text-transform:uppercase}\n.gtag{background:#1d3354;color:#fff}\n.fin{background:#fff;color:#111}\n.banner{width:47vh;height:9vh}\n.bn{border-radius:1vh;font-size:4.4vh;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.bn-warm,.bn-break{background:#1d3354;color:#e6eefb}\n.bn-gp{background:#ff8a1c;color:#111}\n.bn-mp{background:#e3262f;color:#fff}\n.chips{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:.8vh}\n.chip{width:24vh;height:4.8vh}\n.fl{border-radius:.6vh;font-size:2.8vh;font-weight:800;letter-spacing:.06em;text-transform:uppercase;background:#1d3354;color:#e6eefb}\n\n.board:has(.isComplete[style*=\"opacity: 1\"]) .big{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip-path:inset(50%)!important}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw{grid-area:pts;flex-direction:column-reverse;justify-content:center;gap:2vh;padding:0}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gn{background:none;color:#fff;font-size:40vh;height:auto;line-height:.8}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .gw i{font-size:4.4vh}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]{box-shadow:inset 0 0 0 .8vh #ffd23f}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"]{opacity:.5}\n:is(.board:has(.isAWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"A\"],.board:has(.isBWinner[style*=\"opacity: 1\"]) .end[data-osb-resolved-court-side=\"B\"]) .gn{color:#ffd23f!important}\n\n</style>\n</head>\n<body>\n<main class=\"board t-arena\" data-osb-component=\"layout\"><div class=\"ends\" data-osb-component=\"layout\"><div class=\"courtSideAView end eA\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"isAWinner win\" data-osb-component=\"field\" data-osb-field=\"isAWinner\" style=\"opacity:0\">Winner</span><span class=\"isBWinner win\" data-osb-component=\"field\" data-osb-field=\"isBWinner\" style=\"opacity:0\">Winner</span><div class=\"who\" data-osb-component=\"layout\"><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nm\"><span class=\"courtSideCombinedAName name\" data-osb-component=\"field\" data-osb-field=\"courtSideCombinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"tie\"><i>Tie</i><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span></span></div><div class=\"pts\" data-osb-component=\"layout\"><span class=\"courtSideAGameScore big\" data-osb-component=\"field\" data-osb-field=\"courtSideAGameScore\">0</span></div><div class=\"hist\" data-osb-component=\"layout\"><span class=\"hg isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><i class=\"hl\">G1</i><span class=\"isGame1AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame1AWon\" style=\"opacity:0\"></span><span class=\"isGame1BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame1BWon\" style=\"opacity:0\"></span><span class=\"game1AScore gs\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hg isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><i class=\"hl\">G2</i><span class=\"isGame2AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame2AWon\" style=\"opacity:0\"></span><span class=\"isGame2BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame2BWon\" style=\"opacity:0\"></span><span class=\"game2AScore gs\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hg isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><i class=\"hl\">G3</i><span class=\"isGame3AWon won wA\" data-osb-component=\"field\" data-osb-field=\"isGame3AWon\" style=\"opacity:0\"></span><span class=\"isGame3BWon won wB\" data-osb-component=\"field\" data-osb-field=\"isGame3BWon\" style=\"opacity:0\"></span><span class=\"game3AScore gs\" data-osb-component=\"field\" data-osb-field=