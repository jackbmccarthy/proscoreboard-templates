{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Cloud Graphite Combined Bay horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#293b44}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;flex-direction:column;width:min(82vw,1660px);max-width:100%;min-width:0;overflow:hidden;border:2px solid #aebbb8;border-radius:4px;background:#e8edeb;container-type:inline-size}\n.header{display:flex;align-items:center;justify-content:space-between;flex:none;height:4.8cqw;padding:0 1.5cqw;border-bottom:1px solid #aebbb8;background:#e8edeb}\n.sport-tag{display:block;flex:none;color:#293b44;font-size:1.65cqw;font-weight:800;line-height:1;white-space:nowrap}\n.stats{display:flex;align-items:center;justify-content:flex-end;gap:2.3cqw;flex:1 1 auto;min-width:0}\n.stat{display:flex;align-items:baseline;gap:.4cqw;min-width:0;color:#293b44;font-size:1.3cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stat strong{font-variant-numeric:tabular-nums}\n.competitors{display:flex;align-items:stretch;min-width:0}\n.competitor{display:flex;align-items:stretch;flex:1 1 50%;min-width:0;height:11.7cqw;background:#e8edeb}\n.competitor+.competitor{border-left:2px solid #aebbb8}\n.identity{display:block;flex:none;width:1.4cqw;height:100%;background:#2178d8}\n.jerseyColorB{background:#f25b60}\n.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 1.8cqw;color:#293b44;font-size:4.3cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.score-bay{display:flex;flex-direction:column;flex:0 0 27.5%;min-width:0;background:#293b44;color:#f7faf8;padding:0 .6cqw}\n.small-line,.large-line{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0}\n.small-line{flex:0 0 42%;border-bottom:1px solid #aebbb8}\n.large-line{flex:1 1 auto}\n.small-label,.large-label{display:block;color:#f7faf8;font-weight:700;line-height:1;white-space:nowrap}\n.small-label{font-size:1.35cqw}.large-label{font-size:1.45cqw}\n.hit-value,.score{display:block;max-width:100%;overflow:hidden;color:#f7faf8;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center}\n.hit-value{font-size:2.2cqw}.score{font-size:4.6cqw}\n.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%;border-width:1px}.header{height:48px;flex-direction:column;align-items:stretch;justify-content:center;gap:4px;padding:0 6px}.sport-tag{font-size:10px}.stats{flex:none;justify-content:space-between;gap:2px}.stat{font-size:9px;gap:2px}.competitor{height:80px}.competitor+.competitor{border-left-width:1px}.identity{width:3px}.name{font-size:clamp(14px,3.8vw,22px);padding:0 5px}.score-bay{flex-basis:30%;padding:0 2px}.small-label,.large-label{font-size:8px}.hit-value{font-size:12px}.score{font-size:clamp(20px,5.5vw,28px)}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Softball scoreboard\">\n<div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOFTBALL</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static softball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></div>\n<div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"small-line columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"small-label\" data-osb-component=\"text\">HITS</span><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong></div><div class=\"large-line columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"large-label\" data-osb-component=\"text\">RUNS</span><strong class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong></div></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"small-line columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"small-label\" data-osb-component=\"text\">HITS</span><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong></div><div class=\"large-line columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"large-label\" data-osb-component=\"text\">RUNS</span><strong class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong></div></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
