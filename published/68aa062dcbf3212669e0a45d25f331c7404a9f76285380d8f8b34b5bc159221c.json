{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Harbor Silver Leadstat stacked</title><style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f7faf8}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{container-type:inline-size;width:min(76vw,1400px);max-width:100%;min-width:0;overflow:hidden;border:1px solid #58717b;border-radius:3px;background:#1e3949}\n.header{display:flex;align-items:center;justify-content:space-between;gap:2cqw;height:6cqw;min-height:35px;padding:0 2cqw;border-bottom:1px solid #58717b;background:#1e3949}\n.sport-tag{flex:none;color:#f7faf8;font-size:3cqw;font-weight:700;line-height:1;letter-spacing:.025em;white-space:nowrap}\n.status{display:flex;align-items:center;justify-content:flex-end;min-width:0}\n.stat{display:flex;align-items:baseline;gap:.65cqw;padding:0 1.6cqw;border-left:1px solid #58717b;color:#d9e3e4;font-size:1.8cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stat:last-child{padding-right:0}.stat-value{color:#f7faf8;font-size:1.28em;font-variant-numeric:tabular-nums}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{display:flex;align-items:stretch;min-width:0;height:10cqw;background:#1e3949}\n.lane+.lane{border-top:1px solid #58717b}\n.tick{display:block;flex:none;align-self:stretch;width:1.45cqw;min-width:4px;background:#338ba6}\n.lane-b .tick{background:#c86e69}\n.support-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:10.5cqw;min-width:0;margin:1.25cqw 0;border-right:1px solid #58717b;background:#1e3949;color:#d9e3e4}\n.support-value{display:block;max-width:100%;overflow:hidden;color:#d9e3e4;font-size:4.2cqw;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.support-caption{display:block;color:#d9e3e4;font-size:1.55cqw;font-weight:700;line-height:1.1;white-space:nowrap}\n.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2.1cqw;color:#f7faf8;font-size:4.4cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.primary-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;width:12.2cqw;min-width:0;background:#d9e3e4;color:#1e3949}\n.primary-score{display:block;max-width:100%;overflow:hidden;color:#1e3949;font-size:6cqw;font-weight:800;line-height:.95;font-variant-numeric:tabular-nums;white-space:nowrap}\n.primary-caption{display:block;color:#1e3949;font-size:1.75cqw;font-weight:700;line-height:1.1;white-space:nowrap}\n.hidden-field,.point-slot{position:absolute!important;width:0!important;height:0!important;overflow:hidden!important;clip-path:inset(50%)}\n.point-slot>span{position:absolute;inset:0;opacity:0}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%}.header{height:auto;min-height:42px;padding:6px 8px;gap:5px}.sport-tag{font-size:12px}.status{flex-wrap:wrap;gap:3px}.stat{font-size:9px;gap:3px;padding:0 5px}.stat:first-child{border-left:0}.lanes{display:flex;flex-direction:column}.lane{height:66px}.lane+.lane{border-left:0;border-top:1px solid #58717b}.tick{width:5px}.support-track{width:53px;margin:8px 0}.support-value{font-size:22px}.support-caption{font-size:10px}.name{padding:0 9px;font-size:clamp(17px,5vw,25px)}.primary-track{width:74px}.primary-score{font-size:34px}.primary-caption{font-size:10px}}\n@media(max-width:410px){.header{flex-wrap:wrap}.status{width:100%;justify-content:space-between}.stat{font-size:8px;padding:0 3px}.stat:first-child{padding-left:0}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-static=\"true\">BASEBALL</span><div class=\"status rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat\"><span data-osb-static=\"true\">INNING</span><strong class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\"><span data-osb-static=\"true\">BALLS</span><strong class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\"><span data-osb-static=\"true\">STRIKES</span><strong class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\"><span data-osb-static=\"true\">OUTS</span><strong class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></header><div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"support-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong><span class=\"support-caption\" data-osb-static=\"true\">HITS</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong><span class=\"primary-caption\" data-osb-static=\"true\">RUNS</span></div><span class=\"hidden-field currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"support-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"support-value\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong><span class=\"support-caption\" data-osb-static=\"true\">HITS</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><strong class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong><span class=\"primary-caption\" data-osb-static=\"true\">RUNS</span></div><span class=\"hidden-field currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"field\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
