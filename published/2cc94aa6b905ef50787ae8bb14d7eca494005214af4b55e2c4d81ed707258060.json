{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Basketball Petrol Chalk Scoreboard</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f7f9f5}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{position:relative;container-type:inline-size;width:min(86vw,1626px);overflow:hidden;border:1px solid #4d6970;border-radius:3px;background:#18353f}\n.header{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:3.5cqw;padding:0 1.8cqw;border-bottom:1px solid #a8bbb6;background:#18353f}\n.sport-tag{font-size:1.95cqw;font-weight:700;letter-spacing:.02em;white-space:nowrap}\n.status{display:flex;align-items:center;justify-content:flex-end;min-width:0}\n.stat{display:flex;align-items:baseline;gap:.45em;padding:0 1.5cqw;font-size:1.35cqw;white-space:nowrap}\n.stat+.stat{border-left:1px solid #a8bbb6}.stat:last-child{padding-right:0}\n.stat-value{font-size:1.65cqw;font-weight:700;font-variant-numeric:tabular-nums}\n.lanes{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}\n.lane{display:grid;grid-template-columns:2.3cqw 9.5cqw minmax(0,1fr) 6.3cqw;min-width:0;min-height:8.7cqw;background:#18353f}\n.lane+.lane{border-left:1px solid #a8bbb6}\n.tick{display:block;min-width:0;align-self:stretch;margin:.3cqw;background:#2786a5}.lane-b .tick{background:#c76a61}\n.primary{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:.25cqw;background:#e9eee8;color:#18353f}\n.primary-score{max-width:100%;font-size:5.1cqw;font-weight:800;line-height:.92;font-variant-numeric:tabular-nums;white-space:nowrap}\n.caption{font-size:1.2cqw;font-weight:700;line-height:1.05;white-space:nowrap}\n.name{display:block;align-self:center;min-width:0;overflow:hidden;margin:0;padding:0 2cqw;font-size:3.45cqw;font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.support{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:.25cqw;background:#18353f}\n.support-value{font-size:3.4cqw;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}.support .caption{color:#f7f9f5}\n.hidden-field,.point-slot{position:absolute!important;width:0!important;height:0!important;overflow:hidden!important;clip-path:inset(50%)}\n.point-slot>span{position:absolute;inset:0;opacity:0}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%}.header{min-height:32px;padding:4px 7px}.sport-tag{font-size:12px}.stat{padding:0 5px;font-size:9px}.stat-value{font-size:11px}.lane{grid-template-columns:5px 52px minmax(0,1fr) 35px;min-height:68px}.tick{margin:3px 1px}.primary-score{font-size:26px}.caption{font-size:9px}.name{padding:0 9px;font-size:clamp(13px,3.8vw,24px)}.support-value{font-size:23px}}\n@media(max-width:450px){.header{flex-wrap:wrap;gap:2px}.status{width:100%;justify-content:space-between}.stat:first-child{padding-left:0}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Basketball scoreboard\">\n<header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-static=\"true\">BASKETBALL</span><div class=\"status rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat\"><span data-osb-static=\"true\">CLOCK</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"clock\">00:00</span></span><span class=\"stat\"><span data-osb-static=\"true\">PERIOD</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></span><span class=\"stat\"><span data-osb-static=\"true\">SHOT</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"shotClock\">00</span></span></div></header>\n<div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\" data-osb-static=\"true\">POINTS</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</span><span class=\"caption\" data-osb-static=\"true\">FOULS</span></div><span class=\"hidden-field currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\" data-osb-static=\"true\">POINTS</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</span><span class=\"caption\" data-osb-static=\"true\">FOULS</span></div><span class=\"hidden-field currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n</div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</article></main></body></html>\n","css":""}
