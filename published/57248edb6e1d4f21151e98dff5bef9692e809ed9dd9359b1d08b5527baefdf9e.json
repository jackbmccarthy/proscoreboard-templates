{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Copper Slate Score Rail — Pickleball 2</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#1e2b35;font-weight:700}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{position:relative;width:min(84vw,1640px);container-type:inline-size;padding-bottom:22px}.surface{overflow:hidden;border:2px solid #9babb3;border-radius:7px;background:#dce4e8}.header{height:4.35cqw;display:flex;align-items:center;justify-content:center;background:#f4f5f2;border-bottom:5px solid #b98262}.sport{font-size:2.8cqw;line-height:1;white-space:nowrap}.lanes{display:flex;align-items:stretch;min-height:9.3cqw}.lane{display:flex;align-items:stretch;flex:1 1 0;min-width:0}.lane+.lane{border-left:2px solid #9babb3}.point-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3cqw;flex:0 0 17.7%;min-width:0;background:#252c33;color:#fff}.score{display:block;max-width:100%;font-size:5.2cqw;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums;text-align:center}.point-label{font-size:1.3cqw;line-height:1;white-space:nowrap}.identity{display:block;flex:0 0 2.7%;background:#b98262}.jerseyColorB{background:#79a7b5}.name-cell{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:0 1.8cqw}.name-wrap{display:flex;align-items:center;gap:6px;flex:1 1 0;min-width:0}.name{display:block;flex:1 1 0;min-width:0;font-size:3.2cqw;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}.serve{display:block;flex:0 0 12px;width:12px;height:12px;font-size:9px;line-height:12px;text-align:center}.match-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.25cqw;flex:0 0 13%;min-width:0;padding-right:.65cqw}.match-score{display:block;width:100%;font-size:3.35cqw;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums;text-align:center}.match-label{font-size:1.3cqw;line-height:1;color:#62717a}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:190px;max-width:90%;height:18px;font-size:11px;line-height:18px;text-align:center}.point-state{position:absolute;inset:0;background:#252c33;color:#fff}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:94vw;padding-bottom:18px}.surface{border-width:1px;border-radius:4px}.header{height:40px;border-bottom-width:3px}.sport{font-size:18px}.lanes{display:flex;flex-direction:column;min-height:0}.lane{flex:none;width:100%;height:74px}.lane+.lane{border-left:0;border-top:1px solid #9babb3}.point-cell{flex-basis:62px;gap:2px}.score{font-size:33px}.point-label,.match-label{font-size:10px}.identity{flex:0 0 8px}.name-cell{padding:0 10px}.name{font-size:19px}.match-cell{flex-basis:44px;gap:2px;padding-right:4px}.match-score{font-size:24px}.point-slot{height:15px;line-height:15px;font-size:10px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"surface columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><span class=\"sport\">PICKLEBALL</span></header><div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"point-cell\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"point-label\">POINTS</span></div><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-cell\"><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"match-cell\"><span class=\"match-label\">GAMES</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div>\n<div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"point-cell\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"point-label\">POINTS</span></div><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-cell\"><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"match-cell\"><span class=\"match-label\">GAMES</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div></div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
