{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Oxblood Ivory In-Row Rail 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:\"Arial Narrow\",Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(92vw,1120px);max-width:100%;height:338px;overflow:hidden;border:2px solid #7e7671;border-radius:5px;background:#eee9e2;color:#2b2a2b;container-type:inline-size}\n.sport-head{display:flex;align-items:center;justify-content:center;flex:0 0 15.5%;border-bottom:2px solid #7e7671}\n.sport-tag{display:block;overflow:hidden;font-size:clamp(14px,2.4cqw,28px);font-weight:700;letter-spacing:.35em;line-height:1;text-overflow:ellipsis;white-space:nowrap}\n.competitors{display:flex;flex:1 1 0;min-height:0;flex-direction:column}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0;min-width:0}\n.team+.team{border-top:2px solid #7e7671}\n.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0}\n.identity{display:block;flex:0 0 20px;align-self:stretch;margin:16px 0 16px 22px;background:#a42430}\n.jerseyColorB{background:#b59a5e}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;padding:0 42px;color:#2b2a2b;font-size:clamp(22px,5.5cqw,68px);font-stretch:condensed;font-weight:800;line-height:1.05;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.set-rail{display:flex;align-items:center;justify-content:flex-end;flex:0 0 16%;min-width:0;gap:22px;padding-right:28px;color:#81736e;font-size:clamp(17px,2.8cqw,34px);font-stretch:condensed;font-weight:800;white-space:nowrap}\n.set-score{display:block;min-width:1.6ch;max-width:45%;overflow:hidden;text-align:right;font-variant-numeric:tabular-nums;line-height:1}\n.points{display:flex;align-items:center;justify-content:center;flex:0 0 14.2%;min-width:0;background:#552f39;color:#fff}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(38px,8.1cqw,96px);font-weight:800;font-variant-numeric:tabular-nums;line-height:1;text-align:center;white-space:nowrap}\n.set-footer{display:flex;align-items:center;justify-content:center;flex:0 0 15.5%;border-top:2px solid #7e7671;color:#81736e;font-size:clamp(14px,2.6cqw,32px);font-stretch:condensed;font-weight:800;white-space:nowrap}\n.current-set{display:inline-block;min-width:1ch;max-width:5ch;overflow:hidden;margin-left:.35em;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:8px}\n .board{width:100%;height:138px;border-width:1px;border-radius:3px}\n .sport-head,.set-footer{border-width:1px;flex-basis:18%}\n .sport-tag{font-size:11px;letter-spacing:.18em}\n .team+.team{border-width:1px}\n .identity{flex-basis:5px;margin:8px 0 8px 7px}\n .name{padding:0 8px;font-size:clamp(15px,5cqw,22px)}\n .set-rail{flex-basis:20%;gap:3px;padding-right:6px;font-size:clamp(10px,2.8cqw,13px)}\n .points{flex-basis:17%}\n .score{font-size:clamp(26px,9cqw,38px)}\n .set-footer{font-size:12px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"sport-head\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span></div>\n  <div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"set-rail\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"set-rail\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n  </div>\n  <div class=\"set-footer\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
