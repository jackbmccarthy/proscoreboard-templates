{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Table Tennis — Violet Ash Open Register Lower Third</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--ash:#e7e8ec;--ink:#28323d;--rule:#b4bfc4;display:flex;flex-direction:column;width:min(86vw,1880px);min-width:0;overflow:hidden;border:1px solid var(--rule);border-radius:3px;background:var(--ash);color:var(--ink);container-type:inline-size}\n.sport-line{position:relative;display:flex;flex:0 0 auto;height:3.5cqw;align-items:center;padding:0 1.5cqw;border-bottom:1px solid var(--rule);font-size:2.25cqw;line-height:1;font-weight:700;white-space:nowrap}\n.sides{display:flex;min-width:0}\n.side{display:flex;flex:1 1 50%;min-width:0;min-height:10.6cqw;align-items:stretch}\n.side+.side{border-left:1px solid var(--rule)}\n.identity-wrap{display:flex;flex:0 0 5%;align-items:center;justify-content:center;padding:1.6cqw 0}\n.identity{display:block;flex:0 0 .78cqw;width:.78cqw;height:100%;min-width:5px;background:#2677a8}\n.jerseyColorB{background:#c45f66}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:.5cqw;padding:0 .8cqw}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.7cqw;line-height:1.04;font-weight:700}\n.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 .4cqw;width:.4cqw;height:.4cqw;min-width:5px;min-height:5px;border-radius:50%;background:var(--ink)}\n.register{display:flex;flex:0 0 25%;width:25%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:.45cqw;padding:.35cqw .5cqw;background:var(--ash)}\n.support,.primary{display:flex;flex:0 0 auto;width:100%;min-width:0;flex-direction:column;align-items:center;justify-content:center}\n.caption{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:1.25cqw;line-height:1;font-weight:700}\n.support-score,.primary-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.support-score{font-size:2.15cqw}.primary-score{font-size:4.65cqw}\n.point-slot{position:absolute;right:1%;top:0;width:17%;height:100%;font-size:.9cqw;font-weight:700;text-align:center}\n.point-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--ash)}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:94vw}.sport-line{height:27px;padding:0 7px;font-size:12px}.side{min-height:89px}.identity-wrap{flex-basis:5px;padding:8px 0}.identity{flex-basis:4px;width:4px}.name-lane{gap:2px;padding:0 3px}.name{font-size:14px}.serve{flex-basis:5px;width:5px;height:5px}.register{flex-basis:31%;width:31%;gap:3px;padding:2px}.caption{font-size:7px}.support-score{font-size:13px}.primary-score{font-size:30px}.point-slot{font-size:7px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"sport-line\"><span>TABLE TENNIS</span><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div><div class=\"sides rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-wrap\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"register\"><div class=\"support\"><span class=\"caption\">GAMES</span><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"primary\"><span class=\"caption\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div></div><div class=\"side rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-wrap\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"register\"><div class=\"support\"><span class=\"caption\">GAMES</span><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"primary\"><span class=\"caption\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div></article></main></body></html>\n","css":""}
