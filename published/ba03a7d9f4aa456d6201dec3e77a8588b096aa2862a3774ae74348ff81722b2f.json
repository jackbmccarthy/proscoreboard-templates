{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>softball stone gold broadcast 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#f4f4f0}body{font-family:Arial,sans-serif;font-weight:700}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;width:100%;padding:16px}.board{width:min(63vw,calc((100vh - 40px) * 2.4),1400px);container-type:inline-size;position:relative;display:flex;flex-direction:column;background:#273745;border:1px solid #75818c;border-radius:0;overflow:hidden}.header{display:flex;align-items:center;justify-content:space-between;height:6.55cqw;padding:0 2.4cqw;background:#ddc79f;color:#101d2b}.sport{font-size:4.8cqw;line-height:1;white-space:nowrap;max-width:100%}.column-label{font-size:4.05cqw;line-height:1;text-align:center;flex:0 0 23.7cqw;margin-right:-2.4cqw;border-left:1px solid #75818c}.competitors{display:flex;flex-direction:column;min-width:0}.competitor{display:flex;align-items:center;min-width:0;background:#273745;min-height:11.25cqw;}.competitor+.competitor{border-top:1px solid #75818c}.identity-tick{display:block;width:3px;height:8.8cqw;flex:none;background:#ddc79f;margin-left:2.35cqw;margin-right:4.2cqw}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.65cqw;line-height:1.08;color:#f4f4f0}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 23.7cqw;align-self:stretch;min-width:0;background:#101d2b;color:#fff;border-left:1px solid #75818c;gap:.5cqw}.run-label{font-size:2.8cqw;line-height:1;color:#f4f4f0}.score{display:block;width:100%;text-align:center;font-size:7.7cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.stats{display:flex;align-items:center;min-height:10.2cqw;border-top:1px solid #75818c;background:#ddc79f;color:#101d2b;padding:1.25cqw 0}.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:.45cqw;min-height:7.6cqw}.stat+.stat{border-left:1px solid #75818c}.stat-label{font-size:2.4cqw;line-height:1;white-space:nowrap}.stat-number{font-size:4.5cqw;line-height:1;font-variant-numeric:tabular-nums}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:100%}.header{min-height:36px;padding:0 14px}.sport{font-size:16px}.column-label{font-size:12px}.competitor{min-height:56px}.identity-tick{height:42px}.name{font-size:21px}.score{font-size:33px}.stats{min-height:64px;padding:8px 0}.stat{gap:4px;min-height:30px}.stat-label{font-size:11px}.stat-number{font-size:19px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-static=\"true\">SOFTBALL</span><span class=\"column-label\" data-osb-static=\"true\">RUNS</span></header><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
