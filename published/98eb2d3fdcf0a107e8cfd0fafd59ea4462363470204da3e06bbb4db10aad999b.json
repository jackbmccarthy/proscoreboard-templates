{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Coral Slate Header Volleyball — Horizontal Lanes</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f4f5f3; }\n.stage { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }\n.board { width: 100%; max-width: 560px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #59656a; border-radius: 6px; background: #1d2226; }\n.sport-title { display: flex; align-items: center; justify-content: center; min-height: 22px; padding: 3px 12px; background: #e68a72; color: #1d2226; font-size: 17px; line-height: 1; font-weight: 700; white-space: nowrap; }\n.lanes { display: flex; min-height: 52px; }\n.team { display: flex; align-items: stretch; flex: 1 1 0; }\n.team + .team { border-left: 1px solid #59656a; }\n.identity { display: flex; align-items: center; flex: 1 1 0; gap: 8px; padding: 7px 6px; }\n.tick { display: block; width: 24px; flex: 0 0 24px; height: 32px; background: #e68a72; clip-path: path(\"M0 0H4V32H0Z M10 0H14V32H10Z M20 0H24V32H20Z\"); }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23px; font-weight: 700; line-height: 1; color: #f4f5f3; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex: 0 0 18%; }\n.points-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; flex: 0 0 24%; margin: 3px 4px 3px 0; background: #30383d; color: #fff; }\n.label { display: block; font-size: 12px; font-weight: 700; line-height: 1; }\n.match-score, .primary-score { display: block; width: 100%; text-align: center; font-size: 21px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { font-size: 32px; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 21px; border-top: 1px solid #59656a; }\n.footer-frame { display: flex; align-items: center; justify-content: center; height: 18px; gap: 9px; padding: 0 11px; border-left: 1px solid #59656a; border-right: 1px solid #59656a; }\n.footer-label { font-size: 13px; font-weight: 700; line-height: 1; color: #e68a72; }\n.set-value { display: block; width: 20px; font-size: 18px; font-weight: 700; line-height: 1; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .lanes { flex-direction: column; }\n  .team { flex-basis: auto; min-height: 52px; }\n  .team + .team { border-left: 0; border-top: 1px solid #59656a; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"sport-title\">VOLLEYBALL</header>\n      <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n      </div>\n      <footer class=\"set-footer\"><span class=\"footer-frame\"><span class=\"footer-label\">SET</span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
