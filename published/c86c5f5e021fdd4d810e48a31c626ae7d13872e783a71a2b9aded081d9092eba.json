{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Lower Third — Split Plates</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.stage{position:fixed;inset:0;display:flex;align-items:flex-end;justify-content:flex-start;padding:0 0 4.4vw 4.2vw;pointer-events:none}\n.board{font-size:calc(100vw / 80);font-family:var(--font);color:var(--ink);display:flex;flex-direction:column;width:max-content;max-width:91vw;-webkit-font-smoothing:antialiased}\n.head{display:flex;align-items:center;justify-content:space-between;gap:1.4em;height:2em;padding:0 .9em;font-size:.95em;font-weight:700;letter-spacing:.08em;text-transform:uppercase}\n.status{display:flex;align-items:center;gap:.5em;flex:0 0 auto}\n.gtag{display:inline-flex;align-items:center;gap:.3em;height:1.5em;padding:0 .6em;border-radius:.2em;font-size:.9em;font-weight:800;letter-spacing:.1em;white-space:nowrap}\n.state{width:8.6em;height:1.5em}\n.st{border-radius:.2em;font-size:.9em;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.main{display:flex;align-items:stretch}\n.players{display:flex;flex-direction:column;flex:1 1 auto;min-width:22em}\n.row{display:flex;align-items:center;gap:.6em;height:3.25em;padding:0 .7em 0 0;min-width:0}\n.chip{flex:0 0 .45em;align-self:stretch;background:var(--chip-default,#8a96a3)}\n.flag{flex:0 0 auto;width:2.1em;height:1.4em;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.who{display:flex;flex-direction:column;justify-content:center;flex:1 1 auto;min-width:0}\n.name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:1.4em;line-height:1.06;font-weight:800;letter-spacing:.01em;text-transform:uppercase;overflow-wrap:break-word}\n.team{display:flex;align-items:center;gap:.4em;min-width:0;font-size:.9em;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.85}\n.tlogo{width:1.3em;height:1.3em;object-fit:contain}\n.tname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.tscore{padding:0 .4em;border-radius:.2em;background:rgba(255,255,255,.18);font-variant-numeric:tabular-nums}\n.who:has(.name:empty) .team{font-size:1.2em;opacity:1}\n.who:has(.name:empty) .tname{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.05}\n.marks{display:flex;align-items:center;gap:.25em;flex:0 0 auto}\n.to-slot{width:2.3em;height:1.35em}\n.to-on,.to-used{border-radius:.2em;font-size:.82em;font-weight:900;letter-spacing:.04em}\n.to-on{background:var(--to,#ffd23f);color:#111}\n.to-used{border:.12em solid currentColor;opacity:.75}\n.card-slot{width:.95em;height:1.35em}\n.card{border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.yc{background:#ffd400}.rc{background:#e3262f}\n.srv{flex:0 0 1.15em;display:flex;align-items:center;justify-content:center}\n.srv-ball{display:block;width:1.05em;height:1.05em;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 18%,var(--ball,#ff8a1c) 46%,var(--ball-edge,#d65f00) 100%);box-shadow:0 0 0 .14em rgba(0,0,0,.25)}\n.scores{display:flex;align-items:stretch}\n.col,.hcol{display:flex;flex-direction:column}\n.cell,.hc{display:flex;align-items:center;justify-content:center;height:3.25em;font-variant-numeric:tabular-nums;font-weight:800;line-height:1}\n.hcol{width:2.3em}\n.hc>*{font-size:1.15em}\n.gcol{width:3em}.gcol .cell>*{font-size:1.7em}\n.pcol{width:3.7em}.pcol .cell>*{font-size:2.2em}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .5em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.head:not(:has(.meta>:not(.sep):not(:empty))),.band:not(:has(.meta>:not(.sep):not(:empty))),.top:not(:has(.meta>:not(.sep):not(:empty))){display:none}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.team:not(:has(.tname:not(:empty))){display:none}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])) .hcol:not([style*=\"display: none\"]):not([style*=\"display:none\"]):not(:has(~ .hcol:not([style*=\"display: none\"]):not([style*=\"display:none\"])))>*>*{opacity:.4}\n.t-plates{--font:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;--ink:#101828;filter:drop-shadow(0 .3em .8em rgba(0,0,0,.35))}\n.t-plates .head{align-self:flex-start;gap:1em;height:2.1em;margin-bottom:.35em;padding:0 .4em 0 1em;border-radius:.35em;background:#101828;color:#fff}\n.t-plates .players,.t-plates .col,.t-plates .hcol{gap:.35em}\n.t-plates .row{background:#fff;border-radius:.35em 0 0 .35em;overflow:hidden}\n.t-plates .hcol{background:transparent}\n.t-plates .hc{background:#f1f3f7;color:#5b6577;border-left:1px solid #dde2ea}\n.t-plates .gcol .cell{background:#101828;color:#fff}\n.t-plates .pcol .cell{background:#e4002b;color:#fff;border-radius:0 .35em .35em 0}\n.t-plates .tscore{background:#e7eaf0}\n.t-plates .to-on{background:#101828;color:#fff}\n.t-plates .srv-ball{box-shadow:0 0 0 .14em rgba(16,24,40,.15)}\n.t-plates .gtag{background:#fff;color:#101828}\n.t-plates .st-warm,.t-plates .st-break{background:transparent;color:#fff;box-shadow:inset 0 0 0 .12em #fff}\n.t-plates .st-gp{background:#ff8a1c;color:#111}\n.t-plates .st-mp{background:#e4002b;color:#fff}\n.t-plates .st-final{background:#fff;color:#101828}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.eventName.ev,.sep.s1,.matchRound.rd,.sep.s2,.matchFormatLabel.bestOf.bo,.isMatchStarted.gtag,.currentGame.cg,.isComplete.st.st-final,.isMatchPoint.st.st-mp,.isATimeOutActive.to-on,.isBTimeOutActive.to-on,.isGamePoint.st.st-gp,.isATimeOutUsed.to-used,.isBTimeOutUsed.to-used,.isWarmUpStarted.st.st-warm,.isInBetweenGames.st.st-break{font-size:1.25vw!important}\n/* end stream-size floor */\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-plates\" data-osb-component=\"layout\"><div class=\"head\" data-osb-component=\"layout\"><span class=\"meta\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep s1\">·</i><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep s2\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span><span class=\"status\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"slot state\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isComplete st st-final\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></span></div><div class=\"main\" data-osb-component=\"layout\"><div class=\"players\" data-osb-component=\"layout\"><div class=\"row rA\" data-osb-component=\"layout\"><span class=\"jerseyColorA chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"who\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span><span class=\"marks\"><span class=\"slot to-slot\"><span class=\"isATimeOutActive to-on\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\">T/O</span><span class=\"isATimeOutUsed to-used\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"opacity:0\">T</span></span><span class=\"slot card-slot\"><span class=\"isAYellowCarded card yc\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\"></span></span><span class=\"slot card-slot\"><span class=\"isARedCarded card rc\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" 