\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"hc\"><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"hcol isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"hc\"><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"hcol isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"hc\"><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"hcol isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"hc\"><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"hcol isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"hc\"><span class=\"game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"hcol isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"hc\"><span class=\"game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"hcol isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"hc\"><span class=\"game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"hc\"><span class=\"game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div><div class=\"col gcol\" data-osb-component=\"layout\"><span class=\"cell\"><span class=\"currentAMatchScore AScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"cell\"><span class=\"currentBMatchScore BScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span></div><div class=\"col pcol\" data-osb-component=\"layout\"><span class=\"cell\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></span><span class=\"cell\"><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span></div></div></div></article></main>\n</body>\n</html>\n","css":""}
