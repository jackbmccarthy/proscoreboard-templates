{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Stone Gold Broadcast Volleyball — Horizontal Lanes</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f4f4f0; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 650px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #75818c; background: #273745; }\n.sport-title { display: flex; align-items: center; justify-content: center; min-height: 24px; padding: 3px 12px; border-bottom: 1px solid #75818c; background: #ddc79f; color: #101d2b; font-size: 20px; font-weight: 700; line-height: 1; white-space: nowrap; }\n.lanes { display: flex; min-height: 62px; }\n.team { display: flex; align-items: stretch; flex: 1 1 0; }\n.team + .team { border-left: 1px solid #75818c; }\n.identity { display: flex; align-items: center; flex: 1 1 0; gap: 10px; padding: 8px 12px; }\n.tick { display: block; width: 3px; flex: 0 0 3px; height: 32px; background: #ddc79f; }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25px; font-weight: 700; line-height: 1; color: #f4f4f0; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex: 0 0 23.5%; border-left: 1px solid #75818c; }\n.points-track { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; flex: 0 0 28.5%; background: #101d2b; color: #fff; }\n.label { display: block; font-size: 12px; font-weight: 700; line-height: 1; }\n.match-score, .primary-score { display: block; width: 100%; text-align: center; font-size: 22px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { font-size: 34px; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 27px; gap: 12px; border-top: 1px solid #75818c; background: #ddc79f; color: #101d2b; font-size: 15px; font-weight: 700; line-height: 1; }\n.footer-separator { display: block; width: 1px; height: 17px; background: #75818c; }\n.set-value { display: block; width: 24px; font-size: 20px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 700px) {\n  .stage { padding: 14px; }\n  .lanes { flex-direction: column; }\n  .team { flex-basis: auto; min-height: 62px; }\n  .team + .team { border-left: 0; border-top: 1px solid #75818c; }\n  .identity { padding-left: 9px; padding-right: 7px; }\n  .name { font-size: 24px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"sport-title\">VOLLEYBALL</header>\n      <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"sets-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n      </div>\n      <footer class=\"set-footer\"><span>SET</span><span class=\"footer-separator\" aria-hidden=\"true\"></span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
