{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Spike Slash</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.25)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing{animation:none!important;transition:none!important}}\n.clamp2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;line-height:1.02}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.sslot{align-items:center}.sslot>.st{display:flex;align-items:center;justify-content:center;gap:.4em;white-space:nowrap;height:100%}\n.pslot>.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hist:not(:has(>[style*=\"opacity: 1\"])){display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .srv[style*=\"opacity: 1\"]{opacity:.3!important;filter:grayscale(1)}\n.pip{position:relative;display:block}.pip>.lit{position:absolute;inset:0;border-radius:inherit}\n\n.stage{position:fixed;left:0;right:0;bottom:4.2rem;display:flex;justify-content:center}\n.board{position:relative;width:100rem;font-family:\"DIN Condensed\",\"Bahnschrift SemiBold Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;color:#fff}\n.evt{display:flex;justify-content:center;gap:.5rem;margin-bottom:.4rem}\n.ctx{display:flex;align-items:center;gap:.7rem;height:3rem;padding:.35rem 2.2rem 0;background:#1d1446;color:#d9d2ff;font-size:1.7rem;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;clip-path:polygon(1.2rem 0,100% 0,calc(100% - 1.2rem) 100%,0 100%)}.ctx .sep{font-style:normal;color:#ff2e88}\n.band{display:flex;align-items:stretch;height:7rem;filter:drop-shadow(0 .5rem 1rem #0009)}\n.side{position:relative;flex:1;min-width:0;display:flex;align-items:stretch;background:#2a1d66}\n.sA{clip-path:polygon(2.4rem 0,100% 0,100% 100%,0 100%)}.sB{flex-direction:row-reverse;clip-path:polygon(0 0,calc(100% - 2.4rem) 0,100% 100%,0 100%)}\n.chip{width:1.2rem;flex:none}.sA .chip{margin-left:2.4rem}.sB .chip{margin-right:2.4rem}\n.who{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.5rem;padding:.3rem 1.2rem 0}.sB .who{align-items:flex-end;text-align:right}\n.nm{max-width:100%;padding-right:.3em;font-size:2.9rem;font-weight:700;text-transform:uppercase;font-style:italic}.sB .nm{padding:0 0 0 .3em}\n.srv{width:3.4rem;flex:none;display:flex;align-items:center;justify-content:center}.vball{width:2.3rem;height:2.3rem}\n.pips{display:flex;gap:.5rem;flex:none;padding-left:.3rem}.pip{width:2rem;height:.6rem;transform:skewX(-20deg);background:#ffffff2b}.pip>.lit{background:#ff2e88}\n.sets{width:5rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.4rem;background:#1d1446;color:#ff5fa8;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.3rem;font-weight:700}\n.pts{width:8rem;flex:none;display:flex;align-items:center;justify-content:center;padding-top:.4rem;background:#fff;color:#1d1446;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:5rem;font-weight:700}\n.mid{width:13rem;flex:none;display:flex;margin:0 -.1rem;background:#ff2e88;clip-path:polygon(0 0,100% 0,100% 100%,0 100%)}\n.sslot{flex:1}.sslot>.st{flex-direction:column;gap:0;padding-top:.45rem;font-size:2rem;letter-spacing:.1em;line-height:1;text-align:center;white-space:normal;background:#ff2e88;font-style:italic}.sslot .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.2rem;font-weight:700;display:block;font-style:normal}\n.sslot>.sdec{background:#ffd23f;color:#1d1446}.sslot>.sbrk{background:#1d1446}.sslot>.sbrk .num{font-size:2.8rem}.sslot>.sfin{background:#fff;color:#1d1446;font-size:2.9rem}\n.tob{position:absolute;bottom:100%;margin-bottom:.4rem;display:flex;align-items:center;gap:.7rem;height:3rem;padding:.35rem 1.4rem 0;background:#ff2e88;color:#fff;font-size:1.8rem;letter-spacing:.08em;white-space:nowrap;clip-path:polygon(.9rem 0,100% 0,calc(100% - .9rem) 100%,0 100%)}.sA .tob{left:3rem}.sB .tob{right:3rem}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.2rem}\n.side{overflow:visible}.sA,.sB{clip-path:none}\n.sA{background:linear-gradient(105deg,transparent 0 2.4rem,#2a1d66 2.4rem)}.sB{background:linear-gradient(-105deg,transparent 0 2.4rem,#2a1d66 2.4rem)}\n.foot{display:flex;justify-content:center;margin-top:.4rem;height:3rem}\n.hist{display:flex;align-items:center;gap:.4rem;font-size:1.7rem}\n.hc{display:flex;align-items:center;gap:.35rem;height:3rem;padding:.35rem 1.2rem 0;background:#1d1446e6;color:#d9d2ff;clip-path:polygon(.7rem 0,100% 0,calc(100% - .7rem) 100%,0 100%)}.hc .hl{font-weight:400;color:#9c8fe0;margin-right:.3rem}.hc .num{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-weight:700;font-size:1.9rem}.hc .hd{font-style:normal;color:#9c8fe0}\n.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])){background:#ff2e88;color:#fff}.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])) .hl,.hist>.hc[style*=\"opacity: 1\"]:not(:has(~.hc[style*=\"opacity: 1\"])) .hd{color:#ffd1e6}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .hist>.hc,.board:has(.isComplete[style*=\"opacity: 1\"]) .hist>.hc{background:#1d1446e6!important;color:#fff!important}\n.pslot{position:absolute;left:50%;transform:translateX(-50%);bottom:100%;margin-bottom:.4rem}.pt{height:3rem;padding:.35rem 1.8rem 0;font-size:2rem;letter-spacing:.1em;background:#ffd23f;color:#1d1446;clip-path:polygon(.9rem 0,100% 0,calc(100% - .9rem) 100%,0 100%)}.pt.mp{background:#ff2e88;color:#fff}\n.board:has(.isGamePoint[style*=\"opacity: 1\"]) .evt,.board:has(.isMatchPoint[style*=\"opacity: 1\"]) .evt{visibility:hidden}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"evt\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"ctx\"><span class=\"eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span></div>\n<div class=\"band\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side sA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"who\"><span class=\"nm clamp2 combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity:0\"></b></i></span></span><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"sets num setsWonA currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"pts num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"tob isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"tclock num timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span></div><div class=\"mid\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"slot sslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span></span></div><div class=\"side sB\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"who\"><span class=\"nm clamp2 combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity:0\"></b></i></span></span><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"sets num setsWonB currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"pts num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"tob isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"tclock num timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></div></div>\n<div class=\"foot\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"hist\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"hc  isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><b class=\"hl\">S1</b><span class=\"ha num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span><span class=\"hc  isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><b class=\"hl\">S2</b><span class=\"ha num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span><span class=\"hc  isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><b class=\"hl\">S3</b><span class=\"ha num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span><span class=\"hc  isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><b class=\"hl\">S4</b><span class=\"ha num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span><span class=\"hc  isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><b class=\"hl\">S5</b><span class=\"ha num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><i class=\"hd\">-</i><span class=\"hb num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div></div>\n<span class=\"slot pslot\"><span class=\"pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"osb-core-fields\"><span class=\"num timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\">0</span><span class=\"num timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\">0</span></span></section></main>\n</body>\n</html>\n","css":""}
