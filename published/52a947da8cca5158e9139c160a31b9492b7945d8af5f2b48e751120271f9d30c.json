{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Champagne Graphite Columnrail — basketball 1</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { color: #f7f5f0; font-family: Arial, Helvetica, sans-serif; padding: 24px 12px; }\n    .board { width: min(100%, 1300px); margin: 0 auto; background: #2b3036; container-type: inline-size; }\n    .header { min-height: 96px; padding: 0 28px; display: flex; justify-content: space-between; align-items: center; gap: 18px; background: #d8c9ae; color: #2b3036; }\n    .sport { font-size: 47px; font-weight: 800; letter-spacing: -.035em; line-height: 1; }\n    .status { display: flex; align-items: stretch; white-space: nowrap; }\n    .header-stat { min-width: 132px; padding: 0 22px; border-left: 1px solid #67737b; display: flex; flex-direction: column; text-align: center; justify-content: center; }\n    .header-stat:first-child { border-left: 0; }\n    .header-stat span { font-size: 16px; font-weight: 700; line-height: 1.1; }\n    .header-stat strong { font-size: 35px; color: #111; line-height: 1; font-variant-numeric: tabular-nums; }\n    .lanes { display: grid; grid-template-columns: minmax(0,1fr); }\n    .lane { min-width: 0; height: 134px; display: grid; grid-template-columns: 28px minmax(0,1fr) 218px 312px; align-items: stretch; background: #2b3036; }\n    .lane + .lane { border-top: 1px solid #67737b; }\n    .identity { display: block; width: 28px; height: 100%; background: #2b8aa8; }\n    .side-b .identity { background: #d06461; }\n    .team-name { display: flex; align-items: center; min-width: 0; padding: 0 28px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 65px; line-height: 1; font-weight: 700; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .rail { display: flex; flex-direction: column; justify-content: center; align-items: center; min-width: 0; border-left: 1px solid #67737b; font-variant-numeric: tabular-nums; }\n    .rail .number { display: block; min-width: 0; max-width: 100%; overflow: hidden; white-space: nowrap; line-height: 1; }\n    .support .number { font-size: 56px; font-weight: 700; }\n    .primary .number { font-size: 84px; font-weight: 800; }\n    .caption { color: #d5d7d8; font-size: 21px; font-weight: 700; line-height: 1.15; }\n    .runtime-auxiliary, .point-slot { display: none; }\n    .point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint { opacity: 0 !important; }\n    @media (max-width: 900px) {\n      .header { min-height: 55px; padding: 0 14px; }\n      .sport { font-size: clamp(18px, 4vw, 30px); }\n      .header-stat { min-width: 0; padding: 0 8px; gap: 5px; }\n      .header-stat span { font-size: clamp(9px, 1.7vw, 14px); }\n      .header-stat strong { font-size: clamp(13px, 2.8vw, 24px); }\n      .lane { height: 88px; grid-template-columns: 8px minmax(0,1fr) 72px 96px; }\n      .identity { width: 8px; }\n      .team-name { padding: 0 12px; font-size: clamp(18px, 4vw, 32px); }\n      .support .number { font-size: 28px; }\n      .primary .number { font-size: 43px; }\n      .caption { font-size: 11px; }\n    }\n    @media (max-width: 600px) {\n      body { padding: 10px 6px; }\n      .header { min-height: 48px; }\n      .sport { font-size: 16px; }\n      .header-stat { padding: 0 5px; }\n      .header-stat span { font-size: 8px; }\n      .header-stat strong { font-size: 13px; }\n\n      .lane { height: 72px; grid-template-columns: 6px minmax(0,1fr) 53px 72px; }\n      .identity { width: 6px; }\n      .team-name { padding: 0 8px; font-size: 20px; }\n      .support .number { font-size: 23px; }\n      .primary .number { font-size: 34px; }\n      .caption { font-size: 9px; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"basketball scoreboard\">\n    <header class=\"header\">\n      <span class=\"sport sport-tag\">BASKETBALL</span>\n      <div class=\"status\"><div class=\"header-stat\"><span>CLOCK</span><strong data-osb-static=\"true\" data-sport-stat=\"gameClock\">00:00</strong></div><div class=\"header-stat\"><span>PERIOD</span><strong data-osb-static=\"true\" data-sport-stat=\"period\">0</strong></div><div class=\"header-stat\"><span>SHOT</span><strong data-osb-static=\"true\" data-sport-stat=\"shotClock\">00</strong></div></div>\n    </header>\n    <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lane side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n      <span class=\"team-name name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n      <div class=\"rail support\"><span class=\"number\" data-osb-static=\"true\" data-sport-stat=\"foulsA\">0</span><span class=\"caption\">FOULS</span></div>\n      <div class=\"rail primary\"><span class=\"number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n    </div>\n    <div class=\"lane side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n      <span class=\"team-name name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n      <div class=\"rail support\"><span class=\"number\" data-osb-static=\"true\" data-sport-stat=\"foulsB\">0</span><span class=\"caption\">FOULS</span></div>\n      <div class=\"rail primary\"><span class=\"number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n    </div>\n    </div>\n    <div class=\"runtime-auxiliary\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n    <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n  </article>\n</body>\n</html>\n","css":""}
