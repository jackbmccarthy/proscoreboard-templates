{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Oxblood Ivory In-Row Rail 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:\"Arial Narrow\",Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(96vw,1698px);max-width:100%;aspect-ratio:8.49;overflow:hidden;border:2px solid #7e7671;background:#eee9e2;color:#2b2a2b;container-type:inline-size}\n.pair{display:flex;flex:1 1 0;min-height:0;min-width:0}\n.side{display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.side+.side{border-left:2px solid #7e7671}\n.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;padding-left:18px}\n.identity{display:block;flex:0 0 18px;height:56px;background:#be6576;border:2px solid #7e7671}\n.jerseyColorB{background:#d6808e}\n.name-block{display:flex;flex:1 1 0;min-width:0;flex-direction:column;justify-content:center;gap:10px;padding:0 18px}\n.sport-tag{display:block;overflow:hidden;color:#81736e;font-size:clamp(12px,1.55cqw,26px);font-weight:750;letter-spacing:.02em;line-height:1;text-overflow:ellipsis;white-space:nowrap}\n.name{display:block;min-width:0;overflow:hidden;font-size:clamp(24px,4.5cqw,70px);font-stretch:condensed;font-weight:800;line-height:1;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.side-b .name-block{padding-top:26px}\n.set-rail{display:flex;align-items:center;justify-content:center;flex:0 0 21%;min-width:0;gap:27px;color:#81736e;font-size:clamp(16px,2.4cqw,35px);font-stretch:condensed;font-weight:800;white-space:nowrap}\n.set-score{display:block;min-width:1.5ch;max-width:40%;overflow:hidden;text-align:right;font-size:1.55em;font-variant-numeric:tabular-nums;line-height:1}\n.points{display:flex;align-items:center;justify-content:center;flex:0 0 20.5%;min-width:0;background:#552f39;color:#fff}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(44px,7.3cqw,113px);font-weight:800;font-variant-numeric:tabular-nums;line-height:1;text-align:center;white-space:nowrap}\n.set-footer{display:flex;align-items:center;justify-content:center;flex:0 0 28%;border-top:2px solid #7e7671;color:#81736e;font-size:clamp(16px,2.5cqw,36px);font-stretch:condensed;font-weight:800;white-space:nowrap}\n.current-set{display:inline-block;min-width:1ch;max-width:5ch;overflow:hidden;margin-left:.35em;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){\n .stage{padding:6px}\n .board{width:100%;height:108px;aspect-ratio:auto;border-width:1px}\n .side+.side,.set-footer{border-width:1px}\n .name-lane{padding-left:5px}\n .identity{flex-basis:5px;height:33px;border-width:1px}\n .name-block{gap:4px;padding:0 5px}\n .sport-tag{font-size:9px}\n .name{font-size:clamp(12px,4cqw,17px)}\n .side-b .name-block{padding-top:13px}\n .set-rail{flex-basis:22%;gap:3px;font-size:clamp(8px,2.2cqw,11px)}\n .set-score{font-size:1.4em}\n .points{flex-basis:23%}\n .score{font-size:clamp(25px,7.7cqw,34px)}\n .set-footer{font-size:14px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Horizontal volleyball scoreboard with generic manual scoring\">\n  <div class=\"pair rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"side side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-block\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div></div><div class=\"set-rail\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n   <div class=\"side side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-block\" data-osb-component=\"layout\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div></div><div class=\"set-rail\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n  </div>\n  <div class=\"set-footer\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
