{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Ivory Cobalt Line TABLE TENNIS 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#152842}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--view-width),var(--max-width),var(--height-width));position:relative;container-type:inline-size;background:transparent;padding-bottom:3cqw}.desk{width:100%;min-width:0;background:#faf9f3;border:2px solid #1557b0;border-radius:2px;overflow:hidden}.row,.lane,.name-cell,.name-wrap{min-width:0}.name-wrap{display:flex;align-items:center;gap:.7cqw;flex:1 1 0}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{display:block;background:#1557b0;flex-shrink:0}.serve{display:block;flex:0 0 1.2cqw;width:1.2cqw;font-size:1.2cqw;line-height:1;text-align:center}.label{font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.score,.match-score{display:block;width:100%;font-size:var(--score-font);line-height:1.1;text-align:center;white-space:nowrap;font-variant-numeric:tabular-nums}.match-score{font-size:var(--match-font)}.game-cell{background:#e4ecf8;color:#152842}.point-cell{background:#1557b0;color:#fff}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:36cqw;height:2cqw;font-size:1.5cqw;text-align:center}.point{position:absolute;inset:0;background:#152842;color:#fff}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:65vw;--max-width:1200px;--height-width:240vh;--name-font:5.7cqw;--score-font:7.3cqw;--match-font:5.7cqw;--label-font:3.25cqw;--games-width:17.5%;--points-width:23%}.header{display:flex;align-items:center;min-height:7cqw;border-bottom:1px solid #587089;background:#fff}.title{flex:1;min-width:0;font-size:4.4cqw;padding-left:2.7cqw}.header .games,.game-cell{flex:0 0 var(--games-width)}.header .points,.point-cell{flex:0 0 var(--points-width)}.header .games{border-left:0;align-self:stretch;display:flex;align-items:center;justify-content:center}.header .points{border-left:0;align-self:stretch;display:flex;align-items:center;justify-content:center}.row{display:flex;align-items:stretch;min-height:11.1cqw}.row+.row{border-top:1px solid #587089}.name-cell{flex:1 1 0;display:flex;align-items:center;gap:2.4cqw;padding:.25cqw .3cqw}.identity{width:2.2cqw;height:10.2cqw}.name-cell .name-wrap{padding-left:0cqw}.game-cell,.point-cell{display:flex;align-items:center;justify-content:center;border-left:1px solid #587089}@media(max-width:600px){.board{--view-width:94vw}.title{font-size:4.2cqw}.name{font-size:6cqw}.point-slot{font-size:2cqw;height:2.3cqw}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><div class=\"title\">TABLE TENNIS</div><div class=\"label games\">GAMES</div><div class=\"label points\">POINTS</div></header><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
