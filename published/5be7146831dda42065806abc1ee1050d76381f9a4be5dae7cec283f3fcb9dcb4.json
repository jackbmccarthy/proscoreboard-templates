{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Charcoal Outline Sidecar 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.shell{position:relative;width:min(95vw,1690px);max-width:100%;padding-top:32px;container-type:inline-size}\n.sport-tag{position:absolute;top:0;left:0;display:flex;align-items:center;justify-content:center;width:261px;max-width:42%;height:32px;background:#dce3e2;color:#20272c;font-size:25px;font-weight:800;line-height:1;white-space:nowrap}\n.board{display:flex;width:100%;height:max(108px,8.7cqw);overflow:hidden;background:#20272c;color:#f2f3ee;border-radius:2px}\n.team{display:flex;align-items:center;flex:1 1 0;min-width:0}\n.team+.team{border-left:2px solid #a8b8bc}\n.identity{display:block;flex:0 0 2.2%;height:100%;background:#0e87eb}\n.jerseyColorB{background:#f22e39}\n.name{display:block;align-content:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 4%;font-size:4.3cqw;font-weight:700;line-height:1.05;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.score-track{display:flex;align-items:center;justify-content:center;flex:0 0 29%;flex-direction:column;height:97%;min-width:0;margin-right:2%;border:1px solid #a8b8bc;background:#20272c}\n.score-label{font-size:1.4cqw;font-weight:700;line-height:1;white-space:nowrap;color:#dce3e2}\n.score{display:block;color:#fff;font-size:5.3cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.dock{display:flex;align-items:center;justify-content:center;flex:0 0 19.5%;gap:0;min-width:0;padding:1.1%;background:#dce3e2;color:#20272c}\n.sets{display:flex;flex:1 1 0;flex-direction:column;min-width:0}\n.sets-heading{font-size:1.6cqw;font-weight:800;line-height:1;white-space:nowrap}\n.sets-values{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0}\n.set-won{display:flex;align-items:center;flex:1 1 0;flex-direction:column;min-width:0;padding:0 1%;border-right:1px solid #7e958f}\n.set-score{font-size:3.5cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}\n.set-side{font-size:1.1cqw;font-weight:700;line-height:1.1;white-space:nowrap}\n.current-set{display:flex;align-items:center;justify-content:center;flex:0 0 31%;flex-direction:column;gap:.4cqw;min-width:0}\n.current-set-label{font-size:1.6cqw;font-weight:800;line-height:1}\n.current-set-value{font-size:3.5cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:8px}\n .shell{width:100%;padding-top:24px}\n .sport-tag{width:143px;height:24px;font-size:14px}\n .board{height:auto;flex-wrap:wrap}\n .team{flex:1 1 50%;height:108px}\n .team+.team{border-left-width:1px}\n .identity{flex-basis:4px}\n .name{padding:0 3px;font-size:clamp(11px,3.8cqw,16px)}\n .score-track{flex-basis:31%;height:78%;margin-right:3px}\n .score-label{font-size:8px}\n .score{font-size:clamp(20px,6cqw,26px)}\n .dock{flex:0 0 100%;height:52px;padding:4px 12px;border-top:1px solid #7e958f}\n .sets-heading,.current-set-label{font-size:11px}\n .set-score,.current-set-value{font-size:23px}\n .set-side{font-size:9px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <div class=\"shell\">\n  <span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span>\n  <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Volleyball scoreboard\">\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n    <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n    <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n   </div>\n   <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n    <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n    <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"score-label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n   </div>\n   <aside class=\"dock rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Sets won and editable current set\">\n    <div class=\"sets columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n     <span class=\"sets-heading\" data-osb-component=\"text\">SETS</span>\n     <div class=\"sets-values rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <div class=\"set-won columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"set-side\" data-osb-component=\"text\">Team A</span></div>\n      <div class=\"set-won columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"set-side\" data-osb-component=\"text\">Team B</span></div>\n     </div>\n    </div>\n    <div class=\"current-set columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"current-set-label\" data-osb-component=\"text\">SET</span><span class=\"current-set-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></div>\n   </aside>\n   <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n  </article>\n </div>\n</main>\n</body>\n</html>\n","css":""}
