{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Ivory Moss Scorefront 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(96vw,1870px);max-width:100%;aspect-ratio:8.78;overflow:hidden;border:2px solid #b7c2bf;border-radius:8px;background:#f0eee8;color:#273643;container-type:inline-size}\n.head{display:flex;align-items:center;justify-content:space-between;flex:0 0 28%;min-width:0;padding:0 36px;background:#303f57;color:#fbfbf8}\n.sport-tag{display:block;min-width:0;overflow:hidden;font-size:clamp(20px,2.3cqw,45px);font-weight:800;letter-spacing:.03em;line-height:1;text-overflow:ellipsis;white-space:nowrap}\n.status{display:flex;align-items:center;align-self:stretch;gap:.35em;padding-left:41px;border-left:2px solid #fbfbf8;font-size:clamp(19px,2cqw,39px);font-weight:750;line-height:1;white-space:nowrap}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.pair{display:flex;flex:1 1 0;min-width:0;min-height:0}\n.side{display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.side+.side{border-left:2px solid #b7c2bf}\n.identity{display:block;flex:0 0 4.6%;align-self:stretch;background:#3c86df}\n.jerseyColorB{background:#f16b62}\n.points,.sets{display:flex;align-items:center;justify-content:center;min-width:0;flex-direction:column;gap:1px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.points{flex:0 0 16%;background:#f0eee8;color:#273643}\n.sets{flex:0 0 17%;margin:6px 0;border-radius:4px;background:#d9e0d3;color:#273643}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(42px,4cqw,76px);font-weight:800;line-height:1;text-align:center}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(34px,3.4cqw,64px);font-weight:800;line-height:1;text-align:center}\n.label{display:block;max-width:100%;overflow:hidden;font-size:clamp(12px,1.25cqw,23px);font-weight:750;line-height:1}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 34px;color:#273643;font-size:clamp(29px,3.7cqw,70px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){\n .stage{padding:6px}\n .board{width:100%;height:140px;aspect-ratio:auto;border-width:1px;border-radius:3px}\n .head{flex-basis:25%;padding:0 8px}\n .sport-tag{font-size:clamp(10px,2.8cqw,14px)}\n .status{padding-left:8px;border-width:1px;font-size:clamp(10px,2.8cqw,14px)}\n .side+.side{border-width:1px}\n .identity{flex-basis:5px}\n .points{flex-basis:21%}\n .sets{flex-basis:22%;margin:4px 0;gap:1px;border-radius:2px}\n .score{font-size:clamp(25px,6.8cqw,33px)}\n .set-score{font-size:clamp(21px,5.8cqw,28px)}\n .label{font-size:clamp(7px,2cqw,10px)}\n .name{padding:0 5px;font-size:clamp(12px,3.6cqw,17px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Horizontal volleyball scoreboard with generic manual scoring\">\n  <div class=\"head rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n  <div class=\"pair rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"side side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label\" data-osb-component=\"text\">POINTS</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"label\" data-osb-component=\"text\">SETS</span></div></div>\n   <div class=\"side side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"points\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label\" data-osb-component=\"text\">POINTS</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"label\" data-osb-component=\"text\">SETS</span></div></div>\n  </div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
