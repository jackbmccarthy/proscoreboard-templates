{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Table Tennis — Indigo Open Data Lane Scorebug</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--surface:#1b2d3b;--ink:#f0f2ed;--muted:#92b3b1;--line:#89acad;position:relative;display:flex;flex-direction:column;width:min(64vw,1280px);height:min(20.5vw,405px);min-width:0;min-height:0;border:1px solid var(--line);background:var(--surface);color:var(--ink);container-type:inline-size;overflow:visible}\n.headline{display:flex;flex:0 0 19%;min-height:0;align-items:center;justify-content:space-between;padding:0 2.8cqw;border-bottom:1px solid var(--line)}\n.sport-tag{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:2.75cqw;line-height:1;font-weight:700;letter-spacing:.015em}\n.headline-data{display:flex;flex:0 0 auto;align-items:center;color:var(--muted);font-size:1.75cqw;font-weight:700;letter-spacing:.04em}\n.competitors{display:flex;flex:1 1 auto;flex-direction:column;min-width:0;min-height:0}\n.side{display:flex;flex:1 1 50%;align-items:stretch;min-width:0;min-height:0}\n.side+.side{border-top:1px solid var(--line)}\n.identity-name{display:flex;flex:1 1 auto;min-width:0;align-items:center}\n.identity{display:block;flex:0 0 .8cqw;width:.8cqw;height:68%;margin-left:2.9cqw;background:#2d9edc}\n.jerseyColorB{background:#df4044}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:.55cqw;padding:0 2.8cqw}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-transform:uppercase;font-size:4.75cqw;line-height:1;font-weight:700;letter-spacing:.01em}\n.combinedAName:empty::before{content:'Player A'}.combinedBName:empty::before{content:'Player B'}\n.serve{display:block;flex:0 0 .6cqw;width:.6cqw;height:.6cqw;min-width:5px;min-height:5px;border-radius:50%;background:var(--muted)}\n.game-track{display:flex;flex:0 0 17%;min-width:0;align-items:center;justify-content:center;gap:1.7cqw;color:var(--muted);flex-direction:column;gap:.35cqw}\n.game-label,.point-label{display:block;flex:0 0 auto;font-size:1.8cqw;line-height:1;font-weight:700;letter-spacing:.03em;white-space:nowrap}\n.match-score{display:block;min-width:1.8ch;text-align:center;font-size:3.35cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.score-track{display:flex;flex:0 0 20%;min-width:0;align-items:center;justify-content:center;gap:1.45cqw;border-left:2px solid var(--line);flex-direction:column;gap:0;}\n.point-label{color:var(--muted);font-size:1.8cqw;}\n.primary-score{display:block;flex:0 1 auto;min-width:0;max-width:100%;overflow:hidden;white-space:nowrap;color:#fff;text-align:center;font-size:7.2cqw;line-height:1;font-weight:800;font-variant-numeric:tabular-nums}\n.point-slot{position:absolute;left:0;bottom:100%;width:150px;height:18px;color:#fff;text-align:center;font-size:10px;font-weight:700}\n.point-state{position:absolute;inset:0;display:block;padding:3px 4px;background:var(--surface);border:1px solid var(--line)}\n.point-slot:has(>.isMatchPoint[style*='opacity: 1'])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*='opacity:1'])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:96vw;height:190px;max-height:none}.headline{flex-basis:37px;padding:0 7px}.sport-tag{font-size:13px}.headline-data{font-size:9px}.identity{flex-basis:4px;width:4px;height:55%;margin-left:8px}.name-lane{gap:2px;padding:0 8px}.name{font-size:22px;letter-spacing:-.03em}.serve{flex-basis:5px;width:5px;height:5px}.game-track{flex-basis:68px;gap:2px;flex-direction:column}.game-label,.point-label{font-size:10px}.match-score{font-size:22px}.score-track{flex-basis:77px;gap:0;flex-direction:column}.primary-score{font-size:42px}.point-slot{height:16px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"headline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\">TABLE TENNIS</span><span class=\"headline-data\">GAMES</span></header><div class=\"competitors columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><section class=\"side side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-name\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div></div><div class=\"game-track\"><span class=\"game-label\">GAMES</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"score-track\"><span class=\"point-label\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"side side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-name\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div></div><div class=\"game-track\"><span class=\"game-label\">GAMES</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"score-track\"><span class=\"point-label\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section></div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
