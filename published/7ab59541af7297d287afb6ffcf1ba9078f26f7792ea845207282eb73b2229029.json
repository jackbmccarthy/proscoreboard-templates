{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Touchline Bug</title>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { margin: 0; background: transparent; }\n    body { padding: 24px 24px 44px; font-family: \"Avenir Next Condensed\", \"Arial Narrow\", Arial, sans-serif; }\n    .bug { position: relative; display: inline-flex; align-items: stretch; height: 46px; color: #fff; filter: drop-shadow(0 4px 10px #0009); }\n    .clock { position: relative; display: flex; align-items: center; gap: 8px; padding: 0 12px; background: #c8f560; color: #062b2f; border-radius: 4px 0 0 4px; }\n    .gc { font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .live { width: 8px; height: 8px; border-radius: 50%; background: #062b2f; animation: blink 1.6s ease-in-out infinite; }\n    @keyframes blink { 50% { opacity: .25; } }\n    .main { display: flex; align-items: stretch; background: #062b2f; border-radius: 0 4px 4px 0; }\n    .team { display: flex; align-items: center; gap: 8px; padding: 0 12px; }\n    .kit { width: 6px; height: 26px; border-radius: 1px; background-color: #3c6b70; }\n    .nm { max-width: 150px; font-size: 24px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .score { display: flex; align-items: center; gap: 6px; padding: 0 12px; background: #0b3d42; font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; }\n    .score .dash { color: #c8f560; font-size: 22px; }\n    .card { display: inline-flex; align-items: center; justify-content: center; width: 12px; height: 17px; border-radius: 2px; font-size: 10px; font-weight: 700; }\n    .card.red { background: #e5262b; color: #fff; }\n    .card.yellow { background: #f7d117; color: #062b2f; }\n    .cn { line-height: 1; }\n    .under { position: absolute; left: 0; top: 46px; display: flex; gap: 0; }\n    .half { padding: 3px 10px 2px; background: #0b3d42; color: #c8f560; font-size: 14px; font-weight: 700; letter-spacing: 1px; border-radius: 0 0 4px 4px; }\n    .half:empty { display: none; }\n    .added { padding: 3px 10px 2px; margin-left: 4px; background: #fff; color: #062b2f; font-size: 14px; font-weight: 700; border-radius: 0 0 4px 4px; }\n    .added:has(.at:empty) { display: none; }\n    .ht { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #c8f560; color: #062b2f; font-size: 24px; font-weight: 700; letter-spacing: 2px; border-radius: 4px 0 0 4px; }\n    .pens { display: none; }\n    .ev { position: absolute; right: 0; top: 50px; display: flex; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; text-shadow: 0 1px 3px #000; }\n    .ev-round { color: #c8f560; }\n    .osb-aux, .point-slot { display: none; }\n    .point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n    .combinedAName:empty::before { content: \"Team A\"; }\n    .combinedBName:empty::before { content: \"Team B\"; }\n    .eventName:empty, .matchRound:empty { display: none; }\n    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n  </style>\n</head>\n<body>\n<article class=\"bug\" aria-label=\"Soccer scorebug\">\n  <div class=\"clock\"><span class=\"live isMatchStarted\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity: 0;\"></span><span class=\"gc\"><span class=\"cm clockMinutes\" data-osb-component=\"field\" data-osb-field=\"clockMinutes\" data-osb-static=\"true\" data-sport-stat=\"clockMinutes\">00</span><b class=\"colon\">:</b><span class=\"cs clockSeconds\" data-osb-component=\"field\" data-osb-field=\"clockSeconds\" data-osb-static=\"true\" data-sport-stat=\"clockSeconds\">00</span></span><span class=\"ht isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity: 0;\">HT</span></div>\n  <div class=\"main\">\n    <span class=\"team\"><span class=\"kit jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"card yellow isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity: 0;\"><span class=\"cn yellowCardsA\" data-osb-component=\"field\" data-osb-field=\"yellowCardsA\"></span></span><span class=\"card red isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity: 0;\"><span class=\"cn redCardsA\" data-osb-component=\"field\" data-osb-field=\"redCardsA\"></span></span></span>\n    <span class=\"score\"><span class=\"sa currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><b class=\"dash\">-</b><span class=\"sb currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span>\n    <span class=\"team\"><span class=\"card yellow isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity: 0;\"><span class=\"cn yellowCardsB\" data-osb-component=\"field\" data-osb-field=\"yellowCardsB\"></span></span><span class=\"card red isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity: 0;\"><span class=\"cn redCardsB\" data-osb-component=\"field\" data-osb-field=\"redCardsB\"></span></span><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"kit jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span>\n  </div>\n  <div class=\"under\"><span class=\"half periodLabel\" data-osb-component=\"field\" data-osb-field=\"periodLabel\" data-osb-static=\"true\" data-sport-stat=\"half\"></span><span class=\"added addedTimeVisible\"><span class=\"at addedTime\" data-osb-component=\"field\" data-osb-field=\"addedTime\"></span></span><span class=\"pens shootoutAttempts\"><b class=\"pens-l\">PENS</b><span class=\"pen-a shootoutAScore\" data-osb-component=\"field\" data-osb-field=\"shootoutAScore\"></span><b class=\"pens-d\">-</b><span class=\"pen-b shootoutBScore\" data-osb-component=\"field\" data-osb-field=\"shootoutBScore\"></span></span></div>\n  <span class=\"ev\"><span class=\"ev-name eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"ev-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span>\n  <div class=\"osb-aux\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></div>\n</article>\n</body>\n</html>\n","css":""}
