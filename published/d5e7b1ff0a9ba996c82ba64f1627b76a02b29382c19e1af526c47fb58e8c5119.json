{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sage Slate Data Console — SOCCER compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:10px}.board{display:flex;overflow:hidden;width:min(88vw,1650px);height:clamp(168px,22vw,410px);border-radius:4px;background:#e8ebe5;color:#23343a;font-variant-numeric:tabular-nums;container-type:inline-size}.console{flex:0 0 21%;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:4%;padding:2.2%;background:#26383d;color:#fff}.sport-tag{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:clamp(13px,2.3cqw,39px);font-weight:800;letter-spacing:.01em}.stat{display:flex;flex-direction:column;min-width:0}.stat-label{font-size:clamp(9px,1.3cqw,20px);font-weight:700;color:#b8c8c1}.stat-value{font-size:clamp(15px,2.8cqw,46px);font-weight:800;line-height:1.05;white-space:nowrap}.teams{display:flex;flex:1 1 0;min-width:0}.team{display:flex;flex:1 1 0;min-width:0;min-height:0;background:#e8ebe5}.name-track{display:flex;align-items:center;flex:1 1 0;min-width:0}.identity{display:block;flex:none;align-self:stretch;width:2.1%;background:#258fd2}.jerseyColorB{background:#dc3c4b}.name{display:block;flex:1 1 0;min-width:0;margin-left:5%;padding-right:3%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:clamp(18px,4.5cqw,77px);font-weight:750;line-height:1.08}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex:0 0 22%;min-width:0;background:#55766d;color:#fff}.score{display:block;width:100%;min-width:0;overflow:hidden;white-space:nowrap;text-align:center;font-size:clamp(32px,8cqw,132px);font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.stage{padding:6px}.board{width:100%;height:142px}.console{padding:8px;gap:5px;flex-basis:28%}.sport-tag{font-size:11px}.stat-label{font-size:8px}.stat-value{font-size:13px}.name{font-size:clamp(16px,4.7cqw,21px);margin-left:7px;padding-right:2px}.score{font-size:clamp(25px,8cqw,37px)}.identity{width:5px}.score-track{flex-basis:24%}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(68vw,1220px);height:clamp(145px,16vw,300px);border:2px solid #b8c8c1}.console{flex-basis:19%;align-items:center;text-align:center;padding:2%;gap:2%}.console .stat{width:100%;align-items:center;border-top:1px solid #829a91;padding-top:4%}.sport-tag{font-size:clamp(12px,2.5cqw,34px)}.stat-value{font-size:clamp(18px,3.4cqw,49px)}.teams{flex-direction:column}.team+.team{border-top:2px solid #829a91}.identity{width:3.3%;background:#1176bf}.jerseyColorB{background:#ed1f2d}.name{font-size:clamp(17px,5.7cqw,76px);margin-left:4%}.score-track{flex-basis:20%}.score{font-size:clamp(32px,8cqw,108px)}@media(max-width:520px){.board{width:100%;height:138px}.console{flex-basis:26%;padding:4px;gap:3px}.sport-tag{font-size:10px}.console .stat{padding-top:3px}.stat-label{font-size:7px}.stat-value{font-size:14px}.name{font-size:17px;margin-left:7px}.score{font-size:31px}.identity{width:5px}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"SOCCER scoreboard\"><aside class=\"console columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"half\" data-osb-static=\"true\">0</span></div></aside><div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-track\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
