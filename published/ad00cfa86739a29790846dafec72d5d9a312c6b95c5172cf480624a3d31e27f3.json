{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Table Tennis — Maroon Frost Matchline Lower Third</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--frost:#e9edef;--maroon:#572f3c;--ink:#26343b;--white:#f8f6f2;--rule:#bec8cb;display:flex;flex-direction:column;width:min(83.7vw,1820px);min-width:0;overflow:hidden;border:1px solid var(--rule);border-radius:4px;background:var(--frost);color:var(--ink);container-type:inline-size}\n.matchline{position:relative;display:flex;flex:0 0 auto;height:3.3cqw;align-items:center;padding:0 1.8cqw;background:var(--maroon);color:var(--white);font-size:1.9cqw;line-height:1;font-weight:700;white-space:nowrap}\n.sides{display:flex;min-width:0}\n.side{display:flex;flex:1 1 50%;min-width:0;min-height:9.6cqw;align-items:stretch}\n.side+.side{border-left:1px solid #8ea5ad}\n.identity{display:block;flex:0 0 3.5%;width:3.5%;background:#287d9d}\n.jerseyColorB{background:#c45f65}\n.namefoot{display:flex;flex:1 1 auto;min-width:0;flex-direction:column;justify-content:center;gap:.45cqw;padding:0 1.8cqw}\n.name-row{display:flex;min-width:0;align-items:center;gap:.5cqw}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.4cqw;line-height:1.05;font-weight:700}\n.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 .4cqw;width:.4cqw;height:.4cqw;min-width:5px;min-height:5px;border-radius:50%;background:var(--ink)}\n.games{display:flex;min-width:0;align-items:baseline;gap:.6cqw;line-height:1}\n.games-score{display:block;font-size:2.55cqw;font-weight:700;font-variant-numeric:tabular-nums}.games-label{display:block;font-size:1.8cqw;font-weight:700;white-space:nowrap}\n.scorecap{display:flex;flex:0 0 28%;width:28%;min-width:0;flex-direction:column;align-items:center;justify-content:center;background:var(--maroon);color:var(--white)}\n.primary-score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:5.5cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.primary-label{display:block;font-size:1.55cqw;line-height:1;font-weight:700}\n.point-slot{position:absolute;right:1%;top:0;width:16%;height:100%;font-size:.8cqw;font-weight:700;text-align:center}\n.point-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--maroon)}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:94vw}.matchline{height:28px;padding:0 7px;font-size:12px}.side{min-height:87px}.identity{flex-basis:5px;width:5px}.namefoot{gap:3px;padding:0 4px}.name-row{gap:2px}.name{font-size:13px}.serve{flex-basis:5px;width:5px;height:5px}.games{gap:2px}.games-score{font-size:14px}.games-label{font-size:8px}.scorecap{flex-basis:32%;width:32%}.primary-score{font-size:31px}.primary-label{font-size:8px}.point-slot{font-size:6px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\n/* Reserved conditional match states: all score and name tracks remain fixed. */\n.osb-conditional-rail{--osb-rail-bg:#26343b;--osb-rail-fg:#f9fbfa;box-sizing:border-box!important;position:relative!important;inset:auto!important;transform:none!important;grid-column:1/-1!important;display:flex!important;align-items:center!important;justify-content:space-between!important;flex:0 0 auto!important;width:100%!important;min-width:0!important;min-height:28px!important;height:28px!important;margin:0!important;padding:2px 7px!important;gap:5px!important;overflow:hidden!important;background:var(--osb-rail-bg)!important;color:var(--osb-rail-fg)!important;border:0!important;font:700 11px/1 Arial,Helvetica,sans-serif!important;letter-spacing:0!important;text-transform:none!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-condition-side{all:unset!important;box-sizing:border-box!important;display:flex!important;align-items:center!important;flex:1 1 35%!important;width:35%!important;min-width:0!important;height:22px!important;gap:2px!important;position:relative!important;overflow:hidden!important}\n.osb-conditional-rail .osb-condition-side-b{justify-content:flex-end!important}\n.osb-conditional-rail .osb-condition-side-label{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 13px!important;width:13px!important;height:18px!important;color:var(--osb-rail-fg)!important;font:800 10px/1 Arial,Helvetica,sans-serif!important}\n.osb-conditional-rail .osb-condition-slot{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 21px!important;width:21px!important;height:18px!important;position:relative!important}\n.osb-conditional-rail .osb-condition-timeoutused{flex-basis:21px!important;width:21px!important}\n.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:17px!important;width:17px!important}\n.osb-conditional-rail .osb-condition-badge{box-sizing:border-box!important;align-items:center!important;justify-content:center!important;width:100%!important;height:18px!important;min-width:0!important;margin:0!important;padding:0 2px!important;border:1px solid rgba(255,255,255,.3)!important;border-radius:2px!important;background:rgba(255,255,255,.12)!important;color:var(--osb-rail-fg)!important;font:800 9px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-timeout-icon{position:relative!important;display:flex;align-items:center!important;justify-content:center!important;padding:0!important;color:var(--osb-rail-fg)!important}\n.osb-conditional-rail .osb-timeout-icon::before{content:\"\"!important;display:block!important;width:11px!important;height:11px!important;border:1.5px solid currentColor!important;border-radius:50%!important;background:transparent!important}\n.osb-conditional-rail .osb-timeout-icon::after{content:\"\"!important;position:absolute!important;left:50%!important;top:3px!important;width:3px!important;height:6px!important;border-left:1.5px solid currentColor!important;border-bottom:1.5px solid currentColor!important;transform:translateX(-25%) rotate(-35deg)!important;transform-origin:bottom left!important}\n.osb-conditional-rail .isATimeOutActive,.osb-conditional-rail .isBTimeOutActive{background:#f3d27a!important;color:#253641!important;border-color:#f3d27a!important}\n.osb-conditional-rail .isATimeOutUsed,.osb-conditional-rail .isBTimeOutUsed{background:transparent!important;color:#b8c7ca!important;border-color:#b8c7ca!important}\n.osb-conditional-rail .isAYellowCarded,.osb-conditional-rail .isBYellowCarded{background:#e5c94e!important;color:#253641!important;border-color:#e5c94e!important}\n.osb-conditional-rail .isARedCarded,.osb-conditional-rail .isBRedCarded{background:#c94747!important;color:#fff!important;border-color:#c94747!important}\n.osb-conditional-rail .point-slot.osb-shared-point{all:unset!important;box-sizing:border-box!important;position:relative!important;display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 30%!important;width:30%!important;min-width:78px!important;max-width:130px!important;height:22px!important;min-height:22px!important;inset:auto!important;margin:0!important;padding:0!important;transform:none!important;overflow:hidden!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important}\n.osb-conditional-rail .point-slot.osb-shared-point>.isGamePoint,.osb-conditional-rail .point-slot.osb-shared-point>.isMatchPoint{box-sizing:border-box!important;position:absolute!important;inset:0!important;display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;transform:none!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:390px){.osb-conditional-rail{padding:2px 4px!important;gap:3px!important}.osb-conditional-rail .osb-condition-side{gap:1px!important}.osb-conditional-rail .osb-condition-slot{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-timeoutused{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:15px!important;width:15px!important}.osb-conditional-rail .point-slot.osb-shared-point{min-width:76px!important}}\n\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"matchline\"><span>TABLE TENNIS</span></div><div class=\"sides rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"side rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"namefoot\"><div class=\"name-row\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"games\"><span class=\"games-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"games-label\">GAMES</span></div></div><div class=\"scorecap\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\">POINTS</span></div></div><div class=\"side rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"namefoot\"><div class=\"name-row\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"games\"><span class=\"games-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"games-label\">GAMES</span></div></div><div class=\"scorecap\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\">POINTS</span></div></div></div><div class=\"osb-conditional-rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Conditional match states\"><div class=\"osb-condition-side osb-condition-side-a\" data-osb-component=\"layout\"><span class=\"osb-condition-side-label\">A</span><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div><span class=\"point-slot osb-shared-point\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><div class=\"osb-condition-side osb-condition-side-b\" data-osb-component=\"layout\"><span class=\"osb-condition-side-label\">B</span><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div></div></article></main></body></html>\n","css":""}
