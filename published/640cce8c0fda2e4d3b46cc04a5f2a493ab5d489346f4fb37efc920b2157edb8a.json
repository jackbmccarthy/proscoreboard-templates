{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Petrol Ivory Keyline Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #fff; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 18px; }\n.group { width: min(100%, 780px); display: flex; flex-direction: column; gap: 15px; }\n.board { width: 100%; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #b7c6c4; border-top: 3px solid #bd8d5a; border-radius: 6px; background: #203b45; }\n.header { min-height: 54px; display: flex; align-items: stretch; border-bottom: 1px solid #b7c6c4; font-size: 18px; font-weight: 700; letter-spacing: .015em; }\n.sport { display: flex; align-items: center; flex: 1 1 0; padding: 0 18px; font-size: 27px; }\n.sets-head, .points-head { display: flex; align-items: center; justify-content: center; text-align: center; }\n.sets-head, .sets-score { flex: 0 0 15%; border-left: 1px solid #b7c6c4; }\n.points-head, .points-score { flex: 0 0 23%; border-left: 1px solid #b7c6c4; }\n.team { min-height: 99px; display: flex; align-items: stretch; }\n.team + .team { border-top: 1px solid #b7c6c4; }\n.identity { flex: 1 1 0; display: flex; align-items: center; gap: 27px; padding-right: 13px; }\n.tick { flex: 0 0 17px; width: 17px; align-self: stretch; background: #bd8d5a; }\n.jerseyColorB { background: #5e9a9d; }\n.name { flex: 1 1 0; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; font-size: 46px; font-weight: 700; line-height: 1.05; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-score { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 41px; font-weight: 700; font-variant-numeric: tabular-nums; }\n.points-score { display: flex; align-items: center; justify-content: center; background: #f3f1e9; color: #152c33; font-size: 64px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.set-dock { min-height: 58px; display: flex; align-items: center; justify-content: center; gap: 14px; border: 1px solid #b7c6c4; border-radius: 6px; background: #dbe2de; color: #152c33; font-size: 29px; font-weight: 700; line-height: 1; }\n.set-value { display: block; min-width: 1.4ch; text-align: center; font-size: 37px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) {\n  .stage { padding: 12px; }\n  .group { gap: 8px; }\n  .header { min-height: 38px; font-size: 12px; }\n  .sport { padding: 0 9px; font-size: 16px; }\n  .team { min-height: 63px; }\n  .identity { gap: 10px; padding-right: 5px; }\n  .tick { flex-basis: 7px; width: 7px; }\n  .name { font-size: clamp(19px, 5.7vw, 27px); }\n  .sets-score { font-size: 23px; }\n  .points-score { font-size: 35px; }\n  .set-dock { min-height: 38px; font-size: 19px; }\n  .set-value { font-size: 24px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <div class=\"group columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n      <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n        <header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\">VOLLEYBALL</span><span class=\"sets-head\">SETS</span><span class=\"points-head\">POINTS</span></header>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><span class=\"sets-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"points-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><span class=\"sets-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"points-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n      </article>\n      <div class=\"set-dock rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span>SET</span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></div>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </div>\n  </main>\n</body>\n</html>\n","css":""}
