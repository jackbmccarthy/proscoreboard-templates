{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Hinge Rail Volleyball — Stacked</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f4efdf; }\n.stage { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }\n.board { --rail: #222d2e; --ivory: #f1e8d5; --copper: #b47a50; width: 100%; max-width: 1048px; display: flex; flex-direction: column; gap: 10px; }\n.rail { background: var(--rail); border-radius: 5px; }\n.title { display: flex; align-items: center; justify-content: center; min-height: 70px; font-size: 44px; font-weight: 700; letter-spacing: .22em; padding-left: .22em; }\n.team { display: flex; align-items: stretch; min-height: 224px; padding: 21px 30px 23px 52px; }\n.name { display: flex; align-items: center; flex: 1 1 auto; min-width: 0; font-size: 88px; font-weight: 700; letter-spacing: .06em; padding-right: 26px; border-right: 1px solid #53605e; }\n.name > span { display: block; width: 100%; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-track { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 12px; flex: 0 0 240px; min-width: 0; }\n.score-track + .score-track { border-left: 1px solid #53605e; }\n.label { font-size: 26px; letter-spacing: .12em; font-weight: 700; line-height: 1; }\n.module { position: relative; display: flex; align-items: center; width: 156px; height: 140px; border-radius: 8px; background: var(--ivory); color: #080b0b; }\n.module::before, .module::after { content: \"\"; position: absolute; z-index: 2; width: 11px; height: 29px; top: calc(50% - 14px); background: var(--copper); border: 1px solid #755034; }\n.module::before { left: -6px; }\n.module::after { right: -6px; }\n.value { display: block; width: 100%; text-align: center; font-family: \"Liberation Mono\", \"Courier New\", monospace; font-feature-settings: \"zero\" 1; font-variant-numeric: tabular-nums slashed-zero; font-weight: 900; font-size: 104px; line-height: 1; letter-spacing: -.07em; padding-right: .07em; }\n.seam { position: absolute; z-index: 1; height: 1px; background: #72736b; width: 100%; top: 50%; pointer-events: none; }\n.set-rail { min-height: 60px; display: flex; align-items: center; justify-content: center; gap: 24px; font-size: 36px; font-weight: 700; letter-spacing: .16em; }\n.set-value { width: 52px; text-align: center; font-family: \"Liberation Mono\", \"Courier New\", monospace; font-variant-numeric: tabular-nums; letter-spacing: 0; }\n.runtime-reserve, .point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 1100px) {\n  .name { font-size: clamp(28px, 7vw, 80px); }\n  .team { padding-left: 32px; }\n  .score-track { flex-basis: 22%; }\n  .module { width: 76%; }\n  .value { font-size: clamp(44px, 8.5vw, 92px); }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .board { gap: 7px; }\n  .title { min-height: 45px; font-size: 23px; letter-spacing: .17em; }\n  .team { min-height: 120px; padding: 14px 13px 14px 16px; }\n  .name { font-size: 26px; letter-spacing: .02em; padding-right: 10px; }\n  .score-track { flex-basis: 25%; gap: 10px; }\n  .label { font-size: 12px; letter-spacing: .07em; }\n  .module { width: 75%; height: 67px; border-radius: 4px; }\n  .value { font-size: 35px; }\n  .module::before, .module::after { width: 6px; height: 16px; top: calc(50% - 8px); }\n  .module::before { left: -3px; }\n  .module::after { right: -3px; }\n  .set-rail { min-height: 43px; font-size: 23px; gap: 10px; }\n  .set-value { width: 32px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title rail\">VOLLEYBALL</header>\n      <div class=\"team rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"name\"><span class=\"combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div>\n        <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"module\"><span class=\"value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n        <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"module\"><span class=\"value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n      </div>\n      <div class=\"team rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"name\"><span class=\"combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div>\n        <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">SETS</span><div class=\"module\"><span class=\"value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n        <div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"label\">POINTS</span><div class=\"module\"><span class=\"value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><i class=\"seam\" aria-hidden=\"true\"></i></div></div>\n      </div>\n      <footer class=\"set-rail rail\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"runtime-reserve\"><span class=\"jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></div>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
