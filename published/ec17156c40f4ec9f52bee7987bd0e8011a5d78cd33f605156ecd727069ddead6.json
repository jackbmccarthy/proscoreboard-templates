{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Porcelain Inkline — Table Tennis 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#202a2e}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{position:relative;width:min(var(--board-width),94vw);container-type:inline-size}\n.surface{background:#f0f1ed;overflow:hidden;border:1px solid #c6cbc7}\n.header{display:flex;align-items:center;justify-content:center;height:4.65cqw;background:#202a2e;color:#fff;border-bottom:4px solid #397a78;font-size:3.1cqw;font-weight:700;letter-spacing:.07em;white-space:nowrap}\n.lanes{display:flex;min-width:0}\n.lane{height:10.45cqw;display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.lane+.lane{border-left:2px solid #c6cbc7}\n.identity{display:block;flex:0 0 1.35cqw;background:#25877e;margin:1.2cqw 0 1.2cqw 1.35cqw}\n.jerseyColorB{background:#7da2a1}\n.name-lane{display:flex;align-items:center;min-width:0;flex:1 1 0;padding:0 1.5cqw;gap:5px}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.8cqw;line-height:1.1;font-weight:700}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 .8cqw;width:.8cqw;height:.8cqw;border-radius:50%;background:#397a78}\n.number-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 6.65cqw;min-width:0;gap:.45cqw}\n.number-track.points{flex-basis:10.1cqw;border-left:2px solid #c6cbc7}\n.label{font-size:1.5cqw;font-weight:700;line-height:1;white-space:nowrap}\n.match-score,.score{display:block;width:100%;text-align:center;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums;font-weight:700}\n.match-score{font-size:4.4cqw}\n.score{font-size:6.7cqw}\n.point-slot{position:absolute;top:100%;left:50%;transform:translateX(-50%);width:170px;height:18px;text-align:center;color:#fff;font-size:11px;font-weight:700}\n.point-state{position:absolute;inset:0;display:block;background:#202a2e;border-top:2px solid #397a78}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:94vw}.header{height:36px;border-bottom-width:2px;font-size:15px}.lanes{flex-direction:column}.lane{flex:none;width:100%;height:76px}.lane+.lane{border-left:0;border-top:1px solid #c6cbc7}.identity{flex-basis:6px;margin:8px 0 8px 8px}.name-lane{padding:0 9px;gap:4px}.name{font-size:20px}.serve{flex-basis:7px;width:7px;height:7px}.number-track{flex-basis:48px;gap:3px}.number-track.points{flex-basis:68px;border-left-width:1px}.label{font-size:10px}.match-score{font-size:28px}.score{font-size:41px}.point-slot{height:16px;font-size:10px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" style=\"--board-width:76vw;--tick-width:1.35cqw\"><div class=\"surface columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\">TABLE TENNIS</header><div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"number-track\"><span class=\"label\">GAMES</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"number-track points\"><span class=\"label\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n<div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"number-track\"><span class=\"label\">GAMES</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"number-track points\"><span class=\"label\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
