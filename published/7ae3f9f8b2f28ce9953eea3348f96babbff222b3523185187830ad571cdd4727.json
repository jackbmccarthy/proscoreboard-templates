{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pearl Graphite Rightdock — Volleyball 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:10px}\n.board{display:flex;width:min(96vw,1925px);max-width:100%;aspect-ratio:1925/157;overflow:hidden;border:1px solid #aebdbb;border-radius:3px;background:#e8ebe7;color:#26363e;container-type:inline-size}\n.team{display:flex;flex:1 1 0;min-width:0;align-items:stretch}\n.team+.team{border-left:4px solid #e8ebe7}\n.identity{display:block;flex:0 0 3.2%;background:#2b85a3}\n.jerseyColorB{background:#c76b64}\n.name{display:flex;align-items:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 3%;font-size:clamp(16px,3.45cqw,68px);font-weight:700;line-height:1.05;white-space:nowrap;text-overflow:ellipsis}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.support,.primary{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;white-space:nowrap;font-variant-numeric:tabular-nums}\n.support{flex:0 0 16.5%;background:#e8ebe7;color:#26363e}\n.primary{flex:0 0 24.5%;background:#26363e;color:#f8faf8}\n.number{display:block;max-width:100%;overflow:hidden;font-weight:700;line-height:1;text-align:center}\n.support .number{font-size:clamp(17px,3.15cqw,61px)}\n.primary .number{font-size:clamp(24px,4.25cqw,82px)}\n.caption{display:block;max-width:100%;overflow:hidden;font-size:clamp(8px,1.35cqw,26px);font-weight:700;line-height:1.15}\n.dock{display:flex;flex:0 0 16.5%;min-width:0;flex-direction:column;align-items:center;border-left:2px solid #aebdbb;background:#26363e;color:#f8faf8;text-align:center}\n.sport{display:flex;align-items:center;justify-content:center;flex:0 0 45%;max-width:100%;padding:0 5%;overflow:hidden;font-size:clamp(11px,1.65cqw,32px);font-weight:700;line-height:1;white-space:nowrap}\n.rule{display:block;width:87%;height:1px;background:#aebdbb}\n.status{display:flex;flex:1 1 0;align-items:center;justify-content:center;gap:8%;min-height:0;font-variant-numeric:tabular-nums}\n.status-label,.current-set{font-size:clamp(12px,1.55cqw,30px);font-weight:700;line-height:1}\n.status-label{color:#b5c0bd}\n@media(max-width:700px){\n .stage{padding:4px}\n .board{display:grid;grid-template-columns:minmax(0,1fr) 25%;grid-template-rows:1fr 1fr;width:100%;height:154px;aspect-ratio:auto}\n .team:first-child{grid-column:1;grid-row:1}\n .team:nth-child(2){grid-column:1;grid-row:2;border-left:0;border-top:1px solid #aebdbb}\n .identity{flex-basis:3.5%}\n .name{padding:0 3%;font-size:clamp(14px,4.3cqw,27px)}\n .support{flex-basis:16%}\n .primary{flex-basis:22%}\n .support .number{font-size:clamp(18px,5cqw,33px)}\n .primary .number{font-size:clamp(25px,7cqw,46px)}\n .caption{font-size:clamp(8px,2.3cqw,14px)}\n .dock{grid-column:2;grid-row:1 / span 2;height:100%;border-left-width:1px}\n .sport{font-size:clamp(9px,2.35cqw,16px)}\n .status-label,.current-set{font-size:clamp(10px,2.6cqw,17px)}\n}\n.board{position:relative}.neutral-point-slot{position:absolute;width:0;height:0;overflow:hidden;pointer-events:none}.neutral-point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint,.neutral-point-slot:has(.isMatchPoint[style*=\"opacity:1\"]) .isGamePoint{opacity:0!important}</style>\n</head>\n<body>\n<main class=\"stage\">\n<article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Volleyball scoreboard\">\n  <div class=\"team competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span>\n    <span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span>\n    <div class=\"support support-track\"><span class=\"number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"caption\">SETS</span></div>\n    <div class=\"primary primary-track\"><span class=\"number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n  </div>\n  <div class=\"team competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n    <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span>\n    <span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span>\n    <div class=\"support support-track\"><span class=\"number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"caption\">SETS</span></div>\n    <div class=\"primary primary-track\"><span class=\"number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\">POINTS</span></div>\n  </div>\n  <aside class=\"dock columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport dock-title\">VOLLEYBALL</span><span class=\"rule\"></span><div class=\"status\"><span class=\"status-label\">SET</span><span class=\"current-set\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></aside>\n<span class=\"neutral-point-slot\" aria-hidden=\"true\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\"></span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\"></span></span></article>\n</main>\n</body>\n</html>\n","css":""}
