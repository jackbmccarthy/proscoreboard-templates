{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Marine Parchment Terminal — Volleyball Compact</title>\n<style>\n:root{--marine:#173947;--paper:#ece5d7;--white:#f7f9f6;--pale:#ece5d7;--blue:#2f8eaa;--coral:#cb746a}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif}\n.board{width:min(760px,94vw);overflow:hidden;border-radius:5px;background:var(--marine);color:var(--white)}\n.header{height:42px;background:var(--paper);color:var(--marine);display:flex;align-items:center;justify-content:space-between;padding:0 21px}\n.sport-tag{font-size:23px;font-weight:800;letter-spacing:.025em;line-height:1}\n.set-label{font-size:15px;font-weight:700;letter-spacing:.045em;white-space:nowrap}\n.lanes{display:flex;flex-direction:column}\n.lane{min-width:0;height:73px;display:flex;align-items:center;background:var(--marine)}\n.lane+.lane{border-top:1px solid #a8b9b8}\n.identity-tick{align-self:stretch;flex:0 0 12px;margin:2px 0;background:var(--blue);border-radius:2px}\n.lane-b .identity-tick{background:var(--coral)}\n.team-name{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 18px;color:var(--white);font-size:36px;line-height:1;font-weight:700}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.support-track{flex:0 0 73px;align-self:stretch;display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--marine);color:var(--pale);font-variant-numeric:tabular-nums}\n.support-score{font-size:29px;font-weight:700;line-height:1}\n.support-caption{font-size:11px;font-weight:700;letter-spacing:.04em;margin-top:4px}\n.primary-track{flex:0 0 98px;align-self:stretch;margin:3px 3px 3px 9px;display:flex;align-items:center;justify-content:center;flex-direction:column;border-radius:5px;background:var(--paper);color:var(--marine);font-variant-numeric:tabular-nums}\n.primary-score{font-size:48px;line-height:.95;font-weight:800}\n.primary-caption{font-size:12px;line-height:1;font-weight:800;letter-spacing:.025em;margin-top:4px}\n.point-slot{display:none;position:relative}\n.point-slot>.isGamePoint,.point-slot>.isMatchPoint{opacity:0}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:520px){.board{width:min(94vw,420px)}.header{height:36px;padding:0 14px}.sport-tag{font-size:17px}.set-label{font-size:12px}.lane{height:62px}.identity-tick{flex-basis:8px}.team-name{padding:0 10px;font-size:clamp(17px,5vw,27px)}.support-track{flex-basis:50px}.support-score{font-size:23px}.support-caption{font-size:9px}.primary-track{flex-basis:66px;margin-left:4px}.primary-score{font-size:36px}.primary-caption{font-size:9px}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n  <header class=\"header\"><span class=\"sport-tag\">VOLLEYBALL</span><span class=\"set-label\">SET 0</span></header>\n  <div class=\"lanes fixedColumnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-fixed-column-container\">\n    <div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <div class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></div>\n      <div class=\"team-name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></div>\n      <div class=\"support-track\"><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-caption\">SETS</span></div>\n      <div class=\"primary-track\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n    </div>\n    <div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n      <div class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></div>\n      <div class=\"team-name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></div>\n      <div class=\"support-track\"><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-caption\">SETS</span></div>\n      <div class=\"primary-track\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n    </div>\n  </div>\n  <div class=\"point-slot\" aria-hidden=\"true\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></div>\n</article>\n</body>\n</html>\n","css":""}
