{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Coral Slate Header PICKLEBALL 1</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#f4f5f3}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--view-width),var(--max-width),var(--height-width));position:relative;container-type:inline-size;background:transparent;padding-bottom:20px}.desk{width:100%;min-width:0;background:#1d2226;border:1px solid #59656a;border-radius:6px;overflow:hidden}.header{background:#e68a72;color:#1d2226;min-width:0}.sport-caption{white-space:nowrap;line-height:1.1}.row,.lane,.name-cell,.name-wrap{min-width:0}.name-cell{display:flex;align-items:center;flex:1 1 0}.name-wrap{display:flex;align-items:center;flex:1 1 0;gap:5px;min-width:0}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.serve{display:block;flex:0 0 12px;width:12px;height:12px;font-size:8px;line-height:12px;text-align:center}.bars{display:flex;align-items:center;gap:var(--bar-gap);flex-shrink:0}.identity,.bars i{display:block;width:var(--bar-width);height:var(--bar-height);background:#e68a72;flex-shrink:0}.score,.match-score{display:block;width:100%;font-size:var(--score-font);line-height:1.1;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}.match-score{font-size:var(--match-font);color:#f4f5f3}.label{font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.point-cell{background:#30383d;color:#fff}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:200px;max-width:90%;height:16px;font-size:12px;text-align:center}.point{position:absolute;inset:0;background:#1d2226;color:#f4f5f3}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:59vw;--max-width:1400px;--height-width:250vh;--name-font:6.6cqw;--score-font:7.3cqw;--match-font:6.5cqw;--label-font:3cqw;--games-width:18.5%;--points-width:20.5%;--bar-width:.8cqw;--bar-height:7.5cqw;--bar-gap:.55cqw}.header{min-height:8.3cqw;display:flex;align-items:center}.title-lane{flex:1;min-width:0;padding:0 2.2cqw}.sport-caption{font-size:5.55cqw}.header .games,.game-cell{flex:0 0 var(--games-width)}.header .points,.point-cell{flex:0 0 var(--points-width)}.header>.label{display:flex;align-items:center;justify-content:center}.row{display:flex;align-items:stretch;min-height:12.7cqw}.row+.row{border-top:1px solid #59656a}.name-cell{gap:2.8cqw;padding:.8cqw 2.2cqw}.game-cell,.point-cell{display:flex;align-items:center;justify-content:center}.point-cell{border-left:1px solid #59656a}@media(max-width:600px){.board{--view-width:94vw}.sport-caption{font-size:5cqw}.name{font-size:6cqw}.label{font-size:2.5cqw}}\n.bars{display:block;width:calc(3*var(--bar-width) + 2*var(--bar-gap));height:var(--bar-height);background:#e68a72;--bar-ratio:23%;clip-path:polygon(0 0,var(--bar-ratio) 0,var(--bar-ratio) 100%,0 100%,0 0,calc(50% - var(--bar-ratio)/2) 0,calc(50% + var(--bar-ratio)/2) 0,calc(50% + var(--bar-ratio)/2) 100%,calc(50% - var(--bar-ratio)/2) 100%,calc(50% - var(--bar-ratio)/2) 0,calc(100% - var(--bar-ratio)) 0,100% 0,100% 100%,calc(100% - var(--bar-ratio)) 100%,calc(100% - var(--bar-ratio)) 0);flex-shrink:0}\n@media(max-width:600px){.bars{--bar-width:3px;--bar-gap:3px;height:42px}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><div class=\"title-lane\"><div class=\"sport-caption\">PICKLEBALL</div></div><div class=\"label games\">GAMES</div><div class=\"label points\">POINTS</div></header><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><div class=\"bars jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></div><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><div class=\"bars jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></div><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
