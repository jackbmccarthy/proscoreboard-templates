{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Cyan Blue Broadcast TABLE TENNIS 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#19384c}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--view-width),var(--max-width),var(--height-width));position:relative;container-type:inline-size;background:transparent;padding-bottom:20px}.desk{width:100%;min-width:0;background:#e6eef1;border:1px solid #9bb1bd;border-radius:3px;overflow:hidden}.header{background:#a3cbd2;color:#19384c;min-width:0}.sport-caption{white-space:nowrap;line-height:1.1}.row,.lane,.name-cell,.name-wrap{min-width:0}.name-cell{display:flex;align-items:center;flex:1 1 0}.name-wrap{display:flex;align-items:center;flex:1 1 0;gap:5px;min-width:0}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{display:block;flex-shrink:0;background:#a3cbd2}.serve{display:block;flex:0 0 12px;width:12px;height:12px;font-size:8px;line-height:12px;text-align:center}.score,.match-score{display:block;width:100%;font-size:var(--score-font);line-height:1.1;text-align:center;white-space:nowrap;font-variant-numeric:tabular-nums}.match-score{font-size:var(--match-font)}.label{font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.point-cell{background:#19384c;color:#fff}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:200px;max-width:90%;height:16px;font-size:12px;text-align:center}.point{position:absolute;inset:0;background:#142b3a;color:#fff}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:89vw;--max-width:1850px;--height-width:450vh;--name-font:3.95cqw;--score-font:4.65cqw;--match-font:3cqw;--label-font:1.5cqw}.header{display:flex;align-items:center;justify-content:center;min-height:4.75cqw;border-bottom:1px solid #9bb1bd}.sport-caption{font-size:3.2cqw}.lanes{display:flex;min-width:0;width:100%;min-height:8.5cqw}.lane{flex:1 1 0;display:flex;align-items:stretch;min-width:0}.lane+.lane{border-left:.45cqw solid #9bb1bd}.name-cell{gap:1.6cqw;padding:.75cqw 1.35cqw}.identity{width:.9cqw;height:5.2cqw}.game-cell{flex:0 0 9cqw;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.65cqw;border-right:1px solid #9bb1bd;margin:1.2cqw 0}.point-cell{flex:0 0 12.4cqw;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3cqw}.lane .name-wrap{gap:.35cqw}@media(max-width:600px){.board{--view-width:94vw}.header{height:32px;min-height:32px}.sport-caption{font-size:14px}.lanes{flex-direction:column}.lane{flex:none;min-height:76px;width:100%}.lane+.lane{border-left:0;border-top:1px solid #9bb1bd}.name-cell{gap:9px;padding:8px 10px}.identity{width:3px;height:42px}.name{font-size:18px}.game-cell{flex-basis:44px;margin:10px 0;gap:3px}.point-cell{flex-basis:58px;gap:3px}.label{font-size:10px}.score{font-size:30px}.match-score{font-size:23px}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header\"><div class=\"sport-caption\">TABLE TENNIS</div></header><div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><div class=\"label\">GAMES</div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><div class=\"label\">POINTS</div><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><div class=\"label\">GAMES</div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><div class=\"label\">POINTS</div><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
