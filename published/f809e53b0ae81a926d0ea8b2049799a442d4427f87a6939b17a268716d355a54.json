{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>softball inverted splitline 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#f4f0e6}body{font-family:Arial,sans-serif;font-weight:700}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;width:100%;padding:16px}.board{width:min(87vw,calc((100vh - 48px) * 1.45),1720px);container-type:inline-size;display:flex;flex-direction:column;position:relative}.sport{font-size:10.2cqw;line-height:1;font-weight:800;text-align:center}.identities{display:flex;gap:8cqw;margin:2cqw 1.1cqw 0;min-width:0}.identity{display:flex;flex:1 1 0;min-width:0;align-items:center;justify-content:center;background:#ffbf22;height:6.5cqw;padding:.6cqw 1cqw}.name{display:block;min-width:0;width:100%;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:4.8cqw;font-weight:800;line-height:1.05;color:#0b0e11}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.scores{display:flex;gap:0cqw;margin-top:1.5cqw;isolation:isolate;position:relative;background:#15161a;}.scores:before{content:\"\";position:absolute;left:0;right:0;top:0;height:17.1cqw;background:#f4f0e6;pointer-events:none}.pane{flex:1 1 0;min-width:0;display:flex;align-items:center;flex-direction:column;position:relative;height:39cqw;padding-top:1.6cqw;}.score-track{display:flex;align-items:center;justify-content:center;width:100%;height:31cqw;flex:none;position:relative}.score{display:block;width:100%;text-align:center;font-family:\"Arial Black\",Arial,sans-serif;font-size:34.5cqw;font-weight:900;line-height:.75;transform:scaleY(1.12);transform-origin:center;color:#fff;mix-blend-mode:difference;font-variant-numeric:tabular-nums}.run-label{display:block;font-size:4.6cqw;line-height:1;font-weight:800;color:#f4f0e6;position:relative;margin-top:.8cqw}.stats{display:flex;align-items:center;justify-content:center;margin-top:4cqw;padding:0 3cqw;gap:0}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:1.7cqw}.stat-label,.stat-number{font-size:4.2cqw;line-height:1;white-space:nowrap;font-weight:700}.stat-number{font-variant-numeric:tabular-nums}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:min(100%,calc((100vh - 48px) * 1.45))}.stat{gap:1.25cqw}.stat-label,.stat-number{font-size:3.9cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scoreboard\"><header class=\"sport\" data-osb-static=\"true\">SOFTBALL</header><div class=\"identities rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div></div><div class=\"scores rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"pane columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"pane columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"score-track\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
