{"html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>baseball ivory cobalt line 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent;color:#152842}body{font-family:Arial,sans-serif;font-weight:700}.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;width:100%;padding:16px}.board{width:min(84vw,calc((100vh - 40px) * 6),1720px);container-type:inline-size;display:flex;flex-direction:column;position:relative;background:#faf9f3;border:2px solid #1557b0;border-radius:2px;overflow:hidden}.header{display:flex;align-items:center;justify-content:space-between;height:8.3cqw;padding:0 2.4cqw;border-bottom:1px solid #587089;background:#fff}.sport{font-size:2.8cqw;line-height:1;white-space:nowrap}.column-label{font-size:3.85cqw;line-height:1;text-align:center;flex:0 0 11.5cqw;margin-right:-2.4cqw}.desk{display:flex;min-width:0}.endcap{display:flex;align-items:center;justify-content:center;flex:0 0 17cqw;background:#1557b0;color:#fff;padding:1cqw}.competitors{display:flex;flex-direction:row;flex:1 1 0;min-width:0}.competitor{display:flex;align-items:center;min-width:0;background:#faf9f3;flex:1 1 0;min-height:7.4cqw;}.competitor+.competitor{border-left:1px solid #587089}.identity-tick{display:block;width:3px;height:6cqw;flex:none;background:#1557b0;margin-left:1.25cqw;margin-right:2.5cqw}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.85cqw;line-height:1.08}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 11.5cqw;align-self:stretch;background:#1557b0;color:#fff;gap:.45cqw;min-width:0}.run-label{font-size:1.55cqw;line-height:1;color:#fff}.score{display:block;width:100%;text-align:center;font-size:5.2cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}.stats{display:flex;align-items:center;min-height:4.6cqw;border-top:1px solid #587089;background:#152842;color:#fff;padding:.9cqw 0}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:1.75cqw;min-height:2.9cqw}.stat+.stat{border-left:1px solid #83a3bb}.stat-label{font-size:1.9cqw;line-height:1;color:#fff;white-space:nowrap}.stat-number{font-size:3.25cqw;line-height:1;font-variant-numeric:tabular-nums}.hidden{display:none}.point-slot{position:absolute;width:0;height:0;overflow:hidden}.point-slot>span{position:absolute;inset:0}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(max-width:600px){.board{width:100%}.desk{flex-direction:column}.endcap{width:100%;flex-basis:auto;min-height:40px}.endcap .sport{font-size:15px}.competitors{flex-direction:column}.competitor{min-height:70px}.competitor+.competitor{border-left:0;border-top:1px solid #587089}.identity-tick{height:44px;margin-left:12px;margin-right:14px}.name{font-size:22px}.score-track{flex-basis:84px;gap:4px}.run-label{font-size:11px}.score{font-size:34px}.stats{min-height:48px;padding:8px 0}.stat{gap:6px;min-height:30px}.stat-label{font-size:11px}.stat-number{font-size:20px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><div class=\"desk rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><aside class=\"endcap\" data-osb-component=\"layout\"><span class=\"sport\" data-osb-static=\"true\">BASEBALL</span></aside><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"run-label\" data-osb-static=\"true\">RUNS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-number\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
