{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball Scoreboard</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;width:100%;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f7f9f5}\n.stage{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{container-type:inline-size;position:relative;width:min(94vw,1800px);background:#18353f;border:1px solid #4d6970;border-radius:3px;overflow:hidden}\n.header{height:4.1cqw;min-height:28px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 1.7cqw;border-bottom:1px solid #a8bbb6;background:#18353f}\n.sport-tag{font-size:2cqw;font-weight:700;letter-spacing:.025em;white-space:nowrap}\n.status{display:flex;align-items:center;justify-content:flex-end;min-width:0}\n.stat{display:flex;align-items:center;gap:.5em;padding:0 1.8cqw;font-size:1.45cqw;font-weight:700;white-space:nowrap}\n.stat:last-child{padding-right:0}.stat+.stat{border-left:1px solid #a8bbb6}\n.stat-value{font-variant-numeric:tabular-nums}\n.lanes{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);}\n.lane{display:grid;grid-template-columns:1.1cqw 9.1cqw minmax(0,1fr) 5.2cqw;min-width:0;min-height:10cqw;align-items:stretch;background:#18353f}\n.lane+.lane{border-left:1px solid #a8bbb6}\n.tick{display:block;align-self:stretch;margin:1.2cqw .3cqw;border-radius:2px;background:#2786a5;min-width:0}\n.lane-b .tick{background:#c76a61}\n.primary{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;background:#e9eee8;color:#18353f;padding:.3cqw}\n.primary-score{display:block;max-width:100%;font-size:5cqw;line-height:.95;font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}\n.caption{font-size:1.18cqw;line-height:1.1;font-weight:700;white-space:nowrap}\n.name{align-self:center;display:block;min-width:0;margin:0;padding:0 2.1cqw;font-size:3.5cqw;line-height:1.1;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.support{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;background:#18353f;padding:.3cqw}\n.support-value{font-size:3.4cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.support .caption{color:#f7f9f5}\n.hidden-field,.point-slot{position:absolute!important;width:0!important;height:0!important;overflow:hidden!important;clip-path:inset(50%)}\n.point-slot>span{position:absolute;inset:0;opacity:0}\n.point-slot:has(.isMatchPoint[style*=\"opacity: 1\"]) .isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%}.header{height:auto;min-height:31px;padding:4px 7px;gap:4px}.sport-tag{font-size:12px}.stat{font-size:8px;padding:0 5px;gap:3px}.lane{grid-template-columns:4px 49px minmax(0,1fr) 32px;min-height:64px}.tick{margin:4px 1px}.primary-score{font-size:28px}.caption{font-size:9px}.name{font-size:clamp(12px,3.7vw,22px);padding:0 8px}.support-value{font-size:23px}}\n@media(max-width:450px){.header{flex-wrap:wrap}.status{width:100%;justify-content:space-between}.stat:first-child{padding-left:0}.lanes{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"baseball scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-static=\"true\">BASEBALL</span><div class=\"status rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat\"><span data-osb-static=\"true\">INNING</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></span><span class=\"stat\"><span data-osb-static=\"true\">BALLS</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></span><span class=\"stat\"><span data-osb-static=\"true\">STRIKES</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></span><span class=\"stat\"><span data-osb-static=\"true\">OUTS</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></span></div></header><div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"caption\" data-osb-static=\"true\">RUNS</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"caption\" data-osb-static=\"true\">HITS</span></div><span class=\"hidden-field currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"caption\" data-osb-static=\"true\">RUNS</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span><span class=\"caption\" data-osb-static=\"true\">HITS</span></div><span class=\"hidden-field currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
