{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Charcoal Ivory Open Score — Baseball 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{position:relative;display:flex;flex-direction:column;min-width:0;max-width:100%;container-type:inline-size;color:#f6f7f2}\n.surface{overflow:hidden;border:1px solid #53615c;border-radius:3px;background:#232c2b}\n.header{display:flex;align-items:center;min-width:0;background:#e9e6da;color:#232c2b;border-bottom:2px solid #718779}\n.sport{min-width:0;font-weight:700;line-height:1;letter-spacing:.015em;white-space:nowrap}\n.identity{display:block;flex:none;background:#718779}\n.jerseyColorB{background:#ab9470}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#f6f7f2;font-weight:700;line-height:1.08}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.score-track{display:flex;align-items:center;justify-content:center;flex:none;min-width:0}\n.score{display:block;width:100%;color:#f6f7f2;text-align:center;white-space:nowrap;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}\n.stats{display:flex;align-items:stretch;min-width:0;background:#e9e6da;color:#232c2b}\n.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;white-space:nowrap}\n.stat+.stat{border-left:2px solid #718779}\n.stat-label{font-weight:700;line-height:1}\n.stat-value{font-weight:700;line-height:1;font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(76vw,1600px)}\n.header{height:3.75cqw;min-height:34px;justify-content:center}\n.sport{font-size:3.15cqw}\n.competitors{display:flex;align-items:stretch;min-width:0;height:8.5cqw;min-height:72px;background:#232c2b}\n.competitor{display:flex;align-items:center;flex:1 1 0;min-width:0}\n.identity{width:.83cqw;height:5.7cqw}\n.competitor-a .identity{margin-left:1.8cqw;margin-right:1.7cqw}\n.competitor-b .identity{margin-left:1.7cqw;margin-right:1.8cqw}\n.name{font-size:4.5cqw}\n.competitor-b .name{text-align:right}\n.score-track{flex:0 0 11cqw;height:100%;padding:0 .5cqw}\n.score{font-size:7.6cqw}\n.center-rule{display:block;flex:none;width:2px;align-self:center;height:75%;background:#718779}\n.stats{height:4.2cqw;min-height:42px}\n.stat{gap:2.4cqw}\n.stat-label{font-size:1.9cqw}\n.stat-value{font-size:2.7cqw}\n@media(max-width:600px){.board{width:100%}.header{height:39px}.sport{font-size:19px}.competitors{height:auto;min-height:0;flex-direction:column}.competitor{height:74px;flex:none}.competitor+.competitor{border-top:1px solid #53615c}.center-rule{display:none}.identity{width:5px;height:45px}.competitor-a .identity{margin-left:9px;margin-right:9px}.competitor-b .identity{margin-left:9px;margin-right:9px}.name{font-size:22px}.score-track{flex-basis:62px;padding:0 2px}.score{font-size:42px}.stats{height:47px}.stat{gap:3px}.stat+.stat{border-left-width:1px}.stat-label{font-size:9px}.stat-value{font-size:19px}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball scoreboard\"><div class=\"surface columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-component=\"text\">BASEBALL</span></header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor competitor-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"score-track\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"center-rule\"></span><div class=\"competitor competitor-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-track\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">INNING</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">BALLS</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">STRIKES</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"stat-label\" data-osb-component=\"text\">OUTS</span><span class=\"stat-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
