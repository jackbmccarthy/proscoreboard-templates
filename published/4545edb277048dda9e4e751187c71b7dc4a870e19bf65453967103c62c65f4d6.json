{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Copper Slate Score Rail Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #1e2b35; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 18px; }\n.board { width: min(100%, 990px); display: flex; flex-direction: column; overflow: hidden; border: 2px solid #9babb3; border-radius: 3px; background: #dce4e8; }\n.header { height: 80px; flex: 0 0 80px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 2px solid #b98262; background: #f4f5f2; color: #1e2b35; font-weight: 800; }\n.sport { font-size: 47px; line-height: 1; }\n.sets-head { font-size: 26px; line-height: 1; }\n.team { min-height: 120px; display: flex; align-items: stretch; }\n.team + .team { border-top: 2px solid #9babb3; }\n.point-cell { flex: 0 0 145px; width: 145px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #252c33; color: #fff; }\n.point-label { height: 19px; font-size: 19px; font-weight: 700; line-height: 1; }\n.point-label.blank { visibility: hidden; }\n.point-value { display: block; min-width: 2.5ch; text-align: center; font-size: 78px; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }\n.tick { display: block; flex: 0 0 40px; width: 40px; align-self: stretch; background: #b98262; }\n.jerseyColorB { background: #7ea6b5; }\n.name { flex: 1 1 0; display: block; align-self: center; overflow: hidden; padding: 0 27px; text-overflow: ellipsis; white-space: nowrap; font-size: 59px; font-weight: 700; line-height: 1; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.sets-score { flex: 0 0 124px; width: 124px; display: flex; align-items: center; justify-content: center; font-size: 55px; font-weight: 700; font-variant-numeric: tabular-nums; }\n.footer { min-height: 94px; display: flex; align-items: center; justify-content: center; gap: 30px; border-top: 2px solid #9babb3; background: #252c33; color: #fff; font-weight: 700; }\n.footer-label { color: #9babb3; font-size: 37px; }\n.set-value { display: block; min-width: 1.4ch; text-align: center; font-size: 65px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media (max-width: 700px) {\n  .stage { padding: 10px; }\n  .header { height: 44px; flex-basis: 44px; padding: 0 12px; }\n  .sport { font-size: clamp(19px, 5.5vw, 30px); }\n  .sets-head { font-size: 15px; }\n  .team { min-height: 75px; }\n  .point-cell { flex-basis: 75px; width: 75px; }\n  .point-label { height: 13px; font-size: 10px; }\n  .point-value { font-size: 42px; }\n  .tick { flex-basis: 12px; width: 12px; }\n  .name { padding: 0 10px; font-size: clamp(18px, 5.7vw, 34px); }\n  .sets-score { flex-basis: 51px; width: 51px; font-size: 29px; }\n  .footer { min-height: 55px; gap: 12px; }\n  .footer-label { font-size: 21px; }\n  .set-value { font-size: 34px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\">VOLLEYBALL</span><span class=\"sets-head\">SETS</span></header>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"point-cell\"><span class=\"point-label\">POINTS</span><span class=\"point-value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"sets-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"point-cell\"><span class=\"point-label blank\">POINTS</span><span class=\"point-value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"sets-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n      <div class=\"footer rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"footer-label\">SET</span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></div>\n    </article>\n    <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n  </main>\n</body>\n</html>\n","css":""}
