{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Burgundy Sand Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; min-width: 0; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #273537; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 520px; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #b6b4ad; background: #e8e4db; }\n.heading { display: flex; align-items: stretch; min-height: 37px; border-bottom: 1px solid #b6b4ad; font-size: 18px; font-weight: 700; line-height: 1; }\n.sport-tab { display: flex; align-items: center; justify-content: center; flex: 0 0 42%; padding: 5px 10px; background: #893d4d; color: #fff; font-size: 22px; white-space: nowrap; }\n.heading-spacer { flex: 1 1 0; }\n.sets-heading, .points-heading { display: flex; align-items: center; justify-content: center; text-align: center; }\n.sets-heading, .match-score { flex: 0 0 15%; }\n.points-heading, .primary-score { flex: 0 0 23%; }\n.team { display: flex; align-items: stretch; min-height: 52px; }\n.team + .team { border-top: 1px solid #b6b4ad; }\n.identity { display: flex; align-items: center; flex: 1 1 0; gap: 22px; padding: 7px 12px; }\n.tick { display: block; width: 3px; flex: 0 0 3px; height: 37px; background: #893d4d; }\n.name { display: block; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 32px; font-weight: 700; line-height: 1; color: #273537; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.match-score { display: flex; align-items: center; justify-content: center; border-left: 1px solid #b6b4ad; font-size: 30px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.primary-score { display: flex; align-items: center; justify-content: center; border-left: 1px solid #b6b4ad; background: #183336; color: #fff; font-size: 40px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }\n.set-footer { display: flex; align-items: center; justify-content: center; min-height: 41px; gap: 13px; border-top: 1px solid #b6b4ad; background: #183336; color: #fff; font-size: 17px; font-weight: 700; line-height: 1; }\n.footer-label { color: #d3828d; }\n.set-value { display: block; width: 28px; text-align: center; font-size: 24px; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 600px) { .stage { padding: 14px; } .sport-tab { font-size: 18px; } .heading { font-size: 15px; } .identity { gap: 13px; padding-left: 8px; padding-right: 7px; } .name { font-size: 26px; } .match-score { font-size: 24px; } .primary-score { font-size: 34px; } }\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"heading rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tab\">VOLLEYBALL</span><span class=\"heading-spacer\"></span><span class=\"sets-heading\">SETS</span><span class=\"points-heading\">POINTS</span></header>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n      <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n      <footer class=\"set-footer\"><span class=\"footer-label\">SET</span><span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
