{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Linen Navy Sideconsole TABLE TENNIS 2</title>\n  <style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f8fafb}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.board{width:min(92vw,1680px);display:flex;overflow:hidden;background:#1f3242;border-radius:3px;container-type:inline-size}\n.console{position:relative;flex:0 0 21%;min-width:0;display:flex;align-items:center;justify-content:center;padding:1.5cqw;background:#e7dfd0;color:#1f3242}\n.sport-tag{font-size:clamp(13px,2.45cqw,37px);font-weight:800;line-height:1.08;white-space:nowrap;text-align:center}\n.lanes{flex:1;min-width:0;display:flex;flex-direction:column}\n.lane{flex:1;min-width:0;min-height:0;display:flex;align-items:center;gap:2.1cqw;padding:.8cqw 1.7cqw;background:#1f3242}\n.lane+.lane{border-top:1px solid #688293}\n.tick{display:block;flex:0 0 1.1cqw;width:1.1cqw;height:65%;min-height:15px;border-radius:1px;background:#2685a5}\n.jerseyColorB{background:#c96a60}\n.name-wrap{flex:1 1 auto;min-width:0;position:relative}\n.name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:clamp(16px,4.7cqw,72px);font-weight:700;line-height:1.06}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{position:absolute;right:0;top:calc(100% + .35cqw);font-size:1.25cqw;line-height:1;color:#aebfc2}\n.support{flex:0 0 8.2cqw;width:8.2cqw;height:7.6cqw;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#aebfc2;border-radius:3px;color:#1f3242}\n.support-value{display:block;font-size:4.2cqw;font-weight:800;line-height:.95;font-variant-numeric:tabular-nums;white-space:nowrap}\n.support-caption,.primary-caption{display:block;font-size:1.55cqw;font-weight:700;letter-spacing:.04em;line-height:1.1;white-space:nowrap}\n.primary{flex:0 0 10.5cqw;width:10.5cqw;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#f8fafb}\n.primary-value{display:block;font-size:7.5cqw;font-weight:800;line-height:.95;font-variant-numeric:tabular-nums;white-space:nowrap}\n.primary-caption{margin-top:.7cqw;color:#e8eef1}\n.point-slot{position:absolute;left:2%;right:2%;bottom:1.2cqw;height:1.5cqw;text-align:center;font-size:1.05cqw;font-weight:700;letter-spacing:.04em}\n.point-slot span{position:absolute;inset:0;white-space:nowrap}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.stage{padding:6px}.board{width:calc(100vw - 12px)}.console{flex-basis:20%}.sport-tag{font-size:clamp(9px,2.5cqw,15px)}.lane{gap:1.35cqw;padding:1.4cqw}.name{font-size:clamp(12px,4.1cqw,18px)}.support{flex-basis:9.2cqw;width:9.2cqw;height:10.2cqw}.support-value{font-size:5cqw}.support-caption,.primary-caption{font-size:1.45cqw}.primary{flex-basis:11cqw;width:11cqw}.primary-value{font-size:7.5cqw}.point-slot{font-size:1.35cqw}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.board{min-height:10cqw}.console{flex-basis:19%}.lanes{flex-direction:row}.lane{min-width:0;gap:1.55cqw;padding:.75cqw 1.2cqw}.lane+.lane{border-top:0;border-left:1px solid #688293}.tick{flex-basis:.9cqw;width:.9cqw;height:69%}.name{font-size:clamp(12px,3.55cqw,50px)}.support{flex-basis:6.7cqw;width:6.7cqw;height:7.6cqw}.support-value{font-size:3.9cqw}.support-caption,.primary-caption{font-size:1.25cqw}.primary{flex-basis:8.2cqw;width:8.2cqw}.primary-value{font-size:6.6cqw}@media(max-width:600px){.board{min-height:23cqw}.console{flex-basis:18%}.lane{gap:.8cqw;padding:.8cqw}.tick{flex-basis:1cqw;width:1cqw}.name{font-size:clamp(9px,3.15cqw,14px)}.support{flex-basis:6.7cqw;width:6.7cqw;height:9.5cqw}.support-caption,.primary-caption{font-size:1.25cqw}.primary{flex-basis:7.7cqw;width:7.7cqw}.primary-value{font-size:7cqw}}\n\n/* Reserved conditional match states: all score and name tracks remain fixed. */\n.osb-conditional-rail{--osb-rail-bg:#1f3242;--osb-rail-fg:#f9fbfa;box-sizing:border-box!important;position:relative!important;inset:auto!important;transform:none!important;grid-column:1/-1!important;display:flex!important;align-items:center!important;justify-content:space-between!important;flex:0 0 auto!important;width:100%!important;min-width:0!important;min-height:28px!important;height:28px!important;margin:0!important;padding:2px 7px!important;gap:5px!important;overflow:hidden!important;background:var(--osb-rail-bg)!important;color:var(--osb-rail-fg)!important;border:0!important;font:700 11px/1 Arial,Helvetica,sans-serif!important;letter-spacing:0!important;text-transform:none!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-condition-side{all:unset!important;box-sizing:border-box!important;display:flex!important;align-items:center!important;flex:1 1 35%!important;width:35%!important;min-width:0!important;height:22px!important;gap:2px!important;position:relative!important;overflow:hidden!important}\n.osb-conditional-rail .osb-condition-side-b{justify-content:flex-end!important}\n.osb-conditional-rail .osb-condition-slot{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 21px!important;width:21px!important;height:18px!important;position:relative!important}\n.osb-conditional-rail .osb-condition-timeoutused{flex-basis:21px!important;width:21px!important}\n.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:17px!important;width:17px!important}\n.osb-conditional-rail .osb-condition-badge{box-sizing:border-box!important;align-items:center!important;justify-content:center!important;width:100%!important;height:18px!important;min-width:0!important;margin:0!important;padding:0 2px!important;border:1px solid rgba(255,255,255,.3)!important;border-radius:2px!important;background:rgba(255,255,255,.12)!important;color:var(--osb-rail-fg)!important;font:800 9px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .osb-timeout-icon{position:relative!important;display:flex;align-items:center!important;justify-content:center!important;padding:0!important;color:var(--osb-rail-fg)!important}\n.osb-conditional-rail .osb-timeout-icon::before{content:\"\"!important;display:block!important;width:11px!important;height:11px!important;border:1.5px solid currentColor!important;border-radius:50%!important;background:transparent!important}\n.osb-conditional-rail .osb-timeout-icon::after{content:\"\"!important;position:absolute!important;left:50%!important;top:3px!important;width:3px!important;height:6px!important;border-left:1.5px solid currentColor!important;border-bottom:1.5px solid currentColor!important;transform:translateX(-25%) rotate(-35deg)!important;transform-origin:bottom left!important}\n.osb-conditional-rail .isATimeOutActive,.osb-conditional-rail .isBTimeOutActive{background:#f3d27a!important;color:#253641!important;border-color:#f3d27a!important}\n.osb-conditional-rail .isATimeOutUsed,.osb-conditional-rail .isBTimeOutUsed{background:transparent!important;color:#b8c7ca!important;border-color:#b8c7ca!important}\n.osb-conditional-rail .isAYellowCarded,.osb-conditional-rail .isBYellowCarded{background:#e5c94e!important;color:#253641!important;border-color:#e5c94e!important}\n.osb-conditional-rail .isARedCarded,.osb-conditional-rail .isBRedCarded{background:#c94747!important;color:#fff!important;border-color:#c94747!important}\n.osb-conditional-rail .point-slot.osb-shared-point{all:unset!important;box-sizing:border-box!important;position:relative!important;display:flex!important;align-items:center!important;justify-content:center!important;flex:0 0 30%!important;width:30%!important;min-width:78px!important;max-width:130px!important;height:22px!important;min-height:22px!important;inset:auto!important;margin:0!important;padding:0!important;transform:none!important;overflow:hidden!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important}\n.osb-conditional-rail .point-slot.osb-shared-point>.isGamePoint,.osb-conditional-rail .point-slot.osb-shared-point>.isMatchPoint{box-sizing:border-box!important;position:absolute!important;inset:0!important;display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;transform:none!important;background:transparent!important;color:var(--osb-rail-fg)!important;font:800 11px/1 Arial,Helvetica,sans-serif!important;text-align:center!important;white-space:nowrap!important;animation:none!important;transition:none!important}\n.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.osb-conditional-rail .point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:390px){.osb-conditional-rail{padding:2px 4px!important;gap:3px!important}.osb-conditional-rail .osb-condition-side{gap:1px!important}.osb-conditional-rail .osb-condition-slot{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-timeoutused{flex-basis:18px!important;width:18px!important}.osb-conditional-rail .osb-condition-yellowcarded,.osb-conditional-rail .osb-condition-redcarded{flex-basis:15px!important;width:15px!important}.osb-conditional-rail .point-slot.osb-shared-point{min-width:76px!important}}\n.board:has(>.osb-conditional-rail){flex-wrap:wrap!important}.board>.osb-conditional-rail{order:99!important}@media(max-width:700px){.board .sport-tag{font-size:10px!important;white-space:normal!important;line-height:1.1!important}}\n</style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"TABLE TENNIS scoreboard\">\n      <div class=\"console\"><span class=\"sport-tag\">TABLE TENNIS</span></div>\n      <div class=\"lanes rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n        <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div><div class=\"support\"><span class=\"support-value currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-caption\">GAMES</span></div><div class=\"primary\"><span class=\"primary-value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div></div>\n        <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div><div class=\"support\"><span class=\"support-value currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-caption\">GAMES</span></div><div class=\"primary\"><span class=\"primary-value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div></div>\n      </div>\n    <div class=\"osb-conditional-rail rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Conditional match states\"><div class=\"osb-condition-side osb-condition-side-a\" data-osb-component=\"layout\"><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isAYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isAYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isARedCarded\" data-osb-component=\"field\" data-osb-field=\"isARedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div><span class=\"point-slot osb-shared-point\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><div class=\"osb-condition-side osb-condition-side-b\" data-osb-component=\"layout\"><span class=\"osb-condition-slot osb-condition-timeoutactive\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\" aria-label=\"Timeout active\" title=\"Timeout active\"></span></span><span class=\"osb-condition-slot osb-condition-timeoutused\"><span class=\"osb-condition-badge osb-timeout-icon isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\" aria-label=\"Timeout used\" title=\"Timeout used\"></span></span><span class=\"osb-condition-slot osb-condition-yellowcarded\"><span class=\"osb-condition-badge isBYellowCarded\" data-osb-component=\"field\" data-osb-field=\"isBYellowCarded\" style=\"opacity:0\" aria-label=\"Yellow card\" title=\"Yellow card\">Y</span></span><span class=\"osb-condition-slot osb-condition-redcarded\"><span class=\"osb-condition-badge isBRedCarded\" data-osb-component=\"field\" data-osb-field=\"isBRedCarded\" style=\"opacity:0\" aria-label=\"Red card\" title=\"Red card\">R</span></span></div></div></article>\n  </main>\n</body>\n</html>\n","css":""}
