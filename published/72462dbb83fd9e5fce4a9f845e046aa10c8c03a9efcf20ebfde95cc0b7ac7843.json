{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Pewter Columnhead 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}\n.shell{width:min(96vw,1660px);max-width:100%;container-type:inline-size;color:#25343a}\n.package{display:flex;align-items:flex-end;gap:8px;width:100%;padding-top:19px}\n.sport-tab{display:flex;align-items:center;justify-content:center;flex:0 0 13.5%;height:82px;min-width:0;overflow:hidden;border:1px solid #8da1a5;border-radius:4px;background:#25343a;color:#f5f7f4;font-size:clamp(13px,1.85cqw,31px);font-weight:800;line-height:1;white-space:nowrap}\n.board{display:flex;flex:1 1 0;height:82px;min-width:0;overflow:visible;border-radius:4px;background:#dfe6e5}\n.team{display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.team:first-child{border-radius:4px 0 0 4px}\n.team:last-child{border-left:1px solid #8da1a5;border-radius:0 4px 4px 0}\n.name-zone{display:flex;align-items:center;flex:1 1 0;min-width:0;overflow:hidden}\n.identity{display:block;align-self:stretch;flex:0 0 13px;margin:11px 0 11px 12px;background:#1368c4}\n.jerseyColorB{background:#e11d32}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;padding:0 24px;color:#25343a;font-size:clamp(18px,3cqw,50px);font-weight:750;line-height:1.08;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.sets,.points{position:relative;display:flex;align-items:center;justify-content:center;flex:0 0 13.5%;min-width:0;border-left:1px solid #8da1a5;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sets{background:#cbd8da;font-size:clamp(18px,2.4cqw,40px);font-weight:750}\n.points{flex-basis:20.5%;background:#bccdd0;font-size:clamp(25px,3.45cqw,57px);font-weight:800}\n.columnhead{position:absolute;left:-1px;right:-1px;top:-19px;display:flex;align-items:center;justify-content:center;height:19px;border:1px solid #8da1a5;background:#25343a;color:#f5f7f4;font-size:clamp(9px,1.2cqw,19px);font-weight:800;line-height:1;white-space:nowrap}\n.set-score,.point-score{display:block;min-width:0;max-width:100%;overflow:hidden;font-variant-numeric:tabular-nums;line-height:1}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:650px){\n .stage{padding:8px}\n .shell{width:100%}\n .package{flex-wrap:wrap;gap:0;padding-top:0}\n .sport-tab{flex:0 0 130px;height:28px;font-size:13px}\n .board{flex:0 0 100%;height:86px;margin-top:27px}\n .identity{flex-basis:4px;margin:8px 0 8px 4px}\n .name{padding:0 4px;font-size:clamp(10px,3.7cqw,15px)}\n .sets{flex-basis:15%;font-size:18px}\n .points{flex-basis:22%;font-size:clamp(20px,5.7cqw,25px)}\n .columnhead{font-size:8px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <div class=\"shell\" data-osb-component=\"layout\">\n  <div class=\"package rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <span class=\"sport-tab sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span>\n   <article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Volleyball scoreboard, generic manual scoring\">\n    <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n     <div class=\"name-zone rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div>\n     <div class=\"sets\" data-osb-component=\"layout\"><span class=\"columnhead\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n     <div class=\"points\" data-osb-component=\"layout\"><span class=\"columnhead\" data-osb-component=\"text\">POINTS</span><span class=\"point-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div>\n    </div>\n    <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n     <div class=\"name-zone rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div>\n     <div class=\"sets\" data-osb-component=\"layout\"><span class=\"columnhead\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div>\n     <div class=\"points\" data-osb-component=\"layout\"><span class=\"columnhead\" data-osb-component=\"text\">POINTS</span><span class=\"point-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div>\n    </div>\n   </article>\n  </div>\n  <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n </div>\n</main>\n</body>\n</html>\n","css":""}
