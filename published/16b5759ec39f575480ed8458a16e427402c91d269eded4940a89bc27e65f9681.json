{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Spruce Pearl Leadnote Volleyball 1</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(62vw,1320px);max-width:100%;overflow:hidden;border-radius:5px;background:#28443f;color:#f9fbf8;container-type:inline-size}\n.lanes{display:flex;flex-direction:column;min-width:0}\n.lane{display:flex;align-items:stretch;height:12.65cqw;min-width:0;background:#28443f}\n.lane+.lane{border-top:2px solid #a7bcb4}\n.tick{flex:0 0 2.5%;min-width:0;background:#3185aa;border-right:4px solid #28443f}\n.jerseyColorB{background:#c96d70}\n.scorecap{display:flex;align-items:center;justify-content:center;flex:0 0 18.3%;min-width:0;flex-direction:column;gap:1px;background:#e4e9e3;color:#28443f;font-variant-numeric:tabular-nums}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(36px,6.75cqw,90px);font-weight:800;line-height:1.12;text-align:center}\n.score-caption{display:block;max-width:100%;overflow:hidden;font-size:clamp(10px,1.75cqw,23px);font-weight:750;line-height:1;white-space:nowrap}\n.name-lane{display:flex;justify-content:center;flex:1 1 0;min-width:0;flex-direction:column;gap:3px;padding:0 3.0%;background:#28443f}\n.support{display:flex;align-items:baseline;gap:.48em;min-width:0;white-space:nowrap}\n.support-label{font-size:clamp(12px,2.3cqw,30px);font-weight:500;line-height:1}\n.support-score{display:block;max-width:4ch;overflow:hidden;font-size:clamp(16px,2.55cqw,34px);font-weight:750;line-height:1;font-variant-numeric:tabular-nums}\n.name{display:block;min-width:0;overflow:hidden;font-size:clamp(30px,5.45cqw,72px);font-weight:750;line-height:1.05;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.footer{display:flex;align-items:center;min-width:0;height:6.75cqw;gap:3.7%;padding:0 3.3%;background:#e4e9e3;color:#28443f;white-space:nowrap}\n.sport{font-size:clamp(17px,3.0cqw,40px);font-weight:750;line-height:1}\n.footer-rule{align-self:center;flex:0 0 2px;height:68%;background:#a7bcb4}\n.set-status{display:flex;align-items:baseline;gap:.35em;font-size:clamp(16px,2.55cqw,34px);font-weight:600;line-height:1}\n.set-number{font-variant-numeric:tabular-nums}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){\n .stage{padding:6px}\n .board{width:100%}\n .lane{height:66px}\n .lane+.lane{border-top-width:1px}\n .tick{flex-basis:9px;border-right-width:2px}\n .scorecap{flex-basis:74px}\n .score{font-size:43px}\n .score-caption{font-size:11px}\n .name-lane{gap:2px;padding:0 12px}\n .support-label{font-size:11px}.support-score{font-size:16px}\n .name{font-size:clamp(19px,6.4vw,27px)}\n .footer{height:36px;gap:14px;padding:0 12px}\n .sport{font-size:15px}.set-status{font-size:14px}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard with generic manual scoring\">\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"scorecap\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"score-caption\" data-osb-component=\"text\">POINTS</span></div><div class=\"name-lane\" data-osb-component=\"layout\"><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">SETS</span><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div></div>\n   <div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"scorecap\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"score-caption\" data-osb-component=\"text\">POINTS</span></div><div class=\"name-lane\" data-osb-component=\"layout\"><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">SETS</span><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div></div>\n  </div>\n  <div class=\"footer rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-component=\"text\">VOLLEYBALL</span><span class=\"footer-rule\" aria-hidden=\"true\"></span><span class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"set-number\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></span></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
