{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Table Tennis — Pearl Ledger Side Index Scorebug</title><style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}\n.board{--pearl:#e9eeeb;--ink:#24373c;--line:#a7b7b4;display:flex;width:min(86vw,1870px);min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:3px;background:var(--pearl);color:var(--ink);container-type:inline-size}\n.index{position:relative;display:flex;flex:0 0 18.2%;min-width:0;align-items:center;justify-content:center;padding:0 1cqw;border-right:1px solid var(--line)}\n.sport-title{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:2.05cqw;line-height:1;font-weight:700}\n.rows{display:flex;flex:1 1 auto;min-width:0;flex-direction:column}\n.row{display:flex;flex:1 1 50%;min-width:0;min-height:7.85cqw;align-items:stretch}\n.row+.row{border-top:1px solid var(--line)}\n.identity-wrap{display:flex;flex:0 0 3.7%;align-items:center;justify-content:center;padding:.65cqw 0}\n.identity{display:block;flex:0 0 .78cqw;width:.78cqw;height:100%;min-width:5px;border-radius:2px;background:#2178a8}\n.jerseyColorB{background:#c95c5b}\n.name-lane{display:flex;flex:1 1 auto;min-width:0;align-items:center;gap:.6cqw;padding:0 1.3cqw;color:var(--ink)}\n.name{display:block;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:4.25cqw;line-height:1;font-weight:700}\n.combinedAName:empty::before{content:\"Player A\"}.combinedBName:empty::before{content:\"Player B\"}\n.serve{display:block;flex:0 0 .5cqw;width:.5cqw;height:.5cqw;min-width:6px;min-height:6px;border-radius:50%;background:var(--ink)}\n.support-track,.primary-track{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;white-space:nowrap}\n.support-track{flex:0 0 12%;width:12%}.primary-track{flex:0 0 17%;width:17%}\n.caption{display:block;max-width:100%;overflow:hidden;font-size:1.45cqw;line-height:1;font-weight:700}\n.support-score,.primary-score{display:block;max-width:100%;overflow:hidden;line-height:1;font-weight:700;font-variant-numeric:tabular-nums}\n.support-score{font-size:3.2cqw}.primary-score{font-size:6.3cqw}\n.point-slot{position:absolute;left:4%;right:4%;bottom:7%;height:1.3cqw;color:var(--ink);font-size:.9cqw;line-height:1;font-weight:700;text-align:center}\n.point-state{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:var(--pearl)}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:600px){.board{width:94vw}.index{flex-basis:21%;padding:0 3px}.sport-title{font-size:8px}.row{min-height:74px}.identity-wrap{flex-basis:7px;padding:3px 0}.identity{flex-basis:5px;width:5px}.name-lane{gap:2px;padding:0 4px}.name{font-size:17px}.serve{flex-basis:5px;width:5px;height:5px;min-width:5px;min-height:5px}.support-track{flex-basis:19%;width:19%}.primary-track{flex-basis:24%;width:24%}.caption{font-size:7px}.support-score{font-size:20px}.primary-score{font-size:31px}.point-slot{height:12px;font-size:6px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><aside class=\"index\"><span class=\"sport-title\">TABLE TENNIS</span><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></aside><div class=\"rows columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-wrap\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></span><div class=\"name-lane\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\"></span></div><div class=\"support-track\"><span class=\"caption\">GAMES</span><span class=\"support-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"primary-track\"><span class=\"caption\">POINTS</span><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"row rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity-wrap\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></span><div class=\"name-lane\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\"></span></div><div class=\"support-track\"><span class=\"caption\">GAMES</span><span class=\"support-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"primary-track\"><span class=\"caption\">POINTS</span><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div></article></main></body></html>\n","css":""}
