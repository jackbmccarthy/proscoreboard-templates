{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>softball · Cobalt Fog Leadchip</title><style>:root{color-scheme:light}*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}.board{--cobalt:#23394b;--fog:#c9d7d7;--rule:#94a9b2;--blue:#3186a8;--coral:#c76c69;width:min(76vw,1560px);overflow:hidden;border-radius:4px;background:var(--cobalt);color:#f7faf9;container-type:inline-size;font-variant-numeric:tabular-nums}.header{display:flex;align-items:center;min-width:0;height:4.6cqw;padding:0 2.1%;border-bottom:1px solid var(--rule);background:var(--cobalt);white-space:nowrap}.sport-tag{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:2.55cqw;font-weight:750;letter-spacing:.015em}.status{display:flex;align-items:center;justify-content:space-between;gap:2.6cqw;flex:0 0 77%;min-width:0}.status-item{display:flex;align-items:baseline;justify-content:center;gap:.7em;min-width:0;padding-left:2.7cqw;border-left:1px solid var(--rule);font-size:1.45cqw;font-weight:600}.status-value{font-size:1.32em;font-weight:750}.lanes{display:flex;flex-direction:row;min-width:0}.lane{display:flex;align-items:center;flex:1 1 50%;min-width:0;height:8cqw;background:var(--cobalt)}.lane+.lane{border-left:1px solid var(--rule)}.identity{flex:0 0 1.05cqw;align-self:stretch;background:var(--blue)}.lane-b .identity{background:var(--coral)}.support-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 6.6cqw;height:5.9cqw;margin-left:1.1cqw;border-radius:4px;background:var(--fog);color:#132e3d;white-space:nowrap}.support-value{font-size:3.1cqw;font-weight:750;line-height:1}.support-label{font-size:1.15cqw;font-weight:700;line-height:1.1}.name{display:block;flex:1 1 auto;min-width:0;margin:0;padding:0 1.9cqw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.5cqw;font-weight:650;line-height:1.1}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.primary-track{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 9.2cqw;height:6.4cqw;margin-right:1.1cqw;padding-left:0;background:var(--cobalt);color:#fff;white-space:nowrap}.primary-value{display:block;max-width:100%;overflow:hidden;font-size:4.85cqw;font-weight:750;line-height:1;font-variant-numeric:tabular-nums}.primary-label{font-size:1.55cqw;font-weight:700}.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:700px){.stage{padding:8px}.board{width:100%;container-type:normal}.header{height:auto;min-height:40px;padding:7px 10px;gap:8px}.sport-tag{font-size:15px}.status{gap:4px;flex-basis:75%}.status-item{gap:3px;padding-left:4px;font-size:9px}.status-value{font-size:12px}.lanes{flex-direction:column}.lane{height:72px}.lane+.lane{border-left:0;border-top:1px solid var(--rule)}.identity{flex-basis:6px}.support-track{flex-basis:56px;height:52px;margin-left:6px}.support-value{font-size:28px}.support-label{font-size:11px}.name{padding:0 10px;font-size:clamp(20px,6vw,30px)}.primary-track{flex-basis:86px;height:52px;margin-right:5px;padding-left:5px;border-left:1px solid var(--rule);flex-direction:column;justify-content:center}.primary-value{font-size:35px}.primary-label{font-size:11px}}@media(max-width:390px){.sport-tag{font-size:12px}.status-item{font-size:8px}.status-value{font-size:10px}.primary-track{flex-basis:76px}.name{padding:0 6px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"softball scoreboard\"><header class=\"header\" data-osb-component=\"layout\"><span class=\"sport-tag\" data-osb-component=\"text\">SOFTBALL</span><div class=\"status\" data-osb-component=\"layout\"><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\">0</span></span><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\">0</span></span><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\">0</span></span><span class=\"status-item\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><span class=\"status-value\" data-osb-component=\"text\" data-osb-static=\"true\">0</span></span></div></header><div class=\"lanes\" data-osb-component=\"layout\"><div class=\"lane lane-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"support-label\" data-osb-component=\"text\">HITS</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-value currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">RUNS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\" hidden>0</span></div><div class=\"lane lane-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"support-track\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span><span class=\"support-label\" data-osb-component=\"text\">HITS</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"primary-track\" data-osb-component=\"layout\"><span class=\"primary-value currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-label\" data-osb-component=\"text\">RUNS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\" hidden>0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
