{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Brace Register Volleyball — Rows</title>\n  <style>\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: transparent; }\nbody { font-family: Arial, Helvetica, sans-serif; color: #f5eedb; }\n.stage { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }\n.board { width: 100%; max-width: 940px; display: flex; flex-direction: column; background: transparent; }\n.title { text-align: center; font-size: 40px; font-weight: 600; letter-spacing: .29em; padding-left: .29em; line-height: 1.2; margin-bottom: 8px; }\n.match { display: flex; height: 500px; }\n.brace-shell { display: flex; flex: 0 0 100px; align-items: center; justify-content: center; min-width: 0; color: #eee2ba; }\n.brace { display: block; font-family: \"Times New Roman\", Georgia, serif; font-size: 550px; font-weight: 400; line-height: 1; transform: translateY(-24px) scaleX(.62); }\n.teams { display: flex; flex-direction: column; justify-content: space-around; flex: 1 1 0; min-width: 0; padding-left: 30px; }\n.team { display: flex; align-items: center; height: 235px; }\n.name-color { display: block; flex: 1 1 0; min-width: 0; background-color: #a6e3c5; background-clip: text; -webkit-background-clip: text; }\n.name { display: block; width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 88px; font-weight: 700; line-height: 1.1; color: transparent; }\n.combinedAName:empty::before { content: \"Team A\"; }\n.combinedBName:empty::before { content: \"Team B\"; }\n.score-block { display: flex; align-items: flex-start; flex: 0 0 369px; min-width: 0; }\n.primary-track { display: flex; flex-direction: column; align-items: center; flex: 0 0 240px; min-width: 0; }\n.primary-score { display: block; width: calc(100% - 24px); height: 157px; font-family: \"Arial Black\", Verdana, \"DejaVu Sans\", Arial, sans-serif; font-size: 180px; font-weight: 900; line-height: .9; letter-spacing: -.07em; text-align: center; font-variant-numeric: tabular-nums; transform: scaleX(1.1); transform-origin: center; }\n.label { font-size: 30px; font-weight: 600; line-height: 1; letter-spacing: .05em; }\n.points-label { margin-top: 17px; }\n.register { display: flex; align-items: center; gap: 10px; flex: 0 0 125px; min-width: 0; margin-top: 6px; margin-left: 4px; }\n.register .label { font-size: 30px; }\n.match-score { display: block; width: 40px; font-size: 30px; font-weight: 600; line-height: 1; text-align: center; font-variant-numeric: tabular-nums; }\n.set-footer { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 35px; font-size: 32px; font-weight: 600; letter-spacing: .07em; line-height: 1; }\n.set-value { display: block; width: 30px; text-align: center; font-variant-numeric: tabular-nums; }\n.point-slot { display: none; }\n.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint { opacity: 0 !important; }\n@media (max-width: 950px) and (min-width: 601px) {\n  .name { font-size: 64px; }\n  .brace-shell { flex-basis: 75px; }\n  .score-block { flex-basis: 314px; }\n  .primary-track { flex-basis: 195px; }\n  .primary-score { font-size: 155px; }\n  .register { flex-basis: 115px; gap: 6px; }\n  .register .label, .match-score { font-size: 25px; }\n}\n@media (max-width: 600px) {\n  .stage { padding: 14px; }\n  .title { font-size: 22px; letter-spacing: .16em; margin-bottom: 15px; }\n  .match { height: 350px; }\n  .brace-shell { flex-basis: 45px; }\n  .brace { font-size: 350px; transform: translateY(-12px) scaleX(.4); }\n  .teams { padding-left: 5px; }\n  .team { height: 160px; }\n  .name { font-size: 30px; }\n  .score-block { flex-basis: 154px; }\n  .primary-track { flex-basis: 100px; }\n  .primary-score { width: calc(100% - 12px); font-size: 68px; height: 78px; transform: scale(1.12, 1.1); }\n  .label { font-size: 15px; }\n  .points-label { margin-top: 10px; }\n  .register { flex-basis: 50px; gap: 2px; margin-top: 3px; margin-left: 4px; }\n  .register .label, .match-score { font-size: 12px; }\n  .match-score { width: 15px; }\n  .set-footer { margin-top: 20px; font-size: 23px; gap: 7px; }\n  .set-value { width: 23px; }\n}\n  </style>\n</head>\n<body>\n  <main class=\"stage\">\n    <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Volleyball scoreboard\">\n      <header class=\"title\">VOLLEYBALL</header>\n      <div class=\"match rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"brace-shell\" aria-hidden=\"true\"><span class=\"brace\">{</span></div><div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-color jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-block rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"label points-label\">POINTS</span></div><div class=\"register rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"label\">SETS</span><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div></div></div>\n        <div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-color jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-block rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"primary-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"primary-score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"label points-label\">POINTS</span></div><div class=\"register rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"label\">SETS</span><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div></div>\n      </div><div class=\"brace-shell\" aria-hidden=\"true\"><span class=\"brace\">}</span></div></div>\n      <footer class=\"set-footer\">SET <span class=\"set-value\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n      <div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div>\n    </article>\n  </main>\n</body>\n</html>\n","css":""}
