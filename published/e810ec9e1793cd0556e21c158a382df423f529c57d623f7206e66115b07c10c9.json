{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Full Screen — Linescore</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none}\n.board{font-size:calc(100vw / 80);font-family:var(--font);color:var(--ink);-webkit-font-smoothing:antialiased}\n.flag{flex:0 0 auto;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.chip{background:var(--chip-default,#8a96a3)}\n.name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;font-weight:800;text-transform:uppercase;overflow-wrap:break-word;line-height:1;text-wrap:balance}\n.team{display:flex;align-items:center;gap:.4em;min-width:0;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.85}\n.tlogo{width:1.3em;height:1.3em;object-fit:contain}\n.tname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n:has(>.name:empty)>.team .tname{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.05}\n.tscore{padding:0 .4em;border-radius:.2em;background:rgba(127,127,127,.28);font-variant-numeric:tabular-nums}\n.gtag{display:inline-flex;align-items:center;gap:.3em;height:1.8em;padding:0 .8em;border-radius:.2em;font-size:1em;font-weight:800;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}\n.state{width:10.5em;height:1.8em}\n.st{border-radius:.2em;font-size:1em;font-weight:800;letter-spacing:.12em;text-transform:uppercase}\n.srv-ball{display:block;width:1em;height:1em;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 18%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .14em rgba(0,0,0,.25)}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .5em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.head:not(:has(.meta>:not(.sep):not(:empty))),.band:not(:has(.meta>:not(.sep):not(:empty))),.top:not(:has(.meta>:not(.sep):not(:empty))){display:none}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.team:not(:has(.tname:not(:empty))){display:none}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.osb-core-fields{display:none!important}\n.title:has(.big-ev:empty):has(.rd:empty):has(.bo:empty){display:none}\n.board{display:flex;flex-direction:column;align-items:stretch;width:62em;max-width:94vw}\n.card{display:flex;flex-direction:column}\n.title{display:flex;flex-direction:column;align-items:center;gap:.35em;padding:1.1em 1.5em 1em;text-align:center}\n.big-ev{font-size:2.3em;font-weight:800;letter-spacing:.04em;text-transform:uppercase;line-height:1.05;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.sub{display:flex;align-items:center;gap:.6em;font-size:1.2em;font-weight:700;letter-spacing:.14em;text-transform:uppercase}\n.sub .dot{width:.35em;height:.35em;border-radius:50%;background:currentColor;opacity:.6}\n.sub .rd:empty+.dot,.sub .dot:has(+.bo:empty){display:none}\n.title:has(.big-ev:empty){padding-top:.8em}\n.table{display:flex;align-items:stretch}\n.names{display:flex;flex-direction:column;flex:1 1 auto;min-width:0}\n.lab{display:flex;align-items:center;justify-content:center;height:2.2em;font-size:.95em;font-weight:800;letter-spacing:.14em;text-transform:uppercase}\n.names>.lab{justify-content:flex-start;padding-left:1.6em}\n.who{display:flex;align-items:center;gap:.8em;height:5em;padding:0 1em 0 0;min-width:0}\n.who .chip{flex:0 0 .6em;align-self:stretch}\n.who .flag{width:3em;height:2em}\n.nm{display:flex;flex-direction:column;justify-content:center;gap:.2em;min-width:0}\n.who .name{font-size:2em}\n.who .team{font-size:1.05em}\n.nm:has(.name:empty) .team{font-size:1.6em;opacity:1}\n.cols{display:flex;flex:0 0 auto}\n.gc{display:flex;flex-direction:column;width:4.1em;flex:0 0 4.1em}\n.v{display:flex;align-items:center;justify-content:center;height:5em;font-weight:800;font-variant-numeric:tabular-nums}\n.gc .v>*{font-size:2.2em}\n.won{display:flex;flex-direction:column;flex:0 0 7em}\n.won .v>*{font-size:3.6em;font-weight:900}\n.foot{display:flex;align-items:center;justify-content:center;gap:.6em;height:3.4em}\n.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])) .gc:not([style*=\"display: none\"]):not([style*=\"display:none\"]):not(:has(~ .gc:not([style*=\"display: none\"]):not([style*=\"display:none\"])))>*>*{opacity:.4}\n.t-ls{--font:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;--ink:#fff}\n.t-ls .card{border-radius:.5em;overflow:hidden;box-shadow:0 1em 3em rgba(0,0,0,.5);background:#0b1626}\n.t-ls .title{background:linear-gradient(180deg,#14284a,#0f1f3a);color:#fff}\n.t-ls .sub{color:#8fb4ec}\n.t-ls .table{background:#0f1f3a;border-top:.2em solid #3d8bff}\n.t-ls .lab{background:#0b1626;color:#7f9cc7}\n.t-ls .who+.who,.t-ls .v+.v{border-top:1px solid #23395f}\n.t-ls .gc{border-left:1px solid #23395f;color:#dfe8f7}\n.t-ls .won{background:#3d8bff;color:#fff}\n.t-ls .won .lab{background:#2f73d9;color:#e6f0ff}\n.t-ls .won .v+.v{border-top:1px solid #74abff}\n.t-ls .gtag{background:#14284a;color:#fff;box-shadow:inset 0 0 0 .1em #3d8bff}\n.t-ls .st-warm,.t-ls .st-break{background:#0b1626;color:#e6eefb;box-shadow:inset 0 0 0 .12em #3d5b8a}\n.t-ls .st-gp{background:#ff8a1c;color:#111}\n.t-ls .st-mp{background:#e3262f;color:#fff}\n.t-ls .st-final{background:#fff;color:#0b1626}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.lab{font-size:1.25vw!important}\n.dot{width:1.016vw!important;height:1.016vw!important;min-width:0!important;flex-shrink:0!important}\n/* end stream-size floor */\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-ls\" data-osb-component=\"layout\"><div class=\"card\" data-osb-component=\"layout\"><div class=\"title\" data-osb-component=\"layout\"><span class=\"eventName big-ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"sub\"><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"dot\"></i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span></div><div class=\"table\" data-osb-component=\"layout\"><div class=\"names\" data-osb-component=\"layout\"><span class=\"lab\">Game</span><div class=\"who wA\" data-osb-component=\"layout\"><span class=\"jerseyColorA chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nm\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span></div><div class=\"who wB\" data-osb-component=\"layout\"><span class=\"jerseyColorB chip\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"nm\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"team\"><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span></span></div></div><div class=\"cols\" data-osb-component=\"layout\"><div class=\"gc isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"lab\">1</span><span class=\"v\"><span class=\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"v\"><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"gc isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"lab\">2</span><span class=\"v\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"v\"><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"gc isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"lab\">3</span><span class=\"v\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"v\"><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"gc isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"lab\">4</span><span class=\"v\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"v\"><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"gc isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"lab\">5</span><span class=\"v\"><span class=\"game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"v\"><span class=\"game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"gc isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"lab\">6</span><span class=\"v\"><span class=\"game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"v\"><span class=\"game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"gc isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"lab\">7</span><span class=\"v\"><span class=\"game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"v\"><span class=\"game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div><div class=\"gc isGame8Started\" data-osb-component=\"layout\" data-osb-field=\"isGame8Started\" style=\"display:none\"><span class=\"lab\">8</span><span class=\"v\"><span class=\"game8AScore\" data-osb-component=\"field\" data-osb-field=\"game8AScore\">0</span></span><span class=\"v\"><span class=\"game8BScore\" data-osb-component=\"field\" data-osb-field=\"game8BScore\">0</span></span></div><div class=\"gc isGame9Started\" data-osb-component=\"layout\" data-osb-field=\"isGame9Started\" style=\"display:none\"><span class=\"lab\">9</span><span class=\"v\"><span class=\"game9AScore\" data-osb-component=\"field\" data-osb-field=\"game9AScore\">0</span></span><span class=\"v\"><span class=\"game9BScore\" data-osb-component=\"field\" data-osb-field=\"game9BScore\">0</span></span></div></div><div class=\"won\" data-osb-component=\"layout\"><span class=\"lab\">Games</span><span class=\"v\"><span class=\"currentAMatchScore AScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></span><span class=\"v\"><span class=\"currentBMatchScore BScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span></div></div></div><div class=\"foot\" data-osb-component=\"layout\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"slot state\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isComplete st st-final\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></div></article><div class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></main>\n</body>\n</html>\n","css":""}
