{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Classic Final Line Score</title><style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nhtml{font-size:1.25vw}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;font-synthesis:none}\n.bb-retained{display:none}\n.bb-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.diamond{position:relative;display:block;flex:none;width:var(--d,3rem);height:calc(var(--d,3rem)*.8)}\n.diamond>.base{position:absolute;width:30%;height:37.5%;transform:rotate(45deg);background:var(--base-off,transparent);border:var(--base-line,.12rem) solid var(--base-edge,currentColor);border-radius:var(--base-r,.06rem)}\n.diamond>.base.second{left:35%;top:10%}.diamond>.base.third{left:8%;top:44%}.diamond>.base.first{left:62%;top:44%}\n.diamond::before{content:\"\";position:absolute;left:calc(var(--d,3rem)*.309);top:calc(var(--d,3rem)*.311);width:calc(var(--d,3rem)*.382);height:calc(var(--d,3rem)*.382);transform:rotate(45deg);border:1px solid var(--base-edge,currentColor);opacity:.28}\n.bb-plate{display:none}\n.bb-bases{position:absolute;left:0;right:0;bottom:-.1rem;text-align:center;font:700 .42rem/1 var(--mono-ui,Menlo,Consolas,monospace);letter-spacing:.04em;color:var(--base-text,currentColor);opacity:.85}\n.bb-half{position:relative;display:inline-block;flex:none;vertical-align:middle}\n.bb-half-dim{position:absolute;inset:0}\n.bb-half-dim::before,.bb-half-dim::after,.inningHalf::before,.inningHalf::after{content:\"\";background:var(--half-off,rgba(255,255,255,.28))}\n.bb-half-dim::before,.bb-half-dim::after{position:absolute;left:0;width:100%;height:100%}\n.bb-half-dim::before,.inningHalf::after{clip-path:polygon(50% 4%,96% 40%,4% 40%)}\n.bb-half-dim::after,.inningHalf::before{clip-path:polygon(4% 60%,96% 60%,50% 96%)}\n.bb-half-win{position:relative;display:block;width:3ch;height:var(--half-h,1.2rem);overflow:hidden;font-family:Menlo,Consolas,\"DejaVu Sans Mono\",\"Liberation Mono\",monospace;font-size:var(--half-size,.62rem);font-weight:400;line-height:var(--half-h,1.2rem);letter-spacing:0;text-transform:none}\n.inningHalf{display:flex;width:max-content;height:100%;margin-left:-6ch;color:transparent;white-space:pre}\n.inningHalf::before,.inningHalf::after{flex:none;width:3ch;height:100%;background:var(--half-on,#fff)}\n.inningHalf::before{order:1}.inningHalf::after{order:2}\n.bb-ls-col>.bb-gate{display:flex;flex-direction:column;align-items:stretch}\n.bb-tick{position:relative}.bb-tick>.bb-gate{display:block;position:absolute;inset:0;border-radius:inherit;background:var(--tick-on,#fff)}\n.bb-ls-extra{display:none!important}.bb-ls-extra:has(>.bb-gate[style*=\"opacity: 1\"]),.bb-ls-extra:has(>.bb-gate[style*=\"opacity:1\"]){display:flex!important}\n.bb-live,.bb-break,.bb-final{transition:opacity .25s ease}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n.bb-stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-family:\"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;color:#eef2f8}\n.ff{width:52rem;border-radius:.5rem;overflow:hidden;background:#0f1d2f;box-shadow:0 .6rem 2rem rgba(0,0,0,.5)}\n.ff-head{position:relative;display:flex;align-items:flex-end;justify-content:space-between;padding:1.2rem 1.6rem 1rem;background:linear-gradient(120deg,#13284a,#7c1324);color:#ffffff}\n.ff-titles{display:flex;flex-direction:column;gap:.35rem}\n.ff-head .bb-event{font:800 1.9rem/1 \"Avenir Next Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase;letter-spacing:.03em}\n.ff-head .bb-round{font:700 .8rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.2em;text-transform:uppercase;opacity:.85}\n.ff-kicker{font:700 .7rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.3em;opacity:.8}\n.ff-badges{display:flex;flex-direction:column;align-items:flex-end;gap:.35rem}\n.bb-final{padding:.35rem .8rem;border-radius:.2rem;background:#c8102e;color:#fff;font:800 1rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.2em}\n.ff-sport{font:700 .65rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.3em;opacity:.75}\n.ff-body{padding:1rem 1.6rem 1.3rem}\n.bb-ls{display:flex;align-items:stretch;border:1px solid rgba(255,255,255,.09);border-radius:.3rem;overflow:hidden}\n.bb-ls-teams,.bb-ls-col{display:flex;flex-direction:column}\n.bb-ls-h{display:flex;align-items:center;justify-content:center;height:1.6rem;background:#162a45;color:#9fb0c8;font:700 .75rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.08em}\n.bb-ls-teams{flex:1;min-width:0}.bb-ls-teams .bb-ls-h{justify-content:flex-start;padding-left:1rem}\n.bb-ls-team{display:flex;align-items:center;gap:.8rem;height:3.4rem;padding-right:.6rem}\n.bb-ls-team+.bb-ls-team{border-top:1px solid rgba(255,255,255,.09)}\n.bb-ls-chip{align-self:stretch;width:.55rem;background:#c8102e}\n.bb-ls-name{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:700 1.7rem/1 \"Avenir Next Condensed\",\"Bahnschrift Condensed\",\"Roboto Condensed\",\"Arial Narrow\",sans-serif;text-transform:uppercase}\n.bb-ls-innings{display:flex;border-left:1px solid rgba(255,255,255,.09)}\n.bb-ls-col{width:2.4rem}.bb-ls-col>.bb-gate{flex:1}\n.bb-ls-v{display:flex;align-items:center;justify-content:center;height:3.4rem;font:600 1.35rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;font-variant-numeric:tabular-nums}\n.bb-ls-v+.bb-ls-v{border-top:1px solid rgba(255,255,255,.09)}\n.bb-ls-innings .bb-ls-col:nth-child(even){background:rgba(255,255,255,.025)}\n.bb-ls-r{width:3.6rem;background:#c8102e;color:#fff}.bb-ls-r .bb-ls-h{background:#a00d25;color:#fff}\n.bb-ls-r .bb-ls-v{font-size:2rem;font-weight:800}\n.bb-ls-he{width:2.8rem;background:#162a45}.bb-ls-he .bb-ls-v{font-size:1.45rem}\n.ff-foot{display:flex;align-items:center;justify-content:space-between;margin-top:.8rem;color:#9fb0c8;font:700 .65rem/1 \"DIN Alternate\",\"Bahnschrift\",\"D-DIN\",\"Roboto Condensed\",\"Arial\",sans-serif;letter-spacing:.18em}\n.ff-foot .bb-live{color:#c8102e}\n</style></head><body><main class=\"bb-stage\" aria-label=\"Baseball full-screen scoreboard\">\n<article class=\"ff columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball final line score\">\n<header class=\"ff-head\"><div class=\"ff-titles\"><span class=\"ff-kicker\">LINE SCORE</span><span class=\"bb-event eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"bb-round matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></div><div class=\"ff-badges\"><span class=\"bb-final isComplete\" data-osb-component=\"field\" style=\"opacity: 0\">FINAL</span><span class=\"ff-sport\">BASEBALL · 9 INNINGS</span></div></header>\n<div class=\"ff-body\"><div class=\"bb-ls rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"bb-ls-teams\"><span class=\"bb-ls-h\">TEAM</span><span class=\"bb-ls-team\"><span class=\"bb-ls-chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"bb-ls-name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></span><span class=\"bb-ls-team\"><span class=\"bb-ls-chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"bb-ls-name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></span></span><span class=\"bb-ls-innings\"><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">1</span><span class=\"bb-gate isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span><span class=\"bb-ls-v game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">2</span><span class=\"bb-gate isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span><span class=\"bb-ls-v game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">3</span><span class=\"bb-gate isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span><span class=\"bb-ls-v game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">4</span><span class=\"bb-gate isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span><span class=\"bb-ls-v game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">5</span><span class=\"bb-gate isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span><span class=\"bb-ls-v game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">6</span><span class=\"bb-gate isGame6Started\" data-osb-component=\"field\" data-osb-field=\"isGame6Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span><span class=\"bb-ls-v game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">7</span><span class=\"bb-gate isGame7Started\" data-osb-component=\"field\" data-osb-field=\"isGame7Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span><span class=\"bb-ls-v game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">8</span><span class=\"bb-gate isGame8Started\" data-osb-component=\"field\" data-osb-field=\"isGame8Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game8AScore\" data-osb-component=\"field\" data-osb-field=\"game8AScore\">0</span><span class=\"bb-ls-v game8BScore\" data-osb-component=\"field\" data-osb-field=\"game8BScore\">0</span></span></span><span class=\"bb-ls-col\"><span class=\"bb-ls-h\">9</span><span class=\"bb-gate isGame9Started\" data-osb-component=\"field\" data-osb-field=\"isGame9Started\" style=\"opacity: 0\"><span class=\"bb-ls-v game9AScore\" data-osb-component=\"field\" data-osb-field=\"game9AScore\">0</span><span class=\"bb-ls-v game9BScore\" data-osb-component=\"field\" data-osb-field=\"game9BScore\">0</span></span></span><span class=\"bb-ls-col bb-ls-extra\"><span class=\"bb-ls-h\">10</span><span class=\"bb-gate isGame10Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"bb-ls-v game10AScore\" data-osb-component=\"field\">0</span><span class=\"bb-ls-v game10BScore\" data-osb-component=\"field\">0</span></span></span><span class=\"bb-ls-col bb-ls-extra\"><span class=\"bb-ls-h\">11</span><span class=\"bb-gate isGame11Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"bb-ls-v game11AScore\" data-osb-component=\"field\">0</span><span class=\"bb-ls-v game11BScore\" data-osb-component=\"field\">0</span></span></span><span class=\"bb-ls-col bb-ls-extra\"><span class=\"bb-ls-h\">12</span><span class=\"bb-gate isGame12Started\" data-osb-component=\"field\" style=\"opacity: 0\"><span class=\"bb-ls-v game12AScore\" data-osb-component=\"field\">0</span><span class=\"bb-ls-v game12BScore\" data-osb-component=\"field\">0</span></span></span></span><span class=\"bb-ls-col bb-ls-r\"><span class=\"bb-ls-h\">R</span><span class=\"bb-ls-v bb-ls-runs currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"bb-ls-v bb-ls-runs currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></span><span class=\"bb-ls-col bb-ls-he\"><span class=\"bb-ls-h\">H</span><span class=\"bb-ls-v hitsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</span><span class=\"bb-ls-v hitsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</span></span><span class=\"bb-ls-col bb-ls-he\"><span class=\"bb-ls-h\">E</span><span class=\"bb-ls-v errorsA\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsA\">0</span><span class=\"bb-ls-v errorsB\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"errorsB\">0</span></span></div>\n<div class=\"ff-foot\"><span>R RUNS · H HITS · E ERRORS</span><span class=\"bb-live isMatchStarted\" data-osb-component=\"field\" style=\"opacity: 0\">IN PROGRESS</span></div></div>\n</article>\n<span class=\"bb-sr battingSide\" data-osb-component=\"field\"></span><span class=\"bb-retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"bb-retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main></body></html>\n","css":""}
