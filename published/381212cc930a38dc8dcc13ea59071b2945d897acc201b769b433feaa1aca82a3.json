{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Ivory Cobalt Line basketball 1</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#152842}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;min-width:0;padding:14px 0}.board{width:min(64vw,calc((100vh - 28px)*2.25));max-width:1450px;container-type:inline-size;min-width:0;background:#faf9f3;border:2px solid #1557b0;border-radius:2px;overflow:hidden}.header{display:flex;align-items:center;min-width:0;min-height:6.9cqw;border-bottom:1px solid #587089;background:#faf9f3}.sport-title{flex:1 1 0;min-width:0;margin:0;padding:1.2cqw 2.4cqw;font-size:4.7cqw;line-height:1.1;font-weight:700}.column-label{flex:0 0 25.2%;min-width:0;text-align:center;font-size:3.5cqw;line-height:1.1;font-weight:700}.row{display:flex;align-items:stretch;min-width:0;min-height:12.3cqw;border-bottom:1px solid #587089;background:#faf9f3}.identity{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:1.5cqw 2cqw;gap:3.8cqw}.tick{display:block;flex:0 0 3px;height:7.8cqw;min-width:0;background:#1557b0}.name{display:block;flex:1 1 0;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:7.3cqw;line-height:1.1;font-weight:700;letter-spacing:-.025em;color:#152842}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-zone{display:flex;align-items:center;justify-content:center;flex:0 0 25.2%;min-width:0;background:#1557b0;color:#ffffff}.score{display:block;width:100%;min-width:0;font-size:10.3cqw;line-height:1.1;font-weight:700;font-variant-numeric:tabular-nums;text-align:center;white-space:nowrap;letter-spacing:-.02em;color:#ffffff}.footer{display:flex;align-items:stretch;justify-content:center;min-width:0;min-height:11.1cqw;padding:1.3cqw 0;background:#152842;color:#ffffff}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:2.4cqw;padding:0 1cqw}.stat.clock{flex:1.3 1 0}.stat+.stat{border-left:1px solid #587089}.label{display:block;font-size:2.65cqw;line-height:1.1;font-weight:700;white-space:nowrap}.value{display:block;font-size:6cqw;line-height:1.1;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}.basketball.variant-1 .stat{flex-direction:column;gap:.4cqw}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}.variant-2{width:min(90vw,calc((100vh - 28px)*6));max-width:1850px}.duel{display:flex;align-items:stretch;min-width:0;border-bottom:1px solid #587089;min-height:8.7cqw}.endcap{display:flex;align-items:center;justify-content:center;flex:0 0 20.5cqw;min-width:0;background:#1557b0;color:#ffffff}.endcap .sport-title{flex:none;min-width:0;font-size:2.8cqw;padding:.8cqw .5cqw;text-align:center;white-space:nowrap;color:#ffffff}.competitors{display:flex;align-items:stretch;flex:1 1 0;min-width:0}.variant-2 .row{flex:1 1 0;min-width:0;min-height:8.7cqw;border-bottom:0}.variant-2 .row+.row{border-left:1px solid #587089}.variant-2 .identity{padding:.8cqw .8cqw;gap:2cqw}.variant-2 .tick{height:6.8cqw}.variant-2 .name{font-size:3.8cqw}.variant-2 .score-zone{flex:0 0 11cqw;flex-direction:column;gap:.3cqw;padding:.6cqw 0}.variant-2 .score-zone .label{font-size:1.6cqw;color:#ffffff;text-align:center}.variant-2 .score{font-size:5.2cqw}.variant-2 .footer{min-height:5.8cqw;padding:1.3cqw 0}.variant-2 .label{font-size:1.8cqw}.variant-2 .value{font-size:3.2cqw}.soccer.variant-1{width:min(55.8vw,calc((100vh - 28px)*2.1));max-width:1300px}.soccer.variant-1 .header{min-height:8.1cqw}.soccer.variant-1 .sport-title{font-size:5.1cqw;padding:1.3cqw 3.5cqw}.soccer.variant-1 .column-label{flex-basis:25%;font-size:3.5cqw}.soccer.variant-1 .row{min-height:13.9cqw}.soccer.variant-1 .identity{padding:1.2cqw 1.1cqw;gap:4.4cqw}.soccer.variant-1 .tick{height:11cqw}.soccer.variant-1 .name{font-size:8.3cqw}.soccer.variant-1 .score-zone{flex-basis:25%}.soccer.variant-1 .score{font-size:10.4cqw}.soccer.variant-1 .footer{min-height:9.2cqw;padding:1.4cqw 0;gap:5cqw}.soccer.variant-1 .stat{flex:none;gap:5cqw;padding:0}.soccer.variant-1 .stat.clock{flex:none}.soccer.variant-1 .stat+.stat{padding-left:5cqw}.soccer.variant-1 .footer .label{font-size:3.1cqw}.soccer.variant-1 .value{font-size:5.9cqw;border-left:1px solid #587089;padding-left:5cqw}.soccer.variant-2{width:min(83vw,calc((100vh - 28px)*5.8));max-width:1800px}.soccer.variant-2 .duel,.soccer.variant-2 .row{min-height:9.2cqw}.soccer.variant-2 .endcap{flex-basis:15cqw}.soccer.variant-2 .endcap .sport-title{font-size:2.8cqw}.soccer.variant-2 .identity{padding:1.1cqw 1.3cqw;gap:1.8cqw}.soccer.variant-2 .tick{height:6.6cqw}.soccer.variant-2 .score-zone{flex-basis:12.5cqw;gap:.5cqw}.soccer.variant-2 .score{font-size:6.1cqw}.soccer.variant-2 .footer{min-height:6cqw;padding:1.3cqw 0;gap:3cqw}.soccer.variant-2 .stat{flex:none;padding:0 3cqw;gap:2.6cqw}.soccer.variant-2 .stat.clock{flex:none}.soccer.variant-2 .footer .label{font-size:2.2cqw}.soccer.variant-2 .value{font-size:3.8cqw}.soccer.variant-2 .stat.clock .value{border-left:1px solid #587089;padding-left:3cqw}@media(max-width:600px){.board,.variant-2,.soccer.variant-1,.soccer.variant-2{width:94vw}.header,.soccer.variant-1 .header{min-height:44px}.sport-title,.soccer.variant-1 .sport-title{font-size:17px;padding:10px 12px}.column-label,.soccer.variant-1 .column-label{font-size:12px;flex-basis:80px}.row,.soccer.variant-1 .row{min-height:64px}.identity,.soccer.variant-1 .identity{padding:10px 12px;gap:14px}.tick,.soccer.variant-1 .tick{flex-basis:3px;height:36px}.name,.soccer.variant-1 .name{font-size:22px}.score-zone,.soccer.variant-1 .score-zone{flex-basis:80px}.score,.soccer.variant-1 .score{font-size:34px}.footer,.soccer.variant-1 .footer{min-height:66px;padding:10px 0;gap:0}.stat{gap:8px;padding:0 5px}.footer .label,.soccer.variant-1 .footer .label{font-size:11px}.value,.soccer.variant-1 .value{font-size:20px}.basketball.variant-1 .value{font-size:24px}.soccer.variant-1 .stat{gap:8px;padding:0}.soccer.variant-1 .stat+.stat{padding-left:16px;margin-left:16px}.soccer.variant-1 .value{padding-left:8px}.duel{flex-direction:column;min-height:0}.endcap,.soccer.variant-2 .endcap{flex:none;width:100%;min-height:44px;justify-content:flex-start;padding:10px 14px}.endcap .sport-title,.soccer.variant-2 .endcap .sport-title{font-size:15px;padding:0}.competitors{flex-direction:column;width:100%;min-width:0}.variant-2 .row,.soccer.variant-2 .row{flex:none;width:100%;min-height:64px}.variant-2 .row+.row{border-left:0;border-top:1px solid #587089}.variant-2 .identity,.soccer.variant-2 .identity{padding:10px 14px;gap:14px}.variant-2 .tick,.soccer.variant-2 .tick{height:36px}.variant-2 .name{font-size:22px}.variant-2 .score-zone,.soccer.variant-2 .score-zone{flex-basis:84px;gap:3px;padding:5px 0}.variant-2 .score-zone .label{font-size:10px}.variant-2 .score,.soccer.variant-2 .score{font-size:34px}.variant-2 .footer,.soccer.variant-2 .footer{min-height:56px;padding:10px 0;gap:0}.variant-2 .footer .label{font-size:11px}.variant-2 .value{font-size:20px}.soccer.variant-2 .stat{gap:8px;padding:0 14px}.soccer.variant-2 .stat.clock .value{padding-left:8px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer basketball variant-1\" data-osb-component=\"layout\"><header class=\"header rowContainer\" data-osb-component=\"layout\"><h1 class=\"sport-title\" data-osb-component=\"text\">BASKETBALL</h1><span class=\"column-label\" data-osb-component=\"text\">POINTS</span></header><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-zone columnContainer\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"row rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-zone columnContainer\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section><footer class=\"footer rowContainer\" data-osb-component=\"layout\"><div class=\"stat clock rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat period rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">PERIOD</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></div><div class=\"stat shot rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SHOT</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"shot-clock\">00</span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\" currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\" currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\" isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\" isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
