{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Antenna Frame</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.25)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing{animation:none!important;transition:none!important}}\n.clamp2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;line-height:1.02}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.sslot{align-items:center}.sslot>.st{display:flex;align-items:center;justify-content:center;gap:.4em;white-space:nowrap;height:100%}\n.pslot>.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hist:not(:has(>[style*=\"opacity: 1\"])){display:none}\n.board:has(.isComplete[style*=\"opacity: 1\"]) .srv[style*=\"opacity: 1\"]{opacity:.3!important;filter:grayscale(1)}\n.pip{position:relative;display:block}.pip>.lit{position:absolute;inset:0;border-radius:inherit}\n\n.stage{position:fixed;left:4rem;bottom:4rem}\n.board{position:relative;width:80rem;padding-left:1.2rem;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;color:#141821;filter:drop-shadow(0 .5rem 1.1rem #0008)}\n.board::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:1.2rem;background:repeating-linear-gradient(#e3242b 0 1.6rem,#fff 0 3.2rem);border-radius:.3rem 0 0 .3rem}\n.top{display:flex;align-items:stretch;height:3.2rem;font-size:1.5rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}\n.sslot{min-width:13.5rem}.sslot>.st{padding:0 1.2rem;background:#141821;color:#fff}.sslot>.sdec{background:#e3242b}.sslot>.sbrk{background:#5b6475}.sslot>.sfin{background:#e3242b}\n.ctx{flex:1;min-width:0;display:flex;align-items:center;gap:.6rem;padding:0 1.2rem;background:#e9ecf1;color:#4a5263;white-space:nowrap;overflow:hidden}.ctx .sep{font-style:normal;color:#e3242b}\n.lhead,.lrow{display:flex;align-items:stretch}\n.lhead{height:2.4rem;background:#f6f7f9;color:#7a8291;font-size:1.25rem;font-weight:700;letter-spacing:.12em;border-bottom:.1rem solid #dfe3ea}\n.lh{display:flex;align-items:center;justify-content:center}.lh.lead{flex:1;justify-content:flex-start;padding-left:1.9rem}\n.lc{width:5rem;flex:none;display:flex;align-items:center;justify-content:center}.lsets{width:5.6rem;flex:none}.lpts{width:7.6rem;flex:none}\n.lrow{position:relative;height:5.6rem;background:#fff}.rB{border-top:.1rem solid #e3e6ec}\n.chip{width:.9rem;flex:none}\n.lname{flex:1;min-width:0;display:flex;align-items:center;gap:.8rem;padding:0 1rem}\n.nm{flex:1;min-width:0;font-size:2.3rem;font-weight:800;letter-spacing:-.01em}\n.srv{width:2.4rem;flex:none;display:flex;align-items:center;justify-content:center}.vball{width:2.1rem;height:2.1rem}\n.pips{display:flex;flex-direction:column;gap:.45rem;flex:none}.pip{width:1.5rem;height:.6rem;border-radius:.12rem;background:#e1e4ea}.pip>.lit{background:#141821}\n.lrow .lc{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.3rem;font-weight:700;color:#6a7282;border-left:.1rem solid #eef0f4}\n.lrow>.lc[style*=\"opacity: 1\"]:not(:has(~.lc[style*=\"opacity: 1\"])){color:#e3242b}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) .lrow>.lc,.board:has(.isComplete[style*=\"opacity: 1\"]) .lrow>.lc{color:#6a7282!important}\n.sets{width:5.6rem;flex:none;display:flex;align-items:center;justify-content:center;background:#f1f3f6;color:#e3242b;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3rem;font-weight:700}\n.pts{width:7.6rem;flex:none;display:flex;align-items:center;justify-content:center;background:#141821;color:#fff;font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.9rem;font-weight:700}\n.tob{position:absolute;left:100%;top:0;bottom:0;display:flex;align-items:center;gap:.6rem;padding:0 1.1rem;background:#e3242b;color:#fff;font-size:1.5rem;font-weight:800;letter-spacing:.08em;white-space:nowrap}.tob em{font-style:normal}.tob b{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:2.1rem}\n.pslot{position:absolute;right:0;bottom:100%;margin-bottom:.5rem}.pt{height:3.2rem;padding:0 1.4rem;font-size:1.6rem;font-weight:800;letter-spacing:.1em;background:#141821;color:#fff;border-left:.5rem solid #e3242b}.pt.mp{background:#e3242b;border-left-color:#fff}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"top\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"slot sslot\"><span class=\"st sset\">SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sdec isDecidingSet\" data-osb-component=\"field\" data-osb-field=\"isDecidingSet\" style=\"opacity:0\">DECIDING SET</span><span class=\"st sbrk isInBetweenGames\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">END OF SET <span class=\"num currentGame\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"st sfin isComplete\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">FINAL</span></span><span class=\"ctx\"><span class=\"eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep\">&middot;</i><span class=\"matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span></span></div>\n<div class=\"lhead\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"lh lead\">TEAM</span><span class=\"lh lc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\">1</span><span class=\"lh lc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\">2</span><span class=\"lh lc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\">3</span><span class=\"lh lc isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\">4</span><span class=\"lh lc isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\">5</span><span class=\"lh lsets\">SETS</span><span class=\"lh lpts\">PTS</span></div>\n<div class=\"lrow rA\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"lname\"><span class=\"nm clamp2 combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"srv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isATimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isATimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isATimeoutLeft2\" style=\"opacity:0\"></b></i></span></span><span class=\"lc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><span class=\"num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"lc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><span class=\"num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"lc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><span class=\"num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"lc isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><span class=\"num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"lc isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><span class=\"num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"sets num setsWonA currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"pts num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"tob isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"tclock num timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</b></span></div>\n<div class=\"lrow rB\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"lname\"><span class=\"nm clamp2 combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"srv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"pips\"><i class=\"pip\"><b class=\"lit isBTimeoutLeft1\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft1\" style=\"opacity:0\"></b></i><i class=\"pip\"><b class=\"lit isBTimeoutLeft2\" data-osb-component=\"field\" data-osb-field=\"isBTimeoutLeft2\" style=\"opacity:0\"></b></i></span></span><span class=\"lc isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"opacity:0\"><span class=\"num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span><span class=\"lc isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"opacity:0\"><span class=\"num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span><span class=\"lc isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"opacity:0\"><span class=\"num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span><span class=\"lc isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"opacity:0\"><span class=\"num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span><span class=\"lc isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"opacity:0\"><span class=\"num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span><span class=\"sets num setsWonB currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"pts num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"tob isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"opacity:0\"><em>TIMEOUT</em><b class=\"tclock num timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</b></span></div>\n<span class=\"slot pslot\"><span class=\"pt gp isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"pt mp isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span><span class=\"osb-core-fields\"><span class=\"num timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\">0</span><span class=\"num timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\">0</span></span></section></main>\n</body>\n</html>\n","css":""}
