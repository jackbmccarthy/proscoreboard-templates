{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Pearl Ledger Side Index horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#24373c}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;width:min(95vw,1900px);max-width:100%;min-width:0;overflow:hidden;border:1px solid #a7b7b4;border-radius:4px;background:#e9eeeb;container-type:inline-size}\n.index{display:flex;flex-direction:column;justify-content:center;flex:0 0 17.5%;min-width:0;padding:.85cqw;border-right:1px solid #a7b7b4;background:#e9eeeb}\n.sport-tag{display:block;min-width:0;color:#24373c;font-size:2cqw;font-weight:800;line-height:1;white-space:nowrap}\n.status{display:flex;flex-direction:column;gap:.25cqw;margin-top:.9cqw}\n.stat{display:flex;align-items:baseline;justify-content:space-between;gap:.7cqw;min-width:0;color:#24373c;font-size:1.55cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stat strong{font-variant-numeric:tabular-nums}\n.competitors{display:flex;align-items:stretch;flex:1 1 auto;min-width:0}\n.competitor{display:flex;align-items:center;flex:1 1 50%;min-width:0;height:11.6cqw;background:#e9eeeb}\n.competitor+.competitor{border-left:1px solid #a7b7b4}\n.identity{display:block;flex:none;width:1.1cqw;height:63%;margin:0 1.2cqw;background:#2178d8}\n.jerseyColorB{background:#ff6161}\n.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 .5cqw;color:#24373c;font-size:4cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.hits-track,.score-track{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:none;min-width:0;height:73%;background:#e9eeeb}\n.hits-track{width:18%}.score-track{width:22%;border-left:1px solid #a7b7b4}\n.field-label{display:block;color:#24373c;font-size:1.65cqw;font-weight:700;line-height:1;white-space:nowrap}\n.hit-value,.score{display:block;max-width:100%;overflow:hidden;color:#24373c;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:center}\n.hit-value{font-size:4cqw}.score{font-size:4.8cqw}\n.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%}.index{flex-basis:23%;padding:4px}.sport-tag{font-size:9px}.status{gap:6px;margin-top:8px}.stat{font-size:8px;gap:2px}.competitor{height:83px}.identity{width:3px;height:62%;margin:0 4px}.name{font-size:clamp(13px,3.5vw,19px);padding:0 2px}.hits-track{width:19%}.score-track{width:30%}.field-label{font-size:8px}.hit-value{font-size:15px}.score{font-size:clamp(20px,5.3vw,26px)}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Softball scoreboard\">\n<aside class=\"index columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOFTBALL</span><div class=\"status columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Editable static softball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></aside>\n<div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"hits-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"field-label\" data-osb-component=\"text\">HITS</span><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong></div><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"field-label\" data-osb-component=\"text\">RUNS</span><strong class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"hits-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"field-label\" data-osb-component=\"text\">HITS</span><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong></div><div class=\"score-track columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><span class=\"field-label\" data-osb-component=\"text\">RUNS</span><strong class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
