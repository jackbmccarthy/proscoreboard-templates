{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Softball — Copper Slate Score Rail, horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:12px}.package{width:min(88vw,1490px,calc((100vh - 24px)*4.58));max-width:100%;container-type:inline-size}.board{display:flex;flex-direction:column;overflow:hidden;border:2px solid #9babb3;border-radius:4px;background:#dce4e8}.header{display:flex;align-items:center;justify-content:center;height:5.2cqw;min-height:30px;background:#f4f5f2;border-bottom:4px solid #b98262;color:#252c33}.sport{font-size:3.7cqw;line-height:1;font-weight:800;white-space:nowrap}.competitors{display:flex;min-width:0}.competitor{display:flex;align-items:stretch;flex:1 1 50%;width:50%;min-width:0;height:9.8cqw;min-height:48px;background:#dce4e8}.competitor+.competitor{border-left:2px solid #9babb3}.score-cell{display:flex;align-items:center;justify-content:center;flex:0 0 26.5%;min-width:0;flex-direction:column;background:#252c33;color:#fff}.score{display:block;width:100%;text-align:center;font-size:6.5cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}.run-label{font-size:1.8cqw;font-weight:700;line-height:1;color:#b9c8ce}.identity-tick{display:block;flex:0 0 4%;background:#b98262}.jerseyColorB{background:#86aab9}.name{display:block;align-content:center;min-width:0;flex:1 1 0;padding:0 2.2cqw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.9cqw;font-weight:800;line-height:1;color:#252c33}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.stats{display:flex;min-height:6.7cqw;align-items:center;background:#252c33;border-top:2px solid #9babb3;color:#fff}.stat{display:flex;align-items:center;justify-content:center;gap:3cqw;flex:1 1 0;min-width:0;padding:.8cqw}.stat+.stat{border-left:2px solid #9babb3}.stat-label{font-size:1.9cqw;font-weight:700;line-height:1;color:#b3c0c6;white-space:nowrap}.stat-value{font-size:4.0cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.hidden,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:600px){.package{width:100%}.header{border-bottom-width:2px}.sport{font-size:max(14px,3.7cqw)}.competitor{min-height:54px}.score{font-size:max(23px,6.5cqw)}.run-label{font-size:max(8px,1.8cqw)}.name{font-size:max(13px,3.9cqw)}.stat{gap:.7cqw}.stat+.stat,.competitor+.competitor{border-left-width:1px}.stat-label{font-size:max(9px,1.9cqw)}.stat-value{font-size:max(14px,4.0cqw)}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"package board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Softball scoreboard\"><header class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport\" data-osb-static=\"true\">SOFTBALL</span></header><div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"competitor fixedRowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-fixed-row-container\"><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"run-label\" data-osb-static=\"true\">RUNS</span></div><span class=\"identity-tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"hidden currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"competitor fixedRowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-fixed-row-container\"><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"run-label\" data-osb-static=\"true\">RUNS</span></div><span class=\"identity-tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"hidden currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><footer class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">INNING</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">BALLS</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">STRIKES</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</span></div><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-static=\"true\">OUTS</span><span class=\"stat-value\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</span></div></footer><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
