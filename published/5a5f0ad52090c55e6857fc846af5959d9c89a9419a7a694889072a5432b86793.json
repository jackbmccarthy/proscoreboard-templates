{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Oxblood Ivory In-Row Rail — Soccer horizontal</title>\n<style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:5px}.board{width:min(95vw,1710px);aspect-ratio:8.9;display:flex;flex-direction:column;overflow:hidden;border:2px solid #3d3937;background:#ece8e1;color:#202021;container-type:inline-size;font-variant-numeric:tabular-nums}.teams{height:69%;min-height:0;display:flex}.team{display:flex;flex:1 1 0;min-width:0;min-height:0}.team+.team{border-left:2px solid #9b9690}.name-lane{position:relative;flex:1 1 0;min-width:0;display:flex;align-items:center;gap:6%;padding:0 2%;overflow:hidden}.sport-tag{position:absolute;top:6%;left:2%;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:1.6cqw;letter-spacing:.14em;color:#7f7975;white-space:nowrap}.identity{flex:none;width:2.1%;height:58%;background:#5a2b3a}.name{flex:1 1 0;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-weight:700;text-transform:uppercase;font-size:4.4cqw;letter-spacing:.004em;line-height:1}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.score-label{align-self:center;flex:none;margin:0 2%;color:#85807a;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:2cqw}.score-cell{flex:0 0 19%;display:flex;align-items:center;justify-content:center;min-width:0;margin:1.2% .6%;background:#5a2b3a;color:#fff}.score{display:block;width:100%;overflow:hidden;white-space:nowrap;text-align:center;font-size:5cqw;line-height:1;font-weight:800;font-variant-numeric:tabular-nums}.status{height:31%;min-height:0;display:flex;align-items:center;justify-content:center;gap:3%;border-top:2px solid #88837f;font-family:Impact,\"Arial Narrow\",Arial,sans-serif;font-size:2.05cqw;white-space:nowrap}.stat{display:flex;align-items:baseline;gap:.5em;min-width:0}.stat-label{color:#85807a}.stat-value{font-size:1.16em;font-variant-numeric:tabular-nums}.divider{height:56%;width:2px;background:#77716d}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;aspect-ratio:auto;height:126px;border-width:1px}.teams{height:73%}.team+.team{border-width:1px}.name-lane{gap:4%}.sport-tag{top:5%;font-size:2.3cqw}.name{font-size:4.8cqw}.score-label{font-size:2.2cqw}.score-cell{flex-basis:21%}.score{font-size:6cqw}.status{height:27%;gap:2%;font-size:2.65cqw;border-width:1px}.divider{width:1px}.identity{width:3px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(86vw,1570px);aspect-ratio:6.18;border-radius:5px}.sport-tag{position:static;flex:0 0 22%;display:flex;align-items:center;padding-left:1.3%;border-bottom:2px solid #3d3937;font-size:2cqw;letter-spacing:.16em;color:#303031}.teams{height:49%}.name-lane{padding-left:2.4%}.name{font-size:4cqw}.score-label{font-size:1.9cqw}.score-cell{flex-basis:20%;margin:0;background:#642c3c}.score{font-size:5.5cqw}.status{height:29%;font-size:2.6cqw;gap:3%}.stat-label{color:#202021}.stat-value{font-size:1em}@media(max-width:520px){.board{width:100%;height:142px;aspect-ratio:auto}.sport-tag{font-size:3.1cqw;flex-basis:23%}.teams{height:48%}.name{font-size:5cqw}.score-label{font-size:2.1cqw}.score{font-size:6.6cqw}.status{height:29%;font-size:3.5cqw}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component-type=\"osb-column-container\" data-osb-component=\"layout\" aria-label=\"Soccer scoreboard\">\n<div class=\"sport-tag\" data-osb-component=\"text\">SOCCER</div><div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><span class=\"score-label\" data-osb-component=\"text\">GOALS</span><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><span class=\"score-label\" data-osb-component=\"text\">GOALS</span><div class=\"score-cell\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"status rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><span class=\"divider\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"half\" data-osb-static=\"true\">0</span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</article></main></body></html>\n","css":""}
