{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseball — Stone Ink Lead Bay horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;color:#263741}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:8px}\n.board{display:flex;flex-direction:column;width:min(94vw,1850px);max-width:100%;min-width:0;overflow:hidden;border:2px solid #b4bfbb;border-radius:4px;background:#e9e7e1;container-type:inline-size}\n.competitors{display:flex;align-items:stretch;min-width:0}\n.competitor{display:flex;align-items:stretch;flex:1 1 50%;min-width:0;height:8.7cqw;background:#e9e7e1}\n.competitor+.competitor{border-left:2px solid #b4bfbb}\n.score-bay{display:flex;flex-direction:column;justify-content:center;flex:0 0 27%;min-width:0;padding:0 .7cqw;background:#263741;color:#f7f7f4}\n.primary-line,.support-line{display:flex;align-items:center;justify-content:space-between;gap:.5cqw;min-width:0;white-space:nowrap}\n.primary-line{flex:0 0 58%}.support-line{flex:1 1 auto}\n.score,.hit-value{display:block;max-width:65%;overflow:hidden;color:#f7f7f4;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:left}\n.score{font-size:4cqw}.hit-value{font-size:2.5cqw}\n.primary-label,.support-label{display:block;flex:none;color:#f7f7f4;font-weight:700;line-height:1;white-space:nowrap}\n.primary-label{font-size:1.4cqw}.support-label{font-size:1.3cqw}\n.identity{display:block;flex:none;width:1cqw;height:100%;background:#2791ec}\n.jerseyColorB{background:#ef6765}\n.name{display:block;align-content:center;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2cqw;color:#263741;font-size:4.1cqw;font-weight:700;line-height:1.05}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\n.baseline{display:flex;align-items:center;min-width:0;height:4cqw;border-top:2px solid #b4bfbb;background:#e9e7e1}\n.sport-tag{display:block;flex:1 1 auto;min-width:0;padding:0 1.8cqw;color:#263741;font-size:1.8cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stats{display:flex;align-items:center;justify-content:flex-end;flex:none;min-width:0}\n.stat{display:flex;align-items:baseline;gap:.5cqw;min-width:0;padding:0 1.4cqw;color:#263741;font-size:1.5cqw;font-weight:700;line-height:1;white-space:nowrap}\n.stat:first-child,.stat+.stat{border-left:2px solid #b4bfbb}.stat strong{font-variant-numeric:tabular-nums}\n.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){.board{width:100%;border-width:1px}.competitor{height:74px}.competitor+.competitor{border-left-width:1px}.score-bay{flex-basis:38%;padding:0 3px}.primary-line,.support-line{gap:2px}.score{font-size:clamp(18px,5vw,24px)}.hit-value{font-size:12px}.primary-label,.support-label{font-size:8px}.identity{width:3px}.name{font-size:clamp(13px,3.6vw,20px);padding:0 4px}.baseline{height:47px;border-top-width:1px;flex-direction:column;align-items:stretch;justify-content:center;gap:4px}.sport-tag{flex:none;padding:0 6px;font-size:10px}.stats{justify-content:space-between}.stat{font-size:9px;gap:2px;padding:0 4px}.stat:first-child{border-left:0}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Baseball scoreboard\">\n<div class=\"competitors rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"primary-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><strong class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</strong><span class=\"primary-label\" data-osb-component=\"text\">RUNS</span></div><div class=\"support-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsA\">0</strong><span class=\"support-label\" data-osb-component=\"text\">HITS</span></div></div><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"competitor rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"score-bay columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"primary-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><strong class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</strong><span class=\"primary-label\" data-osb-component=\"text\">RUNS</span></div><div class=\"support-line rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><strong class=\"hit-value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"hitsB\">0</strong><span class=\"support-label\" data-osb-component=\"text\">HITS</span></div></div><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"baseline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">BASEBALL</span><div class=\"stats rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\" aria-label=\"Editable static baseball counters\"><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">INNING</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"inning\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">BALLS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"balls\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">STRIKES</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"strikes\">0</strong></span><span class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">OUTS</span><strong data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"outs\">0</strong></span></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
