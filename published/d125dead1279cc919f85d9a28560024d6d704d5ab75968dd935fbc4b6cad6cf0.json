{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pearl Slate Stat Lead — Soccer horizontal</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:6px}.board{width:min(78vw,1400px);aspect-ratio:3.5;display:flex;flex-direction:column;overflow:hidden;border:2px solid #bec8cb;border-radius:5px;background:#e8edea;color:#1f3440;container-type:inline-size;font-variant-numeric:tabular-nums}.header{height:24%;min-height:0;display:flex;align-items:center;gap:2%;padding:0 2%;background:#243b49;color:#f6f8f5;white-space:nowrap}.sport-tag{flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:3.5cqw;font-weight:750}.stats{display:flex;align-items:center;gap:2cqw;height:100%}.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;font-size:1.7cqw;font-weight:650}.stat-label{order:1;color:#d6e4e0}.stat-value{order:2;font-size:1.6em;font-weight:800;font-variant-numeric:tabular-nums}.divider{height:60%;width:2px;background:#bfd1ce}.teams{height:76%;min-height:0;display:flex;flex-direction:column}.team{display:flex;flex:1 1 0;min-height:0}.team+.team{border-top:2px solid #bec8cb}.identity{display:block;flex:0 0 4%;height:100%;background:#2682d2}.jerseyColorB{background:#e46669}.support{display:flex;flex:0 0 13%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:2%;background:#bfd1ce;color:#1f3440}.support-value{font-size:6cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.support-label{font-size:2cqw;font-weight:700;line-height:1}.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:0 2.5%}.name{display:block;flex:1 1 0;width:100%;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:5.7cqw;font-weight:700;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.primary{display:flex;flex:0 0 16%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:0;background:transparent}.score-row{display:flex;width:100%;align-items:center;justify-content:center}.score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:7cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.primary-label{font-size:2cqw;font-weight:700}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;height:165px;aspect-ratio:auto;border-width:1px;border-radius:3px}.header{height:24%}.sport-tag{font-size:3cqw}.stats{gap:1cqw}.stat{font-size:2cqw}.divider{width:1px}.teams{height:76%}.team+.team{border-width:1px}.identity{flex-basis:4%}.support{flex-basis:17%}.support-value{font-size:6cqw}.support-label{font-size:2.1cqw}.name{font-size:5.8cqw}.primary{flex-basis:22%}.score{font-size:7.3cqw}.primary-label{font-size:2cqw}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(98vw,1900px);aspect-ratio:7.73}.header{height:29%}.sport-tag{font-size:2.3cqw}.stats{gap:1.2cqw}.stat{flex-direction:row;gap:.5em;font-size:1.6cqw}.stat-label{order:1;font-size:1em}.stat-value{order:2;font-size:1.15em}.teams{height:71%;flex-direction:row}.team{min-width:0}.team+.team{border-top:0;border-left:2px solid #bec8cb}.identity{flex-basis:4%}.support{flex-basis:16%}.support-value{font-size:4.2cqw}.support-label{font-size:1.55cqw}.name-lane{padding:0 3%}.name{font-size:4.4cqw}.primary{flex-basis:21%}.score{font-size:5.6cqw}.primary-label{font-size:1.6cqw}@media(max-width:520px){.board{width:100%;height:145px;aspect-ratio:auto}.header{height:29%}.sport-tag{font-size:2.8cqw}.stats{gap:.7cqw}.stat{font-size:2.1cqw}.teams{height:71%}.team+.team{border-width:1px}.identity{flex-basis:4%}.support{flex-basis:19%}.support-value{font-size:5.5cqw}.support-label{font-size:1.8cqw}.name{font-size:4.3cqw}.primary{flex-basis:25%}.score{font-size:5.8cqw}.primary-label{font-size:1.8cqw}}\n.board{width:min(96vw,1810px);aspect-ratio:7.1}.header{height:30%}.teams{height:70%}.sport-tag{font-size:2.4cqw}.stat{font-size:1.8cqw}.support{flex-basis:16%}.name{font-size:4cqw}.primary{flex-basis:20%}.score{font-size:6.2cqw}@media(max-width:520px){.board{width:100%;height:145px;aspect-ratio:auto}.header{height:30%}.teams{height:70%}.sport-tag{font-size:2.9cqw}.stat{font-size:2.4cqw}.support{flex-basis:19%}.name{font-size:4.3cqw}.primary{flex-basis:25%}.score{font-size:6.2cqw}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><div class=\"header rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"stats\" data-osb-component=\"layout\"><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><span class=\"divider\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span class=\"stat-label\" data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"half\" data-osb-static=\"true\">0</span></div></div></div><div class=\"teams rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsA\" data-osb-static=\"true\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"primary\" data-osb-component=\"layout\"><div class=\"score-row\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsB\" data-osb-static=\"true\">0</span><span class=\"support-label\" data-osb-component=\"text\">FOULS</span></div><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"primary\" data-osb-component=\"layout\"><div class=\"score-row\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div><div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
