{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Volleyball Box Score</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;font-family:\"Arial Narrow\",\"Helvetica Neue\",Arial,sans-serif;-webkit-font-smoothing:antialiased}\n.rowContainer{display:flex;flex-direction:row}.columnContainer{display:flex;flex-direction:column}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}\nimg.logo:not([src]),img.logo[src=\"\"]{display:none}\n.pt-slot{position:relative;display:block}.pt-slot>.pt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.pt-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint,.pt-slot:has(> .isMatchPoint[style*=\"opacity:1\"]) > .isGamePoint{opacity:0!important}\n.pt-slot .isMatchPoint{animation:osbPulse 1.8s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.3)}}\n@media (prefers-reduced-motion: reduce) {\n.pt-slot .isGamePoint,.pt-slot .isMatchPoint{animation:none!important;transition:none!important}\n}\n.pips{display:inline-flex;gap:.35rem;align-items:center}.pip{position:relative;display:block;width:.7rem;height:.7rem;border-radius:50%;background:currentColor}\n.pip-used{position:absolute;inset:-1px;border-radius:50%;background:var(--pip-off,#0009)}\n.to-left:empty{display:none}\n.isACurrentlyServing,.isBCurrentlyServing{transition:opacity .2s}\n.dbl-probe{display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff9 0 18%,transparent 40%),conic-gradient(from 20deg,#ffd23f 0 120deg,#1d4fbf 0 240deg,#f4f6fb 0);box-shadow:inset 0 0 0 .12rem #0005}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 32%,#0003 0 9%,transparent 10%),radial-gradient(circle at 66% 30%,#0003 0 9%,transparent 10%),radial-gradient(circle at 50% 62%,#0003 0 9%,transparent 10%),radial-gradient(circle at 24% 70%,#0002 0 7%,transparent 8%),radial-gradient(circle at 78% 70%,#0002 0 7%,transparent 8%),radial-gradient(circle at 38% 30%,#fbffb0,#d4f02b 60%,#a9c414)}\n.sn{position:relative;display:inline-grid}.sn>i,.cn>i{grid-area:1/1;font-style:normal}\n.sn:has(> .isSecondServer[style*=\"opacity: 1\"]) > .one,.sn:has(> .isSecondServer[style*=\"opacity:1\"]) > .one{opacity:0}\n.cn{position:relative;display:inline-grid}.cn:has(> .isSecondServer[style*=\"opacity: 1\"]) > .one,.cn:has(> .isSecondServer[style*=\"opacity:1\"]) > .one{opacity:0}\n.call{display:inline-flex;align-items:baseline}.call>i{font-style:normal}.call .ca{order:1}.call .cd1{order:2}.call .cb{order:3}.call .cd2{order:4}.call .cn{order:5}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .ca,.board:has(.isBCurrentlyServing[style*=\"opacity:1\"]) .call .ca{order:3}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .cb,.board:has(.isBCurrentlyServing[style*=\"opacity:1\"]) .call .cb{order:1}\n.board:has(.playerA2:empty) .sn,.board:has(.playerA2:empty) .cn,.board:has(.playerA2:empty) .cd2{display:none}\n.gstack{display:inline-grid}.gstack>.gs{grid-area:1/1;white-space:nowrap}.gstack>.gs:has(~ .gs[style*=\"opacity: 1\"]),.gstack>.gs:has(~ .gs[style*=\"opacity:1\"]){visibility:hidden}\n.tie{display:none}\n.cards{display:inline-flex;gap:.25rem}.card{display:block;width:.8rem;height:1.1rem;border-radius:.15rem;box-shadow:0 0 0 1px #0003}.yc{background:#ffd200}.rc{background:#e3262f}\n.live{display:inline-flex;align-items:center;gap:.35rem}.live::before{content:\"\";width:.6rem;height:.6rem;border-radius:50%;background:#ff3b30}\n.stage{position:fixed;left:50%;bottom:4rem;transform:translateX(-50%)}\n.board{position:relative;width:84rem;color:#20232a;font-family:\"Helvetica Neue\",Arial,sans-serif;font-weight:700;background:#fff;box-shadow:0 .4rem 1.2rem #0006}\n.top{height:2.8rem;align-items:center;gap:1rem;padding:0 1.4rem;background:#20232a;color:#fff;font-size:1.2rem;letter-spacing:.1em}\n.top .ev{color:#fff}.top .rd{color:#ff8a9a}.top .pt-slot{flex:1;height:100%}.top .pt{justify-content:flex-end!important;color:#ffd23f}\n.grid{display:grid;grid-template-columns:.8rem minmax(0,1fr) 2.6rem 4rem repeat(5,4.4rem) 5rem 7rem;align-items:stretch}\n.grid>*{display:flex;align-items:center;justify-content:center;border-bottom:1px solid #e3e6ec}\n.th{height:2.2rem;background:#eef0f4;font-size:1rem;letter-spacing:.12em;color:#6b7280}\n.th.tl{justify-content:flex-start;padding-left:1rem}\n.chip{background:#1f5fbf;height:4.4rem}.chip.jerseyColorB{background:#c8102e}\n.nm{justify-content:flex-start!important;padding:0 1rem;font-size:2.2rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block!important;line-height:4.4rem}\n.vball{width:1.6rem;height:1.6rem}\n.grid>.sv{border-bottom:0}\n.hc:has(> .hcv:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"])):has(+ .hc > .hcv:not([style*=\"opacity: 1\"]):not([style*=\"opacity:1\"])),.hc:has(+ .won):has(> .hcv:is([style*=\"opacity: 1\"],[style*=\"opacity:1\"])){color:#c8102e;background:#c8102e10}\n.pips{color:#c8102e;--pip-off:#fffd}\n.hc{font-size:1.8rem;color:#4b5563}\n.won{font-size:2.4rem;background:#20232a;color:#fff}\n.pts{font-size:3.4rem;background:#c8102e;color:#fff}\n.tcol{flex-direction:column;gap:.2rem}.to-left{font-size:.85rem;color:#6b7280}\n.foot{height:2rem;align-items:center;justify-content:flex-end;gap:1rem;padding:0 1.4rem;background:#eef0f4;font-size:1rem;color:#6b7280;letter-spacing:.1em}\n.foot .setno{color:#c8102e}.dec{color:#c8102e}\n.tolive{position:absolute;right:0;bottom:100%;margin-bottom:.5rem;display:flex;gap:.4rem}.to-live{gap:.5rem;padding:.4rem 1rem;background:#c8102e;color:#fff;font-size:1.2rem}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<header class=\"top rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"ev eventName\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><span class=\"rd matchRound\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><span class=\"pt-slot\"><span class=\"pt isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">SET POINT</span><span class=\"pt isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">MATCH POINT</span></span></header>\n<div class=\"grid\">\n<span class=\"th\"></span><span class=\"th tl\">TEAM</span><span class=\"th\"></span><span class=\"th\">T/O</span><span class=\"th\">S1</span><span class=\"th\">S2</span><span class=\"th\">S3</span><span class=\"th\">S4</span><span class=\"th\">S5</span><span class=\"th\">SETS</span><span class=\"th\">PTS</span>\n<i class=\"chip jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></i><span class=\"nm combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"sv isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" isA=\"true\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"tcol\"><span class=\"pips\"><i class=\"pip\"></i><i class=\"pip\"><span class=\"pip-used isATimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isATimeOutUsed\" style=\"display:none;opacity:0\"></span></i></span><span class=\"to-left num timeoutsRemainingA\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingA\"></span></span><span class=\"hc\"><span class=\"hcv isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\"><span class=\"hv num game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\"><span class=\"hv num game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\"><span class=\"hv num game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\"><span class=\"hv num game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\"><span class=\"hv num game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span></span><span class=\"won num currentAMatchScore setsWonA\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"pts num currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span>\n<i class=\"chip jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></i><span class=\"nm combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"sv isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity:0\"><i class=\"vball\"></i></span><span class=\"tcol\"><span class=\"pips\"><i class=\"pip\"></i><i class=\"pip\"><span class=\"pip-used isBTimeOutUsed\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutUsed\" style=\"display:none;opacity:0\"></span></i></span><span class=\"to-left num timeoutsRemainingB\" data-osb-component=\"field\" data-osb-field=\"timeoutsRemainingB\"></span></span><span class=\"hc\"><span class=\"hcv isGame1Started\" data-osb-component=\"field\" data-osb-field=\"isGame1Started\" style=\"display:none;opacity:0\"><span class=\"hv num game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame2Started\" data-osb-component=\"field\" data-osb-field=\"isGame2Started\" style=\"display:none;opacity:0\"><span class=\"hv num game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame3Started\" data-osb-component=\"field\" data-osb-field=\"isGame3Started\" style=\"display:none;opacity:0\"><span class=\"hv num game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame4Started\" data-osb-component=\"field\" data-osb-field=\"isGame4Started\" style=\"display:none;opacity:0\"><span class=\"hv num game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></span><span class=\"hc\"><span class=\"hcv isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\"><span class=\"hv num game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></span><span class=\"won num currentBMatchScore setsWonB\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"pts num currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span>\n</div>\n<footer class=\"foot rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"dec isGame5Started\" data-osb-component=\"field\" data-osb-field=\"isGame5Started\" style=\"display:none;opacity:0\">DECIDING SET</span><span>SET</span><span class=\"setno num\" data-osb-static=\"true\" data-sport-stat=\"set\">0</span></footer>\n<div class=\"tolive\"><span class=\"to-live isATimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isATimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT <span class=\"to-clock num timeOutTimerA\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerA\">0</span></span><span class=\"to-live isBTimeOutActive\" data-osb-component=\"field\" data-osb-field=\"isBTimeOutActive\" style=\"display:none;opacity:0\">TIMEOUT <span class=\"to-clock num timeOutTimerB\" data-osb-component=\"field\" data-osb-field=\"timeOutTimerB\">0</span></span></div></section></main>\n</body>\n</html>\n","css":""}
