{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Table Tennis Full Screen — Hero Ledger</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;background:transparent}\n.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none}\n.board{font-size:calc(100vw / 80);font-family:var(--font);color:var(--ink);-webkit-font-smoothing:antialiased}\n.flag{flex:0 0 auto;object-fit:cover;border-radius:.12em;box-shadow:0 0 0 1px rgba(0,0,0,.35)}\n.chip{background:var(--chip-default,#8a96a3)}\n.name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-weight:800;text-transform:uppercase;overflow-wrap:break-word;line-height:1.04}\n.team{display:flex;align-items:center;gap:.4em;min-width:0;font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.85}\n.tlogo{width:1.3em;height:1.3em;object-fit:contain}\n.tname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n:has(>.name:empty)>.team .tname{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.05}\n.tscore{padding:0 .4em;border-radius:.2em;background:rgba(127,127,127,.28);font-variant-numeric:tabular-nums}\n.gtag{display:inline-flex;align-items:center;gap:.3em;height:1.8em;padding:0 .8em;border-radius:.2em;font-size:1em;font-weight:800;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}\n.state{width:10.5em;height:1.8em}\n.st{border-radius:.2em;font-size:1em;font-weight:800;letter-spacing:.12em;text-transform:uppercase}\n.srv-ball{display:block;width:1em;height:1em;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff 0 18%,#ff8a1c 46%,#d65f00 100%);box-shadow:0 0 0 .14em rgba(0,0,0,.25)}\n.meta{display:flex;align-items:center;min-width:0;white-space:nowrap;overflow:hidden}\n.meta>*{flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}\n.meta .sep{flex:0 0 auto;font-style:normal;padding:0 .5em;opacity:.55}\n.meta .rd,.meta .bo{flex-shrink:0}\n.meta .ev:empty+.s1,.meta .rd:empty+.s2,.meta .s1:has(+.rd:empty),.meta .s2:has(+.bo:empty){display:none}\n.meta .ev:empty+.s1+.rd:empty+.s2{display:none}\n.head:not(:has(.meta>:not(.sep):not(:empty))),.band:not(:has(.meta>:not(.sep):not(:empty))),.top:not(:has(.meta>:not(.sep):not(:empty))){display:none}\n.slot{position:relative;display:inline-block;flex:0 0 auto}\n.slot>*{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .isWarmUpStarted{opacity:0!important}\n.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isGamePoint[style*=\"opacity: 1\"])>.isInBetweenGames,.slot:has(>.isComplete[style*=\"opacity: 1\"])>.isInBetweenGames{opacity:0!important}\n.slot:has(>.isATimeOutActive[style*=\"opacity: 1\"])>.isATimeOutUsed,.slot:has(>.isBTimeOutActive[style*=\"opacity: 1\"])>.isBTimeOutUsed{opacity:0!important}\n.flag:not([src]),.tlogo:not([src]){display:none}\n.team:not(:has(.tname:not(:empty))){display:none}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.osb-core-fields{display:none!important}\n.title:has(.big-ev:empty):has(.rd:empty):has(.bo:empty){display:none}\n.board{display:flex;flex-direction:column;align-items:stretch;width:66em;max-width:96vw}\n.band{align-self:flex-start;display:flex;align-items:center;height:2.4em;padding:0 1.2em;margin-bottom:.4em;border-radius:.3em;font-size:1.1em;font-weight:800;letter-spacing:.12em;text-transform:uppercase;max-width:100%}\n.card{border-radius:.5em;overflow:hidden}\n.hero{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:2em;padding:1.6em 1.6em}\n.hs{position:relative;display:flex;align-items:center;gap:.9em;min-width:0}\n.hB{flex-direction:row-reverse;text-align:right}\n.hs .kit{flex:0 0 .55em;align-self:stretch;border-radius:.2em}\n.hs .flag{width:3.3em;height:2.2em}\n.nm{display:flex;flex-direction:column;gap:.2em;min-width:0}\n.hB .nm{align-items:flex-end}\n.hs .name{font-size:2.1em;-webkit-line-clamp:3;text-wrap:balance;line-height:1}\n.hs .team{font-size:1.05em}\n.hB .team{flex-direction:row-reverse}\n.nm:has(.name:empty) .team{font-size:1.7em;opacity:1}\n.score{display:flex;align-items:center;gap:.5em}\n.g{display:flex;align-items:center;justify-content:center;width:1.6em;height:1.5em;border-radius:.12em;font-size:4.2em;font-weight:900;font-variant-numeric:tabular-nums;line-height:1}\n.dash{width:.9em;height:.22em;border-radius:.1em;background:currentColor;opacity:.4}\n.ls{display:flex;align-items:stretch;justify-content:center;padding:.4em 1.6em 1.2em}\n.lnames{display:flex;flex-direction:column;flex:0 1 auto;min-width:0;max-width:24em;padding-right:1.2em}\n.ls:not(:has(.lc:not([style*=\"display: none\"]):not([style*=\"display:none\"]))){display:none}\n.lab{display:flex;align-items:center;justify-content:center;height:2em;font-size:.95em;font-weight:800;letter-spacing:.12em}\n.ln{display:flex;align-items:center;height:2.9em;min-width:0}\n.lname{font-size:1.55em;font-weight:800;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.lcols{display:flex;flex:0 0 auto}\n.lc{display:flex;flex-direction:column;flex:none;width:4em}\n.v{display:flex;align-items:center;justify-content:center;height:2.9em;font-weight:800;font-variant-numeric:tabular-nums}\n.lc .v>*{font-size:1.9em}\n.foot{display:flex;align-items:center;justify-content:center;gap:.6em;height:3.4em}\n.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])) .lc:not([style*=\"display: none\"]):not([style*=\"display:none\"]):not(:has(~ .lc:not([style*=\"display: none\"]):not([style*=\"display:none\"])))>*>*{opacity:.4}\n.t-hero{--font:\"Avenir Next Condensed\",\"DIN Condensed\",\"Roboto Condensed\",\"Arial Narrow\",Arial,sans-serif;--ink:#0e1b33}\n.t-hero .band{background:#0e1b33;color:#fff}\n.t-hero .card{background:#fff;box-shadow:0 1em 3em rgba(0,0,0,.45)}\n.t-hero .hero{border-bottom:1px solid #e3e7ee}\n.t-hero .g{background:#f2b632;color:#0e1b33}\n.t-hero .ls{background:#f6f7fa}\n.t-hero .lab{color:#6b778c}\n.t-hero .ln+.ln,.t-hero .v+.v{border-top:1px solid #e3e7ee}\n.t-hero .lc{border-left:1px solid #e3e7ee}\n.t-hero .tscore{background:#e8ebf1}\n.t-hero .gtag{background:#0e1b33;color:#fff}\n.t-hero .st-warm,.t-hero .st-break{background:#fff;color:#0e1b33;box-shadow:inset 0 0 0 .12em #0e1b33}\n.t-hero .st-gp{background:#ff8a1c;color:#111}\n.t-hero .st-mp{background:#d7263d;color:#fff}\n.t-hero .st-final{background:#0e1b33;color:#fff}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n/* stream-size floor: text >= 16px, indicators >= 12px at 1280x720 */\n.lab{font-size:1.25vw!important}\n/* end stream-size floor */\n\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board t-hero\" data-osb-component=\"layout\"><div class=\"band\" data-osb-component=\"layout\"><span class=\"meta\"><span class=\"eventName ev\" data-osb-component=\"field\" data-osb-field=\"eventName\"></span><i class=\"sep s1\">·</i><span class=\"matchRound rd\" data-osb-component=\"field\" data-osb-field=\"matchRound\"></span><i class=\"sep s2\">·</i><span class=\"matchFormatLabel bestOf bo\" data-osb-component=\"field\" data-osb-field=\"matchFormatLabel\"></span></span></div><div class=\"card\" data-osb-component=\"layout\"><div class=\"hero\" data-osb-component=\"layout\"><div class=\"hs hA\" data-osb-component=\"layout\"><span class=\"jerseyColorA kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><img class=\"countryA flag\" data-osb-component=\"field\" data-osb-field=\"countryA\" alt=\"\"><span class=\"nm\"><span class=\"combinedAName name\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"team\"><img class=\"teamLogoURLA tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLA\" alt=\"\"><span class=\"teamAName tname\" data-osb-component=\"field\" data-osb-field=\"teamAName\"></span><span class=\"teamAScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamAScore\">0</span></span></span></div><span class=\"score\"><span class=\"currentAMatchScore AScore g gA\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><i class=\"dash\"></i><span class=\"currentBMatchScore BScore g gB\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></span><div class=\"hs hB\" data-osb-component=\"layout\"><span class=\"jerseyColorB kit\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><img class=\"countryB flag\" data-osb-component=\"field\" data-osb-field=\"countryB\" alt=\"\"><span class=\"nm\"><span class=\"combinedBName name\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"team\"><img class=\"teamLogoURLB tlogo\" data-osb-component=\"field\" data-osb-field=\"teamLogoURLB\" alt=\"\"><span class=\"teamBName tname\" data-osb-component=\"field\" data-osb-field=\"teamBName\"></span><span class=\"teamBScore tscore\" data-osb-component=\"field\" data-osb-field=\"teamBScore\">0</span></span></span></div></div><div class=\"ls\" data-osb-component=\"layout\"><div class=\"lnames\" data-osb-component=\"layout\"><span class=\"lab\"></span><span class=\"ln\"><span class=\"combinedAFirstInitialLastName lname\" data-osb-component=\"field\" data-osb-field=\"combinedAFirstInitialLastName\"></span></span><span class=\"ln\"><span class=\"combinedBFirstInitialLastName lname\" data-osb-component=\"field\" data-osb-field=\"combinedBFirstInitialLastName\"></span></span></div><div class=\"lcols\" data-osb-component=\"layout\"><div class=\"lc isGame1Started\" data-osb-component=\"layout\" data-osb-field=\"isGame1Started\" style=\"display:none\"><span class=\"lab\">G1</span><span class=\"v\"><span class=\"game1AScore\" data-osb-component=\"field\" data-osb-field=\"game1AScore\">0</span></span><span class=\"v\"><span class=\"game1BScore\" data-osb-component=\"field\" data-osb-field=\"game1BScore\">0</span></span></div><div class=\"lc isGame2Started\" data-osb-component=\"layout\" data-osb-field=\"isGame2Started\" style=\"display:none\"><span class=\"lab\">G2</span><span class=\"v\"><span class=\"game2AScore\" data-osb-component=\"field\" data-osb-field=\"game2AScore\">0</span></span><span class=\"v\"><span class=\"game2BScore\" data-osb-component=\"field\" data-osb-field=\"game2BScore\">0</span></span></div><div class=\"lc isGame3Started\" data-osb-component=\"layout\" data-osb-field=\"isGame3Started\" style=\"display:none\"><span class=\"lab\">G3</span><span class=\"v\"><span class=\"game3AScore\" data-osb-component=\"field\" data-osb-field=\"game3AScore\">0</span></span><span class=\"v\"><span class=\"game3BScore\" data-osb-component=\"field\" data-osb-field=\"game3BScore\">0</span></span></div><div class=\"lc isGame4Started\" data-osb-component=\"layout\" data-osb-field=\"isGame4Started\" style=\"display:none\"><span class=\"lab\">G4</span><span class=\"v\"><span class=\"game4AScore\" data-osb-component=\"field\" data-osb-field=\"game4AScore\">0</span></span><span class=\"v\"><span class=\"game4BScore\" data-osb-component=\"field\" data-osb-field=\"game4BScore\">0</span></span></div><div class=\"lc isGame5Started\" data-osb-component=\"layout\" data-osb-field=\"isGame5Started\" style=\"display:none\"><span class=\"lab\">G5</span><span class=\"v\"><span class=\"game5AScore\" data-osb-component=\"field\" data-osb-field=\"game5AScore\">0</span></span><span class=\"v\"><span class=\"game5BScore\" data-osb-component=\"field\" data-osb-field=\"game5BScore\">0</span></span></div><div class=\"lc isGame6Started\" data-osb-component=\"layout\" data-osb-field=\"isGame6Started\" style=\"display:none\"><span class=\"lab\">G6</span><span class=\"v\"><span class=\"game6AScore\" data-osb-component=\"field\" data-osb-field=\"game6AScore\">0</span></span><span class=\"v\"><span class=\"game6BScore\" data-osb-component=\"field\" data-osb-field=\"game6BScore\">0</span></span></div><div class=\"lc isGame7Started\" data-osb-component=\"layout\" data-osb-field=\"isGame7Started\" style=\"display:none\"><span class=\"lab\">G7</span><span class=\"v\"><span class=\"game7AScore\" data-osb-component=\"field\" data-osb-field=\"game7AScore\">0</span></span><span class=\"v\"><span class=\"game7BScore\" data-osb-component=\"field\" data-osb-field=\"game7BScore\">0</span></span></div><div class=\"lc isGame8Started\" data-osb-component=\"layout\" data-osb-field=\"isGame8Started\" style=\"display:none\"><span class=\"lab\">G8</span><span class=\"v\"><span class=\"game8AScore\" data-osb-component=\"field\" data-osb-field=\"game8AScore\">0</span></span><span class=\"v\"><span class=\"game8BScore\" data-osb-component=\"field\" data-osb-field=\"game8BScore\">0</span></span></div><div class=\"lc isGame9Started\" data-osb-component=\"layout\" data-osb-field=\"isGame9Started\" style=\"display:none\"><span class=\"lab\">G9</span><span class=\"v\"><span class=\"game9AScore\" data-osb-component=\"field\" data-osb-field=\"game9AScore\">0</span></span><span class=\"v\"><span class=\"game9BScore\" data-osb-component=\"field\" data-osb-field=\"game9BScore\">0</span></span></div></div></div></div><div class=\"foot\" data-osb-component=\"layout\"><span class=\"isMatchStarted gtag\" data-osb-component=\"field\" data-osb-field=\"isMatchStarted\" style=\"opacity:0\">Game <span class=\"currentGame cg\" data-osb-component=\"field\" data-osb-field=\"currentGame\"></span></span><span class=\"slot state\"><span class=\"isWarmUpStarted st st-warm\" data-osb-component=\"field\" data-osb-field=\"isWarmUpStarted\" style=\"opacity:0\">Warm-up</span><span class=\"isInBetweenGames st st-break\" data-osb-component=\"field\" data-osb-field=\"isInBetweenGames\" style=\"opacity:0\">Between games</span><span class=\"isComplete st st-final\" data-osb-component=\"field\" data-osb-field=\"isComplete\" style=\"opacity:0\">Final</span><span class=\"isGamePoint st st-gp\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity:0\">Game point</span><span class=\"isMatchPoint st st-mp\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity:0\">Match point</span></span></div></article><div class=\"osb-core-fields\" aria-hidden=\"true\"><span class=\"currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></main>\n</body>\n</html>\n","css":""}
