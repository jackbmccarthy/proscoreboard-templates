{"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Atlantic Open Flank — Soccer compact</title><style>\n*{box-sizing:border-box}html,body{width:100%;min-height:100%;margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:6px}.board{width:min(75vw,1360px);aspect-ratio:3.56;display:flex;flex-direction:column;overflow:hidden;border:2px solid #5c7379;border-radius:5px;background:#21343c;color:#f6f8f5;container-type:inline-size;font-variant-numeric:tabular-nums}.teams{height:77%;min-height:0;display:flex;flex-direction:column}.team{display:flex;align-items:stretch;flex:1 1 0;min-height:0}.team+.team{border-top:2px solid #5c7379}.identity-lane{display:flex;align-items:center;justify-content:center;flex:0 0 4%;min-width:0}.identity{display:block;width:35%;height:78%;background:#2678da}.jerseyColorB{background:#e66069}.support{display:flex;flex:0 0 11%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:3%;background:transparent;color:#a5c5c3}.support-label{font-size:1.8cqw;font-weight:700;line-height:1}.support-value{font-size:3.7cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.name-lane{display:flex;align-items:center;flex:1 1 0;min-width:0;padding:0 1.3%;background:transparent}.name{display:block;flex:1 1 0;width:100%;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:5.4cqw;font-weight:700;line-height:1.05}.combinedAName:empty:before{content:\"Team A\"}.combinedBName:empty:before{content:\"Team B\"}.primary{display:flex;flex:0 0 15%;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:1%;background:transparent}.primary-label{font-size:1.8cqw;font-weight:700}.primary-value-row{display:flex;width:100%;align-items:center;justify-content:center}.score{display:block;max-width:100%;overflow:hidden;white-space:nowrap;font-size:5.7cqw;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.baseline{height:23%;min-height:0;display:flex;align-items:center;gap:2%;padding:0 2%;border-top:2px solid #5c7379;background:#21343c;white-space:nowrap}.sport-tag{flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:2.6cqw;font-weight:750}.stats{display:flex;align-items:center;gap:1.4cqw}.stat{display:flex;align-items:baseline;gap:.5em;font-size:2.1cqw;font-weight:650}.stat-value{font-variant-numeric:tabular-nums}.divider{height:55%;width:2px;background:#a5c5c3}.retained,.point-slot{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}@media(max-width:520px){.board{width:100%;height:162px;aspect-ratio:auto;border-width:1px;border-radius:3px}.team+.team,.baseline{border-width:1px}.identity{width:4px}.support{flex-basis:16%}.support-label{font-size:2cqw}.support-value{font-size:4.8cqw}.name{font-size:5.6cqw}.primary{flex-basis:20%}.primary-label{font-size:1.9cqw}.score{font-size:6.7cqw}.sport-tag{font-size:2.6cqw}.stat{font-size:2.1cqw}.divider{width:1px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.board{width:min(75vw,1360px);aspect-ratio:3.38}.support{position:relative;flex-basis:12.5%}.support:after{content:\"\";position:absolute;right:0;top:19%;height:62%;width:2px;background:#5c7379}.support-value{font-size:4.2cqw}.name{font-size:6cqw}.score{font-size:7cqw}.sport-tag{font-size:2.9cqw}.stat{font-size:2.55cqw}@media(max-width:520px){.board{width:100%;height:166px;aspect-ratio:auto}.support{flex-basis:17%}.support:after{width:1px}.support-value{font-size:5cqw}.name{font-size:6.2cqw}.score{font-size:7.5cqw}.sport-tag{font-size:3cqw}.stat{font-size:2.8cqw}}\n</style></head><body><main class=\"stage\" data-osb-component=\"layout\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Soccer scoreboard\"><div class=\"teams columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsA\" data-osb-static=\"true\">0</span></div><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span><div class=\"primary-value-row\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><span class=\"retained currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div>\n<div class=\"team rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"identity-lane\" data-osb-component=\"layout\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span></div><div class=\"support\" data-osb-component=\"layout\"><span class=\"support-label\" data-osb-component=\"text\">FOULS</span><span class=\"support-value\" data-osb-component=\"text\" data-sport-stat=\"foulsB\" data-osb-static=\"true\">0</span></div><div class=\"name-lane\" data-osb-component=\"layout\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"primary\" data-osb-component=\"layout\"><span class=\"primary-label\" data-osb-component=\"text\">GOALS</span><div class=\"primary-value-row\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div><span class=\"retained currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div></div>\n<div class=\"baseline rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">SOCCER</span><div class=\"stats\" data-osb-component=\"layout\"><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">CLOCK</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"clock\" data-osb-static=\"true\">00:00</span></div><span class=\"divider\" data-osb-component=\"layout\"></span><div class=\"stat\" data-osb-component=\"layout\"><span data-osb-component=\"text\">HALF</span><span class=\"stat-value\" data-osb-component=\"text\" data-sport-stat=\"half\" data-osb-static=\"true\">0</span></div></div></div>\n<div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div></article></main></body></html>\n","css":""}
