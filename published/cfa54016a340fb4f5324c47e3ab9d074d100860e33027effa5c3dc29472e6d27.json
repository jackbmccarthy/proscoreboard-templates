{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>PICKLEBALL · Cobalt Fog Leadchip</title>\n<style>\n:root{color-scheme:light}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:transparent}\nbody{background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif;color:#f7faf9}\n.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;background:transparent}\n.board{--board-width:86vw;--board-max:1760px;width:min(var(--board-width),var(--board-max));min-width:0;container-type:inline-size;border:1px solid #506c75;border-radius:4px;background:#23394b;overflow:hidden}\n.header{height:4cqw;min-height:30px;display:flex;align-items:center;gap:2cqw;padding:0 2cqw;background:#23394b;border-bottom:1px solid #506c75;position:relative}\n.sport-tag{font-size:1.85cqw;font-weight:700;letter-spacing:.025em;line-height:1;white-space:nowrap}\n.status{margin-left:auto;display:flex;align-items:center;gap:1.5cqw;color:#c9d7d7;font-size:0.7cqw;font-weight:700;letter-spacing:.06em;white-space:nowrap}\n.status b{color:#f7faf9;font-size:1.18em;font-variant-numeric:tabular-nums}\n.point-slot{position:absolute;right:2cqw;top:50%;transform:translateY(-50%);min-width:14cqw;height:1.8em;text-align:right;pointer-events:none}\n.point-state{position:absolute;inset:0;color:#f7faf9;font-size:0.8cqw;font-weight:700;line-height:1.8em;white-space:nowrap;background:#23394b}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}\n.lanes{display:flex;flex-direction:row;min-width:0}\n.lane{height:7.7cqw;min-height:70px;display:flex;align-items:center;min-width:0;flex:1 1 50%;background:#23394b}\n.lane+.lane{border-left:1px solid #506c75}\n.identity{align-self:stretch;display:block;flex:0 0 0.95cqw;min-width:5px;background:#3186a8}\n.jerseyColorB{background:#c76c69}\n.support-track{flex:0 0 6.5cqw;min-width:0;height:5.5cqw;min-height:50px;margin:0 1.2cqw;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:4px;background:#c9d7d7;color:#23394b}\n.support-number{display:block;font-size:3.1cqw;font-weight:700;line-height:.98;font-variant-numeric:tabular-nums;white-space:nowrap}\n.support-caption{font-size:1.1cqw;font-weight:700;line-height:1.1;letter-spacing:.025em;white-space:nowrap}\n.name-track{display:flex;align-items:center;gap:1cqw;flex:1 1 0;min-width:0;padding-right:1cqw}\n.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:3.15cqw;font-weight:700;line-height:1.1}\n.combinedAName:empty::before{content:\"Player A\"}\n.combinedBName:empty::before{content:\"Player B\"}\n.serve{flex:0 0 auto;color:#f7faf9;font-size:1.1cqw;line-height:1}\n.primary-track{flex:0 0 8.9cqw;min-width:0;height:100%;display:flex;align-items:center;justify-content:center;gap:0;flex-direction:column;padding:0 .5cqw;background:#23394b;color:#f7faf9;overflow:hidden}\n.primary-number{display:block;font-size:4.6cqw;font-weight:700;line-height:.95;font-variant-numeric:tabular-nums;white-space:nowrap}\n.primary-caption{display:block;font-size:1.14cqw;font-weight:700;line-height:1.1;letter-spacing:.015em;white-space:nowrap}\n@media(max-width:650px){\n .board{width:94vw}\n .header{height:11cqw;padding:0 3cqw}\n .sport-tag{font-size:4.3cqw}\n .status{font-size:1.5cqw}\n .point-slot{right:3cqw}\n .point-state{font-size:1.7cqw}\n .lanes{flex-direction:column}\n .lane{height:19cqw;min-height:65px;flex:0 0 auto}\n .lane+.lane{border-left:0;border-top:1px solid #506c75}\n .identity{flex-basis:2cqw}\n .support-track{flex-basis:12cqw;height:15cqw;min-height:0;margin:0 2.3cqw}\n .support-number{font-size:6cqw}\n .support-caption{font-size:2.1cqw}\n .name{font-size:5.8cqw}\n .serve{font-size:2.2cqw}\n .primary-track{flex-basis:19cqw;flex-direction:column;gap:0;padding:0 1cqw}\n .primary-number{font-size:9cqw}\n .primary-caption{font-size:2.25cqw}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\"><article class=\"board columnContainer horizontal\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n  <header class=\"header\"><div class=\"sport-tag\">PICKLEBALL</div><div class=\"status\"><span>GAME <b>0</b></span><span>MATCH <b>0</b></span></div><div class=\"point-slot\"><span class=\"point-state isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point-state isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></header>\n  <div class=\"lanes columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n    <div class=\"lane rowContainer lane-a\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n  <span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\" aria-hidden=\"true\"></span>\n  <div class=\"support-track\"><span class=\"support-number currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"support-caption\">GAMES</span></div>\n  <div class=\"name-track\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\" aria-label=\"Serving\">●</span></div>\n  <div class=\"primary-track\"><span class=\"primary-number currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n</div>\n    <div class=\"lane rowContainer lane-b\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n  <span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\" aria-hidden=\"true\"></span>\n  <div class=\"support-track\"><span class=\"support-number currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><span class=\"support-caption\">GAMES</span></div>\n  <div class=\"name-track\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\" aria-label=\"Serving\">●</span></div>\n  <div class=\"primary-track\"><span class=\"primary-number currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span><span class=\"primary-caption\">POINTS</span></div>\n</div>\n  </div>\n</article></main>\n</body>\n</html>\n","css":""}
