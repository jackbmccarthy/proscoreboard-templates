{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Pickleball Match Summary</title>\n<style>\n*{box-sizing:border-box}html{font-size:calc(100vw / 128)}html,body{margin:0;background:transparent}\nbody{min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}\n.num{font-variant-numeric:tabular-nums;white-space:nowrap}\n.osb-core-fields{display:none!important}\n.slot{position:relative;display:grid}.slot>*{grid-area:1/1;position:relative}\n.pslot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.pslot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n.isMatchPoint[style*=\"opacity: 1\"]{animation:osbPulse 1.6s ease-in-out infinite}\n@keyframes osbPulse{50%{filter:brightness(1.18)}}\n@media (prefers-reduced-motion: reduce){.isGamePoint,.isMatchPoint,.isACurrentlyServing,.isBCurrentlyServing,.ldot{animation:none!important;transition:none!important}}\n.nm{display:block;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;line-height:1.02}\n.bal{text-wrap:balance}\n.st,.pt{display:flex;align-items:center;justify-content:center;white-space:nowrap}\n.hv{position:relative;display:inline-grid;place-items:center}.hv>*{grid-area:1/1}.hv>.w{display:block;align-self:stretch;justify-self:stretch}.hv>.num{position:relative}\n.ev,.rd{white-space:nowrap}\n.hc:not([style*=\"opacity: 1\"]),.cell:not([style*=\"opacity: 1\"]){display:none}\n.vball{display:block;border-radius:50%;background:radial-gradient(circle at 34% 30%,#fff 0 14%,transparent 34%),conic-gradient(from 30deg,#ffd23f 0 120deg,#2a5bd7 0 240deg,#f6f7fb 0);box-shadow:inset 0 0 0 .12rem #0006,0 0 .4rem #0006}\n.pball{display:block;border-radius:50%;background:radial-gradient(circle at 30% 34%,#0005 0 8%,transparent 9%),radial-gradient(circle at 64% 30%,#0005 0 8%,transparent 9%),radial-gradient(circle at 52% 64%,#0005 0 8%,transparent 9%),radial-gradient(circle at 24% 72%,#0004 0 6%,transparent 7%),radial-gradient(circle at 78% 70%,#0004 0 6%,transparent 7%),radial-gradient(circle at 36% 30%,#fbffb4,#d8f22c 60%,#a6c214);box-shadow:0 0 0 .15rem #0b1a12,0 0 .4rem #0007}\n\n.srv{display:flex;align-items:center;gap:.4rem}\n.sn{position:relative;display:inline-grid;place-items:center}.sn>i{grid-area:1/1;font-style:normal}\n.sn:has(>.isSecondServer[style*=\"opacity: 1\"])>.one,.cn:has(>.isSecondServer[style*=\"opacity: 1\"])>.one{opacity:0}\n.cn{display:inline-grid}.cn>i{grid-area:1/1;font-style:normal;text-align:center}\n.call{display:inline-flex;align-items:baseline}.call>i,.dbl>i{font-style:normal}.call .ca{order:1}.call .d1{order:2}.call .cb{order:3}.call .dbl{order:4;display:inline-flex;align-items:baseline}\n.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .ca{order:3}.board:has(.isBCurrentlyServing[style*=\"opacity: 1\"]) .call .cb{order:1}\n.call .dbl:not([style*=\"opacity: 1\"]){display:none}\n.cards{display:flex;gap:.35rem;align-items:center}.card{display:block;width:1.3rem;height:1.8rem;border-radius:.15rem;box-shadow:0 0 0 .1rem #0005}.yc{background:#ffd200}.rc{background:#e3262f}\n.cards:not(:has(>[style*=\"opacity: 1\"])){display:none}\n.tos{display:flex;gap:.4rem;align-items:center}.tp{position:relative;display:block;width:1.3rem;height:1.3rem;border-radius:50%}.tp>.used{position:absolute;inset:0;border-radius:50%}\n.board:has(.isMatchStarted[style*=\"opacity: 1\"]) .swarm{opacity:0!important}\nbody:has(.isComplete[style*=\"opacity: 1\"]) .isMatchStarted{opacity:0!important}\n.ldot{display:inline-block;width:1.2rem;height:1.2rem;border-radius:50%;background:#ff2b3a;margin-right:.7rem;box-shadow:0 0 0 .2rem #fff6;animation:osbLive 1.4s ease-in-out infinite}\n@keyframes osbLive{50%{opacity:.35}}\n.tie{display:flex;align-items:center}.tie:has(>.teamAName[style*=\"display: none\"]){display:none}\n.tlogo{display:block;object-fit:contain;flex:none}.tlogo:not([src]),.tlogo[src=\"\"]{visibility:hidden}\n.tchip{display:block;flex:none}\n.tname{flex:1;min-width:0;overflow-wrap:normal;word-break:normal;hyphens:none;text-wrap:balance;line-height:1.05}.tname.tb{text-align:right}\n.tsc{display:flex;align-items:center;flex:none}.tdash{font-style:normal}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>:not(.tie){display:none!important}\n.board:has(.isInBetweenGames[style*=\"opacity: 1\"]) :is(.pts,.call){opacity:.38}\n.ph{place-items:center}.ph:has(>.phn[style*=\"opacity: 1\"])>.phl:first-child{opacity:0}.ph .num{margin-left:.35rem}\n\n.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}\n.board{position:relative;width:96rem;font-family:\"Avenir Next\",\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;color:#20163a;background:#f6f3fb;border-radius:1rem;box-shadow:0 1.6rem 4rem #000b;overflow:hidden}\n.tie{justify-content:center;gap:1.6rem;min-height:5.2rem;padding:.6rem 3rem;background:#ece6f7;font-size:2.2rem;font-weight:700}.tlogo{width:3.4rem;height:3.4rem}.tchip{width:.7rem;height:2.8rem}.tscore{font-family:\"DIN Alternate\",\"Bahnschrift\",\"Roboto Condensed\",\"Helvetica Neue\",Arial,sans-serif;font-size:3.4rem;color:#7c3aed;padding:0 .6rem}.tie .tname{flex:0 1 32rem}\n.top{display:flex;align-items:center;justify-content:space-between;gap:2rem;height:6.4rem;padding:0 3rem;background:#20163a;color:#fff}\n.ctx{flex:1;min-width:0;display:block;font-size:2rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#c9bfe3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2}.ctx .sep{font-style:normal;color:#a78bfa;margin:0 .7rem}\n.sslot{flex:none;min-width:26rem}.sslot>.st{height:4.4rem;padding:.1rem 2rem 0;border-radius:.4rem;font-size:2.3rem;font-weight:700;letter-spacing:.08em;background:#352a57;color:#c9bfe3}\n.sslot>.sgame{background:#a78bfa;color:#20163a}.sslot>.swarm{background:#fbbf24;color:#20163a}.sslot>.sbrk{background:#fff;color:#20163a}.sslot>.sfin{background:#fff;color