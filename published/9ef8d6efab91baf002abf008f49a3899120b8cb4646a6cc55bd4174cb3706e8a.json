e3BWon[style*=\"opacity: 1\"]):not(:has(.isGame4Started[style*=\"opacity: 1\"])) .ptsB,.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):has(.isGame4BWon[style*=\"opacity: 1\"]):not(:has(.isGame5Started[style*=\"opacity: 1\"])) .ptsB,.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):has(.isGame5BWon[style*=\"opacity: 1\"]):not(:has(.isGame6Started[style*=\"opacity: 1\"])) .ptsB,.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):has(.isGame6BWon[style*=\"opacity: 1\"]):not(:has(.isGame7Started[style*=\"opacity: 1\"])) .ptsB,.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):has(.isGame7BWon[style*=\"opacity: 1\"]):not(:has(.isGame8Started[style*=\"opacity: 1\"])) .ptsB,.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):has(.isGame8BWon[style*=\"opacity: 1\"]):not(:has(.isGame9Started[style*=\"opacity: 1\"])) .ptsB,.board:not(:has(.isInBetweenGames[style*=\"opacity: 1\"])):has(.isGame9BWon[style*=\"opacity: 1\"]) .ptsB{background:#7c3aed}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .tA,.board:has(.isBWinner[style*=\"opacity: 1\"]) .tB{box-shadow:0 0 0 .3rem #7c3aed,0 .4rem 1.2rem #7c3aed33}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) .tA .games,.board:has(.isBWinner[style*=\"opacity: 1\"]) .tB .games{color:#7c3aed}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.tB .nm,.tB .big),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.tA .nm,.tA .big){opacity:0.4}\n.board:has(.isAWinner[style*=\"opacity: 1\"]) :is(.lB .team,.lB .pts),.board:has(.isBWinner[style*=\"opacity: 1\"]) :is(.lA .team,.lA .pts){opacity:0.45}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>.tie{min-height:12rem;font-size:3.2rem}\n.board:has(.combinedAName:empty):has(.combinedBName:empty)>.tie .tscore{font-size:6rem}\n</style>\n</head>\n<body>\n<main class=\"stage\"><section class=\"board\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\">\n<span class=\"tie\"><img class=\"tlogo teamLogoURLA\" data-osb-compon