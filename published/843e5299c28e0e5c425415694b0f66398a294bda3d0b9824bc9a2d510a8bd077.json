{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Volleyball — Atlantic Open Flank 2</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{width:100%;min-height:100%;margin:0;background:transparent}\nbody{font-family:Arial,Helvetica,sans-serif}\n.stage{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}\n.board{display:flex;flex-direction:column;width:min(96vw,1736px);max-width:100%;aspect-ratio:8.55;overflow:hidden;border:2px solid #5c7379;border-radius:4px;background:#21343c;color:#f6f8f5;container-type:inline-size}\n.pair{display:flex;flex:1 1 0;min-width:0;min-height:0}\n.side{display:flex;align-items:stretch;flex:1 1 0;min-width:0}\n.side+.side{border-left:2px solid #5c7379}\n.identity{display:block;flex:0 0 14px;align-self:stretch;margin:22px 0 22px 16px;background:#39a6e4}\n.jerseyColorB{background:#ed6c74}\n.sets,.points{display:flex;align-items:center;justify-content:center;flex-direction:column;min-width:0;gap:2px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.sets{flex:0 0 12%;color:#a5c5c3}\n.points{flex:0 0 17%;color:#f6f8f5}\n.label{display:block;max-width:100%;overflow:hidden;font-size:clamp(13px,1.5cqw,27px);font-weight:700;line-height:1}\n.set-score{display:block;max-width:100%;overflow:hidden;font-size:clamp(28px,2.9cqw,51px);font-weight:800;line-height:1;text-align:center}\n.score{display:block;max-width:100%;overflow:hidden;font-size:clamp(44px,4.2cqw,73px);font-weight:800;line-height:1;text-align:center}\n.name{display:block;align-self:center;flex:1 1 0;min-width:0;overflow:hidden;padding:0 27px;color:#f6f8f5;font-size:clamp(29px,3.7cqw,65px);font-weight:700;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}\n.combinedAName:empty::before{content:\"Team A\"}\n.combinedBName:empty::before{content:\"Team B\"}\n.utility{display:flex;align-items:center;justify-content:space-between;flex:0 0 29%;min-width:0;padding:0 28px;border-top:2px solid #5c7379;font-size:clamp(17px,1.9cqw,33px);font-weight:750;line-height:1;white-space:nowrap}\n.sport-tag{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.set-status{display:flex;align-items:center;gap:.3em;color:#a5c5c3}\n.current-set{display:inline-block;min-width:1ch;max-width:4ch;overflow:hidden;font-variant-numeric:tabular-nums;text-align:center}\n.point-slot{display:none}\n.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint,.point-slot:has(>.isMatchPoint[style*=\"opacity:1\"])>.isGamePoint{opacity:0!important}\n@media(max-width:700px){\n .stage{padding:6px}\n .board{width:100%;height:130px;aspect-ratio:auto;border-width:1px;border-radius:2px}\n .side+.side,.utility{border-width:1px}\n .identity{flex-basis:4px;margin:18px 0 18px 5px}\n .sets{flex-basis:19%}\n .points{flex-basis:21%}\n .label{font-size:clamp(7px,2cqw,10px)}\n .set-score{font-size:clamp(16px,4.4cqw,21px)}\n .score{font-size:clamp(23px,6.5cqw,30px)}\n .name{padding:0 5px;font-size:clamp(12px,3.7cqw,17px)}\n .utility{padding:0 8px;font-size:clamp(10px,3cqw,14px)}\n}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"stage\" data-osb-component=\"layout\">\n <article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\" aria-label=\"Horizontal volleyball scoreboard with generic manual scoring\">\n  <div class=\"pair rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\">\n   <div class=\"side side-a rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><div class=\"points\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div>\n   <div class=\"side side-b rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"sets\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SETS</span><span class=\"set-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><div class=\"points\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">POINTS</span><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div>\n  </div>\n  <div class=\"utility rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><span class=\"sport-tag\" data-osb-component=\"text\">VOLLEYBALL</span><div class=\"set-status\" data-osb-component=\"layout\"><span data-osb-component=\"text\">SET</span><span class=\"current-set\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"current-set\">0</span></div></div>\n </article>\n <div class=\"point-slot\" data-osb-component=\"layout\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">GAME POINT</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">MATCH POINT</span></div>\n</main>\n</body>\n</html>\n","css":""}
