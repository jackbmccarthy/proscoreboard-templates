{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Petrol Ivory Keyline — Soccer Scorebug</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:14px 0}.package{width:min(49.5vw,950px);min-width:0;container-type:inline-size}.board{overflow:hidden;background:#203b45;border:1px solid #b7c6c4;border-top:5px solid #bd8d5a;border-radius:7px 7px 5px 5px;color:#fff}.header{display:flex;align-items:center;justify-content:space-between;min-height:7.6cqw;border-bottom:1px solid #8ca6a9}.sport{margin:0;padding:1.2cqw 3.8cqw;font-size:4.2cqw;line-height:1;white-space:nowrap}.header-label{display:flex;align-items:center;justify-content:center;align-self:stretch;flex:0 0 24%;border-left:1px solid #8ca6a9;font-size:3cqw;white-space:nowrap}.team{display:flex;align-items:stretch;min-width:0;min-height:13.8cqw}.team+.team{border-top:1px solid #8ca6a9}.identity{display:flex;align-items:stretch;gap:3.8cqw;flex:1 1 0;min-width:0}.tick{display:block;flex:0 0 2.4cqw;min-width:0;background:#bd8d5a}.jerseyColorB{background:#5e9a9d}.name{display:flex;align-items:center;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#fff;font-size:7.2cqw;line-height:1.1}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-cell{display:flex;align-items:center;justify-content:center;flex:0 0 24%;min-width:0;background:#f3f1e9;border-left:1px solid #a5b6b5}.score{display:block;width:100%;text-align:center;white-space:nowrap;color:#152c33;font-size:9.1cqw;font-variant-numeric:tabular-nums;line-height:1}.dock{display:flex;align-items:stretch;width:100%;min-height:9.2cqw;margin-top:1.4cqw;border-radius:6px;background:#dbe2de;color:#152c33;overflow:hidden}.stat{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;gap:2.6cqw;padding:.5cqw}.stat+.stat{border-left:1px solid #a5b6b5;margin:1cqw 0}.label{font-size:3cqw;white-space:nowrap}.value{font-size:6.3cqw;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}@media(max-width:600px){.package{width:94vw}.board{border-top-width:4px}.header{min-height:42px}.sport{padding:8px 12px;font-size:16px}.header-label{flex-basis:83px;font-size:12px}.team{min-height:66px}.identity{gap:12px}.tick{flex-basis:7px}.name{font-size:22px}.score-cell{flex-basis:83px}.score{font-size:36px}.dock{min-height:58px;margin-top:8px}.stat{gap:8px;padding:4px}.stat+.stat{margin:6px 0}.label{font-size:11px}.value{font-size:23px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.stage{align-items:flex-start;padding-top:17.1vh}\n</style>\n</head>\n<body><main class=\"stage\"><article class=\"package columnContainer\" data-osb-component=\"layout\"><div class=\"board columnContainer\" data-osb-component=\"layout\"><header class=\"header rowContainer\" data-osb-component=\"layout\"><h1 class=\"sport\" data-osb-component=\"text\">SOCCER</h1><span class=\"header-label\" data-osb-component=\"text\">GOALS</span></header><section class=\"team rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-cell rowContainer\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></section><section class=\"team rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-cell rowContainer\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></section></div><footer class=\"dock rowContainer\" data-osb-component=\"layout\"><div class=\"stat rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat rowContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">HALF</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"half\">0</span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
