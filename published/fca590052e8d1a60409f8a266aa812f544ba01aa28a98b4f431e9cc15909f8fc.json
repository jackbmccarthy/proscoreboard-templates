{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Petrol Ivory Keyline — Basketball Lower Third</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:14px 0}.package{width:min(63vw,1210px);min-width:0;container-type:inline-size}.board{overflow:hidden;background:#203b45;border:1px solid #b7c6c4;border-top:5px solid #bd8d5a;border-radius:7px 7px 5px 5px;color:#fff}.header{display:flex;align-items:center;justify-content:center;min-height:4.3cqw;border-bottom:1px solid #8ca6a9}.sport{margin:0;font-size:3cqw;line-height:1;white-space:nowrap}.competitors{display:flex;align-items:stretch;min-width:0}.team{display:flex;align-items:stretch;flex:1 1 0;min-width:0;min-height:11.5cqw}.team+.team{border-left:1px solid #8ca6a9}.identity{display:flex;align-items:center;gap:2cqw;flex:1 1 0;min-width:0;padding:1.3cqw 1.7cqw}.tick{display:block;flex:0 0 1.15cqw;align-self:stretch;min-width:0;background:#bd8d5a}.jerseyColorB{background:#5e9a9d}.name{display:block;flex:1 1 0;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#fff;font-size:4cqw;line-height:1.1}.combinedAName:empty::before{content:\"Team A\"}.combinedBName:empty::before{content:\"Team B\"}.score-group{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 17.6cqw;min-width:0;padding:1cqw 1.1cqw .5cqw}.score-cell{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;min-height:7.5cqw;border-radius:5px;background:#f3f1e9}.score{display:block;width:100%;text-align:center;white-space:nowrap;color:#152c33;font-size:6.2cqw;font-variant-numeric:tabular-nums;line-height:1}.score-label{font-size:1.7cqw;line-height:1.1;white-space:nowrap;color:#fff;padding-top:.5cqw}.dock{display:flex;align-items:stretch;width:100%;min-height:7.2cqw;margin-top:1.2cqw;border-radius:6px;background:#dbe2de;color:#152c33;overflow:hidden}.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1 1 0;min-width:0;padding:.4cqw;gap:.2cqw}.stat+.stat{border-left:1px solid #a5b6b5;margin:.65cqw 0}.label{font-size:1.8cqw;white-space:nowrap}.value{font-size:3.6cqw;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums}.retained{display:none}.point-slot:has(>.isMatchPoint[style*=\"opacity: 1\"])>.isGamePoint{opacity:0!important}@media(max-width:600px){.package{width:94vw}.board{border-top-width:4px}.header{min-height:40px}.sport{font-size:16px}.competitors{flex-direction:column}.team{flex:none;width:100%;min-height:64px}.team+.team{border-left:0;border-top:1px solid #8ca6a9}.identity{gap:12px;padding:7px 12px}.tick{flex-basis:6px}.name{font-size:22px}.score-group{flex-basis:85px;padding:5px 5px 4px}.score-cell{min-height:39px}.score{font-size:33px}.score-label{font-size:10px;padding-top:2px}.dock{min-height:62px;margin-top:8px}.stat{padding:3px;gap:2px}.stat+.stat{margin:6px 0}.label{font-size:10px}.value{font-size:22px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n.stage{align-items:flex-start;padding-top:18vh}\n</style>\n</head>\n<body><main class=\"stage\"><article class=\"package columnContainer\" data-osb-component=\"layout\"><div class=\"board columnContainer\" data-osb-component=\"layout\"><header class=\"header rowContainer\" data-osb-component=\"layout\"><h1 class=\"sport\" data-osb-component=\"text\">BASKETBALL</h1></header><div class=\"competitors rowContainer\" data-osb-component=\"layout\"><section class=\"team rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span></div><div class=\"score-group columnContainer\" data-osb-component=\"layout\"><div class=\"score-cell rowContainer\" data-osb-component=\"layout\"><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div><span class=\"score-label\" data-osb-component=\"text\">POINTS</span></div></section><section class=\"team rowContainer\" data-osb-component=\"layout\"><div class=\"identity rowContainer\" data-osb-component=\"layout\"><span class=\"tick jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span></div><div class=\"score-group columnContainer\" data-osb-component=\"layout\"><div class=\"score-cell rowContainer\" data-osb-component=\"layout\"><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div><span class=\"score-label\" data-osb-component=\"text\">POINTS</span></div></section></div></div><footer class=\"dock rowContainer\" data-osb-component=\"layout\"><div class=\"stat columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">CLOCK</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"game-clock\">00:00</span></div><div class=\"stat columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">PERIOD</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"period\">0</span></div><div class=\"stat columnContainer\" data-osb-component=\"layout\"><span class=\"label\" data-osb-component=\"text\">SHOT</span><span class=\"value\" data-osb-component=\"text\" data-osb-static=\"true\" data-sport-stat=\"shot-clock\">00</span></div></footer><div class=\"retained\" aria-hidden=\"true\"><span class=\"currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span><span class=\"currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span><div class=\"point-slot\"><span class=\"isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0\">Game point</span><span class=\"isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0\">Match point</span></div></div></article></main></body>\n</html>\n","css":""}
