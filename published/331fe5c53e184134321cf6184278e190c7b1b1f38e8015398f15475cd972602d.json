{"html":"<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Ivory Cobalt Line TABLE TENNIS 2</title><style>\n*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:transparent}body{font-family:Arial,Helvetica,sans-serif;font-weight:700;color:#152842}.stage{min-height:100vh;display:flex;align-items:center;justify-content:center}.board{width:min(var(--view-width),var(--max-width),var(--height-width));position:relative;container-type:inline-size;background:transparent;padding-bottom:3cqw}.desk{width:100%;min-width:0;background:#faf9f3;border:2px solid #1557b0;border-radius:2px;overflow:hidden}.row,.lane,.name-cell,.name-wrap{min-width:0}.name-wrap{display:flex;align-items:center;gap:.7cqw;flex:1 1 0}.name{display:block;flex:1 1 0;min-width:0;max-width:100%;font-size:var(--name-font);line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.combinedAName:empty:before{content:\"Player A\"}.combinedBName:empty:before{content:\"Player B\"}.identity{display:block;background:#1557b0;flex-shrink:0}.serve{display:block;flex:0 0 1.2cqw;width:1.2cqw;font-size:1.2cqw;line-height:1;text-align:center}.label{font-size:var(--label-font);line-height:1.1;text-align:center;white-space:nowrap}.score,.match-score{display:block;width:100%;font-size:var(--score-font);line-height:1.1;text-align:center;white-space:nowrap;font-variant-numeric:tabular-nums}.match-score{font-size:var(--match-font)}.game-cell{background:#e4ecf8;color:#152842}.point-cell{background:#1557b0;color:#fff}.point-slot{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:36cqw;height:2cqw;font-size:1.5cqw;text-align:center}.point{position:absolute;inset:0;background:#152842;color:#fff}.point-slot:has(> .isMatchPoint[style*=\"opacity: 1\"]) > .isGamePoint{opacity:0!important}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.board{--view-width:89vw;--max-width:1800px;--height-width:450vh;--name-font:3.35cqw;--score-font:4.7cqw;--match-font:3.2cqw;--label-font:1.45cqw}.desk{display:flex;background:#1557b0;min-height:7.4cqw}.endcap{flex:0 0 18.8cqw;min-width:0;color:#fff;display:flex;align-items:center;justify-content:center;padding:0 1cqw;font-size:2.85cqw;white-space:nowrap}.lane{flex:1 1 0;display:flex;align-items:stretch;background:#faf9f3;border-left:1px solid #587089}.name-cell{flex:1 1 0;display:flex;align-items:center;gap:1.2cqw;padding:.65cqw .7cqw .65cqw .7cqw}.identity{width:.8cqw;height:5.8cqw}.lane .game-cell{flex:0 0 6.8cqw;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.45cqw;border-left:1px solid #587089}.lane .point-cell{flex:0 0 10cqw;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.05cqw}.lane .name-wrap{gap:.35cqw}@media(max-width:600px){.board{--view-width:94vw;padding-bottom:24px}.desk{flex-direction:column}.endcap{flex:none;width:100%;height:38px;font-size:15px}.lane{flex:none;min-height:72px;width:100%;border-left:0;border-top:1px solid #587089}.name-cell{padding:8px 10px;gap:9px}.identity{width:3px;height:42px}.name{font-size:18px}.serve{flex-basis:7px;width:7px;font-size:7px}.name-wrap{gap:4px}.lane .game-cell{flex-basis:44px;gap:3px}.lane .point-cell{flex-basis:58px;gap:3px}.label{font-size:10px}.match-score{font-size:23px}.score{font-size:30px}.point-slot{width:200px;font-size:12px;height:20px}}\n.endcap{font-size:2.3cqw}@media(max-width:600px){.endcap{font-size:15px}}\n</style></head>\n<body><main class=\"stage\"><article class=\"board columnContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-column-container\"><div class=\"desk rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"endcap\">TABLE TENNIS</div><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorA\" data-osb-component=\"field\" data-osb-field=\"jerseyColorA\"></span><div class=\"name-wrap\"><span class=\"name combinedAName\" data-osb-component=\"field\" data-osb-field=\"combinedAName\"></span><span class=\"serve isACurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isACurrentlyServing\" style=\"opacity: 0;\" isA=\"true\">●</span></div></div><div class=\"game-cell\"><div class=\"label\">GAMES</div><span class=\"match-score currentAMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentAMatchScore\">0</span></div><div class=\"point-cell\"><div class=\"label\">POINTS</div><span class=\"score currentAGameScore\" data-osb-component=\"field\" data-osb-field=\"currentAGameScore\">0</span></div></div><div class=\"lane rowContainer\" data-osb-component=\"layout\" data-osb-component-type=\"osb-row-container\"><div class=\"name-cell\"><span class=\"identity jerseyColorB\" data-osb-component=\"field\" data-osb-field=\"jerseyColorB\"></span><div class=\"name-wrap\"><span class=\"name combinedBName\" data-osb-component=\"field\" data-osb-field=\"combinedBName\"></span><span class=\"serve isBCurrentlyServing\" data-osb-component=\"field\" data-osb-field=\"isBCurrentlyServing\" style=\"opacity: 0;\">●</span></div></div><div class=\"game-cell\"><div class=\"label\">GAMES</div><span class=\"match-score currentBMatchScore\" data-osb-component=\"field\" data-osb-field=\"currentBMatchScore\">0</span></div><div class=\"point-cell\"><div class=\"label\">POINTS</div><span class=\"score currentBGameScore\" data-osb-component=\"field\" data-osb-field=\"currentBGameScore\">0</span></div></div></div><div class=\"point-slot\"><span class=\"point isGamePoint\" data-osb-component=\"field\" data-osb-field=\"isGamePoint\" style=\"opacity: 0;\">GAME POINT</span><span class=\"point isMatchPoint\" data-osb-component=\"field\" data-osb-field=\"isMatchPoint\" style=\"opacity: 0;\">MATCH POINT</span></div></article></main></body>\n</html>\n","css":""}
