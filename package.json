{
  "name": "proscoreboard-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node studio/server.mjs",
    "catalog": "node tools/build-catalog.mjs && node tools/build-social-catalog.mjs",
    "catalog:check": "node tools/build-catalog.mjs --check && node tools/build-social-catalog.mjs --check",
    "lint": "node tools/check-syntax.mjs",
    "test": "node --test tools/*.test.mjs studio/server.test.mjs studio/social-server.test.mjs",
    "test:browser": "node --test studio/*browser.test.mjs",
    "audit:export": "node tools/audit-export.mjs",
    "validate": "npm run lint && npm run catalog:check && npm test"
  }
}
